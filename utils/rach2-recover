#!/bin/sh
#
# rach2-recover: the recovery system's menu, for a machine that will not boot.
#
# A person who has to repair a machine should not have to know `reflash`'s
# arguments or which partition the root is. This lists what the machine has,
# checks a file system, puts a saved image back, installs a kernel through
# `bootctl`, and opens a shell. Every step can be left without doing anything,
# and every step says in one line what it did or why it did not.
#
# It runs from the recovery system, which mounts nothing from the disk it is
# repairing, so a root that will not mount is still a root this can write.
#
# Usage: rach2-recover
#

set -u

ME=rach2-recover
MNT=/mnt/recover

# Prints MESSAGE on stdout as `rach2-recover: MESSAGE`.
say() { echo "$ME: $1"; }
# Prints MESSAGE on stderr as `rach2-recover: MESSAGE`; the menu goes on.
warn() { echo "$ME: $1" >&2; }

mounted=""
# Unmounts the stick when this run mounted it. The traps call it; it returns 0.
cleanup() {
    [ -n "$mounted" ] && umount "$mounted" 2>/dev/null
    return 0
}
# A signal ends the run: a handler that tidied up and returned would let the
# menu go on with the volume it had just unmounted.
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
trap 'cleanup; exit 129' HUP

# The functions below read `/proc/disk`, whose `disk` line for disk N has the
# fields N TRANSPORT LOCATION SECTORS TABLE MODEL after the word, and whose
# `identity` line has N SECTOR-SIZE fixed|removable mounted|free SERIAL. Each
# prints nothing for a disk the file does not list.
#
# disk_numbers prints the number of each disk /proc/disk lists, one a line.
disk_numbers() {
    grep '^disk ' /proc/disk | cut -d' ' -f2
}

# Prints field FIELD of disk N's `disk` line, counting the word as field 1.
disk_field() { # disk_field N FIELD
    grep "^disk $1 " /proc/disk | head -1 | cut -d' ' -f"$2"
}

# Prints disk N's model, the rest of its `disk` line from field 7.
disk_model() {
    grep "^disk $1 " /proc/disk | head -1 | cut -d' ' -f7-
}

# Prints disk N's serial, the rest of its `identity` line from field 6.
disk_serial() {
    grep "^identity $1 " /proc/disk | head -1 | cut -d' ' -f6-
}

# ---- what the machine has ----

# Prints each disk on one line, with its model, serial, size in bytes,
# transport and table, and its `part` lines from /proc/disk below it.
list_disks() {
    for n in $(disk_numbers); do
        say "/dev/disk$n: $(disk_model "$n"), serial $(disk_serial "$n"), \
$(($(disk_field "$n" 5) * 512)) bytes, $(disk_field "$n" 3), table $(disk_field "$n" 6)"
        grep "^part $n " /proc/disk | sed "s/^/  /"
    done
}

# Asks for a device with PROMPT and leaves the answer in `device`. Status 1
# when the answer is empty, or names nothing on this machine, which is said.
ask_device() { # ask_device PROMPT
    printf '%s: %s: ' "$ME" "$1"
    read -r device
    [ -n "$device" ] || return 1
    [ -e "$device" ] || {
        warn "$device is not a device of this machine"
        return 1
    }
    return 0
}

# ---- the steps ----

# Asks for a partition and checks its ext2 file system with `e2fsck -f -n`,
# which writes nothing, and says how to repair it when the check finds faults.
check_volume() {
    ask_device "which partition shall be checked, for example /dev/disk0p3" || return 0
    say "checking $device without writing to it"
    if e2fsck -f -n "$device"; then
        say "$device: the file system is clean"
    else
        say "$device: the checker found faults; the repair is 'e2fsck -f -p $device'"
    fi
}

# Mount the stick this is running from, if it has an image, and print where.
# The same volume the installer reads, found the same way: by the manifest on
# it rather than by a position. Status 1 when no removable disk has one, or
# when a volume mounted to look would not unmount.
find_stick() {
    for n in $(disk_numbers); do
        [ "$(grep "^identity $n " /proc/disk | cut -d' ' -f4)" = "removable" ] || continue
        for p in 1 2 3 4; do
            [ -e "/dev/disk${n}p${p}" ] || continue
            mkdir -p "$MNT" 2>/dev/null
            mount -t exfat "/dev/disk${n}p${p}" "$MNT" 2>/dev/null || continue
            if [ -f "$MNT/rach2-install.manifest" ]; then
                echo "$MNT"
                return 0
            fi
            umount "$MNT" || return 1
        done
    done
    return 1
}

# Whether PATH is /dev/diskN for a disk `/proc/disk` lists, so that a target
# is a disk of this machine and not a path that happens to exist.
is_whole_disk() { # is_whole_disk PATH
    for n in $(disk_numbers); do
        [ "$1" = "/dev/disk$n" ] && return 0
    done
    return 1
}

# Writes a saved image of a whole disk to a disk the person names, once its
# hash agrees, reads it back, and has the kernel read the new table. The
# target is a whole disk and not a partition: an image begins with a table,
# and written at a partition's first sector it would put that table there
# and read back as though it had been written correctly. The image offered is
# the one on the stick this runs from, since the stick a person boots to
# repair a machine is usually the stick that has the system.
#
# The hash comes from IMAGE.sha256 beside the image, or from the installer's
# manifest when that manifest names this image, and an image with neither is
# not written. The length comes from the file's own record rather than from
# counting its bytes: `wc -c` on a stick reads the whole image, which is
# minutes before a question is even asked. An image with a GUID table has its
# backup where the image ends; on a larger disk it goes to the disk's end, as
# the installer puts it. Each outcome is said in one line, and the function
# returns 0.
restore_image() {
    ask_device "which disk shall be restored, for example /dev/disk0" || return 0
    target=$device
    is_whole_disk "$target" || {
        warn "$target is not a whole disk of this machine; the disks are:"
        list_disks
        return 0
    }
    offer=""
    if [ -z "$mounted" ]; then
        mounted=$(find_stick) || mounted=""
    fi
    if [ -n "$mounted" ]; then
        offer="$mounted/$(sed -n 's/^image //p' "$mounted/rach2-install.manifest")"
        printf '%s: the image to put on it [%s]: ' "$ME" "$offer"
    else
        printf '%s: the image to put on it, with its hash in IMAGE.sha256: ' "$ME"
    fi
    read -r image
    [ -n "$image" ] || image=$offer
    [ -n "$image" ] || return 0
    [ -f "$image" ] || {
        warn "$image is not a file"
        return 0
    }
    want=""
    if [ -f "$image.sha256" ]; then
        hashfile=$image.sha256
        want=$(cut -d' ' -f1 < "$hashfile")
    else
        hashfile=$(dirname "$image")/rach2-install.manifest
        if [ -f "$hashfile" ] &&
            [ "$(sed -n 's/^image //p' "$hashfile")" = "$(basename "$image")" ]
        then
            want=$(sed -n 's/^sha256 //p' "$hashfile")
        fi
    fi
    [ -n "$want" ] || {
        warn "no hash for $image: an image is restored only against one"
        return 0
    }
    bytes=$(stat -c %s "$image")
    [ -n "$bytes" ] || {
        warn "the length of $image could not be read"
        return 0
    }
    n=${target#/dev/disk}
    say "everything on $target will be overwritten by $bytes bytes of $image:"
    say "  $(disk_model "$n"), serial $(disk_serial "$n"), \
$(($(disk_field "$n" 5) * 512)) bytes, $(disk_field "$n" 3), table $(disk_field "$n" 6)"
    printf '%s: type the name of that disk to go on, anything else to stop: ' "$ME"
    read -r confirm
    [ "$confirm" = "$target" ] || {
        say "nothing was written"
        return 0
    }
    say "reading the image to check it against its hash"
    got=$(dd if="$image" bs=1048576 2>/dev/null | sha256sum | cut -d' ' -f1)
    [ "$got" = "$want" ] || {
        warn "the image hashes to $got and $hashfile says $want; nothing was written"
        return 0
    }
    reflash -p "$target" 0 "$bytes" < "$image" || {
        warn "the image was not written"
        return 0
    }
    back=$(reflash --verify "$target" 0 "$bytes" | cut -d' ' -f3)
    [ "$back" = "$want" ] || {
        warn "what reached the disk hashes to $back and the image to $want"
        return 0
    }
    # Type 0xEE in the first MBR entry, byte 450, marks a GUID table.
    if [ "$(dd if="$image" bs=1 skip=450 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')" = ee ]; then
        if ! diskctl relocate "$target" > /dev/null; then
            warn "$target: the image is on the disk and read back, and its GUID table's backup \
was not moved to the disk's end; reboot before mounting anything from it"
            return 0
        fi
    elif ! diskctl reread "$target" > /dev/null; then
        warn "$target: the image is on the disk and read back, and the kernel would not read \
its new table; reboot before mounting anything from it"
        return 0
    fi
    say "$target: restored and read back; reboot from it"
}

# Asks for a boot partition and a kernel file, and stages the kernel in the
# candidate slot with `bootctl kernel`, which arms one trial boot of it.
install_kernel() {
    ask_device "which boot partition, for example /dev/disk0p1" || return 0
    boot=$device
    printf '%s: the kernel to install: ' "$ME"
    read -r kernel
    [ -n "$kernel" ] || return 0
    [ -f "$kernel" ] || {
        warn "$kernel is not a file"
        return 0
    }
    if bootctl --target "$boot" kernel "$kernel"; then
        say "$boot: the kernel is installed as the candidate; boot it once to try it"
    else
        warn "$boot: the kernel was not installed"
    fi
}

# ---- the menu ----

say "this machine mounts nothing from the disk it is repairing"
while :; do
    echo ""
    echo "  1  what this machine has"
    echo "  2  check a file system"
    echo "  3  put a saved image back on a disk"
    echo "  4  install a kernel on a boot partition"
    echo "  5  a shell"
    echo "  6  leave"
    printf '%s: which? ' "$ME"
    read -r choice || break
    case "$choice" in
        1) list_disks ;;
        2) check_volume ;;
        3) restore_image ;;
        4) install_kernel ;;
        5)
            say "the shell; leave it with exit to come back here"
            /bin/sh
            ;;
        6)
            say "leaving"
            break
            ;;
        *) warn "$choice is not one of the numbers above" ;;
    esac
done
