#!/bin/sh
#
# rach2-install: install this system onto a disk of this machine.
#
# It runs from the recovery system booted off the install stick. The stick
# has the whole disk image and a manifest naming that image's length and
# SHA-256. This reads the manifest, lists the disks it could write with what
# each one is, and asks its questions, the last of which is the chosen disk's
# name typed back. Then it hashes the image, writes it, reads it back and
# hashes it again, has the kernel read the new table, writes the accounts
# into the new root, archives them on the recovery partition, and grows the
# root when the answer to that question was yes.
#
# The name is `rach2-install` and not `install` because the shell resolves
# `install` to BusyBox's own applet before it searches the path.
#
# Nothing is written until the question about the target has been answered
# with the device's own name. Every disk passed over is listed with the
# reason, because a person standing at a machine with two disks in it needs
# to know which one was passed over and for what.
#
# Usage: rach2-install [--source DIR]
#        rach2-install [--console term] [--i915] --update IMAGE DISK
#        rach2-install --data DISK SIZE
#        rach2-install --slots DISK
#
# `--source DIR` takes the image and its manifest from a directory already
# mounted, which is how the tests drive it without a stick.
#
# `--update` writes a root file system image into the root partition of a
# machine that is already installed, without moving its partitions. The account
# files, the SSH policy, the console's keymap, the saved Wi-Fi networks, the
# machine's identifiers, its kept sound and backlight levels, the server's host
# keys, the accounts' own keys and the home directories, root's among them, are
# copied off the root first and written back afterwards, so a password changed
# after the install is still the machine's password, a saved network still
# joins, and an agent signed in there is still signed in. The root is grown again
# into its partition. The machine is saved to its recovery system for the whole
# of the write and the new root is armed for one trial boot, so an update cut
# off by a power cut, or one that does not come up, costs a reboot into recovery
# and not a visit to the machine: the update requires a recovery system on
# the disk that would start, and a copy of the old root on a volume that
# outlives the cut, before it destroys anything. Kernel slots smaller than
# the size of this version's slots, which `bootctl status` prints, are grown
# to it. An MBR disk is converted on the way to boot by UEFI as well, when
# GRUB's EFI image is beside IMAGE: it keeps its MBR, and its boot partition
# becomes the EFI system partition.
#
# `--console term` gives the installed root's candidate, fallback and text
# entries one rach2.console=term token, and `--i915` one rach2.i915 token,
# which binds the Intel graphics driver to the machine's chip. Recovery
# entries are left as they are; without these options the update leaves the
# menu unchanged.
#
# A new install writes the image's table, a GUID table on the images this
# system builds, and moves its backup to the disk's last sectors, where a
# reader looks for it on a disk larger than the image. It grows the root to
# the size asked for, 64 GiB unless another is given, and makes the rest of
# the disk the data partition, entry 6, an ext2 volume labelled `Rach2 data`
# for what the machine keeps across updates of its root: games, the disks of
# virtual machines, caches and the trial roots `bootctl rootimage` boots. An
# update writes the root's partition, and of the data partition only the
# directory rach2-update-keep, where it keeps a copy of the old root until
# it finishes.
#
# `--data DISK SIZE` makes room for the data partition on a disk installed
# without one, from the recovery system: it checks the root, shrinks its file
# system to SIZE with `resize2fs`, gives its entry that length with `diskctl
# shrink`, makes entry 6 over the sectors freed with `diskctl data` and its
# file system with `mke2fs`. Each step is one that a run stopped after it
# finds done and passes, so the command can be run again.
#
# `--slots DISK` moves a disk installed before the kernel slots grew to the
# size of this version's, from the recovery system, without an image:
# `bootctl kernel` and `bootctl fallback` refuse its smaller slots. The
# machine is saved to its recovery system for the move, the candidate slot is
# grown and checked and then the fallback, and the saved default is put back
# once both are, so a stop at any point leaves a disk that starts the
# recovery system, where the command run again finishes the move.
#

set -u

# The recovery system's shell has no sbin directories in its path, and
# e2fsck, resize2fs and mke2fs are there.
PATH=$PATH:/sbin:/usr/sbin
export PATH

ME=rach2-install
MNT=/mnt/install-source
TARGET_MNT=/mnt/install-root
RECOVERY_MNT=/mnt/install-recovery
BOOT_MNT=/mnt/install-boot
DATA_MNT=/mnt/install-data
# The directory at the top of the volume that holds an update's copy of the
# root's homes and configuration, `keep.tar`, while the root is written.
KEEP_STORE=rach2-update-keep
# The machine's own files an update keeps and the archive holds: the accounts,
# the SSH policy, the console's keymap, the networks wifi(1) has saved, the
# machine's identifiers and the levels init keeps across a reboot.
CONFIG_FILES="etc/passwd etc/group etc/shadow etc/rach2/sshd.conf etc/vconsole.conf
etc/wpa_supplicant/wlan0.conf etc/machine-id var/lib/ipv6-stable-secret
var/lib/backlight var/lib/mixer var/lib/mixer.mute"
ARCHIVE_NEEDS="etc/passwd etc/group etc/shadow"
# The recovery system's key, on the recovery partition, where its init reads it.
RECOVERY_KEYS_FILE=boot/recovery_authorized_keys

# keep_copy SRC DST: copy a kept file, or a directory such as var/lib/backlight
# whole, to DST, making DST's directory.
keep_copy() {
    mkdir -p "$(dirname "$2")" || return 1
    if [ -d "$1" ]; then
        rm -rf "$2" && cp -R "$1" "$2"
    else
        cp "$1" "$2"
    fi
}

# Prints MESSAGE on stdout as `rach2-install: MESSAGE`, a note of progress.
say() { echo "$ME: $1"; }
# Text addressed to the person, with no `rach2-install: ` in front of it. The
# prefix is for a diagnostic, which says which program is reporting a fault; a
# question or an explanation is neither. It also costs fifteen columns of an
# eighty-column screen, enough to wrap the lines of the summary below and make
# a mess of the one screen that has to be read.
tell() { echo "$1"; }
# Prints MESSAGE on stderr as `rach2-install: MESSAGE` and ends the run with
# status 1; the EXIT trap then puts back what the run changed.
die() {
    echo "$ME: $1" >&2
    exit 1
}

# What this mounted, unmounted however it ends. A source left mounted would
# make the next run report that it could find no stick, and a root left mounted
# would keep the disk from being read again.
mounted_source=""
mounted_root=""
mounted_recovery=""
mounted_boot=""
mounted_data=""
console_new=""
key_dir=""
echo_off=""
screen_level=""
# The archive recover_archive found, and what write_archive records beside
# the configuration; see there.
archive=""
archive_root=""
archive_keep=""
# The screen is shared with the kernel's own record, and a routine note from a
# disk or a file system arriving in the middle of a question reads, to the
# person answering it, as something having gone wrong. The records are still
# kept and still go out the serial port; only the screen is turned down, and
# only while this runs. The level asked for is 2, the kernel's floor, at which a
# panic still shows: a middle value would make the screen noisier, since the
# kernel has usually set the floor already when it started init. The level it
# had is saved in screen_level for `cleanup`; nothing is changed where
# /dev/screenlog cannot be written.
quiet_screen() {
    [ -w /dev/screenlog ] || return 0
    screen_level=$(cat /dev/screenlog 2>/dev/null) || screen_level=""
    # 2 is KLOG_CRIT, the lowest level the kernel takes.
    echo 2 > /dev/screenlog 2>/dev/null || screen_level=""
}
# Puts back what the run changed and has not yet put back: the screen's
# level, the terminal's echo, which a run that ends inside a password question
# leaves off, the five mounts and the directory of the recovery key's copy.
# The traps call it; it returns 0.
cleanup() {
    [ -n "$screen_level" ] && echo "$screen_level" > /dev/screenlog 2>/dev/null
    [ -n "$echo_off" ] && stty echo 2>/dev/null
    [ -n "$mounted_root" ] && umount "$mounted_root" 2>/dev/null
    [ -n "$mounted_recovery" ] && umount "$mounted_recovery" 2>/dev/null
    [ -n "$mounted_data" ] && umount "$mounted_data" 2>/dev/null
    [ -n "$console_new" ] && rm -f "$console_new"
    [ -n "$mounted_boot" ] && umount "$mounted_boot" 2>/dev/null
    [ -n "$mounted_source" ] && umount "$mounted_source" 2>/dev/null
    [ -n "$key_dir" ] && rm -rf "$key_dir"
    return 0
}
# A signal ends the run. A handler that tidied up and returned would let the
# next command write into a directory whose file system had just been
# unmounted under it.
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
trap 'cleanup; exit 129' HUP
quiet_screen

# Prints the opening screen of an install from the stick: what the program
# does and how to stop it.
greet() {
    tell "Rach2 installer"
    tell ""
    tell "This program puts Rach2 on a disk in this computer."
    tell "It asks you which disk, and it asks you to make two accounts."
    tell "It erases everything on the disk you choose."
    tell "It writes nothing until you type the name of that disk at the end."
    tell "To stop before then, hold Control and press C."
    tell ""
}

source_dir=""
update_image=""
update_disk=""
update_console=""
update_i915=""
data_disk=""
data_size=""
slots_disk=""
while [ $# -gt 0 ]; do
    case "$1" in
        --slots)
            [ $# -ge 2 ] || die "--slots takes a disk"
            slots_disk=$2
            shift 2
            ;;
        --data)
            [ $# -ge 3 ] || die "--data takes a disk and the root's size"
            data_disk=$2
            data_size=$3
            shift 3
            ;;
        --source)
            [ $# -ge 2 ] || die "--source takes a directory"
            source_dir=$2
            shift 2
            ;;
        --console)
            [ $# -ge 2 ] || die "--console takes term"
            [ "$2" = term ] || die "--console takes only term"
            update_console=$2
            shift 2
            ;;
        --i915)
            update_i915=1
            shift
            ;;
        --update)
            [ $# -ge 3 ] || die "--update takes an image and a disk"
            update_image=$2
            update_disk=$3
            shift 3
            ;;
        *)
            die "usage: $ME [--source DIR] | $ME [--console term] [--i915] --update IMAGE DISK | $ME --data DISK SIZE | $ME --slots DISK"
            ;;
    esac
done
[ -z "$update_console" ] || [ -n "$update_image" ] ||
    die "--console requires --update"
[ -z "$update_i915" ] || [ -n "$update_image" ] ||
    die "--i915 requires --update"

# One run at a time. Every mode mounts at the same points, and an update
# keeps its copy of a root's homes in one directory: a second run would mount
# over the first's volumes, or remove that copy while the first still needs
# it. The lock is flock(2)'s on descriptor 9, which the kernel drops when the
# run ends however it ends; /tmp is in RAM, so a power cut takes it too.
LOCK=/tmp/rach2-install.lock
{ exec 9> "$LOCK"; } 2>/dev/null || die "the lock $LOCK could not be opened"
flock -n 9 || die "another $ME is running; let it end and run this again"

# ---- the disks this machine has ----
#
# `/proc/disk` names each registered disk on a `disk` line and describes it on
# the `identity` line after it. Both are read here rather than the nodes being
# guessed, since a disk that has gone leaves its node named and unopenable.
# Each function below prints nothing for a disk /proc/disk does not list.

# Prints the number of each disk /proc/disk lists, one a line.
disk_numbers() {
    grep '^disk ' /proc/disk | cut -d' ' -f2
}

# Prints field FIELD of disk N's `disk` line, counted as the table below
# counts them.
disk_field() { # disk_field N FIELD
    grep "^disk $1 " /proc/disk | head -1 | cut -d' ' -f"$2"
}

# Prints disk N's model, the rest of its `disk` line from field 7.
disk_model() {
    grep "^disk $1 " /proc/disk | head -1 | cut -d' ' -f7-
}

# Prints field FIELD of disk N's `identity` line.
identity_field() { # identity_field N FIELD
    grep "^identity $1 " /proc/disk | head -1 | cut -d' ' -f"$2"
}

# Prints disk N's serial, the rest of its `identity` line from field 6.
disk_serial() {
    grep "^identity $1 " /proc/disk | head -1 | cut -d' ' -f6-
}

# Prints the identity growroot and the boot line name disk N by, `MBRID=ID` or
# `GPTID=GUID`, by the table the kernel read on it. Status 1 when `diskctl`
# cannot read the identity or the disk has neither table.
disk_identity() { # disk_identity N
    id=$(diskctl id "/dev/disk$1") || return 1
    case "$(disk_field "$1" 6)" in
        mbr) echo "MBRID=$id" ;;
        gpt) echo "GPTID=$id" ;;
        *) return 1 ;;
    esac
}

# The fields of the two lines, counting the word that names them:
#   disk     N TRANSPORT LOCATION SECTORS TABLE MODEL...
#   identity N SECTOR-SIZE fixed|removable mounted|free SERIAL...
SECTOR_SIZE=3
FIXED_OR_NOT=4
MOUNT_STATE=5

# ---- the image and its manifest ----
#
# The stick is found by looking for the manifest rather than by position: the
# machine may have any number of disks and the stick is not always the last of
# them. Each of the first four partitions of every removable disk is tried,
# and the first that mounts as exFAT and holds a manifest is the source.

# Prints the disk's number and where its volume was mounted, so the caller
# knows both which disk to leave out of the offer and what to unmount. Status 1
# when no disk has the manifest, and 2 when a volume it mounted to look would
# not unmount, since a search that went on would mount the next one over it.
find_source() {
    for n in $(disk_numbers); do
        [ "$(identity_field "$n" "$FIXED_OR_NOT")" = "removable" ] || continue
        for p in 1 2 3 4; do
            [ -e "/dev/disk${n}p${p}" ] || continue
            mkdir -p "$MNT" 2>/dev/null
            mount -t exfat "/dev/disk${n}p${p}" "$MNT" 2>/dev/null || continue
            if [ -f "$MNT/rach2-install.manifest" ]; then
                echo "$n $MNT"
                return 0
            fi
            umount "$MNT" || {
                echo "$ME: /dev/disk${n}p${p} would not unmount" >&2
                return 2
            }
        done
    done
    return 1
}

# ---- the archive ----
#
# The account files, SSH policy and keys on the recovery partition, written
# at the install and refreshed at every update, so that a machine whose root
# no longer reads can still be updated without losing its accounts. The
# passwords are the hashes the files already hold. The recovery partition is
# the FAT32 volume that holds the recovery kernel, /boot/recovery, found by
# that file and not assumed to be a particular entry.

# Where DEVICE is mounted other than at this run's own mount points, printed,
# or a failure when it is mounted nowhere else.
mounted_elsewhere() { # mounted_elsewhere DEVICE
    awk -v d="$1" -v a="$TARGET_MNT" -v b="$RECOVERY_MNT" '
        $1 == d && $2 != a && $2 != b { print $2; found = 1; exit }
        END { exit !found }' /proc/mounts
}

# The recovery partition's number goes in recovery_found, empty when the disk
# has none; it is left mounted at RECOVERY_MNT, which mounted_recovery then
# names, with the archive's files readable by root alone. It runs in this shell and not in a command
# substitution, so that `die` ends the run: a partition mounted elsewhere,
# which a mount here cannot open, may be the recovery partition, and a run
# that went on without it would write a root with no archive of the
# machine's configuration behind it. A volume that was mounted to look and
# will not unmount ends the run too, since the raw writer fails on a disk
# with a mount on it. Status 0 when the disk has a recovery partition and 1
# when it has none. Every volume is looked at mounted read-only, since a
# writable mount of a FAT volume left dirty repairs it, and the disk may
# hold another system's beside this one's; only the recovery partition, once
# found, is mounted again writable, and with ro it is left read-only.
find_recovery() { # find_recovery DISKNUMBER [ro]
    recovery_found=""
    for p in 1 2 3 4; do
        [ -e "/dev/disk${1}p${p}" ] || continue
        mkdir -p "$RECOVERY_MNT" 2>/dev/null
        if ! mount -t vfat -o ro,umask=077 "/dev/disk${1}p${p}" "$RECOVERY_MNT" 2>/dev/null; then
            if where=$(mounted_elsewhere "/dev/disk${1}p${p}"); then
                die "/dev/disk${1}p${p} is mounted at $where, so it cannot be looked at for the recovery partition; unmount it and run this again"
            fi
            continue
        fi
        mounted_recovery=$RECOVERY_MNT
        if [ -f "$RECOVERY_MNT/boot/recovery" ]; then
            recovery_found=$p
            [ "${2:-}" != ro ] || return 0
            umount "$RECOVERY_MNT" ||
                die "/dev/disk${1}p${p} was mounted read-only to find the recovery partition and would not unmount"
            mounted_recovery=""
            mount -t vfat -o umask=077 "/dev/disk${1}p${p}" "$RECOVERY_MNT" ||
                die "the recovery partition /dev/disk${1}p${p} would not mount to be written"
            mounted_recovery=$RECOVERY_MNT
            return 0
        fi
        umount "$RECOVERY_MNT" || die "/dev/disk${1}p${p} was mounted to look for the recovery partition and would not unmount"
        mounted_recovery=""
    done
    return 1
}

# archive_complete [DIR]: whether DIR, or the directory `archive` names when
# DIR is not given, holds every file of ARCHIVE_NEEDS, the files an update
# cannot do without.
archive_complete() {
    for f in $ARCHIVE_NEEDS; do
        [ -f "${1:-$archive}/$f" ] || return 1
    done
    return 0
}

# The archive to read goes in `archive`, empty when there is none, and its
# generation in `generation`. It is selected without renaming: FAT32 can lose
# both names during a rename. rach2-config, rach2-config.new and
# rach2-config.old count as generation zero, tried in that order. The slots
# rach2-config-a and rach2-config-b require a valid generation, written after
# all their contents, and the highest wins. The recovery partition must be
# mounted at RECOVERY_MNT.
recover_archive() {
    archive=""
    generation=0
    for candidate in rach2-config rach2-config.new rach2-config.old \
        rach2-config-a rach2-config-b; do
        candidate="$RECOVERY_MNT/$candidate"
        archive_complete "$candidate" || continue
        number=0
        case "$candidate" in
        "$RECOVERY_MNT/rach2-config-a" | "$RECOVERY_MNT/rach2-config-b")
            [ -f "$candidate/generation" ] || continue
            number=$(cat "$candidate/generation") || continue
            case "$number" in "" | *[!0-9]*) continue ;; esac
            number=$(printf '%s\n' "$number" | sed 's/^0*//')
            number=${number:-0}
            [ "${#number}" -le 10 ] && [ "$number" -ge 1 ] &&
                [ "$number" -le 2147483647 ] || continue
            ;;
        esac
        if [ -z "$archive" ] || [ "$number" -gt "$generation" ]; then
            archive=$candidate
            generation=$number
        fi
    done
}

# Whether ROOTDIR has OpenSSH's host keys, the GNU root's server's, in
# ROOTDIR/etc/ssh.
ssh_host_keys() { # ssh_host_keys ROOTDIR
    for k in "$1"/etc/ssh/ssh_host_*; do
        [ -f "$k" ] && return 0
    done
    return 1
}

# Makes the public host keys in DIR readable by all, as OpenSSH writes them;
# a directory with none has nothing to change.
public_keys_readable() { # public_keys_readable DIR
    for k in "$1"/ssh_host_*.pub; do
        [ ! -f "$k" ] || chmod 644 "$k" || return 1
    done
}

# Archives the configuration under ROOTDIR on the recovery partition, mounted
# at RECOVERY_MNT: the files of CONFIG_FILES, both servers' host keys and the
# accounts' keys. They go into the slot that does not hold the current
# archive, which stays whole until the new slot is complete and synced and
# has its generation, one more than the current one. The old archives
# rach2-config, .new and .old are removed after that. A file the root does
# not have is left out, except the account files, without which the run ends.
# With MARK, the slot has a file update-in-progress that holds it, the name
# and length of the image being written, so a retry after a stop takes the
# archive and not the root, which is the image's by then. The file `root`
# holds archive_root, `ENTRY START`, the root partition's entry and first
# sector, and `update-keep` holds archive_keep, `ENTRY SHA256`, the partition
# whose rach2-update-keep/keep.tar is an update's copy of the root and that
# file's hash; each is left out when its variable is empty. The slot written
# is left in next_archive; any failure ends the run.
write_archive() { # write_archive ROOTDIR [MARK]
    recover_archive
    for f in $ARCHIVE_NEEDS; do
        [ -f "$1/$f" ] || die "$f is not among the files to archive"
    done
    [ "$generation" -lt 2147483647 ] || die "the archive generation counter is exhausted"
    next_archive="$RECOVERY_MNT/rach2-config-a"
    if [ "$archive" = "$next_archive" ]; then
        next_archive="$RECOVERY_MNT/rach2-config-b"
    fi
    rm -f "$next_archive/generation" || die "the old generation could not be removed"
    sync
    rm -rf "$next_archive" || die "the other archive slot could not be removed"
    mkdir -p "$next_archive/etc/rach2" ||
        die "the archive directory could not be made on the recovery partition"
    for f in $CONFIG_FILES; do
        if [ -e "$1/$f" ]; then
            keep_copy "$1/$f" "$next_archive/$f" || die "$f could not be archived"
        fi
    done
    if [ -d "$1/etc/dropbear" ]; then
        cp -R "$1/etc/dropbear" "$next_archive/etc/dropbear" ||
            die "the host keys could not be archived"
    fi
    if ssh_host_keys "$1"; then
        { mkdir -p "$next_archive/etc/ssh" && cp "$1"/etc/ssh/ssh_host_* "$next_archive/etc/ssh/"; } ||
            die "OpenSSH's host keys could not be archived"
    fi
    archive_account_keys "$1" || die "the account keys could not be archived"
    if [ -n "$archive_root" ]; then
        echo "$archive_root" > "$next_archive/root" ||
            die "the root partition's place could not be archived"
    fi
    if [ -n "$archive_keep" ]; then
        echo "$archive_keep" > "$next_archive/update-keep" ||
            die "the place of the update's copy could not be archived"
    fi
    if [ -n "${2:-}" ]; then
        echo "$2" > "$next_archive/update-in-progress" ||
            die "the update's mark could not be written to the archive"
    fi
    sync
    echo "$((generation + 1))" > "$next_archive/generation" ||
        die "the archive generation could not be written"
    sync
    rm -rf "$RECOVERY_MNT/rach2-config" "$RECOVERY_MNT/rach2-config.new" \
        "$RECOVERY_MNT/rach2-config.old" ||
        die "the legacy archives could not be removed"
}

# root_path ROOT PATH: prints where PATH leads in the tree at ROOT, as a
# process whose root directory is ROOT finds it, with ROOT in front. Each
# symbolic link along PATH is followed with ROOT as `/`, and `..` at ROOT
# stays there, so the result is ROOT or a path below it however PATH or the
# links in the tree are written. A home field of passwd is read this way
# before anything is copied from it, removed or given an owner: a home of
# `/../../mnt/other`, or one through a link to `/mnt`, would otherwise reach
# outside the disk being written. A component that does not exist is taken as
# written. Status 1 after 40 links, as Linux's ELOOP, or when a link cannot be
# read. Run it in a command substitution.
root_path() { # root_path ROOT PATH
    rest=$2
    done_path=""
    links=0
    while [ -n "$rest" ]; do
        case "$rest" in
            /*)
                rest=${rest#/}
                continue
                ;;
        esac
        part=${rest%%/*}
        if [ "$part" = "$rest" ]; then
            rest=""
        else
            rest=${rest#*/}
        fi
        case "$part" in
            .) continue ;;
            ..)
                done_path=${done_path%/*}
                continue
                ;;
        esac
        if [ -L "$1$done_path/$part" ]; then
            links=$((links + 1))
            [ "$links" -le 40 ] || return 1
            link=$(readlink "$1$done_path/$part") || return 1
            case "$link" in /*) done_path="" ;; esac
            rest=$link${rest:+/$rest}
            continue
        fi
        done_path=$done_path/$part
    done
    printf '%s\n' "$1$done_path"
}

# Whether the resolved path PATH is ROOT/home or a path below it.
under_home() { # under_home ROOT PATH
    case "$2" in "$1/home" | "$1/home/"*) return 0 ;; esac
    return 1
}

# pin_key_links ROOT TREE COPY [KEPT]: makes each symbolic link of COPY, a
# copy of the key directory TREE of the root at ROOT, lead where it led in
# TREE. TREE is a path root_path printed, ROOT in front. COPY goes back at
# another depth, or into a root that has nothing of TREE's surroundings, so
# a link as written may lead elsewhere there or nowhere. Each link is read
# where it stands in TREE, by root_path. One that leads inside TREE is
# written again relative to its place in COPY. With KEPT, the update's copy,
# one that leads under ROOT/home, which the update keeps whole, is written
# again as the absolute path it leads to. One that leads to a regular file
# elsewhere is replaced by a copy of that file, with its owner and mode, and
# a later link to the same file, by name or by a hard link, by a link to that
# copy. Any other, leading to a directory, a device or nothing outside TREE,
# is written as the absolute path it leads to in the archive's copy, and
# with KEPT ends the run, before the root is written: the update would lose
# what it leads to, or let it lead to the new image's file of that name. A
# name with a newline in COPY ends the run too.
pin_key_links() { # pin_key_links ROOT TREE COPY [KEPT]
    pin_bad=$(find "$3" -name '*
*') || die "${2#"$1"} could not be read"
    [ -z "$pin_bad" ] || die "${2#"$1"} holds a name with a newline, which the update cannot keep"
    pin_links=$(find "$3" -type l) || die "${2#"$1"} could not be read"
    pin_made=""
    while IFS= read -r pin_l; do
        [ -n "$pin_l" ] || continue
        pin_p=${pin_l#"$3"/}
        pin_t=$(root_path "$1" "${2#"$1"}/$pin_p") ||
            die "${2#"$1"}/$pin_p leads through too many links"
        pin_abs=${pin_t#"$1"}
        pin_abs=${pin_abs:-/}
        if [ "$pin_t" = "$2" ] || [ "${pin_t#"$2"/}" != "$pin_t" ]; then
            pin_up=$(printf '%s\n' "$pin_p" | sed 's|[^/]*/|../|g; s|[^/]*$||')
            pin_to=${pin_t#"$2"}
            pin_to=$pin_up${pin_to#/}
            pin_to=${pin_to%/}
            { rm -f "$pin_l" && ln -s "${pin_to:-.}" "$pin_l"; } ||
                die "${2#"$1"}/$pin_p could not be kept"
            continue
        fi
        if [ -n "${4:-}" ] && under_home "$1" "$pin_t"; then
            { rm -f "$pin_l" && ln -s "$pin_abs" "$pin_l"; } ||
                die "${2#"$1"}/$pin_p could not be kept"
            continue
        fi
        if [ -f "$pin_t" ]; then
            pin_id=$(stat -c %d:%i "$pin_t") || die "$pin_abs could not be read"
            pin_first=$(printf '%s' "$pin_made" | awk -v id="$pin_id" '$1 == id {
                print substr($0, length(id) + 2); exit }')
            if [ -n "$pin_first" ]; then
                pin_up=$(printf '%s\n' "$pin_p" | sed 's|[^/]*/|../|g; s|[^/]*$||')
                { rm -f "$pin_l" && ln -s "$pin_up$pin_first" "$pin_l"; } ||
                    die "${2#"$1"}/$pin_p could not be kept"
            else
                { rm -f "$pin_l" && cp -a "$pin_t" "$pin_l"; } ||
                    die "$pin_abs, which ${2#"$1"}/$pin_p leads to, could not be kept"
                pin_made="$pin_made$pin_id $pin_p
"
            fi
            continue
        fi
        [ -z "${4:-}" ] || die "${2#"$1"}/$pin_p leads to $pin_abs, which is no file the \
update keeps; copy what it needs into ${2#"$1"} or remove the link, and run this again; nothing was written"
        { rm -f "$pin_l" && ln -s "$pin_abs" "$pin_l"; } ||
            die "${2#"$1"}/$pin_p could not be kept"
    done <<EOF
$pin_links
EOF
}

# keep_root_directory PATH COPY: copies the directory PATH of the root at
# TARGET_MNT to COPY, PATH read inside that root by root_path, as a home is.
# A PATH that is a symbolic link leading under /home is kept as a link straight
# to the directory it leads to, since /home is kept whole and that directory
# is there after the write; a link through other links, such as /root to
# /srv/root and /srv/root to /home/root, would lead through directories that
# neither the copy nor the new root may have. Any other PATH is copied as the
# tree it leads to, which may not be on the new root. A PATH that leads to the
# root itself or to no directory is not copied. Status 1 when PATH leads
# through too many links or the copy fails.
keep_root_directory() { # keep_root_directory PATH COPY
    kept_dir=$(root_path "$TARGET_MNT" "$1") || return 1
    [ "$kept_dir" != "$TARGET_MNT" ] && [ -d "$kept_dir" ] || return 0
    if [ -L "$TARGET_MNT$1" ] && under_home "$TARGET_MNT" "$kept_dir"; then
        ln -s "${kept_dir#"$TARGET_MNT"}" "$2"
    else
        cp -a "$kept_dir" "$2"
    fi
}

# archive_account_keys ROOTDIR: stores the .ssh directory of each account of
# ROOTDIR/etc/passwd with a numeric id and an absolute home in the tar file
# keys/UID.tar of the slot next_archive names, the home read inside ROOTDIR
# by root_path. A tar file keeps the tree's names as they are, where FAT32
# would fold their case and match a name such as `ABCDEF~1` to the short
# alias of another, and keeps its symbolic and hard links, which FAT32 cannot
# hold. The tree is copied first to a scratch directory under /dev/shm, or
# /tmp where there is none, and its links made by pin_key_links to lead where
# they led in ROOTDIR, so that a key that is a link out of .ssh is archived
# with its bytes. The file is named by the id, which has no case to fold, and
# when accounts share an id the first of them in passwd has it, whether or
# not that account has keys. A .ssh that leads to ROOTDIR itself is not
# stored. It runs in a subshell, and its status is 1 when a home could not be
# read or a tree could not be stored.
archive_account_keys() (
    scratch=/tmp
    [ -d /dev/shm ] && scratch=/dev/shm
    stage=$(mktemp -d "$scratch/rach2-install.XXXXXX") ||
        die "there is nowhere to stage the account keys"
    trap 'rm -rf "$stage"' EXIT
    seen=" "
    while IFS=: read -r _name _password uid _gid _gecos home _shell; do
        case "$uid" in "" | *[!0-9]*) continue ;; esac
        case "$seen" in *" $uid "*) continue ;; esac
        seen="$seen$uid "
        case "$home" in /*) ;; *) continue ;; esac
        keys=$(root_path "$1" "$home/.ssh") || die "$home/.ssh leads through too many links"
        [ "$keys" != "$1" ] && [ -d "$keys" ] || continue
        { rm -rf "$stage/keys" && cp -a "$keys" "$stage/keys"; } ||
            die "$home/.ssh could not be archived"
        pin_key_links "$1" "$keys" "$stage/keys"
        { mkdir -p "$next_archive/keys" &&
            tar -cf "$next_archive/keys/$uid.tar" -C "$stage/keys" .; } ||
            die "$home/.ssh could not be archived"
    done < "$1/etc/passwd"
    rm -rf "$stage"
)

# add_lines FILE TEXT: TEXT's lines appended to FILE, after a newline when
# FILE's last line has none.
add_lines() {
    [ -n "$2" ] || return 0
    if [ -s "$1" ] && [ -n "$(tail -c 1 "$1")" ]; then
        printf '\n' >> "$1" || return 1
    fi
    printf '%s\n' "$2" >> "$1"
}

# keep_image_accounts IMAGE DEST: adds the image's system accounts to the
# account files under DEST. The files an install writes and an update keeps
# were made for a root that may not have had these accounts, and a program of
# the image, such as the GNU root's OpenSSH with its `sshd`, does not start
# without its own.
#
# A system account is one of an id below 1000, or of 65534, the id of `nobody`
# and `nogroup` as on Linux. A system account of IMAGE/etc/passwd is appended
# to DEST/etc/passwd when DEST has neither its name nor its id. A system group
# of IMAGE/etc/group is appended to DEST/etc/group when DEST has neither its
# name nor its id, whether or not an account comes with it, as the GNU root's
# `crontab` comes alone; but the primary group of an image account whose name
# or id DEST gives another account stays out. An image shadow line is appended
# to DEST/etc/shadow for each system account that DEST has by the image's name
# and id and has no shadow line for: one appended here, or one an older image
# gave without a line. An id is compared as a number, and a name or an id the
# image has twice is taken once. Status 0 with nothing done when IMAGE has no
# etc/passwd, and 1 when a file could not be read or written.
keep_image_accounts() {
    [ -f "$1/etc/passwd" ] || return 0
    added=$(awk -F: 'FILENAME == ARGV[1] { name[$1] = 1; id[$3 + 0] = 1; next }
        ($3 + 0 < 1000 || $3 + 0 == 65534) && !($1 in name) && !(($3 + 0) in id) {
            print; name[$1] = 1; id[$3 + 0] = 1
        }' "$2/etc/passwd" "$1/etc/passwd") || return 1
    groups=
    if [ -f "$1/etc/group" ]; then
        groups=$(awk -F: 'FILENAME == ARGV[1] { name[$1] = 1; id[$3 + 0] = 1; next }
            FILENAME == ARGV[2] { uid[$1] = $3 + 0; used[$3 + 0] = 1; next }
            FILENAME == ARGV[3] {
                if (($3 + 0 < 1000 || $3 + 0 == 65534) && (($1 in uid) || (($3 + 0) in used)) &&
                    !(($1 in uid) && uid[$1] == $3 + 0))
                    refused[$4 + 0] = 1
                next
            }
            ($3 + 0 < 1000 || $3 + 0 == 65534) && !($1 in name) && !(($3 + 0) in id) &&
                !(($3 + 0) in refused) {
                print; name[$1] = 1; id[$3 + 0] = 1
            }' "$2/etc/group" "$2/etc/passwd" "$1/etc/passwd" "$1/etc/group") || return 1
    fi
    add_lines "$2/etc/passwd" "$added" || return 1
    add_lines "$2/etc/group" "$groups" || return 1
    [ -f "$1/etc/shadow" ] && [ -f "$2/etc/shadow" ] || return 0
    lines=$(awk -F: '
        FILENAME == ARGV[1] { if ($3 + 0 < 1000 || $3 + 0 == 65534) uid[$1] = $3 + 0; next }
        FILENAME == ARGV[2] { if (($1 in uid) && uid[$1] == $3 + 0) same[$1] = 1; next }
        FILENAME == ARGV[3] { have[$1] = 1; next }
        ($1 in same) && !($1 in have) { print; have[$1] = 1 }' \
        "$2/etc/passwd" "$1/etc/passwd" "$2/etc/shadow" "$1/etc/shadow") || return 1
    add_lines "$2/etc/shadow" "$lines"
}

# Copies the key tree SOURCE, taken from the archive, to DESTINATION, and
# ends the run when it cannot. SOURCE is a tar file, as archive_account_keys
# writes, or a directory, as an archive of an older version holds. A tar file
# gives each file and directory, DESTINATION among them, the numeric owner
# and the mode it had in the tree archived: a file of root's, or of another
# account, that the tree held through a hard link or a link out of .ssh
# stays that owner's, and is not given to the account whose home it is
# restored to. A symbolic link it holds is root's. A directory records
# neither owners nor modes on FAT32, and SSH checks them, so it is given
# OWNER, mode 700 on its directories and 600 on its files, before cp -a puts
# the copy on the new root; a symbolic link is given the owner and not
# followed.
restore_key_directory() { # restore_key_directory SOURCE DESTINATION OWNER
    if [ -f "$1" ]; then
        { mkdir -p "$2" && tar -xf "$1" --numeric-owner -C "$2"; } ||
            die "$1 could not be restored to $2"
        return 0
    fi
    { mkdir -p "$2" && cp -R "$1/." "$2/"; } || die "$1 could not be restored to $2"
    if ! { chown -R -h "$3" "$2" &&
        find "$2" -type d -exec chmod 700 {} + &&
        find "$2" -type f -exec chmod 600 {} +; }; then
        die "$1 could not be restored with its owner and modes"
    fi
}

# Puts the archive's host keys and account keys into the copy at `keep`, for
# an update that takes the configuration from the archive. Each account of
# keep/etc/passwd with an id of 1000 or more and a home under /home is given
# that home, empty when the archive has no keys for it, since the copy's home
# tree replaces all of the image's homes after the write. An account has keys
# only when the archive has keys/UID.tar for its id, or keys/UID from an older
# version. A home is read inside `keep` by root_path, and one that is not
# there yet is made with the account's owner and mode 700; one that is there
# keeps its own. Accounts of different ids whose homes are one directory
# share its .ssh, which the archive holds once for each id: it is restored
# once, from the first of them in passwd, and the others' copies must be the
# same, or the run ends before the root is written, since the update cannot
# give that .ssh to both. The recovery partition must be mounted at
# RECOVERY_MNT. It runs in a subshell, and its status is 1 when a home or a
# key could not be restored.
restore_archive_keys() (
    restored=""
    recover_archive
    if [ -d "$archive/etc/dropbear" ]; then
        restore_key_directory "$archive/etc/dropbear" "$keep/etc/dropbear" 0:0
    fi
    if ssh_host_keys "$archive"; then
        { mkdir -p "$keep/etc/ssh" && cp "$archive"/etc/ssh/ssh_host_* "$keep/etc/ssh/" &&
            chown 0:0 "$keep"/etc/ssh/ssh_host_* && chmod 600 "$keep"/etc/ssh/ssh_host_* &&
            public_keys_readable "$keep/etc/ssh"; } ||
            die "OpenSSH's host keys could not be restored with their owner and modes"
    fi
    while IFS=: read -r _name _password uid gid _gecos home _shell; do
        case "$uid" in "" | *[!0-9]*) continue ;; esac
        case "$home" in /*) ;; *) continue ;; esac
        dir=$(root_path "$keep" "$home") || exit 1
        keys=""
        if [ -f "$archive/keys/$uid.tar" ]; then
            keys=$archive/keys/$uid.tar
        elif [ -d "$archive/keys/$uid" ]; then
            keys=$archive/keys/$uid
        fi
        case "$dir" in
            "$keep/home/"*) [ "$uid" -ge 1000 ] || [ -n "$keys" ] || continue ;;
            *) [ -n "$keys" ] || continue ;;
        esac
        if [ ! -d "$dir" ]; then
            mkdir -p "$dir" && chmod 700 "$dir" && chown "$uid:$gid" "$dir" || exit 1
        fi
        [ -n "$keys" ] || continue
        # $keys is under RECOVERY_MNT and has no space; the rest is the place.
        first=$(printf '%s' "$restored" | D="$dir/.ssh" awk '
            substr($0, index($0, " ") + 1) == ENVIRON["D"] { print $1; exit }')
        if [ -n "$first" ]; then
            if [ -f "$first" ] && [ -f "$keys" ]; then
                cmp -s "$first" "$keys"
            elif [ -d "$first" ] && [ -d "$keys" ]; then
                diff -r "$first" "$keys" > /dev/null 2>&1
            else
                false
            fi || die "$first and $keys are different keys for one $home/.ssh, shared by accounts \
of different ids, and the update cannot restore both; nothing was written"
            continue
        fi
        restored="$restored$keys $dir/.ssh
"
        restore_key_directory "$keys" "$dir/.ssh" "$uid:$gid"
    done < "$keep/etc/passwd"
)

# ---- an MBR disk's conversion ----
#
# A disk installed with an MBR is converted by an update to boot by UEFI as
# well, when GRUB's EFI image, `bootx64.efi`, is beside the image, where the
# install stick carries it. The disk keeps its MBR; its boot partition becomes
# the EFI system partition, type 0xEF, which UEFI firmware boots from on an MBR
# disk, and the image goes into it as \EFI\BOOT\BOOTX64.EFI beside the
# kernels, where the image's prefix opens the menu the BIOS core opens.
#
# UEFI firmware reads a FAT32 volume only with 65525 clusters or more, and a
# 64 MiB boot partition made at eight sectors to a cluster has 16348. A boot
# partition with fewer clusters has its file system made again at one sector
# to a cluster, with every file it held put back and its serial kept, since the
# menu finds the kernels' partition by that serial; the files are kept on the
# recovery partition meanwhile, where an update run again after a stop finds
# them. A boot partition of less than 33 MiB holds no FAT32 volume of that
# many clusters, and its disk is left to boot by BIOS alone, as one is when
# the image is not there or the recovery partition cannot keep the files.

# Prints the clusters of the FAT volume on NODE, as a FAT driver counts them
# from the boot sector: the data sectors after the reserved ones and the FATs,
# by the sectors of a cluster. A boot sector with no sectors to a cluster
# prints 0.
fat_clusters() { # fat_clusters NODE
    dd if="$1" bs=512 count=1 2>/dev/null | od -An -tu1 -v | awk '
        { for (i = 1; i <= NF; i++) b[n++] = $i }
        END {
            total = b[19] + 256 * b[20]
            if (total == 0) total = b[32] + 256 * (b[33] + 256 * (b[34] + 256 * b[35]))
            fat = b[22] + 256 * b[23]
            if (fat == 0) fat = b[36] + 256 * (b[37] + 256 * (b[38] + 256 * b[39]))
            if (b[13] == 0) { print 0; exit }
            print int((total - (b[14] + 256 * b[15]) - b[16] * fat) / b[13])
        }'
}

# Copies the volume serial, the four bytes at offset 67 of the boot sector
# saved in the file SAVED, into the boot sector of the FAT32 volume on NODE
# and into its backup, at the sector that bytes 50 and 51 of NODE's boot
# sector name. SCRATCH is a file for the sector being changed. Status 1 when
# a read or a write fails.
keep_serial() { # keep_serial SAVED NODE SCRATCH
    serial_backup=$(dd if="$2" bs=512 count=1 2>/dev/null | od -An -tu1 -j 50 -N 2 |
        awk '{ print $1 + 256 * $2 }')
    for serial_at in 0 $serial_backup; do
        dd if="$2" of="$3" bs=512 skip="$serial_at" count=1 2>/dev/null &&
            dd if="$1" of="$3" bs=1 skip=67 seek=67 count=4 conv=notrunc 2>/dev/null &&
            dd if="$3" of="$2" bs=512 seek="$serial_at" count=1 conv=notrunc 2>/dev/null ||
            return 1
    done
}

# Status 0 when the directory COPY holds the files and directories of DIR
# and no others, each file with DIR's bytes; status 1 otherwise.
same_tree() { # same_tree DIR COPY
    [ "$(cd "$1" && find . | sort)" = "$(cd "$2" && find . | sort)" ] || return 1
    (cd "$1" && find . -type f) | {
        while IFS= read -r slot_f; do
            cmp -s "$1/$slot_f" "$2/$slot_f" || exit 1
        done
    }
}

# Make the file system of the boot partition BOOT again, one UEFI firmware
# reads, with what it held put back. Its first sector and its files are kept
# on the recovery partition first, mounted at $RECOVERY_MNT, compared whole
# with BOOT once synced, and marked whole by the file `complete`, written
# last. A stop part way leaves a boot partition the BIOS core reads no menu
# from, and it starts the recovery system from partition 2 by its label
# instead; the update run again there finds the files and finishes the job
# (`resume_boot_partition`). Returns 1, with nothing written to BOOT, when
# the files could not be kept whole on the recovery partition, which is
# mostly for want of room; any other failure ends the run.
remake_boot_partition() { # remake_boot_partition BOOT
    boot_keep="$RECOVERY_MNT/rach2-boot-keep"
    rm -rf "$boot_keep" || die "an old copy of $1's files could not be removed; nothing was written"
    mkdir -p "$BOOT_MNT" 2>/dev/null
    mount -t vfat -o ro "$1" "$BOOT_MNT" || die "$1 would not mount; nothing was written"
    mounted_boot=$BOOT_MNT
    if ! { mkdir -p "$boot_keep/files" &&
        dd if="$1" of="$boot_keep/sector" bs=512 count=1 2>/dev/null &&
        cp -R "$BOOT_MNT/." "$boot_keep/files/" && sync &&
        dd if="$1" bs=512 count=1 2>/dev/null | cmp -s - "$boot_keep/sector" &&
        same_tree "$BOOT_MNT" "$boot_keep/files" &&
        echo whole > "$boot_keep/complete" && sync; }; then
        rm -rf "$boot_keep"
        umount "$BOOT_MNT" || die "$1 would not unmount; nothing was written"
        mounted_boot=""
        return 1
    fi
    umount "$BOOT_MNT" || die "$1 would not unmount; nothing was written"
    mounted_boot=""
    rebuild_boot_partition "$1" "$boot_keep"
}

# Make the file system of BOOT again from the first sector and the files kept
# in KEEP, and drop KEEP once what was made, mounted again read-only, holds
# KEEP's files whole and `bootctl` reads it. The menu goes back last, through
# grub.cfg.new and a rename, once the environment block, whose saved default
# is recovery, and the kernels are back, synced and compared: until it has
# its name the BIOS core and the EFI image find no menu and start the
# recovery system. A failure ends the run and leaves KEEP for the update run
# again.
rebuild_boot_partition() { # rebuild_boot_partition BOOT KEEP
    boot_kept="its files are kept on the recovery partition, and this update run again \
from the recovery system puts them back"
    say "making $1's file system again, at one sector to a cluster, for UEFI firmware"
    mkfs.vfat -n RACH2BOOT "$1" > /dev/null || die "$1's file system was not made; $boot_kept"
    keep_serial "$2/sector" "$1" "$2/new" || die "$1's serial was not kept; $boot_kept"
    [ "$(fat_clusters "$1")" -ge 65525 ] ||
        die "$1's new file system has fewer clusters than UEFI firmware reads; $boot_kept"
    mkdir -p "$BOOT_MNT" 2>/dev/null
    mount -t vfat "$1" "$BOOT_MNT" || die "$1's new file system would not mount; $boot_kept"
    mounted_boot=$BOOT_MNT
    boot_menu=boot/grub/grub.cfg
    { (cd "$2/files" && find . -type d) | {
        while IFS= read -r slot_f; do
            mkdir -p "$BOOT_MNT/$slot_f" || exit 1
        done
    } && (cd "$2/files" && find . -type f ! -path "./$boot_menu") | {
        while IFS= read -r slot_f; do
            cp "$2/files/$slot_f" "$BOOT_MNT/$slot_f" || exit 1
        done
    } && sync && (cd "$2/files" && find . -type f ! -path "./$boot_menu") | {
        while IFS= read -r slot_f; do
            cmp -s "$2/files/$slot_f" "$BOOT_MNT/$slot_f" || exit 1
        done
    }; } || die "$1's files were not put back; $boot_kept"
    if [ -f "$2/files/$boot_menu" ]; then
        { cp "$2/files/$boot_menu" "$BOOT_MNT/$boot_menu.new" && sync &&
            cmp -s "$2/files/$boot_menu" "$BOOT_MNT/$boot_menu.new" &&
            mv "$BOOT_MNT/$boot_menu.new" "$BOOT_MNT/$boot_menu" && sync; } ||
            die "$1's menu was not put back; $boot_kept"
    fi
    umount "$BOOT_MNT" || die "$1 would not unmount; $boot_kept"
    mounted_boot=""
    mount -t vfat -o ro "$1" "$BOOT_MNT" || die "$1, made again, would not mount to be compared; $boot_kept"
    mounted_boot=$BOOT_MNT
    same_tree "$2/files" "$BOOT_MNT" || die "$1, made again, does not hold its kept files whole; $boot_kept"
    umount "$BOOT_MNT" || die "$1 would not unmount; $boot_kept"
    mounted_boot=""
    bootctl --target "$1" status > /dev/null ||
        die "$1, made again, is not a boot partition bootctl reads; $boot_kept"
    { rm -f "$2/complete" && sync && rm -rf "$2"; } ||
        say "the copy of $1's files on the recovery partition could not be removed"
}

# Finish the remake of BOOT that a stop cut short: its files are on the
# recovery partition of the disk being updated, marked whole, and BOOT holds
# no file system, an empty one or a part of its files. A copy not marked
# whole was cut short before BOOT was touched, and the next remake removes it.
# `target` names the disk; a disk with no recovery partition has nothing to
# finish.
resume_boot_partition() { # resume_boot_partition BOOT
    find_recovery "$target" || return 0
    mounted_recovery=$RECOVERY_MNT
    if [ -f "$RECOVERY_MNT/rach2-boot-keep/complete" ]; then
        say "the conversion of $1 was stopped part way; its files are on the recovery partition"
        rebuild_boot_partition "$1" "$RECOVERY_MNT/rach2-boot-keep"
    fi
    umount "$RECOVERY_MNT" || die "the recovery partition would not unmount"
    mounted_recovery=""
}

# The menu, a file of the boot partition that is replaced whole, is replaced
# so that a stop leaves it whole under its name or under FILE.keep. FAT32
# renames over a name by freeing the old file's entries and the new one's
# before it writes the name again (fat_rename in fat32.c), so a stop between
# those writes leaves neither name. The new bytes are written to FILE.new; a
# copy of them, FILE.keep, is compared and synced before FILE.new is renamed
# over FILE; and FILE.keep is removed only once FILE has its name again. So
# FILE.keep is whole whenever FILE is not there. A missing menu sends the BIOS
# core and the EFI image to the recovery partition's own menu. GRUB's EFI
# image never loses its name, since UEFI firmware finds no other loader on
# the disk (`replace_loader`); `finish_file` also puts back the FILE.keep of
# it that an older version of this program left.

# Status 0 when FILE, on a boot partition mounted writable, is whole under
# its name: put back from FILE.keep when a stop in `publish_file` took its
# name, and with the spare copies of a replacement removed. A file with no
# kept copy that is not there is left as it is. Status 1 when a write fails.
finish_file() { # finish_file FILE
    if [ ! -e "$1" ] && [ -e "$1.keep" ]; then
        { rm -f "$1.new" && cp "$1.keep" "$1.new" && sync &&
            cmp -s "$1.keep" "$1.new" && mv "$1.new" "$1" && sync; } || return 1
        say "$1, whose name a stop took while it was replaced, is put back from its kept copy"
    fi
    [ -e "$1" ] || return 0
    rm -f "$1.new" "$1.keep" && sync
}

# Give FILE, on a boot partition mounted writable, the bytes of FILE.new,
# which the caller has written whole after `finish_file`, in the order above;
# a FILE not there yet has nothing to keep and takes FILE.new's name alone.
# Status 1 when a write or a comparison fails; FILE.keep stays when FILE
# may have lost its name.
publish_file() { # publish_file FILE
    sync || return 1
    if [ -e "$1" ]; then
        { rm -f "$1.keep" && cp "$1.new" "$1.keep" && sync &&
            cmp -s "$1.new" "$1.keep"; } || return 1
    fi
    mv -f "$1.new" "$1" && sync && rm -f "$1.keep" && sync
}

# ---- GRUB's EFI image ----
#
# UEFI firmware finds the loader of an MBR disk by one name alone,
# \EFI\BOOT\BOOTX64.EFI, so GRUB's EFI image is replaced without a moment in
# which that name is missing or holds part of a file, and a stop anywhere
# leaves the disk booting by UEFI. The new image is written beside the old one
# as BOOTX64.TMP, whose name, like BOOTX64.EFI, is a short name with one
# directory entry, synced and compared with the image. With no loader there
# yet, BOOTX64.TMP is renamed, which rewrites its one entry in place. With
# one, the volume is unmounted and the two entries' first clusters and sizes
# are swapped in one write of the directory sector that holds both, which
# moves the name from the old file to the new one at once; the old image,
# then named BOOTX64.TMP, is removed. A stop leaves BOOTX64.EFI whole, with
# the old image or the new one, and perhaps a BOOTX64.TMP, which
# `finish_loader` removes.

# Status 0 when the directory DIR of a boot partition mounted writable,
# \EFI\BOOT, holds no copy that a stop in `replace_loader` left: a
# BOOTX64.TMP is removed, as is the BOOTX64.NEW an older version of this
# program wrote, and a BOOTX64.EFI.keep is put back or removed as
# `finish_file` does. Status 1 when a write fails.
finish_loader() { # finish_loader DIR
    finish_file "$1/BOOTX64.EFI" || return 1
    [ -e "$1/BOOTX64.TMP" ] || [ -e "$1/BOOTX64.NEW" ] || return 0
    rm -f "$1/BOOTX64.TMP" "$1/BOOTX64.NEW" && sync
}

# Reads the boot sector of the FAT32 volume on NODE past the cache into
# fat_spc, its sectors to a cluster, fat_reserved, the sectors before the
# first FAT, fat_data, the first sector of cluster 2, fat_count, its
# clusters, and fat_root, the root directory's first cluster. Status 1 for a
# volume that is not FAT32 with 512-byte sectors, or a failed read.
fat_geometry() { # fat_geometry NODE
    fat_geo=$(dd if="$1" bs=512 count=1 2>/dev/null | od -An -tu1 -v | awk '
        { for (i = 1; i <= NF; i++) b[n++] = $i }
        END {
            total = b[19] + 256 * b[20]
            if (total == 0) total = b[32] + 256 * (b[33] + 256 * (b[34] + 256 * b[35]))
            fat = b[36] + 256 * (b[37] + 256 * (b[38] + 256 * b[39]))
            if (n != 512 || b[11] + 256 * b[12] != 512 || b[13] == 0 ||
                b[22] + 256 * b[23] != 0 || fat == 0) exit 1
            reserved = b[14] + 256 * b[15]
            data = reserved + b[16] * fat
            print b[13], reserved, data, int((total - data) / b[13]),
                b[44] + 256 * (b[45] + 256 * (b[46] + 256 * b[47]))
        }') || return 1
    # shellcheck disable=SC2086
    set -- $fat_geo
    [ "$#" -eq 5 ] || return 1
    fat_spc=$1 fat_reserved=$2 fat_data=$3 fat_count=$4 fat_root=$5
}

# Prints the cluster after CLUSTER in its chain, from the first FAT of the
# volume on NODE that `fat_geometry` read. Status 1 when the read fails.
fat_next() { # fat_next NODE CLUSTER
    dd if="$1" bs=512 skip=$((fat_reserved + $2 / 128)) count=1 2>/dev/null |
        od -An -tu1 -v -j $(($2 % 128 * 4)) -N 4 |
        awk 'NF == 4 { print $1 + 256 * ($2 + 256 * ($3 + 256 * ($4 % 16))); found = 1 }
            END { exit !found }'
}

# Prints the short directory entry NAME, its eleven bytes as FAT stores
# them, of the directory whose first cluster is CLUSTER on the volume on NODE
# that `fat_geometry` read, past the cache: the sector that holds it, its
# offset there, its attributes, its first cluster and its size. Status 1
# when the directory has no such entry or a read fails.
fat_entry() { # fat_entry NODE CLUSTER NAME
    fat_want=$(printf '%s' "$3" | od -An -tu1 -v)
    fat_at=$2
    fat_steps=0
    while [ "$fat_at" -ge 2 ] && [ "$fat_at" -lt $((fat_count + 2)) ] &&
        [ "$fat_steps" -le "$fat_count" ]; do
        fat_sector=$((fat_data + (fat_at - 2) * fat_spc))
        fat_got=$(dd if="$1" bs=512 skip="$fat_sector" count="$fat_spc" 2>/dev/null |
            od -An -tu1 -v | awk -v want="$fat_want" -v sector="$fat_sector" \
            -v bytes=$((fat_spc * 512)) '
            BEGIN { split(want, w, " ") }
            { for (i = 1; i <= NF; i++) b[n++] = $i }
            END {
                if (n != bytes) { print "fault"; exit }
                for (e = 0; e < n; e += 32) {
                    if (b[e] == 0) { print "end"; exit }
                    if (b[e] == 229 || b[e + 11] % 64 == 15) continue
                    i = 0
                    while (i < 11 && b[e + i] == w[i + 1]) i++
                    if (i < 11) continue
                    print sector + int(e / 512), e % 512, b[e + 11],
                        (b[e + 20] + 256 * b[e + 21]) * 65536 + b[e + 26] + 256 * b[e + 27],
                        b[e + 28] + 256 * (b[e + 29] + 256 * (b[e + 30] + 256 * b[e + 31]))
                    exit
                }
            }')
        case "$fat_got" in
            "") ;;
            end | fault) return 1 ;;
            *)
                echo "$fat_got"
                return 0
                ;;
        esac
        fat_at=$(fat_next "$1" "$fat_at") || return 1
        fat_steps=$((fat_steps + 1))
    done
    return 1
}

# Copies COUNT bytes at offset FROM of the file SOURCE to offset TO of DEST.
put_bytes() { # put_bytes SOURCE DEST FROM TO COUNT
    dd if="$1" of="$2" bs=1 skip="$3" seek="$4" count="$5" conv=notrunc 2>/dev/null
}

# Make IMAGE GRUB's EFI image on the boot partition BOOT, mounted writable at
# $BOOT_MNT, where `finish_loader` has run, as described above; BOOT is
# mounted there again when it returns. A failure ends the run, with
# BOOTX64.EFI whole.
replace_loader() { # replace_loader BOOT IMAGE
    loader_dir="$BOOT_MNT/EFI/BOOT"
    loader_fail="GRUB's EFI image on $1 was not replaced; the root is not written"
    { cp "$2" "$loader_dir/BOOTX64.TMP" && sync && cmp -s "$2" "$loader_dir/BOOTX64.TMP"; } ||
        die "GRUB's EFI image could not be written to $1 beside the old one; $loader_fail"
    if [ ! -e "$loader_dir/BOOTX64.EFI" ]; then
        { mv "$loader_dir/BOOTX64.TMP" "$loader_dir/BOOTX64.EFI" && sync; } ||
            die "GRUB's EFI image on $1 could not take its name; the root is not written"
        return 0
    fi
    umount "$BOOT_MNT" || die "$1 would not unmount; $loader_fail"
    mounted_boot=""
    loader_node=$1
    loader_image=$2
    loader_size=$(wc -c < "$loader_image")
    fat_geometry "$loader_node" || die "$loader_node is not a FAT32 volume of 512-byte sectors; $loader_fail"
    loader_at=$fat_root
    for loader_name in "EFI        " "BOOT       "; do
        loader_entry=$(fat_entry "$loader_node" "$loader_at" "$loader_name") ||
            die "the directory \\EFI\\BOOT of $loader_node could not be read; $loader_fail"
        # shellcheck disable=SC2086
        set -- $loader_entry
        [ $(($3 & 16)) -ne 0 ] || die "\\EFI\\BOOT of $loader_node is not a directory; $loader_fail"
        loader_at=$4
    done
    { loader_old=$(fat_entry "$loader_node" "$loader_at" "BOOTX64 EFI") &&
        loader_new=$(fat_entry "$loader_node" "$loader_at" "BOOTX64 TMP"); } ||
        die "BOOTX64.EFI or BOOTX64.TMP has no short entry in \\EFI\\BOOT of $loader_node; $loader_fail"
    # The fields: sector, offset, attributes, first cluster and size of
    # BOOTX64.EFI, then of BOOTX64.TMP.
    # shellcheck disable=SC2086
    set -- $loader_old $loader_new
    [ "$#" -eq 10 ] && [ $(( ($3 | $8) & 24 )) -eq 0 ] && [ "$4" -ne "$9" ] &&
        [ "${10}" -eq "$loader_size" ] ||
        die "BOOTX64.EFI and BOOTX64.TMP in \\EFI\\BOOT of $loader_node are not the files written; $loader_fail"
    [ "$1" -eq "$6" ] ||
        die "the directory entries of BOOTX64.EFI and BOOTX64.TMP are in different sectors of \
$loader_node, so one write cannot swap them; remove the other files of \\EFI\\BOOT and run the update again"
    loader_tmp=$(mktemp -d /tmp/rach2-install.XXXXXX) || die "there is nowhere to change a sector; $loader_fail"
    loader_ok=0
    dd if="$loader_node" of="$loader_tmp/old" bs=512 skip="$1" count=1 2>/dev/null &&
        cp "$loader_tmp/old" "$loader_tmp/new" || loader_ok=1
    for loader_field in 20:2 26:2 28:4; do
        loader_by=${loader_field#*:}
        loader_field=${loader_field%:*}
        put_bytes "$loader_tmp/old" "$loader_tmp/new" $(($2 + loader_field)) \
            $(($7 + loader_field)) "$loader_by" &&
            put_bytes "$loader_tmp/old" "$loader_tmp/new" $(($7 + loader_field)) \
                $(($2 + loader_field)) "$loader_by" || loader_ok=1
    done
    [ "$loader_ok" -eq 0 ] && [ "$(wc -c < "$loader_tmp/new")" -eq 512 ] || {
        rm -rf "$loader_tmp"
        die "the sector of \\EFI\\BOOT on $loader_node could not be changed; $loader_fail"
    }
    # One sector, written whole or not at all, moves the name.
    dd if="$loader_tmp/new" of="$loader_node" bs=512 seek="$1" count=1 conv=notrunc 2>/dev/null &&
        sync && dd if="$loader_node" bs=512 skip="$1" count=1 2>/dev/null | cmp -s - "$loader_tmp/new" ||
        loader_ok=1
    rm -rf "$loader_tmp"
    [ "$loader_ok" -eq 0 ] ||
        die "the sector of \\EFI\\BOOT on $loader_node was not written; BOOTX64.EFI holds the old \
image or the new one, and the update run again finishes it"
    mount -t vfat "$loader_node" "$BOOT_MNT" ||
        die "$loader_node would not mount again; the root is not written"
    mounted_boot=$BOOT_MNT
    cmp -s "$loader_image" "$loader_dir/BOOTX64.EFI" 2>/dev/null ||
        die "BOOTX64.EFI on $loader_node does not hold the new image after the swap; the root is not written"
    { rm -f "$loader_dir/BOOTX64.TMP" && sync; } ||
        die "the old GRUB EFI image on $loader_node could not be removed; the root is not written"
}

# Finish or undo what a stop left of a slot's move on the boot partition
# BOOT, so that bootctl reads it again: it refuses a volume without both
# /boot/kernel and /boot/fallback. A slot's grown copy, kernel.new or
# fallback.new, is whole and checked before the slot is removed, so a copy
# with no slot beside it was cut off before its rename and becomes the slot,
# and a copy beside its slot is unfinished and is removed. A slot with no
# copy and no file, which no stop of `grow_slots` leaves, is made again from
# the other slot, with a note, since a bootable kernel in it is better than
# a disk bootctl cannot read. That copy is written as kernel.tmp or
# fallback.tmp, which a stop leaves partial and the next run removes first,
# compared with the other slot and synced, and only then renamed: both names
# are 8.3, so the rename rewrites the copy's one directory entry in place,
# and the slot's name never holds part of a kernel. The menu and GRUB's EFI
# image are put back first when a stop took their names while they were
# replaced (`finish_file`, `finish_loader`). The caller has proved that BOOT is this system's
# by reads alone (`boot_ours`).
finish_slots() { # finish_slots BOOT
    mkdir -p "$BOOT_MNT" 2>/dev/null
    mount -t vfat "$1" "$BOOT_MNT" || die "$1 would not mount to look at its kernel slots"
    mounted_boot=$BOOT_MNT
    finish_file "$BOOT_MNT/boot/grub/grub.cfg" ||
        die "$BOOT_MNT/boot/grub/grub.cfg, which a stop left, could not be put back"
    finish_loader "$BOOT_MNT/EFI/BOOT" ||
        die "GRUB's EFI image, which a stop left on $1, could not be put back"
    for slot in kernel fallback; do
        slot_copy="$BOOT_MNT/boot/$slot.tmp"
        [ -e "$slot_copy" ] || continue
        { rm -f "$slot_copy" && sync; } ||
            die "the unfinished copy $slot_copy of $1 could not be removed"
        say "removed an unfinished copy of the $slot slot of $1, which a stop left"
    done
    for slot in kernel fallback; do
        slot_file="$BOOT_MNT/boot/$slot"
        [ -e "$slot_file.new" ] || continue
        if [ -e "$slot_file" ]; then
            { rm -f "$slot_file.new" && sync; } ||
                die "the unfinished copy of the $slot slot of $1 could not be removed"
            say "removed an unfinished copy of the $slot slot of $1, which a stop left"
        else
            { mv "$slot_file.new" "$slot_file" && sync; } ||
                die "the grown $slot slot of $1 could not take its name"
            say "the grown $slot slot of $1, which a stop left under another name, takes its name"
        fi
    done
    for slot in kernel fallback; do
        slot_file="$BOOT_MNT/boot/$slot"
        [ ! -e "$slot_file" ] || continue
        slot_other="$BOOT_MNT/boot/fallback"
        [ "$slot" = kernel ] || slot_other="$BOOT_MNT/boot/kernel"
        [ -e "$slot_other" ] || die "$1 has neither kernel slot; run $ME --update to write it again"
        slot_copy="$slot_file.tmp"
        if ! { cp "$slot_other" "$slot_copy" && sync && cmp -s "$slot_other" "$slot_copy"; }; then
            rm -f "$slot_copy"
            sync
            die "the missing $slot slot of $1 could not be made again"
        fi
        { mv "$slot_copy" "$slot_file" && sync; } ||
            die "the copy of the missing $slot slot of $1 could not take its name"
        say "$1 had no $slot slot; it is made again as a copy of the other"
    done
    umount "$BOOT_MNT" || die "$1 would not unmount"
    mounted_boot=""
}

# Status 0 when DIR, the files of a boot partition, carry what only this
# system writes beside its kernel slots: the 1024-byte environment block and
# a menu with entries for both slots' kernels, read from grub.cfg.keep when
# a stop in its replacement took grub.cfg's name. It sets slot_count to the
# number of the two slots, /boot/kernel and /boot/fallback, that are files.
boot_marked() { # boot_marked DIR
    slot_count=0
    for slot in kernel fallback; do
        [ ! -f "$1/boot/$slot" ] || slot_count=$((slot_count + 1))
    done
    slot_menu="$1/boot/grub/grub.cfg"
    [ -e "$slot_menu" ] || slot_menu="$slot_menu.keep"
    [ -f "$1/boot/grub/grubenv" ] &&
        [ "$(wc -c < "$1/boot/grub/grubenv")" -eq 1024 ] &&
        grep -q 'rach2\.slot=candidate' "$slot_menu" 2>/dev/null &&
        grep -q 'rach2\.slot=fallback' "$slot_menu" 2>/dev/null
}

# Status 0 when the boot partition of DISK, a whole disk, is this system's:
# boot_marked, with one of its two slots or both. `bootctl status` is no
# proof, since it reads the slots' names and the volume's structure and
# neither the kernels nor the menu, and it refuses states a stop leaves that
# the writes after this repair: a slot missing, a grown copy whose chain FAT
# extended before it wrote the larger size, or two FATs that disagree. Status
# 1 otherwise. The partition is mounted read-only.
boot_ours() { # boot_ours DISK
    mkdir -p "$BOOT_MNT" 2>/dev/null
    mount -t vfat -o ro "${1}p1" "$BOOT_MNT" 2>/dev/null || return 1
    mounted_boot=$BOOT_MNT
    slot_ours=1
    if boot_marked "$BOOT_MNT" && [ "$slot_count" -ge 1 ]; then
        slot_ours=0
    fi
    umount "$BOOT_MNT" || die "${1}p1 would not unmount"
    mounted_boot=""
    return "$slot_ours"
}

# Status 0 when the recovery partition of DISK, a whole disk, holds the
# files of its boot partition marked whole, as `remake_boot_partition` keeps
# them before it makes the file system again, and they are a boot partition
# of this system with both slots: a stop there leaves a boot partition that
# neither bootctl nor `boot_ours` reads, and only this copy says whose it
# was. Status 1 otherwise. Every partition is mounted read-only.
boot_kept() { # boot_kept DISK
    find_recovery "${1#/dev/disk}" ro || return 1
    mounted_recovery=$RECOVERY_MNT
    slot_ours=1
    slot_keep="$RECOVERY_MNT/rach2-boot-keep"
    if [ -f "$slot_keep/complete" ] && [ -f "$slot_keep/sector" ] &&
        [ "$(wc -c < "$slot_keep/sector")" -eq 512 ] &&
        boot_marked "$slot_keep/files" && [ "$slot_count" -eq 2 ]; then
        slot_ours=0
    fi
    umount "$RECOVERY_MNT" || die "the recovery partition of $1 would not unmount"
    mounted_recovery=""
    return "$slot_ours"
}

# Status 0 when DISK, a whole disk, carries a root of this system, an ext2
# partition with /etc/passwd and /etc/rach2, which no other system writes,
# or, when none reads, a recovery partition with the recovery kernel and a
# whole archive of the configuration, which an update takes in the root's
# place. Status 1 otherwise. Every partition is mounted read-only.
root_owned() { # root_owned DISK
    mkdir -p "$TARGET_MNT" "$RECOVERY_MNT" 2>/dev/null
    for slot_part in 2 3 4; do
        [ -e "${1}p${slot_part}" ] || continue
        mount -t ext2 -o ro "${1}p${slot_part}" "$TARGET_MNT" 2>/dev/null || continue
        mounted_root=$TARGET_MNT
        slot_root=1
        [ ! -f "$TARGET_MNT/etc/passwd" ] || [ ! -d "$TARGET_MNT/etc/rach2" ] || slot_root=0
        umount "$TARGET_MNT" || die "${1}p${slot_part} would not unmount"
        mounted_root=""
        [ "$slot_root" -ne 0 ] || return 0
    done
    for slot_part in 2 3 4; do
        [ -e "${1}p${slot_part}" ] || continue
        mount -t vfat -o ro "${1}p${slot_part}" "$RECOVERY_MNT" 2>/dev/null || continue
        mounted_recovery=$RECOVERY_MNT
        slot_root=1
        if [ -f "$RECOVERY_MNT/boot/recovery" ]; then
            for slot_archive in rach2-config rach2-config.new rach2-config.old \
                rach2-config-a rach2-config-b; do
                slot_whole=0
                for slot_need in $ARCHIVE_NEEDS; do
                    [ -f "$RECOVERY_MNT/$slot_archive/$slot_need" ] || slot_whole=1
                done
                [ "$slot_whole" -ne 0 ] || slot_root=0
            done
        fi
        umount "$RECOVERY_MNT" || die "${1}p${slot_part} would not unmount"
        mounted_recovery=""
        [ "$slot_root" -ne 0 ] || return 0
    done
    return 1
}

# Status 0 when DISK, a whole disk, is one this system installed: its boot
# partition is this system's (`boot_ours`) and it carries a root of this
# system or an archive of its configuration (`root_owned`); status 1
# otherwise. `--slots` proves it before `finish_slots` changes a file, and
# so it only reads.
slots_owned() { # slots_owned DISK
    boot_ours "$1" && root_owned "$1"
}

# Grow each kernel slot of the boot partition BOOT, /boot/kernel and then
# /boot/fallback, that is smaller than the slots of this version's disks,
# whose size `bootctl status` prints: `bootctl kernel` refuses a smaller one,
# and bootctl rewrites a slot in place and never grows it. A slot is copied
# beside itself as kernel.new or fallback.new, padded with zeros and compared
# with the slot and its padding; only then is the slot removed and the copy
# renamed to its name, which in one directory with the name free rewrites
# the copy's entries in place. One slot is moved at a time, so the other is
# whole throughout. The caller has saved the machine to its recovery system,
# which a stop then starts, and `finish_slots`, run first here, completes or
# undoes what the stop left. Status 1, with the slot kept as it was, when the
# volume has no room for a copy. Its variables, and those of `finish_slots`
# and of the checks that prove a disk this system's before it, are the
# script's globals, so their names begin with slot: the update that calls it
# compares the root's readback with its own $want afterwards.
grow_slots() { # grow_slots BOOT
    finish_slots "$1"
    slot_want=$(bootctl --target "$1" status | sed -n 's/^bootctl: slot size: \([0-9][0-9]*\) bytes$/\1/p')
    [ -n "$slot_want" ] || die "$1 is not a boot partition bootctl reads, so its slots cannot be grown"
    slots_short=0
    mkdir -p "$BOOT_MNT" 2>/dev/null
    mount -t vfat "$1" "$BOOT_MNT" || die "$1 would not mount to grow its kernel slots"
    mounted_boot=$BOOT_MNT
    for slot in kernel fallback; do
        slot_file="$BOOT_MNT/boot/$slot"
        slot_size=$(wc -c < "$slot_file") || die "$slot_file could not be read"
        [ "$slot_size" -lt "$slot_want" ] || continue
        slot_pad=$(((slot_want - slot_size) / 512))
        if ! { cp "$slot_file" "$slot_file.new" &&
            dd if=/dev/zero bs=512 count="$slot_pad" 2>/dev/null >> "$slot_file.new" &&
            [ "$(wc -c < "$slot_file.new")" -eq "$slot_want" ] && sync &&
            { cat "$slot_file" && dd if=/dev/zero bs=512 count="$slot_pad" 2>/dev/null; } |
            cmp -s - "$slot_file.new"; }; then
            rm -f "$slot_file.new"
            sync
            say "$1 has no room to grow its $slot slot to $slot_want bytes; it keeps $slot_size"
            slots_short=1
            continue
        fi
        { rm -f "$slot_file" && sync && mv "$slot_file.new" "$slot_file" && sync; } ||
            die "the grown $slot slot of $1 did not take the place of the old one; run $ME --slots ${1%p1} from the recovery system to finish it"
        say "grew the $slot slot of $1 from $slot_size to $slot_want bytes"
    done
    umount "$BOOT_MNT" || die "$1 would not unmount"
    mounted_boot=""
    bootctl --target "$1" status > /dev/null ||
        die "$1, its slots grown, is not a boot partition bootctl reads"
    return "$slots_short"
}

# Give the installed root's boot lines one rach2.console=term token when
# CONSOLE is 1, and one rach2.i915 token when I915 is 1, on BOOT. The new
# menu is written beside the old one and put in place by `publish_file`,
# then the partition is unmounted and bootctl reads it before the caller
# arms a trial. Recovery lines keep their bytes.
set_update_console() { # set_update_console BOOT CONSOLE I915
    mkdir -p "$BOOT_MNT" || die "the boot mount directory could not be made"
    mount -t vfat "$1" "$BOOT_MNT" || die "$1 would not mount to set its console"
    mounted_boot=$BOOT_MNT
    console_menu="$BOOT_MNT/boot/grub/grub.cfg"
    finish_file "$console_menu" || die "the menu of $1 that a stop left could not be put back"
    console_new="$console_menu.new"
    awk -v console="$2" -v i915="$3" '
        # drop: remove every whole word of the line that matches RE.
        function drop(re) {
            while (match($0, "[ \t]" re "([ \t]|$)"))
                $0 = substr($0, 1, RSTART - 1) " " substr($0, RSTART + RLENGTH)
        }
        /^[ \t]*(multiboot|multiboot2)[ \t]/ &&
        /[ \t]rach2.slot=(candidate|fallback)([ \t]|$)/ {
            if (console) drop("rach2\\.console=[^ \t]+")
            if (i915) drop("rach2\\.i915")
            sub(/[ \t]+$/, "")
            if (console) $0 = $0 " rach2.console=term"
            if (i915) $0 = $0 " rach2.i915"
            roots++
        }
        { print }
        END { if (roots == 0) exit 1 }
    ' "$console_menu" > "$console_new" || die "the installed root's menu could not be written"
    if cmp -s "$console_menu" "$console_new"; then
        rm -f "$console_new" || die "the spare menu could not be removed"
    else
        publish_file "$console_menu" || die "the console menu could not be put in place"
    fi
    console_new=""
    umount "$BOOT_MNT" || die "$1 would not unmount after setting its console"
    mounted_boot=""
    bootctl --target "$1" status > /dev/null ||
        die "$1, its console set, is not a boot partition bootctl reads"
    [ "$2" != 1 ] || say "console: $1 boots the installed root with term"
    [ "$3" != 1 ] || say "i915: $1 boots the installed root with the Intel graphics driver bound"
}

# Give a menu on BOOT written before the recordfail lines what
# tools/image/mkdisk_grub.sh now writes: `set recordfail=1` and
# `save_env recordfail` at the top of each entry that boots the candidate
# slot, and after the saved default's candidate line the test that boots the
# fallback while recordfail stays set. An update writes only the root and no
# bootctl verb rewrites the fixed menu, so without this a committed
# candidate that panics at boot resets into itself for ever. A menu that has
# the test, or that lacks the line it follows, is left as it is. The menu
# is written and put in place, and bootctl reads the partition, as for the
# console.
set_update_recordfail() { # set_update_recordfail BOOT
    mkdir -p "$BOOT_MNT" || die "the boot mount directory could not be made"
    mount -t vfat "$1" "$BOOT_MNT" || die "$1 would not mount to add its recordfail lines"
    mounted_boot=$BOOT_MNT
    console_menu="$BOOT_MNT/boot/grub/grub.cfg"
    finish_file "$console_menu" || die "the menu of $1 that a stop left could not be put back"
    console_new="$console_menu.new"
    if grep -q 'recordfail}" = "1"' "$console_menu"; then
        rf_said="$1 has its recordfail lines"
    elif awk '
        function flush(   i, n) {
            n = split(entry, line, "\n")
            print line[1]
            if (entry ~ /[ \t]rach2\.slot=candidate([ \t]|\n|$)/ &&
                entry !~ /\n[ \t]*set recordfail=1/) {
                print "    set recordfail=1"
                print "    save_env recordfail"
                entries++
            }
            for (i = 2; i <= n; i++)
                print line[i]
            entry = ""
            inside = 0
        }
        inside { entry = entry "\n" $0; if ($0 ~ /^}/) flush(); next }
        /^menuentry[ \t]/ { entry = $0; inside = 1; next }
        $0 == "if [ \"${saved_entry}\" = \"candidate\" ]; then set default=candidate; fi" {
            print
            print "if [ \"${default}\" = \"candidate\" ]; then"
            print "    if [ \"${recordfail}\" = \"1\" ]; then set default=fallback; fi"
            print "fi"
            tests++
            next
        }
        { print }
        END { if (inside) printf "%s\n", entry; if (entries == 0 || tests != 1) exit 1 }
    ' "$console_menu" > "$console_new"; then
        publish_file "$console_menu" ||
            die "the menu with its recordfail lines could not be put in place"
        rf_said="recordfail: $1 boots the previous kernel after a candidate that never reaches user space"
    else
        rm -f "$console_new" || die "the spare menu could not be removed"
        rf_said="$1's menu has no candidate entry or saved default line to give recordfail lines; it is left as it was"
    fi
    console_new=""
    umount "$BOOT_MNT" || die "$1 would not unmount after adding its recordfail lines"
    mounted_boot=""
    bootctl --target "$1" status > /dev/null ||
        die "$1, its recordfail lines added, is not a boot partition bootctl reads"
    say "$rf_said"
}

# Convert the MBR disk being updated, $update_disk, to boot by UEFI as well,
# with the bootx64.efi beside $update_image; a bootx64.efi.sha256 beside that
# must agree with it. A disk that cannot be converted is left to boot by BIOS
# alone, with a note, and the update goes on; an EFI image that fails its
# checks, or a failure while the boot partition is changed, ends the run.
#
# A new loader is written beside the old one, compared with the image, and
# put in place by `replace_loader`, so that the name UEFI firmware knows it
# by holds the old one or the new one whole at every moment. The same loader
# is left as it is.
convert_mbr_disk() {
    efi_image="$(dirname "$update_image")/bootx64.efi"
    boot="${update_disk}p1"
    if [ ! -f "$efi_image" ]; then
        say "there is no bootx64.efi beside $update_image, so $update_disk boots by BIOS alone"
        return 0
    fi
    if [ -f "$efi_image.sha256" ]; then
        efi_sum=$(sha256sum "$efi_image" | cut -d' ' -f1)
        [ "$efi_sum" = "$(cut -d' ' -f1 < "$efi_image.sha256")" ] ||
            die "$efi_image hashes to $efi_sum and $efi_image.sha256 says otherwise; nothing was written"
    fi
    [ "$(dd if="$efi_image" bs=2 count=1 2>/dev/null)" = MZ ] ||
        die "$efi_image is not an EFI program; nothing was written"
    if [ "$(fat_clusters "$boot")" -lt 65525 ]; then
        boot_sectors=$(grep "^part $target 1 " /proc/disk | cut -d' ' -f5)
        if [ "${boot_sectors:-0}" -lt 67584 ]; then
            say "$boot is smaller than the 33 MiB of a FAT32 volume UEFI firmware reads, so \
$update_disk boots by BIOS alone"
            return 0
        fi
        if ! find_recovery "$target"; then
            say "$update_disk has no recovery partition to keep $boot's files on while its file \
system is made again, so it boots by BIOS alone"
            return 0
        fi
        mounted_recovery=$RECOVERY_MNT
        if ! remake_boot_partition "$boot"; then
            umount "$RECOVERY_MNT" || die "the recovery partition would not unmount"
            mounted_recovery=""
            say "the recovery partition could not keep $boot's files whole, mostly for want of room, so $update_disk boots by BIOS alone"
            return 0
        fi
        umount "$RECOVERY_MNT" || die "the recovery partition would not unmount"
        mounted_recovery=""
    fi
    mkdir -p "$BOOT_MNT" 2>/dev/null
    mount -t vfat "$boot" "$BOOT_MNT" || die "$boot would not mount; the root is not written"
    mounted_boot=$BOOT_MNT
    efi_dir="$BOOT_MNT/EFI/BOOT"
    efi_file="$efi_dir/BOOTX64.EFI"
    { mkdir -p "$efi_dir" && finish_loader "$efi_dir"; } ||
        die "GRUB's EFI image that a stop left on $boot could not be put back; the root is not written"
    if cmp -s "$efi_image" "$efi_file"; then
        say "GRUB's EFI image on $boot is already this one"
    else
        replace_loader "$boot" "$efi_image"
    fi
    umount "$BOOT_MNT" || die "$boot would not unmount; the root is not written"
    mounted_boot=""
    diskctl esp "$update_disk" > /dev/null ||
        die "$boot was not given the EFI system partition's type; the root is not written"
    say "converted: $update_disk keeps its MBR and boots by UEFI as well, from $boot"
}

# ---- the data partition ----
#
# Entry 6 of a GUID table, after the root. On a new install the root keeps
# the size asked for and the data partition takes the rest of the disk, when
# that is DATA_MIN_SECTORS or more; a disk with less, or an MBR, has none,
# and its root grows into the whole of it.

# The root's size when the person gives none, 64 GiB, in sectors.
ROOT_DEFAULT=64G
# The least data partition worth making, 64 MiB, in sectors.
DATA_MIN_SECTORS=131072

# Prints SIZE, a number of mebibytes, gibibytes or tebibytes such as 64G, as
# sectors. Status 1 for anything else.
size_sectors() { # size_sectors SIZE
    case "$1" in
        "" | *[!0-9MGT]* | [MGT]* | *[MGT]?*) return 1 ;;
        *M) echo $((${1%M} * 2048)) ;;
        *G) echo $((${1%G} * 2097152)) ;;
        *T) echo $((${1%T} * 2147483648)) ;;
        *) return 1 ;;
    esac
}

# Prints the sector where the data partition of disk N begins, after the
# root's entry ENTRY when the root keeps WANT sectors from its start, or more
# when the entry has more already: the next mebibyte boundary. Prints nothing
# when the disk has no GUID table or the sectors left after it, to the last
# the table may use, are fewer than DATA_MIN_SECTORS.
data_start() { # data_start N ENTRY WANT
    [ "$(disk_field "$1" 6)" = gpt ] || return 0
    root_start=$(grep "^part $1 $2 " /proc/disk | head -1 | cut -d' ' -f4)
    root_count=$(grep "^part $1 $2 " /proc/disk | head -1 | cut -d' ' -f5)
    [ -n "$root_start" ] && [ -n "$root_count" ] || return 0
    keep=$3
    [ "$keep" -ge "$root_count" ] || keep=$root_count
    first=$(((root_start + keep + 2047) / 2048 * 2048))
    # The backup table's 33 sectors end the disk.
    last=$(($(disk_field "$1" 5) - 34))
    [ $((last - first + 1)) -ge "$DATA_MIN_SECTORS" ] || return 0
    echo "$first"
}

# Makes entry 6 of disk N the data partition from sector START to the next
# partition or the table's end, with `diskctl data`, and its ext2 file system,
# labelled `Rach2 data`, unless it has one that checks, which a run stopped
# after mke2fs leaves. Nothing of the disk may be mounted. `-T huge` gives an
# inode to each 64 KiB, which a volume of large files and caches needs, and
# keeps the inode tables mke2fs writes to a quarter of its default's. A
# failure ends the run.
make_data() { # make_data N START
    diskctl data "/dev/disk$1" "$2" ||
        die "the data partition was not made in /dev/disk$1's table"
    [ -e "/dev/disk$1p6" ] || die "/dev/disk$1p6 did not appear after the table was read"
    if [ "$(dd if="/dev/disk$1p6" bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 53ef ] &&
        e2fsck -fn "/dev/disk$1p6" > /dev/null 2>&1; then
        say "/dev/disk$1p6 has its file system already"
        return 0
    fi
    say "making the data partition's file system on /dev/disk$1p6"
    mke2fs -q -t ext2 -T huge -L "Rach2 data" "/dev/disk$1p6" ||
        die "the data partition's file system was not made on /dev/disk$1p6"
}

# ---- making room for the data partition ----
#
# A disk installed without a data partition, whose root fills the space up
# to the next partition, as the Lenovo's p3 does, gets one from recovery: the
# root is checked and shrunk to SIZE, its entry shortened to match, and the
# sectors freed become entry 6. Nothing of the disk may be mounted, and the
# kernel must be the recovery kernel, the one that writes a whole disk.

if [ -n "$data_disk" ]; then
    case "$data_disk" in
        /dev/disk[0-9] | /dev/disk[0-9][0-9]) ;;
        *) die "$data_disk is not a whole disk of this machine" ;;
    esac
    [ -e "$data_disk" ] || die "$data_disk is not there"
    target=${data_disk#/dev/disk}
    [ "$(disk_field "$target" 6)" = gpt ] ||
        die "$data_disk has no GUID table, and the data partition is entry 6 of one"
    want=$(size_sectors "$data_size") || die "$data_size is not a size such as 64G"
    root_entry=""
    for p in 4 3 2 1; do
        [ -e "${data_disk}p${p}" ] || continue
        mkdir -p "$TARGET_MNT" 2>/dev/null
        mount -t ext2 -o ro "${data_disk}p${p}" "$TARGET_MNT" 2>/dev/null || continue
        mounted_root=$TARGET_MNT
        [ -f "$TARGET_MNT/etc/passwd" ] && [ -d "$TARGET_MNT/etc/rach2" ] && root_entry=$p
        umount "$TARGET_MNT" || die "${data_disk}p${p} would not unmount"
        mounted_root=""
        [ -z "$root_entry" ] || break
    done
    [ -n "$root_entry" ] || die "$data_disk carries no root of this system"
    root_node="${data_disk}p${root_entry}"
    root_count=$(grep "^part $target $root_entry " /proc/disk | head -1 | cut -d' ' -f5)
    [ "$want" -le "$root_count" ] ||
        die "$root_node has $root_count sectors, fewer than the $want of $data_size"
    say "checking $root_node before it is shrunk"
    e2fsck -fp "$root_node"
    [ $? -le 1 ] || die "$root_node did not check clean; run e2fsck -f on it first"
    say "shrinking the file system on $root_node to $data_size"
    resize2fs "$root_node" "${want}s" || die "$root_node's file system was not shrunk to $data_size"
    if [ "$root_count" -gt "$want" ]; then
        diskctl shrink "$data_disk" "$root_entry" "$want" ||
            die "$root_node's entry was not shortened; its file system is $data_size already"
    fi
    start=$(data_start "$target" "$root_entry" "$want")
    [ -n "$start" ] || die "the space freed after $root_node is too small for a data partition"
    make_data "$target" "$start"
    say "made room: $root_node is $data_size, and ${data_disk}p6 is the data partition"
    exit 0
fi

# ---- moving the kernel slots ----
#
# A disk installed before the kernel slots grew is moved to the slots of this
# version from the recovery system. The saved default goes to recovery
# first, which GRUB starts from partition 2 whatever state the boot
# partition is in, and is put back once both slots are grown and checked. A
# trial armed on the disk is refused, since GRUB would take it at a stop in
# place of recovery. A run again after a stop finds the saved default at
# recovery and leaves it there, with a note of the command that sets it.

if [ -n "$slots_disk" ]; then
    case "$slots_disk" in
        /dev/disk[0-9] | /dev/disk[0-9][0-9]) ;;
        *) die "$slots_disk is not a whole disk of this machine" ;;
    esac
    slots_boot="${slots_disk}p1"
    [ -e "$slots_boot" ] || die "$slots_disk has no boot partition"
    if where=$(mounted_elsewhere "$slots_boot"); then
        die "$slots_boot is mounted at $where; unmount it first"
    fi
    # Nothing is written to a disk not proved this system's by reads alone,
    # whether or not `bootctl` reads its boot partition.
    slots_owned "$slots_disk" ||
        die "$slots_disk does not carry this system's boot partition and root; it was not installed from here"
    finish_slots "$slots_boot"
    slots_status=$(bootctl --target "$slots_boot" status) ||
        die "$slots_boot is not a boot partition bootctl reads"
    slots_saved=$(echo "$slots_status" | sed -n 's/^bootctl: saved_entry: //p')
    if ! echo "$slots_status" | grep -q '^bootctl: slot size: the kernel slots are smaller'; then
        # A stop after both slots grew, before the default was put back.
        if [ "$slots_saved" = recovery ]; then
            say "$slots_boot has the slots of this version already; the saved entry is recovery, and bootctl --target $slots_boot env saved_entry candidate starts the installed system"
        else
            say "$slots_boot has the slots of this version already"
        fi
        exit 0
    fi
    case "$(echo "$slots_status" | sed -n 's/^bootctl: next_entry: //p')" in
        empty* | absent) ;;
        *) die "a trial is armed on $slots_boot; boot it, or cancel it with bootctl --target $slots_boot cancel, and run this again" ;;
    esac
    if [ "$slots_saved" != recovery ]; then
        bootctl --target "$slots_boot" env saved_entry recovery > /dev/null ||
            die "the saved boot entry could not be moved to recovery; nothing was written"
    fi
    say "the machine is saved to its recovery system until its slots are moved"
    grow_slots "$slots_boot" ||
        die "$slots_boot has no room for the larger slots; the machine stays saved to its recovery system"
    case "$slots_saved" in
        recovery)
            say "moved $slots_boot to the slots of this version; the saved entry stays recovery, as it was, and bootctl --target $slots_boot env saved_entry candidate starts the installed system"
            exit 0
            ;;
        candidate) slots_back=candidate ;;
        # Any other value starts the fallback entry, by the menu's rule.
        *) slots_back=fallback ;;
    esac
    bootctl --target "$slots_boot" env saved_entry "$slots_back" > /dev/null ||
        die "the slots of $slots_boot are moved, but the saved entry could not be put back; run bootctl --target $slots_boot env saved_entry $slots_back"
    say "moved $slots_boot to the slots of this version; the saved entry is $slots_back again"
    exit 0
fi

# ---- the update ----
#
# A machine that is already installed, given a new root file system. The
# account files, the SSH policy, the server's host keys and the keys the
# accounts log in with are copied off the root first. The image goes into the
# root's own partition, and no partition moves. Besides the root, the update
# writes the boot partition's environment block, the root's entry, which
# growroot grows up to the data partition when the disk has one, the
# archive on the recovery partition, and a copy of the old root, homes and
# all, in rach2-update-keep on the data partition or else the recovery
# partition, which outlives a power cut in the write and is removed when the
# update finishes; the data partition's entry is kept as every other is. The conversion
# of an MBR disk for UEFI also writes the boot partition's type, its loader
# and, when it has too few clusters, its file system.

# Prints `ENTRY START`, entry ENTRY of disk N and its first sector, which
# names the partition however its length changes; status 1 when the table
# has no such entry.
root_place() { # root_place N ENTRY
    awk -v d="$1" -v e="$2" '
        $1 == "part" && $2 == d && $3 == e { print $3, $4; found = 1; exit }
        END { exit !found }' /proc/disk
}

# Sets root_entry to the root partition the archive at `archive` names in its
# file `root`, when the table's entry of that number still begins at the
# sector recorded; dies when it does not, since the partition at that number
# is then another. Status 1 when the archive names no root, as one written
# before the archive recorded it does not.
archived_root() { # archived_root N
    [ -f "$archive/root" ] || return 1
    read -r named_entry named_start < "$archive/root" || named_entry=""
    case "$named_entry" in [1-9]) ;; *) die "$archive/root names no partition of the disk" ;; esac
    [ "$(root_place "$1" "$named_entry" 2>/dev/null)" = "$named_entry $named_start" ] ||
        die "the archive says the root is entry $named_entry, which begins at sector \
$named_start, and the table has no such entry; nothing was written"
    root_entry=$named_entry
}

# Sets root_entry, for an archive that names no root, from the table: entry 3
# of a GUID table, where this system puts the root, or the one MBR entry of
# type 83, Linux's. An MBR disk with more than one is refused, since the
# update would replace whichever it chose.
table_root() { # table_root N
    if [ "$(disk_field "$1" 6)" = gpt ]; then
        root_entry=$(root_place "$1" 3 | cut -d' ' -f1)
    else
        root_entry=$(awk -v d="$1" '$1 == "part" && $2 == d && $6 == "mbr:83" { printf "%s%s", s, $3; s = " " }' /proc/disk)
        case "$root_entry" in
            *" "*) die "/dev/disk$1 has more than one Linux partition, entries $root_entry, and \
its archive does not say which is the root; nothing was written" ;;
        esac
    fi
    [ -n "$root_entry" ] || die "/dev/disk$1 has no ext2 partition in its table"
}

# Dies, saying what is missing, unless the recovery system on disk N would
# start a machine whose root is gone: the recovery partition is mounted at
# RECOVERY_MNT, its kernel carries a Multiboot2 header and reads whole, its
# RAM image is not empty and reads whole, its own menu, which the core image
# loads when the boot partition does not read, loads both, and the boot
# partition's entry `recovery` loads both from the partition with this
# partition's serial. The boot partition is mounted read-only to look.
require_recovery() { # require_recovery N
    [ -n "$mounted_recovery" ] ||
        die "/dev/disk$1 has no recovery partition, so a stopped write would leave it \
nothing to start; $unwritten"
    rk="$RECOVERY_MNT/boot/recovery"
    ri="$RECOVERY_MNT/boot/recovery.krffs"
    rc="$RECOVERY_MNT/boot/grub/recovery.cfg"
    # 0xe85250d6 is Multiboot2's header magic, on a 4-byte boundary.
    dd if="$rk" bs=32768 count=1 2>/dev/null | od -An -tx4 -v | grep -qw e85250d6 ||
        die "the recovery kernel on /dev/disk$1p$recovery_entry has no Multiboot2 header; $unwritten"
    { [ -s "$ri" ] && cat "$rk" "$ri" > /dev/null; } ||
        die "the recovery kernel or its RAM image on /dev/disk$1p$recovery_entry does not read; $unwritten"
    { grep -q '/boot/recovery ' "$rc" && grep -q '/boot/recovery\.krffs' "$rc"; } 2>/dev/null ||
        die "the recovery partition's own menu, boot/grub/recovery.cfg, does not load its kernel and \
RAM image; $unwritten"
    # FAT32 keeps the volume's serial at byte 67 of its boot sector, low byte
    # first; GRUB names the volume by it as XXXX-XXXX.
    rs=$(dd if="/dev/disk$1p$recovery_entry" bs=1 skip=67 count=4 2>/dev/null | od -An -tx1 |
        awk '{ printf "%s%s-%s%s", $4, $3, $2, $1 }' | tr 'a-f' 'A-F')
    mkdir -p "$BOOT_MNT" 2>/dev/null
    mount -t vfat -o ro "/dev/disk$1p1" "$BOOT_MNT" ||
        die "/dev/disk$1p1 would not mount to look at its recovery entry; $unwritten"
    mounted_boot=$BOOT_MNT
    rm_entry=$(awk '/^menuentry .*--id recovery /, /^}/' "$BOOT_MNT/boot/grub/grub.cfg" 2>/dev/null)
    umount "$BOOT_MNT" || die "/dev/disk$1p1 would not unmount"
    mounted_boot=""
    case "$rm_entry" in *"--set=root $rs"*) ;; *)
        die "the boot menu's entry recovery does not look for the recovery partition, serial $rs; \
$unwritten" ;;
    esac
    case "$rm_entry" in *"/boot/recovery "*"/boot/recovery.krffs"*) ;; *)
        die "the boot menu's entry recovery does not load the recovery kernel and its RAM image; \
$unwritten" ;;
    esac
}

# Mounts the volume that keeps an update's copy of the root, entry E of disk
# N, and sets keep_dir to its rach2-update-keep: the recovery partition,
# mounted already, or the data partition, mounted at DATA_MNT. A data
# partition is entry 6 of a GUID table with an ext2 volume labelled `Rach2
# data`, as `--data` and the install make it, so that no other system's
# volume is written; status 1 for any other entry.
mount_store() { # mount_store N E
    if [ "$2" = "$recovery_entry" ]; then
        keep_dir="$RECOVERY_MNT/$KEEP_STORE"
        return 0
    fi
    [ "$2" = 6 ] && [ "$(disk_field "$1" 6)" = gpt ] || return 1
    # ext2 keeps its volume's label, 16 bytes, at byte 1144 of the partition.
    [ "$(dd if="/dev/disk$1p6" bs=1 skip=1144 count=16 2>/dev/null | tr -d '\000')" = "Rach2 data" ] ||
        return 1
    mkdir -p "$DATA_MNT" 2>/dev/null
    mount -t ext2 "/dev/disk$1p$2" "$DATA_MNT" 2>/dev/null || return 1
    mounted_data=$DATA_MNT
    keep_dir="$DATA_MNT/$KEEP_STORE"
}

# Unmounts the data partition when mount_store mounted it.
unmount_store() {
    [ -n "$mounted_data" ] || return 0
    umount "$DATA_MNT" || die "the data partition would not unmount"
    mounted_data=""
}

# Status 0 when keep_dir holds keep.tar with keep.sha256 beside it, the hash
# of the whole file, written once the file was synced and read back, and the
# file hashes to SUM now.
keep_whole() { # keep_whole SUM
    [ -f "$keep_dir/keep.sha256" ] && [ "$(cat "$keep_dir/keep.sha256")" = "$1" ] &&
        [ "$(sha256sum < "$keep_dir/keep.tar" | cut -d' ' -f1)" = "$1" ]
}

# Writes the copy at KEEP, the root's configuration, keys and homes as the
# update keeps them, to a volume that outlives a power cut, and sets
# archive_keep to where it went: the data partition, entry 6, when it mounts,
# or else the recovery partition when the copy fits there. It is one tar file,
# which keeps owners, modes and links on FAT as well; it is synced, the
# volume is unmounted and mounted again so that the file is read from the
# disk, and only when the hash read then is the hash written does keep.sha256
# go beside it. Dies when neither volume has room.
save_keep() { # save_keep N KEEP
    need=$(du -sk "$2" | cut -f1)
    need=$((need + need / 50 + 1024))
    store=""
    for candidate in 6 "$recovery_entry"; do
        [ -e "/dev/disk$1p$candidate" ] || continue
        mount_store "$1" "$candidate" || continue
        rm -rf "$keep_dir" || die "an old copy in $keep_dir could not be removed"
        sync
        free=$(df -Pk "${keep_dir%/*}" | awk 'NR == 2 { print $4 }')
        # FAT32 holds no file of 4 GiB or more.
        if [ -n "$free" ] && [ "$free" -gt "$need" ] &&
            { [ "$candidate" != "$recovery_entry" ] || [ "$need" -lt 4194000 ]; }; then
            store=$candidate
            break
        fi
        unmount_store
    done
    [ -n "$store" ] || die "neither the data partition nor the recovery partition of /dev/disk$1 \
has the $need KiB a copy of the root's homes takes; make room, or give the disk a data \
partition with $ME --data, and run this again; $unwritten"
    say "keeping a copy of the root's homes and configuration in /dev/disk$1p$store, $KEEP_STORE"
    { mkdir -p "$keep_dir" && chmod 700 "$keep_dir"; } ||
        die "$keep_dir could not be made"
    (cd "$2" && tar -cf - --exclude=./root-written .) > "$keep_dir/keep.tar" ||
        die "the copy of the root could not be written to /dev/disk$1p$store"
    sync
    written=$(sha256sum < "$keep_dir/keep.tar" | cut -d' ' -f1)
    if [ "$store" = "$recovery_entry" ]; then
        umount "$RECOVERY_MNT" || die "the recovery partition would not unmount"
        mount -t vfat -o umask=077 "/dev/disk$1p$store" "$RECOVERY_MNT" ||
            die "the recovery partition would not mount again"
    else
        unmount_store
        mount_store "$1" "$store" || die "the data partition would not mount again"
    fi
    [ "$(sha256sum < "$keep_dir/keep.tar" | cut -d' ' -f1)" = "$written" ] ||
        die "the copy of the root on /dev/disk$1p$store does not read back as it was written; $unwritten"
    echo "$written" > "$keep_dir/keep.sha256" || die "the copy's hash could not be written"
    sync
    unmount_store
    archive_keep="$store $written"
}

# Status 0 when the archive at `archive` names a copy of the root in its
# update-keep and that copy is whole; archive_keep is then set, and the volume
# that holds it mounted, with keep_dir naming the copy's directory.
found_keep() { # found_keep N
    [ -f "$archive/update-keep" ] || return 1
    read -r kept_store kept_sum < "$archive/update-keep" || return 1
    case "$kept_store" in [1-9]) ;; *) return 1 ;; esac
    mount_store "$1" "$kept_store" || return 1
    if ! keep_whole "$kept_sum"; then
        unmount_store
        return 1
    fi
    archive_keep="$kept_store $kept_sum"
}

# Takes the copy the archive's update-keep names back into KEEP. It dies when
# that copy does not mount or is not whole, since the root it was taken from
# is overwritten and the copy is all that is left of its homes.
load_keep() { # load_keep N KEEP
    found_keep "$1" ||
        die "the copy of the old root that $archive/update-keep names does not mount or is not \
whole, and the root it was taken from is overwritten; nothing more was written"
    { rm -rf "$2" && mkdir -p "$2" && chmod 700 "$2" &&
        tar -xf "$keep_dir/keep.tar" --numeric-owner -C "$2"; } ||
        die "the copy of the old root on /dev/disk$1p${archive_keep%% *} could not be taken back"
    unmount_store
}

if [ -n "$update_image" ]; then
    [ -f "$update_image" ] || die "$update_image is not a file"
    # A whole disk and not a partition of one: the offsets below are the
    # table's, so a partition node here would write the root's bytes at the
    # root's own offset inside the root.
    case "$update_disk" in
        /dev/disk[0-9] | /dev/disk[0-9][0-9]) ;;
        *) die "$update_disk is not a whole disk of this machine" ;;
    esac
    [ -e "$update_disk" ] || die "$update_disk is not there"
    target=${update_disk#/dev/disk}

    # The copy of what the old root keeps, the home directories among it, goes
    # in /dev/shm, the tmpfs of half the machine's memory, where there is one,
    # and not in the recovery system's root, which the build leaves half a
    # mebibyte free at the least. Its file `root-written`, `DISK ENTRY`, says
    # that an update of this boot began to write that root and did not finish:
    # the copy is then the only one of the old root's homes, and is used again.
    keep=/tmp/rach2-update-keep
    [ -d /dev/shm ] && keep=/dev/shm/rach2-update-keep
    kept_entry=""
    if [ -f "$keep/root-written" ]; then
        read -r kept_disk kept_entry < "$keep/root-written" || kept_entry=""
        case "$kept_entry" in [1-4]) ;; *) die "$keep/root-written is not a disk and an entry" ;; esac
        [ "$kept_disk" = "$update_disk" ] ||
            die "an update of $kept_disk stopped after it wrote the root, and $keep holds the \
only copy of its homes; update $kept_disk again before $update_disk"
    fi

    # The disk must be one this system installed, and not another system's that
    # happens to have an ext2 partition with an `/etc/passwd` in it: the write
    # below replaces a whole partition, and a disk that was never installed
    # from here has no partition this may claim. It is proved before anything
    # of it is mounted writable, since a writable mount of a FAT volume left
    # dirty repairs it, and so by reads alone. Two things say so together.
    # The boot partition is this system's: it holds this system's menu,
    # environment block and slots, whatever a stop in a slot's move left of
    # them (`boot_ours`); or a stop in its conversion left it unreadable and
    # its files kept whole on the recovery partition, as `boot_kept` reads
    # them. And the disk carries a root of this system, or an archive of its
    # configuration (`root_owned`), or an update of this boot wrote its root
    # and stopped.
    if boot_ours "$update_disk" || boot_kept "$update_disk"; then
        [ -n "$kept_entry" ] || root_owned "$update_disk" ||
            die "$update_disk carries no root of this system and no archive of its configuration; \
it was not installed from here"
    else
        die "${update_disk}p1 is not a boot partition this system wrote; \
$update_disk was not installed from here"
    fi

    # A stopped conversion is finished first. Then `finish_slots` puts back
    # what a stop left of a slot's move, the menu or GRUB's EFI image, as
    # `--slots` would: a slot missing or a copy whose chain is longer than its
    # size, which `bootctl` refuses, and its writable mount repairs a volume a
    # stop left dirty.
    resume_boot_partition "${update_disk}p1"
    finish_slots "${update_disk}p1"
    bootctl --target "${update_disk}p1" status > /dev/null ||
        die "${update_disk}p1, its kernel slots made whole, is not a boot partition bootctl reads"

    root_entry=""
    if [ -n "$kept_entry" ]; then
        root_entry=$kept_entry
        say "an update of this boot stopped after it wrote the root; taking the configuration it kept in $keep"
    else
        for p in 4 3 2 1; do
            [ -e "${update_disk}p${p}" ] || continue
            mkdir -p "$TARGET_MNT" 2>/dev/null
            mount -t ext2 -o ro "${update_disk}p${p}" "$TARGET_MNT" 2>/dev/null || continue
            mounted_root=$TARGET_MNT
            if [ -f "$TARGET_MNT/etc/passwd" ] && [ -d "$TARGET_MNT/etc/rach2" ]; then
                root_entry=$p
                break
            fi
            umount "$TARGET_MNT" || die "${update_disk}p${p} would not unmount"
            mounted_root=""
        done
        rm -rf "$keep" || die "an old copy of the configuration could not be removed"
        { mkdir -p "$keep" && chmod 700 "$keep"; } || die "there is nowhere to keep the machine's configuration"
    fi
    find_recovery "$target"
    recovery_entry=$recovery_found
    [ -n "$recovery_entry" ] && mounted_recovery=$RECOVERY_MNT
    [ -z "$recovery_entry" ] || recover_archive
    # A write that began in an earlier boot and stopped leaves the archive
    # marked, and naming the copy of the old root it kept on a volume that
    # outlived the stop, homes and all. That copy is taken back as this boot's
    # own, and the update goes on as one of this boot would.
    if [ -z "$kept_entry" ] && [ -n "$archive" ] && [ -f "$archive/update-in-progress" ] &&
        [ -f "$archive/update-keep" ]; then
        if [ -n "$mounted_root" ]; then
            umount "$TARGET_MNT" || die "${update_disk}p${root_entry} would not unmount"
            mounted_root=""
        fi
        archived_root "$target" || table_root "$target"
        load_keep "$target" "$keep"
        echo "$update_disk $root_entry" > "$keep/root-written" ||
            die "the copy of the configuration could not be marked"
        kept_entry=$root_entry
        say "an update stopped after it began to write ${update_disk}p${root_entry}; taking the copy of the \
old root kept on ${update_disk}p${archive_keep%% *}"
    fi
    # The archive names the partition its root was taken from. Another
    # partition that reads as a root of this system may be a copy, and the
    # update writes neither while the two disagree.
    if [ -z "$kept_entry" ] && [ -n "$archive" ] && [ -n "$root_entry" ]; then
        found_entry=$root_entry
        if archived_root "$target" && [ "$root_entry" != "$found_entry" ]; then
            die "the archive names ${update_disk}p${root_entry} as the root and ${update_disk}p${found_entry} \
reads as one; nothing was written"
        fi
        root_entry=$found_entry
    fi
    from_archive=""
    if [ -n "$kept_entry" ]; then
        :
    elif [ -n "$recovery_entry" ] && [ -n "$archive" ] && [ -f "$archive/update-in-progress" ]; then
        # An update stopped after it wrote the root and before it wrote the
        # accounts back: the root reads, and what it holds is the image's.
        # The archive was written before that root, from the machine's own.
        from_archive="an update was stopped part way, and the root holds the image's accounts"
    elif [ -z "$root_entry" ]; then
        from_archive="the root does not read"
    fi
    if [ -n "$from_archive" ]; then
        # The archive is the configuration, and names the root's partition;
        # an archive written before it named one leaves it to the root that
        # reads, or to the table.
        { [ -n "$recovery_entry" ] && [ -n "$archive" ] && archive_complete; } ||
            die "$update_disk carries no root of this system whose accounts can be taken and no \
whole configuration archived on its recovery partition; its accounts are not there to be kept"
        archived_root "$target" || [ -n "$root_entry" ] || table_root "$target"
        say "$from_archive; taking the configuration saved on the recovery partition"
        for f in $CONFIG_FILES; do
            if [ -e "$archive/$f" ]; then
                keep_copy "$archive/$f" "$keep/$f" || die "$f could not be taken from the archive"
            fi
        done
        restore_archive_keys || die "the archived keys and homes could not be restored"
    elif [ -z "$kept_entry" ]; then
        say "copying this machine's accounts, policy and keys off the root"
        for f in $CONFIG_FILES; do
            if [ -e "$TARGET_MNT/$f" ]; then
                keep_copy "$TARGET_MNT/$f" "$keep/$f" || die "$f could not be kept"
            fi
        done
        # The archive is a copy of the root's own files; a difference is
        # reported and the root's copy is what the machine keeps.
        if [ -n "$recovery_entry" ] && [ -n "$archive" ]; then
            for f in $CONFIG_FILES; do
                if [ -f "$keep/$f" ] && [ -f "$archive/$f" ]; then
                    cmp -s "$keep/$f" "$archive/$f" ||
                        say "the archive on the recovery partition differs from the root's $f; the root's is kept"
                elif [ -f "$keep/$f" ] || [ -f "$archive/$f" ]; then
                    say "the archive on the recovery partition differs from the root's $f; the root's is kept"
                fi
            done
        elif [ -n "$recovery_entry" ]; then
            say "the recovery partition has no archive of the configuration; one is written before the update"
        fi
    fi
    chmod 600 "$keep/etc/shadow" 2>/dev/null || true
    # Every copy is checked, because what is not kept here is replaced below by
    # the image's own: a copy that failed and said nothing would take the
    # machine's home directories, or its host keys, away in the name of
    # updating it. `-a` keeps the owner and the mode, which `cp` run by root
    # does not do on its own: an account's home restored as root's is a home
    # its owner cannot enter.
    if [ -n "$from_archive" ] && [ -n "$mounted_root" ]; then
        # A root that holds the image's accounts holds the image's homes and
        # keys too: nothing of it is kept.
        umount "$TARGET_MNT" || die "${update_disk}p${root_entry} would not unmount"
        mounted_root=""
    fi
    if [ -d "$TARGET_MNT/etc/dropbear" ] && [ -n "$mounted_root" ]; then
        cp -a "$TARGET_MNT/etc/dropbear" "$keep/etc/dropbear" ||
            die "the server's host keys could not be kept"
    fi
    if [ -n "$mounted_root" ] && ssh_host_keys "$TARGET_MNT"; then
        { mkdir -p "$keep/etc/ssh" && cp -a "$TARGET_MNT"/etc/ssh/ssh_host_* "$keep/etc/ssh/"; } ||
            die "OpenSSH's host keys could not be kept"
    fi
    # /home is kept whole, and root's home is too, apart from the keys,
    # which the loop below keeps in "$keep/root" for the archive.
    if [ -n "$mounted_root" ]; then
        keep_root_directory /home "$keep/home" || die "the home directories could not be kept"
        keep_root_directory /root "$keep/root-home" || die "root's home directory could not be kept"
        # A /root kept as its link into /home is root's home in the copy too,
        # where the archive and the restore read root's keys.
        if [ -L "$keep/root-home" ]; then
            cp -a "$keep/root-home" "$keep/root" || die "root's home directory could not be kept"
        fi
    fi
    # Each home is read inside the old root and kept at the same home read
    # inside the copy, and a .ssh that is a link leading out of /home is kept
    # as the tree it leads to, which may not be on the new root. Such a link
    # that the copy of /home holds is replaced there by its tree, since the
    # copy goes back in place of the image's /home and the archive reads the
    # keys in the copy. The links inside each .ssh kept are made by
    # pin_key_links to lead where they led in the old root, in the copy of
    # /home as in a tree kept on its own, or the update stops here.
    if [ -n "$mounted_root" ]; then
        pinned=""
        while IFS=: read -r _name _password _uid _gid _gecos home _shell; do
            case "$home" in /*) ;; *) continue ;; esac
            from=$(root_path "$TARGET_MNT" "$home/.ssh") || die "$home/.ssh leads through too many links"
            [ "$from" != "$TARGET_MNT" ] && [ -d "$from" ] || continue
            if under_home "$TARGET_MNT" "$from"; then
                to=$keep/home${from#"$TARGET_MNT/home"}
                case "$pinned" in *"
$from
"*) continue ;; esac
                pinned="$pinned
$from
"
                [ ! -d "$to" ] || [ -L "$to" ] || pin_key_links "$TARGET_MNT" "$from" "$to" kept
                continue
            fi
            to=$(root_path "$keep" "$home") || die "$home leads through too many links in $keep"
            if [ -L "$to/.ssh" ]; then
                rm -f "$to/.ssh" || die "$home/.ssh could not be kept"
            elif [ -e "$to/.ssh" ]; then
                continue
            fi
            { mkdir -p "$to" && cp -a "$from" "$to/.ssh"; } ||
                die "$home/.ssh could not be kept"
            pin_key_links "$TARGET_MNT" "$from" "$to/.ssh" kept
        done < "$keep/etc/passwd"
    fi
    if [ -n "$mounted_root" ]; then
        umount "$TARGET_MNT" || die "the root would not unmount"
        mounted_root=""
    fi

    # Where the root partition is, from the table the machine has now: an
    # update writes that range and nothing else.
    start=$(grep "^part $target $root_entry " /proc/disk | head -1 | cut -d' ' -f4)
    count=$(grep "^part $target $root_entry " /proc/disk | head -1 | cut -d' ' -f5)
    [ -n "$start" ] && [ -n "$count" ] || die "the root partition's place could not be read"
    bytes=$(stat -c %s "$update_image")
    at=$((start * 512))
    room=$((count * 512))
    [ "$bytes" -le "$room" ] ||
        die "the image is $bytes bytes and the root partition holds $room"
    [ $((bytes % 512)) -eq 0 ] ||
        die "the image is $bytes bytes, which is not a whole number of sectors"

    # The image is judged before the root it replaces is destroyed. Its hash is
    # taken here, so the readback below compares the disk with what was read
    # rather than with itself; and the first bytes of an ext2 file system are
    # read, since an image that is not one would leave a machine with no root
    # at all and nothing to say why.
    want=$(dd if="$update_image" bs=1048576 2>/dev/null | sha256sum | cut -d' ' -f1)
    [ -n "$want" ] || die "the image could not be read"
    if [ -f "$update_image.sha256" ]; then
        declared=$(cut -d' ' -f1 < "$update_image.sha256")
        [ "$want" = "$declared" ] ||
            die "the image hashes to $want and $update_image.sha256 says $declared"
    fi
    magic=$(dd if="$update_image" bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' \n')
    [ "$magic" = "53ef" ] ||
        die "$update_image does not begin with an ext2 file system"

    update_mark="$(basename "$update_image") $bytes"
    begun=""
    [ -z "$kept_entry" ] && [ -z "$from_archive" ] || begun=1
    unwritten="nothing was written"
    [ -z "$begun" ] || unwritten="nothing more was written"

    # Nothing is destroyed until the recovery system would start the machine
    # whatever this leaves, and holds what the retry that follows needs.
    require_recovery "$target"

    # The copy at keep is the only one of the old root's homes once the write
    # begins, and RAM does not outlive a power cut, so it goes whole to a
    # volume that does, and is proved there, before anything is destroyed. A
    # write that began already and has a whole copy keeps that copy, which is
    # this keep's own: making another would remove it first.
    if [ -n "$kept_entry" ] && [ -z "$archive_keep" ] && [ -n "$archive" ] &&
        [ -f "$archive/update-in-progress" ] && found_keep "$target"; then
        unmount_store
    fi
    [ -n "$archive_keep" ] || save_keep "$target" "$keep"

    # The archive is written now, from what is kept, with the root's place and
    # the copy's. It is marked as an update in progress only once the write
    # begins, below, so that a run stopped before then leaves an archive that
    # sends the retry to the root, which is still whole. A write that began
    # already, and a root that does not read or holds the image's accounts,
    # whose configuration came from the archive, keep the mark. Nothing of
    # the disk may be mounted while its root is written, since the raw writer
    # refuses a disk with a mount on it. The archive goes into slot B,
    # written a second time when the first went into A, so that the refresh
    # after the write goes into A and a finished update leaves A current.
    archive_root=$(root_place "$target" "$root_entry") ||
        die "the root partition's place could not be read"
    if [ -n "$begun" ]; then
        write_archive "$keep" "$update_mark"
        if [ "$next_archive" = "$RECOVERY_MNT/rach2-config-a" ]; then
            write_archive "$keep" "$update_mark"
        fi
    else
        write_archive "$keep"
        if [ "$next_archive" = "$RECOVERY_MNT/rach2-config-a" ]; then
            write_archive "$keep"
        fi
    fi
    recover_archive
    { [ "$archive" = "$next_archive" ] && archive_complete &&
        [ "$(cat "$archive/update-keep" 2>/dev/null)" = "$archive_keep" ]; } ||
        die "the archive just written on ${update_disk}p${recovery_entry} does not read back whole; $unwritten"
    umount "$RECOVERY_MNT" || die "the recovery partition would not unmount"
    mounted_recovery=""
    say "the configuration is archived on ${update_disk}p${recovery_entry} before the root is written"

    # The machine is put where it can come back from before its root is
    # replaced, and that is the recovery system, not the fallback entry: both
    # kernel entries boot this root, so a write cut off by a power cut would
    # leave the machine with two ways to start a half-written root and no
    # third way at all. Recovery runs from RAM and needs no root, so it comes
    # up whatever state this write leaves behind.
    #
    # A trial arms one boot and leaves the saved default alone, so this must be
    # the saved default and not a trial: a machine that lost power during the
    # write has already spent its one boot.
    bootctl --target "${update_disk}p1" env saved_entry recovery > /dev/null ||
        die "the saved boot entry could not be moved to recovery; nothing was written"
    # Any trial already armed would consume itself on the next boot and take the
    # machine off recovery in the middle of this, so this has to succeed before
    # a byte is written. `cancel` on a machine with nothing armed succeeds, so
    # a failure here means the environment block could not be read or
    # rewritten, and the write does not start.
    bootctl --target "${update_disk}p1" cancel > /dev/null ||
        die "an armed trial could not be cancelled, so recovery would not hold; nothing was written"
    say "the machine is saved to its recovery system until the new root is tried"

    if [ "$(disk_field "$target" 6)" = mbr ]; then
        convert_mbr_disk
    fi
    grow_slots "${update_disk}p1" ||
        say "bootctl kernel refuses the smaller slots of ${update_disk}p1 until they grow; free room there and run $ME --slots $update_disk"

    # The write begins: the archive is marked, which sends a retry after a
    # stop to the archive and the copy it names and not to the root, and keep
    # is marked for a retry in this boot.
    if [ -z "$begun" ]; then
        find_recovery "$target"
        [ -n "$recovery_found" ] && mounted_recovery=$RECOVERY_MNT
        [ "$recovery_found" = "$recovery_entry" ] ||
            die "the recovery partition ${update_disk}p${recovery_entry} was not found again; nothing was written"
        recover_archive
        { [ "$(cat "$archive/update-keep" 2>/dev/null)" = "$archive_keep" ] &&
            echo "$update_mark" > "$archive/update-in-progress" && sync; } ||
            die "the archive could not be marked; the root was not written"
        umount "$RECOVERY_MNT" || die "the recovery partition would not unmount"
        mounted_recovery=""
    fi
    echo "$update_disk $root_entry" > "$keep/root-written" ||
        die "the copy of the configuration could not be marked; the root was not written"
    say "writing $bytes bytes into ${update_disk}p${root_entry}, at $at"
    reflash -p "$update_disk" "$at" "$bytes" < "$update_image" ||
        die "the root was not written"
    back=$(reflash --verify "$update_disk" "$at" "$bytes" | cut -d' ' -f3)
    [ "$back" = "$want" ] || die "what reached the root hashes to $back and the image to $want"
    say "what reached the root is the image"

    spec=$(disk_identity "$target") || die "the disk's identity could not be read"
    growroot "$spec,$root_entry" || die "the root was not grown into its partition"

    mount -t ext2 "${update_disk}p${root_entry}" "$TARGET_MNT" ||
        die "the new root would not mount"
    mounted_root=$TARGET_MNT
    say "writing the accounts, the policy and the keys back"
    keep_image_accounts "$TARGET_MNT" "$keep" ||
        die "the image's system accounts could not be kept beside the machine's"
    for f in $CONFIG_FILES; do
        if [ -e "$keep/$f" ]; then
            keep_copy "$keep/$f" "$TARGET_MNT/$f" || die "$f could not be put back"
        fi
    done
    chmod 600 "$TARGET_MNT/etc/shadow" || die "the shadow file's mode could not be set"
    # The archive's FAT file system keeps no mode, and this file has passphrases.
    if [ -f "$TARGET_MNT/etc/machine-id" ]; then
        chmod 444 "$TARGET_MNT/etc/machine-id" || die "the machine id's mode could not be set"
    fi
    if [ -f "$TARGET_MNT/etc/wpa_supplicant/wlan0.conf" ]; then
        chmod 600 "$TARGET_MNT/etc/wpa_supplicant/wlan0.conf" ||
            die "the saved networks' mode could not be set"
    fi
    if [ -f "$TARGET_MNT/var/lib/ipv6-stable-secret" ]; then
        chmod 600 "$TARGET_MNT/var/lib/ipv6-stable-secret" ||
            die "the stable secret's mode could not be set"
    fi
    if [ -d "$keep/etc/dropbear" ]; then
        rm -rf "$TARGET_MNT/etc/dropbear" || die "the image's host keys could not be removed"
        cp -a "$keep/etc/dropbear" "$TARGET_MNT/etc/dropbear" ||
            die "the server's host keys could not be put back"
    fi
    if ssh_host_keys "$keep"; then
        { rm -f "$TARGET_MNT"/etc/ssh/ssh_host_* && mkdir -p "$TARGET_MNT/etc/ssh" &&
            cp -a "$keep"/etc/ssh/ssh_host_* "$TARGET_MNT/etc/ssh/"; } ||
            die "OpenSSH's host keys could not be put back"
    fi
    # The image's home directories go, with the keys they carry, whether or
    # not the machine's were kept: an account that has the image's name must
    # not regain the image's key. Where the machine's homes were not kept,
    # each account of the archive gets a home with its archived keys.
    rm -rf "${TARGET_MNT:?}/home" || die "the image's home directories could not be removed"
    if [ -d "$keep/home" ]; then
        cp -a "$keep/home" "$TARGET_MNT/home" || die "the home directories could not be put back"
    else
        mkdir -p "$TARGET_MNT/home" || die "the home directory could not be made"
        while IFS=: read -r _name _password uid gid _gecos home _shell; do
            case "$uid" in "" | *[!0-9]*) continue ;; esac
            [ "$uid" -ge 1000 ] || continue
            case "$home" in /*) ;; *) continue ;; esac
            dir=$(root_path "$TARGET_MNT" "$home") || die "$home leads through too many links"
            case "$dir" in "$TARGET_MNT/home/"*) ;; *) continue ;; esac
            [ ! -d "$dir" ] || continue
            { mkdir -p "$dir" && chmod 700 "$dir" && chown "$uid:$gid" "$dir"; } ||
                die "$home could not be made"
        done < "$TARGET_MNT/etc/passwd"
    fi
    # Root's home is the machine's where it was kept, a tree or a link into
    # /home; its keys are put back with the other homes' below.
    if [ -d "$keep/root-home" ] || [ -L "$keep/root-home" ]; then
        rm -rf "${TARGET_MNT:?}/root" || die "the image's home for root could not be removed"
        cp -a "$keep/root-home" "$TARGET_MNT/root" || die "root's home directory could not be put back"
    fi
    # The image's keys go from /root and from every home outside /home, kept
    # keys or not. /root and each home are read inside the new root, and
    # each home inside the copy, by root_path, so that a home such as
    # `/../../mnt/other`, or one through a link, is the root's own and not a
    # directory of another disk or of the system running the update.
    root_home=$(root_path "$TARGET_MNT" /root) || die "/root leads through too many links"
    if ! under_home "$TARGET_MNT" "$root_home"; then
        rm -rf "$root_home/.ssh" || die "the image's keys for root could not be removed"
    fi
    while IFS=: read -r _name _password uid gid _gecos home _shell; do
        case "$home" in /*) ;; *) continue ;; esac
        to=$(root_path "$TARGET_MNT" "$home") || die "$home leads through too many links"
        under_home "$TARGET_MNT" "$to" && continue
        rm -rf "$to/.ssh" || die "$home/.ssh could not be removed"
        from=$(root_path "$keep" "$home") || die "$home leads through too many links in $keep"
        [ -d "$from/.ssh" ] || continue
        if [ ! -d "$to" ]; then
            { mkdir -p "$to" && chmod 700 "$to" && chown "$uid:$gid" "$to"; } ||
                die "$home could not be made"
        fi
        cp -a "$from/.ssh" "$to/.ssh" || die "$home/.ssh could not be put back"
    done < "$keep/etc/passwd"
    sync
    umount "$TARGET_MNT" || die "the new root would not unmount"
    mounted_root=""
    # The archive refreshed from what was written back and its mark taken
    # off, so the next update of a root that does not read takes what this
    # one kept; an archive that was there and cannot be refreshed stops the
    # update here, with the root written and no trial armed, rather than
    # leave a stale archive that says an update is in progress.
    if [ -n "$recovery_entry" ]; then
        find_recovery "$target"
        again=$recovery_found
        [ -n "$again" ] && mounted_recovery=$RECOVERY_MNT
        [ "$again" = "$recovery_entry" ] ||
            die "the recovery partition ${update_disk}p${recovery_entry} was not found again; the \
root is written and its archive still says an update is in progress; run the update once more"
        archive_keep=""
        write_archive "$keep"
        # The copy of the old root is not needed once the archive no longer
        # names it.
        rm -rf "${RECOVERY_MNT:?}/$KEEP_STORE" ||
            die "the copy of the old root on the recovery partition could not be removed"
        sync
        umount "$RECOVERY_MNT" || die "the recovery partition would not unmount"
        mounted_recovery=""
        if mount_store "$target" 6; then
            rm -rf "$keep_dir" || die "the copy of the old root on the data partition could not be removed"
            sync
            unmount_store
        fi
        say "the configuration is archived on ${update_disk}p${recovery_entry}"
    fi
    rm -rf "$keep"

    set_update_recordfail "${update_disk}p1"
    if [ -n "$update_console" ] || [ -n "$update_i915" ]; then
        set_update_console "${update_disk}p1" "${update_console:+1}" \
            "${update_i915:-0}"
    fi

    # One trial boot of the new root. The saved default is still recovery, so a
    # root that does not come up costs a reboot and the machine lands in the
    # system that can repair it; `bootctl commit` from the booted new root is
    # what finally makes it the default.
    if bootctl --target "${update_disk}p1" trial candidate; then
        say "the new root is armed for one trial boot"
    else
        die "the new root is on the disk and no trial was armed; arm one with \
bootctl --target ${update_disk}p1 trial candidate"
    fi
    say "updated: ${update_disk}p${root_entry} carries the new root with this machine's \
accounts. Reboot to try it."
    exit 0
fi

source_disk=-1
if [ -n "$source_dir" ]; then
    [ -f "$source_dir/rach2-install.manifest" ] ||
        die "$source_dir holds no rach2-install.manifest"
else
    greet
    say "looking for the image on the removable disks"
    found=$(find_source)
    case "$?" in
        0) ;;
        2) die "a volume this looked at would not unmount; nothing was written" ;;
        *) die "no stick with an image on it was found" ;;
    esac
    source_disk=${found%% *}
    source_dir=${found#* }
    mounted_source=$source_dir
fi

image=$(sed -n 's/^image //p' "$source_dir/rach2-install.manifest")
bytes=$(sed -n 's/^bytes //p' "$source_dir/rach2-install.manifest")
want=$(sed -n 's/^sha256 //p' "$source_dir/rach2-install.manifest")
[ -n "$image" ] && [ -n "$bytes" ] && [ -n "$want" ] ||
    die "the manifest does not name an image, a length and a hash"
[ -f "$source_dir/$image" ] || die "$source_dir holds no $image"

say "the image is $image, $bytes bytes"

# ---- which disks could take it ----
#
# A disk is a candidate when it is fixed, nothing is mounted from it, its
# sector is 512 bytes, it is not the stick this is running from, and it is
# large enough. The ones it could take are numbered first, since those are what
# the next question is about; the ones it passed over come after, with the
# reason for each, because a person at a machine with two disks in it needs to
# know which was left out and why.

tell "Rach2 can be written to these disks:"
candidates=""
skipped=""
disk_count=0
for n in $(disk_numbers); do
    sectors=$(disk_field "$n" 5)
    size=$((sectors * 512))
    # Everything this knows about the disk, on three lines rather than one. A
    # model of forty characters beside a serial of twenty and a size in bytes
    # would make a single line of 132 columns, which an eighty-column screen
    # folds in the middle of whichever field it reaches first.
    what="/dev/disk$n, $size bytes"
    what_model="$(disk_model "$n")"
    what_more="$(disk_field "$n" 3), $(identity_field "$n" "$FIXED_OR_NOT"), \
table $(disk_field "$n" 6), serial $(disk_serial "$n")"
    if [ "$n" = "$source_disk" ]; then
        skipped="$skipped\n  /dev/disk$n is the stick this is running from"
        continue
    fi
    if [ "$(identity_field "$n" "$FIXED_OR_NOT")" = "removable" ]; then
        # A disk that can be pulled out is not one this system boots from:
        # the firmware and the kernel both take their root from a fixed one.
        skipped="$skipped\n  /dev/disk$n can be pulled out, and this system does not boot from one"
        continue
    fi
    if [ "$(identity_field "$n" "$MOUNT_STATE")" = "mounted" ]; then
        skipped="$skipped\n  /dev/disk$n has something mounted from it"
        continue
    fi
    if [ "$(identity_field "$n" "$SECTOR_SIZE")" != "512" ]; then
        skipped="$skipped\n  /dev/disk$n counts in $(identity_field "$n" "$SECTOR_SIZE")-byte sectors, not 512"
        continue
    fi
    if [ "$size" -lt "$bytes" ]; then
        skipped="$skipped\n  /dev/disk$n holds $size bytes and the image is $bytes"
        continue
    fi
    disk_count=$((disk_count + 1))
    echo "  $disk_count) $what"
    echo "     $what_model"
    echo "     $what_more"
    candidates="$candidates $n"
done
if [ -n "$skipped" ]; then
    tell "These disks were passed over:"
    printf '%b\n' "$skipped" | sed '/^$/d'
fi
[ -n "$candidates" ] && [ "$candidates" != " " ] ||
    die "no disk of this machine can take the image"

# ---- the questions ----
#
# All of them are asked before anything is written, and the last of them is the
# confirmation, so a person who changes their mind has not left a disk half
# written.

# Ends the run when the answers end before the last question. Nothing is
# written yet, and a question asked again would only meet the end again. A
# caller calls it only when its read took nothing, since a last line with no
# newline is still an answer.
no_answer() {
    die "the answers ended before the questions did; nothing was written"
}

# Asks for a password twice, with the terminal's echo off, until the two are
# the same and not empty, and leaves it in `password`. `stty` is put back
# however this ends, since a shell left with no echo is a shell nobody can use.
ask_password() { # ask_password PROMPT
    while :; do
        echo_off=yes
        stty -echo 2>/dev/null
        printf '%s: ' "$1"
        read -r pw1 || [ -n "$pw1" ] || no_answer
        printf '\n%s again: ' "$1"
        read -r pw2 || [ -n "$pw2" ] || no_answer
        stty echo 2>/dev/null
        echo_off=""
        printf '\n'
        if [ -z "$pw1" ]; then
            tell "An empty password will not do. Type one."
            continue
        fi
        if [ "$pw1" != "$pw2" ]; then
            tell "Those two were different. Type it again."
            continue
        fi
        password=$pw1
        return 0
    done
}

# The name rules are the ones every account file here is read under: a letter
# first, then letters, digits, hyphen and underscore, at most 32 characters,
# and not root, whose account this writes itself. Status 0 when NAME follows
# them.
check_name() { # check_name NAME
    case "$1" in
        "" | *[!a-z0-9_-]* | [!a-z]*)
            return 1
            ;;
    esac
    [ "${#1}" -le 32 ] || return 1
    [ "$1" != "root" ] || return 1
    return 0
}

# Prints why a name was refused, in one clause, naming the rule it broke rather
# than reciting all of them: a person who typed `ROOT` is helped by being told
# that names are lowercase and not by the whole sentence about letters and
# digits.
name_fault() { # name_fault NAME
    case "$1" in
        "") echo "a name cannot be empty" ;;
        *[A-Z]*) echo "names are lowercase" ;;
        [!a-z]*) echo "a name starts with a letter" ;;
        *[!a-z0-9_-]*) echo "a name takes letters, digits, - and _ only" ;;
        *)
            if [ "$1" = "root" ]; then
                echo "root is made by this install already"
            elif [ "${#1}" -gt 32 ]; then
                echo "a name is at most 32 characters and that is ${#1}"
            else
                echo "that is not a name this system takes"
            fi
            ;;
    esac
}

target=""
while :; do
    printf 'Which disk shall Rach2 be written to? A number above, or its name: '
    read -r answer || [ -n "$answer" ] || no_answer
    i=0
    for n in $candidates; do
        i=$((i + 1))
        if [ "$answer" = "/dev/disk$n" ] || [ "$answer" = "$i" ]; then
            target=$n
        fi
    done
    [ -n "$target" ] && break
    if [ -z "$answer" ]; then
        tell "Nothing was typed. Answer 1 to $disk_count, or the disk's name."
    else
        tell "$answer is not in the list. Answer 1 to $disk_count, or the disk's name."
    fi
done

ask_password "the password for root"
root_password=$password
while :; do
    printf 'The name of the first account: '
    read -r user_name || [ -n "$user_name" ] || no_answer
    check_name "$user_name" && break
    tell "$(name_fault "$user_name"). Try another."
done
ask_password "the password for $user_name"
user_password=$password
# The keys are offered, not demanded. A person at a console should not have to
# type a path from memory, and a path typed wrong should not throw away the
# answers already given: what this can find is listed and chosen by number, a
# path still works for anything it did not find, nothing means no keys, and a
# wrong answer is asked again rather than ending the run.
key_choices=""
key_count=0
for d in "$source_dir" /root /root/.ssh /tmp /; do
    [ -d "$d" ] || continue
    for f in "$d"/*.pub "$d"/authorized_keys; do
        [ -f "$f" ] || continue
        case " $key_choices " in *" $f "*) continue ;; esac
        key_count=$((key_count + 1))
        key_choices="$key_choices $f"
    done
done
if [ "$key_count" -gt 0 ]; then
    tell "These keys are on this machine:"
    i=0
    for f in $key_choices; do
        i=$((i + 1))
        tell "  $i) $f"
    done
fi
user_keys=""
while :; do
    if [ "$key_count" -gt 0 ]; then
        tell "Authorized keys for $user_name:"
        printf 'A number above, a path, or nothing: '
    else
        tell "A file of authorized keys for $user_name:"
        printf 'A path, or nothing: '
    fi
    read -r user_keys || [ -n "$user_keys" ] || no_answer
    [ -z "$user_keys" ] && break
    case "$user_keys" in
        *[!0-9]*) ;;
        *)
            if [ "$user_keys" -ge 1 ] && [ "$user_keys" -le "$key_count" ]; then
                i=0
                for f in $key_choices; do
                    i=$((i + 1))
                    [ "$i" = "$user_keys" ] && user_keys=$f && break
                done
            fi
            ;;
    esac
    [ -f "$user_keys" ] && break
    tell "$user_keys is not a file. Try again, or type nothing for no keys."
done
# The recovery system on the disk starts an SSH server only where it has a
# key, and a root update runs from recovery, so a machine that is to be
# updated over the network needs a key there. The image's recovery system has
# one only when it was built with one; this puts a file beside it on the
# recovery partition, which init reads when that partition boots. The key is
# offered as the account's keys are, and it must be one init will take: a
# private key, a file of nothing but comments and one larger than init reads
# are said and asked again. What is judged is a copy of the file, made in a
# directory of this run's own so that nothing another process put in /tmp is
# followed, with a newline added to a last line that has none; that copy is
# what is written, so the file cannot change between the two and the size
# judged is the size init reads.
#
# The function below prints why FILE will not do as that key file, or nothing
# when it will: init reads at most 16384 bytes of it, and takes no file that
# has a NUL byte, a private key, or no line that is neither blank nor a
# comment.
recovery_key_fault() { # recovery_key_fault FILE: why FILE will not do, or nothing
    if [ "$(wc -c < "$1")" -gt 16384 ]; then
        echo "is larger than 16384 bytes with its last line ended"
    elif od -An -tx1 "$1" | grep -q ' 00'; then
        echo "is not text"
    elif grep -q 'PRIVATE KEY' "$1"; then
        echo "holds a private key; give the public half, the file ending .pub"
    elif ! grep -q '^[[:space:]]*[^#[:space:]]' "$1"; then
        echo "has no line that is a key"
    fi
}
recovery_keys=""
while :; do
    tell "A key for the recovery system on this disk, so that it can be updated over"
    tell "the network. With none, it starts an SSH server only if its image has a key."
    if [ "$key_count" -gt 0 ]; then
        printf 'A number above, a path, or nothing: '
    else
        printf 'A path, or nothing: '
    fi
    read -r recovery_keys || [ -n "$recovery_keys" ] || no_answer
    [ -z "$recovery_keys" ] && break
    case "$recovery_keys" in
        *[!0-9]*) ;;
        *)
            if [ "$recovery_keys" -ge 1 ] && [ "$recovery_keys" -le "$key_count" ]; then
                i=0
                for f in $key_choices; do
                    i=$((i + 1))
                    [ "$i" = "$recovery_keys" ] && recovery_keys=$f && break
                done
            fi
            ;;
    esac
    if [ ! -f "$recovery_keys" ]; then
        tell "$recovery_keys is not a file. Try again, or type nothing for no key."
        continue
    fi
    if [ -z "$key_dir" ]; then
        key_dir=$(mktemp -d /tmp/rach2-install.XXXXXX) ||
            die "no private directory could be made for the key's copy"
    fi
    key_copy=$key_dir/key
    if ! head -c 16385 "$recovery_keys" > "$key_copy"; then
        rm -f "$key_copy"
        tell "$recovery_keys cannot be read. Try again, or type nothing for no key."
        continue
    fi
    if [ -n "$(tail -c 1 "$key_copy")" ]; then
        echo >> "$key_copy"
    fi
    fault=$(recovery_key_fault "$key_copy")
    [ -z "$fault" ] && break
    rm -f "$key_copy"
    tell "$recovery_keys $fault. Try again, or type nothing for no key."
done
# The root's size: the root grows to it and the rest of the disk becomes the
# data partition. `whole`, or `yes` as the question was once answered, grows
# the root into the whole disk with no data partition, and `no` leaves the
# disk as the image has it.
tell "The root grows to the size you give, and the rest of the disk becomes the data"
tell "partition, which keeps games and the disks of virtual machines across updates."
tell "Give a size such as 64G, whole for no data partition, or no to grow nothing."
while :; do
    printf 'Grow the root to what size? [%s] ' "$ROOT_DEFAULT"
    read -r grow_answer || [ -n "$grow_answer" ] || no_answer
    grow=yes
    root_size=$grow_answer
    case "$grow_answer" in
        "") root_size=$ROOT_DEFAULT ;;
        whole | y | yes) root_size="" ;;
        n | no)
            grow=no
            root_size=""
            ;;
    esac
    { [ -z "$root_size" ] || size_sectors "$root_size" > /dev/null; } && break
    tell "$grow_answer is not a size such as 64G, nor whole or no."
done

# Everything that was answered, on one screen, before the one step that cannot
# be taken back. A person who has answered six questions in a row should not
# have to remember what they said to know what is about to happen. One fact a
# line, and no column that a long model name or serial can push past the edge:
# the screen is eighty columns, a disk identifies itself in as many characters
# as it likes, and a line that wraps in the middle of a serial number is worse
# than no line. Nothing here is shortened to fit.
tell ""
tell "Check this before you go on."
tell ""
tell "Disk to erase: /dev/disk$target"
tell "  model:  $(disk_model "$target")"
tell "  serial: $(disk_serial "$target")"
tell "  size:   $(($(disk_field "$target" 5) * 512)) bytes"
tell "  bus:    $(disk_field "$target" 3)"
tell "  now:    $(identity_field "$target" "$FIXED_OR_NOT"), partition table $(disk_field "$target" 6)"
tell "Accounts to make: root, and $user_name"
if [ -n "$user_keys" ]; then
    tell "Keys for $user_name:"
    tell "  $user_keys"
else
    tell "Keys for $user_name: none"
    tell "  Both accounts use their passwords."
fi
if [ -n "$recovery_keys" ]; then
    tell "Key for the recovery system:"
    tell "  $recovery_keys"
else
    tell "Key for the recovery system: none"
fi
if [ "$grow" = "yes" ] && [ -n "$root_size" ]; then
    tell "Root partition: grown to $root_size, with the rest of the disk the data partition"
    tell "  when there is room for one. This takes some minutes."
elif [ "$grow" = "yes" ]; then
    tell "Root partition: grown to fill the disk. This takes some minutes."
else
    tell "Root partition: left at the size the image has"
fi
tell ""
tell "Everything on /dev/disk$target is erased."
# A typo here should cost a retype and not the six answers above, so a wrong
# word asks again; stopping is a word of its own rather than anything that is
# not the disk's name.
while :; do
    printf 'Type /dev/disk%s to go on, or stop to stop: ' "$target"
    read -r confirm || [ -n "$confirm" ] || no_answer
    [ "$confirm" = "/dev/disk$target" ] && break
    case "$confirm" in
        stop | STOP | Stop | quit | q) die "nothing was written" ;;
    esac
    tell "That is not /dev/disk$target."
done

# The disk the answer was given about, by its serial and size. A disk that
# goes and comes back takes a fresh record, so the write below stops rather
# than landing on whatever took its place.
target_serial=$(disk_serial "$target")
target_sectors=$(disk_field "$target" 5)

# ---- the write ----
#
# The image is hashed here, after the last question and before the first write:
# a stick that has gone bad is found before anything is destroyed, and a run
# that ends at a question has not paid for the reading.

# The length the manifest declares is the length the file has: a manifest whose
# `bytes` was changed and whose hash was not would otherwise send `reflash` a
# count that is not the image's, and the disk is written before the stream's
# end says so.
actual=$(stat -c %s "$source_dir/$image")
[ "$actual" = "$bytes" ] ||
    die "the manifest says $bytes bytes and $image is $actual"

# A step with nothing to show is one a person reads as a machine that has
# stopped, so what it is doing and that it will be quiet are said first.
say "checking the image against the manifest: reading all $bytes bytes, which takes \
a few minutes and prints nothing until it is done"
# Cache read-ahead avoids a disk request for each small sha256sum read.
got=$(sha256sum "$source_dir/$image" | cut -d' ' -f1)
[ "$got" = "$want" ] ||
    die "the image on the stick hashes to $got and the manifest says $want"
say "the image on the stick is the one the manifest describes"

# The disk's serial and sector count are read again before the first byte and
# after the last: a disk pulled out between the question and the write takes a
# fresh record when it comes back, and that record describes another disk.
[ "$(disk_serial "$target")" = "$target_serial" ] &&
    [ "$(disk_field "$target" 5)" = "$target_sectors" ] ||
    die "/dev/disk$target is no longer the disk the question was answered about"

say "writing $bytes bytes to /dev/disk$target"
if ! reflash -p "/dev/disk$target" 0 "$bytes" < "$source_dir/$image"; then
    die "the image was not written"
fi
[ "$(disk_serial "$target")" = "$target_serial" ] &&
    [ "$(disk_field "$target" 5)" = "$target_sectors" ] ||
    die "/dev/disk$target is not the disk the question was answered about"

say "reading it back"
back=$(reflash --verify "/dev/disk$target" 0 "$bytes" | cut -d' ' -f3)
[ "$back" = "$want" ] ||
    die "what reached the disk hashes to $back and the image hashes to $want"
say "what reached the disk is the image"

# ---- the new table ----
#
# An image with a GUID table, which a protective MBR's type 0xEE in its first
# entry says it has, carries its backup where the image ends, and the disk is
# usually larger: the backup goes to the disk's last sectors, where a reader
# looks for it, and the kernel reads the table again. An MBR needs only the
# reading.

if [ "$(dd if="$source_dir/$image" bs=1 skip=450 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')" = ee ]; then
    diskctl relocate "/dev/disk$target" ||
        die "the GUID table's backup was not moved to the disk's end"
else
    diskctl reread "/dev/disk$target" || die "the new table was not read"
fi
say "the table is the one the image carries:"
grep "^part $target " /proc/disk | sed 's/^/  /'

# ---- the accounts ----
#
# The image carries the accounts it was built with, which are a demonstration's
# and not this machine's. They are replaced here, on the root the installed
# system boots: the three files are small and a fresh install knows all of
# their contents, so each is written whole to a name of its own and renamed
# into place, which is the write a stop in the middle leaves undone rather than
# half done.
#
# The root is found rather than assumed: the highest-numbered of entries 1 to
# 4 that mounts as ext2 and has an `/etc/passwd` is the root both kernel
# entries boot. The recovery system's own image keeps the credentials it was
# built with, since it is the way back into a machine whose new root will not
# come up.

# Prints the root's entry number on the disk `target` names and where it was
# mounted, and leaves it mounted. Status 1 when no entry has a root.
find_root() {
    for p in 4 3 2 1; do
        [ -e "/dev/disk${target}p${p}" ] || continue
        mkdir -p "$TARGET_MNT" 2>/dev/null
        mount -t ext2 "/dev/disk${target}p${p}" "$TARGET_MNT" 2>/dev/null || continue
        if [ -f "$TARGET_MNT/etc/passwd" ]; then
            echo "$p $TARGET_MNT"
            return 0
        fi
        umount "$TARGET_MNT" 2>/dev/null
    done
    return 1
}

found_root=$(find_root) || die "the disk carries no ext2 root to write the accounts into"
root_entry=${found_root%% *}
root_dir=${found_root#* }
mounted_root=$root_dir
say "writing the accounts into the ext2 root at $root_dir"

# Prints PASSWORD's SHA-512 crypt hash, the form /etc/shadow holds.
hash_of() { # hash_of PASSWORD
    printf '%s\n' "$1" | mkpasswd -m sha512 -P 0
}

root_hash=$(hash_of "$root_password")
user_hash=$(hash_of "$user_password")
[ -n "$root_hash" ] && [ -n "$user_hash" ] || die "the passwords could not be hashed"

# Writes CONTENT to PATH.new with MODE and renames it to PATH, so a stop
# leaves the old file or the new one whole; a failure ends the run.
put_file() { # put_file PATH MODE CONTENT
    printf '%s' "$3" > "$1.new" || die "$1 could not be written"
    chmod "$2" "$1.new" || die "$1 could not be given its mode"
    mv "$1.new" "$1" || die "$1 could not be put in place"
}

image_etc=$(mktemp -d /tmp/rach2-install.XXXXXX) || die "there is nowhere to keep the image's accounts"
mkdir -p "$image_etc/etc" || die "there is nowhere to keep the image's accounts"
for f in passwd group shadow; do
    if [ -f "$root_dir/etc/$f" ]; then
        cp "$root_dir/etc/$f" "$image_etc/etc/$f" || die "the image's /etc/$f could not be read"
    fi
done
put_file "$root_dir/etc/passwd" 644 "root:x:0:0:root:/root:/bin/sh
$user_name:x:1000:1000:$user_name:/home/$user_name:/bin/sh
"
put_file "$root_dir/etc/group" 644 "root:x:0:
$user_name:x:1000:
"
put_file "$root_dir/etc/shadow" 600 "root:$root_hash:0:0:99999:7:::
$user_name:$user_hash:0:0:99999:7:::
"
keep_image_accounts "$image_etc" "$root_dir" ||
    die "the image's system accounts could not be kept beside the new ones"
rm -rf "$image_etc"

# The account's home, and the keys if any were given. The demonstration's home
# and its keys go, whatever they were called.
rm -rf "${root_dir:?}/home" 2>/dev/null
mkdir -p "$root_dir/home/$user_name" || die "the home directory could not be made"
chmod 700 "$root_dir/home/$user_name"
chown 1000:1000 "$root_dir/home/$user_name" 2>/dev/null
rm -rf "$root_dir/root/.ssh" 2>/dev/null
if [ -n "$user_keys" ]; then
    mkdir -p "$root_dir/home/$user_name/.ssh"
    chmod 700 "$root_dir/home/$user_name/.ssh"
    cp "$user_keys" "$root_dir/home/$user_name/.ssh/authorized_keys" ||
        die "the keys could not be copied"
    chmod 600 "$root_dir/home/$user_name/.ssh/authorized_keys"
    chown 1000:1000 "$root_dir/home/$user_name/.ssh" \
        "$root_dir/home/$user_name/.ssh/authorized_keys" 2>/dev/null
    say "the keys in $user_keys are $user_name's"
fi

# Root over SSH with a password, which is this system's policy once it is
# installed: the person who installed it chose that password and may have no
# key at all. `init` reads this file and drops dropbear's `-g` for it.
mkdir -p "$root_dir/etc/rach2"
put_file "$root_dir/etc/rach2/sshd.conf" 644 "root-password-login yes
"

sync
# Accounts, policy and keys are archived for a root that no longer reads, and
# the recovery system's key goes beside its kernel. With no key given, a key
# the image carried there is removed, so a disk installed without one has none.
find_recovery "$target"
recovery_entry=$recovery_found
if [ -n "$recovery_entry" ]; then
    mounted_recovery=$RECOVERY_MNT
    archive_root=$(root_place "$target" "$root_entry") ||
        die "the root partition's place could not be read"
    write_archive "$root_dir"
    if [ -n "$recovery_keys" ]; then
        cp "$key_copy" "$RECOVERY_MNT/$RECOVERY_KEYS_FILE" ||
            die "the key for the recovery system could not be written"
    else
        rm -f "$RECOVERY_MNT/$RECOVERY_KEYS_FILE" ||
            die "the key the image carried for the recovery system could not be removed"
    fi
    sync
    umount "$RECOVERY_MNT" || die "the recovery partition would not unmount"
    mounted_recovery=""
    say "the configuration is archived on /dev/disk${target}p${recovery_entry}"
    if [ -n "$recovery_keys" ]; then
        say "the recovery system on /dev/disk${target}p${recovery_entry} takes the key in $recovery_keys"
    fi
else
    say "the disk has no recovery partition, so the configuration is not archived"
    if [ -n "$recovery_keys" ]; then
        say "and the key for the recovery system has nowhere to go, so it was not placed"
    fi
fi
umount "$root_dir" || die "the root would not unmount"
mounted_root=""

say "the accounts are root and $user_name, and root may log in over SSH with a password"

# ---- the root's size ----
#
# The image is as large as it was built and the disk is usually larger. The root
# is the last partition of the image, so the space after it is free. The data
# partition is made first, after the root's room, when the disk has space for
# one, and `growroot` then grows the root's entry up to it, or to the disk's
# end, and the file system with it: the entry first, then the checker, then
# the resizer, each of which a run stopped in the middle leaves for the next
# run to finish. Both run on volumes nothing has mounted, which is why they
# come after the accounts and not before them.

if [ "$grow" = "yes" ]; then
    spec=$(disk_identity "$target") || die "the disk's identity could not be read"
    data_from=""
    if [ -n "$root_size" ]; then
        data_from=$(data_start "$target" "$root_entry" "$(size_sectors "$root_size")")
        [ -n "$data_from" ] ||
            say "the disk has no room for a data partition after a root of $root_size"
    fi
    if [ -n "$data_from" ]; then
        make_data "$target" "$data_from"
        say "growing the root to $root_size, up to the data partition: a check, a repair \
pass and the resize, each of which takes minutes and is quiet while it runs"
    else
        say "growing the root into the rest of the disk: a check, a repair pass and the \
resize, each of which takes minutes and is quiet while it runs"
    fi
    growroot "$spec,$root_entry" ||
        die "the root was not grown; the disk carries the image and boots as it is"
fi
say "installed: /dev/disk$target now carries this system. Reboot from it."
