#!/bin/sh
#
# rach2-install: install this system onto a disk of this machine.
#
# It runs from the recovery system booted off the install stick. The stick
# has the whole disk image and a manifest naming that image's length and
# SHA-256. This reads the manifest, lists the disks it could write with what
# each one is, and asks its questions, the last of which is the chosen disk's
# name typed back. Then it hashes the image, writes it, reads it back and
# hashes it again, has the kernel read the new table, writes the accounts
# into the new root, archives them on the recovery partition, and grows the
# root when the answer to that question was yes.
#
# The name is `rach2-install` and not `install` because the shell resolves
# `install` to BusyBox's own applet before it searches the path.
#
# Nothing is written until the question about the target has been answered
# with the device's own name. Every disk passed over is listed with the
# reason, because a person standing at a machine with two disks in it needs
# to know which one was passed over and for what.
#
# Usage: rach2-install [--source DIR]
#        rach2-install --update IMAGE DISK
#
# `--source DIR` takes the image and its manifest from a directory already
# mounted, which is how the tests drive it without a stick.
#
# `--update` writes a root file system image into the root partition of a
# machine that is already installed, without moving its partitions. The account
# files, the SSH policy, the server's host keys and the accounts' own keys are
# copied off the root first and written back afterwards, so a password changed
# after the install is still the machine's password. The root is grown again
# into its partition. The machine is saved to its recovery system for the whole
# of the write and the new root is armed for one trial boot, so an update cut
# off by a power cut, or one that does not come up, costs a reboot into recovery
# and not a visit to the machine. An MBR disk is converted on the way to boot by
# UEFI as well, when GRUB's EFI image is beside IMAGE: it keeps its MBR, and its
# boot partition becomes the EFI system partition.
#
# A new install writes the image's table, a GUID table on the images this
# system builds, and moves its backup to the disk's last sectors, where a
# reader looks for it on a disk larger than the image.
#

set -u

ME=rach2-install
MNT=/mnt/install-source
TARGET_MNT=/mnt/install-root
RECOVERY_MNT=/mnt/install-recovery
BOOT_MNT=/mnt/install-boot
CONFIG_FILES="etc/passwd etc/group etc/shadow etc/rach2/sshd.conf"
ARCHIVE_NEEDS="etc/passwd etc/group etc/shadow"
# The recovery system's key, on the recovery partition, where its init reads it.
RECOVERY_KEYS_FILE=boot/recovery_authorized_keys

# Prints MESSAGE on stdout as `rach2-install: MESSAGE`, a note of progress.
say() { echo "$ME: $1"; }
# Text addressed to the person, with no `rach2-install: ` in front of it. The
# prefix is for a diagnostic, which says which program is reporting a fault; a
# question or an explanation is neither. It also costs fifteen columns of an
# eighty-column screen, enough to wrap the lines of the summary below and make
# a mess of the one screen that has to be read.
tell() { echo "$1"; }
# Prints MESSAGE on stderr as `rach2-install: MESSAGE` and ends the run with
# status 1; the EXIT trap then puts back what the run changed.
die() {
    echo "$ME: $1" >&2
    exit 1
}

# What this mounted, unmounted however it ends. A source left mounted would
# make the next run report that it could find no stick, and a root left mounted
# would keep the disk from being read again.
mounted_source=""
mounted_root=""
mounted_recovery=""
mounted_boot=""
key_dir=""
echo_off=""
screen_level=""
# The screen is shared with the kernel's own record, and a routine note from a
# disk or a file system arriving in the middle of a question reads, to the
# person answering it, as something having gone wrong. The records are still
# kept and still go out the serial port; only the screen is turned down, and
# only while this runs. The level asked for is 2, the kernel's floor, at which a
# panic still shows: a middle value would make the screen noisier, since the
# kernel has usually set the floor already when it started init. The level it
# had is saved in screen_level for `cleanup`; nothing is changed where
# /dev/screenlog cannot be written.
quiet_screen() {
    [ -w /dev/screenlog ] || return 0
    screen_level=$(cat /dev/screenlog 2>/dev/null) || screen_level=""
    # 2 is KLOG_CRIT, the lowest level the kernel takes.
    echo 2 > /dev/screenlog 2>/dev/null || screen_level=""
}
# Puts back what the run changed and has not yet put back: the screen's
# level, the terminal's echo, which a run that ends inside a password question
# leaves off, the four mounts and the directory of the recovery key's copy.
# The traps call it; it returns 0.
cleanup() {
    [ -n "$screen_level" ] && echo "$screen_level" > /dev/screenlog 2>/dev/null
    [ -n "$echo_off" ] && stty echo 2>/dev/null
    [ -n "$mounted_root" ] && umount "$mounted_root" 2>/dev/null
    [ -n "$mounted_recovery" ] && umount "$mounted_recovery" 2>/dev/null
    [ -n "$mounted_boot" ] && umount "$mounted_boot" 2>/dev/null
    [ -n "$mounted_source" ] && umount "$mounted_source" 2>/dev/null
    [ -n "$key_dir" ] && rm -rf "$key_dir"
    return 0
}
# A signal ends the run. A handler that tidied up and returned would let the
# next command write into a directory whose file system had just been
# unmounted under it.
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
trap 'cleanup; exit 129' HUP
quiet_screen

# Prints the opening screen of an install from the stick: what the program
# does and how to stop it.
greet() {
    tell "Rach2 installer"
    tell ""
    tell "This program puts Rach2 on a disk in this computer."
    tell "It asks you which disk, and it asks you to make two accounts."
    tell "It erases everything on the disk you choose."
    tell "It writes nothing until you type the name of that disk at the end."
    tell "To stop before then, hold Control and press C."
    tell ""
}

source_dir=""
update_image=""
update_disk=""
while [ $# -gt 0 ]; do
    case "$1" in
        --source)
            [ $# -ge 2 ] || die "--source takes a directory"
            source_dir=$2
            shift 2
            ;;
        --update)
            [ $# -ge 3 ] || die "--update takes an image and a disk"
            update_image=$2
            update_disk=$3
            shift 3
            ;;
        *)
            die "usage: $ME [--source DIR] | $ME --update IMAGE DISK"
            ;;
    esac
done

# ---- the disks this machine has ----
#
# `/proc/disk` names each registered disk on a `disk` line and describes it on
# the `identity` line after it. Both are read here rather than the nodes being
# guessed, since a disk that has gone leaves its node named and unopenable.
# Each function below prints nothing for a disk /proc/disk does not list.

# Prints the number of each disk /proc/disk lists, one a line.
disk_numbers() {
    grep '^disk ' /proc/disk | cut -d' ' -f2
}

# Prints field FIELD of disk N's `disk` line, counted as the table below
# counts them.
disk_field() { # disk_field N FIELD
    grep "^disk $1 " /proc/disk | head -1 | cut -d' ' -f"$2"
}

# Prints disk N's model, the rest of its `disk` line from field 7.
disk_model() {
    grep "^disk $1 " /proc/disk | head -1 | cut -d' ' -f7-
}

# Prints field FIELD of disk N's `identity` line.
identity_field() { # identity_field N FIELD
    grep "^identity $1 " /proc/disk | head -1 | cut -d' ' -f"$2"
}

# Prints disk N's serial, the rest of its `identity` line from field 6.
disk_serial() {
    grep "^identity $1 " /proc/disk | head -1 | cut -d' ' -f6-
}

# Prints the identity growroot and the boot line name disk N by, `MBRID=ID` or
# `GPTID=GUID`, by the table the kernel read on it. Status 1 when `diskctl`
# cannot read the identity or the disk has neither table.
disk_identity() { # disk_identity N
    id=$(diskctl id "/dev/disk$1") || return 1
    case "$(disk_field "$1" 6)" in
        mbr) echo "MBRID=$id" ;;
        gpt) echo "GPTID=$id" ;;
        *) return 1 ;;
    esac
}

# The fields of the two lines, counting the word that names them:
#   disk     N TRANSPORT LOCATION SECTORS TABLE MODEL...
#   identity N SECTOR-SIZE fixed|removable mounted|free SERIAL...
SECTOR_SIZE=3
FIXED_OR_NOT=4
MOUNT_STATE=5

# ---- the image and its manifest ----
#
# The stick is found by looking for the manifest rather than by position: the
# machine may have any number of disks and the stick is not always the last of
# them. Each of the first four partitions of every removable disk is tried,
# and the first that mounts as exFAT and holds a manifest is the source.

# Prints the disk's number and where its volume was mounted, so the caller
# knows both which disk to leave out of the offer and what to unmount. Status 1
# when no disk has the manifest, and 2 when a volume it mounted to look would
# not unmount, since a search that went on would mount the next one over it.
find_source() {
    for n in $(disk_numbers); do
        [ "$(identity_field "$n" "$FIXED_OR_NOT")" = "removable" ] || continue
        for p in 1 2 3 4; do
            [ -e "/dev/disk${n}p${p}" ] || continue
            mkdir -p "$MNT" 2>/dev/null
            mount -t exfat "/dev/disk${n}p${p}" "$MNT" 2>/dev/null || continue
            if [ -f "$MNT/rach2-install.manifest" ]; then
                echo "$n $MNT"
                return 0
            fi
            umount "$MNT" || {
                echo "$ME: /dev/disk${n}p${p} would not unmount" >&2
                return 2
            }
        done
    done
    return 1
}

# ---- the archive ----
#
# The account files, SSH policy and keys on the recovery partition, written
# at the install and refreshed at every update, so that a machine whose root
# no longer reads can still be updated without losing its accounts. The
# passwords are the hashes the files already hold. The recovery partition is
# the FAT32 volume that holds the recovery kernel, /boot/recovery, found by
# that file and not assumed to be a particular entry.

# Where DEVICE is mounted other than at this run's own mount points, printed,
# or a failure when it is mounted nowhere else.
mounted_elsewhere() { # mounted_elsewhere DEVICE
    awk -v d="$1" -v a="$TARGET_MNT" -v b="$RECOVERY_MNT" '
        $1 == d && $2 != a && $2 != b { print $2; found = 1; exit }
        END { exit !found }' /proc/mounts
}

# The recovery partition's number goes in recovery_found, empty when the disk
# has none; it is left mounted at RECOVERY_MNT, with the archive's files
# readable by root alone. It runs in this shell and not in a command
# substitution, so that `die` ends the run: a partition mounted elsewhere,
# which a mount here cannot open, may be the recovery partition, and a run
# that went on without it would write a root with no archive of the
# machine's configuration behind it. A volume that was mounted to look and
# will not unmount ends the run too, since the raw writer fails on a disk
# with a mount on it. Status 0 when the disk has a recovery partition and 1
# when it has none.
find_recovery() { # find_recovery DISKNUMBER
    recovery_found=""
    for p in 1 2 3 4; do
        [ -e "/dev/disk${1}p${p}" ] || continue
        mkdir -p "$RECOVERY_MNT" 2>/dev/null
        if ! mount -t vfat -o umask=077 "/dev/disk${1}p${p}" "$RECOVERY_MNT" 2>/dev/null; then
            if where=$(mounted_elsewhere "/dev/disk${1}p${p}"); then
                die "/dev/disk${1}p${p} is mounted at $where, so it cannot be looked at for the recovery partition; unmount it and run this again"
            fi
            continue
        fi
        if [ -f "$RECOVERY_MNT/boot/recovery" ]; then
            recovery_found=$p
            return 0
        fi
        umount "$RECOVERY_MNT" || die "/dev/disk${1}p${p} was mounted to look for the recovery partition and would not unmount"
    done
    return 1
}

# archive_complete [DIR]: whether DIR, or the directory `archive` names when
# DIR is not given, holds every file of ARCHIVE_NEEDS, the files an update
# cannot do without.
archive_complete() {
    for f in $ARCHIVE_NEEDS; do
        [ -f "${1:-$archive}/$f" ] || return 1
    done
    return 0
}

# The archive to read goes in `archive`, empty when there is none, and its
# generation in `generation`. It is selected without renaming: FAT32 can lose
# both names during a rename. rach2-config, rach2-config.new and
# rach2-config.old count as generation zero, tried in that order. The slots
# rach2-config-a and rach2-config-b require a valid generation, written after
# all their contents, and the highest wins. The recovery partition must be
# mounted at RECOVERY_MNT.
recover_archive() {
    archive=""
    generation=0
    for candidate in rach2-config rach2-config.new rach2-config.old \
        rach2-config-a rach2-config-b; do
        candidate="$RECOVERY_MNT/$candidate"
        archive_complete "$candidate" || continue
        number=0
        case "$candidate" in
        "$RECOVERY_MNT/rach2-config-a" | "$RECOVERY_MNT/rach2-config-b")
            [ -f "$candidate/generation" ] || continue
            number=$(cat "$candidate/generation") || continue
            case "$number" in "" | *[!0-9]*) continue ;; esac
            number=$(printf '%s\n' "$number" | sed 's/^0*//')
            number=${number:-0}
            [ "${#number}" -le 10 ] && [ "$number" -ge 1 ] &&
                [ "$number" -le 2147483647 ] || continue
            ;;
        esac
        if [ -z "$archive" ] || [ "$number" -gt "$generation" ]; then
            archive=$candidate
            generation=$number
        fi
    done
}

# Whether ROOTDIR has OpenSSH's host keys, the GNU root's server's, in
# ROOTDIR/etc/ssh.
ssh_host_keys() { # ssh_host_keys ROOTDIR
    for k in "$1"/etc/ssh/ssh_host_*; do
        [ -f "$k" ] && return 0
    done
    return 1
}

# Makes the public host keys in DIR readable by all, as OpenSSH writes them;
# a directory with none has nothing to change.
public_keys_readable() { # public_keys_readable DIR
    for k in "$1"/ssh_host_*.pub; do
        [ ! -f "$k" ] || chmod 644 "$k" || return 1
    done
}

# Archives the configuration under ROOTDIR on the recovery partition, mounted
# at RECOVERY_MNT: the files of CONFIG_FILES, both servers' host keys and the
# accounts' keys. They go into the slot that does not hold the current
# archive, which stays whole until the new slot is complete and synced and
# has its generation, one more than the current one. The old archives
# rach2-config, .new and .old are removed after that. A file the root does
# not have is left out, except the account files, without which the run ends.
# With MARK, the slot has a file update-in-progress that holds it, the name
# and length of the image being written, so a retry after a stop takes the
# archive and not the root, which is the image's by then. The slot written is
# left in next_archive; any failure ends the run.
write_archive() { # write_archive ROOTDIR [MARK]
    recover_archive
    for f in $ARCHIVE_NEEDS; do
        [ -f "$1/$f" ] || die "$f is not among the files to archive"
    done
    archive_account_keys "$1" check || die "the account key names could not be archived"
    [ "$generation" -lt 2147483647 ] || die "the archive generation counter is exhausted"
    next_archive="$RECOVERY_MNT/rach2-config-a"
    if [ "$archive" = "$next_archive" ]; then
        next_archive="$RECOVERY_MNT/rach2-config-b"
    fi
    rm -f "$next_archive/generation" || die "the old generation could not be removed"
    sync
    rm -rf "$next_archive" || die "the other archive slot could not be removed"
    mkdir -p "$next_archive/etc/rach2" ||
        die "the archive directory could not be made on the recovery partition"
    for f in $CONFIG_FILES; do
        if [ -f "$1/$f" ]; then
            cp "$1/$f" "$next_archive/$f" || die "$f could not be archived"
        fi
    done
    if [ -d "$1/etc/dropbear" ]; then
        cp -R "$1/etc/dropbear" "$next_archive/etc/dropbear" ||
            die "the host keys could not be archived"
    fi
    if ssh_host_keys "$1"; then
        { mkdir -p "$next_archive/etc/ssh" && cp "$1"/etc/ssh/ssh_host_* "$next_archive/etc/ssh/"; } ||
            die "OpenSSH's host keys could not be archived"
    fi
    archive_account_keys "$1" || die "the account keys could not be archived"
    if [ -n "${2:-}" ]; then
        echo "$2" > "$next_archive/update-in-progress" ||
            die "the update's mark could not be written to the archive"
    fi
    sync
    echo "$((generation + 1))" > "$next_archive/generation" ||
        die "the archive generation could not be written"
    sync
    rm -rf "$RECOVERY_MNT/rach2-config" "$RECOVERY_MNT/rach2-config.new" \
        "$RECOVERY_MNT/rach2-config.old" ||
        die "the legacy archives could not be removed"
}

# check_key_names DIR: prints the two names and exits 1 when two names in DIR,
# or in a directory below it, differ only in ASCII case: FAT32 folds case, so
# on the recovery partition one would replace the other without a word. It
# runs in a subshell, so its `die` ends only the subshell.
check_key_names() (
    for entry in "$1"/* "$1"/.[!.]* "$1"/..?*; do
        [ -e "$entry" ] || [ -L "$entry" ] || continue
        folded=$(printf '%s' "${entry##*/}" | LC_ALL=C tr '[:upper:]' '[:lower:]')
        for other in "$1"/* "$1"/.[!.]* "$1"/..?*; do
            [ -e "$other" ] || [ -L "$other" ] || continue
            [ "$entry" != "$other" ] || continue
            other_folded=$(printf '%s' "${other##*/}" | LC_ALL=C tr '[:upper:]' '[:lower:]')
            [ "$folded" != "$other_folded" ] ||
                die "ssh key names collide on FAT32: $entry and $other"
        done
        if [ -d "$entry" ] && [ ! -L "$entry" ]; then
            check_key_names "$entry" || exit 1
        fi
    done
)

# archive_account_keys ROOTDIR [check]: copies the .ssh directory of each
# account of ROOTDIR/etc/passwd with a numeric id and an absolute home into
# keys/UID of the slot next_archive names. The directory is named by the id,
# which has no case for FAT32 to fold, and when accounts share an id the
# first of them in passwd has it, whether or not that account has keys. With
# `check`, the key names are checked and nothing is copied. It runs in a
# subshell, and its status is 1 when a check or a copy failed.
archive_account_keys() (
    seen=" "
    while IFS=: read -r _name _password uid _gid _gecos home _shell; do
        case "$uid" in "" | *[!0-9]*) continue ;; esac
        case "$seen" in *" $uid "*) continue ;; esac
        seen="$seen$uid "
        case "$home" in /*) ;; *) continue ;; esac
        [ -d "$1$home/.ssh" ] || continue
        check_key_names "$1$home/.ssh" || exit 1
        [ "${2:-}" != check ] || continue
        destination="$next_archive/keys/$uid"
        { mkdir -p "$destination" && cp -R "$1$home/.ssh/." "$destination/"; } ||
            die "$home/.ssh could not be archived"
    done < "$1/etc/passwd"
)

# add_lines FILE TEXT: TEXT's lines appended to FILE, after a newline when
# FILE's last line has none.
add_lines() {
    [ -n "$2" ] || return 0
    if [ -s "$1" ] && [ -n "$(tail -c 1 "$1")" ]; then
        printf '\n' >> "$1" || return 1
    fi
    printf '%s\n' "$2" >> "$1"
}

# keep_image_accounts IMAGE DEST: adds the image's system accounts to the
# account files under DEST. The files an install writes and an update keeps
# were made for a root that may not have had these accounts, and a program of
# the image, such as the GNU root's OpenSSH with its `sshd`, does not start
# without its own.
#
# An account of IMAGE/etc/passwd with an id below 1000 is appended to
# DEST/etc/passwd when DEST has neither its name nor its id. A group of
# IMAGE/etc/group with an id below 1000 is appended to DEST/etc/group when
# DEST has neither its name nor its id, whether or not an account comes with
# it, as the GNU root's `crontab` comes alone; but the primary group of an
# image account whose name or id DEST gives another account stays out. An
# image shadow line is appended to DEST/etc/shadow for each account, of an id
# below 1000 or `nobody` with its id of 65534 as on Linux, that DEST has by
# the image's name and id and has no shadow line for: one appended here, or
# one an older image gave without a line. An id is compared as a number, and
# a name or an id the image has twice is taken once. Status 0 with nothing
# done when IMAGE has no etc/passwd, and 1 when a file could not be read or
# written.
keep_image_accounts() {
    [ -f "$1/etc/passwd" ] || return 0
    added=$(awk -F: 'FILENAME == ARGV[1] { name[$1] = 1; id[$3 + 0] = 1; next }
        $3 + 0 < 1000 && !($1 in name) && !(($3 + 0) in id) {
            print; name[$1] = 1; id[$3 + 0] = 1
        }' "$2/etc/passwd" "$1/etc/passwd") || return 1
    groups=
    if [ -f "$1/etc/group" ]; then
        groups=$(awk -F: 'FILENAME == ARGV[1] { name[$1] = 1; id[$3 + 0] = 1; next }
            FILENAME == ARGV[2] { uid[$1] = $3 + 0; used[$3 + 0] = 1; next }
            FILENAME == ARGV[3] {
                if ($3 + 0 < 1000 && (($1 in uid) || (($3 + 0) in used)) &&
                    !(($1 in uid) && uid[$1] == $3 + 0))
                    refused[$4 + 0] = 1
                next
            }
            $3 + 0 < 1000 && !($1 in name) && !(($3 + 0) in id) && !(($3 + 0) in refused) {
                print; name[$1] = 1; id[$3 + 0] = 1
            }' "$2/etc/group" "$2/etc/passwd" "$1/etc/passwd" "$1/etc/group") || return 1
    fi
    add_lines "$2/etc/passwd" "$added" || return 1
    add_lines "$2/etc/group" "$groups" || return 1
    [ -f "$1/etc/shadow" ] && [ -f "$2/etc/shadow" ] || return 0
    lines=$(awk -F: '
        FILENAME == ARGV[1] { if ($3 + 0 < 1000 || $3 + 0 == 65534) uid[$1] = $3 + 0; next }
        FILENAME == ARGV[2] { if (($1 in uid) && uid[$1] == $3 + 0) same[$1] = 1; next }
        FILENAME == ARGV[3] { have[$1] = 1; next }
        ($1 in same) && !($1 in have) { print; have[$1] = 1 }' \
        "$2/etc/passwd" "$1/etc/passwd" "$2/etc/shadow" "$1/etc/shadow") || return 1
    add_lines "$2/etc/shadow" "$lines"
}

# Copies the key directory SOURCE, taken from the archive, to DESTINATION with
# OWNER, mode 700 on its directories and 600 on its files, and ends the run
# when it cannot. FAT32 records neither owners nor modes, and SSH checks
# them, so they are set here, before cp -a puts the copy on the new root.
restore_key_directory() { # restore_key_directory SOURCE DESTINATION OWNER
    if ! { mkdir -p "$2" && cp -R "$1/." "$2/" &&
        chown -R "$3" "$2" &&
        find "$2" -type d -exec chmod 700 {} + &&
        find "$2" -type f -exec chmod 600 {} +; }; then
        die "$1 could not be restored with its owner and modes"
    fi
}

# Puts the archive's host keys and account keys into the copy at `keep`, for
# an update that takes the configuration from the archive. Each account of
# keep/etc/passwd with an id of 1000 or more and a home under /home is given
# that home, empty when the archive has no keys for it, since the copy's home
# tree replaces all of the image's homes after the write. An account has keys
# only when the archive has keys/UID for its id. The recovery partition must
# be mounted at RECOVERY_MNT. It runs in a subshell, and its status is 1 when
# a home or a key could not be restored.
restore_archive_keys() (
    recover_archive
    if [ -d "$archive/etc/dropbear" ]; then
        restore_key_directory "$archive/etc/dropbear" "$keep/etc/dropbear" 0:0
    fi
    if ssh_host_keys "$archive"; then
        { mkdir -p "$keep/etc/ssh" && cp "$archive"/etc/ssh/ssh_host_* "$keep/etc/ssh/" &&
            chown 0:0 "$keep"/etc/ssh/ssh_host_* && chmod 600 "$keep"/etc/ssh/ssh_host_* &&
            public_keys_readable "$keep/etc/ssh"; } ||
            die "OpenSSH's host keys could not be restored with their owner and modes"
    fi
    while IFS=: read -r _name _password uid gid _gecos home _shell; do
        case "$uid" in "" | *[!0-9]*) continue ;; esac
        case "$home" in /*) ;; *) continue ;; esac
        case "$home" in
            /home/*)
                if [ "$uid" -ge 1000 ]; then
                    mkdir -p "$keep$home" && chmod 700 "$keep$home" &&
                        chown "$uid:$gid" "$keep$home" || exit 1
                fi
                ;;
        esac
        [ -d "$archive/keys/$uid" ] || continue
        mkdir -p "$keep$home" && chmod 700 "$keep$home" &&
            chown "$uid:$gid" "$keep$home" || exit 1
        restore_key_directory "$archive/keys/$uid" "$keep$home/.ssh" "$uid:$gid"
    done < "$keep/etc/passwd"
)

# ---- an MBR disk's conversion ----
#
# A disk installed with an MBR is converted by an update to boot by UEFI as
# well, when GRUB's EFI image, `bootx64.efi`, is beside the image, where the
# install stick carries it. The disk keeps its MBR; its boot partition becomes
# the EFI system partition, type 0xEF, which UEFI firmware boots from on an MBR
# disk, and the image goes into it as \EFI\BOOT\BOOTX64.EFI beside the
# kernels, where the image's prefix opens the menu the BIOS core opens.
#
# UEFI firmware reads a FAT32 volume only with 65525 clusters or more, and a
# 64 MiB boot partition made at eight sectors to a cluster has 16348. A boot
# partition with fewer clusters has its file system made again at one sector
# to a cluster, with every file it held put back and its serial kept, since the
# menu finds the kernels' partition by that serial; the files are kept on the
# recovery partition meanwhile, where an update run again after a stop finds
# them. A boot partition of less than 33 MiB holds no FAT32 volume of that
# many clusters, and its disk is left to boot by BIOS alone, as one is when
# the image is not there or the recovery partition cannot keep the files.

# Prints the clusters of the FAT volume on NODE, as a FAT driver counts them
# from the boot sector: the data sectors after the reserved ones and the FATs,
# by the sectors of a cluster. A boot sector with no sectors to a cluster
# prints 0.
fat_clusters() { # fat_clusters NODE
    dd if="$1" bs=512 count=1 2>/dev/null | od -An -tu1 -v | awk '
        { for (i = 1; i <= NF; i++) b[n++] = $i }
        END {
            total = b[19] + 256 * b[20]
            if (total == 0) total = b[32] + 256 * (b[33] + 256 * (b[34] + 256 * b[35]))
            fat = b[22] + 256 * b[23]
            if (fat == 0) fat = b[36] + 256 * (b[37] + 256 * (b[38] + 256 * b[39]))
            if (b[13] == 0) { print 0; exit }
            print int((total - (b[14] + 256 * b[15]) - b[16] * fat) / b[13])
        }'
}

# Copies the volume serial, the four bytes at offset 67 of the boot sector
# saved in the file SAVED, into the boot sector of the FAT32 volume on NODE
# and into its backup, at the sector that bytes 50 and 51 of NODE's boot
# sector name. SCRATCH is a file for the sector being changed. Status 1 when
# a read or a write fails.
keep_serial() { # keep_serial SAVED NODE SCRATCH
    serial_backup=$(dd if="$2" bs=512 count=1 2>/dev/null | od -An -tu1 -j 50 -N 2 |
        awk '{ print $1 + 256 * $2 }')
    for serial_at in 0 $serial_backup; do
        dd if="$2" of="$3" bs=512 skip="$serial_at" count=1 2>/dev/null &&
            dd if="$1" of="$3" bs=1 skip=67 seek=67 count=4 conv=notrunc 2>/dev/null &&
            dd if="$3" of="$2" bs=512 seek="$serial_at" count=1 conv=notrunc 2>/dev/null ||
            return 1
    done
}

# Make the file system of the boot partition BOOT again, one UEFI firmware
# reads, with what it held put back. Its first sector and its files are kept
# on the recovery partition first, mounted at $RECOVERY_MNT, and marked whole
# by the file `complete`, written last. A stop part way leaves a boot
# partition the BIOS core reads no menu from, and it starts the recovery
# system from partition 2 by its label instead; the update run again there
# finds the files and finishes the job (`resume_boot_partition`). Returns 1,
# with nothing written to BOOT, when the files could not be kept on the
# recovery partition, which is mostly for want of room; any other failure
# ends the run.
remake_boot_partition() { # remake_boot_partition BOOT
    boot_keep="$RECOVERY_MNT/rach2-boot-keep"
    rm -rf "$boot_keep" || die "an old copy of $1's files could not be removed; nothing was written"
    mkdir -p "$BOOT_MNT" 2>/dev/null
    mount -t vfat -o ro "$1" "$BOOT_MNT" || die "$1 would not mount; nothing was written"
    mounted_boot=$BOOT_MNT
    if ! { mkdir -p "$boot_keep/files" &&
        dd if="$1" of="$boot_keep/sector" bs=512 count=1 2>/dev/null &&
        cp -R "$BOOT_MNT/." "$boot_keep/files/" && sync &&
        echo whole > "$boot_keep/complete" && sync; }; then
        rm -rf "$boot_keep"
        umount "$BOOT_MNT" || die "$1 would not unmount; nothing was written"
        mounted_boot=""
        return 1
    fi
    umount "$BOOT_MNT" || die "$1 would not unmount; nothing was written"
    mounted_boot=""
    rebuild_boot_partition "$1" "$boot_keep"
}

# Make the file system of BOOT again from the first sector and the files kept
# in KEEP, and drop KEEP once `bootctl` reads what was made. A failure ends
# the run and leaves KEEP for the update run again.
rebuild_boot_partition() { # rebuild_boot_partition BOOT KEEP
    boot_kept="its files are kept on the recovery partition, and this update run again \
from the recovery system puts them back"
    say "making $1's file system again, at one sector to a cluster, for UEFI firmware"
    mkfs.vfat -n RACH2BOOT "$1" > /dev/null || die "$1's file system was not made; $boot_kept"
    keep_serial "$2/sector" "$1" "$2/new" || die "$1's serial was not kept; $boot_kept"
    [ "$(fat_clusters "$1")" -ge 65525 ] ||
        die "$1's new file system has fewer clusters than UEFI firmware reads; $boot_kept"
    mkdir -p "$BOOT_MNT" 2>/dev/null
    mount -t vfat "$1" "$BOOT_MNT" || die "$1's new file system would not mount; $boot_kept"
    mounted_boot=$BOOT_MNT
    cp -R "$2/files/." "$BOOT_MNT/" || die "$1's files were not put back; $boot_kept"
    sync
    umount "$BOOT_MNT" || die "$1 would not unmount; $boot_kept"
    mounted_boot=""
    bootctl --target "$1" status > /dev/null ||
        die "$1, made again, is not a boot partition bootctl reads; $boot_kept"
    { rm -f "$2/complete" && sync && rm -rf "$2"; } ||
        say "the copy of $1's files on the recovery partition could not be removed"
}

# Finish the remake of BOOT that a stop cut short: its files are on the
# recovery partition of the disk being updated, marked whole, and BOOT holds
# no file system, an empty one or a part of its files. A copy not marked
# whole was cut short before BOOT was touched, and the next remake removes it.
# `target` names the disk; a disk with no recovery partition has nothing to
# finish.
resume_boot_partition() { # resume_boot_partition BOOT
    find_recovery "$target" || return 0
    mounted_recovery=$RECOVERY_MNT
    if [ -f "$RECOVERY_MNT/rach2-boot-keep/complete" ]; then
        say "the conversion of $1 was stopped part way; its files are on the recovery partition"
        rebuild_boot_partition "$1" "$RECOVERY_MNT/rach2-boot-keep"
    fi
    umount "$RECOVERY_MNT" || die "the recovery partition would not unmount"
    mounted_recovery=""
}

# Convert the MBR disk being updated, $update_disk, to boot by UEFI as well,
# with the bootx64.efi beside $update_image; a bootx64.efi.sha256 beside that
# must agree with it. A disk that cannot be converted is left to boot by BIOS
# alone, with a note, and the update goes on; an EFI image that fails its
# checks, or a failure while the boot partition is changed, ends the run.
#
# A new loader is written beside the old one and takes its name only once it
# is whole on the disk, so that a stop part way leaves the old one; UEFI
# firmware knows the loader by that one name, and the rename's few writes are
# the only time the disk has none. The same loader is left as it is.
convert_mbr_disk() {
    efi_image="$(dirname "$update_image")/bootx64.efi"
    boot="${update_disk}p1"
    if [ ! -f "$efi_image" ]; then
        say "there is no bootx64.efi beside $update_image, so $update_disk boots by BIOS alone"
        return 0
    fi
    if [ -f "$efi_image.sha256" ]; then
        efi_sum=$(sha256sum "$efi_image" | cut -d' ' -f1)
        [ "$efi_sum" = "$(cut -d' ' -f1 < "$efi_image.sha256")" ] ||
            die "$efi_image hashes to $efi_sum and $efi_image.sha256 says otherwise; nothing was written"
    fi
    [ "$(dd if="$efi_image" bs=2 count=1 2>/dev/null)" = MZ ] ||
        die "$efi_image is not an EFI program; nothing was written"
    if [ "$(fat_clusters "$boot")" -lt 65525 ]; then
        boot_sectors=$(grep "^part $target 1 " /proc/disk | cut -d' ' -f5)
        if [ "${boot_sectors:-0}" -lt 67584 ]; then
            say "$boot is smaller than the 33 MiB of a FAT32 volume UEFI firmware reads, so \
$update_disk boots by BIOS alone"
            return 0
        fi
        if ! find_recovery "$target"; then
            say "$update_disk has no recovery partition to keep $boot's files on while its file \
system is made again, so it boots by BIOS alone"
            return 0
        fi
        mounted_recovery=$RECOVERY_MNT
        if ! remake_boot_partition "$boot"; then
            umount "$RECOVERY_MNT" || die "the recovery partition would not unmount"
            mounted_recovery=""
            say "the recovery partition has no room for $boot's files, so $update_disk boots by BIOS alone"
            return 0
        fi
        umount "$RECOVERY_MNT" || die "the recovery partition would not unmount"
        mounted_recovery=""
    fi
    mkdir -p "$BOOT_MNT" 2>/dev/null
    mount -t vfat "$boot" "$BOOT_MNT" || die "$boot would not mount; the root is not written"
    mounted_boot=$BOOT_MNT
    efi_dir="$BOOT_MNT/EFI/BOOT"
    if cmp -s "$efi_image" "$efi_dir/BOOTX64.EFI"; then
        say "GRUB's EFI image on $boot is already this one"
    else
        { mkdir -p "$efi_dir" && rm -f "$efi_dir/BOOTX64.NEW" &&
            cp "$efi_image" "$efi_dir/BOOTX64.NEW" && sync &&
            mv -f "$efi_dir/BOOTX64.NEW" "$efi_dir/BOOTX64.EFI" && sync; } ||
            die "GRUB's EFI image was not put on $boot; the root is not written"
    fi
    umount "$BOOT_MNT" || die "$boot would not unmount; the root is not written"
    mounted_boot=""
    diskctl esp "$update_disk" > /dev/null ||
        die "$boot was not given the EFI system partition's type; the root is not written"
    say "converted: $update_disk keeps its MBR and boots by UEFI as well, from $boot"
}

# ---- the update ----
#
# A machine that is already installed, given a new root file system. The
# account files, the SSH policy, the server's host keys and the keys the
# accounts log in with are copied off the root first. The image goes into the
# root's own partition, and no partition moves. Besides the root, the update
# writes the boot partition's environment block, the root's entry, which
# growroot grows, and the archive on the recovery partition. The conversion
# of an MBR disk for UEFI also writes the boot partition's type, its loader
# and, when it has too few clusters, its file system.

if [ -n "$update_image" ]; then
    [ -f "$update_image" ] || die "$update_image is not a file"
    # A whole disk and not a partition of one: the offsets below are the
    # table's, so a partition node here would write the root's bytes at the
    # root's own offset inside the root.
    case "$update_disk" in
        /dev/disk[0-9] | /dev/disk[0-9][0-9]) ;;
        *) die "$update_disk is not a whole disk of this machine" ;;
    esac
    [ -e "$update_disk" ] || die "$update_disk is not there"
    target=${update_disk#/dev/disk}
    resume_boot_partition "${update_disk}p1"

    # The disk must be one this system installed, and not another system's that
    # happens to have an ext2 partition with an `/etc/passwd` in it: the write
    # below replaces a whole partition, and a disk that was never installed
    # from here has no partition this may claim. Two things say so together:
    # the boot partition is one `bootctl` can read, which is this system's own
    # menu and slots, and the root carries `/etc/rach2`, which no other system
    # writes.
    bootctl --target "${update_disk}p1" status > /dev/null 2>&1 ||
        die "${update_disk}p1 is not a boot partition this system wrote; \
$update_disk was not installed from here"

    # The copy of what the old root keeps, the home directories among it, goes
    # in /dev/shm, the tmpfs of half the machine's memory, where there is one,
    # and not in the recovery system's root, which the build leaves half a
    # mebibyte free at the least. Its file `root-written`, `DISK ENTRY`, says
    # that an update of this boot began to write that root and did not finish:
    # the copy is then the only one of the old root's homes, and is used again.
    keep=/tmp/rach2-update-keep
    [ -d /dev/shm ] && keep=/dev/shm/rach2-update-keep
    kept_entry=""
    if [ -f "$keep/root-written" ]; then
        read -r kept_disk kept_entry < "$keep/root-written" || kept_entry=""
        case "$kept_entry" in [1-4]) ;; *) die "$keep/root-written is not a disk and an entry" ;; esac
        [ "$kept_disk" = "$update_disk" ] ||
            die "an update of $kept_disk stopped after it wrote the root, and $keep holds the \
only copy of its homes; update $kept_disk again before $update_disk"
    fi

    root_entry=""
    if [ -n "$kept_entry" ]; then
        root_entry=$kept_entry
        say "an update of this boot stopped after it wrote the root; taking the configuration it kept in $keep"
    else
        for p in 4 3 2 1; do
            [ -e "${update_disk}p${p}" ] || continue
            mkdir -p "$TARGET_MNT" 2>/dev/null
            mount -t ext2 "${update_disk}p${p}" "$TARGET_MNT" 2>/dev/null || continue
            mounted_root=$TARGET_MNT
            if [ -f "$TARGET_MNT/etc/passwd" ] && [ -d "$TARGET_MNT/etc/rach2" ]; then
                root_entry=$p
                break
            fi
            umount "$TARGET_MNT" || die "${update_disk}p${p} would not unmount"
            mounted_root=""
        done
        rm -rf "$keep" || die "an old copy of the configuration could not be removed"
        { mkdir -p "$keep" && chmod 700 "$keep"; } || die "there is nowhere to keep the machine's configuration"
    fi
    find_recovery "$target"
    recovery_entry=$recovery_found
    [ -n "$recovery_entry" ] && mounted_recovery=$RECOVERY_MNT
    [ -z "$recovery_entry" ] || recover_archive
    from_archive=""
    if [ -n "$kept_entry" ]; then
        :
    elif [ -n "$recovery_entry" ] && [ -n "$archive" ] && [ -f "$archive/update-in-progress" ]; then
        # An update stopped after it wrote the root and before it wrote the
        # accounts back: the root reads, and what it holds is the image's.
        # The archive was written before that root, from the machine's own.
        from_archive="an update was stopped part way, and the root holds the image's accounts"
    elif [ -z "$root_entry" ]; then
        from_archive="the root does not read"
    fi
    if [ -n "$from_archive" ]; then
        # The archive is the configuration; when no mount found the root,
        # the table says which entry is the root's.
        { [ -n "$recovery_entry" ] && [ -n "$archive" ] && archive_complete; } ||
            die "$update_disk carries no root of this system whose accounts can be taken and no \
whole configuration archived on its recovery partition; its accounts are not there to be kept"
        if [ -z "$root_entry" ]; then
            # A GUID table's entries have no type in /proc/disk, and a disk
            # this system installs keeps its root in entry 3.
            if [ "$(disk_field "$target" 6)" = gpt ]; then
                root_entry=$(grep "^part $target 3 " /proc/disk | cut -d' ' -f3)
            else
                root_entry=$(grep "^part $target " /proc/disk | awk '$6 == "mbr:83" { print $3 }' | tail -1)
            fi
            [ -n "$root_entry" ] || die "$update_disk has no ext2 partition in its table"
        fi
        say "$from_archive; taking the configuration saved on the recovery partition"
        for f in $CONFIG_FILES; do
            if [ -f "$archive/$f" ]; then
                mkdir -p "$keep/$(dirname "$f")"
                cp "$archive/$f" "$keep/$f" || die "$f could not be taken from the archive"
            fi
        done
        restore_archive_keys || die "the archived keys and homes could not be restored"
    elif [ -z "$kept_entry" ]; then
        say "copying this machine's accounts, policy and keys off the root"
        for f in $CONFIG_FILES; do
            if [ -f "$TARGET_MNT/$f" ]; then
                mkdir -p "$keep/$(dirname "$f")"
                cp "$TARGET_MNT/$f" "$keep/$f" || die "$f could not be kept"
            fi
        done
        # The archive is a copy of the root's own files; a difference is
        # reported and the root's copy is what the machine keeps.
        if [ -n "$recovery_entry" ] && [ -n "$archive" ]; then
            for f in $CONFIG_FILES; do
                if [ -f "$keep/$f" ] && [ -f "$archive/$f" ]; then
                    cmp -s "$keep/$f" "$archive/$f" ||
                        say "the archive on the recovery partition differs from the root's $f; the root's is kept"
                elif [ -f "$keep/$f" ] || [ -f "$archive/$f" ]; then
                    say "the archive on the recovery partition differs from the root's $f; the root's is kept"
                fi
            done
        elif [ -n "$recovery_entry" ]; then
            say "the recovery partition has no archive of the configuration; one is written before the update"
        fi
    fi
    chmod 600 "$keep/etc/shadow" 2>/dev/null || true
    # Every copy is checked, because what is not kept here is replaced below by
    # the image's own: a copy that failed and said nothing would take the
    # machine's home directories, or its host keys, away in the name of
    # updating it. `-a` keeps the owner and the mode, which `cp` run by root
    # does not do on its own: an account's home restored as root's is a home
    # its owner cannot enter.
    if [ -n "$from_archive" ] && [ -n "$mounted_root" ]; then
        # A root that holds the image's accounts holds the image's homes and
        # keys too: nothing of it is kept.
        umount "$TARGET_MNT" || die "${update_disk}p${root_entry} would not unmount"
        mounted_root=""
    fi
    if [ -d "$TARGET_MNT/etc/dropbear" ] && [ -n "$mounted_root" ]; then
        cp -a "$TARGET_MNT/etc/dropbear" "$keep/etc/dropbear" ||
            die "the server's host keys could not be kept"
    fi
    if [ -n "$mounted_root" ] && ssh_host_keys "$TARGET_MNT"; then
        { mkdir -p "$keep/etc/ssh" && cp -a "$TARGET_MNT"/etc/ssh/ssh_host_* "$keep/etc/ssh/"; } ||
            die "OpenSSH's host keys could not be kept"
    fi
    if [ -d "$TARGET_MNT/home" ] && [ -n "$mounted_root" ]; then
        cp -a "$TARGET_MNT/home" "$keep/home" || die "the home directories could not be kept"
    fi
    if [ -n "$mounted_root" ]; then
        while IFS=: read -r _name _password _uid _gid _gecos home _shell; do
            case "$home" in /home | /home/*) continue ;; /*) ;; *) continue ;; esac
            [ -d "$TARGET_MNT$home/.ssh" ] || continue
            { mkdir -p "$keep$home" && cp -a "$TARGET_MNT$home/.ssh" "$keep$home/"; } ||
                die "$home/.ssh could not be kept"
        done < "$keep/etc/passwd"
    fi
    if [ -n "$mounted_root" ]; then
        umount "$TARGET_MNT" || die "the root would not unmount"
        mounted_root=""
    fi

    # The archive is written now, from what is kept, and marked as an
    # update in progress: a stop between the root's write and the accounts'
    # return then leaves the machine's own configuration on the recovery
    # partition for the retry, and not the image's on the root. Nothing of
    # the disk may be mounted while its root is written, since the raw writer
    # refuses a disk with a mount on it; the archive is mounted again for its
    # refresh once the new root has been written and unmounted. The marked
    # archive goes into slot B, written a second time when the first went
    # into A, so that the unmarked refresh goes into A and a finished update
    # leaves A current.
    if [ -n "$mounted_recovery" ]; then
        update_mark="$(basename "$update_image") $(stat -c %s "$update_image")"
        write_archive "$keep" "$update_mark"
        if [ "$next_archive" = "$RECOVERY_MNT/rach2-config-a" ]; then
            write_archive "$keep" "$update_mark"
        fi
        umount "$RECOVERY_MNT" || die "the recovery partition would not unmount"
        mounted_recovery=""
        say "the configuration is archived on ${update_disk}p${recovery_entry} before the root is written"
    fi

    # Where the root partition is, from the table the machine has now: an
    # update writes that range and nothing else.
    start=$(grep "^part $target $root_entry " /proc/disk | head -1 | cut -d' ' -f4)
    count=$(grep "^part $target $root_entry " /proc/disk | head -1 | cut -d' ' -f5)
    [ -n "$start" ] && [ -n "$count" ] || die "the root partition's place could not be read"
    bytes=$(stat -c %s "$update_image")
    at=$((start * 512))
    room=$((count * 512))
    [ "$bytes" -le "$room" ] ||
        die "the image is $bytes bytes and the root partition holds $room"
    [ $((bytes % 512)) -eq 0 ] ||
        die "the image is $bytes bytes, which is not a whole number of sectors"

    # The image is judged before the root it replaces is destroyed. Its hash is
    # taken here, so the readback below compares the disk with what was read
    # rather than with itself; and the first bytes of an ext2 file system are
    # read, since an image that is not one would leave a machine with no root
    # at all and nothing to say why.
    want=$(dd if="$update_image" bs=1048576 2>/dev/null | sha256sum | cut -d' ' -f1)
    [ -n "$want" ] || die "the image could not be read"
    if [ -f "$update_image.sha256" ]; then
        declared=$(cut -d' ' -f1 < "$update_image.sha256")
        [ "$want" = "$declared" ] ||
            die "the image hashes to $want and $update_image.sha256 says $declared"
    fi
    magic=$(dd if="$update_image" bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' \n')
    [ "$magic" = "53ef" ] ||
        die "$update_image does not begin with an ext2 file system"

    # The machine is put where it can come back from before its root is
    # replaced, and that is the recovery system, not the fallback entry: both
    # kernel entries boot this root, so a write cut off by a power cut would
    # leave the machine with two ways to start a half-written root and no
    # third way at all. Recovery runs from RAM and needs no root, so it comes
    # up whatever state this write leaves behind.
    #
    # A trial arms one boot and leaves the saved default alone, so this must be
    # the saved default and not a trial: a machine that lost power during the
    # write has already spent its one boot.
    bootctl --target "${update_disk}p1" env saved_entry recovery > /dev/null ||
        die "the saved boot entry could not be moved to recovery; nothing was written"
    # Any trial already armed would consume itself on the next boot and take the
    # machine off recovery in the middle of this, so this has to succeed before
    # a byte is written. `cancel` on a machine with nothing armed succeeds, so
    # a failure here means the environment block could not be read or
    # rewritten, and the write does not start.
    bootctl --target "${update_disk}p1" cancel > /dev/null ||
        die "an armed trial could not be cancelled, so recovery would not hold; nothing was written"
    say "the machine is saved to its recovery system until the new root is tried"

    if [ "$(disk_field "$target" 6)" = mbr ]; then
        convert_mbr_disk
    fi

    echo "$update_disk $root_entry" > "$keep/root-written" ||
        die "the copy of the configuration could not be marked; the root was not written"
    say "writing $bytes bytes into ${update_disk}p${root_entry}, at $at"
    reflash -p "$update_disk" "$at" "$bytes" < "$update_image" ||
        die "the root was not written"
    back=$(reflash --verify "$update_disk" "$at" "$bytes" | cut -d' ' -f3)
    [ "$back" = "$want" ] || die "what reached the root hashes to $back and the image to $want"
    say "what reached the root is the image"

    spec=$(disk_identity "$target") || die "the disk's identity could not be read"
    growroot "$spec,$root_entry" || die "the root was not grown into its partition"

    mount -t ext2 "${update_disk}p${root_entry}" "$TARGET_MNT" ||
        die "the new root would not mount"
    mounted_root=$TARGET_MNT
    say "writing the accounts, the policy and the keys back"
    keep_image_accounts "$TARGET_MNT" "$keep" ||
        die "the image's system accounts could not be kept beside the machine's"
    for f in etc/passwd etc/group etc/shadow etc/rach2/sshd.conf; do
        if [ -f "$keep/$f" ]; then
            mkdir -p "$TARGET_MNT/$(dirname "$f")"
            cp "$keep/$f" "$TARGET_MNT/$f" || die "$f could not be put back"
        fi
    done
    chmod 600 "$TARGET_MNT/etc/shadow" || die "the shadow file's mode could not be set"
    if [ -d "$keep/etc/dropbear" ]; then
        rm -rf "$TARGET_MNT/etc/dropbear" || die "the image's host keys could not be removed"
        cp -a "$keep/etc/dropbear" "$TARGET_MNT/etc/dropbear" ||
            die "the server's host keys could not be put back"
    fi
    if ssh_host_keys "$keep"; then
        { rm -f "$TARGET_MNT"/etc/ssh/ssh_host_* && mkdir -p "$TARGET_MNT/etc/ssh" &&
            cp -a "$keep"/etc/ssh/ssh_host_* "$TARGET_MNT/etc/ssh/"; } ||
            die "OpenSSH's host keys could not be put back"
    fi
    # The image's home directories go, with the keys they carry, whether or
    # not the machine's were kept: an account that has the image's name must
    # not regain the image's key. Where the machine's homes were not kept,
    # each account of the archive gets a home with its archived keys.
    rm -rf "${TARGET_MNT:?}/home" || die "the image's home directories could not be removed"
    if [ -d "$keep/home" ]; then
        cp -a "$keep/home" "$TARGET_MNT/home" || die "the home directories could not be put back"
    else
        mkdir -p "$TARGET_MNT/home" || die "the home directory could not be made"
        awk -F: '$3 >= 1000 && $6 ~ /^\/home\// { print $3, $4, $6 }' "$TARGET_MNT/etc/passwd" |
        while read -r uid gid home; do
            { mkdir -p "$TARGET_MNT$home" && chmod 700 "$TARGET_MNT$home" &&
                chown "$uid:$gid" "$TARGET_MNT$home"; } || die "$home could not be made"
        done
    fi
    # The image's keys go from every home outside /home, kept keys or not.
    rm -rf "$TARGET_MNT/root/.ssh" || die "the image's keys for root could not be removed"
    while IFS=: read -r _name _password uid gid _gecos home _shell; do
        case "$home" in /home | /home/*) continue ;; /*) ;; *) continue ;; esac
        rm -rf "$TARGET_MNT$home/.ssh" || die "$home/.ssh could not be removed"
        [ -d "$keep$home/.ssh" ] || continue
        if [ ! -d "$TARGET_MNT$home" ]; then
            { mkdir -p "$TARGET_MNT$home" && chmod 700 "$TARGET_MNT$home" &&
                chown "$uid:$gid" "$TARGET_MNT$home"; } || die "$home could not be made"
        fi
        cp -a "$keep$home/.ssh" "$TARGET_MNT$home/.ssh" ||
            die "$home/.ssh could not be put back"
    done < "$keep/etc/passwd"
    sync
    umount "$TARGET_MNT" || die "the new root would not unmount"
    mounted_root=""
    # The archive refreshed from what was written back and its mark taken
    # off, so the next update of a root that does not read takes what this
    # one kept; an archive that was there and cannot be refreshed stops the
    # update here, with the root written and no trial armed, rather than
    # leave a stale archive that says an update is in progress.
    if [ -n "$recovery_entry" ]; then
        find_recovery "$target"
        again=$recovery_found
        [ -n "$again" ] && mounted_recovery=$RECOVERY_MNT
        [ "$again" = "$recovery_entry" ] ||
            die "the recovery partition ${update_disk}p${recovery_entry} was not found again; the \
root is written and its archive still says an update is in progress; run the update once more"
        write_archive "$keep"
        umount "$RECOVERY_MNT" || die "the recovery partition would not unmount"
        mounted_recovery=""
        say "the configuration is archived on ${update_disk}p${recovery_entry}"
    fi
    rm -rf "$keep"

    # One trial boot of the new root. The saved default is still recovery, so a
    # root that does not come up costs a reboot and the machine lands in the
    # system that can repair it; `bootctl commit` from the booted new root is
    # what finally makes it the default.
    if bootctl --target "${update_disk}p1" trial candidate; then
        say "the new root is armed for one trial boot"
    else
        die "the new root is on the disk and no trial was armed; arm one with \
bootctl --target ${update_disk}p1 trial candidate"
    fi
    say "updated: ${update_disk}p${root_entry} carries the new root with this machine's \
accounts. Reboot to try it."
    exit 0
fi

source_disk=-1
if [ -n "$source_dir" ]; then
    [ -f "$source_dir/rach2-install.manifest" ] ||
        die "$source_dir holds no rach2-install.manifest"
else
    greet
    say "looking for the image on the removable disks"
    found=$(find_source)
    case "$?" in
        0) ;;
        2) die "a volume this looked at would not unmount; nothing was written" ;;
        *) die "no stick with an image on it was found" ;;
    esac
    source_disk=${found%% *}
    source_dir=${found#* }
    mounted_source=$source_dir
fi

image=$(sed -n 's/^image //p' "$source_dir/rach2-install.manifest")
bytes=$(sed -n 's/^bytes //p' "$source_dir/rach2-install.manifest")
want=$(sed -n 's/^sha256 //p' "$source_dir/rach2-install.manifest")
[ -n "$image" ] && [ -n "$bytes" ] && [ -n "$want" ] ||
    die "the manifest does not name an image, a length and a hash"
[ -f "$source_dir/$image" ] || die "$source_dir holds no $image"

say "the image is $image, $bytes bytes"

# ---- which disks could take it ----
#
# A disk is a candidate when it is fixed, nothing is mounted from it, its
# sector is 512 bytes, it is not the stick this is running from, and it is
# large enough. The ones it could take are numbered first, since those are what
# the next question is about; the ones it passed over come after, with the
# reason for each, because a person at a machine with two disks in it needs to
# know which was left out and why.

tell "Rach2 can be written to these disks:"
candidates=""
skipped=""
disk_count=0
for n in $(disk_numbers); do
    sectors=$(disk_field "$n" 5)
    size=$((sectors * 512))
    # Everything this knows about the disk, on three lines rather than one. A
    # model of forty characters beside a serial of twenty and a size in bytes
    # would make a single line of 132 columns, which an eighty-column screen
    # folds in the middle of whichever field it reaches first.
    what="/dev/disk$n, $size bytes"
    what_model="$(disk_model "$n")"
    what_more="$(disk_field "$n" 3), $(identity_field "$n" "$FIXED_OR_NOT"), \
table $(disk_field "$n" 6), serial $(disk_serial "$n")"
    if [ "$n" = "$source_disk" ]; then
        skipped="$skipped\n  /dev/disk$n is the stick this is running from"
        continue
    fi
    if [ "$(identity_field "$n" "$FIXED_OR_NOT")" = "removable" ]; then
        # A disk that can be pulled out is not one this system boots from:
        # the firmware and the kernel both take their root from a fixed one.
        skipped="$skipped\n  /dev/disk$n can be pulled out, and this system does not boot from one"
        continue
    fi
    if [ "$(identity_field "$n" "$MOUNT_STATE")" = "mounted" ]; then
        skipped="$skipped\n  /dev/disk$n has something mounted from it"
        continue
    fi
    if [ "$(identity_field "$n" "$SECTOR_SIZE")" != "512" ]; then
        skipped="$skipped\n  /dev/disk$n counts in $(identity_field "$n" "$SECTOR_SIZE")-byte sectors, not 512"
        continue
    fi
    if [ "$size" -lt "$bytes" ]; then
        skipped="$skipped\n  /dev/disk$n holds $size bytes and the image is $bytes"
        continue
    fi
    disk_count=$((disk_count + 1))
    echo "  $disk_count) $what"
    echo "     $what_model"
    echo "     $what_more"
    candidates="$candidates $n"
done
if [ -n "$skipped" ]; then
    tell "These disks were passed over:"
    printf '%b\n' "$skipped" | sed '/^$/d'
fi
[ -n "$candidates" ] && [ "$candidates" != " " ] ||
    die "no disk of this machine can take the image"

# ---- the questions ----
#
# All of them are asked before anything is written, and the last of them is the
# confirmation, so a person who changes their mind has not left a disk half
# written.

# Ends the run when the answers end before the last question. Nothing is
# written yet, and a question asked again would only meet the end again. A
# caller calls it only when its read took nothing, since a last line with no
# newline is still an answer.
no_answer() {
    die "the answers ended before the questions did; nothing was written"
}

# Asks for a password twice, with the terminal's echo off, until the two are
# the same and not empty, and leaves it in `password`. `stty` is put back
# however this ends, since a shell left with no echo is a shell nobody can use.
ask_password() { # ask_password PROMPT
    while :; do
        echo_off=yes
        stty -echo 2>/dev/null
        printf '%s: ' "$1"
        read -r pw1 || [ -n "$pw1" ] || no_answer
        printf '\n%s again: ' "$1"
        read -r pw2 || [ -n "$pw2" ] || no_answer
        stty echo 2>/dev/null
        echo_off=""
        printf '\n'
        if [ -z "$pw1" ]; then
            tell "An empty password will not do. Type one."
            continue
        fi
        if [ "$pw1" != "$pw2" ]; then
            tell "Those two were different. Type it again."
            continue
        fi
        password=$pw1
        return 0
    done
}

# The name rules are the ones every account file here is read under: a letter
# first, then letters, digits, hyphen and underscore, at most 32 characters,
# and not root, whose account this writes itself. Status 0 when NAME follows
# them.
check_name() { # check_name NAME
    case "$1" in
        "" | *[!a-z0-9_-]* | [!a-z]*)
            return 1
            ;;
    esac
    [ "${#1}" -le 32 ] || return 1
    [ "$1" != "root" ] || return 1
    return 0
}

# Prints why a name was refused, in one clause, naming the rule it broke rather
# than reciting all of them: a person who typed `ROOT` is helped by being told
# that names are lowercase and not by the whole sentence about letters and
# digits.
name_fault() { # name_fault NAME
    case "$1" in
        "") echo "a name cannot be empty" ;;
        *[A-Z]*) echo "names are lowercase" ;;
        [!a-z]*) echo "a name starts with a letter" ;;
        *[!a-z0-9_-]*) echo "a name takes letters, digits, - and _ only" ;;
        *)
            if [ "$1" = "root" ]; then
                echo "root is made by this install already"
            elif [ "${#1}" -gt 32 ]; then
                echo "a name is at most 32 characters and that is ${#1}"
            else
                echo "that is not a name this system takes"
            fi
            ;;
    esac
}

target=""
while :; do
    printf 'Which disk shall Rach2 be written to? A number above, or its name: '
    read -r answer || [ -n "$answer" ] || no_answer
    i=0
    for n in $candidates; do
        i=$((i + 1))
        if [ "$answer" = "/dev/disk$n" ] || [ "$answer" = "$i" ]; then
            target=$n
        fi
    done
    [ -n "$target" ] && break
    if [ -z "$answer" ]; then
        tell "Nothing was typed. Answer 1 to $disk_count, or the disk's name."
    else
        tell "$answer is not in the list. Answer 1 to $disk_count, or the disk's name."
    fi
done

ask_password "the password for root"
root_password=$password
while :; do
    printf 'The name of the first account: '
    read -r user_name || [ -n "$user_name" ] || no_answer
    check_name "$user_name" && break
    tell "$(name_fault "$user_name"). Try another."
done
ask_password "the password for $user_name"
user_password=$password
# The keys are offered, not demanded. A person at a console should not have to
# type a path from memory, and a path typed wrong should not throw away the
# answers already given: what this can find is listed and chosen by number, a
# path still works for anything it did not find, nothing means no keys, and a
# wrong answer is asked again rather than ending the run.
key_choices=""
key_count=0
for d in "$source_dir" /root /root/.ssh /tmp /; do
    [ -d "$d" ] || continue
    for f in "$d"/*.pub "$d"/authorized_keys; do
        [ -f "$f" ] || continue
        case " $key_choices " in *" $f "*) continue ;; esac
        key_count=$((key_count + 1))
        key_choices="$key_choices $f"
    done
done
if [ "$key_count" -gt 0 ]; then
    tell "These keys are on this machine:"
    i=0
    for f in $key_choices; do
        i=$((i + 1))
        tell "  $i) $f"
    done
fi
user_keys=""
while :; do
    if [ "$key_count" -gt 0 ]; then
        tell "Authorized keys for $user_name:"
        printf 'A number above, a path, or nothing: '
    else
        tell "A file of authorized keys for $user_name:"
        printf 'A path, or nothing: '
    fi
    read -r user_keys || [ -n "$user_keys" ] || no_answer
    [ -z "$user_keys" ] && break
    case "$user_keys" in
        *[!0-9]*) ;;
        *)
            if [ "$user_keys" -ge 1 ] && [ "$user_keys" -le "$key_count" ]; then
                i=0
                for f in $key_choices; do
                    i=$((i + 1))
                    [ "$i" = "$user_keys" ] && user_keys=$f && break
                done
            fi
            ;;
    esac
    [ -f "$user_keys" ] && break
    tell "$user_keys is not a file. Try again, or type nothing for no keys."
done
# The recovery system on the disk starts an SSH server only where it has a
# key, and a root update runs from recovery, so a machine that is to be
# updated over the network needs a key there. The image's recovery system has
# one only when it was built with one; this puts a file beside it on the
# recovery partition, which init reads when that partition boots. The key is
# offered as the account's keys are, and it must be one init will take: a
# private key, a file of nothing but comments and one larger than init reads
# are said and asked again. What is judged is a copy of the file, made in a
# directory of this run's own so that nothing another process put in /tmp is
# followed, with a newline added to a last line that has none; that copy is
# what is written, so the file cannot change between the two and the size
# judged is the size init reads.
#
# The function below prints why FILE will not do as that key file, or nothing
# when it will: init reads at most 16384 bytes of it, and takes no file that
# has a NUL byte, a private key, or no line that is neither blank nor a
# comment.
recovery_key_fault() { # recovery_key_fault FILE: why FILE will not do, or nothing
    if [ "$(wc -c < "$1")" -gt 16384 ]; then
        echo "is larger than 16384 bytes with its last line ended"
    elif od -An -tx1 "$1" | grep -q ' 00'; then
        echo "is not text"
    elif grep -q 'PRIVATE KEY' "$1"; then
        echo "holds a private key; give the public half, the file ending .pub"
    elif ! grep -q '^[[:space:]]*[^#[:space:]]' "$1"; then
        echo "has no line that is a key"
    fi
}
recovery_keys=""
while :; do
    tell "A key for the recovery system on this disk, so that it can be updated over"
    tell "the network. With none, it starts an SSH server only if its image has a key."
    if [ "$key_count" -gt 0 ]; then
        printf 'A number above, a path, or nothing: '
    else
        printf 'A path, or nothing: '
    fi
    read -r recovery_keys || [ -n "$recovery_keys" ] || no_answer
    [ -z "$recovery_keys" ] && break
    case "$recovery_keys" in
        *[!0-9]*) ;;
        *)
            if [ "$recovery_keys" -ge 1 ] && [ "$recovery_keys" -le "$key_count" ]; then
                i=0
                for f in $key_choices; do
                    i=$((i + 1))
                    [ "$i" = "$recovery_keys" ] && recovery_keys=$f && break
                done
            fi
            ;;
    esac
    if [ ! -f "$recovery_keys" ]; then
        tell "$recovery_keys is not a file. Try again, or type nothing for no key."
        continue
    fi
    if [ -z "$key_dir" ]; then
        key_dir=$(mktemp -d /tmp/rach2-install.XXXXXX) ||
            die "no private directory could be made for the key's copy"
    fi
    key_copy=$key_dir/key
    if ! head -c 16385 "$recovery_keys" > "$key_copy"; then
        rm -f "$key_copy"
        tell "$recovery_keys cannot be read. Try again, or type nothing for no key."
        continue
    fi
    if [ -n "$(tail -c 1 "$key_copy")" ]; then
        echo >> "$key_copy"
    fi
    fault=$(recovery_key_fault "$key_copy")
    [ -z "$fault" ] && break
    rm -f "$key_copy"
    tell "$recovery_keys $fault. Try again, or type nothing for no key."
done
printf 'Grow the root into the whole disk? [yes] '
read -r grow_answer || [ -n "$grow_answer" ] || no_answer
case "$grow_answer" in
    "" | y | yes) grow=yes ;;
    *) grow=no ;;
esac

# Everything that was answered, on one screen, before the one step that cannot
# be taken back. A person who has answered six questions in a row should not
# have to remember what they said to know what is about to happen. One fact a
# line, and no column that a long model name or serial can push past the edge:
# the screen is eighty columns, a disk identifies itself in as many characters
# as it likes, and a line that wraps in the middle of a serial number is worse
# than no line. Nothing here is shortened to fit.
tell ""
tell "Check this before you go on."
tell ""
tell "Disk to erase: /dev/disk$target"
tell "  model:  $(disk_model "$target")"
tell "  serial: $(disk_serial "$target")"
tell "  size:   $(($(disk_field "$target" 5) * 512)) bytes"
tell "  bus:    $(disk_field "$target" 3)"
tell "  now:    $(identity_field "$target" "$FIXED_OR_NOT"), partition table $(disk_field "$target" 6)"
tell "Accounts to make: root, and $user_name"
if [ -n "$user_keys" ]; then
    tell "Keys for $user_name:"
    tell "  $user_keys"
else
    tell "Keys for $user_name: none"
    tell "  Both accounts use their passwords."
fi
if [ -n "$recovery_keys" ]; then
    tell "Key for the recovery system:"
    tell "  $recovery_keys"
else
    tell "Key for the recovery system: none"
fi
if [ "$grow" = "yes" ]; then
    tell "Root partition: grown to fill the disk. This takes some minutes."
else
    tell "Root partition: left at the size the image has"
fi
tell ""
tell "Everything on /dev/disk$target is erased."
# A typo here should cost a retype and not the six answers above, so a wrong
# word asks again; stopping is a word of its own rather than anything that is
# not the disk's name.
while :; do
    printf 'Type /dev/disk%s to go on, or stop to stop: ' "$target"
    read -r confirm || [ -n "$confirm" ] || no_answer
    [ "$confirm" = "/dev/disk$target" ] && break
    case "$confirm" in
        stop | STOP | Stop | quit | q) die "nothing was written" ;;
    esac
    tell "That is not /dev/disk$target."
done

# The disk the answer was given about, by its serial and size. A disk that
# goes and comes back takes a fresh record, so the write below stops rather
# than landing on whatever took its place.
target_serial=$(disk_serial "$target")
target_sectors=$(disk_field "$target" 5)

# ---- the write ----
#
# The image is hashed here, after the last question and before the first write:
# a stick that has gone bad is found before anything is destroyed, and a run
# that ends at a question has not paid for the reading.

# The length the manifest declares is the length the file has: a manifest whose
# `bytes` was changed and whose hash was not would otherwise send `reflash` a
# count that is not the image's, and the disk is written before the stream's
# end says so.
actual=$(stat -c %s "$source_dir/$image")
[ "$actual" = "$bytes" ] ||
    die "the manifest says $bytes bytes and $image is $actual"

# A step with nothing to show is one a person reads as a machine that has
# stopped, so what it is doing and that it will be quiet are said first.
say "checking the image against the manifest: reading all $bytes bytes, which takes \
a few minutes and prints nothing until it is done"
# Cache read-ahead avoids a disk request for each small sha256sum read.
got=$(sha256sum "$source_dir/$image" | cut -d' ' -f1)
[ "$got" = "$want" ] ||
    die "the image on the stick hashes to $got and the manifest says $want"
say "the image on the stick is the one the manifest describes"

# The disk's serial and sector count are read again before the first byte and
# after the last: a disk pulled out between the question and the write takes a
# fresh record when it comes back, and that record describes another disk.
[ "$(disk_serial "$target")" = "$target_serial" ] &&
    [ "$(disk_field "$target" 5)" = "$target_sectors" ] ||
    die "/dev/disk$target is no longer the disk the question was answered about"

say "writing $bytes bytes to /dev/disk$target"
if ! reflash -p "/dev/disk$target" 0 "$bytes" < "$source_dir/$image"; then
    die "the image was not written"
fi
[ "$(disk_serial "$target")" = "$target_serial" ] &&
    [ "$(disk_field "$target" 5)" = "$target_sectors" ] ||
    die "/dev/disk$target is not the disk the question was answered about"

say "reading it back"
back=$(reflash --verify "/dev/disk$target" 0 "$bytes" | cut -d' ' -f3)
[ "$back" = "$want" ] ||
    die "what reached the disk hashes to $back and the image hashes to $want"
say "what reached the disk is the image"

# ---- the new table ----
#
# An image with a GUID table, which a protective MBR's type 0xEE in its first
# entry says it has, carries its backup where the image ends, and the disk is
# usually larger: the backup goes to the disk's last sectors, where a reader
# looks for it, and the kernel reads the table again. An MBR needs only the
# reading.

if [ "$(dd if="$source_dir/$image" bs=1 skip=450 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')" = ee ]; then
    diskctl relocate "/dev/disk$target" ||
        die "the GUID table's backup was not moved to the disk's end"
else
    diskctl reread "/dev/disk$target" || die "the new table was not read"
fi
say "the table is the one the image carries:"
grep "^part $target " /proc/disk | sed 's/^/  /'

# ---- the accounts ----
#
# The image carries the accounts it was built with, which are a demonstration's
# and not this machine's. They are replaced here, on the root the installed
# system boots: the three files are small and a fresh install knows all of
# their contents, so each is written whole to a name of its own and renamed
# into place, which is the write a stop in the middle leaves undone rather than
# half done.
#
# The root is found rather than assumed: the highest-numbered of entries 1 to
# 4 that mounts as ext2 and has an `/etc/passwd` is the root both kernel
# entries boot. The recovery system's own image keeps the credentials it was
# built with, since it is the way back into a machine whose new root will not
# come up.

# Prints the root's entry number on the disk `target` names and where it was
# mounted, and leaves it mounted. Status 1 when no entry has a root.
find_root() {
    for p in 4 3 2 1; do
        [ -e "/dev/disk${target}p${p}" ] || continue
        mkdir -p "$TARGET_MNT" 2>/dev/null
        mount -t ext2 "/dev/disk${target}p${p}" "$TARGET_MNT" 2>/dev/null || continue
        if [ -f "$TARGET_MNT/etc/passwd" ]; then
            echo "$p $TARGET_MNT"
            return 0
        fi
        umount "$TARGET_MNT" 2>/dev/null
    done
    return 1
}

found_root=$(find_root) || die "the disk carries no ext2 root to write the accounts into"
root_entry=${found_root%% *}
root_dir=${found_root#* }
mounted_root=$root_dir
say "writing the accounts into the ext2 root at $root_dir"

# Prints PASSWORD's SHA-512 crypt hash, the form /etc/shadow holds.
hash_of() { # hash_of PASSWORD
    printf '%s\n' "$1" | mkpasswd -m sha512 -P 0
}

root_hash=$(hash_of "$root_password")
user_hash=$(hash_of "$user_password")
[ -n "$root_hash" ] && [ -n "$user_hash" ] || die "the passwords could not be hashed"

# Writes CONTENT to PATH.new with MODE and renames it to PATH, so a stop
# leaves the old file or the new one whole; a failure ends the run.
put_file() { # put_file PATH MODE CONTENT
    printf '%s' "$3" > "$1.new" || die "$1 could not be written"
    chmod "$2" "$1.new" || die "$1 could not be given its mode"
    mv "$1.new" "$1" || die "$1 could not be put in place"
}

image_etc=$(mktemp -d /tmp/rach2-install.XXXXXX) || die "there is nowhere to keep the image's accounts"
mkdir -p "$image_etc/etc" || die "there is nowhere to keep the image's accounts"
for f in passwd group shadow; do
    if [ -f "$root_dir/etc/$f" ]; then
        cp "$root_dir/etc/$f" "$image_etc/etc/$f" || die "the image's /etc/$f could not be read"
    fi
done
put_file "$root_dir/etc/passwd" 644 "root:x:0:0:root:/root:/bin/sh
$user_name:x:1000:1000:$user_name:/home/$user_name:/bin/sh
"
put_file "$root_dir/etc/group" 644 "root:x:0:
$user_name:x:1000:
"
put_file "$root_dir/etc/shadow" 600 "root:$root_hash:0:0:99999:7:::
$user_name:$user_hash:0:0:99999:7:::
"
keep_image_accounts "$image_etc" "$root_dir" ||
    die "the image's system accounts could not be kept beside the new ones"
rm -rf "$image_etc"

# The account's home, and the keys if any were given. The demonstration's home
# and its keys go, whatever they were called.
rm -rf "${root_dir:?}/home" 2>/dev/null
mkdir -p "$root_dir/home/$user_name" || die "the home directory could not be made"
chmod 700 "$root_dir/home/$user_name"
chown 1000:1000 "$root_dir/home/$user_name" 2>/dev/null
rm -rf "$root_dir/root/.ssh" 2>/dev/null
if [ -n "$user_keys" ]; then
    mkdir -p "$root_dir/home/$user_name/.ssh"
    chmod 700 "$root_dir/home/$user_name/.ssh"
    cp "$user_keys" "$root_dir/home/$user_name/.ssh/authorized_keys" ||
        die "the keys could not be copied"
    chmod 600 "$root_dir/home/$user_name/.ssh/authorized_keys"
    chown 1000:1000 "$root_dir/home/$user_name/.ssh" \
        "$root_dir/home/$user_name/.ssh/authorized_keys" 2>/dev/null
    say "the keys in $user_keys are $user_name's"
fi

# Root over SSH with a password, which is this system's policy once it is
# installed: the person who installed it chose that password and may have no
# key at all. `init` reads this file and drops dropbear's `-g` for it.
mkdir -p "$root_dir/etc/rach2"
put_file "$root_dir/etc/rach2/sshd.conf" 644 "root-password-login yes
"

sync
# Accounts, policy and keys are archived for a root that no longer reads, and
# the recovery system's key goes beside its kernel. With no key given, a key
# the image carried there is removed, so a disk installed without one has none.
find_recovery "$target"
recovery_entry=$recovery_found
if [ -n "$recovery_entry" ]; then
    mounted_recovery=$RECOVERY_MNT
    write_archive "$root_dir"
    if [ -n "$recovery_keys" ]; then
        cp "$key_copy" "$RECOVERY_MNT/$RECOVERY_KEYS_FILE" ||
            die "the key for the recovery system could not be written"
    else
        rm -f "$RECOVERY_MNT/$RECOVERY_KEYS_FILE" ||
            die "the key the image carried for the recovery system could not be removed"
    fi
    sync
    umount "$RECOVERY_MNT" || die "the recovery partition would not unmount"
    mounted_recovery=""
    say "the configuration is archived on /dev/disk${target}p${recovery_entry}"
    if [ -n "$recovery_keys" ]; then
        say "the recovery system on /dev/disk${target}p${recovery_entry} takes the key in $recovery_keys"
    fi
else
    say "the disk has no recovery partition, so the configuration is not archived"
    if [ -n "$recovery_keys" ]; then
        say "and the key for the recovery system has nowhere to go, so it was not placed"
    fi
fi
umount "$root_dir" || die "the root would not unmount"
mounted_root=""

say "the accounts are root and $user_name, and root may log in over SSH with a password"

# ---- the root's size ----
#
# The image is as large as it was built and the disk is usually larger. The root
# is the last partition on the disk, so the space after it is free, and
# `growroot` puts the entry and then the file system on it: the entry first,
# then the checker, then the resizer, each of which a run stopped in the middle
# leaves for the next run to finish. It runs on a volume nothing has mounted,
# which is why it comes after the accounts and not before them.

if [ "$grow" = "yes" ]; then
    spec=$(disk_identity "$target") || die "the disk's identity could not be read"
    say "growing the root into the rest of the disk: a check, a repair pass and the \
resize, each of which takes minutes and is quiet while it runs"
    growroot "$spec,$root_entry" ||
        die "the root was not grown; the disk carries the image and boots as it is"
fi
say "installed: /dev/disk$target now carries this system. Reboot from it."
