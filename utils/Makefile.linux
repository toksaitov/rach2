# Unix Utilities Makefile (native Linux)
#
# Builds the file utilities as ordinary native programs with the host compiler
# and its libc, for running/testing on Linux. Usage: make -f Makefile.linux
#
# Only the portable file utilities are built here; the network utilities
# (ping/nc/httpd) target the Rach2 kernel's sockets and stay with the main
# musl-linked Makefile.
#
# Like the main build, this builds out of tree, into build/utils/linux/ (its own
# subdir so the native binaries never collide with the Rach2 musl binaries of the
# same name under build/utils/). See ../mk/build.mk.

COMPONENT = utils/linux
include ../mk/build.mk

CC ?= cc
CFLAGS = -O2 -Wall -Wextra

UTILITIES = true  \
            false \
            echo  \
            yes   \
            cat   \
            pwd   \
            touch \
            mkdir \
            rm    \
            mv    \
            cp    \
            ls

TARGETS = $(addprefix $(BUILD)/, $(UTILITIES))

.PHONY: all clean

all: $(TARGETS)

$(BUILD)/%: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -o $@ $<

clean:
	rm -rf $(BUILD)
