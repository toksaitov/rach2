# utils/Makefile.linux: build the file utilities as native programs with the
# host's compiler and libc, to run and test them on Linux.
#
# Usage: make -f Makefile.linux
#
# Only the portable file utilities are built here; the other programs are
# written for the Rach2 kernel and build only with the Makefile beside this one.
#
# The build is out of tree, into build/utils/linux/ (../mk/build.mk), a
# directory of its own so that the native programs never collide with the
# Rach2 programs of the same name in build/utils/.

COMPONENT = utils/linux
include ../mk/build.mk

CC ?= cc
CFLAGS = -O2 -Wall -Wextra

UTILITIES = true  \
            false \
            echo  \
            yes   \
            cat   \
            pwd   \
            touch \
            mkdir \
            rm    \
            mv    \
            cp    \
            ls

TARGETS = $(addprefix $(BUILD)/, $(UTILITIES))

.PHONY: all clean

all: $(TARGETS)

$(BUILD)/%: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -o $@ $<

clean:
	rm -rf $(BUILD)
