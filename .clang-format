# Rach2 house style: LLVM base, 4-space, Allman braces on functions but K&R on
# control statements, pointers bound right, includes left as written, 100 cols.
# Every in-house C file is formatted with it; tests/run style refuses one
# that differs, judged by the clang-format version tools/setup/judges
# records. The reformat commits are listed in tools/verify/blame-ignore-revs.
---
Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100
PointerAlignment: Right
DerivePointerAlignment: false
SortIncludes: false
IndentCaseLabels: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
AlwaysBreakAfterReturnType: None
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterControlStatement: Never
  AfterClass: false
  AfterStruct: false
  AfterUnion: false
  AfterEnum: false
  BeforeElse: false
  BeforeWhile: false
  SplitEmptyFunction: false
KeepEmptyLinesAtTheStartOfBlocks: false
SpaceAfterCStyleCast: false
AlignConsecutiveMacros: AcrossComments
AlignTrailingComments: true
AlignEscapedNewlines: Left
