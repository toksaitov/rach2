# clangd compilation database, generated from the build by `make compile-commands`
# (see tools/dev/gen_compile_commands.sh); regenerable, never committed.
compile_commands.json

# clangd's per-project index cache.
.cache/

# All build output. Every in-house component builds out of tree into one repo-root
# build/ directory whose layout mirrors the source tree (mk/build.mk): the objects, the
# GCC-written .d files, the final binaries, the kernel, the RAM-disk image and mount
# point, the ISO staging, and the staged capstones under build/vendor/. Nothing
# build-related lands in the source tree, so this one entry replaces the former
# per-component ignores.
build/

# macOS
.DS_Store

# Python bytecode cache
__pycache__/

# Scratch files at the repository root are never part of the build.
/*.txt
