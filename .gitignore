# clangd compilation database, generated from the build by
# tools/dev/gen_compile_commands.sh; regenerable, never committed.
compile_commands.json

# clangd's per-project index cache.
.cache/

# All build output. Every in-house component builds out of tree into one
# build/ directory at the repository root whose layout follows the source tree
# (mk/build.mk): the objects, the .d files, the binaries, the kernels, the
# images, the ISO staging and the vendored binaries under build/vendor/.
build/

# macOS
.DS_Store

# Scratch files at the repository root are never part of the build.
/*.txt

# Worktrees Claude Code makes for its subagents; each is a checkout of this
# repository, not part of it.
.claude/worktrees/
