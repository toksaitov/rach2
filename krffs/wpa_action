#!/bin/sh
#
# The script wpa_cli runs, as `wpa_cli -a`, when wpa_supplicant joins a
# network or leaves one: `wpa_action IFACE CONNECTED` or `wpa_action IFACE
# DISCONNECTED`. init(8) starts both programs on wlan0. wpa_cli runs it for
# other events too, with the event as the second argument; those it ignores.
# The probe's script runs it as `wpa_action IFACE PROBED PID [ADDRESS]`.
#
# A Wi-Fi interface's link is its association: the kernel reports carrier
# while the station is associated, and the network after a disconnection may
# be another, as when the machine is carried to another building. So the
# lease follows the network joined. CONNECTED starts a DHCP client on IFACE,
# which asks the network just joined for a lease at once, and records the
# network's id, wpa_cli's WPA_ID. DISCONNECTED leaves the client running for
# up to HOLD seconds: a CONNECTED to the same network keeps the client, the
# address and the connections that use it, and sends the client nothing, so
# that its lease and its timers are its own: it renews at half the lease and
# gives the address up when a server refuses it or the lease ends, and a
# server that does not answer meanwhile costs nothing. A CONNECTED to
# another network, or none within HOLD seconds, stops the client, and its
# script gives the lease up with the address, the default route and the
# servers (udhcpc-default.script). The wait ends early when wpa_supplicant
# stops trying, its state INTERFACE_DISABLED, as for a blocked radio, or
# INACTIVE, with no network enabled. This is NetworkManager's link timeout,
# which keeps a Wi-Fi connection while wpa_supplicant joins its network again
# after a short break, such as an AP that restarts, deauthenticates the
# station or is lost for a few beacons.
#
# A network of the same name may be on another subnet, as when the machine
# is carried to another building of one campus. So a CONNECTED that
# keeps the client starts a probe beside it: a second udhcpc that asks the
# network for the address in use (`-r`), once, with a short retry, and quits
# (`-n -q`), whose script, udhcpc-probe.script, configures nothing and runs
# this one with what was offered. An offer of another address restarts the
# client, as a change of network does; an offer of the same address, or a
# server that does not answer, changes nothing. The probe gives nothing
# back, having no `-R`: the lease it was offered is the client's own, both
# being asked for by the card's address. Two clients on one interface each
# get every DHCP frame from their own packet socket and drop the replies
# whose transaction is not theirs. One probe runs at most, and a CONNECTED,
# a DISCONNECTED or a stop of the client stops the one there is.
#
# wpa_cli can lose an event on a loaded machine: it reads its socket late,
# wpa_supplicant finds the socket full, drops the event and detaches it, and
# init starts another wpa_cli, which has not seen it. So a CONNECTED keeps a
# client of the same network with or without a wait pending, and the wait
# asks the state itself, and after HOLD seconds goes on asking, every LOOK
# seconds, until the station has joined or stopped trying: a state of
# COMPLETED twice over, each with the network's id in the same reply, stands
# for the CONNECTED.
#
# The card stays up throughout, since wpa_supplicant owns it, which is why
# ifplugd follows the cable alone: its action's `ifdown` would take the card
# down under wpa_supplicant. IPv6 needs nothing here: the kernel makes the
# addresses the routers advertise, and ndwatch(8), which init runs on wlan0
# as on eth0, follows their servers and starts udhcpc6 when they ask for it.
#
# wpa_cli runs this script for a move between two networks, whose ids
# differ, but not for a roam between the access points of one network, so a
# roam keeps the lease without it.
#
# The client is BusyBox's udhcpc, in the foreground of a process of its own
# (`-f`), so that wpa_cli, which waits for this script, is not held while
# the network answers. `-R` gives the lease up when the client is stopped.
# Its pid is kept in /var/run/udhcpc.IFACE.pid, the file `ifup` uses, and
# its network's id in /var/run/udhcpc.IFACE.net. The probe's pid is kept in
# /var/run/udhcpc.IFACE.probe while its answer may still act.
#
# wpa_cli runs one action at a time, but the waiting process and the probe
# run beside them, so whatever looks at the client, the wait or the probe
# and acts on it holds flock(1)'s lock on /var/run/wpa_action.IFACE.lock, on
# descriptor 9. A pending wait is the file
# /var/run/wpa_action.IFACE.hold.TOKEN, and a wait acts only while its file
# is there: a CONNECTED that comes first removes it. The file stays through
# a stop at HOLD seconds, for the wait goes on. A probe acts only while the
# probe's file names it, and only when it can take the lock at once:
# whoever holds it is changing the client or the wait, and stops the probe,
# which would otherwise wait on that holder while the holder waits for it to
# end.

PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH

HOLD=15 # seconds a disconnection may last before the lease goes
LOOK=10 # seconds between looks at the state once the lease has gone
CTRL=/var/run/wpa_supplicant
PROBE_SCRIPT=/usr/share/udhcpc/probe.script

iface=$1
pidfile=/var/run/udhcpc.$iface.pid
netfile=/var/run/udhcpc.$iface.net
probefile=/var/run/udhcpc.$iface.probe
hold=/var/run/wpa_action.$iface.hold
lock=/var/run/wpa_action.$iface.lock

# Take the lock of IFACE's client, until dhcp_unlock or this process ends.
dhcp_lock() {
	exec 9> "$lock"
	flock 9
}

# Give the lock up. A process started under it must not inherit descriptor 9.
dhcp_unlock() {
	exec 9>&-
}

# Stop the process whose pid is in the file $1, if it runs, wait up to five
# seconds for it to end, and remove the file.
stop_pid() {
	if [ -s "$1" ]; then
		pid=$(cat "$1")
		if kill "$pid" 2>/dev/null; then
			n=0
			while [ $n -lt 50 ] && kill -0 "$pid" 2>/dev/null; do
				usleep 100000
				n=$((n + 1))
			done
		fi
	fi
	rm -f "$1"
}

# Stop IFACE's probe, if one runs. The caller holds the lock.
stop_probe() {
	stop_pid "$probefile"
}

# Stop IFACE's client and its probe, and wait for the client's script to
# give the lease up, so that a new client's lease cannot be taken away by
# the old one's ending. The caller holds the lock.
stop_dhcp() {
	stop_probe
	stop_pid "$pidfile"
	rm -f "$netfile"
}

# Start a client of IFACE for the network WPA_ID.
start_dhcp() {
	/bin/busybox udhcpc -f -R -O mtu -i "$iface" -p "$pidfile" < /dev/null 9>&- &
	echo $! > "$pidfile"
	echo "${WPA_ID-}" > "$netfile"
}

# Set `addr` to IFACE's IPv4 address, or to nothing when it has none.
address() {
	addr=$(/bin/busybox ifconfig "$iface" 2>/dev/null |
		sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')
}

# Ask the network IFACE has joined whether the address in use is still its
# own, in the background, in place of a probe already running. A client
# with no address yet is still asking, and needs no probe. The caller holds
# the lock.
start_probe() {
	stop_probe
	address
	[ -n "$addr" ] || return 0
	/bin/busybox udhcpc -n -q -f -t 3 -T 2 -r "$addr" -i "$iface" -s "$PROBE_SCRIPT" \
		< /dev/null 9>&- &
	echo $! > "$probefile"
}

# The probe whose pid is $1 has ended its asking, with the address $2
# offered, or none when no server answered. Unless the lock is busy or a
# newer probe or a stop has taken its place, restart the client when the
# offer is not the address in use.
probed() {
	exec 9> "$lock"
	flock -n 9 || return 0
	[ "$(cat "$probefile" 2>/dev/null)" = "$1" ] || return 0
	rm -f "$probefile"
	if [ -z "$2" ] || ! running; then
		return 0
	fi
	address
	if [ -n "$addr" ] && [ "$addr" != "$2" ]; then
		echo "wpa_action: $iface: the network offers $2, not $addr: starting over" >&2
		WPA_ID=$(cat "$netfile" 2>/dev/null)
		stop_dhcp
		start_dhcp
	fi
}

# Whether IFACE's client runs.
running() {
	[ -s "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

# Set `st` to wpa_supplicant's state of IFACE, such as COMPLETED, and `net` to
# the id of the network joined, both from one reply: a reply cut short leaves
# `net` empty.
look() {
	reply=$(wpa_cli -p "$CTRL" -i "$iface" status 2>/dev/null)
	st=$(printf '%s\n' "$reply" | sed -n 's/^wpa_state=//p')
	net=$(printf '%s\n' "$reply" | sed -n 's/^id=//p')
}

# Wait for the disconnection whose file is "$hold.$1": stop the client when
# no CONNECTED has taken the file within HOLD seconds, and go on until one
# does, or the station is seen to have joined, or wpa_supplicant stops trying.
hold_wait() {
	n=0
	joined=0
	while [ -e "$hold.$1" ]; do
		look
		case "$st" in
			INTERFACE_DISABLED | INACTIVE) break ;;
			COMPLETED) [ -z "$net" ] || joined=$((joined + 1)) ;;
			*) joined=0 ;;
		esac
		if [ $joined -ge 2 ]; then
			dhcp_lock
			if [ -e "$hold.$1" ]; then
				WPA_ID=$net connected
			fi
			return
		fi
		if [ $n -eq $HOLD ]; then
			dhcp_lock
			if [ -e "$hold.$1" ]; then
				stop_dhcp
			fi
			dhcp_unlock
		fi
		if [ $n -lt $HOLD ]; then
			sleep 1
		else
			sleep $LOOK
		fi
		n=$((n + 1))
	done
	dhcp_lock
	if [ -e "$hold.$1" ]; then
		stop_dhcp
		rm -f "$hold.$1"
	fi
}

# The station joined the network WPA_ID: keep the client through a rejoin of
# the same network, whether or not its disconnection was heard, and probe
# for another subnet, or start a client for this network. A new client
# under load can take minutes to have a lease. The caller holds the lock.
connected() {
	rm -f "$hold".*
	if running && [ -n "${WPA_ID-}" ] &&
		[ "$(cat "$netfile" 2>/dev/null)" = "$WPA_ID" ]; then
		start_probe
	else
		stop_dhcp
		start_dhcp
	fi
}

case "$iface" in
	'' | */*)
		echo "wpa_action: usage: wpa_action IFACE CONNECTED|DISCONNECTED" >&2
		exit 2
		;;
esac

case "$2" in
	CONNECTED)
		dhcp_lock
		connected
		;;
	DISCONNECTED)
		dhcp_lock
		rm -f "$hold".*
		stop_probe
		running || stop_dhcp
		: > "$hold.$$"
		dhcp_unlock
		hold_wait $$ < /dev/null > /dev/null 2>&1 &
		;;
	PROBED)
		probed "$3" "${4-}"
		;;
esac
exit 0
