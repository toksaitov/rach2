#!/bin/sh
#
# The script BusyBox's udhcpc runs when a lease arrives, is renewed, or ends.
#
# udhcpc does not configure anything itself: it learns a lease and calls this
# with the answer in the environment. So this is where a lease becomes an
# address, a route and a resolver, and it uses the same commands an
# administrator would: busybox's `ifconfig` and `route`.
#
# The three cases are the ones udhcpc has. `deconfig` runs before the first
# request and when a lease is lost, and leaves the interface with no address.
# `bound` is a new lease and `renew` an extension of one; both apply the whole
# answer, because a renewal may carry a different router or resolver than the
# lease before it. The interfaces file runs udhcpc with `-O mtu`, so a lease
# may carry an MTU, which is applied too.
#
# The lease's servers go to the resolver merge, resolv.script, as the source
# IFACE.dhcp, which writes /etc/resolv.conf from them and from what DHCPv6 and
# the routers' advertisements give, so that no source drops another's.

# shellcheck disable=SC2154 # udhcpc passes the lease in the environment
MERGE=/usr/share/udhcpc/resolv.script

fail=0

# The lease's resolver lines, for the merge.
resolv_lines() {
	if [ -n "$domain" ]; then
		echo "search $domain"
	fi
	for s in $dns; do
		echo "nameserver $s"
	done
}

# Remove the default routes through the interface. The loop ends when a
# removal fails, as it does once none is left.
drop_routes() {
	while /bin/busybox route del default gw 0.0.0.0 dev "$interface" 2>/dev/null; do
		:
	done
}

case "$1" in
	# A lost lease, or a link that went down, takes everything the lease
	# gave: the address, the default route, whose gateway is the last
	# network's, and the servers.
	deconfig)
		/bin/busybox ifconfig "$interface" 0.0.0.0 || fail=1
		drop_routes
		: | "$MERGE" "$interface.dhcp" || fail=1
		;;

	bound|renew)
		# The netmask is given only when the lease carries one. Without it
		# `ifconfig` derives the classful mask, which is the right answer;
		# inventing a /24 here would make a gateway on a wider subnet
		# unreachable.
		if [ -n "$subnet" ]; then
			/bin/busybox ifconfig "$interface" "$ip" netmask "$subnet" || fail=1
		else
			/bin/busybox ifconfig "$interface" "$ip" || fail=1
		fi

		# An MTU only when the lease gives one: a network such as a PPPoE
		# line's carries less than Ethernet's 1500 bytes, and its server
		# says so. Without one the interface keeps the MTU it has.
		if [ -n "$mtu" ]; then
			/bin/busybox ifconfig "$interface" mtu "$mtu" || fail=1
		fi

		# Old default routes go before the new one.
		drop_routes

		# The lease decides the route, a lease that names none included:
		# the old default route goes whether or not this one replaces it,
		# because a gateway of the network this machine was on before is
		# not a gateway here. A lease with no router leaves the machine with
		# its subnet and nothing beyond it, as the lease says, and that is
		# reported, because a machine reachable only from its own subnet
		# looks like a machine that is down.
		if [ -n "$router" ]; then
			for r in $router; do
				/bin/busybox route add default gw "$r" dev "$interface" || fail=1
				break
			done
		else
			echo "udhcpc: the lease names no router: nothing off this subnet is reachable" >&2
		fi

		# The servers are given on every lease, whether or not this one
		# names any: leaving the last lease's behind would point this
		# machine at a network it is no longer on. The merge keeps the old
		# file when a write fails, rather than publishing a resolver with
		# nothing in it.
		resolv_lines | "$MERGE" "$interface.dhcp" || fail=1
		;;
esac

# What failed is reported rather than swallowed: udhcpc logs a script that
# fails, and a machine configured by halves should say so.
exit $fail
