#!/bin/sh
#
# The script BusyBox's udhcpc6 runs when a DHCPv6 lease arrives, is renewed,
# or ends.
#
# Most IPv6 networks need no DHCPv6: the kernel makes the addresses the
# routers advertise by itself (SLAAC). A router that sets the M flag in its
# advertisements tells its hosts to ask a server for an address, and one that
# sets O alone to ask for the other settings, the DNS servers among them;
# ndwatch(8) starts udhcpc6 for either, with `-l` for O, and an `up` line of
# an `inet6` stanza can start it too. A DHCPv6 lease carries no prefix length
# and no route: the address is a /128, and the on-link prefix and the default
# route are the routers'. A lease of `-l` has no address, only servers.
#
# The address of the lease in force is kept in /var/run, so that a lease
# lost or replaced takes its address away. The servers go to the resolver
# merge, resolv.script, as the source IFACE.dhcp6, beside the IPv4 lease's
# and the routers', so that a machine on both keeps both.

# shellcheck disable=SC2154 # udhcpc6 passes the lease in the environment
MERGE=/usr/share/udhcpc/resolv.script
KEPT=/var/run/udhcpc6.$interface.address

fail=0

# Take away the address of the lease before this one, if there was one.
drop_old() {
	if [ -s "$KEPT" ]; then
		/bin/busybox ifconfig "$interface" del "$(cat "$KEPT")/128" 2>/dev/null
		/bin/busybox rm -f "$KEPT"
	fi
}

# The lease's resolver lines, for the merge.
resolv_lines() {
	if [ -n "$search" ]; then
		echo "search $search"
	fi
	for s in $dns; do
		echo "nameserver $s"
	done
}

case "$1" in
	deconfig)
		drop_old
		: | "$MERGE" "$interface.dhcp6" || fail=1
		;;

	bound|renew)
		if [ -n "$ipv6" ]; then
			if [ "$(cat "$KEPT" 2>/dev/null)" != "$ipv6" ]; then
				drop_old
				/bin/busybox ifconfig "$interface" add "$ipv6/128" || fail=1
				[ $fail = 0 ] && echo "$ipv6" > "$KEPT"
			fi
		else
			drop_old
		fi
		resolv_lines | "$MERGE" "$interface.dhcp6" || fail=1
		;;
esac

exit $fail
