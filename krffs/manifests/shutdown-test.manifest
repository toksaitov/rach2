# shutdown-test.manifest: the disk of `tests/run shutdown`, which checks that
# a program can stop the machine, and that only root's can.
#
# Its init is init-shell, not init-login, so that the console starts with a
# root shell and the suite's input never meets `login`, which discards
# pending input when it puts the terminal back into canonical mode and would
# lose input written ahead of its prompts. The console's login is
# `tests/run login`'s to test.
#
# The image has an unprivileged account and the set-user-ID `/bin/su`,
# because one phase checks a refusal: a `halt` run by an account other than
# root must be refused by the kernel's check of signal permission.
#
# tests/system/suites/shutdown.sh boots it. Host paths are relative to the
# repository root, where mkdisk.sh runs.

dir 0755 /bin
file 0755 /bin/busybox build/vendor/busybox/busybox
file 0755 /bin/sh build/vendor/busybox/busybox
file 04755:0:0 /bin/su build/utils/sbin/su

dir 0755 /sbin
file 0755 /sbin/init build/utils/sbin/init-shell

# The /etc of the login images, with the second account. The shadow file is
# the one the build makes, so the suite reads root's password from the file
# the other suites read.
dir 0755 /etc
text 0644 /etc/motd shutdown-test\n
text 0644 /etc/hostname rach2\n
text 0644 /etc/passwd root:x:0:0:root:/root:/bin/sh\ntest:x:1000:1000:test:/home/test:/bin/sh\n
file 0600 /etc/shadow krffs/shadow
text 0644 /etc/group root:x:0:\ntest:x:1000:\n
text 0644 /etc/shells /bin/sh\n
text 0644 /etc/profile export PATH=/bin:/usr/bin\n

dir 0755 /root
dir 0755 /home
dir 0700:1000:1000 /home/test
