# os-real-gnu.manifest: the os-real system that the GNU system is installed
# over, on an ext2 root (vendor/gnu/Readme.md).
#
# This manifest stages the musl system; vendor/gnu/install_root.sh then
# installs glibc, the ports, GCC, GDB, the SpiderMonkey shell and Debian's
# chromium-headless-shell over the staged tree before tools/image/mkext2.sh
# formats it. It is os-real.manifest with these differences, and a line
# without a comment here has the reason os-real.manifest gives it:
#
# * OpenSSH replaces Dropbear: there is no /bin/dropbearmulti, and /sbin/init
#   is init-metal, which starts /usr/sbin/sshd at boot where Dropbear's
#   machine starts Dropbear, and makes its host keys on the first boot.
# * The accounts have `sshd`, the unprivileged user of the server's
#   privilege separation, and /var/empty, the empty directory owned by root
#   that the server's unprivileged child is confined to; and `messagebus`,
#   the user D-Bus's system bus runs as, which init starts.
# * bash is the login shell of root and the test account, and /bin/sh,
#   which install_root.sh links to it, so that a script and system(3) find
#   the programs of the path, as on a GNU/Linux system, where BusyBox's ash
#   would run its own applet for a name first. The path finds what is
#   installed under /usr/local, then the GNU programs in /usr/bin before the
#   files of /bin.
# * `nobody` and `nogroup`, the account and group with nothing of their
#   own, 65534 as on Debian, which programs and scripts name.
# * /etc/profile gives a prompt of the user, the machine and the directory,
#   and a session on a terminal other than a dumb one the C.UTF-8 locale,
#   the console's among them, whose screen draws UTF-8;
#   and it gives the user a D-Bus session bus, which the browser asks for,
#   at ~/.dbus/session_bus_socket, starting one where none answers there.
#   It leaves the directory as it is: login, su - and sshd start a session
#   in the home directory, and a login shell started elsewhere, as tmux
#   starts each window's, stays where it was started.
# * /etc/hosts is a machine's, as the metal disk has it, since this root is
#   installed on the Lenovo; QEMU's gateway and resolver are reached by
#   address.
# * /etc/fstab names the root by the label the image tool gives every root,
#   which findmnt --verify, mount -a and fsck -A read.
# * The programs of the ports that are set-id on Debian: util-linux's
#   newgrp, cronie's crontab, with the group `crontab` and the crontabs'
#   directory under /var/spool/cron, and shadow's chsh, chfn and gpasswd.
# * glibc's own files: /etc/nsswitch.conf, and /etc/ld.so.conf, from which
#   install_root.sh writes /etc/ld.so.cache.

dir 0755 /bin
file 0755 /bin/audiotest build/utils/audiotest
file 0755 /bin/busybox build/vendor/busybox/busybox
file 04755:0:0 /bin/su build/vendor/busybox/busybox-suid
file 04755:0:0 /bin/passwd build/vendor/busybox/busybox-suid
file 04755:0:0 /bin/login build/vendor/busybox/busybox-suid
file 0755 /bin/ping build/utils/ping
file 0755 /bin/dmesg krffs/dmesg.script
file 0755 /bin/man krffs/man.script
file 0755 /bin/loopctl build/utils/loopctl
optional-file 0755 /bin/doom build/ports/doom/doom

# TinyCC and pdpmake keep their places, so the musl self-build of /src works
# as on os-real. The path finds GCC's `cc` and GNU make first, so these are
# reached as `tcc` and by their full names, /bin/cc and /bin/make.
file 0755 /bin/tcc build/vendor/tcc/tcc
file 0755 /bin/cc build/vendor/tcc/tcc
file 0755 /bin/make build/vendor/pdpmake/make
dir 0755 /lib
dir 0755 /lib/tcc
file 0644 /lib/tcc/libtcc1.a build/vendor/tcc/libtcc1.a
tree 0644 /lib/tcc/include build/vendor/tcc/include
file 0644 /lib/libc.a vendor/musl/install/lib/libc.a
file 0644 /lib/crt1.o vendor/musl/install/lib/crt1.o
file 0644 /lib/crti.o vendor/musl/install/lib/crti.o
file 0644 /lib/crtn.o vendor/musl/install/lib/crtn.o
tree 0644 /include vendor/musl/install/include

tree 0644 /src/utils utils
dir 0755 /src
dir 0755 /src/utils
dir 0755 /src/rach2
dir 0755 /src/rach2/sys
dir 0755 /src/ish
tree 0644 /src/rach2 rach2
tree 0644 /src/ish ish

# init-metal: init-login's strict console with the network and a supervised
# SSH server beside it (utils/init.c), which on this image is OpenSSH's.
dir 0755 /sbin
file 0755 /sbin/init build/utils/sbin/init-metal
file 0755 /bin/mke2fs build/vendor/e2fsprogs/mke2fs

# e2fsprogs' checker, resizer and tuner beside mke2fs, as Debian has them
# in /sbin; the overlay links fsck.ext2 and e2label to them.
file 0755 /sbin/e2fsck build/vendor/e2fsprogs/e2fsck
file 0755 /sbin/resize2fs build/vendor/e2fsprogs/resize2fs
file 0755 /sbin/tune2fs build/vendor/e2fsprogs/tune2fs
file 0755 /sbin/dumpe2fs build/vendor/e2fsprogs/dumpe2fs
file 0755 /bin/update build/utils/update

file 0755 /bin/bootctl build/utils/sbin/bootctl

dir 0755 /demo
text 0644 /demo/hello.txt hello, world\n

dir 0755 /etc
text 0644 /etc/motd Rach2\n\nThe log of this boot is in /dev/bootlog, for root.\nWhat the services print is in /var/log/services.\nType su to become root.\n\n
text 0644 /etc/hostname rach2\n
text 0644 /etc/fstab # The root, by the label every Rach2 root has.\nLABEL=rach2 / ext2 defaults 0 1\n
# What the system is, which scripts that tell systems apart read.
text 0644 /etc/os-release NAME="Rach2"\nPRETTY_NAME="Rach2 1.0.0 with the GNU system"\nID=rach2\nVERSION_ID="1.0.0"\n
# The server's privilege separation runs as `sshd`, which has no password
# and no shell to log in with, and 74, the number Red Hat's systems give it,
# is below the 100 from which BusyBox's adduser gives out system accounts.
text 0644 /etc/passwd root:x:0:0:root:/root:/bin/bash\ntest:x:1000:1000:test:/home/test:/bin/bash\nsshd:x:74:74::/var/empty:/usr/bin/false\nmessagebus:x:81:81::/nonexistent:/usr/bin/false\nnobody:x:65534:65534:nobody:/nonexistent:/usr/bin/false\n
file 0600 /etc/shadow krffs/shadow
# `tty` is the group of every pseudo-terminal, 5 as on Linux, which write(1)
# and wall(1) run as to write to another user's terminal. `sudo`, 27 as on
# Debian, is the group whose members /etc/sudoers lets run any command as
# any user. `crontab` is the group crontab(1) runs as, which may write the
# crontabs' directory; 63 is below the system accounts' 100, and no Debian
# group has that number.
text 0644 /etc/group root:x:0:\ntty:x:5:\nsudo:x:27:\ntest:x:1000:\nsshd:x:74:\nmessagebus:x:81:\ncrontab:x:63:\nnogroup:x:65534:\n
text 0644 /etc/shells /bin/sh\n/bin/bash\n
# sudo's rules, Debian's: root and the group sudo may run any command as any
# user, with a clean environment and on a terminal of its own, and a file in
# /etc/sudoers.d adds rules.
text 0440 /etc/sudoers Defaults env_reset\nDefaults use_pty\nroot ALL=(ALL:ALL) ALL\n%sudo ALL=(ALL:ALL) ALL\n@includedir /etc/sudoers.d\n
dir 0755 /etc/sudoers.d
# shadow's useradd makes no mail spool, since the system delivers no mail
# and has no spool directory for it.
dir 0755 /etc/default
text 0644 /etc/default/useradd CREATE_MAIL_SPOOL=no\n
dir 0755 /etc/rach2
text 0644 /etc/rach2/limits # The limits every session starts with: a name, the soft value and the\n# hard one; unlimited for none. Root may raise them.\nnproc 256 512\nnofile 1024 1024\nas unlimited unlimited\n
# The path OpenSSH's server gives a session too, which finds what is
# installed under /usr/local, then GCC, GNU make and the rest of the GNU
# system before the musl programs of /bin. The
# prompt's escapes are bash's, which BusyBox's ash takes too, and it is
# exported so that a shell started from the login shell has it. The console
# draws ASCII alone, so only a session on another terminal, over SSH, gets
# the UTF-8 locale that glibc builds in.
text 0644 /etc/profile export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin\nexport HOME="${HOME:-/root}"\nexport PS1='\u@\h:\w\$ '\ncase "$TERM" in dumb|'') ;; *) export LANG=C.UTF-8 ;; esac\nif [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -x /usr/bin/dbus-daemon ]; then\n    export DBUS_SESSION_BUS_ADDRESS="unix:path=$HOME/.dbus/session_bus_socket"\n    dbus-send --session --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.GetId 2>/dev/null ||\n        { mkdir -p "$HOME/.dbus" && chmod 700 "$HOME/.dbus" &&\n          dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --fork --nopidfile >/dev/null 2>&1; }\nfi\n
text 0644 /etc/resolv.conf nameserver 10.0.2.3\n
text 0644 /etc/hosts 127.0.0.1   localhost\n127.0.1.1   rach2\n
# Where glibc looks up accounts and names: the files in /etc, then DNS for
# a host that /etc/hosts does not have.
text 0644 /etc/nsswitch.conf passwd: files\ngroup: files\nshadow: files\nhosts: files dns\nnetworks: files\nprotocols: files\nservices: files\n
# The directory of Debian's libraries, which glibc's loader searches after
# /lib and /usr/lib through the cache ldconfig writes from this file.
text 0644 /etc/ld.so.conf /usr/lib/i386-linux-gnu\n

dir 0755 /etc/network
text 0644 /etc/network/interfaces auto eth0\niface eth0 inet dhcp\n
dir 0755 /etc/network/if-pre-up.d
dir 0755 /etc/network/if-up.d
dir 0755 /etc/network/if-down.d
dir 0755 /etc/network/if-post-down.d

dir 0755 /var
# The directory the server's unprivileged child is confined to, which the
# server requires to be root's and writable by nobody else.
dir 0755 /var/empty
dir 0755 /var/log
dir 0755 /var/run
# The crontabs, which crontab(1) writes as the group `crontab` and cron
# reads as root. The sticky bit keeps a user from removing another's
# crontab, and nobody else may list the directory, as on Debian.
dir 0755 /var/spool
dir 0755 /var/spool/cron
dir 01730:0:63 /var/spool/cron/crontabs

dir 0755 /usr
# The set-id programs of the ports. install_root.sh installs the rest of the
# GNU system, and what it adds has no set-id bit, so these come from
# build/vendor/gnu/setid, where their recipes leave them: newgrp, set-id
# root, which changes a session's group; crontab, set-id to `crontab`;
# write and wall, set-id to `tty`, which write to another user's terminal;
# sudo, set-id root, which runs a command as another user by /etc/sudoers;
# and chsh, chfn and gpasswd, set-id root, which change a user's own shell
# and name in /etc/passwd and a group's members and password.
dir 0755 /usr/bin
file 04755:0:0 /usr/bin/newgrp build/vendor/gnu/setid/newgrp
file 02755:0:63 /usr/bin/crontab build/vendor/gnu/setid/crontab
file 02755:0:5 /usr/bin/write build/vendor/gnu/setid/write
file 02755:0:5 /usr/bin/wall build/vendor/gnu/setid/wall
file 04755:0:0 /usr/bin/sudo build/vendor/gnu/setid/sudo
file 04755:0:0 /usr/bin/chsh build/vendor/gnu/setid/chsh
file 04755:0:0 /usr/bin/chfn build/vendor/gnu/setid/chfn
file 04755:0:0 /usr/bin/gpasswd build/vendor/gnu/setid/gpasswd
dir 0755 /usr/share
dir 0755 /usr/share/udhcpc
file 0755 /usr/share/udhcpc/default.script krffs/udhcpc-default.script
dir 0755 /usr/share/man
file 0644 /usr/share/man/aliases man/aliases
tree 0644 /usr/share/man/cat1 build/man/cat1
tree 0644 /usr/share/man/cat2 build/man/cat2
tree 0644 /usr/share/man/cat4 build/man/cat4
tree 0644 /usr/share/man/cat5 build/man/cat5
tree 0644 /usr/share/man/cat7 build/man/cat7
tree 0644 /usr/share/man/cat8 build/man/cat8

dir 0700 /root
dir 0700 /root/.ssh
file 0600 /root/.ssh/authorized_keys krffs/authorized_keys

dir 1777 /tmp
dir 0755 /home
dir 0700:1000:1000 /home/test
dir 0700:1000:1000 /home/test/.ssh
file 0600:1000:1000 /home/test/.ssh/authorized_keys krffs/test_authorized_keys
optional-file 0644 /demo/doom1.wad ports/doom/doom1.wad
