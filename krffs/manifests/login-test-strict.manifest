# login-test-strict.manifest: the strict image of `tests/run login`, with
# init-login and no /bin/login, the case in which the console must refuse.
#
# The fault this image is for is a fall-through: an init that tried
# /bin/login and then a shell would give the console to whoever is at it,
# and a fall-through on ENOENT alone would not remove the danger, since
# ENOENT is this image. So init-login has no fallback compiled in, and this
# boot must report that it cannot exec /bin/login, report it more than once,
# since once is a failure and not a retry, and never print uid=0.
#
# The shell is staged all the same, at the path os-real uses: the test is
# that init does not run a shell, so one must be there to run.
#
# tests/system/suites/login.sh boots this image and the permissive one. Host
# paths are relative to the repository root, where mkimage.sh runs.

dir 0755 /bin
file 0755 /bin/busybox build/vendor/busybox/busybox
file 0755 /bin/sh build/vendor/busybox/busybox

dir 0755 /sbin
file 0755 /sbin/init build/utils/sbin/init-login

# A full /etc, so that what stops the boot is the missing program and not a
# missing account, and the init is the only difference between this image
# and login-test-shell.
dir 0755 /etc
text 0644 /etc/motd login-test-strict\n
text 0644 /etc/hostname rach2\n
text 0644 /etc/passwd root:x:0:0:root:/root:/bin/sh\n
file 0600 /etc/shadow krffs/shadow
text 0644 /etc/group root:x:0:\n
text 0644 /etc/shells /bin/sh\n
text 0644 /etc/profile export PATH=/bin:/usr/bin\n

dir 0755 /root
