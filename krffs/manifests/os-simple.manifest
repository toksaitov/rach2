# os-simple.manifest: a small Unix built out of this project's own code.
#
# Everything here was written for this system: the ISH shell, the hand-written
# utilities, and the account programs (login, su, passwd, adduser). It is the
# counterpart to os-real, which takes the same jobs from busybox and dropbear.
# Reading one against the other is the point of having both. Host paths are
# relative to the repo root (mkimage.sh cd's there).

# /bin: the shell and the programs, at the path a Unix keeps them, because that
# is the PATH login and su hand an account. The utilities arrive as one
# exec-dir line, which stages whatever build/utils holds.
dir 0755 /bin
file 0755 /bin/ish build/ish/ish
# The same shell again under the name a Unix calls its shell. KRFFS has no
# symlinks, so this is a second copy and not a link, and it is what makes
# `adduser name` with no -s create an account that can log in: the default
# shell it writes down is /bin/sh, and here that is ISH.
file 0755 /bin/sh build/ish/ish
exec-dir 0755 /bin build/utils

# The account programs. su and passwd read /etc/shadow, which is root's alone,
# so they carry the set-id bit and nothing else does; login is exec'd by init,
# which is already root. This is where the trust boundary of this image is: four
# programs, all in utils/, all readable in an afternoon.
file 04755:0:0 /bin/su build/utils/sbin/su
file 04755:0:0 /bin/passwd build/utils/sbin/passwd
file 0755:0:0 /bin/login build/utils/sbin/login
file 0755:0:0 /bin/adduser build/utils/sbin/adduser

# /sbin/init (PID 1): the kernel boots it; it forks a session child that execs
# /bin/login and nothing else, so this image asks who is there before it offers
# a shell. That is the init-login artifact, built with the shell table compiled
# out, so an image missing /bin/login refuses rather than falling back to a root
# shell. Booting with rach2.rescue is the way into an image that will not offer
# a prompt.
dir 0755 /sbin
file 0755 /sbin/init build/utils/sbin/init-login

# /etc: the account databases the four programs above read and write. The shadow
# file holds the real $6$ hashes, generated by krffs/gen_demo_password.sh when
# absent, and is the same file os-real stages, so one password opens either
# image. It is 0600 root: the permission bits are what keep it from the account
# that logs in, and the kernel enforces them.
dir 0755 /etc
text 0644 /etc/motd Welcome to Rach2 (os-simple). The ISH shell and this project's own tools.\n
text 0644 /etc/passwd root:x:0:0:root:/root:/bin/ish\ntest:x:1000:1000:test:/home/test:/bin/ish\n
file 0600 /etc/shadow krffs/shadow
text 0644 /etc/group root:x:0:\ntest:x:1000:\n
text 0644 /etc/shells /bin/ish\n/bin/sh\n
text 0644 /etc/resolv.conf nameserver 10.0.2.3\n
text 0644 /etc/hosts 127.0.0.1   localhost\n10.0.2.2    gateway\n10.0.2.3    dns\n10.0.2.15   rach2\n

# The network, in the file os-real reads and in the same format, so one
# description serves both machines. This image has no busybox, so `netup` reads
# it and `dhcpc` takes the lease; `/etc/resolv.conf` above is what a machine
# with no lease starts from, and a lease replaces it.
dir 0755 /etc/network
text 0644 /etc/network/interfaces auto eth0\niface eth0 inet dhcp\n
# A fixed address, written out and not applied. This image has no editor at
# all, so the way to move the machine off DHCP is to copy this over the file
# above and run `netup -a`; it is also the format's second half, which a reader
# would otherwise never see on this machine.
text 0644 /etc/network/interfaces.static auto eth0\niface eth0 inet static\n    address 10.90.0.50\n    netmask 255.255.0.0\n    gateway 10.90.0.2\n

# Where the DHCP client records which process holds the interface, so a second
# `netup` is refused rather than starting a client that fights the first. Init
# empties it at boot, so a record from a machine that was switched off does not
# outlive it.
dir 0755 /var
dir 0755 /var/run

# The homes. root's is root's; the test account's is owned by it and closed to
# everyone else, which is a real second account here and not a label.
dir 0755 /root
dir 0755 /home
dir 0700:1000:1000 /home/test
dir 1777 /tmp

text 0644 /hello.txt hello, world\n
