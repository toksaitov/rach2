# os-simple.manifest: a small Unix built out of this project's own code.
#
# Every program here was written for this system: the ISH shell, the
# utilities, and the account programs login, su, passwd and adduser. It is
# the counterpart of os-real, which has BusyBox and Dropbear do the same
# work, and the two are meant to be read side by side. Host paths are
# relative to the repository root, where mkimage.sh runs.

# /bin: the shell and the programs, in the directory of the PATH that login
# and su give an account. The utilities are staged by one exec-dir line,
# which takes every program built in build/utils.
dir 0755 /bin
file 0755 /bin/ish build/ish/ish
# The same shell under the name a Unix gives its shell. KRFFS has no symbolic
# links, so this is a second copy, and it lets `adduser NAME` with no -s make
# an account that can log in: the default shell it writes is /bin/sh, which
# here is ISH.
file 0755 /bin/sh build/ish/ish
exec-dir 0755 /bin build/utils

# The account programs. su and passwd read /etc/shadow, which is root's
# alone, so they have the set-user-ID bit and nothing else does; init, which
# is root already, runs login. These four programs, all in utils/, are the
# image's trust boundary.
file 04755:0:0 /bin/su build/utils/sbin/su
file 04755:0:0 /bin/passwd build/utils/sbin/passwd
file 0755:0:0 /bin/login build/utils/sbin/login
file 0755:0:0 /bin/adduser build/utils/sbin/adduser

# /sbin/init, process 1, which the kernel starts: it forks a session child
# that runs /bin/login and nothing else, so the image asks who is there before
# it gives a shell. It is init-login, built with the shell table compiled out,
# so an image without /bin/login refuses rather than falling back to a root
# shell. A boot with rach2.rescue is the way into an image that will not give
# a prompt.
dir 0755 /sbin
file 0755 /sbin/init build/utils/sbin/init-login

# /etc: the account files the four programs above read and write. The shadow
# file has the $6$ hashes that krffs/gen_demo_password.sh makes, and it is
# the file os-real stages, so one password opens either image. It is 0600
# and root's: the mode, which the kernel enforces, keeps it from the account
# that logs in.
dir 0755 /etc
text 0644 /etc/motd Welcome to Rach2 (os-simple). The ISH shell and this project's own tools.\n
text 0644 /etc/passwd root:x:0:0:root:/root:/bin/ish\ntest:x:1000:1000:test:/home/test:/bin/ish\n
file 0600 /etc/shadow krffs/shadow
text 0644 /etc/group root:x:0:\ntest:x:1000:\n
text 0644 /etc/shells /bin/ish\n/bin/sh\n
text 0644 /etc/resolv.conf nameserver 10.0.2.3\n
text 0644 /etc/hosts 127.0.0.1   localhost\n10.0.2.2    gateway\n10.0.2.3    dns\n10.0.2.15   rach2\n

# The network, in the file and the format os-real reads, so one description
# serves both systems. This image has no BusyBox, so `netup` reads it and
# `dhcpc` takes the lease; `/etc/resolv.conf` above is what a machine with no
# lease starts from, and a lease replaces it.
dir 0755 /etc/network
text 0644 /etc/network/interfaces auto eth0\niface eth0 inet dhcp\n
# A fixed address, written out and not applied. This image has no editor at
# all, so the way to move the machine off DHCP is to copy this over the file
# above and run `netup -a`; it is also the format's second half, which a reader
# would otherwise never see on this machine.
text 0644 /etc/network/interfaces.static auto eth0\niface eth0 inet static\n    address 10.90.0.50\n    netmask 255.255.0.0\n    gateway 10.90.0.2\n

dir 0755 /var
# Where init puts what its services print, once the console is the login's.
dir 0755 /var/log
# Where the DHCP client records the process that has the interface, so that a
# second `netup` is refused rather than starting a client beside the first.
# init empties it at boot, so a record does not outlive the boot that wrote
# it.
dir 0755 /var/run

# The homes: root's, and the test account's, which it owns, at mode 0700.
dir 0755 /root
dir 0755 /home
dir 0700:1000:1000 /home/test
dir 1777 /tmp

dir 0755 /demo
text 0644 /demo/hello.txt hello, world\n
