# rach2-metal-disk.manifest: the os-real system for the root of an
# installed disk, the sealed disk's and the installer's. It differs from
# os-real in these, and a line without a comment here has the reason
# os-real.manifest gives it:
#
# * /sbin/init is init-metal, which keeps an SSH server running beside the
#   console login, so that the machine can be reached over the network as
#   soon as it has booted.
# * /demo has a file system of each kind the kernel mounts, for a person at
#   the console to attach, mount and write.
# * /etc/resolv.conf and /etc/hosts have no address of QEMU's.
# * /etc/ifplugd/ifplugd.action and /sbin/ndwatch, which init-metal runs
#   to follow a change of network, and /etc/sysctl.conf, whose settings
#   init applies at boot.
# * /root is 0755.
# * /bin/term and its font, which take 3.8 MiB: os-real's RAM image would
#   outgrow its size, OS_REAL_MIB in the Makefile.
#
# tools/inspect/setidcheck.c checks its set-id entries against setid.allow
# as it does os-real's.
dir 0755 /bin
file 0755 /bin/audiotest build/utils/audiotest
file 0755 /bin/sox build/vendor/sox_ng/sox
file 0755 /bin/play build/vendor/sox_ng/mode
file 0755 /bin/rec build/vendor/sox_ng/mode
file 0755 /bin/soxi build/vendor/sox_ng/mode
# The Wi-Fi station, its control and passphrase programs, and iw, which
# configures the radios through nl80211 (vendor/hostap/Readme.md,
# vendor/iw/Readme.md).
file 0755 /bin/wpa_supplicant build/vendor/hostap/wpa_supplicant
file 0755 /bin/wpa_cli build/vendor/hostap/wpa_cli
file 0755 /bin/wpa_passphrase build/vendor/hostap/wpa_passphrase
file 0755 /bin/iw build/vendor/iw/iw
# This BusyBox has no set-id bit. A set-user-ID BusyBox would run each of
# its BB_SUID_REQUIRE and BB_SUID_MAYBE applets as root unless a
# configuration file confined it, so there are two binaries, as BusyBox
# provides for, and the set-id bit is on the one that needs it. `su`,
# `passwd` and `login` are compiled out of this one, so a bare `su` finds the
# set-id build staged below and nothing else.
file 0755 /bin/busybox build/vendor/busybox/busybox
# Preserve sh as argument zero without a second copy of BusyBox.
file 0755 /bin/sh build/vendor/sox_ng/sh
# The account programs are BusyBox's, from the second build: one binary with
# only login, passwd and su, staged under the three names, since KRFFS has no
# symbolic links and BusyBox chooses the applet by argv[0]. It has the set-id
# bit, and the main BusyBox does not.
file 04755:0:0 /bin/su build/vendor/busybox/busybox-suid
file 04755:0:0 /bin/passwd build/vendor/busybox/busybox-suid
file 04755:0:0 /bin/login build/vendor/busybox/busybox-suid
# The periodic sync init keeps running: sleep thirty seconds, sync(2), for ever.
file 0755 /bin/update build/utils/update
# dmesg, which prints the kernel's log from /dev/bootlog
# (krffs/dmesg.script).
file 0755 /bin/dmesg krffs/dmesg.script
file 0755 /bin/man krffs/man.script
file 0755 /bin/dropbearmulti build/vendor/dropbear/dropbearmulti
# Attaches a file to a loop device so a file system in a file can be mounted
# (utils/Readme.md); it writes /dev/loop-control, which is root's.
file 0755 /bin/loopctl build/utils/loopctl
file 0755 /bin/mixer build/utils/mixer
# wifi, which scans for Wi-Fi networks and joins, lists and forgets them
# through wpa_supplicant (wifi(1)).
file 0755 /bin/wifi build/utils/wifi
# mke2fs makes an ext2 volume in a file, which a loop device then mounts,
# since the kernel's disk nodes refuse writes outside a recovery build.
file 0755 /bin/mke2fs build/vendor/e2fsprogs/mke2fs
optional-file 0755 /bin/doom build/ports/doom/doom

# The compiler, and the system root it reads when it runs. /bin/tcc is an
# ordinary program: nothing here runs it as root, so it is not in the set-id
# guard's list of trusted paths, as /bin/sh and /bin/login are. It needs the
# parts of a C toolchain outside the compiler: musl's headers and library,
# the startup objects, and tcc's own runtime and headers. Their paths are
# compiled into tcc by its configure (vendor/tcc/Readme.md), and
# /lib/tcc/include is searched before /include, since musl expects the
# compiler to provide stdarg.h and the other headers of the compiler.
file 0755 /bin/tcc build/vendor/tcc/tcc
# The same compiler under the name a makefile's built-in rules use. KRFFS has
# no symbolic links, so it is staged twice, as the account programs are.
file 0755 /bin/cc build/vendor/tcc/tcc
# pdpmake, as make (vendor/pdpmake/Readme.md).
file 0755 /bin/make build/vendor/pdpmake/make
dir 0755 /lib
dir 0755 /lib/tcc
file 0644 /lib/tcc/libtcc1.a build/vendor/tcc/libtcc1.a
tree 0644 /lib/tcc/include build/vendor/tcc/include
file 0644 /lib/libc.a vendor/musl/install/lib/libc.a
file 0644 /lib/crt1.o vendor/musl/install/lib/crt1.o
file 0644 /lib/crti.o vendor/musl/install/lib/crti.o
file 0644 /lib/crtn.o vendor/musl/install/lib/crtn.o
tree 0644 /include vendor/musl/install/include
# Rach2's own header for programs that use /fb, <rach2/fb.h>.
file 0644 /include/rach2/fb.h rach2/include/rach2/fb.h

# The sources of the project's utilities, staged so that the machine can
# build them, and a student can change a program and run the changed one on
# the machine.
tree 0644 /src/utils utils

# The kernel's and the shell's sources, each tree with the guest.mk that pdpmake
# reads, so that the machine can build its own kernel and shell (`tests/run
# selfbuild` builds both), with ACPICA's core, which the kernel compiles, beside
# the kernel's sources as the archive vendor/acpica.tar.bz2, which guest.mk
# unpacks. /src is root's and read-only to every other account: root builds in
# place, and another account copies a tree to its home first. The dir lines give
# the modes of the directories above the trusted files, which the set-id sweep
# requires for every path root reads through.
dir 0755 /src
dir 0755 /src/utils
dir 0755 /src/rach2
dir 0755 /src/rach2/sys
dir 0755 /src/rach2/vendor
dir 0755 /src/ish
tree 0644 /src/rach2 rach2
file 0644 /src/rach2/vendor/acpica.tar.bz2 build/vendor/acpica/acpica.tar.bz2
tree 0644 /src/ish ish
# term's sources with libtsm's patched ones beside them as an archive and
# their list, which term/guest.mk unpacks and includes.
dir 0755 /src/term
dir 0755 /src/term/vendor
tree 0644 /src/term term
file 0644 /src/term/vendor/libtsm.tar.bz2 build/vendor/libtsm/libtsm.tar.bz2
file 0644 /src/term/vendor/libtsm.mk vendor/libtsm/sources.mk

# /sbin/init, process 1, which the kernel starts: it forks a session child
# that runs /bin/login and nothing else, so the console is behind a password.
# It is init-metal, init-login's console with the network and a supervised
# SSH server beside it (utils/init.c). Like init-login it is built with the
# shell table compiled out, so an image without /bin/login refuses rather
# than falling back to a root shell. A boot with rach2.rescue is the way back
# into a broken image. init also reaps orphans, so the shells Dropbear forks
# for SSH sessions do not remain after a session closes, and /bin/login runs
# the account's shell, /bin/sh, in its own process once it has changed to
# the account's identity.
dir 0755 /sbin
file 0755 /sbin/init build/utils/sbin/init-metal

# bootctl puts a kernel the machine built into the boot partition's
# candidate slot for one trial boot (bootctl(8)). Only root can use it, since
# /dev/bootpart is 0600, so it has no set-id bit.
file 0755 /bin/bootctl build/utils/sbin/bootctl

# What a person at this machine can look at and change: a hello.txt in
# /demo, and one file system of each kind the kernel mounts, in a file, to be
# attached to a loop device. `empty.krffs` is formatted and empty, for a
# person to copy to make an image of their own, since the machine has no
# KRFFS formatter. `demo/Readme.txt` has the commands.

dir 0755 /demo
text 0644 /demo/hello.txt hello, world\n
file 0644 /demo/Readme.txt krffs/demo/Readme.txt
file 0644 /demo/fat32.img build/images/fs-demo/fat32.img
file 0644 /demo/exfat.img build/images/fs-demo/exfat.img
file 0644 /demo/ext2.img build/images/fs-demo/ext2.img
file 0644 /demo/krffs.img build/images/fs-demo/krffs.img
file 0444 /demo/empty.krffs build/images/fs-demo/empty.krffs

# /etc: the account and name-resolution files. Dropbear reads passwd and
# checks the login shell against shells; BusyBox's ash reads profile in a
# login shell. The shadow file has the $6$ hashes that
# krffs/gen_demo_password.sh makes, at 0600 and root's, so its mode keeps it
# from every other account; passwd, which all may read, has x in its
# password fields, which is what the separate shadow file is for.
dir 0755 /etc
file 0644 /etc/sox.COPYING build/vendor/sox_ng/COPYING
# The license notices of the Wi-Fi programs and of the libraries they link.
file 0644 /etc/hostap.COPYING build/vendor/hostap/COPYING
file 0644 /etc/iw.COPYING build/vendor/iw/COPYING
file 0644 /etc/libnl.COPYING build/vendor/libnl/COPYING
file 0644 /etc/openssl.LICENSE build/vendor/openssl/LICENSE.txt
dir 0700 /etc/dropbear
text 0644 /etc/motd Rach2\n\nThe log of this boot is in /dev/bootlog, for root.\nWhat the services print is in /var/log/services.\nType su to become root.\n\n
text 0644 /etc/hostname rach2\n
text 0644 /etc/passwd root:x:0:0:root:/root:/bin/sh\ntest:x:1000:1000:test:/home/test:/bin/sh\n
file 0600 /etc/shadow krffs/shadow
text 0644 /etc/group root:x:0:\ntest:x:1000:\n
text 0644 /etc/shells /bin/sh\n
dir 0755 /etc/rach2
text 0644 /etc/rach2/limits # The limits every session starts with: a name, the soft value and the\n# hard one; unlimited for none. Root may raise them.\nnproc 256 512\nnofile 1024 524288\nas unlimited unlimited\n
text 0644 /etc/profile export PATH=/bin:/usr/bin\nexport HOME="${HOME:-/root}"\ncd "$HOME"\n
# The machine this disk is installed in is on whatever network it is plugged
# into, so neither file has an address of QEMU's. The nameserver comes from
# the lease: `udhcpc` writes this file when one arrives, and until then a
# lookup has no server and fails. The hosts file has the loopback address
# and this machine's own name, which a program on it resolving `rach2` asks
# for.
text 0644 /etc/resolv.conf # written by udhcpc when a lease arrives\n
text 0644 /etc/hosts 127.0.0.1   localhost\n::1         localhost ip6-localhost ip6-loopback\n127.0.1.1   rach2\n

# The network configuration `ifup -a` reads, in the file where Debian keeps
# it and BusyBox's ifup reads it. `dhcp` brings the machine up on whatever
# network it is plugged into; a `static` stanza in the same file would give
# it a fixed address instead.
dir 0755 /etc/network
text 0644 /etc/network/interfaces auto eth0\niface eth0 inet dhcp\n    udhcpc_opts -O mtu\n

# The four directories `ifup` runs through run-parts. It treats a failure of any
# of them as a failed method, and run-parts on a directory that is not there is
# a failure, so they exist and are empty.
dir 0755 /etc/network/if-pre-up.d
dir 0755 /etc/network/if-up.d
dir 0755 /etc/network/if-down.d
dir 0755 /etc/network/if-post-down.d

file 0644 /etc/acpi.map krffs/acpi/acpi.map
file 0644 /etc/acpid.conf krffs/acpi/acpid.conf
dir 0755 /etc/acpi
file 0755 /etc/acpi/power krffs/acpi/power.script
dir 0755 /etc/acpi/volume
file 0755 /etc/acpi/volume/up krffs/acpi/volume.script
file 0755 /etc/acpi/volume/down krffs/acpi/volume.script
file 0755 /etc/acpi/volume/mute krffs/acpi/volume.script
dir 0755 /etc/acpi/brightness
file 0755 /etc/acpi/brightness/up krffs/acpi/brightness.script
file 0755 /etc/acpi/brightness/down krffs/acpi/brightness.script
file 0755 /etc/acpi/wifi krffs/acpi/wifi.script

dir 0755 /var
# Where init puts what its services print, once the console is the login's.
dir 0755 /var/log
# Where `ifup` records the interfaces it has brought up. It writes the file
# through a temporary beside it, so the directory must exist.
dir 0755 /var/run

dir 0755 /usr
dir 0755 /usr/share
dir 0755 /usr/share/udhcpc
# The script udhcpc runs when a lease arrives or ends, which turns the lease
# into an address, a route and a resolver.
file 0755 /usr/share/udhcpc/default.script krffs/udhcpc-default.script
# The script udhcpc6 runs for a DHCPv6 lease, which turns it into an address
# and resolvers (busybox-networking(1)).
file 0755 /usr/share/udhcpc/default6.script krffs/udhcpc6-default.script
# The resolver merge the lease scripts and ndwatch give their servers to,
# which writes /etc/resolv.conf from all of them (ndwatch(8)).
file 0755 /usr/share/udhcpc/resolv.script krffs/resolv.script
# What init runs where the boot line hands the network to userland (init(8)):
# BusyBox's ifplugd, which runs this action when eth0's link comes or goes,
# so a cable moved to another network gives that network's lease at once,
# and ndwatch, which follows the routers' DNS servers and DHCPv6 flags.
dir 0755 /etc/ifplugd
file 0755 /etc/ifplugd/ifplugd.action krffs/ifplugd.action
file 0755 /sbin/ndwatch build/utils/ndwatch
# What init runs on a machine with a Wi-Fi radio (init(8)): wpa_supplicant
# with this configuration, which wifi(1) adds networks to and which then
# holds their passphrases, so that only root reads it, and wpa_cli, which
# runs this action as the station joins and leaves a network, to start and
# stop the DHCP client on wlan0.
dir 0700 /etc/wpa_supplicant
file 0600 /etc/wpa_supplicant/wlan0.conf krffs/wpa_supplicant.conf
file 0755 /etc/wpa_supplicant/wpa_action krffs/wpa_action
# zzz, which suspends the machine to idle, and its Wi-Fi hook, which
# leaves the network before the suspend and joins it again after (zzz(8)).
file 0755 /sbin/zzz krffs/zzz
dir 0755 /etc/zzz.d
file 0755 /etc/zzz.d/wifi krffs/zzz-wifi
# wsimrelay, which carries a software radio's frames between /dev/wsim and
# a peer over UDP, for a machine whose Wi-Fi is the tests' software medium
# (wsimrelay(8)).
file 0755 /sbin/wsimrelay build/utils/sbin/wsimrelay
# The kernel settings init applies at boot with sysctl -p (init(8)): an
# outgoing IPv6 connection takes a temporary address, made anew each day
# (RFC 8981), while the stable address still answers connections from
# outside.
text 0644 /etc/sysctl.conf # Kernel settings, NAME = VALUE, which init applies at boot with sysctl -p.\n# Outgoing IPv6 connections use temporary addresses (RFC 8981).\nnet.ipv6.conf.all.use_tempaddr = 2\nnet.ipv6.conf.default.use_tempaddr = 2\n
# The keymaps, which loadkeys finds by name, as in `loadkeys -u kg alt-shift`
# (vendor/keymaps/Readme.md).
tree 0644 /usr/share/kbd/keymaps/xkb vendor/keymaps/xkb
# term, the terminal on the whole framebuffer, which init starts as the
# console session on a boot with rach2.console=term (init(8)), and the
# packed Unifont it draws with (vendor/unifont/Readme.md).
file 0755 /bin/term build/term/term
dir 0755 /usr/share/term
file 0644 /usr/share/term/unifont.font build/unifont/unifont.font
dir 0755 /usr/share/man
file 0644 /usr/share/man/aliases man/aliases
tree 0644 /usr/share/man/cat1 build/man/cat1
tree 0644 /usr/share/man/cat2 build/man/cat2
tree 0644 /usr/share/man/cat4 build/man/cat4
tree 0644 /usr/share/man/cat5 build/man/cat5
tree 0644 /usr/share/man/cat7 build/man/cat7
tree 0644 /usr/share/man/cat8 build/man/cat8

# /root, root's home, with the SSH login's authorized_keys, the demo keys that
# krffs/gen_demo_key.sh writes. Dropbear accepts a key only from a file, and
# directories above it, that no account but its owner and root may write.
dir 0755 /root
dir 0700 /root/.ssh
file 0600 /root/.ssh/authorized_keys krffs/authorized_keys

# /home/test, below /tmp: the test account's home and SSH login, owned by
# 1000:1000 at 0700 and 0600, so that no account but it and root may read
# them.

# The one sticky directory of the image: any account may make files in /tmp,
# and only a file's owner or root may remove or rename one, so root and the
# test account can share it.
dir 1777 /tmp
dir 0755 /home
dir 0700:1000:1000 /home/test
dir 0700:1000:1000 /home/test/.ssh
file 0600:1000:1000 /home/test/.ssh/authorized_keys krffs/test_authorized_keys
# Doom's game data, when the tree has it.
optional-file 0644 /demo/doom1.wad ports/doom/doom1.wad

# kbd console keyboard tools (vendor/kbd/Readme.md).
file 0755 /bin/loadkeys build/vendor/kbd/loadkeys
file 0755 /bin/dumpkeys build/vendor/kbd/dumpkeys
file 0755 /bin/setleds build/vendor/kbd/setleds
file 0755 /bin/kbdrate build/vendor/kbd/kbdrate
file 0755 /bin/showkey build/vendor/kbd/showkey
file 0755 /bin/kbd_mode build/vendor/kbd/kbd_mode
