# The metal profile: the image the Lenovo G50-70 boots from a USB stick.
#
# The machine has no USB driver of its own, so whatever GRUB loads as the boot
# module IS the machine: nothing persists, and every byte here costs RAM under
# the kernel's 32 MiB direct map. So this profile carries what a bring-up needs
# and nothing else: a shell, an SSH server, the account files, and the keys.
#
# What os-real has and this does not, each for the same reason (it cannot be
# used on a machine with no writable disk, or it is not needed to bring the
# hardware up): the compiler and its sysroot, pdpmake, the /src trees, Doom,
# and bootctl, which writes a boot partition this profile never has.
#
# The account files are os-real's, so one password opens either image, and the
# authorized keys are the same pair the SSH capstone uses.

dir 0755 /bin
file 0755 /bin/audiotest build/utils/audiotest
file 0755 /bin/busybox build/vendor/busybox/busybox
file 0755 /bin/sh build/vendor/busybox/busybox

# The three applets that need the set-id bit come from busybox's second build,
# which holds only login, passwd and su, exactly as os-real stages them.
file 04755:0:0 /bin/su build/vendor/busybox/busybox-suid
file 04755:0:0 /bin/passwd build/vendor/busybox/busybox-suid
file 04755:0:0 /bin/login build/vendor/busybox/busybox-suid

file 0755 /bin/ping build/utils/ping
# The boot log, under the name a person expects. This machine has no
# console to watch it scroll past, so reading it afterwards is the only
# way to see it; `klogctl` does not exist here, and the log is a device.
file 0755 /bin/dmesg krffs/dmesg.script
file 0755 /bin/dropbearmulti build/vendor/dropbear/dropbearmulti
# Attaches a file to a loop device so a file system in a file can be mounted
# (utils/Readme.md); it writes /dev/loop-control, which is root's.
file 0755 /bin/loopctl build/utils/loopctl

dir 0755 /sbin
file 0755 /sbin/init build/utils/sbin/init-metal
# The periodic sync init keeps running: sleep thirty seconds, sync(2), for ever.
file 0755 /bin/update build/utils/update

dir 0755 /etc
dir 0700 /etc/dropbear
text 0644 /etc/motd Rach2 on real hardware (metal profile). No disk, no compiler: this machine lives in RAM.\n
text 0644 /etc/hostname rach2\n
text 0644 /etc/passwd root:x:0:0:root:/root:/bin/sh\ntest:x:1000:1000:test:/home/test:/bin/sh\n
file 0600 /etc/shadow krffs/shadow
text 0644 /etc/group root:x:0:\ntest:x:1000:\n
text 0644 /etc/shells /bin/sh\n
dir 0755 /etc/rach2
text 0644 /etc/rach2/limits # The limits every session starts with: a name, the soft value and the\n# hard one; unlimited for none. Root may raise them.\nnproc 256 512\nnofile 1024 1024\nas unlimited unlimited\n
# The stub resolver reads these two (utils/resolv.c). Without them a name is
# unresolvable and only numeric addresses work, which is what the first LAN
# session found. The nameserver is the one this LAN's router hands out rather
# than the router itself, because that router forwards nothing: it gives
# clients Cloudflare's resolvers, and a machine that assumed the gateway would
# answer would fail for a reason nobody could see. The resolver reads the first
# `nameserver` line; the second is here for a reader, not for the code.
# Numeric addresses never touch this file.
text 0644 /etc/resolv.conf nameserver 1.1.1.1\nnameserver 1.0.0.1\n
text 0644 /etc/hosts 127.0.0.1 localhost\n
text 0644 /etc/profile export PATH=/bin:/usr/bin\nexport HOME="${HOME:-/root}"\ncd "$HOME"\n

# The network configuration `ifup -a` reads, in the file Debian put it in and
# busybox's ifup expects. `dhcp` is what the sealed machine carries: it comes up
# wherever it is plugged in, which is the whole reason DHCP is here. A static
# stanza is the other half of the same file and is what a machine with a fixed
# address would say instead.
dir 0755 /etc/network
text 0644 /etc/network/interfaces auto eth0\niface eth0 inet dhcp\n

# The four directories `ifup` runs through run-parts. It treats a failure of any
# of them as a failed method, and run-parts on a directory that is not there is
# a failure, so they exist and are empty.
dir 0755 /etc/network/if-pre-up.d
dir 0755 /etc/network/if-up.d
dir 0755 /etc/network/if-down.d
dir 0755 /etc/network/if-post-down.d

# The script udhcpc runs when a lease arrives or ends. udhcpc learns the lease
# and this turns it into an address, a route and a resolver.
# /var/run: where `ifup` records which interfaces it has brought up. It writes
# the file through a temporary beside it, so the directory must be there.
dir 0755 /var
# Where init puts what its services print, once the console is the login's.
dir 0755 /var/log
dir 0755 /var/run

dir 0755 /usr
dir 0755 /usr/share
dir 0755 /usr/share/udhcpc
file 0755 /usr/share/udhcpc/default.script krffs/udhcpc-default.script

dir 0755 /root
dir 0700 /root/.ssh
file 0600 /root/.ssh/authorized_keys krffs/authorized_keys

dir 1777 /tmp
dir 0755 /home
dir 0700:1000:1000 /home/test
dir 0700:1000:1000 /home/test/.ssh
file 0600:1000:1000 /home/test/.ssh/authorized_keys krffs/test_authorized_keys
