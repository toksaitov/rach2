# The disk of `tests/run cred-persist`: creddisk on a KRFFS root on disk.
#
# mkdisk.sh builds it, and the suite boots it three times with rach2.fsdisk
# and rach2.rescue. The first boot replaces both files and stops while it
# holds the lock; the second reads the files back, reports and removes the
# lock the first left, and takes and releases one of its own; and the third
# checks that no lock is left. Each file is root's, at a mode the replacement
# must keep, as /etc/shadow is; the two modes differ, so that the probe can
# tell which one each file kept.
file 0755 /creddisk build/tests/musl/creddisk
text 0600 /credtarget original\n
text 0640 /credalso original\n

# The lock's directory: the probe takes the lock the system's writers of
# account files take, at the path compiled into the library.
dir 0755 /etc
