# The disk of `tests/run persist` and `persist-ahci`: persistprobe on a KRFFS
# root on disk.
#
# mkdisk.sh builds it, and the suite boots it twice with rach2.fsdisk and
# rach2.rescue. The first boot writes /persist.txt and calls fsync; the
# second reads the file back, which shows that fsync took the write through
# the page cache to the disk.
file 0755 /persistprobe build/tests/persistprobe
