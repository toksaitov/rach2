# test.manifest: the automated end-to-end test image.
#
# The freestanding syscall probes (build/tests) at the root, the musl integration
# programs (build/tests/musl) under /musl, a minimal /etc the musl file and auth
# probes read, and the small name-resolution config the network probes read.
# `make test` boots this image and asserts every probe's success token. Host
# paths are relative to the repo root (mkimage.sh cd's there).

exec-dir 0755 / build/tests

# suidprobe's fixtures: the same helper binary staged at several modes and
# owners. exec-dir above already placed a plain 0755 /suidhelper (the "plain"
# control); these add the setuid-root copy suidprobe execs to gain root, a
# setuid copy owned by a non-root uid (the bit grants that owner's identity), a
# setgid copy owned by a non-root group, and a setuid-but-no-x copy the execute
# check must still refuse. Explicit modes and owners override the exec-dir
# default for these paths.
file 04755:0:0 /suidhelper.suid build/tests/suidhelper
file 04755:5:0 /suidhelper.u5   build/tests/suidhelper
file 02755:0:5 /suidhelper.sgid build/tests/suidhelper
file 04644:0:0 /suidhelper.nox  build/tests/suidhelper

# sudoprobe's fixtures: the reference sudo (utils/sudo.c, the coursework answer
# key) staged setuid root, and a sudoers listing uid 1000. sudoprobe drops to
# 1000, runs sudo to become root, and to 1001 to be refused. Shipped only here;
# the os-real image deliberately carries su and no sudo.
file 04755:0:0 /sudo build/utils/sbin/sudo
text 0644 /etc/sudoers # uids permitted to run sudo\n1000\n

dir 0755 /musl
exec-dir 0755 /musl build/tests/musl
# suidmusl's setuid-root copy: the plain 0755 /musl/suidmusl above is the
# parent that drops to 1000 and execs this to prove libc's view of a set-id
# exec (getresuid, getauxval(AT_SECURE), the saved-id dance).
file 04755:0:0 /musl/suidmusl.suid build/tests/musl/suidmusl

# A minimal /etc: catfile reads motd and lists the directory, permmusl opens
# motd, and authmusl resolves root through passwd to uid 0. The shadow line is a
# fixed, committed test credential (the password is "rach2"), not a secret: the
# probes need a known hash to verify against.
dir 0755 /etc
text 0644 /etc/motd Welcome to Rach2 (test image).\n
text 0644 /etc/hostname rach2\n
text 0644 /etc/passwd root:x:0:0:root:/root:/bin/sh\n
text 0600 /etc/shadow root:$6$rach2test$br2Wb86wTtgiPWLN2WQoPqu69kGMNLnIQj3eaZLhG6sNTm9sN6ny.2af9tuaB/2HTw86.N3ZZN585IBoPgi0w/:0:0:99999:7:::\n

text 0644 /hello.txt hello, world\n
text 0644 /resolv.conf nameserver 10.0.2.3\n
text 0644 /hosts 127.0.0.1   localhost\n10.0.2.2    gateway\n10.0.2.3    dns\n10.0.2.15   rach2\n
