# login-test-shell.manifest: the permissive image of `tests/run login`, the
# same as login-test-strict.manifest but for its init, init-shell, which
# starts a shell on the console.
#
# This boot must print uid=0 at the console. `id` is a standalone-ash
# applet, so uid=0 on a console nobody logged in at is a root shell nobody
# authenticated, the fault the strict init removes. This image shows that
# the boot works, so that the strict image's printing nothing means
# something: a strict image that failed to boot for an unrelated reason
# would otherwise pass by printing nothing.
#
# tests/system/suites/login.sh boots this image and the strict one. Host
# paths are relative to the repository root, where mkimage.sh runs.

dir 0755 /bin
file 0755 /bin/busybox build/vendor/busybox/busybox
file 0755 /bin/sh build/vendor/busybox/busybox

dir 0755 /sbin
file 0755 /sbin/init build/utils/sbin/init-shell

# The same /etc as the strict image, so the init each declares is the only
# difference between the two.
dir 0755 /etc
text 0644 /etc/motd login-test-shell\n
text 0644 /etc/hostname rach2\n
text 0644 /etc/passwd root:x:0:0:root:/root:/bin/sh\n
file 0600 /etc/shadow krffs/shadow
text 0644 /etc/group root:x:0:\n
text 0644 /etc/shells /bin/sh\n
text 0644 /etc/profile export PATH=/bin:/usr/bin\n

dir 0755 /root
