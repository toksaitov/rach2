# rach2-recovery.manifest: the recovery system's RAM root, on partition 2 of
# an installed disk, for when the machine's own root will not mount.
#
# It is the metal image with the programs that repair a disk. The kernel it
# boots with is the recovery build, the only one that may write the whole
# disk, and this image mounts nothing from that disk, which is what lets it
# rewrite the root. Everything it needs arrives over SSH or is typed at its
# console, so it has a shell on the console, a server, account files that
# authenticate nobody, the key it was built with if it was built with one,
# the programs that repair a disk (`reflash` for the raw device, `bootctl`
# for the boot partition, `rach2-install` and `rach2-recover` for the root,
# `growroot` with `e2fsck` and `resize2fs` for the file system, and
# `diskctl`, `growset` and `growboot` beside them), and the pages of the
# manual that describe them.

dir 0755 /bin
file 0755 /bin/busybox build/vendor/busybox/busybox
file 0755 /bin/sh build/vendor/busybox/busybox
file 0755 /bin/man krffs/man.script

# Two of the set-id applets come from BusyBox's second build, which has only
# login, passwd and su. `login` is not staged, since this system has no
# login: its init starts a shell on the console. Every account here has `*`
# for a password, so none could log in in any case; `su` and `passwd` stay
# because a person at the shell uses them on the machine being repaired.
file 04755:0:0 /bin/su build/vendor/busybox/busybox-suid
file 04755:0:0 /bin/passwd build/vendor/busybox/busybox-suid

file 0755 /bin/ping build/utils/ping
# dmesg, which prints the kernel's log from /dev/bootlog
# (krffs/dmesg.script).
file 0755 /bin/dmesg krffs/dmesg.script

# The two repair programs. `reflash` writes a declared number of bytes from
# an ssh pipe onto a raw device, which is how a whole root partition
# arrives; `bootctl` repairs the boot partition, the kernel slots and the
# menu, which the metal image leaves out, having no boot partition, while
# this image boots from a disk that has one.
file 0755 /bin/reflash build/utils/reflash
file 0755 /bin/bootctl build/utils/sbin/bootctl
# `growroot` enlarges the root's partition entry into the free space after it
# and runs the checker and the resizer under /sbin on the volume.
file 0755 /bin/growroot build/utils/growroot
file 0755 /bin/growset build/utils/growset
file 0755 /bin/growboot build/utils/growboot
# `diskctl reread` makes the kernel read again the partition table that a
# write of the whole disk has replaced, which an install needs even without
# a grow.
file 0755 /bin/diskctl build/utils/diskctl
# The installer itself, a shell program: it reads the manifest on the stick,
# checks the image against it, asks which disk, writes it and reads it back.
file 0755 /bin/rach2-install utils/rach2-install
# The recovery menu beside it: what the machine has, a file system checked, a
# saved image put back, a kernel installed, and a shell.
file 0755 /bin/rach2-recover utils/rach2-recover

dir 0755 /sbin
# The ext2 checker, for a root that was not unmounted: when the boot line has
# rach2.fsck, init runs it on each ext2 partition before anything else, and
# it can be run by hand over SSH. The resizer beside it is what `growroot`
# runs after it has enlarged the root's partition entry. They are the only
# programs of e2fsprogs here, since checking and growing are the uses
# recovery has for it.
file 0755 /sbin/e2fsck build/vendor/e2fsprogs/e2fsck
file 0755 /sbin/resize2fs build/vendor/e2fsprogs/resize2fs
# The recovery system starts a shell on the console without a login: the
# person who chose this boot has the machine in hand, and the image has none
# of the machine's accounts to check a password against. The installed
# system keeps its login.
#
# init-recovery runs that shell with the network and the optional SSH server
# beside it; init-shell starts no network, and init-metal asks for a login,
# which this image has no password for.
#
# The server runs when this image was built with a key, or when the
# installer put one on the recovery partition. A root cannot be updated from
# the running system, since the kernel refuses to write a partition whose
# file system is mounted, so a recovery system with no key can be updated
# only at its keyboard: right for an image built for somebody else, wrong
# for one built to work on.
file 0755 /sbin/init build/utils/sbin/init-recovery
file 0755 /bin/dropbearmulti build/vendor/dropbear/dropbearmulti
dir 0700 /etc/dropbear
dir 0755 /root
dir 0700 /root/.ssh
# The key, when this build has one, from a file no build makes by itself:
# `krffs/authorized_keys` is made by `gen_demo_key.sh` whenever it is
# missing, while this file exists only once a person, or `make recovery-key`
# with this tree's own keys, has written it. `optional-file` stages it when
# it is there and skips it when it is not, and that decides whether the
# recovery system answers the network.
optional-file 0600 /root/.ssh/authorized_keys krffs/recovery_authorized_keys
# The periodic sync init keeps running: sleep thirty seconds, sync(2), for ever.
file 0755 /bin/update build/utils/update

dir 0755 /etc
text 0644 /etc/motd Rach2 recovery. This machine mounts nothing from the disk it is repairing: /dev/disk0 is the whole drive and reflash writes it.\n
text 0644 /etc/hostname rach2\n
text 0644 /etc/passwd root:x:0:0:root:/root:/bin/sh\ntest:x:1000:1000:test:/home/test:/bin/sh\n
# No stored password: nothing in this image authenticates anybody. The account
# files remain because the tools run as somebody and the shell reads them.
text 0600 /etc/shadow root:*:0:0:99999:7:::\ntest:*:0:0:99999:7:::\n
text 0644 /etc/group root:x:0:\ntest:x:1000:\n
text 0644 /etc/shells /bin/sh\n
# The resolvers the image starts with, which a DHCP lease replaces
# (krffs/udhcpc-default.script). They are public ones and not the gateway,
# since a router need not answer queries itself. utils/resolv.c reads the
# first `nameserver` line, and musl's resolver up to three.
text 0644 /etc/resolv.conf nameserver 1.1.1.1\nnameserver 1.0.0.1\n
text 0644 /etc/hosts 127.0.0.1 localhost\n
text 0644 /etc/profile export PATH=/bin:/usr/bin\nexport HOME="${HOME:-/root}"\ncd "$HOME"\n

# The network configuration `ifup -a` reads, in the file where Debian keeps
# it and BusyBox's ifup reads it. `dhcp` brings the machine up on whatever
# network it is plugged into; a `static` stanza in the same file would give
# it a fixed address instead.
dir 0755 /etc/network
text 0644 /etc/network/interfaces auto eth0\niface eth0 inet dhcp\n    post-up /bin/rescue-static &\n

# What the post-up command above runs: it waits for a lease and takes the
# sealed disk's fixed address if none arrives, so that a machine whose boot
# partition is damaged can be reached on a network with no DHCP server
# (krffs/rescue-static.script).
file 0755 /bin/rescue-static krffs/rescue-static.script

# The four directories `ifup` runs through run-parts. It treats a failure of any
# of them as a failed method, and run-parts on a directory that is not there is
# a failure, so they exist and are empty.
dir 0755 /etc/network/if-pre-up.d
dir 0755 /etc/network/if-up.d
dir 0755 /etc/network/if-down.d
dir 0755 /etc/network/if-post-down.d

dir 0755 /var
# Where init puts what its services print, once the console is the login's.
dir 0755 /var/log
# Where `ifup` records the interfaces it has brought up. It writes the file
# through a temporary beside it, so the directory must exist.
dir 0755 /var/run

dir 0755 /usr
dir 0755 /usr/share
dir 0755 /usr/share/udhcpc
# The script udhcpc runs when a lease arrives or ends, which turns the lease
# into an address, a route and a resolver.
file 0755 /usr/share/udhcpc/default.script krffs/udhcpc-default.script
# The pages man/recovery lists: what the installer and the recovery menu direct
# a person to, readable here with man(1). mancheck requires each.
dir 0755 /usr/share/man
file 0644 /usr/share/man/aliases man/aliases
dir 0755 /usr/share/man/cat7
dir 0755 /usr/share/man/cat8
file 0644 /usr/share/man/cat7/recovery.7 build/man/cat7/recovery.7
file 0644 /usr/share/man/cat8/rach2-install.8 build/man/cat8/rach2-install.8
file 0644 /usr/share/man/cat8/rach2-recover.8 build/man/cat8/rach2-recover.8
file 0644 /usr/share/man/cat8/reflash.8 build/man/cat8/reflash.8
file 0644 /usr/share/man/cat8/bootctl.8 build/man/cat8/bootctl.8
file 0644 /usr/share/man/cat8/growroot.8 build/man/cat8/growroot.8
file 0644 /usr/share/man/cat8/mount.8 build/man/cat8/mount.8
file 0644 /usr/share/man/cat8/netup.8 build/man/cat8/netup.8
file 0644 /usr/share/man/cat8/e2fsck.8 build/man/cat8/e2fsck.8
file 0644 /usr/share/man/cat8/resize2fs.8 build/man/cat8/resize2fs.8
dir 0755 /usr/share/man/cat1
file 0644 /usr/share/man/cat1/man.1 build/man/cat1/man.1


dir 1777 /tmp
dir 0755 /home
dir 0700:1000:1000 /home/test
