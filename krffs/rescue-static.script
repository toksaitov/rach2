#!/bin/sh
#
# rescue-static: take the sealed disk's fixed address when no DHCP lease
# arrives, so that the recovery system can be reached on a network with no
# DHCP server.
#
# The recovery image's /etc/network/interfaces runs this in the background,
# as a `post-up` command of eth0. A machine whose boot partition is damaged
# reaches recovery through the boot loader's own configuration, and there is
# no menu entry to choose there without a person at the keyboard; on a
# network with no DHCP server, this address is the way in.
#
# The lease is waited for once, and the fixed address is taken if none
# arrives. The wait is bounded, and the test is on the address the interface
# has rather than on what the client said, since a client that is still
# asking has said nothing either way.
#
# The address is the sealed disk's fixed one, set in the root Makefile
# (SEALED_ADDRESS, SEALED_MASK, SEALED_GATEWAY); the sealed disk's build
# refuses to write a disk whose script and settings disagree.

sleep 25

ifconfig eth0 | grep -q 'addr:0.0.0.0' || exit 0
echo "rescue: no lease arrived; taking the fixed address" >&2

# The client is stopped before the address is taken: a lease that arrived
# afterwards would replace the address and the route under a session just
# opened to them.
pid=$(cat /var/run/udhcpc.eth0.pid 2>/dev/null)
if [ -n "$pid" ]; then
    kill "$pid" 2>/dev/null
    n=0
    while [ "$n" -lt 10 ] && kill -0 "$pid" 2>/dev/null; do
        sleep 1
        n=$((n + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo "rescue: the DHCP client will not stop; leaving the address alone" >&2
        exit 1
    fi
fi
ifconfig eth0 192.168.0.105 netmask 255.255.255.0 || exit 1
route add default gw 192.168.0.1 || exit 1

echo "rescue: eth0: 192.168.0.105 through 192.168.0.1" >&2
