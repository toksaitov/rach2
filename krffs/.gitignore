# The credentials each tree makes for itself. The key pairs
# rach2_demo_ed25519 and rach2_test_ed25519 are committed, the same in every
# clone; the authorized_keys lists made from them, and the passwords and the
# shadow file of gen_demo_password.sh, are not. What this component builds
# is under build/krffs/, which the top-level .gitignore covers.
authorized_keys
test_authorized_keys
rach2_demo_password
rach2_test_password
shadow
# What gen_demo_password.sh leaves when it is killed part way: its lock
# directory and the shadow file before its rename.
shadow.tmp
.gen_demo_password.lock

# The public keys of whoever works on this machine, which gen_demo_key.sh
# appends to the demo keys, and the recovery system's list that
# gen_recovery_key.sh writes.
authorized_keys.extra
test_authorized_keys.extra
recovery_authorized_keys
