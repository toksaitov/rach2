# Demo credentials: the SSH keypairs from gen_demo_key.sh and the passwords and
# /etc/shadow from gen_demo_password.sh, never committed (each is a host-side
# test credential, referenced as krffs/<name>). Everything this component builds
# (the host tools, the RAM-disk image, the mount point) goes out of tree to
# build/krffs/ (mk/build.mk), covered by the repo-root build/ ignore.
authorized_keys
rach2_demo_ed25519
rach2_demo_ed25519.pub
test_authorized_keys
rach2_test_ed25519
rach2_test_ed25519.pub
rach2_demo_password
rach2_test_password
shadow
# gen_demo_password.sh transients: the lock dir and the pre-rename shadow, left
# behind only if the script is killed mid-run, ignored so a kill cannot dirty
# the tree.
shadow.tmp
.gen_demo_password.lock

# Public keys belonging to whoever works on this machine, appended to the
# demo key by gen_demo_key.sh. Not the project's, so not committed.
authorized_keys.extra
test_authorized_keys.extra
recovery_authorized_keys
