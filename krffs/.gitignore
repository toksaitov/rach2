# Demo credentials: the SSH keypairs from gen_demo_key.sh and the passwords and
# /etc/shadow from gen_demo_password.sh, never committed (each is a host-side
# test credential, referenced as krffs/<name>). Everything this component builds
# (the host tools, the RAM-disk image, the mount point) goes out of tree to
# build/krffs/ (mk/build.mk), covered by the repo-root build/ ignore.
authorized_keys
