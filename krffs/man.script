#!/bin/sh
# man: read a page of this system's manual.
#
# Usage: man [SECTION] NAME
#
# The pages are the preformatted, gzipped texts under /usr/share/man/catN,
# and /usr/share/man/aliases lists the names a page answers for besides
# its own, one `NAME SECTION TARGET` a line. A name is looked up as an alias
# first, then as a page, in the section given or in sections 1, 8, 2, 4, 5
# and 7 in that order. The text goes through the pager on a terminal and
# straight to standard output otherwise. BusyBox's man applet is not built:
# it finds a page only as a file, and a file per alias would put four
# hundred nodes on every root, which the RAM root and a KRFFS disk walk on
# every lookup.
mandir=/usr/share/man
if [ $# -eq 2 ]; then
    sections=$1; name=$2
elif [ $# -eq 1 ]; then
    sections="1 8 2 4 5 7"; name=$1
else
    echo "usage: man [SECTION] NAME" >&2
    exit 2
fi
for section in $sections; do
    target=$(awk -v n="$name" -v s="$section" '$1 == n && $2 == s { print $3; exit }' "$mandir/aliases" 2>/dev/null)
    page="$mandir/cat$section/${target:-$name}.$section"
    if [ -f "$page" ]; then
        if [ -t 1 ]; then
            gunzip -c "$page" | "${MANPAGER:-${PAGER:-less}}"
        else
            gunzip -c "$page"
        fi
        exit $?
    fi
done
echo "man: no page for $name" >&2
exit 1
