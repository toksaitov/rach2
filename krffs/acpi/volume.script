#!/bin/sh
#
# volume: raise, lower or mute the volume, for the volume keys. acpid runs
# this file as /etc/acpi/volume/up, down or mute, with no argument, so the
# key is the name it is run by, or the first argument when there is one.
#
# A step is 5 of mixer's 100. The mute key mutes, or unmutes when the volume
# is muted, and a step up from a mute starts from 0.
#
# The action holds the lock ACPI_LOCK, /var/run/acpi.lock unless it is set,
# from its start to its end, as the brightness action does; mixer, which
# the action ends by, keeps it until it exits. acpid starts an action for
# each key without waiting for the one before, and two steps that read the
# same level would write the same step from it. An empty ACPI_LOCK takes
# no lock. The lock is made mode 0600, so that only root opens it and no
# ordinary process can hold it and stop the keys.

lock=${ACPI_LOCK-/var/run/acpi.lock}
if [ -n "$lock" ]; then
    mask=$(umask)
    umask 077
    exec 9>>"$lock" && flock 9 || exit 1
    umask "$mask"
fi

case ${1:-${0##*/}} in
up)
    exec /bin/mixer vol +5
    ;;
down)
    exec /bin/mixer vol -5
    ;;
mute)
    case $(/bin/mixer vol) in
    *' muted') exec /bin/mixer unmute ;;
    *) exec /bin/mixer mute ;;
    esac
    ;;
*)
    echo "volume: usage: volume up|down|mute" >&2
    exit 2
    ;;
esac
