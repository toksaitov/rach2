#!/bin/sh
#
# dmesg: print the kernel's log.
#
# The log is read from the device /dev/bootlog, whose records have the form
# Linux's `dmesg -r` prints: the level in angle brackets, the seconds since
# boot in square ones, and the text. This script takes the options of
# Linux's dmesg that read the log: the records raw or without their levels,
# with no time or the time of day, of some levels only, with the facility and
# level decoded, and followed as they come. BusyBox's `dmesg` applet, which
# reads the log through the syslog call, is turned off.
#
# The options that change the log, clearing it, resizing it or setting the
# console's level, are refused rather than ignored: this script changes
# nothing, and a caller told nothing would take the change as made.

usage() {
    echo "usage: dmesg [-krtTwx] [-l LEVEL[,LEVEL...]]" >&2
    exit 1
}

raw=0
stamp=keep
decode=0
follow=0
levels=
while [ "$#" -gt 0 ]; do
    case "$1" in
        -r | --raw) raw=1 ;;
        -t | --notime) stamp=none ;;
        -T | --ctime) stamp=ctime ;;
        -x | --decode) decode=1 ;;
        -k | --kernel) ;;
        -w | --follow) follow=1 ;;
        -l | --level)
            [ "$#" -gt 1 ] || usage
            levels=$2
            shift
            ;;
        --level=*) levels=${1#--level=} ;;
        -l?*) levels=${1#-l} ;;
        -[krtTwx][krtTwxl]*)
            rest=${1#-?}
            first=${1%"$rest"}
            shift
            set -- "$first" "-$rest" "$@"
            continue
            ;;
        -c | -C | -D | -E | -n* | -s* | --clear | --read-clear | --console-* | --buffer-size*)
            echo "dmesg: $1: the boot log, /dev/bootlog, is not cleared, resized or given a console level" >&2
            exit 1
            ;;
        *) usage ;;
    esac
    shift
done

if [ "$raw" -eq 1 ] && { [ "$stamp" != keep ] || [ "$decode" -eq 1 ]; }; then
    echo "dmesg: -r is taken with -l alone" >&2
    exit 1
fi
# The fields between the commas, as the formatter splits them, an empty last
# one included, which the shell's splitting drops.
case "$levels" in
    *,)
        echo "dmesg: unknown level ''" >&2
        exit 1
        ;;
esac
ifs=$IFS
IFS=,
for word in $levels; do
    case $(printf '%s' "$word" | tr '[:upper:]' '[:lower:]' | sed 's/^+//; s/+$//') in
        emerg | alert | crit | err | warn | notice | info | debug | [0-7]) ;;
        *)
            echo "dmesg: unknown level '$word'" >&2
            exit 1
            ;;
    esac
done
IFS=$ifs
if [ ! -r /dev/bootlog ]; then
    echo "dmesg: /dev/bootlog: cannot read the log" >&2
    exit 1
fi
btime=$(awk '$1 == "btime" { print $2 }' /proc/stat)

# Print the records on standard input as the options ask.
format() {
    awk -v raw="$raw" -v stamp="$stamp" -v decode="$decode" -v levels="$levels" \
        -v btime="${btime:-0}" '
BEGIN {
    split("emerg alert crit err warn notice info debug", name, " ")
    n = split(levels, want, ",")
    for (i = 1; i <= n; i++) {
        word = tolower(want[i])
        up = sub(/\+$/, "", word)
        down = sub(/^\+/, "", word)
        found = 6
        for (k = 1; k <= 8; k++) {
            if (word == name[k] || word == k - 1 "") {
                found = k - 1
            }
        }
        for (k = up ? 0 : found; k <= (down ? 7 : found); k++) {
            keep[k] = 1
        }
    }
}
{
    line = $0
    level = 6
    if (line ~ /^<[0-7]>/) {
        level = substr(line, 2, 1) + 0
        line = substr(line, 4)
    }
    if (levels != "" && !(level in keep)) {
        next
    }
    if (raw == 1) {
        print $0
        fflush()
        next
    }
    time = ""
    if (match(line, /^\[[ 0-9.]*\] ?/)) {
        time = substr(line, 1, RLENGTH)
        line = substr(line, RLENGTH + 1)
    }
    if (stamp == "none") {
        time = ""
    } else if (stamp == "ctime" && time != "") {
        secs = time
        gsub(/[^0-9.]/, "", secs)
        time = "[" strftime("%a %b %e %H:%M:%S %Y", btime + int(secs)) "] "
    }
    prefix = decode == 1 ? sprintf("%-6s:%-6s: ", "kern", name[level + 1]) : ""
    print prefix time line
    fflush()
}'
}

if [ "$follow" -eq 0 ]; then
    log=$(cat /dev/bootlog) || exit 1
    printf '%s\n' "$log" | format
    exit
fi

# With -w, the log is read again each second and what was not in the read
# before is printed. The ring drops its oldest records as it fills, so a read
# is the one before with some of its first records gone and new ones after:
# the new records begin where the fewest dropped leave the old read's records
# a prefix of the new one's. A read the ring changed while it was taken may
# match no way; then the records after the time of the last one printed are
# the new ones. A failed read, or output that is closed, ends it.
prev=
while :; do
    log=$(cat /dev/bootlog) || exit 1
    printf '%s\n\001\n%s\n' "$prev" "$log" | awk '
function stamp(s) {
    return match(s, /\[[ 0-9.]*\]/) ? substr(s, RSTART + 1, RLENGTH - 2) + 0 : -1
}
$0 == "\001" { part = 1; next }
!part && $0 != "" { old[++olds] = $0; next }
part { new[++news] = $0 }
END {
    for (drop = 0; drop < olds; drop++) {
        same = 1
        for (i = drop + 1; i <= olds && same; i++) {
            same = i - drop <= news && new[i - drop] == old[i]
        }
        if (same) {
            break
        }
    }
    start = olds - drop + 1
    if (olds > 0 && drop == olds) {
        for (last = olds; last > 1 && stamp(old[last]) < 0; last--) {
        }
        for (start = 1; start <= news && stamp(new[start]) <= stamp(old[last]); start++) {
        }
    }
    for (i = start; i <= news; i++) {
        print new[i]
    }
}' | format || exit 1
    { : >>/dev/stdout; } 2>/dev/null || exit 1
    prev=$log
    sleep 1
done
