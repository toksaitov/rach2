#!/bin/sh
#
# dmesg: what this machine has logged since it started.
#
# Linux's `dmesg` reads the kernel's ring buffer through `klogctl`, a system
# call this kernel does not have; the log here is a device, `/dev/bootlog`,
# with a record a line in the form Linux's `dmesg -r` prints: the level in
# angle brackets, the seconds since boot in square ones, and the text. So this
# is the command a person expects, over that device, with Linux's options that
# read the log: the records raw or without their levels, with no time or the
# time of day, of some levels only, with the facility and level decoded, and
# followed as they come. BusyBox's own `dmesg` applet is turned off, since it
# can only fail here.
#
# The options that change the buffer, clearing it, resizing it or setting the
# console's level, are refused rather than ignored: there is no buffer to
# change, and a caller told nothing would take it as changed.

usage() {
    echo "usage: dmesg [-krtTwx] [-l LEVEL[,LEVEL...]]" >&2
    exit 1
}

# The records after the last one printed, from reads of the log a second
# apart. The ring drops its oldest records as it fills, and a reader's offset
# counts from the oldest it holds, so a record is found again by its line,
# and when the ring has dropped it, by its time.
follow_log() {
    last=
    while :; do
        log=$(cat /dev/bootlog) || exit 1
        printf '%s\n' "$log" | awk -v last="$last" '
function stamp(s) {
    return match(s, /\[[ 0-9.]*\]/) ? substr(s, RSTART + 1, RLENGTH - 2) + 0 : -1
}
{ line[NR] = $0 }
END {
    start = 1
    if (last != "") {
        start = 0
        for (i = NR; i >= 1 && !start; i--) {
            if (line[i] == last) {
                start = i + 1
            }
        }
        if (!start) {
            for (start = 1; start <= NR && stamp(line[start]) <= stamp(last); start++) {
            }
        }
    }
    for (i = start; i <= NR; i++) {
        print line[i]
    }
}'
        last=$(printf '%s\n' "$log" | tail -n 1)
        sleep 1
    done
}

raw=0
stamp=keep
decode=0
follow=0
levels=
while [ "$#" -gt 0 ]; do
    case "$1" in
        -r | --raw) raw=1 ;;
        -t | --notime) stamp=none ;;
        -T | --ctime) stamp=ctime ;;
        -x | --decode) decode=1 ;;
        -k | --kernel) ;;
        -w | --follow) follow=1 ;;
        -l | --level)
            [ "$#" -gt 1 ] || usage
            levels=$2
            shift
            ;;
        --level=*) levels=${1#--level=} ;;
        -l?*) levels=${1#-l} ;;
        -[krtTwx][krtTwxl]*)
            rest=${1#-?}
            first=${1%"$rest"}
            shift
            set -- "$first" "-$rest" "$@"
            continue
            ;;
        -c | -C | -D | -E | -n* | -s* | --clear | --read-clear | --console-* | --buffer-size*)
            echo "dmesg: $1: the boot log, /dev/bootlog, is not cleared, resized or given a console level" >&2
            exit 1
            ;;
        *) usage ;;
    esac
    shift
done

if [ "$raw" -eq 1 ] && { [ "$stamp" != keep ] || [ "$decode" -eq 1 ]; }; then
    echo "dmesg: -r is taken with -l alone" >&2
    exit 1
fi
if [ ! -r /dev/bootlog ]; then
    echo "dmesg: /dev/bootlog: cannot read the log" >&2
    exit 1
fi

# The log, and with -w each record after it as it is made.
read_log() {
    if [ "$follow" -eq 1 ]; then
        follow_log
    else
        cat /dev/bootlog
    fi
}

btime=$(awk '$1 == "btime" { print $2 }' /proc/stat)
read_log | awk -v raw="$raw" -v stamp="$stamp" -v decode="$decode" -v levels="$levels" \
    -v btime="${btime:-0}" '
BEGIN {
    split("emerg alert crit err warn notice info debug", name, " ")
    n = split(levels, want, ",")
    for (i = 1; i <= n; i++) {
        word = tolower(want[i])
        up = sub(/\+$/, "", word)
        down = sub(/^\+/, "", word)
        found = -1
        for (k = 1; k <= 8; k++) {
            if (word == name[k] || word == k - 1 "") {
                found = k - 1
            }
        }
        if (found < 0) {
            print "dmesg: unknown level \047" want[i] "\047" > "/dev/stderr"
            exit 1
        }
        for (k = up ? 0 : found; k <= (down ? 7 : found); k++) {
            keep[k] = 1
        }
    }
}
{
    line = $0
    level = 6
    if (line ~ /^<[0-7]>/) {
        level = substr(line, 2, 1) + 0
        line = substr(line, 4)
    }
    if (levels != "" && !(level in keep)) {
        next
    }
    if (raw == 1) {
        print $0
        fflush()
        next
    }
    time = ""
    if (match(line, /^\[[ 0-9.]*\] ?/)) {
        time = substr(line, 1, RLENGTH)
        line = substr(line, RLENGTH + 1)
    }
    if (stamp == "none") {
        time = ""
    } else if (stamp == "ctime" && time != "") {
        secs = time
        gsub(/[^0-9.]/, "", secs)
        time = "[" strftime("%a %b %e %H:%M:%S %Y", btime + int(secs)) "] "
    }
    prefix = decode == 1 ? sprintf("%-6s:%-6s: ", "kern", name[level + 1]) : ""
    print prefix time line
    fflush()
}'
