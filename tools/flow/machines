# machines: the settings of the whole runs that a release makes besides the
# run of full.yml on Ubuntu in WSL, read by tools/flow/release.sh. A line is
# MACHINE NAME VALUE. An `env` line sets a variable of the run, and a `path`
# line puts a directory before the run's PATH, in the order of the lines.

# Until the owner says otherwise, the release's full run is WSL's alone: the
# line below gives every start of release.sh -o, which leaves out the Mac and
# Windows. A check that needs one of them runs there by hand. Remove the line
# to run their full suites again.
release full wsl

# The Mac, which runs release.sh: QEMU under TCG, in the copy and the
# admission site under build/machines/mac of the clone that runs it. Its
# guests share 14 GiB of its 24.
mac accel tcg
mac path /opt/homebrew/bin
mac env RACH2_WORKERS=8
mac env RACH2_MEMORY_MIB=14336
mac env RACH2_CPUS=2
mac env JOBS=8

# Windows on the testing host, through `ssh testing` and MSYS2's bash: QEMU
# under WHPX, with the copy `tree`, the runs' directory `out` and the
# protected admission site `site`. The corrected QEMU of
# tools/setup/qemu-whpx is in the copy's build/qemu, and its tooling machine
# in build/tooling, etude's default there.
windows accel whpx
windows tree D:/rach2
windows out D:/rach2/build/release
windows site C:/ProgramData/rach2/etude-site
windows path /d/rach2/build/qemu
windows path /ucrt64/bin
windows path /usr/bin
windows env JOBS=30
windows env HOSTCC=/ucrt64/bin/gcc
windows env RACH2_WORKERS=16
windows env RACH2_MEMORY_MIB=122880
windows env RACH2_CPUS=2
windows env RACH2_OVMF_CODE=/d/rach2/build/qemu/share/edk2-x86_64-code.fd
windows env USERCHECK_CLANG=D:/rach2/build/host-tools/llvm-21.1.8/bin/clang.exe
windows env USERCHECK_SYSTEM_PATH=C:/Windows/System32

# The Lenovo: the native cases on its trial boot, which native-deploy starts
# from the Mac on the machine's network; `peer` is that address, or `route`
# for the one release.sh reads off the route to the machine. The other values
# are the options of `native-deploy run` of the same names
# (tests/native/Readme.md).
lenovo target /var/native
lenovo peer route
lenovo echo-port 55090
lenovo network 192.168.0.106/24
lenovo interface eth0
lenovo gateway 192.168.0.1
lenovo far 1.1.1.1
lenovo empty 192.168.0.250
lenovo silent 192.168.0.252
