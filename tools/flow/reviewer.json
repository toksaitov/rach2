{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "complete", "unreviewed", "findings"],
  "properties": {
    "summary": {"type": "string"},
    "complete": {"type": "boolean"},
    "unreviewed": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "severity", "file", "line", "claim", "evidence", "fix"],
        "properties": {
          "title": {"type": "string"},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "claim": {"type": "string"},
          "evidence": {"type": "string"},
          "fix": {"type": "string"}
        }
      }
    }
  }
}
