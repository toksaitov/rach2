# cppcheck.suppress: the cppcheck suppressions of the style check,
# tools/verify/check.sh, and the slow analysers, tools/verify/analyze.sh.
#
# Each entry is a deliberate exception with its reason; a fault cppcheck finds
# is fixed in the code and is not listed here. A bare id suppresses a rule
# everywhere, where the tree's conventions contradict it. An id:*path entry
# suppresses a rule in one file and keeps it in force in every other.

# The tree's conventions.

# C89 requires declarations at the top of a block, and the tree does not move
# a declaration into an inner block to narrow its scope.
variableScope

# Syscall handlers are installed in a function-pointer dispatch table, so their
# signature is fixed; cppcheck's own message for the rule says that a `const`
# there would need a cast.
constParameterCallback

# The kernel's C89 interfaces take their pointers without `const`, and are not
# changed to add it.
constParameterPointer
constVariablePointer

# The HDA driver and the audio self-test.

# Intentional `field | 0` idiom documenting an all-fields register composition.
badBitmaskCheck:*sys/audio/hda.c
# A variable is initialised where it is declared and assigned again before it
# is read, and a debug switch such as `hda_probe_log_enabled` is fixed when
# the kernel is built: cppcheck reports the first value as unused or as
# initialised twice, and the switch's test as constant.
unreadVariable:*sys/audio/hda.c
unreadVariable:*sys/audio/audio_debug.c
redundantInitialization:*sys/audio/hda.c
knownConditionTrueFalse:*sys/audio/hda.c
knownConditionTrueFalse:*sys/audio/audio_debug.c

# Inline assembly cppcheck does not model.

# krandom_seed's `rdtsc` writes lo (eax) and hi (edx) via inline asm; cppcheck
# cannot see that and treats them as the identical zero-initialized value.
duplicateExpression:*sys/lib/krandom.c

# The ABI layout structs in the timestamp probes.

# `struct old_stat` in these two mirrors the kernel's `struct linux_stat` field
# for field, because musl never issues that call on i386 and the probes ask for
# it by number. Members nothing reads are the layout, not dead code.
unusedStructMember:*tests/musl/statmusl.c
unusedStructMember:*tests/musl/stampmusl.c

# `struct rusage32` in the ptrace probe is the i386 kernel's rusage, which the
# raw wait4 writes whole; the probe reads the user time alone, and the members
# after it are the layout.
unusedStructMember:*tests/musl/ptracemusl.c

# `struct wkalrm` in the calls probe is Linux's struct rtc_wkalrm, which
# RTC_WKALM_SET and RTC_WKALM_RD copy whole; the probe reads `enabled` and the
# time, and the members after them are the layout.
unusedStructMember:*tests/musl/callsmusl.c

# The kernel's copies of Linux's structures.

# The i386 and x86-64 signal frames, statx, the rusage, the siginfo a wait
# fills, sysinfo's record, the ifreq and rtentry the interface calls take and
# the notes of a core file are Linux's layouts, copied to or from the user
# whole: a member nothing here reads is the layout, not dead code.
unusedStructMember:*sys/arch/i686/sigframe.c
unusedStructMember:*sys/arch/x86_64/sigframe.c
unusedStructMember:*sys/syscall.c
unusedStructMember:*sys/syscall_fs.c
unusedStructMember:*sys/syscall_proc.c
unusedStructMember:*sys/network/netif.c
unusedStructMember:*sys/proc/coredump.c

# k_itoa gives a base other than ten the int's 32 bits as unsigned: on
# x86-64 that is a different long, and on i686, where a long is an int's
# width, the same one, which cppcheck reports as a redundant assignment.
redundantAssignment:*sys/lib/kstd.c

# The i686 signal frame's room is the larger of the two frames, a test of two
# sizes the compiler knows, which cppcheck calls constant.
knownConditionTrueFalse:*sys/arch/i686/sigframe.c

# A user page's entry is composed with PTE_NOEXEC, which is 0 on i686, whose
# tables without PAE have no execute bit; x86-64's TSS descriptor is composed
# field by field, and the limit's high bits are 0 for a TSS of this size.
badBitmaskCheck:*sys/mm/paging.c
badBitmaskCheck:*sys/arch/x86_64/percpu.c

# System V IPC's 64-bit records and POSIX queues' struct mq_attr, copied to
# and from the user whole: the padding and the members kept for the layout
# are not dead code.
unusedStructMember:*sys/ipc/sysv.c
unusedStructMember:*sys/ipc/mqueue.c

# fp_access keeps the floating-point image in the 16-byte-aligned part of a
# buffer, which it writes through the aligned pointer cppcheck does not follow.
unassignedVariable:*sys/proc/ptrace.c

# A receive notes the queue's generation, then faults the user's pages in,
# which sleeps; another receiver may take the queue meanwhile, which is what
# the second test of the generation finds. cppcheck does not know the fault-in
# sleeps, so it calls the test constant.
knownConditionTrueFalse:*sys/ipc/unix.c

# The guest programs.

# main's argv has the type the C standard gives it: cppcheck asks for
# `const char *argv[]`, which is not the signature a hosted C program's main
# has.
constParameter:*tests/musl/execargmusl.c

# The budget test holds descriptors rather than reading them: the value of the
# second socket is what keeps it drawn from the pool the test measures.
unreadVariable:*tests/musl/budgetmusl.c

# cppcheck's library marks raise() and abort() as never returning. abort()
# does not return, and the `_exit` after it is there for a reader; raise() of
# a blocked signal returns to its caller, which is the case the test covers,
# and so does a raise() whose signal a handler takes or a tracer resumes.
unreachableCode:*tests/musl/sigmusl.c
unreachableCode:*tests/musl/ptracemusl.c
unreachableCode:*tests/musl/sigframemusl.c

# ptrace takes the word it stores in its pointer argument.
intToPointerCast:*tests/musl/ptracemusl.c

# A fault handler makes a page writable and the store runs again, and a
# fork's child reads what its parent stored before the fork: each test reads
# what the kernel under test did, which cppcheck takes as a constant.
knownConditionTrueFalse:*tests/musl/sigframemusl.c
knownConditionTrueFalse:*tests/musl/mapmusl.c

# Linux's struct stat64 and struct rusage, laid out member for member for a
# call the probe makes by number.
unusedStructMember:*tests/musl/fdcallmusl.c
unusedStructMember:*tests/musl/waitidmusl.c

# The probes reach the kernel through inline assembly, which cppcheck does not
# read, so an array a system call fills looks to it like one nothing writes.
# The framebuffer palette in devprobe is the other half of that: 768 bytes of
# zeroes is what the row hands the kernel, so nothing assigns it here.
constVariable:*tests/bootprobe.c
constVariable:*tests/devprobe.c
constVariable:*tests/exitprobe.c
constVariable:*tests/loopdevprobe.c
constVariable:*tests/sigprobe.c
unassignedVariable:*tests/devprobe.c
unassignedVariable:*tests/loopprobe.c
unassignedVariable:*tests/procprobe.c
unassignedVariable:*tests/sigprobe.c

# The limit and pty probes give the kernel Linux's struct sigaction, whose
# members the probes set in an initializer and the kernel reads.
unusedStructMember:*tests/limitprobe.c
unusedStructMember:*tests/ptyprobe.c

# The XSAVE probe's cpuid writes its four registers into its array through
# inline assembly, which cppcheck does not follow.
constParameter:*tests/xsaveprobe.c

# The interface probe reads a length the kernel writes through a pointer it
# passes as an integer in the socketcall argument block, so cppcheck sees only
# the initial `sizeof` and calls every later test of it constant. The probe is
# freestanding and has no libc, so it clears a structure with a byte loop.
knownConditionTrueFalse:*tests/netifprobe.c
useStandardLibrary:*tests/netifprobe.c

# The host programs: tools/, tests/system/ and krffs/.

# The vendored terminal library fsviz includes is not this project's code.
*:*krffs/vendor/*

# The on-disk node and file system layouts, and the fixture's copy of the
# kernel's VFS structures for the source it compiles: members the tools read
# in other translation units, or that the layout requires, are the format,
# not dead code.
unusedStructMember:*krffs/krffs_node.h
unusedStructMember:*krffs/krffs_file_system.h
unusedStructMember:*tests/system/fixtures/vfs_unmount.c

# The index entries are a `char [][128]` array; C does not convert a pointer
# to such an array to one with `const` inside, so the parameter cppcheck asks
# for would need a cast at every call.
constParameter:*tools/verify/prosecheck.c

# `struct insn` in the seccomp probe is Linux's struct sock_filter, a BPF
# instruction the probe writes in initializers and the kernel reads; no
# member is read by name.
unusedStructMember:*tests/musl/seccompmusl.c
