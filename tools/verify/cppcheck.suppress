# cppcheck.suppress: the cppcheck suppressions of the style check,
# tests/cases/host/style.sh, and the slow analysers, tools/verify/analyze.sh.
#
# Each entry is a deliberate exception with its reason; a fault cppcheck finds
# is fixed in the code and is not listed here. A bare id suppresses a rule
# everywhere, where the tree's conventions contradict it. An id:*path entry
# suppresses a rule in one file and keeps it in force in every other.

# The tree's conventions.

# C89 requires declarations at the top of a block, and the tree does not move
# a declaration into an inner block to narrow its scope.
variableScope

# Syscall handlers are installed in a function-pointer dispatch table, so their
# signature is fixed; cppcheck's own message for the rule says that a `const`
# there would need a cast.
constParameterCallback

# The kernel's C89 interfaces take their pointers without `const`, and are not
# changed to add it.
constParameterPointer
constVariablePointer

# The HDA driver and the audio self-test.

# Intentional `field | 0` idiom documenting an all-fields register composition.
badBitmaskCheck:*sys/audio/hda.c
# A variable is initialised where it is declared and assigned again before it
# is read, and a debug switch such as `hda_probe_log_enabled` is fixed when
# the kernel is built: cppcheck reports the first value as unused or as
# initialised twice, and the switch's test as constant.
unreadVariable:*sys/audio/hda.c
unreadVariable:*sys/audio/audio_debug.c
redundantInitialization:*sys/audio/hda.c
knownConditionTrueFalse:*sys/audio/hda.c
knownConditionTrueFalse:*sys/audio/audio_debug.c

# Inline assembly cppcheck does not model.

# krandom_seed's `rdtsc` writes lo (eax) and hi (edx) via inline asm; cppcheck
# cannot see that and treats them as the identical zero-initialized value.
duplicateExpression:*sys/lib/krandom.c

# The ABI layout structs in the timestamp probes.

# `struct old_stat` in these two mirrors the kernel's `struct linux_stat` field
# for field, because musl never issues that call on i386 and the probes ask for
# it by number. Members nothing reads are the layout, not dead code.
unusedStructMember:*tests/musl/statmusl.c
unusedStructMember:*tests/musl/stampmusl.c

# `struct rusage32` in the ptrace probe is the i386 kernel's rusage, which the
# raw wait4 writes whole; the probe reads the user time alone, and the members
# after it are the layout.
unusedStructMember:*tests/musl/ptracemusl.c

# `struct wkalrm` in the calls probe is Linux's struct rtc_wkalrm, which
# RTC_WKALM_SET and RTC_WKALM_RD copy whole; the probe reads `enabled` and the
# time, and the members after them are the layout.
unusedStructMember:*tests/musl/callsmusl.c

# `struct input_event` and `struct mixer_info` in the event probe are Linux's,
# which a read of an event device and SOUND_MIXER_INFO fill whole; the probe
# reads an event's type, code and value and the info's id and name, and the
# members around them are the layout.
unusedStructMember:*tests/evprobe.c

# `struct kernel_termios` in the key latency probe is Linux's, which TCGETS
# and TCSETS copy whole; the probe changes the input and local flags and two
# control characters, and the members between them are the layout.
unusedStructMember:*tests/keylatprobe.c

# `struct drm_mode_modeinfo` in the DRM probe is Linux's, which GETCONNECTOR
# fills and SETCRTC and GETCRTC copy whole; the probe compares and prints
# some members, and the rest are the layout.
unusedStructMember:*tests/drmprobe.c

# The kernel's copies of Linux's structures.

# The i386 and x86-64 signal frames, statx, the rusage, the siginfo a wait
# fills, sysinfo's record, the ifreq and rtentry the interface calls take and
# the notes of a core file are Linux's layouts, copied to or from the user
# whole: a member nothing here reads is the layout, not dead code.
unusedStructMember:*sys/arch/i686/sigframe.c
unusedStructMember:*sys/arch/x86_64/sigframe.c
unusedStructMember:*sys/syscall.c
unusedStructMember:*sys/syscall_fs.c
unusedStructMember:*sys/syscall_proc.c
unusedStructMember:*sys/network/netif.c
unusedStructMember:*sys/proc/coredump.c

# `struct mixer_info` is OSS's, which SOUND_MIXER_INFO copies to the user
# whole; its `fillers` are the layout's reserved words, zero on the way out.
unusedStructMember:*sys/audio/mixer.c

# k_itoa gives a base other than ten the int's 32 bits as unsigned: on
# x86-64 that is a different long, and on i686, where a long is an int's
# width, the same one, which cppcheck reports as a redundant assignment.
redundantAssignment:*sys/lib/kstd.c

# The i686 signal frame's room is the larger of the two frames, a test of two
# sizes the compiler knows, which cppcheck calls constant.
knownConditionTrueFalse:*sys/arch/i686/sigframe.c

# A user page's entry is composed with PTE_NOEXEC, which is 0 on i686, whose
# tables without PAE have no execute bit; x86-64's TSS descriptor is composed
# field by field, and the limit's high bits are 0 for a TSS of this size.
badBitmaskCheck:*sys/mm/paging.c
badBitmaskCheck:*sys/arch/x86_64/percpu.c

# System V IPC's 64-bit records and POSIX queues' struct mq_attr, copied to
# and from the user whole: the padding and the members kept for the layout
# are not dead code.
unusedStructMember:*sys/ipc/sysv.c
unusedStructMember:*sys/ipc/mqueue.c

# fp_access keeps the floating-point image in the 16-byte-aligned part of a
# buffer, which it writes through the aligned pointer cppcheck does not follow.
unassignedVariable:*sys/proc/ptrace.c

# A request that waits for the wireless worker links a hop on its own stack
# into its station's list, which the worker, or nl80211_detach, unlinks
# before the request wakes and returns. nl80211_detach cancels each hop's
# work, which waits for a running hop and so may unlink it; cppcheck, which
# does not know the cancel waits, calls the test of the list's head constant.
autoVariables:*sys/network/wireless/nl80211.c
knownConditionTrueFalse:*sys/network/wireless/nl80211.c

# A receive notes the queue's generation, then faults the user's pages in,
# which sleeps; another receiver may take the queue meanwhile, which is what
# the second test of the generation finds. cppcheck does not know the fault-in
# sleeps, so it calls the test constant.
knownConditionTrueFalse:*sys/ipc/unix.c
# A read of a /proc file notes its snapshot's generation and copies a piece
# to the user, which may sleep in a fault while a sharer makes the snapshot
# again; the next test of the generation finds that, and cppcheck, which does
# not know the copy sleeps, calls it constant.
knownConditionTrueFalse:*sys/fs/procfs.c

# The guest programs.

# main's argv has the type the C standard gives it: cppcheck asks for
# `const char *argv[]`, which is not the signature a hosted C program's main
# has.
constParameter:*tests/musl/execargmusl.c

# The budget test holds descriptors rather than reading them: the value of the
# second socket is what keeps it drawn from the pool the test measures.
unreadVariable:*tests/musl/budgetmusl.c

# cppcheck's library marks raise() and abort() as never returning. abort()
# does not return, and the `_exit` after it is there for a reader; raise() of
# a blocked signal returns to its caller, which is the case the test covers,
# and so does a raise() whose signal a handler takes or a tracer resumes.
unreachableCode:*tests/musl/sigmusl.c
unreachableCode:*tests/musl/ptracemusl.c
unreachableCode:*tests/musl/sigframemusl.c

# ptrace takes the word it stores in its pointer argument.
intToPointerCast:*tests/musl/ptracemusl.c
# The pidfd probe passes the address 1 for a siginfo, which no process maps,
# so that the kernel's copy of it fails with EFAULT.
intToPointerCast:*tests/musl/pidfdmusl.c

# A fault handler makes a page writable and the store runs again, and a
# fork's child reads what its parent stored before the fork: each test reads
# what the kernel under test did, which cppcheck takes as a constant.
knownConditionTrueFalse:*tests/musl/sigframemusl.c
knownConditionTrueFalse:*tests/musl/mapmusl.c

# The probes report a branch by the architecture they are built for, and the
# 32-bit pass reads the x86-64 branch's condition as a constant.
knownConditionTrueFalse:*tests/musl/execargmusl.c
knownConditionTrueFalse:*tests/musl/statmusl.c

# `passed` reports the assertion that held and returns 0, so that it stands
# between the checks of a chain joined by `||`.
knownConditionTrueFalse:*tests/musl/ptracemusl.c

# Linux's struct stat64, struct rusage and struct clone_args, laid out member
# for member for a call the probe makes by number.
unusedStructMember:*tests/musl/fdcallmusl.c
unusedStructMember:*tests/musl/pidfdmusl.c
unusedStructMember:*tests/musl/waitidmusl.c
# Linux's struct sockaddr_nl, which bind and getsockname of a netlink socket
# copy whole; the probe sets the family and the groups, and the members
# between are the layout.
unusedStructMember:*tests/musl/ndwatchmusl.c

# The probes and tools/audio/resamplebench.c reach the kernel through inline
# assembly, which cppcheck does not read, so an array a system call fills
# looks to it like one nothing writes.
# The framebuffer palette in devprobe is the other half of that: 768 bytes of
# zeroes is what the row hands the kernel, so nothing assigns it here.
constVariable:*tests/bootprobe.c
constVariable:*tests/devprobe.c
constVariable:*tests/exitprobe.c
constVariable:*tests/limitprobe.c
constVariable:*tests/lockwaitprobe.c
constVariable:*tests/loopdevprobe.c
constVariable:*tests/sigprobe.c
constVariable:*tools/audio/resamplebench.c
unassignedVariable:*tests/devprobe.c
unassignedVariable:*tests/loopprobe.c
unassignedVariable:*tests/procprobe.c
unassignedVariable:*tests/sigprobe.c

# The limit and pty probes give the kernel Linux's struct sigaction, whose
# members the probes set in an initializer and the kernel reads.
unusedStructMember:*tests/limitprobe.c
unusedStructMember:*tests/ptyprobe.c

# The XSAVE probe's cpuid writes its four registers into its array through
# inline assembly, which cppcheck does not follow.
constParameter:*tests/xsaveprobe.c

# The interface probe reads a length the kernel writes through a pointer it
# passes as an integer in the socketcall argument block, so cppcheck sees only
# the initial `sizeof` and calls every later test of it constant. The probe is
# freestanding and has no libc, so it clears a structure with a byte loop.
knownConditionTrueFalse:*tests/netifprobe.c
useStandardLibrary:*tests/netifprobe.c
# The raw socket probe likewise reads a socket option the kernel writes
# through an address it passes as an integer in the socketcall argument
# block, so cppcheck calls the test of the value read constant.
knownConditionTrueFalse:*tests/rawprobe.c

# The host programs: tools/, tests/system/ and krffs/.

# The vendored terminal library fsviz includes is not this project's code.
*:*krffs/vendor/*

# The on-disk node and file system layouts, and the fixture's copy of the
# kernel's VFS structures for the source it compiles: members the tools read
# in other translation units, or that the layout requires, are the format,
# not dead code.
unusedStructMember:*krffs/krffs_node.h
unusedStructMember:*krffs/krffs_file_system.h
unusedStructMember:*tests/system/fixtures/vfs_unmount.c

# The interface of etude's remote execution: posix/responder.c, checked alone,
# fills the responder's configuration and reads none of the structures that
# serve.c and remote.c read.
unusedStructMember:*tools/etude/include/etude/remote.h

# The index entries are a `char [][128]` array; C does not convert a pointer
# to such an array to one with `const` inside, so the parameter cppcheck asks
# for would need a cast at every call.
constParameter:*tools/verify/prosecheck.c

# `struct insn` in the seccomp probe is Linux's struct sock_filter, a BPF
# instruction the probe writes in initializers and the kernel reads; no
# member is read by name.
unusedStructMember:*tests/musl/seccompmusl.c

# `struct etude_termination` is the interface that libetude-case fills and
# machine scenarios read; cppcheck judges the header as a file of its own and
# finds no reader of its members.
unusedStructMember:*tools/etude/include/etude/scenario.h

# cppcheck checks these headers alone as well as their C users. Every member
# is used by history.c, history_json.c, history_collect.c or their host test.
unusedStructMember:*tools/etude/history_json.h
unusedStructMember:*tools/etude/include/etude/history.h

# The context and load headers are also checked alone. Their C implementations
# and collection callers read these fields when preparing and observing a run.
unusedStructMember:*tools/etude/measurement_context.h
unusedStructMember:*tools/etude/observe_history.h
unusedStructMember:*tools/etude/observe_scope.h
unusedStructMember:*tools/etude/observe_system.h

# launch.h is also checked alone; launch.c and launch_make.c read and set the
# members of `struct launch_jobs`.
unusedStructMember:*tools/etude/launch.h

# The headers of the executor, the QEMU launcher, the watchdog, the ledger,
# the schedule, the artifact store and the serial controller declare the
# structures that their sources and their callers fill and read. cppcheck judges each header as a
# file of its own, apart from the sources that include it, and finds no
# reader of a member.
unusedStructMember:*tools/etude/include/etude/exec.h
unusedStructMember:*tools/etude/include/etude/qemu.h
unusedStructMember:*tools/etude/capture.h
unusedStructMember:*tools/etude/posix/posix.h
unusedStructMember:*tools/etude/include/etude/ledger.h
unusedStructMember:*tools/etude/include/etude/watchdog.h
unusedStructMember:*tools/etude/include/etude/sched.h
unusedStructMember:*tools/etude/cost.h
unusedStructMember:*tools/etude/include/etude/artifact.h
unusedStructMember:*tools/etude/serial.h

# The repetitions' structures: cppcheck checks repeat.h alone, and its members
# are read in repeat.c, posix/repeat.c, posix/load.c and their host test.
unusedStructMember:*tools/etude/include/etude/repeat.h

# These collection headers are also checked alone. Their fields are read by
# collection_load.c, collection_repeat.c, collection.c and posix/legacy_set.c.
unusedStructMember:*tools/etude/collection_load.h
unusedStructMember:*tools/etude/collection_repeat.h

# The options of the preparation adapter and the set driver: cppcheck checks
# legacy.h alone, and its members are read in posix/legacy.c,
# posix/legacy_set.c, posix/run_suites.c and their host tests.
unusedStructMember:*tools/etude/include/etude/legacy.h

# The set driver's cases: cppcheck checks legacy_cases.h alone, and its
# members are read in posix/legacy_cases.c and posix/legacy_set.c.
unusedStructMember:*tools/etude/posix/legacy_cases.h

# The set driver's guest attempts: cppcheck checks legacy_guest.h alone, and
# its members are read in posix/legacy_guest.c and posix/legacy_set.c.
unusedStructMember:*tools/etude/posix/legacy_guest.h

# The shared structures of `etude check`: cppcheck checks each header alone,
# and the members are read in the validator's .c files and the QEMU launcher.
unusedStructMember:*tools/etude/check.h
unusedStructMember:*tools/etude/json.h
unusedStructMember:*tools/etude/include/etude/processor.h

# The comparison's structures: cppcheck checks compare.h alone, and its
# members are read in compare.c, baseline.c, compare_report.c and compare_run.c.
unusedStructMember:*tools/etude/compare.h

# The budget's structures: cppcheck checks budget.h alone, and its members
# are read in budget.c, budget_run.c and their host test.
unusedStructMember:*tools/etude/budget.h

# The Windows adapter's structures are filled by winexec.c and read by
# winfixture.c, which cppcheck reads without the Windows headers they need;
# checked alone, the header has no reader of its members.
unusedStructMember:*tools/etude/win/winexec.h

# The frame codec's structure: cppcheck checks wire.h alone, and its members
# are read in guest.c, wire.c and the host test.
unusedStructMember:*tools/etude/guest/wire.h

# The native fixtures' structures: cppcheck checks fixture.h alone, and its
# members are read in fixture.c, guest.c and the guest's host test.
unusedStructMember:*tools/etude/guest/fixture.h

# The attempt owner's shared state is read by owner.c and guest.c. The
# header is also checked alone, where those member readers are absent.
unusedStructMember:*tools/etude/guest/owner.h

# The bridge's request is a public structure read in posix/bridge.c and
# posix/admit.c, beyond the header's own analysis unit.
unusedStructMember:*tools/etude/include/etude/bridge.h

# The host and port locks' structures: cppcheck checks portlock.h alone, and
# its members are read in portlock.c, posix/bridge.c and lock_ports.c.
unusedStructMember:*tools/etude/include/etude/portlock.h

# The tooling machine's structures: cppcheck checks tooling.h alone, and its
# members are read in tooling.c, provision_tooling.c and their test.
unusedStructMember:*tools/etude/include/etude/tooling.h

# The status record's structures: cppcheck checks status.h alone, and its
# members are read in posix/status.c and its host test.
unusedStructMember:*tools/etude/include/etude/status.h

# The hold's process identity: cppcheck checks hold.h alone, and its members
# are read in lock_tree.c, posix/hold.c and win/hold.c.
unusedStructMember:*tools/etude/hold.h

# The native file-status and directory records are public across translation
# units; their fields are read by the shared store and collection driver.
unusedStructMember:*tools/etude/win/files.h

# The fake API exports these structures across translation units. The source
# list also checks headers alone: api.h members are used by server.c,
# protocols.c, responses.c and worker.c; json.h members are used by json.c.
unusedStructMember:*tests/system/fakeapi/native/api.h
unusedStructMember:*tests/system/fakeapi/native/json.h

# The native attempt records are shared by posix/run_native.c and the native
# collection adapter in tests/native/{attempt,collection,proof}.c.
unusedStructMember:*tools/etude/include/etude/native.h

# These headers are also analysed alone. All implementations are already in
# srclists.sh; a standalone header has no member readers. The phase, binding,
# state and authority members are read by authority.c/authority_parse.c. File
# identity and gate members are read by authority.c and both platform adapters.
# The remaining invocation fields are read by authority_run.c; its unused
# metadata fields were removed rather than suppressed.
unusedStructMember:*tools/etude/authority.h
unusedStructMember:*tools/etude/authority_internal.h
unusedStructMember:*tools/etude/authority_platform.h
unusedStructMember:*tools/etude/authority_run.h

# routine_charge.c reads every routine input and writes the cost fields;
# budget_prepare.c/budget_run.c/verdict_budget.c read those results.
# routine_owner.c reads every owner field, including the direct phase state.
unusedStructMember:*tools/etude/routine_charge.h
unusedStructMember:*tools/etude/routine_owner.h

# The host check inventory, native preparation, preparation import, retention
# and routine input headers are also checked alone. Their members are read by
# host_prepare*.c, native_prepare*.c, preparation_import*.c, retention*.c and
# reference.c, and routine_*.c.
unusedStructMember:*tools/etude/host_prepare.h
unusedStructMember:*tools/etude/native_prepare.h
unusedStructMember:*tools/etude/preparation_import.h
unusedStructMember:*tools/etude/retention.h
unusedStructMember:*tools/etude/routine_entry.h
