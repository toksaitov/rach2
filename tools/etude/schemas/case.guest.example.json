    {
      "case_id": "guest.default.rngprobe",
      "behavior": "The random devices give varied bytes from a trusted source and refuse to read without one",
      "units": ["rngprobe"],
      "domain": "guest",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {}, "repetitions": 1, "seed": null},
      "requirements": {
        "host_api": "c", "tools": [], "features": {"rdrand": "either", "rdseed": "either"},
        "qemu": {"kernel": "kernel", "initrd": "test-image", "disks": [], "cpu": "max", "processors": 1,
                 "memory_bytes": 134217728, "firmware": "direct", "devices": ["rtl8139"], "boot_options": []}
      },
      "execution": {
        "program": "rngprobe", "stdin": null, "role": "ordinary", "privileges": "any",
        "isolation": [], "children": "none", "cleanup": "nothing to remove"
      },
      "assertions": [
        {"assertion_id": "cpuid-leaf7", "checks": "kcpu_id gives leaf 7 subleaf 0 as a direct cpuid does", "source": "program"},
        {"assertion_id": "trusted-urandom", "checks": "with getrandom succeeding, /dev/urandom opens, reads and varies across reads", "source": "program"},
        {"assertion_id": "trusted-monobit", "checks": "the bytes of /dev/urandom pass a loose monobit count", "source": "program"},
        {"assertion_id": "closed-urandom", "checks": "with getrandom answering EIO, a read of /dev/urandom answers EIO", "source": "program"},
        {"assertion_id": "closed-random", "checks": "with getrandom answering EIO, a read of /dev/random answers EIO", "source": "program"},
        {"assertion_id": "closed-insecure", "checks": "getrandom(GRND_INSECURE) still returns bytes", "source": "program"}
      ],
      "branches": [
        {"group_id": "source", "decided_by": {"features": ["rdrand", "rdseed"]},
         "alternatives": [
           {"alternative_id": "trusted", "when": "present", "assertions": ["trusted-urandom", "trusted-monobit"]},
           {"alternative_id": "fail-closed", "when": "absent", "assertions": ["closed-urandom", "closed-random", "closed-insecure"]}
         ]}
      ],
