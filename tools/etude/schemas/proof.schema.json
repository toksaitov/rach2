{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Etude mutation proof, version 1",
  "description": "The catalogue of one proof: the sources its faults change, the build of its artifacts, the test, and each fault with the failure the test must give; see tools/etude/Readme.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proof", "summary", "tree", "sources", "artifacts", "build", "test", "faults"],
  "properties": {
    "schema_version": {"const": 1},
    "proof": {"$ref": "#/$defs/name"},
    "summary": {"$ref": "#/$defs/text"},
    "tree": {"enum": ["private", "shared"]},
    "sources": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/path"}
    },
    "artifacts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "build": {"$ref": "#/$defs/command"},
    "test": {
      "allOf": [{"$ref": "#/$defs/command"}],
      "properties": {
        "argv": true,
        "bound_s": true,
        "fail_prefix": {"$ref": "#/$defs/text"}
      },
      "additionalProperties": false
    },
    "faults": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "summary", "edits", "fails"],
        "properties": {
          "name": {"$ref": "#/$defs/name"},
          "summary": {"$ref": "#/$defs/text"},
          "edits": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["file", "find", "replace"],
              "properties": {
                "file": {"$ref": "#/$defs/path"},
                "find": {"type": "string", "minLength": 1},
                "replace": {"type": "string"}
              }
            }
          },
          "fails": {
            "type": "object", "additionalProperties": false,
            "required": ["lines"],
            "properties": {
              "status": {"type": "integer", "minimum": 1, "maximum": 255},
              "lines": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"$ref": "#/$defs/text"}
              },
              "only": {"type": "boolean"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.+-]*(/[A-Za-z0-9_][A-Za-z0-9_.+-]*)*$"},
    "command": {
      "type": "object",
      "required": ["argv", "bound_s"],
      "properties": {
        "argv": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "bound_s": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    }
  }
}
