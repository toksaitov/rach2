{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Etude repetition record, version 1",
  "description": "The seed of a run of repetitions and the plan it gave, the plan's selection and concurrency; see tools/etude/Readme.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "run_id", "seed", "pick", "load_percent", "width", "retries", "cases", "loads", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "policy": {"const": "repeat-splitmix64-v1"},
    "run_id": {"$ref": "#/$defs/id"},
    "seed": {"$ref": "#/$defs/count"},
    "pick": {"$ref": "#/$defs/count"},
    "load_percent": {"type": "integer", "minimum": 0, "maximum": 100},
    "width": {"$ref": "#/$defs/positive"},
    "retries": {"$ref": "#/$defs/count"},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "architecture", "repetitions"],
        "properties": {
          "case_id": {"$ref": "#/$defs/id"},
          "architecture": {"$ref": "#/$defs/architecture"},
          "repetitions": {"$ref": "#/$defs/positive"}
        }
      }
    },
    "loads": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["load_id", "kind", "amount"],
        "properties": {
          "load_id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["cpu", "memory", "disk"]},
          "amount": {"$ref": "#/$defs/positive"}
        }
      }
    },
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item_id", "case_id", "architecture", "repetition", "load_id"],
        "properties": {
          "item_id": {"$ref": "#/$defs/id"},
          "case_id": {"$ref": "#/$defs/id"},
          "architecture": {"$ref": "#/$defs/architecture"},
          "repetition": {"$ref": "#/$defs/count"},
          "load_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "architecture": {"enum": ["i686", "x86_64", "none"]}
  }
}
