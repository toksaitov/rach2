{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Etude budget policy, version 1",
  "description": "The site whose reference capacity the runs of routine testing are charged on, the limits of each class of run, and the steps whose first run is one-time setup; see tools/etude/Readme.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "site", "classes", "one_time_setup"],
  "properties": {
    "schema_version": {"const": 1},
    "policy": {"const": "budget-v1"},
    "site": {
      "type": "object", "additionalProperties": false,
      "required": ["machine_id", "os", "accelerator", "capacity"],
      "properties": {
        "machine_id": {"$ref": "#/$defs/id"},
        "os": {"enum": ["linux", "macos", "windows", "rach2"]},
        "accelerator": {"enum": ["tcg", "kvm", "hvf", "whpx", "native"]},
        "capacity": {
          "type": "object", "additionalProperties": false,
          "required": ["cpu_millis", "memory_bytes", "disk_bytes"],
          "properties": {
            "cpu_millis": {"$ref": "#/$defs/positive"},
            "memory_bytes": {"$ref": "#/$defs/positive"},
            "disk_bytes": {"$ref": "#/$defs/positive"}
          }
        }
      }
    },
    "classes": {
      "type": "object", "additionalProperties": false,
      "required": ["push", "ci", "release", "focused", "phase_first_run"],
      "properties": {
        "push": {"$ref": "#/$defs/limits"},
        "ci": {"$ref": "#/$defs/limits"},
        "release": {"$ref": "#/$defs/limits"},
        "focused": {"$ref": "#/$defs/limits"},
        "phase_first_run": {"$ref": "#/$defs/limits"}
      }
    },
    "one_time_setup": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["goal_us", "growth_us", "ceiling_us", "cleanup_reserve_us"],
      "properties": {
        "goal_us": {"$ref": "#/$defs/positive"},
        "growth_us": {"$ref": "#/$defs/count"},
        "ceiling_us": {"$ref": "#/$defs/positive"},
        "cleanup_reserve_us": {"$ref": "#/$defs/positive"}
      }
    }
  }
}
