    {
      "case_id": "fixture.networks.past",
      "behavior": "A forward of the second port of a case that reserves one",
      "units": [
        "dropbear",
        "tcp"
      ],
      "domain": "machine",
      "architectures": [
        "i686",
        "x86_64"
      ],
      "workload": {
        "arguments": [],
        "inputs": {
          "marker": "ssh-key-login-ok"
        },
        "repetitions": 1,
        "seed": null
      },
      "requirements": {
        "host_api": "posix",
        "tools": [
          "ssh"
        ],
        "features": {}
      },
      "execution": {
        "program": "ssh_scenario",
        "stdin": null,
        "role": "ordinary",
        "privileges": "an ordinary user",
        "isolation": [
          {
            "fixture": "scratch"
          },
          {
            "fixture": "disk",
            "names": [
              "ssh-disk"
            ]
          }
        ],
        "children": "none",
        "cleanup": "libetude-case ends the machine and removes the disk copy, which it keeps after a failure"
      },
      "steps": [
        {
          "step_id": "dropbear",
          "stage": "execute",
          "machine": "server",
          "does": "boot the copy, log in as root at the console and start dropbear on port 22"
        },
        {
          "step_id": "login",
          "stage": "execute",
          "does": "run ssh with root's key against 127.0.0.1 at the case's first port and read the marker it prints"
        }
      ],
      "machines": [
        {
          "machine_id": "server",
          "qemu": {
            "kernel": "kernel",
            "initrd": null,
            "disks": [
              "ssh-disk"
            ],
            "cpu": "max",
            "processors": 1,
            "memory_bytes": 134217728,
            "firmware": "direct",
            "devices": [
              {
                "model": "rtl8139",
                "forwards": [
                  {
                    "protocol": "tcp",
                    "port": 1,
                    "guest_port": 22
                  }
                ]
              }
            ],
            "boot_options": [
              "rach2.fsdisk"
            ]
          },
          "console": "serial",
          "qmp": true,
          "helper": false
        }
      ],
      "assertions": [
        {
          "assertion_id": "root-prompt",
          "checks": "the console reaches a root prompt",
          "source": "scenario"
        },
        {
          "assertion_id": "key-login",
          "checks": "ssh exits 0 and prints the marker that the remote command echoes",
          "source": "scenario"
