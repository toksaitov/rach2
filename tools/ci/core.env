# core.env: the environment of a core run on each architecture. ci.yml's
# core jobs add it to their environment, and bisect.sh runs a core failure
# again with it, so that a failure that needs parallel make repeats there.
# Each line other than a comment is NAME=VALUE, taken as it is, with no
# quoting. Each architecture takes at most 6 of the testing host's 24
# processors, so that the workers' checks are admitted beside the two core
# runs.
JOBS=6
MAKEFLAGS=-j6
RACH2_WORKERS=6
