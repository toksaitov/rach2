#!/bin/sh
#
# pre-commit: format the staged in-house C files with the clang-format
# version tools/setup/judges records, stage the result, and refuse the commit
# when the staged files fail the size limits, the comment width, the banned
# terms or the fast style checks of tools/verify/quickcheck.sh.
#
# tools/verify/hookcheck.sh does the work; its header says how.
#
exec sh "$(dirname "$0")/../verify/hookcheck.sh" commit
