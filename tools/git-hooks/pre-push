#!/bin/sh
#
# pre-push: refuse a push to master whose commits change a file that fails
# the formatting or the text rules of `tests/run style`, and print what to
# run. It changes no file.
#
# git passes the remote's name and address as arguments, which the check
# does not need, and one line for each ref it pushes on the input, which
# tools/verify/hookcheck.sh reads; its header says how the check works.
#
exec sh "$(dirname "$0")/../verify/hookcheck.sh" push
