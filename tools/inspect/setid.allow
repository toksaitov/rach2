# tools/inspect/setid.allow: the set-id guard's declarations.
#
# setidcheck reads this file. One `manifest` line opens an entry named by a
# manifest's stem, and the indented lines under it declare what that image
# may carry; `copy` starts from another entry's declarations, and later
# lines add to or replace them, so a shared profile is written once and a
# derived one cannot drift from it. The global lists at the bottom feed the
# applet, config and init checks. Lines read like manifest directives: the
# same tokenizer, `#` starts a full-line comment, and a `text` payload is
# the rest of the line, byte for byte, before escapes are expanded.
#
# `setid` declares a privileged path with its mode, owner and the host file
# it is staged from. `trusted` names a file that must be present,
# unprivileged, and exactly as declared: a program root runs, or a file
# root reads to decide who somebody is. `trusted overlay` names one that a
# manifest's overlay program installs over the staged tree, with the host
# file it comes from: the manifest check passes it over, and the check of
# the finished image requires a regular file with the declared mode and
# owner under directories nobody but root may write. `sentinel` names one ordinary node
# the image inventory must find when an entry declares no set-id path, so a
# misparsed image cannot read as clean. `init` names which init artifact
# the manifest must stage (`none` forbids one). `sysroot` marks the image
# that carries the compiler, whose search paths are then inventoried too.

manifest os-real
setid /bin/su 04755:0:0 build/vendor/busybox/busybox-suid
setid /bin/passwd 04755:0:0 build/vendor/busybox/busybox-suid
setid /bin/login 04755:0:0 build/vendor/busybox/busybox-suid
trusted file 0755:0:0 /bin/busybox build/vendor/busybox/busybox
trusted file 0755:0:0 /bin/sh build/vendor/busybox/busybox
trusted file 0755:0:0 /bin/dropbearmulti build/vendor/dropbear/dropbearmulti
trusted text 0644:0:0 /etc/passwd root:x:0:0:root:/root:/bin/sh\ntest:x:1000:1000:test:/home/test:/bin/sh\n
trusted file 0600:0:0 /etc/shadow krffs/shadow
trusted text 0644:0:0 /etc/group root:x:0:\ntest:x:1000:\n
trusted text 0644:0:0 /etc/shells /bin/sh\n
trusted text 0644:0:0 /etc/profile export PATH=/bin:/usr/bin\nexport HOME="${HOME:-/root}"\ncd "$HOME"\n
trusted file 0600:0:0 /root/.ssh/authorized_keys krffs/authorized_keys
trusted file 0755:0:0 /bin/bootctl build/utils/sbin/bootctl
trusted file 0644:0:0 /src/rach2/guest.mk rach2/guest.mk
trusted file 0644:0:0 /src/utils/guest.mk utils/guest.mk
trusted file 0644:0:0 /src/ish/guest.mk ish/guest.mk
trusted file 0644:0:0 /src/rach2/sys/syscall.c rach2/sys/syscall.c
init init-login
sysroot

# The metal profile the laptop boots from a USB stick: os-real's privilege
# model with no compiler, no /src and no installer.
manifest rach2-metal
setid /bin/su 04755:0:0 build/vendor/busybox/busybox-suid
setid /bin/passwd 04755:0:0 build/vendor/busybox/busybox-suid
setid /bin/login 04755:0:0 build/vendor/busybox/busybox-suid
trusted file 0755:0:0 /bin/busybox build/vendor/busybox/busybox
trusted file 0755:0:0 /bin/sh build/vendor/busybox/busybox
trusted file 0755:0:0 /bin/dropbearmulti build/vendor/dropbear/dropbearmulti
trusted text 0644:0:0 /etc/passwd root:x:0:0:root:/root:/bin/sh\ntest:x:1000:1000:test:/home/test:/bin/sh\n
trusted file 0600:0:0 /etc/shadow krffs/shadow
trusted text 0644:0:0 /etc/group root:x:0:\ntest:x:1000:\n
trusted text 0644:0:0 /etc/shells /bin/sh\n
trusted text 0644:0:0 /etc/profile export PATH=/bin:/usr/bin\nexport HOME="${HOME:-/root}"\ncd "$HOME"\n
trusted file 0600:0:0 /root/.ssh/authorized_keys krffs/authorized_keys
init init-metal

# The recovery profile. It copied the metal one until 2026-09-14 and now
# stands on its own, because it is the one image that authenticates nobody:
# it boots to a shell, carries no stored password, and nothing on it decides
# who a person is at its console. Whether it answers the network is decided by
# whether the build had a key to stage: no key, no server. That is deliberate. Whoever
# chooses this entry has the machine in their hands, a password here would
# have stood between somebody whose machine will not start and the tools that
# repair it, and the image has none of that machine's accounts to check
# against in any case.
#
# The set-id programs come with it because the shell still needs them to run
# something as another user, and the two disk tools are pinned because both
# run as root against raw devices in the one image whose purpose is writing
# any sector.
manifest rach2-recovery
setid /bin/su 04755:0:0 build/vendor/busybox/busybox-suid
trusted file 0755:0:0 /bin/dropbearmulti build/vendor/dropbear/dropbearmulti
trusted optional-file 0600:0:0 /root/.ssh/authorized_keys krffs/recovery_authorized_keys
setid /bin/passwd 04755:0:0 build/vendor/busybox/busybox-suid
trusted file 0755:0:0 /bin/busybox build/vendor/busybox/busybox
trusted file 0755:0:0 /bin/sh build/vendor/busybox/busybox
trusted text 0644:0:0 /etc/passwd root:x:0:0:root:/root:/bin/sh\ntest:x:1000:1000:test:/home/test:/bin/sh\n
trusted text 0600:0:0 /etc/shadow root:*:0:0:99999:7:::\ntest:*:0:0:99999:7:::\n
trusted text 0644:0:0 /etc/group root:x:0:\ntest:x:1000:\n
trusted text 0644:0:0 /etc/shells /bin/sh\n
trusted text 0644:0:0 /etc/profile export PATH=/bin:/usr/bin\nexport HOME="${HOME:-/root}"\ncd "$HOME"\n
trusted file 0755:0:0 /bin/reflash build/utils/reflash
trusted file 0755:0:0 /bin/rescue-static krffs/rescue-static.script
trusted file 0755:0:0 /bin/bootctl build/utils/sbin/bootctl
init init-recovery

# The laptop's own-disk profile: os-real with the metal init and nothing
# else changed, exactly as its manifest is built.
manifest rach2-metal-disk copy os-real
init init-metal

# The GNU system's root: os-real's privilege set with OpenSSH in Dropbear's
# place, so there is no dropbearmulti to declare, and the accounts, shells and
# path that go with it, the metal init that starts OpenSSH's server, and
# the two files by which glibc decides whose account a name is and which
# libraries a program of root's loads. What vendor/gnu/install_root.sh adds
# over the staged tree is not in the manifest, and none of it may be set-id:
# OpenSSH's ssh-keysign is installed without its bit. The programs of it
# that root runs, the SSH server and ssh-keygen, which init starts, the two
# helpers the server starts as root, bash, root's login shell, which
# /bin/bash links to and /bin/sh is a second name of, and D-Bus's daemon and
# dbus-send, which root's login profile runs for its session bus, are
# declared as overlay files.
manifest os-real-gnu
setid /bin/su 04755:0:0 build/vendor/busybox/busybox-suid
setid /bin/passwd 04755:0:0 build/vendor/busybox/busybox-suid
setid /bin/login 04755:0:0 build/vendor/busybox/busybox-suid
setid /usr/bin/newgrp 04755:0:0 build/vendor/gnu/setid/newgrp
setid /usr/bin/crontab 02755:0:63 build/vendor/gnu/setid/crontab
trusted file 0755:0:0 /bin/busybox build/vendor/busybox/busybox
trusted overlay 0755:0:0 /bin/sh build/vendor/gnu/root/usr/bin/bash
trusted text 0644:0:0 /etc/passwd root:x:0:0:root:/root:/bin/bash\ntest:x:1000:1000:test:/home/test:/bin/bash\nsshd:x:74:74::/var/empty:/usr/bin/false\nmessagebus:x:81:81::/nonexistent:/usr/bin/false\nnobody:x:65534:65534:nobody:/nonexistent:/usr/bin/false\n
trusted file 0600:0:0 /etc/shadow krffs/shadow
trusted text 0644:0:0 /etc/group root:x:0:\ntest:x:1000:\nsshd:x:74:\nmessagebus:x:81:\ncrontab:x:63:\nnogroup:x:65534:\n
trusted text 0644:0:0 /etc/shells /bin/sh\n/bin/bash\n
trusted text 0644:0:0 /etc/profile export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin\nexport HOME="${HOME:-/root}"\nexport PS1='\u@\h:\w\$ '\ncase "$TERM" in rach2|linux|dumb|'') ;; *) export LANG=C.UTF-8 ;; esac\nif [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -x /usr/bin/dbus-daemon ]; then\n    export DBUS_SESSION_BUS_ADDRESS="unix:path=$HOME/.dbus/session_bus_socket"\n    dbus-send --session --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.GetId 2>/dev/null ||\n        { mkdir -p "$HOME/.dbus" && chmod 700 "$HOME/.dbus" &&\n          dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --fork --nopidfile >/dev/null 2>&1; }\nfi\ncd "$HOME"\n
trusted text 0644:0:0 /etc/nsswitch.conf passwd: files\ngroup: files\nshadow: files\nhosts: files dns\nnetworks: files\nprotocols: files\nservices: files\n
trusted text 0644:0:0 /etc/ld.so.conf /usr/lib/i386-linux-gnu\n
trusted overlay 0755:0:0 /usr/sbin/sshd build/vendor/gnu/root/usr/sbin/sshd
trusted overlay 0755:0:0 /usr/bin/ssh-keygen build/vendor/gnu/root/usr/bin/ssh-keygen
trusted overlay 0755:0:0 /usr/libexec/sshd-session build/vendor/gnu/root/usr/libexec/sshd-session
trusted overlay 0755:0:0 /usr/libexec/sshd-auth build/vendor/gnu/root/usr/libexec/sshd-auth
trusted overlay 0755:0:0 /usr/bin/bash build/vendor/gnu/root/usr/bin/bash
trusted overlay 0755:0:0 /usr/bin/dbus-daemon build/vendor/gnu/chromium/usr/bin/dbus-daemon
trusted overlay 0755:0:0 /usr/bin/dbus-send build/vendor/gnu/chromium/usr/bin/dbus-send
trusted file 0600:0:0 /root/.ssh/authorized_keys krffs/authorized_keys
trusted file 0755:0:0 /bin/bootctl build/utils/sbin/bootctl
trusted file 0644:0:0 /src/rach2/guest.mk rach2/guest.mk
trusted file 0644:0:0 /src/utils/guest.mk utils/guest.mk
trusted file 0644:0:0 /src/ish/guest.mk ish/guest.mk
trusted file 0644:0:0 /src/rach2/sys/syscall.c rach2/sys/syscall.c
init init-metal
sysroot

# `tests/run grub` boots os-real with marked GRUB cores staged beside it;
# its privilege set is os-real's and must stay so.
manifest grub-test copy os-real

manifest test
setid /suidhelper.suid 04755:0:0 build/tests/suidhelper
setid /suidhelper.u5 04755:5:0 build/tests/suidhelper
setid /suidhelper.sgid 02755:0:5 build/tests/suidhelper
setid /suidhelper.nox 04644:0:0 build/tests/suidhelper
setid /sudo 04755:0:0 build/utils/sbin/sudo
setid /su 04755:0:0 build/utils/sbin/su
setid /passwd 04755:0:0 build/utils/sbin/passwd
setid /musl/suidmusl.suid 04755:0:0 build/tests/musl/suidmusl
init none

manifest os-simple
setid /bin/su 04755:0:0 build/utils/sbin/su
setid /bin/passwd 04755:0:0 build/utils/sbin/passwd
trusted file 0755:0:0 /bin/login build/utils/sbin/login
trusted file 0755:0:0 /bin/adduser build/utils/sbin/adduser
trusted file 0755:0:0 /bin/ish build/ish/ish
trusted file 0755:0:0 /bin/sh build/ish/ish
trusted text 0644:0:0 /etc/passwd root:x:0:0:root:/root:/bin/ish\ntest:x:1000:1000:test:/home/test:/bin/ish\n
trusted file 0600:0:0 /etc/shadow krffs/shadow
trusted text 0644:0:0 /etc/group root:x:0:\ntest:x:1000:\n
trusted text 0644:0:0 /etc/shells /bin/ish\n/bin/sh\n
sentinel /demo/hello.txt 0644:0:0
init init-login

manifest disk-test
sentinel /blockprobe 0755:0:0
init none

# The image `tests/run loopdev` mounts through a loop device: two data files
# and no program, so it stages no set-id node and has no init to run.
manifest loopimg-test
sentinel /hello.txt 0644:0:0
init none

# The four file systems in files that a fresh disk carries in /demo, and the
# empty KRFFS volume beside them: one file each, no program, no init.
manifest fs-demo
sentinel /hello.txt 0644:0:0
init none

# The volume `tests/run krffsmount` mounts: three data files and no program,
# so it stages no set-id node and has no init to run.
manifest krffsvol-test
sentinel /pattern.bin 0644:0:0
init none

manifest persist-test
sentinel /persistprobe 0755:0:0
init none

manifest cred-persist-test
sentinel /creddisk 0755:0:0
init none

# The tree `tests/run imagerace` builds for itself: one program, staged to
# prove that a changed source reaches the image through exactly its target.
manifest imagerace-tree
sentinel /prog 0755:0:0
init none

# The USB mutation image contains only its freshly compiled probe.
manifest usbdisk-proof
sentinel /usbdiskprobe 0755:0:0
init none

manifest rng-proof
sentinel /rngprobe 0755:0:0
init none

# The console-login fixtures: the same image but for the init each
# declares, and neither stages /bin/login. The strict one must refuse and
# the permissive one must reach a root shell.
manifest login-test-strict
trusted file 0755:0:0 /sbin/init build/utils/sbin/init-login
sentinel /etc/motd 0644:0:0
init init-login

manifest login-test-shell
trusted file 0755:0:0 /sbin/init build/utils/sbin/init-shell
sentinel /etc/motd 0644:0:0
init init-shell

# The shutdown fixture stages the shipped setuid `su` so one phase can ask
# a bare `halt` as somebody who is not root and be refused.
manifest shutdown-test
setid /bin/su 04755:0:0 build/utils/sbin/su
trusted file 0755:0:0 /bin/busybox build/vendor/busybox/busybox
init init-shell

manifest stress-test
sentinel /stressprobe 0755:0:0
init none

# What the MAIN busybox must not carry. The first six want the set-id bit
# this binary is staged without, so an applet of that name would answer
# before the set-id build's copy and refuse. `ping6` and `traceroute6` need
# IPv6 this stack does not have. `ping` and `dmesg` would answer from the
# applet table before the files staged under the same names: /bin/ping is
# the in-house program an ordinary account can run, and /bin/dmesg prints
# /dev/bootlog. The sentinel is an applet that must be present, because a
# check that only looks for absences passes just as well on a header it
# failed to understand.
forbidden-applet su
forbidden-applet passwd
forbidden-applet login
forbidden-applet vlock
forbidden-applet wall
forbidden-applet crontab
forbidden-applet ping
forbidden-applet ping6
forbidden-applet traceroute6
forbidden-applet dmesg
applet-sentinel cat

# The set-id build's whitelist: exactly these three and nothing else, since
# every applet in that binary runs as root.
suid-applet login
suid-applet passwd
suid-applet su

# The set-id build's config. Every symbol here must APPEAR, on or off, so a
# config regenerated under other symbol names fails instead of passing by
# holding none of them. The off list is what keeps the binary the thing its
# name claims: no busybox.conf parser (an upstream use-after-free), no
# applet-over-disk preference, no login scripts, and no shell in any form.
suid-config-on CONFIG_STATIC
suid-config-on CONFIG_LFS
suid-config-on CONFIG_FEATURE_SUID
suid-config-on CONFIG_FEATURE_SHADOWPASSWDS
suid-config-on CONFIG_SH_IS_NONE
suid-config-on CONFIG_LOGIN
suid-config-on CONFIG_PASSWD
suid-config-on CONFIG_SU
suid-config-off CONFIG_FEATURE_SUID_CONFIG
suid-config-off CONFIG_FEATURE_PREFER_APPLETS
suid-config-off CONFIG_LOGIN_SCRIPTS
suid-config-off CONFIG_BUSYBOX
suid-config-off CONFIG_ASH
suid-config-off CONFIG_HUSH
suid-config-off CONFIG_SH_IS_ASH
suid-config-off CONFIG_SH_IS_HUSH
suid-config-off CONFIG_FEATURE_SH_STANDALONE

# The two init disciplines, told apart by the byte strings that name a
# shell. A strict init must hold neither; init-shell must hold both, which
# is the sentinel that proves the scan read the artifact at all. init-metal
# is init-login plus a supervised SSH server and inherits the strict rule.
init-strict init-login
init-strict init-metal
init-names-shell init-shell
shell-string /bin/sh
shell-string /ish

# The sysroot the compiler was configured to look in, inventoried in the
# image whose entry says `sysroot`. `sysroot-program` marks the ones that
# are run, not read.
sysroot-program /bin/tcc
sysroot-program /bin/cc
sysroot-program /bin/make
sysroot-path /lib/tcc/libtcc1.a
sysroot-path /lib/tcc/include/stdarg.h
sysroot-path /lib/tcc/include/stddef.h
sysroot-path /lib/tcc/include/stdbool.h
sysroot-path /lib/tcc/include/float.h
sysroot-path /lib/tcc/include/varargs.h
sysroot-path /lib/libc.a
sysroot-path /lib/crt1.o
sysroot-path /lib/crti.o
sysroot-path /lib/crtn.o
sysroot-path /include/stdio.h
sysroot-path /include/stdlib.h
sysroot-path /include/string.h
sysroot-path /include/unistd.h
sysroot-path /include/sys/stat.h
sysroot-path /include/bits/alltypes.h
