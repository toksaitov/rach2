+    bridge->references = 1;
+    if (!program || !command || wcslen(command) >= 32767) {
+        goto done;
+    }
+    if (WSADuplicateSocketW(socket, GetCurrentProcessId(), &protocol)) {
+        error = WSAGetLastError();
+        goto done;
+    }
+    bridge->socket = WSASocketW(FROM_PROTOCOL_INFO, FROM_PROTOCOL_INFO,
+                                FROM_PROTOCOL_INFO, &protocol, 0, WSA_FLAG_NO_HANDLE_INHERIT);
+    if (bridge->socket == INVALID_SOCKET) {
+        error = WSAGetLastError();
+        goto done;
+    }
