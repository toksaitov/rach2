+/* Quote the parsed argv by the native CRT's command-line rules. */
+static wchar_t *fork_exec_command(gchar **argv)
+{
+    GString *line = g_string_new(NULL);
+    wchar_t *wide;
+
+    for (size_t i = 0; argv[i]; i++) {
+        const char *at = argv[i];
+        if (i) {
+            g_string_append_c(line, ' ');
+        }
+        g_string_append_c(line, '"');
+        while (*at) {
+            size_t slashes = 0;
+            while (*at == '\\') {
+                slashes++;
+                at++;
+            }
+            if (*at == '"' || !*at) {
+                slashes = 2 * slashes + (*at == '"');
+            }
+            while (slashes--) {
+                g_string_append_c(line, '\\');
+            }
+            if (*at) {
+                g_string_append_c(line, *at++);
+            }
+        }
+        g_string_append_c(line, '"');
+    }
+    wide = (wchar_t *)g_utf8_to_utf16(line->str, -1, NULL, NULL, NULL);
+    g_string_free(line, TRUE);
+    return wide;
+}
+
+struct fork_exec_bridge {
+    SOCKET socket;
+    HANDLE input, output, gate;
+    LONG references;
+    gboolean ready;
+};
+
+/* The last worker closes the native socket and the startup event. */
+static void fork_exec_bridge_release(struct fork_exec_bridge *bridge)
+{
+    if (InterlockedDecrement(&bridge->references) != 0) {
+        return;
+    }
+    if (bridge->input) {
+        CloseHandle(bridge->input);
+    }
+    if (bridge->output) {
+        CloseHandle(bridge->output);
+    }
+    if (bridge->gate) {
+        CloseHandle(bridge->gate);
+    }
+    if (bridge->socket != INVALID_SOCKET) {
+        closesocket(bridge->socket);
+    }
+    g_free(bridge);
+}
+
+/* Deliver guest bytes to the child's pipe, then publish EOF to the child. */
+static DWORD WINAPI fork_exec_bridge_input(void *argument)
+{
+    struct fork_exec_bridge *bridge = argument;
+    char buffer[4096];
+    int count;
+
+    if (WaitForSingleObject(bridge->gate, INFINITE) == WAIT_OBJECT_0 && bridge->ready) {
+        while ((count = recv(bridge->socket, buffer, sizeof(buffer), 0)) > 0) {
+            DWORD at = 0, written;
+            while (at < (DWORD)count) {
+                if (!WriteFile(bridge->input, buffer + at, count - at, &written, NULL) ||
+                    !written) {
+                    goto done;
+                }
+                at += written;
+            }
+        }
+    }
+done:
+    CloseHandle(bridge->input);
+    bridge->input = NULL;
+    shutdown(bridge->socket, SD_RECEIVE);
+    fork_exec_bridge_release(bridge);
+    return 0;
+}
+
+/* Deliver child output to the guest, retaining the independent half-close. */
+static DWORD WINAPI fork_exec_bridge_output(void *argument)
+{
+    struct fork_exec_bridge *bridge = argument;
+    char buffer[4096];
+    DWORD count;
+
+    if (WaitForSingleObject(bridge->gate, INFINITE) == WAIT_OBJECT_0 && bridge->ready) {
+        while (ReadFile(bridge->output, buffer, sizeof(buffer), &count, NULL) && count) {
+            DWORD at = 0;
+            while (at < count) {
+                int written = send(bridge->socket, buffer + at, count - at, 0);
+                if (written <= 0) {
+                    goto done;
+                }
+                at += written;
+            }
+        }
+    }
+done:
+    CloseHandle(bridge->output);
+    bridge->output = NULL;
+    shutdown(bridge->socket, SD_SEND);
+    fork_exec_bridge_release(bridge);
+    return 0;
+}
+
