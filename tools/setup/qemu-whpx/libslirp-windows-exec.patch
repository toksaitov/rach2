+    if (ResumeThread(child.hThread) == (DWORD)-1) {
+        error = GetLastError();
+        goto done;
+    }
+    bridge->ready = TRUE;
+    started = TRUE;
+done:
+    if (created) {
+        if (!started) {
+            TerminateProcess(child.hProcess, 1);
+            WaitForSingleObject(child.hProcess, INFINITE);
+        }
+        CloseHandle(child.hThread);
+        CloseHandle(child.hProcess);
+    }
+    for (size_t i = 0; i < G_N_ELEMENTS(inherit); i++) {
+        if (inherit[i]) {
+            CloseHandle(inherit[i]);
+        }
+        if (workers[i]) {
+            CloseHandle(workers[i]);
+        }
+    }
+    if (attributes_ready) {
+        DeleteProcThreadAttributeList(startup.lpAttributeList);
+    }
+    g_free(startup.lpAttributeList);
+    if (bridge->gate) {
+        SetEvent(bridge->gate);
+    }
+    fork_exec_bridge_release(bridge);
+    g_free(program);
+    g_free(command);
+    g_free(file);
+    if (!started) {
+        g_set_error(err, G_SPAWN_ERROR, G_SPAWN_ERROR_FAILED,
+                    "native relay launch failed: %lu", (unsigned long)error);
+    }
+    return started;
+}
