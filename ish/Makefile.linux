# ish/Makefile.linux: build ish as a static Linux program, with the
# architecture's cross compiler (mk/toolchain.mk), into build/ish/linux/ or
# build/x86_64/ish/linux/ (mk/build.mk), apart from the Rach2 build. The text
# address is left to the linker.
#
# Usage: make -f Makefile.linux [ARCH=x86_64]

COMPONENT = ish/linux
include ../mk/toolchain.mk
include ../mk/build.mk
CC := $(CROSS_CC)

CFLAGS = $(ARCH_CFLAGS) -ffreestanding
LDFLAGS = $(ARCH_CFLAGS) -nostdlib -static $(ARCH_LDFLAGS)

TARGET = $(BUILD)/ish

OBJECTS = $(addprefix $(BUILD)/, crt0.o ish.o ish_shell_utilities.o \
                                 ish_cstring_utilities.o ish_syscalls.o)
HEADERS = ish_common.h ish_syscalls.h ish_shell_utilities.h ish_cstring_utilities.h

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJECTS)
	@mkdir -p $(dir $@)
	$(CC) $(LDFLAGS) -o $@ $(OBJECTS)

$(BUILD)/%.o: %.c $(HEADERS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -rf $(BUILD)
