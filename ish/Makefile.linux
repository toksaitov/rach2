# ISH Shell Makefile (Linux)
#
# Builds shell for Linux using cross-compiler.
# Usage: make -f Makefile.linux [ARCH=x86_64]
#
# Builds out of tree, into build/ish/linux/, or build/x86_64/ish/linux/ (its own
# subdir, distinct from the main build's build/ish/). See ../mk/build.mk. The
# compiler is the architecture's (mk/toolchain.mk).

COMPONENT = ish/linux
include ../mk/toolchain.mk
include ../mk/build.mk
CC := $(CROSS_CC)

CFLAGS = $(ARCH_CFLAGS) -ffreestanding
LDFLAGS = $(ARCH_CFLAGS) -nostdlib -static $(ARCH_LDFLAGS)

TARGET = $(BUILD)/ish

OBJECTS = $(addprefix $(BUILD)/, crt0.o ish.o ish_shell_utilities.o \
                                 ish_cstring_utilities.o ish_syscalls.o)
HEADERS = ish_common.h ish_syscalls.h ish_shell_utilities.h ish_cstring_utilities.h

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJECTS)
	@mkdir -p $(dir $@)
	$(CC) $(LDFLAGS) -o $@ $(OBJECTS)

$(BUILD)/%.o: %.c $(HEADERS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -rf $(BUILD)
