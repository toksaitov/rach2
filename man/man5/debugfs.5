--------------
fences:
--------------
# cat /sys/kernel/debug/dri/0/name
bochs-drm dev=0000:00:02.0 unique=0000:00:02.0
# echo off > /sys/kernel/debug/dri/0/Virtual-1/force
# echo 0 > /sys/kernel/debug/kvm/exit_stats
.Ed
