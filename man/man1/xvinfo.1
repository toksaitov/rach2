.Dd November 9, 2026
.Dt XVINFO 1
.Os
.Sh NAME
.Nm xvinfo
.Nd Print out X-Video extension adaptor information
.Sh DESCRIPTION
.Ss "SYNOPSIS"
.Bd -literal
     xvinfo [-display displayname]
.Ed
.Ss "DESCRIPTION"
.Bd -literal
     xvinfo prints out the capabilities of any video adaptors associated with
     the display that are accessible through the X-Video extension.
.Ed
.Ss "OPTIONS"
.Bd -literal
     -display display
             This argument allows you to specify the server to query; see
             X(7).

     -short  Output less details, to reduce the amount of text.

     -version
             Output program version, then exit.
.Ed
.Ss "ENVIRONMENT"
.Bd -literal
     DISPLAY This variable may be used to specify the server to query.
.Ed
.Ss "SEE ALSO"
.Bd -literal
     X(7), xdpyinfo(1), xwininfo(1), xdriinfo(1), glxinfo(1), xprop(1)
.Ed
.Ss "AUTHORS"
.Bd -literal
     Mark Vojkovich
.Ed
