#!/bin/sh
# qemu-nctx: Debian's QEMU with the bed's virglrenderer 1.3.0, whose i915
# renderer offers the native-context capset, in place of Debian's 1.1.0.
# Its virtio-gpu-gl device takes drm_native_context=on.
LD_LIBRARY_PATH=/opt/rach2-nctx/virglrenderer/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export LD_LIBRARY_PATH
exec qemu-system-x86_64 "$@"
