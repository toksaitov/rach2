[
  "qemu-system-x86_64",
  "-name",
  "venus-77-10-debian-sdl-cube-1360x768@60",
  "-accel",
  "kvm",
  "-cpu",
  "host",
  "-smp",
  "4",
  "-m",
  "6G",
  "-object",
  "memory-backend-memfd,id=mem,size=6G,share=on",
  "-machine",
  "q35,memory-backend=mem",
  "-no-reboot",
  "-vga",
  "none",
  "-device",
  "virtio-vga-gl,venus=on,blob=on,hostmem=4G",
  "-display",
  "sdl,gl=on,full-screen=on",
  "-audiodev",
  "none,id=noaudio",
  "-drive",
  "file=/data/build/77-10/tmp/debian-sdl-cube-1360x768@60.ag2ysqov/guest.qcow2,if=none,id=root,format=qcow2",
  "-device",
  "ide-hd,drive=root,bus=ide.0",
  "-netdev",
  "user,id=n0,hostfwd=tcp:127.0.0.1:22662-:22",
  "-device",
  "e1000,netdev=n0",
  "-device",
  "virtio-rng-pci",
  "-device",
  "virtio-keyboard-pci",
  "-device",
  "virtio-tablet-pci",
  "-serial",
  "file:/data/build/77-10/runs/debian-sdl-cube-1360x768@60/serial.log",
  "-monitor",
  "none"
]
