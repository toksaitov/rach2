diff --git a/rach2/sys/arch/x86/exits.c b/rach2/sys/arch/x86/exits.c
index 2eae7ebc2..43b835055 100644
--- a/rach2/sys/arch/x86/exits.c
+++ b/rach2/sys/arch/x86/exits.c
@@ -8,6 +8,7 @@
 #include "../../proc/percpu.h"
 #include "../../proc/smp.h"
 #include "../../cmdline.h"
+#include "../../lib/kstring.h"
 
 /* The kinds and numbers one processor has counted, in the order it first
  * met them; a running system fills a few dozen. */
@@ -210,3 +211,257 @@ int32_t exits_show(void *data, char *buf, uint32_t cap)
     put_counts(&t, per, ncpu);
     return (int32_t)t.len;
 }
+
+/* TRACE (80-103): kernel-mode interrupts by the interrupted pc and the
+ * three return addresses above it. */
+#define SITES_SLOTS 1024
+#define SITES_PCS 4
+struct site_slot {
+    uintptr_t pc[SITES_PCS];
+    uint32_t count;
+};
+static struct site_slot sites[NR_CPUS][SITES_SLOTS];
+static uint32_t sites_lost[NR_CPUS];
+uint64_t trace_phase[NR_CPUS][8];
+volatile uint64_t trace_kick[NR_CPUS];
+volatile int trace_kstate[NR_CPUS];
+volatile int trace_wakecls[NR_CPUS];
+uint32_t trace_lat[NR_CPUS][2][12];
+uint64_t trace_ts[NR_CPUS][8];
+volatile int trace_mark[NR_CPUS];
+uint32_t trace_hit[NR_CPUS][4][9];
+uint32_t trace_tick_at[NR_CPUS][9];
+int64_t trace_hr_tick(void);
+int64_t rtc_monotonic_ns(void);
+
+static uint64_t b2b_pc[NR_CPUS], b2b_sp[NR_CPUS];
+static int b2b_cls[NR_CPUS];
+int trace_b2b_wait[NR_CPUS];
+static uint32_t b2b[NR_CPUS][8];
+
+/* An interrupt entry at the frame of the last one: it was pending at that
+ * one's return. Counted by the last one's class: 0 tick, 1 IPI, 2 device,
+ * +3 when it waited long for the big lock; 7 counts entries. */
+void trace_b2b(uint64_t pc, uint64_t sp, int cls)
+{
+    int c = arch_cpu_id();
+
+    b2b[c][7]++;
+    if (pc != 0 && pc == b2b_pc[c] && sp == b2b_sp[c]) {
+        b2b[c][b2b_cls[c] + (trace_b2b_wait[c] ? 3 : 0)]++;
+    }
+    b2b_pc[c] = pc;
+    b2b_sp[c] = sp;
+    b2b_cls[c] = cls;
+    trace_b2b_wait[c] = 0;
+}
+
+static struct {
+    uintptr_t ra;
+    uint64_t cycles;
+    uint32_t n;
+    uint32_t on;
+} trace_callers[NR_CPUS][64];
+
+void trace_caller(uintptr_t ra, int on, uint64_t cycles)
+{
+    int c = arch_cpu_id(), i;
+
+    for (i = 0; i < 64; i++) {
+        if ((trace_callers[c][i].ra == ra && trace_callers[c][i].on == (uint32_t)on) ||
+            trace_callers[c][i].ra == 0) {
+            trace_callers[c][i].ra = ra;
+            trace_callers[c][i].on = (uint32_t)on;
+            trace_callers[c][i].cycles += cycles;
+            trace_callers[c][i].n++;
+            return;
+        }
+    }
+}
+
+/* An interrupt of class `cls` (0 the IPI, 1 the timer, 2 a device) that
+ * landed at schedule's restore: for an IPI, the phase its send fell in,
+ * 0 before the region, 1..7 after trace_ts[k-1], 8 unstamped. */
+void trace_landed(int cls)
+{
+    int c = arch_cpu_id(), k = 0;
+    uint64_t t;
+
+    if (!trace_mark[c]) {
+        return;
+    }
+    trace_mark[c] = 0;
+    if (cls != 0) {
+        trace_hit[c][cls][0]++;
+        if (cls == 1) {
+            int64_t late = rtc_monotonic_ns() - trace_hr_tick();
+            uint64_t due = arch_cycles() - (late > 0 ? (uint64_t)late * 4192u / 1000u : 0);
+
+            while (k < 7 && due >= trace_ts[c][k]) {
+                k++;
+            }
+            trace_hit[c][3][k] += 0;
+            trace_tick_at[c][k]++;
+        }
+        return;
+    }
+    t = trace_kick[c];
+    if (t == 0) {
+        trace_hit[c][0][8]++;
+        return;
+    }
+    while (k < 7 && t >= trace_ts[c][k]) {
+        k++;
+    }
+    trace_hit[c][0][k]++;
+    {
+        uint64_t us = (arch_cycles() - t) / 4192u;
+        int b = 0;
+
+        while (b < 11 && us >= (1u << b)) {
+            b++;
+        }
+        trace_lat[c][0][b]++;
+        trace_hit[c][1][1 + (trace_kstate[c] & 3)]++;
+        trace_hit[c][2][1 + (trace_wakecls[c] & 3)]++;
+        trace_hit[c][2][5 + (t < this_cpu()->idle_end_cycles ? 1 : 0)]++;
+    }
+}
+uint32_t trace_phase_n[NR_CPUS][8];
+
+int trace_cls;
+void exits_irq_site(uintptr_t pc, uintptr_t fp, uintptr_t top)
+{
+    uintptr_t chain[SITES_PCS];
+    uintptr_t low = fp;
+    uint32_t h;
+    int i, c;
+    struct site_slot *s;
+
+    if (!exits_on) {
+        return;
+    }
+    chain[0] = pc;
+    for (i = 1; i < SITES_PCS; i++) {
+        if (top < 0x4000u || fp < top - 0x4000u || fp > top - 2 * sizeof(uintptr_t) ||
+            fp % sizeof(uintptr_t) != 0 || fp < low) {
+            break;
+        }
+        chain[i] = ((const uintptr_t *)fp)[1];
+        low = fp + 2 * sizeof(uintptr_t);
+        fp = ((const uintptr_t *)fp)[0];
+    }
+    for (; i < SITES_PCS; i++) {
+        chain[i] = 0;
+    }
+    chain[3] = (uintptr_t)trace_cls;
+    c = arch_cpu_id();
+    h = (uint32_t)(chain[0] ^ (chain[1] * 31u) ^ (chain[2] * 131u) ^ (chain[3] * 1031u));
+    for (i = 0; i < SITES_SLOTS; i++) {
+        s = &sites[c][(h + (uint32_t)i) % SITES_SLOTS];
+        if (s->count == 0) {
+            k_memcpy(s->pc, chain, sizeof(chain));
+            s->count = 1;
+            return;
+        }
+        if (s->pc[0] == chain[0] && s->pc[1] == chain[1] && s->pc[2] == chain[2] &&
+            s->pc[3] == chain[3]) {
+            s->count++;
+            return;
+        }
+    }
+    sites_lost[c]++;
+}
+
+static void put_hex(struct exits_text *t, uint64_t v)
+{
+    char tmp[17];
+    int n;
+
+    for (n = 15; n >= 0; n--) {
+        tmp[n] = "0123456789abcdef"[v & 15u];
+        v >>= 4;
+    }
+    tmp[16] = '\0';
+    put_str(t, tmp);
+}
+
+int32_t exits_sites_show(void *data, char *buf, uint32_t cap)
+{
+    struct exits_text t;
+    int ncpu = smp_cpu_count();
+    int c, i, k;
+
+    (void)data;
+    t.buf = buf;
+    t.cap = buf ? cap : 0;
+    t.len = 0;
+    if (ncpu > NR_CPUS) {
+        ncpu = NR_CPUS;
+    }
+    for (c = 0; c < ncpu; c++) {
+        for (i = 0; i < SITES_SLOTS; i++) {
+            const struct site_slot *s = &sites[c][i];
+
+            if (s->count == 0) {
+                continue;
+            }
+            put_num(&t, s->count, 0);
+            for (k = 0; k < SITES_PCS; k++) {
+                put_str(&t, " ");
+                put_hex(&t, s->pc[k]);
+            }
+            put_str(&t, "\n");
+        }
+        put_str(&t, "lost ");
+        put_num(&t, sites_lost[c], 0);
+        put_str(&t, "\n");
+        for (k = 0; k < 4 * 9; k++) {
+            put_str(&t, "hit ");
+            put_num(&t, (uint32_t)k, 0);
+            put_str(&t, " ");
+            put_num(&t, trace_hit[c][k / 9][k % 9], 0);
+            put_str(&t, "\n");
+        }
+        for (k = 0; k < 64 && trace_callers[c][k].ra; k++) {
+            put_str(&t, "caller ");
+            put_hex(&t, trace_callers[c][k].ra);
+            put_str(&t, " ");
+            put_hex(&t, trace_callers[c][k].cycles);
+            put_str(&t, " ");
+            put_num(&t, trace_callers[c][k].n, 0);
+            put_str(&t, trace_callers[c][k].on ? " on\n" : " off\n");
+        }
+        for (k = 0; k < 8; k++) {
+            put_str(&t, "b2b ");
+            put_num(&t, (uint32_t)k, 0);
+            put_str(&t, " ");
+            put_num(&t, b2b[c][k], 0);
+            put_str(&t, "\n");
+        }
+        for (k = 0; k < 9; k++) {
+            put_str(&t, "tickat ");
+            put_num(&t, (uint32_t)k, 0);
+            put_str(&t, " ");
+            put_num(&t, trace_tick_at[c][k], 0);
+            put_str(&t, "\n");
+        }
+        for (k = 0; k < 24; k++) {
+            put_str(&t, "lat ");
+            put_num(&t, (uint32_t)k, 0);
+            put_str(&t, " ");
+            put_num(&t, trace_lat[c][k / 12][k % 12], 0);
+            put_str(&t, "\n");
+        }
+        for (k = 0; k < 8; k++) {
+            put_str(&t, "phase ");
+            put_num(&t, (uint32_t)k, 0);
+            put_str(&t, " ");
+            put_hex(&t, trace_phase[c][k]);
+            put_str(&t, " ");
+            put_num(&t, trace_phase_n[c][k], 0);
+            put_str(&t, "\n");
+        }
+    }
+    return (int32_t)t.len;
+}
