+void lapic_eoi_wait(uint32_t vector, uint32_t ctx)
+{
+    uint32_t i, bits, hi = 0, isrn = 0;
+    int c;
+
+    if (!ready || !exits_counting()) {
+        return;
+    }
+    c = arch_cpu_id();
+    if (eoi_word_set[c]) {
+        return;
+    }
+    for (i = 1; i < 8; i++) {
+        bits = apic_read(LAPIC_IRR + i * 0x10u);
+        if (bits) {
+            uint32_t b = 31;
+            while (!(bits & (1u << b))) {
+                b--;
+            }
+            hi = i * 32u + b;
+        }
+        bits = apic_read(LAPIC_ISR + i * 0x10u);
+        while (bits) {
+            isrn++;
+            bits &= bits - 1u;
+        }
+    }
+    exits_count(EXIT_EOI_WAIT, vector | (hi << 8) | (ctx << 16) | (isrn > 1 ? 0x100000u : 0u));
+}
