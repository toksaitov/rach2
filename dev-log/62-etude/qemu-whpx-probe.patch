     }
+    diagnostic_hex("diagnostic frame extended bytes=", get32(img + X_SW + 4));
+    diagnostic_hex("diagnostic frame image bytes=", get32(img + X_SW + 16));
+    diagnostic_hex("diagnostic frame XCR0 low=", get32(img + X_SW + 8));
+    diagnostic_hex("diagnostic frame XCR0 high=", get32(img + X_SW + 12));
     if (get32(img + X_SW + 4) != xstate_size + 4u + FRAME_PREFIX) {
         return "the frame's extended size is not the image's and the magic's";
     }
@@ -643,6 +677,7 @@
