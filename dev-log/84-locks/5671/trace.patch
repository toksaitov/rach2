diff --git a/rach2/sys/dbg5671.h b/rach2/sys/dbg5671.h
new file mode 100644
index 000000000..91e7e4a3f
--- /dev/null
+++ b/rach2/sys/dbg5671.h
@@ -0,0 +1,16 @@
+/* dbg5671.h: a trace to QEMU's debug port, port 0xe9, for task 5671. */
+#ifndef DBG5671_H
+#define DBG5671_H
+extern volatile int dbg5671_on;
+static __inline__ void dbg5671_c(char c)
+{
+    __asm__ __volatile__("outb %0, %1" : : "a"(c), "Nd"((unsigned short)0xe9));
+}
+static __inline__ void dbg5671_x(unsigned long v)
+{
+    int i;
+    for (i = 28; i >= 0; i -= 4) {
+        dbg5671_c("0123456789abcdef"[(v >> i) & 15]);
+    }
+}
+#endif
diff --git a/rach2/sys/syscall_proc.c b/rach2/sys/syscall_proc.c
index c86bb5ad4..da1d5a9ca 100644
--- a/rach2/sys/syscall_proc.c
+++ b/rach2/sys/syscall_proc.c
@@ -84,6 +84,8 @@
 #include "network/ip/icmp.h"
 #include "network/net.h"
 #include "cmdline.h" /* kcmdline_has, for the rach2.stackoverrun test switch */
+#include "dbg5671.h"
+volatile int dbg5671_on;
 #include "mm/filemap.h"
 #include "mm/mm.h"
 #include "fs/tmpfs.h"
@@ -177,6 +179,18 @@ static void kstack_overrun_run(void)
 {
     klog(KLOG_INFO, "kstack", "overrun: pid %d descends its stack at 0x%x", (int)current_proc->pid,
          current_proc->kernel_stack - KERNEL_STACK_SIZE);
+    {
+        uint32_t esp, fl;
+        __asm__ __volatile__("mov %%esp, %0; pushf; pop %1" : "=r"(esp), "=r"(fl));
+        dbg5671_c('R');
+        dbg5671_x(esp);
+        dbg5671_c(' ');
+        dbg5671_x(fl);
+        dbg5671_c(' ');
+        dbg5671_x(paging_virt_to_phys(current_proc->kernel_stack - KERNEL_STACK_SIZE - PAGE_SIZE));
+        dbg5671_c('\n');
+        dbg5671_on = 1;
+    }
     kstack_descend(0);
     k_panic("kstack: overrun: the descent came back");
 }
