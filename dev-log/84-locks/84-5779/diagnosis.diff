 // The renderer of a WebGL context, unmasked where the browser gives it.
diff --git a/tests/graphics/runners/webgl.sh b/tests/graphics/runners/webgl.sh
index 59f25eaeda..f46969e66d 100755
--- a/tests/graphics/runners/webgl.sh
+++ b/tests/graphics/runners/webgl.sh
@@ -56,6 +56,29 @@
 # a result, which judge.py compares with the reference's.
 set -eu
 
+# Diagnosis of task 5779 only: -R N runs the same arguments N times, each
+# with its own -o OUT/rI.
+case " $* " in
+*" -R "*)
+    reps=1 rout=. rest=
+    while [ $# -gt 1 ]; do
+        case $1 in
+            -R) reps=$2; shift 2 ;;
+            -o) rout=$2; shift 2 ;;
+            *) rest="$rest $1"; shift ;;
+        esac
+    done
+    i=1
+    while [ "$i" -le "$reps" ]; do
+        mkdir -p "$rout/r$i"
+        # shellcheck disable=SC2086
+        sh "$0" $rest -o "$rout/r$i" "$1" || echo "webgl: rep $i: status $?" >&2
+        i=$((i + 1))
+    done
+    exit 0
+    ;;
+esac
+
 RUNNER_DIR=$(cd "$(dirname "$0")" && pwd)
 # shellcheck source=common.sh
 . "$RUNNER_DIR/common.sh"
@@ -63,7 +86,8 @@ RUNNER_DIR=$(cd "$(dirname "$0")" && pwd)
 browser=chromium version=2.0.1 size=250 suite=/usr/share/webgl/sdk/tests out=. omit='' batch=0
 silence=120
 # shellcheck disable=SC2034 # runner_weston reads RUNNER_RENDERER
-while getopts b:v:k:n:s:x:o:g o; do
+plist=
+while getopts b:v:k:n:s:x:o:gP: o; do
     case $o in
         b) browser=$OPTARG ;;
         v) version=$OPTARG ;;
@@ -73,6 +97,7 @@ while getopts b:v:k:n:s:x:o:g o; do
         x) omit=$OPTARG ;;
         o) out=$OPTARG ;;
         g) RUNNER_RENDERER=gl ;;
+        P) plist=$(echo "$OPTARG" | tr , ' ') ;;
         *) exit 2 ;;
     esac
 done
@@ -197,7 +222,7 @@ chunk()
 {
     n=$1
     first=$((n * size))
-    run_pages $(seq "$first" $((first + size - 1)))
+    run_pages ${plist:-$(seq "$first" $((first + size - 1)))}
     [ -n "$count" ] || runner_die "the harness gave no list"
     [ "$first" -lt "$count" ] || runner_die "chunk $n starts past the list's $count pages"
     chunks=$(((count + size - 1) / size))
