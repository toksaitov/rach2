@@ -15,6 +15,8 @@
 #include "../mm/paging.h"
 #include "../mm/usercopy.h"
 #include "../virtio/vgpushm.h"
+#include "../arch/x86/tsc.h"
+static uint64_t t4277_c[4];
 
 /* The bytes of the pages MAP_BLOB's answer of a page list is written to,
  * and the runs it holds after its heads: 3836, so that a blob of 64 MiB
@@ -253,6 +255,8 @@ static int32_t map_ask(struct virtio_gpu_device *vg, struct virtio_gpu_object *b
     int big, i;
     int32_t rc;
 
+    uint64_t ta = tsc_ordered(), tb, tc;
+
     for (i = 0; i < 2; i++) {
         cmd = vgpu_cmd_new(vg, vg->ctrlq, VIRTIO_GPU_CMD_RESOURCE_MAP_BLOB, sizeof(*req));
         if (!cmd) {
@@ -268,10 +272,16 @@ static int32_t map_ask(struct virtio_gpu_device *vg, struct virtio_gpu_object *b
         }
         vgpu_cmd_free(cmd); /* the payload's pages, part of them had */
     }
+    tb = tsc_ordered();
+    t4277_c[0] += tb - ta;
     if (!big) {
-        return vgpu_cmd_send_wait_map(cmd, answer, PAGE_SIZE - VIRTIO_GPU_RESP_OFF, got);
+        rc = vgpu_cmd_send_wait_map(cmd, answer, PAGE_SIZE - VIRTIO_GPU_RESP_OFF, got);
+        t4277_c[1] += tsc_ordered() - tb;
+        return rc;
     }
     rc = vgpu_cmd_send_wait_map(cmd, NULL, 0, NULL);
+    tc = tsc_ordered();
+    t4277_c[1] += tc - tb;
     if (rc == -ETIMEDOUT) {
         return rc; /* the reaper frees the command once the device answers */
     }
@@ -282,6 +292,7 @@ static int32_t map_ask(struct virtio_gpu_device *vg, struct virtio_gpu_object *b
         k_memcpy(answer, cmd->payload[page].page, here);
     }
     vgpu_cmd_free(cmd);
+    t4277_c[2] += tsc_ordered() - tc;
     return rc;
 }
 
@@ -299,9 +310,13 @@ static int32_t blob_map_pages(struct virtio_gpu_device *vg, struct virtio_gpu_ob
 {
     struct pages_gather g;
     uint32_t got;
+    uint64_t t0 = tsc_ordered(), t1, t2, t3;
     uint8_t *answer = (uint8_t *)kmalloc(VGPU_MAP_ANSWER);
     int32_t rc = answer ? 0 : -ENOMEM;
 
+    t1 = tsc_ordered();
+    t4277_c[0] = t4277_c[1] = t4277_c[2] = 0;
+
     k_memset(&g, 0, sizeof(g));
     g.total = bo->shmem.base.size >> PAGE_SHIFT;
     while (rc == 0 && g.first < g.total) {
@@ -328,8 +343,13 @@ static int32_t blob_map_pages(struct virtio_gpu_device *vg, struct virtio_gpu_ob
         klog(KLOG_WARN, "virtio_gpu", "resource %u: refused: its page list: error %d",
              (unsigned)bo->res_id, (int)rc);
     }
+    t2 = tsc_ordered();
     kfree(g.runs);
     kfree(answer);
+    t3 = tsc_ordered();
+    klog(KLOG_INFO, "t4277", "map %u pages: kmalloc %u ask-alloc %u wait %u copy-free %u kfree %u total %u cycles",
+         (unsigned)g.total, (unsigned)(t1 - t0), (unsigned)t4277_c[0], (unsigned)t4277_c[1],
+         (unsigned)t4277_c[2], (unsigned)(t3 - t2), (unsigned)(t3 - t0));
     return rc;
 }
 
