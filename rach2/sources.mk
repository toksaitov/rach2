# rach2/sources.mk: the one kernel source list, read by the host Makefile and
# by guest.mk under pdpmake on Rach2. Both derive their object lists from
# these two macros, so the host and guest builds cannot drift apart. Order
# matters: the link keeps input order, and the multiboot header in loader.o
# must stay within the first 8192 bytes of the kernel where loaders search.

ASM_SRC = loader.s \
          sys/isr_handler.s \
          sys/tables/gdt_handler.s \
          sys/tables/idt_handler.s \
          sys/proc/switch.s

