# GRUB Configuration Template for Rach2
#
# Reference only. The actual grub.cfg for a bootable ISO is generated per image by
# tools/mkiso.sh (run `make <image>-iso` or `make isos`), which stages the kernel and
# the image module and writes a grub.cfg like the entry below.
#
#   multiboot /boot/kernel
#   module /boot/<image>.krffs

set timeout=3
set default=0

menuentry "Rach2 (os-simple)" {
    multiboot /boot/kernel
    module /boot/os-simple.krffs
    boot
}
