# GRUB Configuration Template for Rach2
#
# The actual grub.cfg is generated by 'make iso' based on whether
# a RAM disk (../krffs_host/file_system.krffs) is present.
#
# Without RAM disk:
#   multiboot /boot/kernel
#
# With RAM disk:
#   multiboot /boot/kernel
#   module /boot/file_system.krffs

set timeout=3
set default=0

menuentry "Rach2 Kernel" {
    multiboot /boot/kernel
    # module /boot/file_system.krffs  # Added automatically if ramdisk exists
    boot
}
