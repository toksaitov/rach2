# A sample GRUB menu for Rach2, which no build reads.
#
# tools/image/mkiso.sh writes the grub.cfg of each ISO image (`make
# <image>-iso` or `make isos`): it stages the kernel and the image module and
# writes an entry that loads them, by Multiboot under BIOS and by multiboot2
# under UEFI, with a few more entries for rach2-metal. The second entry below
# is a rescue boot: `rach2.rescue` on the kernel's command line starts the
# kernel debug shell instead of the image's /sbin/init.
#
#   multiboot /boot/kernel
#   module /boot/<image>.krffs

set timeout=3
set default=0

menuentry "Rach2 (os-simple)" {
    multiboot /boot/kernel
    module /boot/os-simple.krffs
    boot
}

menuentry "Rach2 (os-simple) - rescue (kernel debug shell)" {
    multiboot /boot/kernel rach2.rescue
    module /boot/os-simple.krffs
    boot
}
