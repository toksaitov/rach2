+/** Wait for an adaptive reply, sending retries and checking the deadline.
+ * The receive loop owns the send buffer and counters in this mode. Every
+ * pass polls, with no wait when a retry is due, so that queued replies are
+ * read before the next retry however short the interval; and the deadline is
+ * checked again after the poll, since a reply can become readable only after
+ * it, as when the process was stopped in ppoll.
+ */
+static void wait_for_reply(void (*send_request)(int))
+{
+	struct pollfd pfd = { pingsock, POLLIN, 0 };
+
+	if (!(option_mask32 & OPT_A))
+		return;
+	for (;;) {
+		unsigned long long now = monotonic_us();
+		unsigned long long until = G.next_event_us;
+		struct timespec ts;
+		struct timespec *wait = NULL;
+		int ready;
+
+		if (deadline_passed(now))
+			print_stats_and_exit(0);
+		if (G.deadline_us) {
+			unsigned left = G.deadline_us - (unsigned)now;
+
+			if (!until || until > now + left)
+				until = now + left;
+		}
+		if (until) {
+			unsigned long long left = until > now ? until - now : 0;
+
+			ts.tv_sec = left / 1000000;
+			ts.tv_nsec = (left % 1000000) * 1000;
+			wait = &ts;
+		}
+		ready = ppoll(&pfd, 1, wait, NULL);
+		if (ready < 0) {
+			if (errno != EINTR)
+				bb_simple_perror_msg_and_die("ppoll");
+			continue;
+		}
+		now = monotonic_us();
+		if (deadline_passed(now))
+			print_stats_and_exit(0);
+		if (ready > 0)
+			return;
+		if (G.next_event_us && G.next_event_us <= now) {
+			if (!more_requests())
+				print_stats_and_exit(0);
+			send_request(0);
 		}
