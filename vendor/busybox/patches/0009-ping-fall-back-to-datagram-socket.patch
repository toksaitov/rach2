+/** Exit through the statistics if -w or the final wait has ended at NOW.
+ * The final wait follows the last request that -c allows; a next_event_us of
+ * 0 there never ends, as upstream's alarm(0) does not. The receive loop calls
+ * this after each read too, so that a reply read after either end is not
+ * counted, however long the process was stopped before the read.
+ */
+static void check_end(unsigned long long now)
+{
+	if (G.deadline_us && (int)(G.deadline_us - (unsigned)now) <= 0)
+		print_stats_and_exit(0);
+	if (!more_requests() && G.next_event_us && G.next_event_us <= now)
+		print_stats_and_exit(0);
+}
+
+/** Wait until the socket is readable in adaptive mode, sending due retries.
+ * The receive loop owns the send buffer and counters in this mode. Each pass
+ * checks -w and the final wait, sends at most one due retry, and then polls,
+ * with no wait when the next retry is due already. So a reply queued at any
+ * pass is read before the next retry however short the interval, and a retry
+ * or an end that is due is acted on at the next pass however much traffic the
+ * socket holds.
+ */
+static void wait_for_reply(void (*send_request)(int))
+{
+	struct pollfd pfd = { pingsock, POLLIN, 0 };
+
+	if (!(option_mask32 & OPT_A))
+		return;
+	for (;;) {
+		unsigned long long now = monotonic_us();
+		unsigned long long until;
+		struct timespec ts;
+		struct timespec *wait = NULL;
+		int ready;
+
+		check_end(now);
+		if (more_requests() && G.next_event_us && G.next_event_us <= now) {
+			send_request(0);
+			now = monotonic_us();
+		}
+		until = G.next_event_us;
+		if (G.deadline_us) {
+			int left = (int)(G.deadline_us - (unsigned)now);
+
+			if (left < 0)
+				left = 0;
+			if (!until || until > now + left)
+				until = now + left;
+		}
+		if (until) {
+			unsigned long long left = until > now ? until - now : 0;
+
+			ts.tv_sec = left / 1000000;
+			ts.tv_nsec = (left % 1000000) * 1000;
+			wait = &ts;
+		}
+		ready = ppoll(&pfd, 1, wait, NULL);
+		if (ready > 0)
+			return;
+		if (ready < 0 && errno != EINTR)
+			bb_simple_perror_msg_and_die("ppoll");
 	}
 }
 
