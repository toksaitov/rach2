The library finds whether a device is mounted from /proc/mounts on Linux and
from the file MOUNTED names, /etc/mtab, otherwise. The muslgcc wrapper
defines __rach2__ for this port and its compiler no __linux__, so without
this patch the
programs read /etc/mtab alone, which only the GNU system has, as a link to
/proc/self/mounts; elsewhere every run warned that the file was missing and
could not see a mounted volume. Rach2's /proc/mounts has the kernel's one
mount table in the format getmntent reads, so the patch takes it under
__rach2__ as under __linux__.

--- a/lib/ext2fs/ismounted.c
+++ b/lib/ext2fs/ismounted.c
@@ -236,7 +236,7 @@
 	if (retval == 0)
 		return 0;
 #endif /* DEBUG */
-#ifdef __linux__
+#if defined(__linux__) || defined(__rach2__)
 	retval = check_mntent_file("/proc/mounts", file, mount_flags,
 				   mtpt, mtlen);
 	if (retval == 0)
