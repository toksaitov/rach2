#!/bin/sh
# muslgcc: wrap the bare i686-elf-gcc cross compiler to build e2fsprogs against
# the ported musl (../musl/install). Three modes: a compile (-c/-S/-E) just adds the
# musl headers; a partial/relocatable link (-r) adds the headers but NO crt/libs
# (else the crt objects would be merged in and then clash at the final link); a
# final link injects the musl crt objects, the lib search path, libc.a and libgcc.
# Resolve ../musl/install relative to this wrapper (build_e2fsprogs.sh invokes it by
# its absolute path), so a clone in any directory uses the right musl tree.
# The -fno- and -no-pie flags turn off what a distribution's GCC adds by
# default, unwind tables, the stack protector, control-flow protection and
# PIE, so a bare i686-elf-gcc and the archive's cross GCC build the same
# binary; --build-id=none keeps its note out of a fixed-address link.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PREFIX="$SCRIPT_DIR/../musl/install"
GCC=i686-elf-gcc
MODE=link
for a in "$@"; do
  case "$a" in
    -c|-S|-E|-M|-MM) MODE=compile ;;
    -r) MODE=partial ;;
  esac
done
case "$MODE" in
  compile) exec "$GCC" -m32 -fno-asynchronous-unwind-tables -fno-unwind-tables -fno-stack-protector -fno-stack-clash-protection -fcf-protection=none -fno-pie -D__rach2__ -isystem "$PREFIX/include" "$@" ;;
  partial) exec "$GCC" -m32 -isystem "$PREFIX/include" -nostdlib "$@" ;;
  *)
    LIBGCC=$("$GCC" -print-libgcc-file-name)
    exec "$GCC" -m32 -fno-asynchronous-unwind-tables -fno-unwind-tables -fno-stack-protector -fno-stack-clash-protection -fcf-protection=none -fno-pie -no-pie -Wl,--build-id=none -D__rach2__ -isystem "$PREFIX/include" -nostdlib -nostartfiles -static \
         -L "$PREFIX/lib" \
         "$PREFIX/lib/crt1.o" "$PREFIX/lib/crti.o" "$@" \
         "$PREFIX/lib/libc.a" "$LIBGCC" "$PREFIX/lib/crtn.o" ;;
esac
