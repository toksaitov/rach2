diff --git a/tccasm.c b/tccasm.c
index c20f3c2..709791d 100644
--- a/tccasm.c
+++ b/tccasm.c
@@ -822,6 +822,14 @@ static void asm_parse_directive(TCCState *s1, int global)
             if (!strcmp(newtype, "function") || !strcmp(newtype, "STT_FUNC")) {
                 sym->type.t = (sym->type.t & ~VT_BTYPE) | VT_FUNC;
             }
+            else if (!strcmp(newtype, "gnu_indirect_function") ||
+                     !strcmp(newtype, "STT_GNU_IFUNC")) {
+                /* the symbol is a resolver, which returns the function
