diff --git a/tccelf.c b/tccelf.c
index ffa2480..5245283 100644
--- a/tccelf.c
+++ b/tccelf.c
@@ -1014,13 +1014,217 @@ static struct sym_attr * put_got_entry(TCCState *s1, int dyn_reloc_type,
     return attr;
 }
 
+#if defined TCC_TARGET_X86_64 || defined TCC_TARGET_I386
+/* Each IFUNC an executable defines gets a GOT entry and a stub in .iplt,
+   `jmp *entry`, which every relocation of the IFUNC takes, as GNU ld makes
+   it in an executable that is not position independent.  A dynamic
+   executable's entry has an IRELATIVE relocation, which the dynamic loader
+   applies by calling the resolver.  A static executable has no loader, and
+   musl's startup applies no IRELATIVE relocation: the code that
+   ifunc_entry_code puts before its entry point stores into each entry the
+   function its resolver returns. */
+
+#ifdef TCC_TARGET_X86_64
+#define R_IRELATIVE R_X86_64_IRELATIVE
+#else
+#define R_IRELATIVE R_386_IRELATIVE
+#endif
+
+/* Return the section of the IFUNC stubs and entry code, made if need be. */
+static Section *iplt_section(TCCState *s1)
+{
+    if (!s1->iplt) {
+        s1->iplt = new_section(s1, ".iplt", SHT_PROGBITS,
+                               SHF_ALLOC | SHF_EXECINSTR);
+        s1->iplt->sh_addralign = 16;
+    }
+    return s1->iplt;
+}
+
+/* Return whether a relocation of type 'type' reads a GOT entry. */
+static int ifunc_got_reloc(int type)
+{
+    switch (type) {
+#ifdef TCC_TARGET_X86_64
+    case R_X86_64_GOT32:
+    case R_X86_64_GOT64:
+    case R_X86_64_GOTPCREL:
+    case R_X86_64_GOTPCRELX:
+    case R_X86_64_REX_GOTPCRELX:
+#else
+    case R_386_GOT32:
+    case R_386_GOT32X:
+#endif
+        return 1;
+    }
+    return 0;
+}
+
+/* Return the index of the local symbol of the stub of the IFUNC
+   'sym_index', making the stub and the IFUNC's GOT entry if need be.  A
+   dynamic executable that exports the IFUNC exports it as a function at
+   its stub, of size 0, as GNU ld does, so that dlsym gives the address
+   that the executable's own references take; the resolver's address stays
+   in the IRELATIVE relocation. */
+static int ifunc_stub(TCCState *s1, int sym_index)
+{
+    ElfW(Sym) *sym, *esym;
+    struct sym_attr *attr;
+    Section *iplt;
+    unsigned char *p;
+    unsigned off;
+    int got_sym, dyn_index;
+    const char *name;
+
+    sym = &((ElfW(Sym) *)symtab_section->data)[sym_index];
+    if (s1->dynsym) {
+        attr = get_sym_attr(s1, sym_index, 1);
+        if (attr->plt_sym)
+            return attr->plt_sym;
+        /* The relocation names the IFUNC by its index in symtab_section
+           until fill_local_got_entries gives it the resolver's address, as
+           put_got_entry does for the R_RELATIVE of a local symbol. */
+        attr->got_offset = s1->got->data_offset;
+        section_ptr_add(s1->got, PTR_SIZE);
+        put_elf_reloc(s1->dynsym, s1->got, attr->got_offset, R_IRELATIVE,
+                      sym_index);
+    } else {
+        attr = put_got_entry(s1, R_GLOB_DAT, sym->st_size, sym->st_info,
+                             sym_index);
+        if (attr->plt_sym)
+            return attr->plt_sym;
+    }
+    iplt = iplt_section(s1);
+    got_sym = find_elf_sym(symtab_section, "_GLOBAL_OFFSET_TABLE_");
+    off = iplt->data_offset;
+    p = section_ptr_add(iplt, 8);
+    p[0] = 0xff; /* jmp *entry */
+    p[1] = 0x25;
+#ifdef TCC_TARGET_X86_64
+    write32le(p + 2, 0);
+    put_elf_reloca(symtab_section, iplt, off + 2, R_X86_64_PC32, got_sym,
+                   attr->got_offset - 4);
+#else
+    write32le(p + 2, attr->got_offset);
+    put_elf_reloc(symtab_section, iplt, off + 2, R_386_32, got_sym);
+#endif
+    p[6] = 0x90;
+    p[7] = 0x90;
+    if (s1->dynsym) {
+        sym = &((ElfW(Sym) *)symtab_section->data)[sym_index];
+        name = (char *)symtab_section->link->data + sym->st_name;
+        dyn_index = find_elf_sym(s1->dynsym, name);
+        if (dyn_index) {
+            esym = &((ElfW(Sym) *)s1->dynsym->data)[dyn_index];
+            esym->st_info = ELFW(ST_INFO)(ELFW(ST_BIND)(esym->st_info),
+                                          STT_FUNC);
+            esym->st_value = off;
+            esym->st_size = 0;
+            esym->st_shndx = iplt->sh_num;
+        }
+    }
+    attr->plt_sym = put_elf_sym(symtab_section, off, 8,
+                                ELFW(ST_INFO)(STB_LOCAL, STT_FUNC), 0,
+                                iplt->sh_num, NULL);
+    return attr->plt_sym;
+}
+
+/* Put before the entry point of a static executable the code that calls
+   the resolver of each IFUNC with a GOT entry and stores what it returns in
+   the entry, as glibc's static startup applies IRELATIVE relocations
+   before any constructor runs.  The code keeps the stack pointer and %edx
+   or %rdx, which the ABI gives the entry point, aligns the stack to 16
+   bytes for each call, and jumps to the entry point, whose place it takes
+   in the ELF header. */
+static void ifunc_entry_code(TCCState *s1)
+{
+    ElfW(Sym) *sym;
+    Section *iplt;
+    unsigned char *p;
+    unsigned off, start, got_offset;
+    int i, nb_syms, got_sym, entry_sym, found;
+    const char *entry;
+
+    found = 0;
+    nb_syms = symtab_section->data_offset / sizeof(ElfW(Sym));
+    for (i = 1; i < nb_syms && i < s1->nb_sym_attrs; i++) {
+        sym = &((ElfW(Sym) *)symtab_section->data)[i];
+        if (ELFW(ST_TYPE)(sym->st_info) == STT_GNU_IFUNC &&
+            s1->sym_attrs[i].got_offset)
+            found = 1;
+    }
+    if (!found)
+        return;
+    entry = s1->elf_entry ? s1->elf_entry : "_start";
+    entry_sym = find_elf_sym(symtab_section, entry);
+    if (!entry_sym ||
+        ((ElfW(Sym) *)symtab_section->data)[entry_sym].st_shndx == SHN_UNDEF)
+        tcc_error("%s not defined", entry);
+    got_sym = find_elf_sym(symtab_section, "_GLOBAL_OFFSET_TABLE_");
+    iplt = iplt_section(s1);
+    start = iplt->data_offset;
+#ifdef TCC_TARGET_X86_64
+    p = section_ptr_add(iplt, 5);
+    memcpy(p, "\x52\x48\x83\xec\x08", 5); /* push %rdx; sub $8,%rsp */
+#else
+    p = section_ptr_add(iplt, 4);
+    memcpy(p, "\x52\x83\xec\x0c", 4); /* push %edx; sub $12,%esp */
+#endif
+    for (i = 1; i < nb_syms && i < s1->nb_sym_attrs; i++) {
+        sym = &((ElfW(Sym) *)symtab_section->data)[i];
+        got_offset = s1->sym_attrs[i].got_offset;
+        if (ELFW(ST_TYPE)(sym->st_info) != STT_GNU_IFUNC || !got_offset)
+            continue;
+        off = iplt->data_offset;
+#ifdef TCC_TARGET_X86_64
+        p = section_ptr_add(iplt, 12);
+        p[0] = 0xe8; /* call resolver */
+        write32le(p + 1, 0);
+        put_elf_reloca(symtab_section, iplt, off + 1, R_X86_64_PC32, i, -4);
+        p[5] = 0x48; /* mov %rax,entry(%rip) */
+        p[6] = 0x89;
+        p[7] = 0x05;
+        write32le(p + 8, 0);
+        put_elf_reloca(symtab_section, iplt, off + 8, R_X86_64_PC32, got_sym,
+                       got_offset - 4);
+#else
+        p = section_ptr_add(iplt, 10);
+        p[0] = 0xe8; /* call resolver */
+        write32le(p + 1, -4);
+        put_elf_reloc(symtab_section, iplt, off + 1, R_386_PC32, i);
+        p[5] = 0xa3; /* mov %eax,entry */
+        write32le(p + 6, got_offset);
+        put_elf_reloc(symtab_section, iplt, off + 6, R_386_32, got_sym);
+#endif
+    }
+    off = iplt->data_offset;
+#ifdef TCC_TARGET_X86_64
+    p = section_ptr_add(iplt, 10);
+    memcpy(p, "\x48\x83\xc4\x08\x5a\xe9", 6); /* add $8,%rsp; pop %rdx */
+    write32le(p + 6, 0);
+    put_elf_reloca(symtab_section, iplt, off + 6, R_X86_64_PC32, entry_sym,
+                   -4);
+#else
+    p = section_ptr_add(iplt, 9);
+    memcpy(p, "\x83\xc4\x0c\x5a\xe9", 5); /* add $12,%esp; pop %edx */
+    write32le(p + 5, -4);
+    put_elf_reloc(symtab_section, iplt, off + 5, R_386_PC32, entry_sym);
+#endif
+    put_elf_sym(symtab_section, start, iplt->data_offset - start,
+                ELFW(ST_INFO)(STB_GLOBAL, STT_FUNC), STV_HIDDEN,
+                iplt->sh_num, ".iplt.entry");
+    tcc_free(s1->elf_entry);
+    s1->elf_entry = tcc_strdup(".iplt.entry");
+}
+#endif
+
 /* build GOT and PLT entries */
 ST_FUNC void build_got_entries(TCCState *s1)
 {
     Section *s;
     ElfW_Rel *rel;
     ElfW(Sym) *sym;
-    int i, type, gotplt_entry, reloc_type, sym_index;
+    int i, type, gotplt_entry, reloc_type, sym_index, stub;
     struct sym_attr *attr;
 
     for(i = 1; i < s1->nb_sections; i++) {
@@ -1042,6 +1246,28 @@ ST_FUNC void build_got_entries(TCCState *s1)
                 continue;
             }
 
+#if defined TCC_TARGET_X86_64 || defined TCC_TARGET_I386
+            /* An executable's IFUNC is reached through its stub, whose
+               address is the function's for every reference, a GOT entry's
+               included, as GNU ld makes it in an executable that is not
+               position independent; the direct call below would run the
+               resolver. */
+            if (s1->output_type == TCC_OUTPUT_EXE &&
+                ELFW(ST_TYPE)(sym->st_info) == STT_GNU_IFUNC &&
+                sym->st_shndx != SHN_UNDEF) {
+                if (!s1->got)
+                    build_got(s1);
+                if (gotplt_entry == BUILD_GOT_ONLY)
+                    continue;
+                stub = ifunc_stub(s1, sym_index);
+                rel->r_info = ELFW(R_INFO)(stub, type);
+                if (ifunc_got_reloc(type))
+                    put_got_entry(s1, R_GLOB_DAT, 8,
+                                  ELFW(ST_INFO)(STB_LOCAL, STT_FUNC), stub);
+                continue;
+            }
+#endif
+
             /* Automatically create PLT/GOT [entry] if it is an undefined
 	       reference (resolved at runtime), or the symbol is absolute,
 	       probably created by tcc_add_symbol, and thus on 64-bit
@@ -1379,15 +1605,27 @@ ST_FUNC void fill_got(TCCState *s1)
 static void fill_local_got_entries(TCCState *s1)
 {
     ElfW_Rel *rel;
+    int type;
+    /* a link that made no GOT entry with a relocation, such as an i386
+       library whose code takes absolute addresses, has no reloc section */
+    if (!s1->got->reloc)
+        return;
     for_each_elem(s1->got->reloc, 0, rel, ElfW_Rel) {
-	if (ELFW(R_TYPE)(rel->r_info) == R_RELATIVE) {
+	type = ELFW(R_TYPE)(rel->r_info);
+	/* R_IRELATIVE: an IFUNC's entry, whose relocation ifunc_stub made
+	   as put_got_entry makes this R_RELATIVE */
+	if (type == R_RELATIVE
+#if defined TCC_TARGET_X86_64 || defined TCC_TARGET_I386
+	    || type == R_IRELATIVE
+#endif
+	    ) {
 	    int sym_index = ELFW(R_SYM) (rel->r_info);
 	    ElfW(Sym) *sym = &((ElfW(Sym) *) symtab_section->data)[sym_index];
 	    struct sym_attr *attr = get_sym_attr(s1, sym_index, 0);
 	    unsigned offset = attr->got_offset;
 	    if (offset != rel->r_offset - s1->got->sh_addr)
 	      tcc_error_noabort("huh");
-	    rel->r_info = ELFW(R_INFO)(0, R_RELATIVE);
+	    rel->r_info = ELFW(R_INFO)(0, type);
 #if SHT_RELX == SHT_RELA
 	    rel->r_addend = sym->st_value;
 #else
@@ -2989,6 +3227,10 @@ static int elf_output_file(TCCState *s1, const char *filename)
             ld_declare_symbols(ls);
         }
         build_got_entries(s1);
+#if defined TCC_TARGET_X86_64 || defined TCC_TARGET_I386
+        if (file_type == TCC_OUTPUT_EXE && s1->static_link)
+            ifunc_entry_code(s1);
+#endif
     }
 
     /* we add a section for symbols */
