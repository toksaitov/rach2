+    unused      : 4;
 };
 
 /* function attributes or temporary attributes for parsing */
@@ -787,6 +788,9 @@ struct TCCState {
     /* got & plt handling */
     Section *got;
     Section *plt;
+    /* a static executable's stubs for its IFUNCs and the code that fills
+       their GOT entries before its entry point */
+    Section *iplt;
 
     /* temporary dynamic symbol sections (for dll loading) */
