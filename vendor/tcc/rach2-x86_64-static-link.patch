Link a static x86-64 or i386 executable whose calls and GOT TinyCC 0.9.27
leaves unfilled.

Two faults, each fatal before main.

GNU as since binutils 2.31 writes R_X86_64_PLT32 for every `call` to a global
function, PIC or not, where it wrote R_X86_64_PC32 before. TinyCC gives each
PLT32 relocation a PLT slot and a GOT entry, and relocates the slots only in a
dynamic link: in a static executable the slot's `jmp *disp(%rip)` keeps the
GOT entry's offset as its displacement. musl's crt1.o calls
__libc_start_main that way. The call needs no slot when the executable
defines the function: it is a plain PC-relative call, which is what the first
change makes of it, as TinyCC already did for a local or hidden symbol and as
its later releases do for any symbol an executable defines. An undefined
symbol keeps its slot, and a static link refuses it as before.

TinyCC reaches extern data on x86-64 through the GOT (R_X86_64_GOTPCREL), as
`stdout` in fflush(stdout), and fills a static executable's GOT in fill_got
from the relocations of the sections that refer to it. It called fill_got
after tidy_section_headers, which drops the unnamed relocation sections from
the section table, so fill_got found none and every entry stayed 0. The
second change fills the GOT before, and the call after then finds nothing
more to fill.

The i386 compiler has the same two faults. Its own code calls by
R_386_PC32 and reaches data by absolute address, but its runtime, libtcc1.a,
is built by GCC with the -fPIC of lib/Makefile, and a call from one runtime
function to another is R_386_PLT32. Its slot, `jmp *n`, kept the GOT
entry's offset n as an absolute address, so every conversion of a floating
value to a 64-bit or a 32-bit integer, which calls __fixdfdi, __fixsfdi or
__fixxfdi and they __fixunsdfdi and its kind, faulted reading 0x14 or 0x18.
The first change makes such a call a plain R_386_PC32 call, and the second
fills the entries of R_386_GOT32 and R_386_GOT32X, which PIC code reads
data through, before the relocation sections are dropped. The x86-64
relocation types fill_got lists are other relocations on i386, where
R_386_GOTOFF has the number of R_X86_64_GOTPCREL, so each target lists its
own.

--- a/tccelf.c
+++ b/tccelf.c
@@ -1081,10 +1081,22 @@ ST_FUNC void build_got_entries(TCCState *s1)
 #ifdef TCC_TARGET_X86_64
             if ((type == R_X86_64_PLT32 || type == R_X86_64_PC32) &&
                 (ELFW(ST_VISIBILITY)(sym->st_other) != STV_DEFAULT ||
-		 ELFW(ST_BIND)(sym->st_info) == STB_LOCAL)) {
+		 ELFW(ST_BIND)(sym->st_info) == STB_LOCAL ||
+		 (s1->output_type == TCC_OUTPUT_EXE &&
+		  sym->st_shndx != SHN_UNDEF))) {
                 rel->r_info = ELFW(R_INFO)(sym_index, R_X86_64_PC32);
                 continue;
             }
+#endif
+#ifdef TCC_TARGET_I386
+            if (type == R_386_PLT32 &&
+                (ELFW(ST_VISIBILITY)(sym->st_other) != STV_DEFAULT ||
+                 ELFW(ST_BIND)(sym->st_info) == STB_LOCAL ||
+                 (s1->output_type == TCC_OUTPUT_EXE &&
+                  sym->st_shndx != SHN_UNDEF))) {
+                rel->r_info = ELFW(R_INFO)(sym_index, R_386_PC32);
+                continue;
+            }
 #endif
             if (code_reloc(type)) {
             jmp_slot:
@@ -1342,11 +1354,17 @@ ST_FUNC void fill_got(TCCState *s1)
             continue;
         for_each_elem(s, 0, rel, ElfW_Rel) {
             switch (ELFW(R_TYPE) (rel->r_info)) {
+#ifdef TCC_TARGET_I386
+                case R_386_GOT32:
+                case R_386_GOT32X:
+                case R_386_PLT32:
+#else
                 case R_X86_64_GOT32:
                 case R_X86_64_GOTPCREL:
 		case R_X86_64_GOTPCRELX:
 		case R_X86_64_REX_GOTPCRELX:
                 case R_X86_64_PLT32:
+#endif
                     fill_got_entry(s1, rel);
                     break;
             }
@@ -2212,6 +2230,14 @@ static int elf_output_file(TCCState *s1, const char *filename)
         ret = final_sections_reloc(s1);
         if (ret)
             goto the_end;
+#if defined TCC_TARGET_X86_64 || defined TCC_TARGET_I386
+        /* A static executable's GOT is filled from the relocations of the
+           sections that refer to it, which tidy_section_headers drops from
+           the section table, so it is filled before; the call below then
+           finds nothing more to fill. */
+        if (file_type == TCC_OUTPUT_EXE && s1->static_link)
+            fill_got(s1);
+#endif
 	tidy_section_headers(s1, sec_order);
 
         /* Perform relocation to GOT or PLT entries */
