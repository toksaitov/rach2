-            if (vtop[-1].type.t & VT_VLA)
+            if (vtop[-1].type.t & VT_VLA) {
                 vla_runtime_pointed_size(&vtop[-1].type);
-            else {
+#if PTR_SIZE == 8
+                /* the int size of a VLA, widened so that the index is
+                   too and the pointer takes all 64 bits of the product */
+                gen_cast_s(VT_LLONG);
+#endif
+            } else {
                 u = pointed_size(&vtop[-1].type);
                 if (u < 0)
                     tcc_error("unknown array element size");
@@ -2619,6 +2624,16 @@ static void gen_cast(CType *type)
 #error
 #endif
                     }
+#if defined(TCC_TARGET_X86_64)
+                    else {
+                        /* x86_64 specific: movl r, r clears the high half,
+                           which a 64-bit value cast to unsigned int in this
+                           register still holds */
+                        int r = gv(RC_INT);
+                        o(0x89);
+                        o(0xc0 + (REG_VALUE(r) << 3) + REG_VALUE(r));
+                    }
+#endif
                 }
