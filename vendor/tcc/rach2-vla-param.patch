+/* Make the parameter 'v' of type 'type' visible to the bounds of the
+   parameters after it, as C99 6.2.1p4 and p7 say, until post_type pops
+   param_stack at the end of its list.  Its scope is one of its own, below
+   any open block, so that it may hide a global or local of the same name
+   and two parameters of one name are an error.  The symbol is only ever
+   evaluated under nocode_wanted. */
+static void param_push(int v, CType *type)
+{
+    Sym *s, **ps;
+
+    s = sym_push2(&param_stack, v, type->t, 0);
+    s->type.ref = type->ref;
+    s->r = VT_LOCAL | lvalue_type(type->t);
+    ps = &table_ident[v - TOK_IDENT]->sym_identifier;
+    s->prev_tok = *ps;
+    *ps = s;
+    s->sym_scope = local_scope + param_depth;
+    if (s->prev_tok && s->prev_tok->sym_scope == s->sym_scope)
+        tcc_error("redeclaration of '%s'", get_tok_str(v, NULL));
+}
+
+/* Read the tokens of a parameter's array bound up to the ']' that closes
+   it, which is left the current token, and return them ending in TOK_EOF. */
+static TokenString *param_bound_save(void)
+{
+    TokenString *str;
+    int nest;
+
+    str = tok_str_alloc();
+    for (nest = 0; nest > 0 || tok != ']'; next()) {
+        if (tok == TOK_EOF)
+            expect("']'");
+        if (tok == '[')
+            nest++;
+        else if (tok == ']')
+            nest--;
+        tok_str_add_tok(str);
+    }
+    tok_str_add(str, TOK_EOF);
+    tok_str_add(str, 0);
+    return str;
+}
+
+/* Evaluate the saved tokens of an array bound with gexpr, leaving the
+   value on the value stack and the current token as it was. */
+static void param_bound_eval(TokenString *str)
+{
+    unget_tok(0);
+    begin_macro(str, 2);
+    next();
+    gexpr();
+    if (tok != TOK_EOF)
+        expect("']'");
+    end_macro();
+    next();
+}
