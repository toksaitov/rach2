+/* Give the VLA 'type' points to, and each VLA inside it, its size slot, from
+   the innermost out, so that an index or sizeof finds the size there. */
+static void vla_param_size(CType *type)
+{
+    Sym *s;
+    int align;
+
+    if ((type->t & VT_BTYPE) != VT_PTR)
+        return;
+    s = type->ref;
+    vla_param_size(&s->type);
+    if (!(type->t & VT_VLA))
+        return;
+    if (!s->vla_bound)
+        tcc_error("'[*]' not allowed in a function definition");
+    loc -= type_size(&size_type, &align);
+    loc &= -align;
+    s->c = loc;
+    param_bound_eval(s->vla_bound);
+    vla_runtime_type_size(&s->type, &align);
+    gen_op('*');
+    vset(&size_type, VT_LOCAL|VT_LVAL, s->c);
+    vswap();
+    vstore();
+    vpop();
+}
+
+/* On entry to the function 'sym', after gfunc_prolog has made its
+   parameters locals, evaluate the bounds of its variably modified
+   parameters, as C99 6.9.1p10 says: the outermost one of an array
+   parameter, which its adjustment to a pointer leaves no use but its side
+   effects, and those of the VLAs the parameter points to. */
+static void func_vla_params(Sym *sym)
+{
+    Sym *arg, *s;
+
+    for (arg = sym->type.ref->next; arg; arg = arg->next) {
+        if ((arg->type.t & VT_BTYPE) != VT_PTR)
+            continue;
+        s = arg->type.ref;
+        if (s->vla_bound) {
+            param_bound_eval(s->vla_bound);
+            vpop();
+        }
+        vla_param_size(&s->type);
+    }
+}
