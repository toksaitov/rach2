+/* Read the tokens of a parameter's array bound up to the ']' that closes
+   it, which is left the current token, and return them ending in TOK_EOF. */
+static TokenString *param_bound_save(void)
+{
+    TokenString *str;
+    int nest;
+
+    str = tok_str_alloc();
+    for (nest = 0; nest > 0 || tok != ']'; next()) {
+        if (tok == TOK_EOF)
+            expect("']'");
+        if (tok == '[')
+            nest++;
+        else if (tok == ']')
+            nest--;
+        tok_str_add_tok(str);
+    }
+    tok_str_add(str, TOK_EOF);
+    tok_str_add(str, 0);
+    return str;
+}
+
+/* Evaluate the saved tokens of an array bound with gexpr, leaving the
+   value on the value stack and the current token as it was. */
+static void param_bound_eval(TokenString *str)
+{
+    unget_tok(0);
+    begin_macro(str, 2);
+    next();
+    gexpr();
+    if (tok != TOK_EOF)
+        expect("']'");
+    end_macro();
+    next();
+}
