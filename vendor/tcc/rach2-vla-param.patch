+/* Make the parameter 'v' of type 'type', whose symbol in its function's
+   list is 'field', visible to the bounds of the parameters after it, as
+   C99 6.2.1p4 and p7 say, until the end of its list pops param_stack.  Its
+   scope is one of its own, below any open block, so that it may hide a
+   global or local of the same name and two parameters of one name are an
+   error.  The symbol is only ever evaluated under nocode_wanted. */
+static void param_push(int v, CType *type, Sym *field)
+{
+    Sym *s, **ps;
+
+    field->vla_seen = ++param_seen;
+    s = sym_push2(&param_stack, v, type->t, 0);
+    s->type.ref = type->ref;
+    s->r = VT_LOCAL | lvalue_type(type->t);
+    ps = &table_ident[v - TOK_IDENT]->sym_identifier;
+    s->prev_tok = *ps;
+    *ps = s;
+    s->sym_scope = local_scope + param_depth;
+    if (s->prev_tok && s->prev_tok->sym_scope == s->sym_scope)
+        tcc_error("redeclaration of '%s'", get_tok_str(v, NULL));
+}
