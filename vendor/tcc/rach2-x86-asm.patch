+/* The operand size, in bits, that the suffix of a mnemonic gives an
+   instruction whose operand is implicit or a pointer in memory; 0 for
+   every other one, whose size its operands or its table entry give. */
+static int mnemonic_size(int opcode)
+{
+    switch (opcode) {
+    case TOK_ASM_cbw: case TOK_ASM_cbtw: case TOK_ASM_cwd: case TOK_ASM_cwtd:
+    case TOK_ASM_pushfw: case TOK_ASM_popfw:
+    case TOK_ASM_pushaw: case TOK_ASM_popaw:
+    case TOK_ASM_iretw: case TOK_ASM_lretw: case TOK_ASM_retw:
+    case TOK_ASM_ljmpw: case TOK_ASM_lcallw:
+    case TOK_ASM_lgdtw: case TOK_ASM_lidtw: case TOK_ASM_sgdtw: case TOK_ASM_sidtw:
+        return 16;
+    case TOK_ASM_cwde: case TOK_ASM_cwtl: case TOK_ASM_cdq: case TOK_ASM_cltd:
+    case TOK_ASM_pushfl: case TOK_ASM_popfl:
+    case TOK_ASM_pushal: case TOK_ASM_popal:
+    case TOK_ASM_iretl: case TOK_ASM_lretl: case TOK_ASM_retl:
+    case TOK_ASM_ljmpl: case TOK_ASM_lcalll:
+    case TOK_ASM_lgdtl: case TOK_ASM_lidtl: case TOK_ASM_sgdtl: case TOK_ASM_sidtl:
+        return 32;
+#ifdef TCC_TARGET_X86_64
+    case TOK_ASM_cqto: case TOK_ASM_pushfq: case TOK_ASM_popfq:
+    case TOK_ASM_iretq: case TOK_ASM_lretq: case TOK_ASM_retq:
+    case TOK_ASM_lgdtq: case TOK_ASM_lidtq: case TOK_ASM_sgdtq: case TOK_ASM_sidtq:
+        return 64;
+#endif
+    }
+    return 0;
