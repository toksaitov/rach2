+   pops of the flags, the near return, and the loads and stores of the
+   descriptor-table registers, and 32 for the others. */
+static int unprefixed_size(TCCState *s1, int opcode)
+{
+    if (s1->seg_size != 64)
+        return s1->seg_size;
+#ifdef TCC_TARGET_X86_64
+    switch (opcode) {
+    case TOK_ASM_pushfw: case TOK_ASM_pushfl: case TOK_ASM_pushfq:
+    case TOK_ASM_popfw: case TOK_ASM_popfl: case TOK_ASM_popfq:
+    case TOK_ASM_retw: case TOK_ASM_retl: case TOK_ASM_retq:
+    case TOK_ASM_lgdtw: case TOK_ASM_lgdtl: case TOK_ASM_lgdtq:
+    case TOK_ASM_lidtw: case TOK_ASM_lidtl: case TOK_ASM_lidtq:
+    case TOK_ASM_sgdtw: case TOK_ASM_sgdtl: case TOK_ASM_sgdtq:
+    case TOK_ASM_sidtw: case TOK_ASM_sidtl: case TOK_ASM_sidtq:
+        return 64;
+    }
+#endif
+    return 32;
+}
