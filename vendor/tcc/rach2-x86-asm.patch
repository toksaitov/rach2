+/* Emit the prefix that gives a sized instruction the operand size its
+   mnemonic names: none, the operand-size prefix 0x66, or REX.W. */
+static void asm_size_prefix(TCCState *s1, int opcode, int size)
+{
+    int plain = unprefixed_size(s1, opcode);
+
+    if (size == plain)
+        return;
+    if (size == 64) {
+        if (s1->seg_size != 64)
+            tcc_error("'%s' is not available in %d-bit code",
+                      get_tok_str(opcode, NULL), s1->seg_size);
+        g(0x48);
+    } else if (plain == 64 && size == 32) {
+        tcc_error("'%s' is not available in 64-bit code",
+                  get_tok_str(opcode, NULL));
+    } else {
+        g(0x66);
+    }
+}
