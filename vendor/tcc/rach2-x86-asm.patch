+#ifdef TCC_TARGET_X86_64
+    if (s1->seg_size == 64 &&
+        (opcode == TOK_ASM_pusha || opcode == TOK_ASM_pushaw ||
+         opcode == TOK_ASM_pushal || opcode == TOK_ASM_popa ||
+         opcode == TOK_ASM_popaw || opcode == TOK_ASM_popal))
+        tcc_error("'%s' is not available in 64-bit code",
+                  get_tok_str(opcode, NULL));
+#endif
+    if (size) {
+        /* the code's own prefix, 0x66 or REX.W, is the size's */
+        if ((b >> 8) == 0x66 || (b >> 8) == 0x48)
+            b &= 0xff;
+        asm_size_prefix(s1, opcode, size);
+    }
