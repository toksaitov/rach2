+/* The kind of a key event, as the Kitty keyboard protocol reports it. */
+enum tsm_vte_key_event {
+	TSM_VTE_KEY_PRESS	= 1,
+	TSM_VTE_KEY_REPEAT	= 2,
+	TSM_VTE_KEY_RELEASE	= 3,
+};
