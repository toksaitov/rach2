+ *   4  Control      128  Num Lock (TSM_NUM_LOCK_MASK)
+ *
+ * and event is 2 for a repeat and 3 for a release. Flag 4 adds the shifted
+ * key and the base layout's key after key, separated by colons.
+ */
+
+/* A key the protocol numbers: its keysym, its number and final byte, and
+ * whether it is a modifier, which flags 1, 2 and 4 do not report. */
+struct kitty_key {
+	uint32_t keysym;
+	uint16_t num;
+	char final;
+	bool modifier;
+};
