+
+static const struct kitty_key *kitty_key_find(uint32_t keysym)
+{
+	size_t i;
+
+	for (i = 0; i < sizeof(kitty_keys) / sizeof(kitty_keys[0]); ++i) {
+		if (kitty_keys[i].keysym == keysym)
+			return &kitty_keys[i];
+	}
+	return NULL;
+}
+
+/* whether c is a code point the protocol may report: not a control */
+static bool kitty_printable(uint32_t c)
+{
+	return c != TSM_VTE_INVALID && c >= 0x20 && c != 0x7f &&
+	       !(c >= 0x80 && c <= 0x9f) && c <= 0x10ffff;
+}
+
+/* Send a key under the flags in effect, which are not 0. */
+static bool vte_kitty_key(struct tsm_vte *vte, unsigned int flags,
+			  uint32_t keysym, uint32_t ascii, unsigned int mods,
+			  uint32_t unicode, uint32_t unshifted, uint32_t base,
+			  unsigned int event)
+{
+	const struct kitty_key *info;
+	unsigned int sig, encoded;
+	uint32_t key, shifted;
+	bool text, alt_shifted, alt_base;
+	char buf[128], ev[3];
+	char final;
+	int len;
+
+	if (!(flags & KITTY_KBD_REPORT_EVENTS)) {
+		if (event == TSM_VTE_KEY_RELEASE)
+			return false;
+		event = TSM_VTE_KEY_PRESS;
+	}
+
+	/* Without flag 1, a press is sent as without the protocol. */
+	if (!(flags & KITTY_KBD_DISAMBIGUATE) && event == TSM_VTE_KEY_PRESS)
+		return vte_legacy_key(vte, keysym, ascii, mods, unicode);
+
+	info = kitty_key_find(keysym);
+	if (info && info->modifier)
+		return false;
+
+	sig = mods & (TSM_SHIFT_MASK | TSM_ALT_MASK | TSM_CONTROL_MASK |
+		      TSM_LOGO_MASK);
+
+	/* Enter, Tab and Backspace without modifiers send their legacy
+	 * bytes, and no release, so that a shell stays usable after a
+	 * program that set the flags dies. */
+	if (!sig && (keysym == XKB_KEY_Return || keysym == XKB_KEY_Tab ||
+		     keysym == XKB_KEY_BackSpace)) {
+		if (event == TSM_VTE_KEY_RELEASE)
+			return false;
+		return vte_legacy_key(vte, keysym, ascii, mods, unicode);
+	}
+
+	/* A key that gives text with no modifier but Shift and the locks
+	 * sends the text, as kitty does. */
+	text = kitty_printable(unicode) &&
+	       !(mods & (TSM_ALT_MASK | TSM_CONTROL_MASK | TSM_LOGO_MASK));
+	if (text && event != TSM_VTE_KEY_RELEASE) {
+		vte_write_key_text(vte, unicode);
+		return true;
+	}
+
+	if (info) {
+		key = info->num;
+		final = info->final;
+		shifted = 0;
+		base = 0;
+	} else {
+		if (!kitty_printable(unicode))
+			return false;
+		shifted = unicode;
+		if (kitty_printable(unshifted))
+			key = unshifted;
+		else if (unicode >= 'A' && unicode <= 'Z')
+			key = unicode - 'A' + 'a';
+		else
+			key = unicode;
+		final = 'u';
+	}
+
+	encoded = 1;
+	if (mods & TSM_SHIFT_MASK)
+		encoded += 1;
+	if (mods & TSM_ALT_MASK)
+		encoded += 2;
+	if (mods & TSM_CONTROL_MASK)
+		encoded += 4;
+	if (mods & TSM_LOGO_MASK)
+		encoded += 8;
+	if (mods & TSM_LOCK_MASK)
+		encoded += 64;
+	if (mods & TSM_NUM_LOCK_MASK)
+		encoded += 128;
+
+	/* kitty leaves out the event of a press, which is the default. */
+	ev[0] = '\0';
+	if (event == TSM_VTE_KEY_REPEAT || event == TSM_VTE_KEY_RELEASE) {
+		ev[0] = ':';
+		ev[1] = event == TSM_VTE_KEY_REPEAT ? '2' : '3';
+		ev[2] = '\0';
+	}
+
+	if (final == 'u' || final == '~') {
+		len = snprintf(buf, sizeof(buf), "\e[%u", key);
+
+		/* The shifted key only with Shift; the base layout's key
+		 * when it differs from both. */
+		if (flags & KITTY_KBD_REPORT_ALTERNATES) {
+			alt_shifted = (mods & TSM_SHIFT_MASK) &&
+				      kitty_printable(shifted) &&
+				      shifted != key;
+			alt_base = kitty_printable(base) && base != key &&
+				   (!alt_shifted || base != shifted);
+			if (alt_shifted)
+				len += snprintf(buf + len, sizeof(buf) - len,
+						":%u", shifted);
+			if (alt_base)
+				len += snprintf(buf + len, sizeof(buf) - len,
+						"%s:%u", alt_shifted ? "" : ":",
+						base);
+		}
+
+		if (encoded > 1 || ev[0])
+			len += snprintf(buf + len, sizeof(buf) - len, ";%u%s",
+					encoded, ev);
+		len += snprintf(buf + len, sizeof(buf) - len, "%c", final);
+	} else if (encoded > 1 || ev[0]) {
+		len = snprintf(buf, sizeof(buf), "\e[1;%u%s%c", encoded, ev,
+			       final);
+	} else {
+		len = snprintf(buf, sizeof(buf), "\e[%c", final);
+	}
+
+	vte->flags &= ~TSM_VTE_FLAG_PREPEND_ESCAPE;
+	vte_write(vte, buf, len);
+	return true;
+}
+
+SHL_EXPORT
+bool tsm_vte_handle_key(struct tsm_vte *vte, uint32_t keysym, uint32_t ascii,
+			unsigned int mods, uint32_t unicode,
+			uint32_t unshifted, uint32_t base, unsigned int event)
+{
+	unsigned int flags;
+
+	if (!vte)
+		return false;
+
+	flags = kitty_kbd_flags(vte);
+	if (flags)
+		return vte_kitty_key(vte, flags, keysym, ascii, mods, unicode,
+				     unshifted, base, event);
+
+	if (event == TSM_VTE_KEY_RELEASE)
+		return false;
+	return vte_legacy_key(vte, keysym, ascii, mods, unicode);
+}
+
 SHL_EXPORT
 bool tsm_vte_handle_keyboard(struct tsm_vte *vte, uint32_t keysym,
 			     uint32_t ascii, unsigned int mods,
 			     uint32_t unicode)
+{
+	return tsm_vte_handle_key(vte, keysym, ascii, mods, unicode,
+				  TSM_VTE_INVALID, TSM_VTE_INVALID,
+				  TSM_VTE_KEY_PRESS);
+}
