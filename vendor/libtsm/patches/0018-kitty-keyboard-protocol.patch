+/**
+ * @brief Send a key event to the application.
+ *
+ * Without the Kitty keyboard protocol's flags, a press or a repeat is sent as
+ * tsm_vte_handle_keyboard() sends it, in xterm's encoding, and a release
+ * sends nothing. Once the application has set flags with CSI = u or pushed
+ * them with CSI > u, the key is sent as the protocol says for flags 1
+ * (disambiguate), 2 (repeat and release events) and 4 (alternate keys); the
+ * library supports no other flag, and drops them from a set or a push. The
+ * main and the alternate screen each have their own stack of flags.
+ *
+ * @param vte The vte object
+ * @param keysym The key's keysym under the modifiers and the layout in effect
+ * @param ascii The keysym the key has in an ASCII layout, which Control
+ *              combines with, or XKB_KEY_NoSymbol
+ * @param mods The modifiers and locks held, TSM_*_MASK
+ * @param unicode The character the key gives, before Control, or
+ *                TSM_VTE_INVALID; the protocol's shifted key
+ * @param unshifted The character the key gives with no modifier in the
+ *                  layout in effect, or TSM_VTE_INVALID; the protocol's key
+ *                  code, which is the lower case of \c unicode when invalid
+ * @param base The character the key gives with no modifier in the base
+ *             layout, US PC-101, or TSM_VTE_INVALID; the protocol's base
+ *             layout key
+ * @param event TSM_VTE_KEY_PRESS, TSM_VTE_KEY_REPEAT or TSM_VTE_KEY_RELEASE
+ *
+ * @retval true if bytes were sent to the application.
+ */
+bool tsm_vte_handle_key(struct tsm_vte *vte, uint32_t keysym, uint32_t ascii,
+			unsigned int mods, uint32_t unicode,
+			uint32_t unshifted, uint32_t base, unsigned int event);
+
+/**
