+/* the Kitty keyboard protocol's stack of the screen in use */
+static unsigned int kitty_kbd_screen(struct tsm_vte *vte)
+{
+	return (tsm_screen_get_flags(vte->con) & TSM_SCREEN_ALTERNATE) ? 1 : 0;
+}
+
+/* the Kitty keyboard protocol's flags in effect on the screen in use */
+static unsigned int kitty_kbd_flags(struct tsm_vte *vte)
+{
+	unsigned int i = kitty_kbd_screen(vte);
+
+	return vte->kitty_kbd[i].flags[vte->kitty_kbd[i].top];
+}
+
+/*
+ * The Kitty keyboard protocol's requests: CSI ? u queries the flags, CSI >
+ * flags u pushes them, CSI < n u pops n entries and CSI = flags ; mode u sets
+ * them. The flags this library does not support are dropped, so that a query
+ * after a set tells the application what took effect.
+ */
+static void csi_kitty_kbd(struct tsm_vte *vte)
+{
+	unsigned int i = kitty_kbd_screen(vte);
+	unsigned int *top = &vte->kitty_kbd[i].top;
+	unsigned int *flags = vte->kitty_kbd[i].flags;
+	int arg = vte->csi_argv[0];
+	char buf[32];
+	int n, len;
+
+	if (vte->csi_flags & CSI_WHAT) {
+		len = snprintf(buf, sizeof(buf), "\e[?%uu", flags[*top]);
+		vte_write(vte, buf, len);
+	} else if (vte->csi_flags & CSI_GT) {
+		*top = (*top + 1) % KITTY_KBD_STACK_MAX;
+		flags[*top] = (arg > 0 ? arg : 0) & KITTY_KBD_SUPPORTED;
+	} else if (vte->csi_flags & CSI_LT) {
+		/* Popping more entries than were pushed leaves no flags. */
+		n = arg > 0 ? arg : 1;
+		if (n > KITTY_KBD_STACK_MAX)
+			n = KITTY_KBD_STACK_MAX;
+		while (n-- > 0) {
+			flags[*top] = 0;
+			*top = (*top + KITTY_KBD_STACK_MAX - 1) %
+			       KITTY_KBD_STACK_MAX;
+		}
+	} else if (vte->csi_flags & CSI_EQUAL) {
+		arg = (arg > 0 ? arg : 0) & KITTY_KBD_SUPPORTED;
+		switch (vte->csi_argc >= 2 ? vte->csi_argv[1] : -1) {
+		case -1:
+		case 0:
+		case 1:
+			flags[*top] = arg;
+			break;
+		case 2:
+			flags[*top] |= arg;
+			break;
+		case 3:
+			flags[*top] &= ~arg;
+			break;
+		default:
+			llog_debug(vte, "unhandled CSI = u mode %d",
+				   vte->csi_argv[1]);
+		}
+	}
+}
