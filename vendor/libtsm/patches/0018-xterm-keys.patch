+/*
+ * The control character Control makes of the ASCII character c, as Xlib and
+ * xterm make it, or -1 when Control leaves c as it is.
+ */
+static int key_ctrl_char(uint32_t c)
+{
+	if ((c >= '@' && c <= '~') || c == ' ')
+		return c & 0x1f;
+	if (c == '2')
+		return 0x00;
+	if (c >= '3' && c <= '7')
+		return c - '3' + 0x1b;
+	if (c == '8' || c == '?')
+		return 0x7f;
+	if (c == '/')
+		return 0x1f;
+	return -1;
+}
