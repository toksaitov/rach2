+ * The legacy key encoding is xterm's, with its default resources and
+ * numLock true. A key that is not text is sent as CSI number ~ or CSI final,
+ * or SS3 final for F1 to F4 and, in cursor key mode, for the cursor keys,
+ * Home and End. With modifiers, every such key is CSI number ; m final, with
+ * number 1 for a key that has none, where m is 1 plus the sum of
+ *
+ *   1  Shift
+ *   2  Alt
+ *   4  Control
+ *
+ * Alt is then part of m and does not prepend ESC. The keypad's keys that give
+ * text send it, whatever the modifiers, unless the keypad is in application
+ * mode with Num Lock off; they then send SS3 final, or SS3 m final with
+ * modifiers.
+ */
+
+/* xterm's modifier parameter for mods, or 0 for none of its modifiers */
+static unsigned int key_mod_param(unsigned int mods)
+{
+	unsigned int m = 0;
+
+	if (mods & TSM_SHIFT_MASK)
+		m |= 1;
+	if (mods & TSM_ALT_MASK)
+		m |= 2;
+	if (mods & TSM_CONTROL_MASK)
+		m |= 4;
+
+	return m ? m + 1 : 0;
 }
 
