+/*
+ * DECRQM, CSI Ps $ p for an ANSI mode and CSI ? Ps $ p for a DEC private
+ * one: answer CSI Ps ; Pm $ y, or CSI ? Ps ; Pm $ y, with the mode's state.
+ */
+static void csi_decrqm(struct tsm_vte *vte)
+{
+	char buf[64];
+	bool dec = vte->csi_flags & CSI_WHAT;
+	int mode = vte->csi_argv[0];
+	int state, len;
+
+	if (vte->csi_flags & ~(CSI_WHAT | CSI_CASH))
+		return;
+
+	if (mode < 0)
+		mode = 0;
+	state = dec ? dec_mode_state(vte, mode) : ansi_mode_state(vte, mode);
+	len = snprintf(buf, sizeof(buf), "\e[%s%d;%d$y", dec ? "?" : "",
+		       mode, state);
+	if (len > 0 && (size_t)len < sizeof(buf))
+		vte_write(vte, buf, len);
+}
