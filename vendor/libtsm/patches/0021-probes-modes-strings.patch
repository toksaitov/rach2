+/* the state of the ANSI mode \mode, as DECRQM reports it */
+static int ansi_mode_state(struct tsm_vte *vte, int mode)
+{
+	unsigned int flag;
+
+	switch (mode) {
+	case 2: /* KAM */
+		flag = TSM_VTE_FLAG_KEYBOARD_ACTION_MODE;
+		break;
+	case 4: /* IRM */
+		flag = TSM_VTE_FLAG_INSERT_REPLACE_MODE;
+		break;
+	case 12: /* SRM */
+		flag = TSM_VTE_FLAG_SEND_RECEIVE_MODE;
+		break;
+	case 20: /* LNM */
+		flag = TSM_VTE_FLAG_LINE_FEED_NEW_LINE_MODE;
+		break;
+	default:
+		return DECRQM_UNKNOWN;
+	}
+
+	return (vte->flags & flag) ? DECRQM_SET : DECRQM_RESET;
+}
+
+/*
+ * The state of the DEC private mode \mode, as DECRQM reports it: every mode
+ * csi_mode() takes. Modes it accepts and ignores are fixed, DECANM set and
+ * the others reset; the blinking cursor's mode 12, which it does not track,
+ * and mode 2027, grapheme clustering, which it does not implement, are not
+ * recognized, so that an application does not rely on them.
+ */
+static int dec_mode_state(struct tsm_vte *vte, int mode)
+{
+	unsigned int flag;
+	bool alt;
+
+	switch (mode) {
+	case 1: /* DECCKM */
+		flag = TSM_VTE_FLAG_CURSOR_KEY_MODE;
+		break;
+	case 2: /* DECANM */
+		return DECRQM_ALWAYS_SET;
+	case 3: /* DECCOLM */
+	case 4: /* DECSCLM */
+	case 18: /* DECPFF */
+	case 19: /* DECPEX */
+		return DECRQM_ALWAYS_RESET;
+	case 5: /* DECSCNM */
+		flag = TSM_VTE_FLAG_INVERSE_SCREEN_MODE;
+		break;
+	case 6: /* DECOM */
+		flag = TSM_VTE_FLAG_ORIGIN_MODE;
+		break;
+	case 7: /* DECAWM */
+		flag = TSM_VTE_FLAG_AUTO_WRAP_MODE;
+		break;
+	case 8: /* DECARM */
+		flag = TSM_VTE_FLAG_AUTO_REPEAT_MODE;
+		break;
+	case 25: /* DECTCEM */
+		flag = TSM_VTE_FLAG_TEXT_CURSOR_MODE;
+		break;
+	case 42: /* DECNRCM */
+		flag = TSM_VTE_FLAG_NATIONAL_CHARSET_MODE;
+		break;
+	case TSM_VTE_MOUSE_MODE_X10:
+	case TSM_VTE_MOUSE_MODE_VT200:
+	case TSM_VTE_MOUSE_MODE_SGR:
+	case TSM_VTE_MOUSE_MODE_PIXEL:
+		return (int)vte->mouse_mode == mode ? DECRQM_SET :
+						      DECRQM_RESET;
+	case TSM_VTE_MOUSE_EVENT_BTN:
+	case TSM_VTE_MOUSE_EVENT_ANY:
+		return (int)vte->mouse_event == mode ? DECRQM_SET :
+						       DECRQM_RESET;
+	case 47:
+	case 1047:
+	case 1049:
+		alt = tsm_screen_get_flags(vte->con) & TSM_SCREEN_ALTERNATE;
+		return alt ? DECRQM_SET : DECRQM_RESET;
+	case 1048:
+		return vte->alt_cursor_saved ? DECRQM_SET : DECRQM_RESET;
+	case MODE_FOCUS_EVENTS:
+		return vte->focus_events ? DECRQM_SET : DECRQM_RESET;
+	case TSM_VTE_BRACKETED_PASTE:
+		return vte->bracketed_paste ? DECRQM_SET : DECRQM_RESET;
+	case MODE_SYNC_OUTPUT:
+		return vte->sync_hold ? DECRQM_SET : DECRQM_RESET;
+	case MODE_GRAPHEME_CLUSTERS:
+	default:
+		return DECRQM_UNKNOWN;
+	}
+
+	return (vte->flags & flag) ? DECRQM_SET : DECRQM_RESET;
+}
