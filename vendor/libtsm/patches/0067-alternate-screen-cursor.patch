 						       TSM_SCREEN_ALTERNATE);
-				tsm_screen_move_to(vte->con, vte->alt_cursor_x,
-						   vte->alt_cursor_y);
+				restore_state(vte);
 			}
 			continue;
 		case TSM_VTE_MOUSE_EVENT_BTN:
