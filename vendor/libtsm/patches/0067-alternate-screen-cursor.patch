+++ b/src/tsm/tsm-vte.c
@@ -248,8 +248,6 @@
 	/* DECSC's saved cursor, [0] the main screen's and [1] the
 	 * alternate screen's, as xterm keeps one for each */
 	struct vte_saved_state saved_state[2];
-	unsigned int alt_cursor_x;
-	unsigned int alt_cursor_y;
 
 	/* The Kitty keyboard protocol's stacks of flags, [0] the main
 	 * screen's and [1] the alternate's. top indexes the flags in effect;
@@ -1924,35 +1922,35 @@
