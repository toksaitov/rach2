 				continue;
 
+			/* DECSC and DECRC, as in xterm, in the slot of
+			 * the screen in use */
 			if (set) {
 				vte->alt_cursor_saved = true;
-				vte->alt_cursor_x =
-					tsm_screen_get_cursor_x(vte->con);
-				vte->alt_cursor_y =
-					tsm_screen_get_cursor_y(vte->con);
+				save_state(vte);
 			} else {
-				tsm_screen_move_to(vte->con, vte->alt_cursor_x,
-						   vte->alt_cursor_y);
+				restore_state(vte);
 			}
 			continue;
 		case 1049: /* Alternate screen buffer with pre-erase+cursor */
 			if (vte->flags & TSM_VTE_FLAG_TITE_INHIBIT_MODE)
 				continue;
 
+			/* DECSC before the switch and DECRC after the
+			 * switch back, as in xterm, so that the main
+			 * screen's slot keeps its cursor, attributes,
+			 * character sets and origin mode, and the
+			 * attributes in use on the alternate screen do
+			 * not stay to erase the main screen with */
 			if (set) {
 				vte->alt_cursor_saved = true;
-				vte->alt_cursor_x =
-					tsm_screen_get_cursor_x(vte->con);
-				vte->alt_cursor_y =
-					tsm_screen_get_cursor_y(vte->con);
+				save_state(vte);
 				tsm_screen_set_flags(vte->con,
