+gSnapshot = None
+
+def InitHost():
+  """Connect inspection before terminal setup, so a failed setup closes it."""
+  global gSnapshot
+  if escargs.args.snapshot_socket is not None:
+    gSnapshot = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    gSnapshot.connect(escargs.args.snapshot_socket)
+    gSnapshot.sendall(("pid %d\n" % os.getpid()).encode("ascii"))
+
+def ReadyHost():
+  """Expose startup on the parsed screen before reset can erase the marker."""
+  if gSnapshot is not None:
+    escio.Write("ESCTEST2_READY")
+    reply = b""
+    while not reply.endswith(b"\n"):
+      part = gSnapshot.recv(1)
+      if not part or len(reply) >= 32:
+        raise esctypes.InternalError("Screen controller did not acknowledge startup")
+      reply += part
+    if reply != b"ready\n":
+      raise esctypes.InternalError("Invalid screen controller acknowledgement")
+
+def HostMeasurement(command):
+  """Measure the parsed screen, after a CPR round trip drains preceding output.
+
+  This channel substitutes for inspection only, never a tested terminal reply.
+  Direct DECRQCRA and window-operation tests still use escio's terminal input.
+  """
+  GetCursorPosition()
+  gSnapshot.sendall((command + "\n").encode("ascii"))
+  line = b""
+  while not line.endswith(b"\n"):
+    part = gSnapshot.recv(1)
+    if not part:
+      raise esctypes.InternalError("Screen measurement channel closed")
+    line += part
+    if len(line) > 4096:
+      raise esctypes.InternalError("Screen measurement too long")
+  return line.decode("ascii").split()
+
