+def Drain():
+  """Discard the replies a failed test left unread.
+
+  CAN ends any sequence the terminal is parsing; everything read before
+  XTVERSION's reply, which no test requests, is stale."""
+  Write(chr(0x18) + ESC + "[>q")
+  s = ""
+  while not re.search("\x1bP>\\|[^\x1b]*\x1b\\\\$", s):
+    s += read(1)
+  if not s.startswith(ESC + "P>|"):
+    LogInfo("Drained: " + s.replace(ESC, "<ESC>"))
+
 def read(n):
   """Try to read n bytes. Times out if it takes more than 1
   second to read any given byte."""
