+int init_geom(int fd UNUSEDP, struct device *dev, struct device *orig_dev,
+	      struct MT_STAT *statbuf UNUSEDP)
+{
+#ifdef OS_linux_musl
+	/* musl has no Linux floppy headers, so this target uses the generic
+	 * path. Its block devices still implement the Linux size request.
+	 * The request's encoded size is size_t, but its result is 64 bits. */
+	if (S_ISBLK(statbuf->st_mode)) {
+		uint64_t bytes, sectors;
+		if (ioctl(fd, _IOR(0x12, 114, size_t), &bytes) < 0) {
+			fprintf(stderr, "Could not get size of device (%s)\n",
+				strerror(errno));
+			return -1;
+		}
+		if (bytes > (uint64_t) max_off_t_seek) {
+			fprintf(stderr, "Device exceeds the file offset range\n");
+			errno = EFBIG;
+			return -1;
+		}
+		sectors = bytes / (dev->sector_size ? dev->sector_size : 512);
+		/* Match regular images' saturation, never truncate a wide count. */
+		dev->tot_sectors = sectors > UINT32_MAX ? UINT32_MAX : (uint32_t) sectors;
+	}
+#endif
+	return compare_geom(dev, orig_dev);
+}
 #endif
