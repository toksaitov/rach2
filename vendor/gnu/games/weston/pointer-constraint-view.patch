Description: Start a fullscreen surface's pointer constraint on a view of it
 A pointer constraint on a fullscreen surface was enabled at once on the
 pointer's focus view, whatever that view was. When Xwayland confined the
 pointer to a window that kiosk-shell had made fullscreen but not yet painted,
 the focus was still the shell's background view under it; the lock and
 confine grabs never pick the focus again, and the confine grab's motion
 handler asserts that the focus is a view of the constrained surface, so
 Weston aborted at the pointer's next move. The constraint now starts on the
 focus only when it is a view of the constrained surface, and otherwise on
 the surface's first mapped view, which takes the focus; with no mapped view
 it waits as any other constraint does.
Author: Rach2
Forwarded: no
---
--- a/libweston/input.c
+++ b/libweston/input.c
@@ -4976,15 +4976,33 @@
 
 	if (constraint) {
 		bool is_fullscreen = false;
+		struct weston_view *view = NULL;
+		struct weston_view *vit;
+
 		if (weston_surface_is_desktop_surface(surface)) {
 			struct weston_desktop_surface *desktop_surface;
 			desktop_surface = weston_surface_get_desktop_surface(surface);
 			is_fullscreen =  weston_desktop_surface_get_fullscreen(desktop_surface);
 		}
-		if (is_fullscreen && !is_pointer_constraint_enabled(constraint)) {
-			weston_view_update_transform(pointer->focus);
-			weston_pointer_set_focus(pointer, pointer->focus);
-			enable_pointer_constraint(constraint, pointer->focus);
+		/* The constraint's grab never picks the focus again, so it must
+		 * start on a view of the constrained surface: the pointer's focus
+		 * may still be a view under it, as kiosk-shell's background when
+		 * the surface has just become fullscreen. */
+		if (is_fullscreen && pointer->focus &&
+		    pointer->focus->surface == surface) {
+			view = pointer->focus;
+		} else if (is_fullscreen) {
+			wl_list_for_each(vit, &surface->views, surface_link) {
+				if (weston_view_is_mapped(vit)) {
+					view = vit;
+					break;
+				}
+			}
+		}
+		if (view && !is_pointer_constraint_enabled(constraint)) {
+			weston_view_update_transform(view);
+			weston_pointer_set_focus(pointer, view);
+			enable_pointer_constraint(constraint, view);
 			maybe_warp_confined_pointer(constraint);
 		} else {
 			maybe_enable_pointer_constraint(constraint);
