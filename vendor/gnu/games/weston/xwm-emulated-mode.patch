+					  input_x, input_y, input_w, input_h);
+	}
 	window->surface->pending.status |= WESTON_SURFACE_DIRTY_INPUT;
 
 	xwayland_interface->set_window_geometry(window->shsurf,
@@ -1590,6 +1639,19 @@
