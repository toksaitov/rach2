+/* Read the emulated mode's size from _XWAYLAND_RANDR_EMU_MONITOR_RECTS alone,
+ * leaving the state that weston_wm_window_read_properties() takes from the
+ * window's other properties as the window manager keeps it. */
 static void
+weston_wm_window_read_emulated(struct weston_wm_window *window)
+{
+	struct weston_wm *wm = window->wm;
+	xcb_get_property_cookie_t cookie;
+	xcb_get_property_reply_t *reply;
+	uint32_t *rect;
+
+	cookie = xcb_get_property(wm->conn, 0, window->id,
+				  wm->atom.xwayland_randr_emu_monitor_rects,
+				  XCB_ATOM_ANY, 0, 2048);
+	reply = xcb_get_property_reply(wm->conn, cookie, NULL);
+	window->emulated_width = 0;
+	window->emulated_height = 0;
+	if (reply && reply->format == 32 && reply->value_len >= 4) {
+		rect = xcb_get_property_value(reply);
+		window->emulated_width = rect[2];
+		window->emulated_height = rect[3];
+	}
+	free(reply);
+}
