+
+	/* A fullscreen client that sets or restores an emulated mode is
+	 * fullscreened again, so that the shell's configure gives it the
+	 * mode's size (send_configure()). */
+	if (property_notify->atom ==
+	    wm->atom.xwayland_randr_emu_monitor_rects &&
+	    window->fullscreen && window->shsurf) {
+		const struct weston_desktop_xwayland_interface *xwayland_interface =
+			wm->server->compositor->xwayland_interface;
+
+		weston_wm_window_read_emulated(window);
+		xwayland_interface->set_fullscreen(window->shsurf, NULL);
+	}
 }
 
