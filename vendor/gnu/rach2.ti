# rach2.ti: the terminfo entry of the Rach2 console, TERM=rach2.
#
# The kernel's console interprets the subset of ANSI escapes that
# rach2/sys/kio.c lists, and this entry lists only those. It gives no size,
# as Linux's console entry gives none: the console is 80 columns by 25 rows
# on the VGA's text mode and as many as a framebuffer's screen holds, and a
# program reads the size from the terminal's window size.
# A line feed also returns the carriage, so the entry moves down with CSI B
# and has no index; the console has no scroll region and no line or character
# insertion, so a program redraws where a terminal would scroll. A character
# in the last column leaves the wrap pending, as a VT100 and Linux's console
# do, so the entry has xenl, and a program may fill the last row, as tmux's
# status line does, without the screen scrolling. The keyboard sends each key
# as xterm does, which tests/host/keytable.txt lists, with the cursor keys and
# the keypad in their normal modes, since the entry has no smkx. The entry
# names the keys that terminfo has standard capabilities for: Backspace, which
# sends DEL, Shift+Tab, the keypad's 5 with Num Lock off, F1 to F12 alone and
# with Shift, Ctrl, Ctrl+Shift and Alt as kf1 to kf60, F1 to F3 with Alt+Shift
# as kf61 to kf63, and the cursor and editing keys alone and with Shift, but
# for Page Up and Page Down with Shift, which scroll the screen back. It
# answers the cursor position and the device attributes as Linux's console
# does, which u6 to u9 describe, and draws UTF-8 from code page 437.
# install_root.sh compiles the entry into the GNU root.
rach2|Rach2 VGA text console,
	am, bw, msgr, xenl, colors#8, it#8, pairs#64, bold=\E[1m,
	clear=\E[H\E[2J, cr=\r, cub=\E[%p1%dD, cub1=^H, cud=\E[%p1%dB,
	cud1=\E[B, cuf=\E[%p1%dC, cuf1=\E[C, cup=\E[%i%p1%d;%p2%dH,
	cuu=\E[%p1%dA, cuu1=\E[A, ech=\E[%p1%dX, ed=\E[J, el=\E[K,
	el1=\E[1K, home=\E[H, hpa=\E[%i%p1%dG, ht=^I, kDC=\E[3;2~,
	kEND=\E[1;2F, kHOM=\E[1;2H, kIC=\E[2;2~, kLFT=\E[1;2D,
	kRIT=\E[1;2C, kb2=\E[E, kbs=\177, kcbt=\E[Z, kcub1=\E[D,
	kcud1=\E[B, kcuf1=\E[C, kcuu1=\E[A, kdch1=\E[3~, kend=\E[F,
	kf1=\EOP, kf2=\EOQ, kf3=\EOR, kf4=\EOS, kf5=\E[15~, kf6=\E[17~,
	kf7=\E[18~, kf8=\E[19~, kf9=\E[20~, kf10=\E[21~, kf11=\E[23~,
	kf12=\E[24~, kf13=\E[1;2P, kf14=\E[1;2Q, kf15=\E[1;2R,
	kf16=\E[1;2S, kf17=\E[15;2~, kf18=\E[17;2~, kf19=\E[18;2~,
	kf20=\E[19;2~, kf21=\E[20;2~, kf22=\E[21;2~, kf23=\E[23;2~,
	kf24=\E[24;2~, kf25=\E[1;5P, kf26=\E[1;5Q, kf27=\E[1;5R,
	kf28=\E[1;5S, kf29=\E[15;5~, kf30=\E[17;5~, kf31=\E[18;5~,
	kf32=\E[19;5~, kf33=\E[20;5~, kf34=\E[21;5~, kf35=\E[23;5~,
	kf36=\E[24;5~, kf37=\E[1;6P, kf38=\E[1;6Q, kf39=\E[1;6R,
	kf40=\E[1;6S, kf41=\E[15;6~, kf42=\E[17;6~, kf43=\E[18;6~,
	kf44=\E[19;6~, kf45=\E[20;6~, kf46=\E[21;6~, kf47=\E[23;6~,
	kf48=\E[24;6~, kf49=\E[1;3P, kf50=\E[1;3Q, kf51=\E[1;3R,
	kf52=\E[1;3S, kf53=\E[15;3~, kf54=\E[17;3~, kf55=\E[18;3~,
	kf56=\E[19;3~, kf57=\E[20;3~, kf58=\E[21;3~, kf59=\E[23;3~,
	kf60=\E[24;3~, kf61=\E[1;4P, kf62=\E[1;4Q, kf63=\E[1;4R,
	khome=\E[H, kich1=\E[2~, kind=\E[1;2B, knp=\E[6~, kpp=\E[5~,
	kri=\E[1;2A, op=\E[39;49m, rc=\E8, rev=\E[7m, rmso=\E[27m,
	sc=\E7, setab=\E[4%p1%dm, setaf=\E[3%p1%dm, sgr0=\E[0m,
	smso=\E[7m, u6=\E[%i%d;%dR, u7=\E[6n, u8=\E[?6c, u9=\E[c,
	vpa=\E[%i%p1%dd,
