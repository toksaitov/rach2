# Debian's QEMU for x86 with its OpenGL modules, which virtio-gpu-gl and the
# GL displays need, its tools and its firmware. qemu-system-x86 depends on
# SeaBIOS and iPXE's ROMs; OVMF, its UEFI firmware, it only recommends.
qemu-system-x86
qemu-system-modules-opengl
qemu-utils
seabios
ovmf
# virglrenderer's render server, the process QEMU's virtio-gpu starts for a
# device with venus=on: libvirglrenderer1, which QEMU links, runs
# /usr/libexec/virgl_render_server, and no package of the closure depends on
# the one that has it.
virgl-server
