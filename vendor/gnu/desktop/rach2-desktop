#!/bin/bash
# Start the desktop's device services; start its ordinary user's session on
# SIGHUP and end it on SIGUSR2, and start it again on the displays left when
# its own goes away. No session starts at boot, so that the console's login
# keeps the screen and the keyboard.
set -eu
udev='' seat='' watch='' session='' restart=0 devices=0 stop=0
# The display the session draws on, `BACKEND CARD RENDERER` as display()
# gives it, the card's device in /sys, whether udev has reported that card
# removed since the session started, and whether the session lost its card
# and waits for another.
shown='' shown_dev='' dropped=0 lost=0
# The cards udev has reported removed, a name a line, which only the monitor
# below writes, by appending, and the lines of it the loop has read.
removed=/run/rach2-desktop.removed seen=0
cleanup()
{
    trap - EXIT HUP INT TERM USR1 USR2
    # A root gone read-only refuses the removal, and under set -e its
    # failure would end the trap with the session and the services running.
    rm -f /run/rach2-desktop.pid "$removed" 2>/dev/null || :
    [ -z "$session" ] || stop_session
    for child in "$watch" "$seat" "$udev"; do
        [ -z "$child" ] || kill -TERM "-$child" 2>/dev/null || :
        [ -z "$child" ] || kill -CONT "-$child" 2>/dev/null || :
    done
    for child in "$watch" "$seat" "$udev"; do
        [ -z "$child" ] || wait "$child" 2>/dev/null || :
    done
}
trap cleanup EXIT
trap 'exit 1' INT TERM
trap 'restart=1' HUP
trap 'devices=1' USR1
trap 'stop=1' USR2
mkdir -p /run/udev /run/user
install -d -m 0700 -o desktop -g desktop /run/user/1001
# The X servers' socket directories, which Debian's tmpfiles.d/x11.conf makes.
install -d -m 1777 /tmp/.X11-unix /tmp/.ICE-unix
setsid /usr/lib/systemd/systemd-udevd --resolve-names=early &
udev=$!
until udevadm control --ping 2>/dev/null; do
    kill -0 "$udev"
    sleep 1
done
udevadm trigger --action=add
udevadm settle
SEATD_VTBOUND=0 setsid seatd -g seat &
seat=$!
while [ ! -S /run/seatd.sock ]; do
    kill -0 "$seat"
    sleep 1
done
# Each card that appears or goes away, as udev reports it once its rules
# have run, wakes the loop below with SIGUSR1; a card that goes away is
# named in $removed first, since it may be back under the same name and
# device by the time the loop looks.
rm -f "$removed"
# shellcheck disable=SC2016 # the child expands its own words
setsid bash -c 'udevadm monitor --udev --subsystem-match=drm |
    while read -r line; do
        case $line in
            *" remove "*"/card"[0-9]*" (drm)")
                card=${line% (drm)}
                echo "${card##*/}" >> "$1"
                kill -USR1 "$0"
                ;;
            *" add "*"/card"[0-9]*" (drm)") kill -USR1 "$0" ;;
        esac
    done' "$$" "$removed" &
watch=$!
echo $$ > /run/rach2-desktop.pid

# display: the display a new session draws on, as `BACKEND CARD RENDERER`.
# A card with a connected connector, one with a render node before one
# without, and of those the first by number, gives `drm cardN gl` or `drm
# cardN pixman`. With none the session is headless: `headless - pixman`, or
# `headless - gl`, GL on llvmpipe, while it has lost its card.
display()
{
    local status card gl='' plain=''
    for status in /sys/class/drm/card*-*/status; do
        [ "$(cat "$status" 2>/dev/null)" = connected ] || continue
        card=${status#/sys/class/drm/}
        card=${card%%-*}
        [ -c "/dev/dri/$card" ] || continue
        if [ -c "/dev/dri/renderD$((128 + ${card#card}))" ]; then
            [ -n "$gl" ] || gl=$card
        else
            [ -n "$plain" ] || plain=$card
        fi
    done
    if [ -n "$gl" ]; then
        echo "drm $gl gl"
    elif [ -n "$plain" ]; then
        echo "drm $plain pixman"
    elif [ "$lost" = 1 ]; then
        echo "headless - gl"
    else
        echo "headless - pixman"
    fi
}

# device CARD: the device of CARD in /sys, which tells a card of the same
# name made later for another device from it, or nothing.
device()
{
    readlink -f "/sys/class/drm/$1/device" 2>/dev/null || :
}

# taken: read the cards udev has reported removed since the last read, and
# set dropped when the session's card is among them. The file is never
# renamed or cut, so that no append can land where the loop does not read; a
# last line without its newline is still being written, and waits for the
# next read.
taken()
{
    local card name n=0
    card=$(echo "$shown" | cut -d' ' -f2)
    [ -f "$removed" ] || return 0
    while IFS= read -r name; do
        n=$((n + 1))
        [ "$n" -gt "$seen" ] || continue
        seen=$n
        [ "$name" != "$card" ] || dropped=1
    done < "$removed"
}

# gone: whether the card of the session's display has gone away, though a
# card of the same name and device may have come back since.
gone()
{
    local card
    taken
    card=$(echo "$shown" | cut -d' ' -f2)
    [ "$card" != - ] && [ -n "$card" ] &&
        { [ "$dropped" = 1 ] || [ ! -c "/dev/dri/$card" ] ||
            [ "$(device "$card")" != "$shown_dev" ]; }
}

# lost_display: remember the loss across a headless start.
lost_display()
{
    lost=1
    echo "rach2-desktop: session: its display $shown is gone; starting again"
}

# The session leads a process group of its own, which a restart ends whole.
# Check the old card again after selecting the display: the old card may
# have gone while the previous session was stopping for SIGHUP. A start
# on a card ends the wait for one.
start_session()
{
    local next
    next=$(display)
    if gone && [ "$lost" = 0 ]; then
        lost_display
        next=$(display)
    fi
    shown=$next
    shown_dev=$(device "$(echo "$shown" | cut -d' ' -f2)")
    dropped=0
    [ "$(echo "$shown" | cut -d' ' -f1)" != drm ] || lost=0
    # shellcheck disable=SC2086 # three words
    setsid su -s /bin/bash desktop -c 'exec /usr/libexec/rach2-session "$@"' rach2-session $shown &
    session=$!
    echo "rach2-desktop: session: started as $session on $shown"
}

# stop_session: end the session's group and wait until none of it is left,
# since Weston still holds its socket's lock after su and dbus-run-session
# have gone, and a new Weston would fail on it. CONT follows TERM, since a
# stopped process takes no TERM until it runs again; what is left after 10
# seconds gets KILL. No wait blocks before that: the session's own cleanup
# waits for Weston and PulseAudio, so a member that holds off TERM would hold
# a wait for the leader too. The shell reaps the leader as it exits, so that
# the group's end shows to kill -0; the wait then gives its status. The
# leader is signalled by its pid as well as its group, since a stop that
# comes just after start_session may find it before its setsid, with no
# group yet, and a wait for it would then last as long as the session.
stop_session()
{
    local left=100
    [ -n "$session" ] || return 0
    kill -TERM "-$session" 2>/dev/null || kill -TERM "$session" 2>/dev/null || :
    kill -CONT "-$session" 2>/dev/null || kill -CONT "$session" 2>/dev/null || :
    while kill -0 "$session" 2>/dev/null || kill -0 "-$session" 2>/dev/null; do
        if [ "$left" -eq 0 ]; then
            kill -KILL "$session" 2>/dev/null || :
            kill -KILL "-$session" 2>/dev/null || :
        else
            left=$((left - 1))
        fi
        sleep 0.1
    done
    wait "$session" 2>/dev/null || :
    session=''
}

echo "rach2-desktop: services: up; SIGHUP starts the session"
while :; do
    for child in "$udev" "$seat" "$watch"; do
        if ! kill -0 "$child" 2>/dev/null; then
            echo "rach2-desktop: device service $child ended" >&2
            exit 1
        fi
    done
    reload=$restart changed=$devices ending=$stop restart=0 devices=0 stop=0
    if [ "$ending" = 1 ]; then
        if [ -n "$session" ]; then
            stop_session
            echo "rach2-desktop: session: stopped; SIGHUP starts it again"
        fi
        shown='' shown_dev='' dropped=0 lost=0
    fi
    ended=0
    if [ -n "$session" ] && ! kill -0 "$session" 2>/dev/null; then ended=1; fi
    if [ -n "$session" ] && { [ "$reload" = 1 ] || [ "$changed" = 1 ] || [ "$ended" = 1 ]; } && gone; then
        lost_display
        reload=1
    fi
    if [ "$reload" = 1 ]; then
        stop_session
        start_session
    elif [ "$ended" = 1 ]; then
        stop_session
        shown='' shown_dev=''
        echo "rach2-desktop: session: ended; SIGHUP starts it again"
    elif [ "$changed" = 1 ] && [ "$lost" = 1 ] && [ -n "$session" ]; then
        next=$(display)
        if [[ $next = 'drm '* ]]; then
            echo "rach2-desktop: session: display $next appeared; starting again"
            stop_session
            start_session
        fi
    fi
    # A trap between the flag check and this sleep waits at most one turn.
    sleep 1
done
