#!/bin/bash
# Start the desktop's device services and its ordinary user's session, and
# start the session again on the displays left when its own goes away.
set -eu
udev='' seat='' watch='' session='' restart=0 devices=0
# The display the session draws on, `BACKEND CARD RENDERER` as display()
# gives it, the card's device in /sys, and whether the session lost its card
# and waits for another.
shown='' shown_dev='' lost=0
cleanup()
{
    trap - EXIT HUP INT TERM USR1
    rm -f /run/rach2-desktop.pid
    for child in "$session" "$watch" "$seat" "$udev"; do
        [ -z "$child" ] || kill -TERM "-$child" 2>/dev/null || :
    done
    for child in "$session" "$watch" "$seat" "$udev"; do
        [ -z "$child" ] || wait "$child" 2>/dev/null || :
    done
}
trap cleanup EXIT
trap 'exit 1' INT TERM
trap 'restart=1' HUP
trap 'devices=1' USR1
mkdir -p /run/udev /run/user
install -d -m 0700 -o desktop -g desktop /run/user/1001
# The X servers' socket directories, which Debian's tmpfiles.d/x11.conf makes.
install -d -m 1777 /tmp/.X11-unix /tmp/.ICE-unix
setsid /usr/lib/systemd/systemd-udevd --resolve-names=early &
udev=$!
until udevadm control --ping 2>/dev/null; do
    kill -0 "$udev"
    sleep 1
done
udevadm trigger --action=add
udevadm settle
SEATD_VTBOUND=0 setsid seatd -g seat &
seat=$!
while [ ! -S /run/seatd.sock ]; do
    kill -0 "$seat"
    sleep 1
done
# Each card that appears or goes away, as udev reports it once its rules
# have run, wakes the loop below with SIGUSR1.
# shellcheck disable=SC2016 # the child expands its own words
setsid bash -c 'udevadm monitor --udev --subsystem-match=drm |
    while read -r line; do
        case $line in
            *" add "*"/card"[0-9]*" (drm)" | *" remove "*"/card"[0-9]*" (drm)") kill -USR1 "$0" ;;
        esac
    done' "$$" &
watch=$!
echo $$ > /run/rach2-desktop.pid

# display: the display a new session draws on, as `BACKEND CARD RENDERER`.
# A card with a connected connector, one with a render node before one
# without, and of those the first by number, gives `drm cardN gl` or `drm
# cardN pixman`. With none the session is headless: `headless - pixman`, or
# `headless - gl`, GL on llvmpipe, while it has lost its card.
display()
{
    local status card gl='' plain=''
    for status in /sys/class/drm/card*-*/status; do
        [ "$(cat "$status" 2>/dev/null)" = connected ] || continue
        card=${status#/sys/class/drm/}
        card=${card%%-*}
        [ -c "/dev/dri/$card" ] || continue
        if [ -c "/dev/dri/renderD$((128 + ${card#card}))" ]; then
            [ -n "$gl" ] || gl=$card
        else
            [ -n "$plain" ] || plain=$card
        fi
    done
    if [ -n "$gl" ]; then
        echo "drm $gl gl"
    elif [ -n "$plain" ]; then
        echo "drm $plain pixman"
    elif [ "$lost" = 1 ]; then
        echo "headless - gl"
    else
        echo "headless - pixman"
    fi
}

# device CARD: the device of CARD in /sys, which tells a card of the same
# name made later for another device from it, or nothing.
device()
{
    readlink -f "/sys/class/drm/$1/device" 2>/dev/null || :
}

# gone: whether the card of the session's display has gone away.
gone()
{
    local card
    card=$(echo "$shown" | cut -d' ' -f2)
    [ "$card" != - ] && [ -n "$card" ] &&
        { [ ! -c "/dev/dri/$card" ] || [ "$(device "$card")" != "$shown_dev" ]; }
}

# The session leads a process group of its own, which a restart ends whole.
start_session()
{
    shown=$(display)
    shown_dev=$(device "$(echo "$shown" | cut -d' ' -f2)")
    # shellcheck disable=SC2086 # three words
    setsid su -s /bin/bash desktop -c 'exec /usr/libexec/rach2-session "$@"' rach2-session $shown &
    session=$!
    echo "rach2-desktop: session: started as $session on $shown"
}

# stop_session: end the session's group and wait for it.
stop_session()
{
    if [ -n "$session" ]; then
        kill -TERM "-$session" 2>/dev/null || :
        wait "$session" 2>/dev/null || :
        session=''
    fi
}

start_session
while :; do
    ended=''
    [ "$restart" = 1 ] || [ "$devices" = 1 ] ||
        wait -n -p ended "$udev" "$seat" "$watch" ${session:+"$session"} || :
    if [ "$restart" = 1 ]; then
        restart=0 devices=0
        if [ "$ended" = "$session" ]; then session=''; fi
        stop_session
        start_session
        continue
    fi
    if [ "$devices" = 1 ]; then
        devices=0
        # The session's card went away: it starts again on what is left,
        # and goes on to the next card that appears, which is how it comes
        # back to a GPU that Rach2's driver has again.
        if [ -n "$session" ] && gone; then
            lost=1
            echo "rach2-desktop: session: its display $shown is gone; starting again"
            stop_session
            start_session
        elif [ "$lost" = 1 ] && [ -n "$session" ] && [ "$(display)" != "$shown" ] &&
            [ "$(display | cut -d' ' -f1)" = drm ]; then
            echo "rach2-desktop: session: display $(display) appeared; starting again"
            lost=0
            stop_session
            start_session
        fi
        continue
    fi
    case $ended in
    '')
        ;;
    "$session")
        session=''
        if gone; then
            # Weston ended with its card: as when the card went first.
            lost=1
            echo "rach2-desktop: session: its display $shown is gone; starting again"
            start_session
        else
            # Weston's end, by quitting or a signal, leaves the screen to
            # the console until SIGHUP starts the session again.
            echo "rach2-desktop: session: ended; SIGHUP starts it again"
        fi
        ;;
    *)
        # A device service ending restarts the whole service under init.
        if [ "$ended" = "$udev" ]; then udev=''; elif [ "$ended" = "$watch" ]; then watch=''; else seat=''; fi
        echo "rach2-desktop: device service $ended ended" >&2
        exit 1
        ;;
    esac
done
