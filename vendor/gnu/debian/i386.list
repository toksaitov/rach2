# The x86-64 root's i386 layer (../Readme.md, The i386 layer): glibc and
# GCC's runtime for /lib/ld-linux.so.2, Mesa 25.0.7's i386 drivers at the
# version mesa.list pins for amd64, since a library of both architectures
# shares its /usr/share files with the other, and the i386 libraries that
# GE-Proton's 32-bit Wine links or loads: those its i386-unix modules and
# its bundled i386 libraries name, and those desktop.list gives the 64-bit
# Wine. fetch_debs.sh resolves it against the i386 indices of the snapshot
# the desktop's lists use; the i386 Venus driver is venus.list's.
libc6
libgcc-s1
libstdc++6
mesa-libgallium=25.0.7-2+deb13u1
libgl1-mesa-dri=25.0.7-2+deb13u1
libegl-mesa0=25.0.7-2+deb13u1
libglx-mesa0=25.0.7-2+deb13u1
libgbm1=25.0.7-2+deb13u1
mesa-vulkan-drivers=25.0.7-2+deb13u1
libosmesa6=25.0.7-2+deb13u1
libegl1
libgles2
libgl1
libvulkan1
libdrm2
libdrm-amdgpu1
libwayland-client0
libwayland-cursor0
libwayland-egl1
libx11-6
libxext6
libxfixes3
libxcursor1
libxi6
libxrandr2
libxrender1
libxinerama1
libxcomposite1
libxxf86vm1
libfreetype6
libfontconfig1
libgnutls30t64
libgcrypt20
libgmp10
libdbus-1-3
libgstreamer1.0-0
libgstreamer-plugins-base1.0-0
libasound2t64
libpulse0
libudev1
libusb-1.0-0
libpcsclite1
libgssapi-krb5-2
libkrb5-3
libglib2.0-0t64
libsqlite3-0
libbrotli1
libpsl5t64
libnghttp2-14
libva2
libva-drm2
libva-x11-2
libvdpau1
libblas3
liblapack3
zlib1g
libzstd1
