# hostapd.config: the build configuration of hostapd and hostapd_cli, the
# access point of the Wi-Fi suite's Linux guest, copied to hostapd/.config by
# build_hostap.sh. Every option not named here is off.

# The nl80211 driver over libnl 3 (libnl-3 and libnl-genl-3).
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y

# OpenSSL for TLS and for every cryptographic primitive.
CONFIG_TLS=openssl
CONFIG_TLSV11=y
CONFIG_TLSV12=y

# WPA3-Personal. 802.11w is always built in 2.12; TKIP is built unless
# CONFIG_NO_TKIP is set, for the suite's WPA (TKIP) network.
CONFIG_SAE=y

# 802.11n, so that the access point can offer HT rates.
CONFIG_IEEE80211N=y

# The integrated EAP server of WPA2-Enterprise: PEAP and TTLS with MSCHAPv2
# or GTC inside, and TLS.
CONFIG_EAP=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_TLS=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_GTC=y
CONFIG_EAP_MD5=y

# The control interface, for hostapd_cli.
CONFIG_CTRL_IFACE=y

CONFIG_IPV6=y
CONFIG_ELOOP=eloop
CONFIG_L2_PACKET=linux
CONFIG_OS=unix
