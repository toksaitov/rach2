# wpa_supplicant.config: the build configuration of wpa_supplicant, wpa_cli
# and wpa_passphrase for Rach2, copied to wpa_supplicant/.config by
# build_hostap.sh. Every option not named here is off.

# The nl80211 driver over libnl 3 (libnl-3 and libnl-genl-3).
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y

# OpenSSL for TLS and for every cryptographic primitive.
CONFIG_TLS=openssl
CONFIG_TLSV11=y
CONFIG_TLSV12=y

# WPA3-Personal. Management-frame protection (802.11w) is always built in
# 2.12 and has no option of its own; TKIP is built unless CONFIG_NO_TKIP is
# set, so WPA (TKIP) networks remain usable.
CONFIG_SAE=y

# 802.1X and the EAP methods of WPA2-Enterprise: PEAP and TTLS with
# MSCHAPv2 or GTC inside, and TLS.
CONFIG_IEEE8021X_EAPOL=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_TLS=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_GTC=y
CONFIG_EAP_MD5=y

# The control interface on a UNIX socket, which wpa_cli and wifi use, and
# wpa_cli's own line editor.
CONFIG_CTRL_IFACE=y
CONFIG_WPA_CLI_EDIT=y

# Roaming among the access points of one network.
CONFIG_BGSCAN_SIMPLE=y

CONFIG_BACKEND=file
CONFIG_IPV6=y
CONFIG_DEBUG_FILE=y
CONFIG_ELOOP=eloop
CONFIG_L2_PACKET=linux
CONFIG_OS=unix
