musl/cputimemusl
musl/clockidmusl
musl/schedmusl
musl/waitidmusl
musl/pidfdmusl
musl/prctlmusl
musl/stackmusl
musl/sockflagmusl
# Capabilities, which Chromium's zygote gives up in each process it forks.
musl/capmusl
# eventfd, and epoll's level-triggered, edge-triggered and one-shot reports;
# timerfd's expirations, alone and through epoll.
musl/epollmusl
musl/timerfdmusl
# pselect6's descriptor sets, and the signal mask it waits under.
musl/pselectmusl
# The netlink route socket's dumps and refusals, the interface ioctls on an
# AF_UNIX socket, and a uevent socket that hears nothing.
musl/netlinkmusl
# inotify's events of a directory and a file, and its refusals.
musl/inotifymusl
# AF_UNIX: pairs, descriptors and credentials in messages, and names in the
# file system and the abstract namespace.
musl/unixmusl
# The IPv6 socket options, their control messages, raw ICMPv6's filter, and a
# group joined on the card.
musl/ip6optmusl
# ndwatch's router advertisements: the hop limit it requires, and its netlink
# socket's overflow; and raw ICMPv6's checksum check.
musl/ndwatchmusl
# File mappings, shared memory, mremap and madvise.
musl/mapmusl
# System V shared memory, semaphores and message queues, and POSIX message
# queues.
musl/ipcmusl
# seccomp's filters: errno, trap, kill, TSYNC, exec, strict mode.
musl/seccompmusl
# Namespaces: user, PID, mount, network, UTS and IPC, by unshare, setns and
# clone.
musl/nsmusl
# A sandbox built as bubblewrap builds one: pivot_root, MNT_DETACH, proc
# anywhere, the bounding set and capset of single capabilities.
musl/sandboxmusl
# FIFO files made by mkfifo and mknodat: their opens, waits and bytes.
musl/fifomusl
# statx, which both libcs call first for every stat, beside fstatat64.
musl/statxmusl
# Record, open file description and flock locks between processes: conflicts,
# splits, waits, EDEADLK and the closes that drop them.
musl/lockmusl
# tmpfs mounted by a program and at /dev/shm.
musl/tmpfsmusl
# mknod's kinds on KRFFS and tmpfs: their types, a device node's number and
# open, and the refusals in Linux's order.
musl/mknodmusl
# memfd_create, its descriptor and name, and each seal.
musl/memfdmusl
# chroot on KRFFS and tmpfs: paths, links and ".." inside the root, fork and
# exec keeping it, and the rmdir and unmount it refuses.
musl/chrootmusl
# Paths that go on past /proc/PID/fd/N, cwd and root, and /dev/fd/N, from the
# file or directory each refers to.
musl/proclinkmusl
# vfork and clone with CLONE_VM|CLONE_VFORK, as posix_spawn, system and popen
# start their children.
musl/vforkmusl
# ptrace as GDB drives it: memory, registers, a step, a breakpoint, syscall
# stops, the exec event, a debug register, attach and detach.
musl/ptracemusl
# sigtimedwait, the memory lock calls, mincore, getcpu, personality, sendmmsg
# and recvmmsg, clock_gettime64 and close_range.
musl/callsmusl
# Core files: their notes and memory, the limit, the dumpable flag, and a link
# at the name.
musl/coremusl
# Threads: their ids, locks and signals, the descriptors, directories and
# umask they share, /proc/self/task, and exec and exit from one.
musl/threadmusl
musl/threadscaling
# The shell's one-line form, which `su -c` depends on. It runs
# /musl/statushelper, a fixture and not a probe, which is why that one is
# staged but not listed here.
musl/ishmusl
# Last, since it changes the modes of a staged tree and makes files outside
# it. It puts every one back, but a failure part way through would leave them
# changed for the probes after it.
searchprobe
# Beside it for the same reason: it makes a tree of its own inside the two
# staged directories of its sticky pair, and two more directories at the image
# root, and removes every one of them again.
stickyprobe
