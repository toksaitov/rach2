{
  "protocol": "responses",
  "steps": [
    {"websocket": [
      {"request": {"model": "gpt-5.5", "store": false},
       "input": [{"role": "user", "text": "Read notes.txt and do what it says."}],
       "output": [{"call": "exec_command", "id": "call_read",
                   "arguments": {"cmd": "cat notes.txt"}}]},
      {"input": [{"output_of": "call_read",
                  "text": ["Process exited with code 0",
                           "Change the greeting in greeting.txt to: hello, rach2"]}],
       "output": [{"call": "exec_command", "id": "call_check",
                   "arguments": {"cmd": "sh check.sh"}}]}
    ]},
    {"refuse": 426},
    {"turn": {
      "input": [{"output_of": "call_check",
                 "text": ["Process exited with code 1",
                          "check: FAIL: greeting.txt says hello, world"]}],
      "output": [{"custom": "apply_patch", "id": "call_patch",
                  "input": "*** Begin Patch\n*** Update File: greeting.txt\n@@\n-hello, world\n+hello, rach2\n*** End Patch\n"}]}},
    {"turn": {
      "input": [{"output_of": "call_patch",
                 "text": ["Success. Updated the following files:", "M greeting.txt"]}],
      "output": [{"call": "exec_command", "id": "call_commit",
                  "arguments": {"cmd": "sh check.sh && git commit -q -am 'Greet Rach2' && git log --format=%s -1"}}]}},
    {"turn": {
      "input": [{"output_of": "call_commit",
                 "text": ["Process exited with code 0", "check: ok", "Greet Rach2"]}],
      "output": [{"message": "greeting.txt says hello, rach2, check.sh passes, and the change is committed."}]}}
  ]
}
