#!/bin/sh
#
# init: the first process of the Linux AP guest. It mounts the kernel's file
# systems, loads the modules the build listed in /etc/wifiap/modules in their
# order, and hands the machine to `wifiap boot`.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

/bin/busybox mkdir -p /proc /sys /dev /run /tmp /var /usr/sbin /usr/bin /sbin
/bin/busybox mount -t proc proc /proc
/bin/busybox --install -s
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=0755 tmpfs /run
mount -t tmpfs -o mode=1777 tmpfs /tmp
ln -sf /run /var/run
# The modules are loaded below by path, and the kernel's own requests, such as
# for a cipher a module already registered, need no helper.
echo /bin/true > /proc/sys/kernel/modprobe
hostname wifiap

while read -r path params; do
    [ -n "$path" ] || continue
    # shellcheck disable=SC2086 # PARAMS are the module's words
    insmod "/lib/modules/$path" $params || echo "wifiap: insmod: $path failed"
done < /etc/wifiap/modules

exec /sbin/wifiap boot
