{
  "hosts": ["fakeapi.test", "generativelanguage.googleapis.com", "antigravity-unleash.goog",
            "play.googleapis.com"],
  "session": {
    "protocol": "gemini",
    "steps": [
      {"protocol": "plain", "unordered": true, "repeat": true,
       "request": {"method": "POST", "path": "/api/client/register",
                   "headers": {"Host": "antigravity-unleash.goog"}},
       "reply": {"status": 404}},
      {"protocol": "plain", "unordered": true, "repeat": true,
       "request": {"method": "GET", "path": "/api/client/features",
                   "headers": {"Host": "antigravity-unleash.goog"}},
       "reply": {"status": 404}},
      {"protocol": "plain", "unordered": true, "repeat": true,
       "request": {"method": "POST", "path": "/api/client/metrics",
                   "headers": {"Host": "antigravity-unleash.goog"}},
       "reply": {"status": 404}},
      {"protocol": "plain", "unordered": true, "repeat": true,
       "request": {"method": "POST", "path": "/log", "headers": {"Host": "play.googleapis.com"}},
       "reply": {"status": 404}},
      {"unordered": true, "repeat": true, "model": "gemini-3.1-flash-lite-preview",
       "system": "conversation title generator", "reply": [{"text": "Greet Rach2"}]},
      {"tools": ["view_file", "run_command", "replace_file_content"],
       "prompt": "Read notes.txt and do what it says.",
       "reply": [{"functionCall": {"id": "call_notes", "name": "view_file",
                                   "args": {"AbsolutePath": "@REPO@/notes.txt",
                                            "toolAction": "Reading the notes",
                                            "toolSummary": "Notes"}}}]},
      {"results": [{"id": "call_notes",
                    "contains": ["Change the greeting in greeting.txt to: hello, rach2"]}],
       "reply": [{"functionCall": {"id": "call_greeting", "name": "view_file",
                                   "args": {"AbsolutePath": "@REPO@/greeting.txt",
                                            "toolAction": "Reading the greeting",
                                            "toolSummary": "Greeting"}}}]},
      {"results": [{"id": "call_greeting", "contains": ["hello, world"]}],
       "reply": [{"functionCall": {"id": "call_edit", "name": "replace_file_content",
                                   "args": {"TargetFile": "@REPO@/greeting.txt",
                                            "Instruction": "Change the greeting to hello, rach2.",
                                            "Description": "Sets the greeting.",
                                            "AllowMultiple": false,
                                            "TargetContent": "hello, world",
                                            "ReplacementContent": "hello, rach2",
                                            "StartLine": 1, "EndLine": 1,
                                            "toolAction": "Editing the greeting",
                                            "toolSummary": "Greeting edit"}}}]},
      {"results": [{"id": "call_edit", "contains": ["greeting.txt"]}],
       "reply": [{"functionCall": {"id": "call_commit", "name": "run_command",
                                   "args": {"CommandLine": "sh check.sh && git commit -q -am 'Greet Rach2' && git log --format=%s -1",
                                            "Cwd": "@REPO@", "WaitMsBeforeAsync": 10000,
                                            "toolAction": "Checking and committing",
                                            "toolSummary": "Commit"}}}]},
      {"results": [{"id": "call_commit", "contains": ["check: ok", "Greet Rach2"]}],
       "reply": [{"text": "greeting.txt says hello, rach2, check.sh passes, and the change is committed."}]},
      {"results": [{"id": "call_commit", "contains": ["check: ok", "Greet Rach2"]}],
       "reply": [{"functionCall": {"id": "call_sleep", "name": "run_command",
                                   "args": {"CommandLine": "sleep 600", "Cwd": "@REPO@",
                                            "WaitMsBeforeAsync": 300000,
                                            "toolAction": "Waiting", "toolSummary": "Wait"}}}]}
    ]
  },
  "after": {
    "protocol": "gemini",
    "steps": [
      {"protocol": "plain", "unordered": true, "repeat": true,
       "request": {"method": "POST", "path": "/api/client/register",
                   "headers": {"Host": "antigravity-unleash.goog"}},
       "reply": {"status": 404}},
      {"protocol": "plain", "unordered": true, "repeat": true,
       "request": {"method": "GET", "path": "/api/client/features",
                   "headers": {"Host": "antigravity-unleash.goog"}},
       "reply": {"status": 404}},
      {"protocol": "plain", "unordered": true, "repeat": true,
       "request": {"method": "POST", "path": "/api/client/metrics",
                   "headers": {"Host": "antigravity-unleash.goog"}},
       "reply": {"status": 404}},
      {"protocol": "plain", "unordered": true, "repeat": true,
       "request": {"method": "POST", "path": "/log", "headers": {"Host": "play.googleapis.com"}},
       "reply": {"status": 404}},
      {"unordered": true, "repeat": true, "model": "gemini-3.1-flash-lite-preview",
       "system": "conversation title generator", "reply": [{"text": "Signed in"}]},
      {"prompt": "Reply with the words: signed in.", "reply": [{"text": "signed in"}]}
    ]
  }
}
