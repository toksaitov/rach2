{
  "hosts": ["fakeapi.test", "api.openai.com", "chatgpt.com", "auth.openai.com", "api.github.com",
            "raw.githubusercontent.com"],
  "session": {
    "protocol": "responses",
    "steps": [
      {"protocol": "plain", "unordered": true, "repeat": true,
       "request": {"path": "/openai/codex/main/announcement_tip.toml",
                   "headers": {"Host": "raw.githubusercontent.com"}},
       "reply": {"status": 404}},
      {"refuse": 426, "unordered": true, "repeat": true},
      {"unordered": true,
       "turn": {
         "request": {"text": {"format": {"type": "json_schema", "name": "codex_output_schema"}}},
         "input": [{"role": "user", "text": "Generate a concise, single-line task title"}],
         "output": [{"message": "{\"title\": \"Greet Rach2\"}"}]}},
      {"turn": {
        "request": {"model": "gpt-5.5", "store": false},
        "input": [{"role": "user", "text": "Read notes.txt and do what it says."}],
        "output": [{"call": "exec_command", "id": "call_read", "arguments": {"cmd": "cat notes.txt"}}]}},
      {"turn": {
        "input": [{"output_of": "call_read",
                   "text": ["Process exited with code 0",
                            "Change the greeting in greeting.txt to: hello, rach2"]}],
        "output": [{"call": "exec_command", "id": "call_check", "arguments": {"cmd": "sh check.sh"}}]}},
      {"turn": {
        "input": [{"output_of": "call_check",
                   "text": ["Process exited with code 1",
                            "check: FAIL: greeting.txt says hello, world"]}],
        "output": [{"custom": "apply_patch", "id": "call_patch",
                    "input": "*** Begin Patch\n*** Update File: greeting.txt\n@@\n-hello, world\n+hello, rach2\n*** End Patch\n"}]}},
      {"turn": {
        "input": [{"output_of": "call_patch",
                   "text": ["Success. Updated the following files:", "M greeting.txt"]}],
        "output": [{"call": "exec_command", "id": "call_commit",
                    "arguments": {"cmd": "sh check.sh && git commit -q -am 'Greet Rach2' && git log --format=%s -1"}}]}},
      {"turn": {
        "input": [{"output_of": "call_commit",
                   "text": ["Process exited with code 0", "check: ok", "Greet Rach2"]}],
        "output": [{"message": "greeting.txt says hello, rach2, check.sh passes, and the change is committed."}]}},
      {"turn": {
        "input": [{"role": "user", "text": "sleep 600"}],
        "output": [{"call": "exec_command", "id": "call_sleep", "arguments": {"cmd": "sleep 600", "yield_time_ms": 300000}}]}}
    ]
  },
  "after": {
    "protocol": "responses",
    "steps": [
      {"refuse": 426, "unordered": true, "repeat": true},
      {"turn": {
        "request": {"model": "gpt-5.5"},
        "input": [{"role": "user", "text": "Reply with the words: signed in."}],
        "output": [{"message": "signed in"}]}}
    ]
  }
}
