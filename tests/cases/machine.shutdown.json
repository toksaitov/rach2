{
  "schema_version": 1,
  "family_id": "machine.shutdown",
  "summary": "Userland stops the machine, halts it or is refused, and only an orderly stop leaves the disk clean",
  "cases": [
    {
      "case_id": "machine.shutdown.poweroff",
      "behavior": "poweroff -n -f ends QEMU with the power-off event after a clean unmount, and the next boot reads the last write back",
      "units": ["shutdown"],
      "domain": "machine",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {"marker": "/root/marker", "command": "poweroff -n -f"}, "repetitions": 1, "seed": null},
      "requirements": {"host_api": "c", "tools": [], "features": {}},
      "execution": {"program": "shutdown_scenario", "stdin": null, "role": "ordinary", "privileges": "an ordinary user", "isolation": [{"fixture": "scratch"}, {"fixture": "disk", "names": ["shutdown-disk"]}], "children": "none", "cleanup": "libetude-case ends the machine and removes the disk copy, which it keeps after a failure"},
      "steps": [
        {"step_id": "poweroff", "stage": "execute", "machine": "fixture", "does": "boot the copy, write the marker, run poweroff -n -f and wait for the machine to end"},
        {"step_id": "fsck", "stage": "execute", "does": "run fsck.krffs on the copy, which must be clean"},
        {"step_id": "readback", "stage": "execute", "machine": "fixture", "does": "boot the same copy again and read the marker"}
      ],
      "machines": [
        {"machine_id": "fixture", "qemu": {"kernel": "kernel", "initrd": null, "disks": ["shutdown-disk"], "cpu": "max", "processors": 1, "memory_bytes": 134217728, "firmware": "direct", "devices": [], "boot_options": ["rach2.fsdisk"]}, "console": "serial", "qmp": true, "helper": false}
      ],
      "assertions": [
        {"assertion_id": "stopped", "checks": "the machine ends by itself, by QEMU's SHUTDOWN event", "source": "scenario"},
        {"assertion_id": "poweroff-status", "checks": "the SHUTDOWN event's reason is guest-shutdown, a power-off", "source": "scenario"},
        {"assertion_id": "clean-unmount", "checks": "the kernel says shutdown: clean unmount: dirty-mount flag cleared", "source": "scenario"},
        {"assertion_id": "no-halt-fallback", "checks": "the kernel never says halting instead", "source": "scenario"},
        {"assertion_id": "said-poweroff", "checks": "the kernel says poweroff: powering off", "source": "scenario"},
        {"assertion_id": "not-restart", "checks": "the kernel never says reboot: restarting", "source": "scenario"},
        {"assertion_id": "fsck-clean", "checks": "fsck.krffs exits 0 and does not call the copy not cleanly unmounted", "source": "scenario"},
        {"assertion_id": "marker-survives", "checks": "the second boot reads back the marker written just before the power-off", "source": "scenario"}
      ],
      "branches": [],
      "termination": {"end": "exited", "value": 0},
      "progress": [
        {"witness_id": "stage", "kind": "step", "means": "a step of the manifest has ended", "limit": 3},
        {"witness_id": "fsck", "kind": "quiet", "means": "fsck.krffs has ended", "limit": null, "bound": {"floor_us": 100000, "initial_us": 30000000, "ceiling_us": 120000000}}
      ],
      "bounds": {
        "case": {"floor_us": 5000000, "initial_us": 300000000, "ceiling_us": 900000000},
        "gap": {"floor_us": 1000000, "initial_us": 150000000, "ceiling_us": 600000000},
        "stages": {
          "prepare": {"floor_us": 100000, "initial_us": 30000000, "ceiling_us": 120000000},
          "boot": {"floor_us": 1000000, "initial_us": 90000000, "ceiling_us": 300000000},
          "cleanup": {"floor_us": 100000, "initial_us": 30000000, "ceiling_us": 120000000}
        }
      },
