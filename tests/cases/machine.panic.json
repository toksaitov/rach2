    {
      "case_id": "machine.panic.acpi",
      "behavior": "a panic with panic=5 and reboot=a on q35, whose FADT has a reset register, resets the machine through that register 5 seconds after its record",
      "units": ["panic"],
      "domain": "machine",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {"boot_options": "panic=5 reboot=a", "machine": "q35"}, "repetitions": 1, "seed": null},
      "requirements": {"host_api": "c", "tools": [], "features": {}},
      "execution": {"program": "panic_scenario", "stdin": null, "role": "ordinary", "privileges": "an ordinary user", "isolation": [{"fixture": "scratch"}], "children": "none", "cleanup": "libetude-case ends the machine and removes its evidence, which it keeps after a failure"},
      "steps": [
        {"step_id": "boot", "stage": "execute", "machine": "fixture", "does": "boot the test image with rach2.stackoverrun=fork and panic=5 reboot=a, read the panic and the reset's records, and wait for the machine to end"}
      ],
      "machines": [
        {"machine_id": "fixture", "qemu": {"kernel": "kernel", "initrd": "test-image", "disks": [], "cpu": "max", "processors": 1, "memory_bytes": 134217728, "firmware": "direct", "devices": [], "boot_options": ["rach2.rescue", "rach2.stackoverrun=fork", "panic=5", "reboot=a"], "machine": "q35"}, "console": "serial", "qmp": true, "helper": false, "fault": {"end": "panic", "records": ["ran past the end of its kernel stack", "a kernel stack ran out", "rebooting in 5 seconds"]}}
      ],
      "assertions": [
        {"assertion_id": "panicked", "checks": "the kernel panics because a kernel stack ran out", "source": "scenario"},
        {"assertion_id": "said-wait", "checks": "the panic's record is followed by panic: rebooting in 5 seconds..", "source": "scenario"},
        {"assertion_id": "methods", "checks": "the reset's record is reboot: emergency: acpi reset register", "source": "scenario"},
        {"assertion_id": "no-other", "checks": "no record of another method follows them", "source": "scenario"},
        {"assertion_id": "reset", "checks": "the machine ends by QEMU's SHUTDOWN event with the reason guest-reset", "source": "scenario"}
      ],
      "branches": [],
      "termination": {"end": "exited", "value": 0},
