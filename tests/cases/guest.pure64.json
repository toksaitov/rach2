        {
          "assertion_id": "int80-sigsegv",
          "checks": "int $0x80 with the i386 getpid number, 20, from 64-bit code ends the child that makes it with SIGSEGV",
          "source": "program"
        },
        {
          "assertion_id": "code32-runs",
          "checks": "code entered by a far return to selector 0x23 still runs in 32-bit mode with CS 0x23, and a far jump to 0x33 comes back",
          "source": "program"
        },
        {
          "assertion_id": "resumed-sleep-wchan",
          "checks": "a child's nanosleep that SIGSTOP cuts short and SIGCONT resumes through restart_syscall reads do_syscall_64 from /proc/PID/wchan, Linux's native entry with the i386 ABI or without it",
          "source": "program"
        }
