        {"assertion_id": "read-only-mount", "checks": "the kernel says krffs: mount: N bytes, read-only", "source": "scenario"},
        {"assertion_id": "unchanged", "checks": "the volume on the copy is byte for byte the volume built after the read-only mount", "source": "scenario"},
        {"assertion_id": "write-ok", "checks": "krffsprobe write says KRFFSPROBE OK (write)", "source": "scenario"},
        {"assertion_id": "read-write-mount", "checks": "the kernel says krffs: mount: N bytes, read-write", "source": "scenario"},
        {"assertion_id": "write-fsck-clean", "checks": "fsck.krffs --strict exits 0 on the volume the write boot unmounted", "source": "scenario"},
        {"assertion_id": "readback-ok", "checks": "krffsprobe readback says KRFFSPROBE OK (readback) on the next boot", "source": "scenario"},
        {"assertion_id": "crash-writing", "checks": "krffsprobe crash says KRFFSPROBE WRITING before the machine is ended", "source": "scenario"},
        {"assertion_id": "crash-fsck-dirty", "checks": "fsck.krffs --strict exits with another status than 0 and says the volume was not cleanly unmounted", "source": "scenario"},
        {"assertion_id": "crash-readback-ok", "checks": "krffsprobe readback says KRFFSPROBE OK (readback) on the volume the ended machine left", "source": "scenario"},
        {"assertion_id": "repair-ok", "checks": "krffsprobe write says KRFFSPROBE OK (write) on that volume", "source": "scenario"},
        {"assertion_id": "repair-checked", "checks": "the kernel says krffs: check: the volume was not unmounted cleanly", "source": "scenario"},
        {"assertion_id": "repair-fsck-clean", "checks": "fsck.krffs --strict exits 0 on the volume the checking mount wrote", "source": "scenario"}
