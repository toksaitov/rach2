  "summary": "A KRFFS volume mounted by mount(2) from krffsprobe at the kernel's debug shell, judged by the probe's line, the kernel's records and fsck.krffs on the disk each boot left; the program is tests/cases/machine/krffsmount_scenario.c",
  "cases": [
    {
      "case_id": "machine.krffsmount.volume",
      "behavior": "one volume through six boots: mounted read-only, mapped privately and read to its last byte with nothing written; written and unmounted clean; read back after a reboot; left dirty by a machine ended while it writes; read back again; and checked and written by the next mount that writes, which leaves it clean",
      "units": ["krffsmount"],
      "domain": "machine",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {"modes": "read write readback crash readback write"}, "repetitions": 1, "seed": null},
      "requirements": {"host_api": "c", "tools": [], "features": {}},
      "execution": {"program": "krffsmount_scenario", "stdin": null, "role": "ordinary", "privileges": "an ordinary user", "isolation": [{"fixture": "scratch"}, {"fixture": "disk", "names": ["volume-disk"]}], "children": "none", "cleanup": "libetude-case ends the machine and removes the disk copy, which it keeps after a failure"},
      "steps": [
        {"step_id": "read", "stage": "execute", "machine": "fixture", "does": "boot the copy, run krffsprobe read from the debug shell and end the machine with QMP's quit"},
        {"step_id": "unchanged", "stage": "execute", "does": "compare the volume on the copy with the volume built"},
        {"step_id": "write", "stage": "execute", "machine": "fixture", "does": "boot the copy, run krffsprobe write and end the machine"},
        {"step_id": "write-fsck", "stage": "execute", "does": "run fsck.krffs --strict on the volume of the copy"},
        {"step_id": "readback", "stage": "execute", "machine": "fixture", "does": "boot the copy, run krffsprobe readback and end the machine"},
        {"step_id": "crash", "stage": "execute", "machine": "fixture", "does": "boot the copy, run krffsprobe crash and end the machine with QMP's quit once it writes"},
        {"step_id": "crash-fsck", "stage": "execute", "does": "run fsck.krffs --strict on the volume of the copy, which must be dirty"},
        {"step_id": "crash-readback", "stage": "execute", "machine": "fixture", "does": "boot the copy, run krffsprobe readback and end the machine"},
        {"step_id": "repair", "stage": "execute", "machine": "fixture", "does": "boot the copy, run krffsprobe write, whose mount checks the volume, and end the machine"},
        {"step_id": "repair-fsck", "stage": "execute", "does": "run fsck.krffs --strict on the volume of the copy"}
