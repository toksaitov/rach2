{
  "schema_version": 1,
  "family_id": "guest.authority",
  "summary": "Which kernel may write the whole disk: bootprobe's auth modes on a disk over AHCI under each kernel",
  "cases": [
    {
      "case_id": "guest.authority.ordinary",
      "behavior": "the everyday kernel refuses to write its whole disk, and writes nothing in refusing, while the bounded window of the boot loader's gap still batches its transfers",
      "units": [
        "authority",
        "bootprobe, `rach2.bootprobe=auth-ordinary`"
      ],
      "domain": "guest",
      "architectures": [
        "i686",
        "x86_64"
      ],
      "workload": {
        "arguments": [],
        "inputs": {
          "disk_bytes": 4294967296,
          "write_at": 3221225472
        },
        "repetitions": 1,
        "seed": null
      },
      "requirements": {
        "host_api": "c",
        "tools": [],
        "features": {},
        "qemu": {
          "kernel": "kernel",
          "initrd": "test-image",
          "disks": [
            {
              "name": "auth-disk",
              "bus": "device",
              "id": "drv0",
              "media": "disk"
            }
          ],
          "cpu": "max",
          "processors": 1,
          "memory_bytes": 134217728,
          "firmware": "direct",
          "devices": [
            {
              "model": "ich9-ahci",
              "id": "ahci0"
            },
            {
              "model": "ide-hd",
              "bus": "ahci0.0",
              "drive": "drv0"
            },
            "virtio-net-pci"
          ],
          "boot_options": [
            "rach2.disk=ahci",
            "rach2.rescue",
            "rach2.diskdiag",
            "rach2.bootprobe=auth-ordinary"
          ]
        }
      },
      "execution": {
        "program": "bootprobe",
        "stdin": null,
        "role": "boot",
        "privileges": "root",
        "isolation": [
          {
            "fixture": "disk",
            "names": [
              "auth-disk"
            ]
          }
        ],
        "children": "none",
        "cleanup": "the case's private copy of the disk, which etude removes"
      },
      "assertions": [
        {
          "assertion_id": "cmdline",
          "checks": "/proc/cmdline names no disk root on this boot from a RAM image and ends with a newline, stat and fstat give it mode 0100444 and inode 0x101, and its descriptor's link in /proc/self/fd is /proc/cmdline",
          "source": "program"
        },
        {
          "assertion_id": "proc-listing",
          "checks": "getdents of /proc lists cmdline",
          "source": "program"
        },
        {
          "assertion_id": "authority",
          "checks": "root opens /dev/disk0 read-write; while it holds it, a second writer of the whole disk, by either mode, of /dev/bootpart or of /dev/grubcore is refused and a reader is not; a write of a sector at 3 GiB is refused with EPERM, and the sector reads back as zeros, so the refusal wrote nothing",
          "source": "program"
        },
        {
          "assertion_id": "window-batch",
          "checks": "a 200-sector read and a 200-sector write of /dev/grubcore are each taken whole in one driver call, as /proc/disk counts them",
          "source": "program"
        }
      ],
      "branches": [],
      "termination": {
        "end": "exited",
        "value": 0
      },
      "progress": [],
      "bounds": {
        "case": {
          "floor_us": 1000000,
          "initial_us": 600000000,
          "ceiling_us": 1800000000
        },
        "gap": {
