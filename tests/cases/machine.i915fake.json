        "stdin": null,
        "role": "ordinary",
        "privileges": "an ordinary user",
        "isolation": [
          {
            "fixture": "scratch"
          }
        ],
        "children": "none",
        "cleanup": "libetude-case stops QEMU and removes the overlay, which it keeps after a failure"
      },
      "steps": [
        {
          "step_id": "boot",
          "stage": "boot",
          "machine": "gnu",
          "does": "boot an overlay of the GNU system's disk on AHCI with an edu device, rach2.root=ext2 and rach2.i915fake, wait for the driver's line that edu stands in for 8086:0a16, log in as root and open the guest command channel"
        },
        {
          "step_id": "probe",
          "stage": "execute",
          "machine": "gnu",
          "does": "run drmdevice, eglinfo -p surfaceless with EGL's debug log on, whose exit is not judged while the driver's own ioctls answer EINVAL, and first light from /sys/kernel/debug/dri/DEVICE/i915_fake plain and under the submit, bind, irq and hang faults"
        }
      ],
      "machines": [
