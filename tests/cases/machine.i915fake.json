      "case_id": "machine.i915fake.gem",
      "behavior": "with rach2.i915fake the i915 driver binds QEMU's edu device, and an X tiled buffer object of 64 KiB with a stride of 2048 bytes, written through a GTT map and read back through a write-back CPU map, holds each dword where X tiling and the swizzle the driver reports put it",
      "units": [
        "rach2/sys/drm/i915/i915_gem_mman.c",
        "rach2/sys/drm/i915/i915_gem_tiling.c",
        "i915gemprobe"
      ],
      "domain": "guest",
      "architectures": [
        "x86_64"
      ],
      "workload": {
        "arguments": [],
