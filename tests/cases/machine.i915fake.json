        {
          "assertion_id": "identity",
          "checks": "drmdevice reports vendor 8086, device 0a16, subvendor 17aa and subdevice 380c",
          "source": "scenario"
        },
        {
          "assertion_id": "loader",
          "checks": "Mesa's loader logs the pci id 8086:0a16 with driver crocus, and eglinfo names crocus as the EGL driver",
          "source": "scenario"
        },
        {
          "assertion_id": "faults",
          "checks": "first light passes, gives -5 under submit, -12 under bind, -62 under irq, passes again, and gives -62 under hang with rcs0 hung, and the script exits 0",
          "source": "scenario"
