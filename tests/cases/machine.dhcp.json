{
  "schema_version": 1,
  "family_id": "machine.dhcp",
  "summary": "The machine taking an address it was not told, on the RTL8139, with BusyBox's udhcpc through ifup and os-simple's own dhcpc through netup, each case a boot of its own that tests/cases/machine/dhcp_scenario.c drives",
  "cases": [
    {
      "case_id": "machine.dhcp.lease",
      "behavior": "os-real booted with no address on the RTL8139 takes the lease of 192.168.90.20 with ifup -a, with its mask, broadcast address and name server, reaches the gateway by IP and by ARP, and sends a packet off the subnet to the gateway",
      "units": ["dhcp", "udhcpc", "ifup", "arping", "tests/system/checkers/pcapcheck.c"],
      "domain": "machine",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {}, "repetitions": 1, "seed": null},
      "requirements": {"host_api": "posix", "tools": [], "features": {}},
      "execution": {
        "program": "dhcp_scenario",
        "stdin": null,
        "role": "ordinary",
        "privileges": "an ordinary user",
        "isolation": [{"fixture": "scratch"}],
        "children": "none",
        "cleanup": "libetude-case ends the machine if it still runs, and removes the evidence after a pass"
      },
      "steps": [
        {
          "step_id": "boot",
          "stage": "boot",
          "machine": "guest",
          "does": "boot os-real with rach2.ip=none on 192.168.90.0/24, its card's frames recorded, and log in as root at the console"
        },
        {"step_id": "unset", "stage": "execute", "machine": "guest", "does": "ask ifconfig whether eth0 has no address"},
        {
          "step_id": "ifup",
          "stage": "execute",
          "machine": "guest",
          "does": "run ifup -a and read the lease, the address, the broadcast address, the mask and /etc/resolv.conf"
        },
        {
          "step_id": "reach",
          "stage": "execute",
          "machine": "guest",
          "does": "ping the gateway, arping it and an address nothing answers, read the ARP cache, and ping 10.9.9.9, which is off the subnet"
        },
        {
          "step_id": "capture",
          "stage": "capture",
          "machine": "guest",
          "does": "end the machine through QMP and run pcapcheck bcast on its card's frames for the route to 10.9.9.9"
        }
      ],
      "machines": [
        {
          "machine_id": "guest",
          "qemu": {
            "kernel": "kernel",
            "initrd": "os-real",
            "disks": [],
            "cpu": "max",
            "processors": 1,
            "memory_bytes": 134217728,
            "firmware": "direct",
            "devices": [
              {
                "model": "rtl8139",
                "net": "192.168.90.0/24",
                "host": "192.168.90.2",
                "dhcpstart": "192.168.90.20",
                "dns": "192.168.90.3"
              }
            ],
            "boot_options": ["rach2.ip=none"],
            "captures": ["net0"]
          },
          "console": "serial",
          "qmp": true,
          "helper": false
        }
      ],
      "assertions": [
        {
          "assertion_id": "unset",
          "checks": "eth0 has the address 0.0.0.0 before userland configures it",
          "source": "scenario"
        },
        {
          "assertion_id": "lease",
          "checks": "ifup -a exits 0, udhcpc says `lease of 192.168.90.20 obtained`, and the kernel says `net: eth0: IPv4 192.168.90.20/`",
          "source": "scenario"
        },
        {
          "assertion_id": "lease-applied",
          "checks": "ifconfig shows the address 192.168.90.20, the broadcast address 192.168.90.255 and the mask 255.255.255.0, and /etc/resolv.conf names 192.168.90.3",
          "source": "scenario"
        },
        {"assertion_id": "peer", "checks": "a ping of the gateway, 192.168.90.2, is answered", "source": "scenario"},
        {
          "assertion_id": "arping-reply",
          "checks": "arping -f of the gateway exits 0 with `Received 1 response`",
          "source": "scenario"
        },
        {
          "assertion_id": "arping-silent",
          "checks": "arping of 192.168.90.9, which nothing answers, ends at its deadline with status 1 and `Received 0 response`, which needs the interval timer",
          "source": "scenario"
        },
        {"assertion_id": "arp-cached", "checks": "the gateway is in the ARP cache", "source": "scenario"},
        {
          "assertion_id": "routed-on-wire",
          "checks": "pcapcheck finds the packet for 10.9.9.9 sent to the gateway's hardware address, which is what the leased default route means",
          "source": "scenario"
        }
      ],
      "branches": [],
      "termination": {"end": "exited", "value": 0},
