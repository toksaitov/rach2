{
  "schema_version": 1,
  "family_id": "guest.ping-e1000",
  "summary": "The kernel's ICMP echo, run as a process on Rach2 with an e1000 on QEMU's user network",
  "cases": [
    {
      "case_id": "guest.ping-e1000.pingtest",
      "behavior": "The kernel's ICMP echo gets the gateway's replies, times out at an address nobody answers, sleeps in a wait that holds its one slot, and refuses a data ping past 1472 bytes",
      "units": ["ping-e1000", "pingtest"],
      "domain": "guest",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {"gateway": "10.0.2.2", "silent": "10.0.2.99", "min_wait_ms": 3990}, "repetitions": 1, "seed": null},
      "requirements": {
        "host_api": "c", "tools": [], "features": {},
        "qemu": {"kernel": "kernel", "initrd": "test-image", "disks": [], "cpu": "max", "processors": 1,
                 "memory_bytes": 134217728, "firmware": "direct", "devices": ["e1000"], "boot_options": []}
      },
      "execution": {
        "program": "pingtest", "stdin": null, "role": "ordinary", "privileges": "any",
        "isolation": [], "children": "reaped", "cleanup": "nothing to remove; the child is reaped once its ping ends"
      },
      "assertions": [
        {"assertion_id": "gateway-replies", "checks": "three pings to the gateway each get a reply", "source": "program"},
        {"assertion_id": "silent-timeout", "checks": "a ping to an address nobody answers fails", "source": "program"},
        {"assertion_id": "child-in-ping", "checks": "the child writes its byte just before its ping, and /proc shows it asleep in the call", "source": "program"},
        {"assertion_id": "busy", "checks": "while the child is in its call, the parent's ping of the loopback address answers EBUSY", "source": "program"},
        {"assertion_id": "progress", "checks": "the parent's clock readings while the child waits span some time, so the wait sleeps", "source": "program"},
        {"assertion_id": "child-length", "checks": "the child reports the length of its call through the pipe", "source": "program"},
        {"assertion_id": "child-exit", "checks": "the child is reaped and exited normally", "source": "program"},
        {"assertion_id": "child-etimedout", "checks": "the child's ping returned ETIMEDOUT", "source": "program"},
        {"assertion_id": "wait-floor", "checks": "the child's call lasted at least 3990 ms, the kernel's four hundred ticks", "source": "program"},
        {"assertion_id": "release", "checks": "after the reap the parent's loopback ping returns a round-trip time of 0 or more", "source": "program"},
        {"assertion_id": "data-size", "checks": "a data ping of 1473 bytes, and on x86-64 one of a size past 32 bits, is refused with EMSGSIZE", "source": "program"}
      ],
      "branches": [],
      "termination": {"end": "exited", "value": 0},
      "progress": [],
      "bounds": {
        "case": {"floor_us": 1000000, "initial_us": 120000000, "ceiling_us": 600000000},
        "gap": {"floor_us": 1000000, "initial_us": 60000000, "ceiling_us": 300000000},
        "stages": {"boot": {"floor_us": 1000000, "initial_us": 60000000, "ceiling_us": 300000000}}
      },
      "resources": {"cpu_millis": 1000, "cpu_ceiling_millis": 1000, "memory_bytes": 268435456, "disk_bytes": 0,
                    "locks": [], "ports": 0, "loop_devices": 0},
      "prepare": [
        {"name": "pingtest", "node": "tests/pingtest", "per_architecture": true},
        {"name": "kernel", "node": "rach2/kernel", "per_architecture": true},
        {"name": "etude-guest", "node": "tools/etude/guest/etude-guest", "per_architecture": true},
        {"name": "test-image", "node": "images/test.krffs", "per_architecture": true}
      ],
      "timing": [],
      "native": {"plan": "none", "class": "card", "reason": "the native machine's card is its own, not QEMU's e1000"}
    }
  ]
}
