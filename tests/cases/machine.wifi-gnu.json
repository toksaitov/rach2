{
  "schema_version": 1,
  "family_id": "machine.wifi-gnu",
  "summary": "Wi-Fi on the GNU root: its own wpa_supplicant joining the Linux AP guest's networks as the installed system's does, through tests/cases/machine/wifi_scenario.c",
  "cases": [
    {
      "case_id": "machine.wifi-gnu.joins",
      "behavior": "the GNU root's wpa_supplicant joins network A under WPA2, SAE and PEAP-MSCHAPv2 through wifi connect as the installed system's does",
      "units": [
        "wifi",
        "wpa_supplicant",
        "nl80211",
        "wlan",
        "wsim",
        "utils/wifi.c",
        "tests/system/wifi",
        "vendor/gnu/ports/wpa_supplicant.sh"
      ],
      "domain": "machine",
      "architectures": [
        "i686",
        "x86_64"
      ],
      "workload": {
        "arguments": [],
        "inputs": {},
        "repetitions": 1,
        "seed": null
      },
      "requirements": {
        "host_api": "posix",
        "tools": [],
        "features": {}
      },
      "execution": {
        "program": "wifi_scenario",
        "stdin": null,
        "role": "ordinary",
        "privileges": "an ordinary user",
        "isolation": [
          {
            "fixture": "scratch"
          }
        ],
        "children": "none",
        "cleanup": "libetude-case ends both machines and the service if they still run, and removes the evidence after a pass"
      },
      "steps": [
        {
          "step_id": "serve",
          "stage": "boot",
          "does": "start hostpeer's TCP and UDP echo on the case's port 3, the endpoint 10.0.2.2 that the AP's DNS names endpoint.wifi.test"
        },
        {
          "step_id": "ap",
          "stage": "boot",
          "machine": "ap",
          "does": "boot the Linux AP guest to its shell, start network A's access points in the case's first profile and its relay to the station's port 1"
        },
        {
          "step_id": "station",
          "stage": "boot",
          "machine": "station",
          "does": "boot the station, pull its cable out through QMP, log in as root at the console, give eth1 10.0.4.15 and start wsimrelay to the guest's port 0"
        },
        {
          "step_id": "wpa2",
          "stage": "execute",
          "machine": "station",
          "does": "wifi connect rach2-net under WPA2 and read wpa_cli status"
        },
        {
          "step_id": "sae",
          "stage": "execute",
          "machine": "station",
          "does": "wifiap start sae, wifi forget and wifi connect rach2-net, and read wpa_cli status"
        },
        {
          "step_id": "peap",
          "stage": "execute",
          "machine": "station",
          "does": "wifiap start enterprise, wifi forget and wifi connect rach2-net answering yes to the certificate, and read wpa_cli status"
        }
      ],
      "machines": [
        {
          "machine_id": "ap",
          "qemu": {
            "architecture": "x86_64",
            "kernel": "ap-kernel",
            "initrd": "ap-initrd",
