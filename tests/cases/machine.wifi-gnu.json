              "wifiap.run=shell"
            ]
          },
          "console": "serial",
          "qmp": true,
          "helper": false
        },
        {
          "machine_id": "station",
          "qemu": {
            "kernel": "kernel",
            "initrd": null,
            "disks": [
              {
                "name": "station-disk",
