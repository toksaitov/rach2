        }
      ],
      "services": [
        {
          "service_id": "endpoint",
          "program": "hostpeer",
          "ready": "hostpeer: echoing",
          "does": "echo each TCP connection and UDP datagram on the case's port 3 until stopped"
        }
      ],
      "assertions": [
        {
          "assertion_id": "wpa2",
          "checks": "the station joins with key_mgmt=WPA2-PSK and pairwise_cipher=CCMP, takes the lease and pings the AP",
          "source": "scenario"
        },
        {
          "assertion_id": "sae",
          "checks": "the station joins with key_mgmt=SAE and pmf=2, takes the lease and pings the AP",
          "source": "scenario"
        },
        {
          "assertion_id": "peap",
          "checks": "the station joins with EAP-PEAP and pings the AP",
          "source": "scenario"
        }
      ],
