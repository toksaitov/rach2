{
  "schema_version": 1,
  "family_id": "machine.piglit",
  "summary": "parts of piglit's quick profile on llvmpipe on the GNU root under the virtio-vga profile, each judged test by test against the Debian reference guest's stored run; the runner is tests/graphics/runners/piglit.sh and the scenario tests/cases/machine/graphics_scenario.c",
  "cases": [
    {
      "case_id": "machine.piglit.gl-1.0",
      "behavior": "the OpenGL 1.0 tests of piglit's quick profile, run by piglit on Mesa's llvmpipe on the surfaceless EGL platform, a process on each CPU, give each test and subtest Linux's result in the Debian reference guest: each pass a pass and each skip a skip",
      "units": [
        "tests/graphics/runners/piglit.sh",
        "tests/graphics/runners/judge.py",
        "piglit",
        "Mesa's llvmpipe"
      ],
      "domain": "machine",
      "architectures": [
        "x86_64"
      ],
      "workload": {
        "arguments": [],
        "inputs": {
          "part": "gl-1.0",
          "reference": "tests/graphics/ref/debian/virtio-vga/piglit/gl-1.0.results"
        },
        "repetitions": 1,
        "seed": null
      },
      "requirements": {
        "host_api": "c",
        "tools": [],
        "features": {},
        "hosts": [
          "linux"
        ]
      },
      "execution": {
        "program": "graphics_scenario",
        "stdin": null,
        "role": "ordinary",
        "privileges": "the runner runs as the guest's test account, an ordinary user",
        "isolation": [
          {
            "fixture": "scratch"
          }
        ],
        "children": "none",
        "cleanup": "libetude-case stops the machine and removes the overlay, which it keeps after a failure"
      },
      "steps": [
        {
          "step_id": "boot",
          "stage": "boot",
          "machine": "gnu",
          "does": "boot an overlay of the GNU system's disk on virtio-blk with rach2.root=ext2 and the virtio-vga display, wait for the root and the login prompt, log in as root at the console and open the framed guest channel"
        },
        {
          "step_id": "stage",
          "stage": "execute",
          "machine": "gnu",
          "does": "make /tmp/graphics and copy there from the read-only graphics data disk the runners, the guest's environment, the IGT list and the Debian references, owned by the test account"
        },
        {
          "step_id": "run",
          "stage": "execute",
          "machine": "gnu",
          "does": "run piglit.sh gl-1.0 as the test account with GRAPHICS_CLASS=conformance and GRAPHICS_DONE=1, through the framed guest channel"
        },
        {
          "step_id": "judge",
          "stage": "execute",
          "machine": "gnu",
          "does": "run judge.py results on the part's results and the Debian reference's"
        },
        {
          "step_id": "collect",
          "stage": "execute",
          "machine": "gnu",
          "does": "fetch the runner's output as the evidence out.tar.gz and write the host's half of the record, its load and the admission ledger's claims, as the evidence host-record"
        }
      ],
      "machines": [
        {
          "machine_id": "gnu",
          "qemu": {
            "kernel": "kernel",
            "initrd": null,
            "disks": [
              {
                "name": "gnu-disk",
                "base": "gnu-image",
                "cluster_bytes": 65536,
                "bus": "virtio"
              },
              {
                "name": "graphics-payload",
                "base": "graphics-data",
                "cluster_bytes": 65536,
                "bus": "virtio"
              }
            ],
            "cpu": "max",
            "processors": 4,
            "memory_bytes": 8589934592,
            "firmware": "direct",
            "devices": [],
            "boot_options": [
              "rach2.root=ext2"
            ],
            "display": "virtio-vga"
          },
          "console": "serial",
          "qmp": true,
          "helper": false
        }
      ],
      "services": [],
      "assertions": [
        {
          "assertion_id": "ran",
          "checks": "piglit.sh exits 0, piglit having made its results, and prints its result line",
          "source": "scenario"
        },
        {
          "assertion_id": "as-debian",
          "checks": "judge.py finds each test and subtest that passed or skipped in the Debian reference guest, stored under tests/graphics/ref/debian, to pass or skip here, and prints judge: result: pass",
          "source": "scenario"
