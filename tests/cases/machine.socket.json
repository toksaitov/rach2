{
  "schema_version": 1,
  "family_id": "machine.socket",
  "summary": "The guest opens connections of its own, to an echo server on the host that it reaches at the user network's gateway",
  "cases": [
    {
      "case_id": "machine.socket.udptest",
      "behavior": "A UDP socket binds, finds nothing to read, sends to the host's echo server and receives the same bytes, and refuses to receive into a kernel address",
      "units": ["socket", "udptest", "tests/system/runner/hostpeer.c"],
      "domain": "machine",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {"message": "rach2-udp-echo", "local_port": 12345}, "repetitions": 1, "seed": null},
      "requirements": {"host_api": "posix", "tools": [], "features": {}},
      "execution": {
        "program": "socket_scenario", "stdin": null, "role": "ordinary", "privileges": "an ordinary user",
        "isolation": [{"fixture": "scratch"}],
        "children": "none",
        "cleanup": "libetude-case stops the echo server and the machine"
      },
      "steps": [
        {"step_id": "serve", "stage": "prepare",
         "does": "start hostpeer echo on the case's port, until it is stopped"},
        {"step_id": "boot", "stage": "boot", "machine": "guest",
         "does": "boot the test image to the debug shell"},
        {"step_id": "udptest", "stage": "execute", "machine": "guest",
         "does": "run udptest with the port at the debug shell and take its report from the console"}
      ],
      "machines": [
        {"machine_id": "guest",
         "qemu": {"kernel": "kernel", "initrd": "test-image", "disks": [], "cpu": "max", "processors": 1,
                  "memory_bytes": 134217728, "firmware": "direct", "devices": ["rtl8139"], "boot_options": []},
         "console": "serial", "qmp": true, "helper": false}
      ],
      "services": [
        {"service_id": "echo", "program": "hostpeer", "ready": "hostpeer: echoing",
         "does": "echo what arrives over TCP and UDP on 127.0.0.1 at the case's port, which the guest reaches at 10.0.2.2"}
      ],
      "assertions": [
        {"assertion_id": "socket", "checks": "socket(AF_INET, SOCK_DGRAM) opens a socket", "source": "scenario"},
        {"assertion_id": "bind", "checks": "the socket binds the local port", "source": "scenario"},
        {"assertion_id": "empty-eagain", "checks": "a MSG_DONTWAIT receive on the empty socket answers EAGAIN", "source": "scenario"},
        {"assertion_id": "echo", "checks": "the message sent to the echo server comes back with the same bytes", "source": "scenario"},
        {"assertion_id": "kernel-pointer", "checks": "with the echo still queued, a receive into a kernel address answers EFAULT", "source": "scenario"}
      ],
      "branches": [],
      "termination": {"end": "exited", "value": 0},
