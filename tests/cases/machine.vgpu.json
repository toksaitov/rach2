      },
      "assertions": [
        {
          "assertion_id": "params",
          "checks": "Virgl and both capability sets are advertised and readable",
          "source": "program"
        },
        {
          "assertion_id": "context",
          "checks": "A second open creates and closes its own context",
          "source": "program"
        },
        {
          "assertion_id": "resource",
          "checks": "A 3D texture is created, described and mapped",
          "source": "program"
        },
        {
          "assertion_id": "transfer",
          "checks": "All 64 uploaded texture bytes read back unchanged and ordinary virgl strides are refused",
          "source": "program"
        },
        {
          "assertion_id": "submit",
          "checks": "A submission naming a buffer returns a sync-file out-fence",
          "source": "program"
        },
        {
          "assertion_id": "out-fence",
          "checks": "The sync file can be inspected and passed as an in-fence",
          "source": "program"
        },
        {
          "assertion_id": "wait",
          "checks": "Blocking WAIT completes the work and NOWAIT reports idle",
          "source": "program"
        },
        {
          "assertion_id": "shared",
          "checks": "A texture both files hold and have named in a submission is attached to both their contexts in virtio_gpu_attachments, read with no draw between; the second file's close of its handle detaches its context alone, and with a second texture the first file's close detaches the first's alone; the first file still uploads, reads back and submits its texture, and the second still submits the other",
          "source": "program"
        },
        {
          "assertion_id": "busy-close",
          "checks": "A texture closed while a mapping and a submission hold it, the submission kept pending by virtio_gpu_hold, stays in virtio_gpu_objects until both have ended, the submission first and the mapping first, and then leaves it with no further call",
          "source": "program"
        },
        {
          "assertion_id": "unref",
          "checks": "A texture named in a submission and closed while virtio_gpu_hold holds the answers stays in virtio_gpu_objects, and once the hold ends the answers' last reference frees it in the kernel's worker, with no further call of the program; the time it took is printed",
          "source": "program"
        },
        {
          "assertion_id": "reset",
          "checks": "Reset fails every still-pending fence and old buffer handles return ENODEV",
          "source": "program"
        }
