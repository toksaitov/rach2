      "case_id": "machine.exitline.harness",
      "behavior": "the harness kernel ends QEMU through its isa-debug-exit port when init exits, and prints the plain line from which a reader with no token takes the status",
      "units": ["exitline", "hello"],
      "domain": "machine",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {"command": "exec /hello"}, "repetitions": 1, "seed": null},
      "requirements": {"host_api": "c", "tools": [], "features": {}},
      "execution": {"program": "exitline_scenario", "stdin": null, "role": "ordinary", "privileges": "an ordinary user", "isolation": [{"fixture": "scratch"}], "children": "none", "cleanup": "libetude-case ends the machine and removes its evidence, which it keeps after a failure"},
      "steps": [
        {"step_id": "boot", "stage": "boot", "machine": "harness", "does": "boot the harness kernel with the test image to the debug shell"},
        {"step_id": "run", "stage": "execute", "machine": "harness", "does": "run hello and wait for QEMU to end by the port"}
      ],
      "machines": [
        {"machine_id": "harness", "qemu": {"kernel": "harness-kernel", "initrd": "test-image", "disks": [], "cpu": "max", "processors": 1, "memory_bytes": 134217728, "firmware": "direct", "devices": [{"model": "isa-debug-exit", "properties": {"iobase": "0xf4", "iosize": "0x04"}}], "boot_options": []}, "console": "serial", "qmp": true, "helper": false}
      ],
