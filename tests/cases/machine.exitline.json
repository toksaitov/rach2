  "cases": [
    {
      "case_id": "machine.exitline.quiet",
      "behavior": "on os-real, whose init and login shell are home, a program that forks, execs and exits prints its output and the kernel prints no plain process-exit line",
      "units": ["exitline"],
      "domain": "machine",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {"command": "/bin/busybox echo FORKED-AND-EXITED; echo REAPED-OK"}, "repetitions": 1, "seed": null},
      "requirements": {"host_api": "c", "tools": [], "features": {}},
      "execution": {"program": "exitline_scenario", "stdin": null, "role": "ordinary", "privileges": "an ordinary user", "isolation": [{"fixture": "scratch"}], "children": "none", "cleanup": "libetude-case ends the machine and removes its evidence, which it keeps after a failure"},
      "steps": [
        {"step_id": "boot", "stage": "boot", "machine": "real", "does": "boot os-real and log in as root at the console"},
        {"step_id": "run", "stage": "execute", "machine": "real", "does": "run BusyBox by its path and then a builtin, wait for the builtin's output and end the machine with QMP's quit"}
      ],
      "machines": [
        {"machine_id": "real", "qemu": {"kernel": "kernel", "initrd": "real", "disks": [], "cpu": "max", "processors": 1, "memory_bytes": 134217728, "firmware": "direct", "devices": [], "boot_options": []}, "console": "serial", "qmp": true, "helper": false}
      ],
      "assertions": [
        {"assertion_id": "ran", "checks": "the forked program prints its output, and the builtin after it runs once the program is reaped", "source": "scenario"},
        {"assertion_id": "quiet", "checks": "the console never has the plain line process: exited with status", "source": "scenario"}
      ],
      "branches": [],
      "termination": {"end": "exited", "value": 0},
      "progress": [
        {"witness_id": "stage", "kind": "step", "means": "a step of the manifest has ended", "limit": 2}
      ],
      "bounds": {"case": {"floor_us": 5000000, "initial_us": 300000000, "ceiling_us": 900000000}, "gap": {"floor_us": 1000000, "initial_us": 150000000, "ceiling_us": 600000000}, "stages": {"prepare": {"floor_us": 100000, "initial_us": 30000000, "ceiling_us": 120000000}, "boot": {"floor_us": 1000000, "initial_us": 90000000, "ceiling_us": 300000000}, "cleanup": {"floor_us": 100000, "initial_us": 30000000, "ceiling_us": 120000000}}},
