{
  "schema_version": 1,
  "family_id": "machine.netguest",
  "summary": "The wired card given through VFIO to a Debian/nftables or FreeBSD/pf gateway guest, the network reached over a tap link with and without vhost-net, and the card taken back, judged by the kernel's and the guest's counts",
  "cases": [
    {
      "case_id": "machine.netguest.cycle",
      "behavior": "Exercise the tap device and the card let go and taken back three times",
      "units": [
        "tests/netguest",
        "tests/cases/machine/netguest_scenario.c",
        "rach2/sys/network/driver",
        "rach2/sys/vfio"
      ],
      "domain": "machine",
      "architectures": [
        "x86_64"
      ],
      "workload": {
        "arguments": [],
        "inputs": {
          "runner": "tests/netguest/run.sh"
        },
        "repetitions": 1,
        "seed": null
      },
      "requirements": {
        "host_api": "c",
        "tools": [],
        "features": {},
        "hosts": [
          "linux"
        ]
      },
      "execution": {
        "program": "netguest_scenario",
        "stdin": null,
        "role": "ordinary",
        "privileges": "root in the private GNU guest, which gives its card to a nested guest",
        "isolation": [
          {
            "fixture": "scratch"
          }
        ],
        "children": "none",
        "cleanup": "libetude-case stops the peer and the machine and removes the overlay, which it keeps after a failure"
      },
      "steps": [
        {
          "step_id": "boot",
          "stage": "boot",
          "machine": "gnu",
          "does": "start the nettput peer on the case's port, boot the GNU root on NVMe by its MBR identity with remapped interrupts, wait for the root and login prompt, log in as root and open the framed guest channel"
        },
        {
          "step_id": "stage",
          "stage": "execute",
          "machine": "gnu",
          "does": "mount the netguest payload's read-only AHCI data disk"
        },
        {
          "step_id": "run",
          "stage": "execute",
          "machine": "gnu",
          "does": "run the case with run.sh against the peer at 10.0.3.2 and require its pass token"
        }
      ],
      "machines": [
        {
          "machine_id": "gnu",
          "qemu": {
            "kernel": "kernel",
            "initrd": null,
            "disks": [
              {
                "name": "gnu-disk",
                "base": "gnu-image",
                "cluster_bytes": 65536,
                "bus": "nvme",
                "serial": "assign-root"
              },
              {
                "name": "netguest-payload",
                "base": "netguest-data",
                "cluster_bytes": 65536,
                "bus": "ahci"
              }
            ],
            "cpu": "max-svm",
            "processors": 4,
            "memory_bytes": 6442450944,
            "firmware": "direct",
            "devices": [
              {
                "model": "intel-iommu",
                "properties": {
                  "intremap": "on",
                  "caching-mode": "on"
                }
              },
              {
                "model": "e1000",
                "net": "10.0.2.0/24",
                "host": "10.0.2.2",
                "dhcpstart": "10.0.2.15"
              },
              {
                "model": "pcie-root-port",
                "id": "cardport",
                "properties": {
                  "addr": "06.0",
                  "chassis": "1"
                }
              },
              {
                "model": "e1000",
                "net": "10.0.3.0/24",
                "host": "10.0.3.2",
                "dhcpstart": "10.0.3.15",
                "properties": {
                  "addr": "00.0"
                },
                "bus": "cardport"
              }
            ],
            "boot_options": [
              "rach2.root=MBRID=82274701,1"
            ],
            "display": "none",
            "machine": "q35",
            "emulator": "assign-qemu"
          },
          "console": "serial",
          "qmp": true,
          "helper": false
        }
      ],
      "services": [
        {
          "service_id": "peer",
          "program": "netguest-nettput",
          "ready": "nettput: serving on",
          "does": "serve nettput's tests on 127.0.0.1 at the case's port, which the machine and its nested guest reach at 10.0.3.2, one client at a time until stopped"
        }
      ],
      "assertions": [
        {
          "assertion_id": "netguest",
          "checks": "run.sh's cycle case: tap9 made, addressed and removed by iproute2; the e1000 unbound and bound three times, the peer answering after each; the free interrupt vectors as before",
          "source": "scenario"
        }
      ],
