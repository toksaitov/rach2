      "behavior": "a machine ended by QMP's quit once the disk is mounted leaves the dirty-mount flag set",
      "units": ["crash"],
      "domain": "machine",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {}, "repetitions": 1, "seed": null},
      "requirements": {"host_api": "c", "tools": [], "features": {}},
      "execution": {"program": "crash_scenario", "stdin": null, "role": "ordinary", "privileges": "an ordinary user", "isolation": [{"fixture": "scratch"}, {"fixture": "disk", "names": ["crash-disk"]}], "children": "none", "cleanup": "libetude-case ends the machine and removes the disk copy, which it keeps after a failure"},
      "steps": [
        {"step_id": "crash", "stage": "execute", "machine": "fixture", "does": "boot the copy, wait for its mount and end the machine with QMP's quit"},
        {"step_id": "fsck", "stage": "execute", "does": "run fsck.krffs on the copy, which must be dirty"}
      ],
      "machines": [
        {"machine_id": "fixture", "qemu": {"kernel": "kernel", "initrd": null, "disks": ["crash-disk"], "cpu": "max", "processors": 1, "memory_bytes": 134217728, "firmware": "direct", "devices": [], "boot_options": ["rach2.fsdisk", "rach2.rescue"]}, "console": "serial", "qmp": true, "helper": false}
      ],
      "assertions": [
