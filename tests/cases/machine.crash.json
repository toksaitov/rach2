        {"assertion_id": "ended-by-quit", "checks": "the machine runs until QMP's quit ends it", "source": "scenario"},
        {"assertion_id": "fsck-dirty", "checks": "fsck.krffs exits 0 and calls the copy not cleanly unmounted", "source": "scenario"}
