    {
      "case_id": "machine.audio.hda",
      "behavior": "the debug shell's scale on an Intel HDA controller reaches QEMU's recording as its five notes, fed by the controller's own interrupts",
      "units": ["audio"],
      "domain": "machine",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {"card": "hda", "scale_ms": 2000}, "repetitions": 1, "seed": null},
      "requirements": {"host_api": "c", "tools": [], "features": {}},
      "execution": {"program": "audio_scenario", "stdin": null, "role": "ordinary", "privileges": "an ordinary user", "isolation": [{"fixture": "scratch"}], "children": "none", "cleanup": "libetude-case ends the machine and removes its recording, which it keeps after a failure"},
      "steps": [
        {"step_id": "play", "stage": "execute", "machine": "fixture", "does": "boot to the debug shell, run intrprobe, play the scale, run intrprobe again, and end the machine with QMP's quit"},
        {"step_id": "judge", "stage": "execute", "does": "run wavcheck on the machine's recording"}
      ],
      "machines": [
        {"machine_id": "fixture", "qemu": {"kernel": "kernel", "initrd": "test-image", "disks": [], "cpu": "max", "processors": 1, "memory_bytes": 134217728, "firmware": "direct", "devices": [], "boot_options": ["rach2.rescue"], "audio": "hda"}, "console": "serial", "qmp": true, "helper": false}
      ],
      "assertions": [
        {"assertion_id": "probe-before", "checks": "intrprobe says INTRPROBE OK before the scale", "source": "scenario"},
        {"assertion_id": "played", "checks": "audio test scale 2000 says Done. before the shell's prompt comes back", "source": "scenario"},
        {"assertion_id": "probe-after", "checks": "intrprobe says INTRPROBE OK after the scale", "source": "scenario"},
        {"assertion_id": "messages", "checks": "the count intrprobe reads on the audio controller's message vector in /proc/interrupts has grown across the scale", "source": "scenario"},
        {"assertion_id": "no-stall", "checks": "the console never says audio: stalled", "source": "scenario"},
        {"assertion_id": "notes", "checks": "wavcheck finds 262, 294, 330, 349 and 392 Hz in QEMU's recording, in that order, and no other tone", "source": "scenario"}
      ],
      "branches": [],
