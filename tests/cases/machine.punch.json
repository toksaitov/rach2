{
  "schema_version": 1,
  "family_id": "machine.punch",
  "summary": "Large files freed on an ext2 volume while other processes allocate, write, sync and press the memory on four processors, judged after the machine by e2fsck -fn and by a reader of the disk image that shares no code with the driver; the program is tests/cases/machine/punch_scenario.c, which runs tests/musl/punchmusl.c at the kernel's debug shell",
  "cases": [
    {
      "case_id": "machine.punch.stress",
      "behavior": "On four processors, sparse files of 6 GiB and solid files of 128 MiB are removed and cut while other processes make, write, fsync and remove files in the same directory, one syncs and one takes the memory, on a mount that writes back and on one with dirsync; every call succeeds, every file reads back, the kept files read whole after each remount, e2fsck -fn finds the volume clean, and each kept file hashed from the disk image is what the machine printed",
      "units": [
        "punch",
        "tests/musl/punchmusl.c",
        "rach2/sys/fs/ext2.c",
        "rach2/sys/fs/bcache.c",
        "rach2/sys/proc/sched.c"
      ],
      "domain": "machine",
      "architectures": [
        "i686",
        "x86_64"
      ],
      "workload": {
        "arguments": [],
        "inputs": {
          "rounds": 6,
          "processors": 4,
          "memory_mib": 512,
          "volume_mib": 2048
        },
        "repetitions": 1,
        "seed": null
      },
      "requirements": {
        "host_api": "c",
        "tools": [],
        "features": {}
      },
      "execution": {
        "program": "punch_scenario",
        "stdin": null,
        "role": "ordinary",
        "privileges": "an ordinary user",
        "isolation": [
          {
            "fixture": "scratch"
          },
          {
            "fixture": "disk",
            "names": [
              "image-disk"
            ]
          }
        ],
        "children": "none",
        "cleanup": "libetude-case ends the machines and removes the disk, which it keeps after a failure"
      },
      "steps": [
        {
          "step_id": "volume",
          "stage": "prepare",
          "does": "write the disk's MBR with mkmbr and make the 2 GiB ext2 volume in its partition with mke2fs; the disk stays sparse"
        },
        {
          "step_id": "stress",
          "stage": "execute",
          "machine": "stress",
          "does": "boot the test image on 4 processors on the disk, run punchmusl from the debug shell, wait for the shell and end the machine"
        },
        {
          "step_id": "fsck",
          "stage": "execute",
          "does": "run e2fsck -fn on the volume in the image helper machine"
        },
        {
          "step_id": "hash",
          "stage": "execute",
          "does": "hash each kept file from the disk image with the scenario's own reader"
        },
        {
          "step_id": "debugfs",
          "stage": "execute",
          "does": "dump one kept file with debugfs in the image helper machine and hash it"
        },
        {
          "step_id": "catches",
          "stage": "execute",
          "does": "flip a byte of a kept file on the disk and the bit of that block in its bitmap, and run the hash and e2fsck -fn again"
        }
      ],
      "machines": [
        {
          "machine_id": "stress",
          "qemu": {
            "kernel": "kernel",
            "initrd": "test-image",
            "disks": [
              {
                "name": "punch",
                "bus": "ahci",
                "size_bytes": 4294967296
              }
            ],
            "cpu": "max",
            "processors": 4,
            "memory_bytes": 536870912,
            "firmware": "direct",
            "devices": [],
            "boot_options": [
              "rach2.rescue"
            ]
          },
          "console": "serial",
          "qmp": true,
          "helper": false
        },
        {
          "machine_id": "image-helper",
          "qemu": {
            "kernel": "image-kernel",
            "initrd": "image-tools",
            "disks": [
              {
                "name": "image-disk",
                "bus": "ide",
                "size_bytes": 512
              }
            ],
            "cpu": "max",
            "processors": 1,
            "memory_bytes": 268435456,
            "firmware": "direct",
            "devices": [],
            "boot_options": [
              "rach2.rescue"
            ]
          },
          "console": "serial",
          "qmp": true,
          "helper": true
        }
      ],
      "assertions": [
        {
          "assertion_id": "volume",
          "checks": "mkmbr writes the disk's table and mke2fs makes the volume, each exiting 0",
          "source": "scenario"
        },
        {
          "assertion_id": "exit",
          "checks": "punchmusl returns to the debug shell with status 0, by the kernel's record of its exit",
          "source": "scenario"
        },
        {
          "assertion_id": "said-ok",
          "checks": "punchmusl says PUNCH OK and never PUNCH FAIL: every call succeeded, each process read back what it cut or wrote, and the kept files read whole after each remount",
          "source": "scenario"
        },
        {
          "assertion_id": "fsck",
          "checks": "e2fsck -fn on the volume exits 0",
          "source": "scenario"
        },
        {
          "assertion_id": "kept",
          "checks": "the machine prints a PUNCH KEEP line for each of the files that PUNCH KEPT counts, and at least one",
          "source": "scenario"
        },
        {
          "assertion_id": "hash",
          "checks": "every kept file read from the disk image has the length and the hash the machine printed",
          "source": "scenario"
        },
        {
          "assertion_id": "debugfs",
          "checks": "the kept file that debugfs dumps has the hash the machine printed, so the scenario's reader and debugfs read the same bytes",
          "source": "scenario"
        },
        {
          "assertion_id": "hash-catches",
          "checks": "with a byte of a kept file flipped on the disk, its hash differs",
          "source": "scenario"
        },
        {
          "assertion_id": "fsck-catches",
          "checks": "with the bit of a kept block flipped in its bitmap, e2fsck -fn does not exit 0",
          "source": "scenario"
        }
      ],
      "branches": [],
      "termination": {
        "end": "exited",
        "value": 0
      },
      "progress": [
        {
          "witness_id": "stage",
          "kind": "step",
          "means": "a step of the manifest has ended",
          "limit": 6
        }
      ],
      "bounds": {
        "case": {
