    {
      "case_id": "machine.procfiles.applets",
      "behavior": "the installed applets read the machine files successfully and report the independently known processes, root size, routes, held connection, IPv6 sockets and interrupt counts",
      "units": [
        "procfiles"
      ],
      "domain": "machine",
      "architectures": [
        "i686",
        "x86_64"
      ],
      "workload": {
        "arguments": [],
        "inputs": {},
        "repetitions": 1,
        "seed": null
      },
      "requirements": {
        "host_api": "c",
        "tools": [],
        "features": {}
      },
      "execution": {
        "program": "procfiles_scenario",
        "stdin": null,
        "role": "ordinary",
        "privileges": "an ordinary user",
        "isolation": [
          {
            "fixture": "scratch"
          }
        ],
        "children": "none",
        "cleanup": "libetude-case stops the machines and services and removes private disks after success, keeping failed evidence"
      },
      "steps": [
        {
          "step_id": "applets",
          "stage": "execute",
          "machine": "fixture",
          "does": "log in, hold the host connection and run every applet row"
        }
      ],
      "machines": [
        {
          "machine_id": "fixture",
          "qemu": {
            "kernel": "kernel",
            "initrd": "real",
            "disks": [],
            "cpu": "max",
            "processors": 1,
            "memory_bytes": 134217728,
            "firmware": "direct",
            "devices": [
              {
                "model": "rtl8139",
                "forwards": [
                  {
                    "protocol": "tcp",
                    "port": 0,
                    "guest_port": 22
                  }
                ]
              }
            ],
            "boot_options": []
          },
          "console": "serial",
          "qmp": true,
          "helper": false
        }
      ],
      "assertions": [
        {
          "assertion_id": "peer-ready",
          "checks": "the host peer has received the SSH server identification",
          "source": "scenario"
        },
        {
          "assertion_id": "ps-status",
          "checks": "the command exits zero, returns bounded output and reports no missing input file",
          "source": "scenario"
        },
        {
          "assertion_id": "ps-self",
          "checks": "ps lists both the probe and its parent shell by their independently read process ids",
          "source": "scenario"
        },
        {
          "assertion_id": "df-status",
          "checks": "the command exits zero, returns bounded output and reports no missing input file",
          "source": "scenario"
        },
        {
          "assertion_id": "df-size",
          "checks": "df reports the root as os-real's independently known size, 20480 KiB on i686 and 22528 KiB on x86-64",
          "source": "scenario"
        },
        {
          "assertion_id": "free-status",
          "checks": "the command exits zero, returns bounded output and reports no missing input file",
          "source": "scenario"
        },
        {
          "assertion_id": "free-memory",
          "checks": "free reports a nonzero total at least as large as the used memory",
          "source": "scenario"
        },
        {
          "assertion_id": "uptime-status",
          "checks": "the command exits zero, returns bounded output and reports no missing input file",
          "source": "scenario"
        },
        {
          "assertion_id": "uptime",
          "checks": "uptime prints up followed by a numeric duration",
          "source": "scenario"
        },
        {
          "assertion_id": "dmesg-status",
          "checks": "the command exits zero, returns bounded output and reports no missing input file",
          "source": "scenario"
        },
        {
          "assertion_id": "dmesg-banner",
          "checks": "the first line of dmesg contains the kernel boot banner",
          "source": "scenario"
        },
        {
          "assertion_id": "dmesg-console",
          "checks": "the kernel log contains no debug-shell greeting",
          "source": "scenario"
        },
        {
          "assertion_id": "raw-status",
          "checks": "the command exits zero, returns bounded output and reports no missing input file",
          "source": "scenario"
        },
        {
          "assertion_id": "dmesg-records",
          "checks": "dmesg -r returns at least twenty whole records with their priorities and timestamps",
          "source": "scenario"
        },
        {
          "assertion_id": "info-status",
          "checks": "the command exits zero, returns bounded output and reports no missing input file",
          "source": "scenario"
        },
        {
          "assertion_id": "dmesg-info",
          "checks": "dmesg -t -l info begins with the untimed boot banner",
          "source": "scenario"
        },
        {
          "assertion_id": "route-status",
          "checks": "the command exits zero, returns bounded output and reports no missing input file",
          "source": "scenario"
        },
        {
          "assertion_id": "route-default",
          "checks": "route -n reports the default gateway as 10.0.2.2",
          "source": "scenario"
        },
        {
          "assertion_id": "route-subnet",
          "checks": "route -n reports 10.0.2.0 with mask 255.255.255.0",
          "source": "scenario"
        },
        {
          "assertion_id": "netstat-status",
          "checks": "the command exits zero, returns bounded output and reports no missing input file",
          "source": "scenario"
        },
        {
          "assertion_id": "netstat-peer",
          "checks": "netstat reports the held connection from 10.0.2.2 as ESTABLISHED",
          "source": "scenario"
        },
        {
          "assertion_id": "arp-status",
          "checks": "the command exits zero, returns bounded output and reports no missing input file",
          "source": "scenario"
        },
        {
          "assertion_id": "arp-neighbour",
          "checks": "arp reports a resolved neighbour in 10.0.2.0/24 with a hardware address",
          "source": "scenario"
        },
        {
          "assertion_id": "ifconfig-status",
          "checks": "the command exits zero, returns bounded output and reports no missing input file",
          "source": "scenario"
        },
        {
          "assertion_id": "link-running",
          "checks": "ifconfig reports the working eth0 link as RUNNING",
          "source": "scenario"
        },
        {
          "assertion_id": "ipv6-sockets",
          "checks": "the probe opens on ::1 a TCP listener and a connection to it, a bound UDP socket and one connected to it, and a bound raw ICMPv6 socket",
          "source": "scenario"
        },
        {
          "assertion_id": "netstat6-status",
          "checks": "the command exits zero, returns bounded output and reports no missing input file",
          "source": "scenario"
        },
        {
          "assertion_id": "netstat-tcp6",
          "checks": "netstat -tuwan lists the IPv6 listener on ::1 as LISTEN and the connection to it as ESTABLISHED",
          "source": "scenario"
        },
        {
          "assertion_id": "netstat-udp6",
          "checks": "netstat -tuwan lists the bound IPv6 UDP socket with no peer and the one connected to it as ESTABLISHED",
          "source": "scenario"
        },
        {
          "assertion_id": "netstat-raw6",
          "checks": "netstat -tuwan lists the raw ICMPv6 socket bound to ::1 with protocol 58, with or without the scope id BusyBox leaves unset on a raw row",
          "source": "scenario"
        },
        {
          "assertion_id": "netdev-status",
          "checks": "the command exits zero, returns bounded output and reports no missing input file",
          "source": "scenario"
        },
        {
          "assertion_id": "netdev-counters",
          "checks": "eth0 has exactly sixteen numeric counters and nonzero receive and transmit byte counts",
          "source": "scenario"
        },
        {
          "assertion_id": "interrupts-status",
          "checks": "the command exits zero, returns bounded output and reports no missing input file",
          "source": "scenario"
        },
        {
          "assertion_id": "timer",
          "checks": "vector 32 has a nonzero count, controller LAPIC and handler timer",
          "source": "scenario"
        },
        {
          "assertion_id": "stat-status",
          "checks": "the command exits zero, returns bounded output and reports no missing input file",
          "source": "scenario"
        },
        {
          "assertion_id": "interrupt-total",
          "checks": "proc stat counts at least the sum of the vector counts, which includes the timer",
          "source": "scenario"
        }
