{
  "schema_version": 1,
  "family_id": "machine.webgpu",
  "summary": "Chromium adapter requests on Venus compared with Debian under the same QEMU profile; only a named non-fallback Venus adapter can count a compute and render readback pass",
  "cases": [
    {
      "case_id": "machine.webgpu.chromium-webgpu-venus",
      "behavior": "Record default and fallback requestAdapter answers and Dawn adapters on Venus, with the browser acceptance switches, and require the Debian reference answer; count readbacks only on Venus",
      "units": [
        "tests/graphics/browser",
        "chromium"
      ],
      "domain": "machine",
      "architectures": [
        "x86_64"
      ],
      "workload": {
        "arguments": [],
        "inputs": {
          "browser": "chromium",
          "case": "webgpu-venus"
        },
        "repetitions": 1,
        "seed": null
      },
      "requirements": {
        "host_api": "c",
        "tools": [],
        "features": {},
        "hosts": [
          "linux"
        ]
      },
      "execution": {
        "program": "browser_scenario",
        "stdin": null,
        "role": "ordinary",
        "privileges": "an ordinary user",
        "isolation": [
          {
            "fixture": "scratch"
          }
        ],
        "children": "none",
        "cleanup": "libetude-case stops the guest and removes its overlay; the runner reaps its browser, compositor, server and capture before removing scratch"
      },
      "steps": [
        {
          "step_id": "boot",
          "stage": "boot",
          "machine": "gnu",
          "does": "boot the private desktop root and open the guest channel"
        },
        {
          "step_id": "stage",
          "stage": "execute",
          "machine": "gnu",
          "does": "mount the pinned browser files and any clips read-only from their data disks; retain the host load and live admission ledger in the runner record"
        },
        {
          "step_id": "run",
          "stage": "execute",
          "machine": "gnu",
          "does": "run the ordinary browser acceptance case"
        },
        {
          "step_id": "judge",
          "stage": "execute",
          "machine": "gnu",
          "does": "compare the complete result with the pinned Debian evidence"
        },
        {
          "step_id": "collect",
          "stage": "execute",
          "machine": "gnu",
          "does": "fetch the acceptance record and results"
        }
      ],
      "machines": [
        {
          "machine_id": "gnu",
          "qemu": {
            "kernel": "kernel",
            "initrd": null,
            "disks": [
              {
                "name": "gnu-disk",
