      "case_id": "guest.dmabuf.fence",
      "behavior": "A slow producer, eight concurrent producers on one buffer and a failing producer write shared buffers behind sw_sync fences, and each consumer reads the fence state, success or the producer error, before the buffer, over udmabuf and over a card's dumb buffers and syncobjs where a driver offers them",
      "units": [
        "fenceprobe"
      ],
      "domain": "guest",
      "architectures": [
        "i686",
        "x86_64"
      ],
      "workload": {
        "arguments": [],
        "inputs": {},
