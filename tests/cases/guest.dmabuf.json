        "children": "reaped",
        "cleanup": "the probe removes what it made"
      },
      "assertions": [
        {
          "assertion_id": "slow",
          "checks": "A consumer sees a slow producer's fence active, wakes on it, reads its success and then the whole buffer the producer wrote",
          "source": "program"
        },
        {
          "assertion_id": "concurrent",
          "checks": "Eight producers on one buffer give the consumer's fence eight leaves; it signals after the last, and every producer's slice is whole",
          "source": "program"
        },
        {
          "assertion_id": "failed",
          "checks": "A producer that exits without signalling fails its fence with ENOENT, which the parent and three forked consumers each read through their own sync files",
          "source": "program"
        },
        {
          "assertion_id": "dumb",
          "checks": "The slow, concurrent and failed rows pass over a card's dumb buffers exported by PRIME",
          "source": "program"
        },
        {
          "assertion_id": "syncobj-wait",
          "checks": "A syncobj wait, and a timeline point's wait and query where offered, end after a slow producer, whose success the syncobj's sync file reports before the buffer is read",
          "source": "program"
        },
        {
          "assertion_id": "syncobj-error",
          "checks": "A failed producer's error reaches the parent and three forked consumers through the syncobj's fence, while their syncobj waits succeed as on Linux",
          "source": "program"
        }
      ],
