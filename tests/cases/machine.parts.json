{
  "schema_version": 1,
  "family_id": "machine.parts",
  "summary": "The partition tables the kernel reads and the root it chooses by identity, on AHCI disks of crafted tables: four tables read and written by partsprobe and found by the host, a 5 TiB disk's numbers past 32 bits, and seven roots named by identity, found or refused; and the recovery shell's disk write, refused on GUID disks and on an MBR disk whose partition holds the last sector, and taken on one whose last sector is free; the program is tests/cases/machine/parts_scenario.c",
  "cases": [
    {
      "case_id": "machine.parts.tables",
      "behavior": "four partition tables on four AHCI disks are read as built: an MBR with an extended partition of three logical ones, a GUID table, the same table read from its backup, and a blank disk; the nodes are numbered as the tables number them, a logical and a GUID partition take a write, and the host finds both files where the nodes said",
      "units": ["parts", "partsprobe"],
      "domain": "machine",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {"command": "exec /partsprobe"}, "repetitions": 1, "seed": null},
      "requirements": {"host_api": "c", "tools": ["mtype"], "features": {}},
      "execution": {"program": "parts_scenario", "stdin": null, "role": "ordinary", "privileges": "an ordinary user", "isolation": [{"fixture": "scratch"}, {"fixture": "disk", "names": ["parts-a", "parts-b", "parts-c"]}], "children": "none", "cleanup": "libetude-case ends the machine and removes the disk copies and the empty disk, which it keeps after a failure"},
      "steps": [
        {"step_id": "probe", "stage": "execute", "machine": "tables", "does": "boot the test image with disks A, B, C and D on ports 0 to 3 of the AHCI controller, run partsprobe at the debug shell, and end the machine with QMP's quit"},
        {"step_id": "files", "stage": "execute", "does": "read logical.txt out of the copy of A's logical partition 6 and gpt.txt out of the copy of B's GUID entry 3 with mtype"}
      ],
      "machines": [
        {"machine_id": "tables", "qemu": {"kernel": "kernel", "initrd": "test-image", "disks": [{"name": "parts-a", "bus": "ahci"}, {"name": "parts-b", "bus": "ahci"}, {"name": "parts-c", "bus": "ahci"}, {"name": "parts-d", "bus": "ahci", "size_bytes": 8388608}], "cpu": "max", "processors": 1, "memory_bytes": 134217728, "firmware": "direct", "devices": [], "boot_options": ["rach2.disk=ahci", "rach2.diskdiag", "rach2.rescue"]}, "console": "serial", "qmp": true, "helper": false}
      ],
      "assertions": [
        {"assertion_id": "probe-ok", "checks": "partsprobe's line says PARTSPROBE OK, never PARTSPROBE FAIL: /proc/disk lists each disk and partition as built, the nodes exist for the partitions and for no extended entry, seventh entry or blank disk, disk 2 was read from its backup GUID header, two partitions mount and take a write, BLKRRPART is refused while one is mounted and reads the table again once none is, and /sys/block and /sys/dev/block describe a partition", "source": "scenario"},
        {"assertion_id": "logical-file", "checks": "mtype prints 'logical six says hello' out of logical.txt in the FAT32 volume of A's logical partition 6, at sector 112642 of the copy the machine wrote", "source": "scenario"},
        {"assertion_id": "gpt-file", "checks": "mtype prints 'gpt three says hello' out of gpt.txt in the FAT32 volume of B's GUID entry 3, at sector 8192 of the copy the machine wrote", "source": "scenario"}
      ],
