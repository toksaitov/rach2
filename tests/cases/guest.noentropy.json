{
  "schema_version": 1,
  "family_id": "guest.noentropy",
  "summary": "With no trusted entropy the random devices, the salt mint, passwd and Dropbear's key generator refuse and change nothing; each case boots the test image on a processor without RDRAND and RDSEED",
  "cases": [
    {
      "case_id": "guest.noentropy.saltnoent",
      "behavior": "With no trusted entropy the salt mint refuses, says so once and writes nothing, and a writer that minted nothing leaves the shadow file as it was",
      "units": ["musl/saltnoent"],
      "domain": "guest",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {}, "repetitions": 1, "seed": null},
      "requirements": {"host_api": "c", "tools": [], "features": {"rdrand": "absent", "rdseed": "absent"}, "qemu": {"kernel": "kernel", "initrd": "test-image", "disks": [], "cpu": "qemu64", "processors": 1, "memory_bytes": 134217728, "firmware": "direct", "devices": ["virtio-net-pci"], "boot_options": []}},
      "execution": {"program": "saltnoent", "stdin": null, "role": "ordinary", "privileges": "root, to take the lock and read /etc/shadow", "isolation": [], "children": "none", "cleanup": "nothing to remove; /etc/shadow, its temporary files and /etc/.pwlock are as the image has them"},
      "assertions": [
        {"assertion_id": "premise", "checks": "getrandom fails with EIO", "source": "program"},
        {"assertion_id": "mint-refused", "checks": "pwauth_mint_salt returns -1", "source": "program"},
        {"assertion_id": "salt-untouched", "checks": "the refused mint wrote no byte of the salt buffer", "source": "program"},
        {"assertion_id": "said-once", "checks": "the line pwauth: no trusted entropy reaches standard error exactly once", "source": "program"},
        {"assertion_id": "writer-refused", "checks": "inside a writer's transaction the mint refuses too, and the transaction ends", "source": "program"},
        {"assertion_id": "shadow-unchanged", "checks": "/etc/shadow is byte for byte what it was", "source": "program"},
        {"assertion_id": "no-temporary", "checks": "no temporary file of /etc/shadow is left", "source": "program"},
        {"assertion_id": "no-lock", "checks": "no /etc/.pwlock is left", "source": "program"}
      ],
      "branches": [],
      "termination": {"end": "exited", "value": 0},
      "progress": [],
      "bounds": {"case": {"floor_us": 1000000, "initial_us": 300000000, "ceiling_us": 900000000}, "gap": {"floor_us": 1000000, "initial_us": 120000000, "ceiling_us": 600000000}, "stages": {"boot": {"floor_us": 1000000, "initial_us": 120000000, "ceiling_us": 600000000}, "transfer": {"floor_us": 1000000, "initial_us": 300000000, "ceiling_us": 900000000}}},
      "resources": {"cpu_millis": 1000, "cpu_ceiling_millis": 1000, "memory_bytes": 268435456, "disk_bytes": 0, "locks": [], "ports": 0, "loop_devices": 0},
      "prepare": [
        {"name": "saltnoent", "node": "tests/musl/saltnoent", "per_architecture": true},
        {"name": "kernel", "node": "rach2/kernel", "per_architecture": true},
        {"name": "etude-guest", "node": "tools/etude/guest/etude-guest", "per_architecture": true},
        {"name": "test-image", "node": "images/test.krffs", "per_architecture": true}
      ],
      "timing": [],
      "native": {"plan": "none", "class": "feature", "reason": "the processor must lack RDRAND and RDSEED, as QEMU's qemu64 does, so that the kernel's generator is untrusted"}
    },
    {
      "case_id": "guest.noentropy.passwdmusl",
      "behavior": "With no trusted entropy passwd refuses before it asks for a new password, both it and the library say why, and the shadow file is unchanged",
      "units": ["musl/passwdmusl"],
      "domain": "guest",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {}, "repetitions": 1, "seed": null},
      "requirements": {"host_api": "c", "tools": [], "features": {"rdrand": "absent", "rdseed": "absent"}, "qemu": {"kernel": "kernel", "initrd": "test-image", "disks": [], "cpu": "qemu64", "processors": 1, "memory_bytes": 134217728, "firmware": "direct", "devices": ["virtio-net-pci"], "boot_options": []}},
      "execution": {"program": "passwdmusl", "stdin": null, "role": "ordinary", "privileges": "root, to run the set-user-ID /passwd as uid 1000 and read /etc/shadow", "isolation": [], "children": "reaped", "cleanup": "the probe restores /etc/passwd, /etc/shadow and /etc/group and removes the lock"},
      "assertions": [
        {"assertion_id": "change", "checks": "a uid-1000 change of its own password gives a new $6$ hash that crypt reproduces, and leaves every other line, the mode, the owner, no temporary file and no lock", "source": "program"},
        {"assertion_id": "refusals", "checks": "a wrong old password, another account, an account named twice, and records and passwords no reader would accept are refused and change nothing", "source": "program"},
        {"assertion_id": "concurrent", "checks": "two accounts changed at once both survive, and records changed under a writer at its prompt are refused", "source": "program"},
        {"assertion_id": "closed-refused", "checks": "passwd exits with a failure", "source": "program"},
        {"assertion_id": "closed-library", "checks": "the library's line says there is no trusted entropy", "source": "program"},
        {"assertion_id": "closed-program", "checks": "passwd says the password is unchanged", "source": "program"},
        {"assertion_id": "closed-no-prompt", "checks": "passwd never asks for the new password", "source": "program"},
        {"assertion_id": "closed-shadow", "checks": "/etc/shadow is byte for byte what it was", "source": "program"}
      ],
      "branches": [
        {"group_id": "source", "decided_by": {"features": ["rdrand", "rdseed"]}, "alternatives": [{"alternative_id": "trusted", "when": "present", "assertions": ["change", "refusals", "concurrent"]}, {"alternative_id": "fail-closed", "when": "absent", "assertions": ["closed-refused", "closed-library", "closed-program", "closed-no-prompt", "closed-shadow"]}]}
      ],
      "termination": {"end": "exited", "value": 1},
      "progress": [],
      "bounds": {"case": {"floor_us": 1000000, "initial_us": 300000000, "ceiling_us": 900000000}, "gap": {"floor_us": 1000000, "initial_us": 120000000, "ceiling_us": 600000000}, "stages": {"boot": {"floor_us": 1000000, "initial_us": 120000000, "ceiling_us": 600000000}, "transfer": {"floor_us": 1000000, "initial_us": 300000000, "ceiling_us": 900000000}}},
      "resources": {"cpu_millis": 1000, "cpu_ceiling_millis": 1000, "memory_bytes": 268435456, "disk_bytes": 0, "locks": [], "ports": 0, "loop_devices": 0},
      "prepare": [
        {"name": "passwdmusl", "node": "tests/musl/passwdmusl", "per_architecture": true},
        {"name": "kernel", "node": "rach2/kernel", "per_architecture": true},
        {"name": "etude-guest", "node": "tools/etude/guest/etude-guest", "per_architecture": true},
        {"name": "test-image", "node": "images/test.krffs", "per_architecture": true}
      ],
      "timing": [],
      "native": {"plan": "none", "class": "feature", "reason": "the processor must lack RDRAND and RDSEED, as QEMU's qemu64 does, so that the kernel's generator is untrusted"}
    },
    {
      "case_id": "guest.noentropy.rngprobe",
