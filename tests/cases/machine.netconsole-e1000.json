{
  "schema_version": 1,
  "family_id": "machine.netconsole-e1000",
  "summary": "The kernel's log on the wire as netconsole frames from the e1000, at a boot and at a power-off, each a boot that tests/cases/machine/netconsole_scenario.c drives",
  "cases": [
    {
      "case_id": "machine.netconsole-e1000.boot",
      "behavior": "the kernel's log leaves on the wire as netconsole frames from the e1000, the records printed before the card existed among them, and the shell's own output does not",
      "units": ["netconsole-e1000"],
      "domain": "machine",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {}, "repetitions": 1, "seed": null},
      "requirements": {"host_api": "c", "tools": [], "features": {}},
      "execution": {
        "program": "netconsole_scenario",
        "stdin": null,
        "role": "ordinary",
        "privileges": "an ordinary user",
        "isolation": [{"fixture": "scratch"}],
        "children": "none",
        "cleanup": "libetude-case ends the machine and removes the capture, which it keeps after a failure"
      },
      "steps": [
        {
          "step_id": "boot",
          "stage": "boot",
          "machine": "card",
          "does": "boot the test image with netconsole on its command line and its card's frames recorded, until the debug shell's greeting"
        },
        {
          "step_id": "capture",
          "stage": "capture",
          "machine": "card",
          "does": "end the machine through QMP, then run pcapcheck netconsole on its card's frames"
        }
      ],
      "machines": [
        {
          "machine_id": "card",
          "qemu": {
            "kernel": "kernel",
            "initrd": "test-image",
            "disks": [],
            "cpu": "max",
            "processors": 1,
            "memory_bytes": 134217728,
            "firmware": "direct",
            "devices": [{"model": "e1000"}],
            "boot_options": ["rach2.netconsole"],
            "captures": ["net0"]
          },
          "console": "serial",
          "qmp": true,
          "helper": false
        }
      ],
      "assertions": [
        {"assertion_id": "shell", "checks": "the machine reaches the debug shell", "source": "scenario"},
        {
          "assertion_id": "frames",
          "checks": "pcapcheck finds at least four netconsole frames that keep the header's contract: one boot id, one source address, sequence numbers from zero without a gap, lengths that match, checksums that sum to zero and the broadcast destination",
          "source": "scenario"
        },
        {
          "assertion_id": "early-record",
          "checks": "the log the frames carry has the whole record `] boot: Initializing system components`, which the kernel printed before the card existed",
          "source": "scenario"
        },
        {
          "assertion_id": "ready-records",
          "checks": "the log the frames carry has the whole records `] net: ready:` and `] netconsole: broadcast`",
          "source": "scenario"
        },
        {
          "assertion_id": "no-console",
          "checks": "the log the frames carry has neither the shell's greeting `Type 'help'` nor its prompt `> `, which are the console's output and not the log's",
          "source": "scenario"
        }
      ],
      "branches": [],
      "termination": {"end": "exited", "value": 0},
      "progress": [{"witness_id": "stage", "kind": "step", "means": "a step of the manifest has ended", "limit": 2}],
      "bounds": {
        "case": {"floor_us": 5000000, "initial_us": 270000000, "ceiling_us": 810000000},
        "gap": {"floor_us": 1000000, "initial_us": 120000000, "ceiling_us": 360000000},
        "stages": {
          "boot": {"floor_us": 1000000, "initial_us": 120000000, "ceiling_us": 360000000},
          "cleanup": {"floor_us": 100000, "initial_us": 30000000, "ceiling_us": 120000000}
        }
      },
      "resources": {
        "cpu_millis": 1000,
        "cpu_ceiling_millis": 1000,
        "memory_bytes": 268435456,
        "disk_bytes": 67108864,
        "locks": [],
        "ports": 0,
        "loop_devices": 0
      },
      "prepare": [
        {"name": "kernel", "node": "rach2/kernel", "per_architecture": true},
        {"name": "test-image", "node": "images/test.krffs", "per_architecture": true},
        {"name": "pcapcheck", "node": "tests/system/pcapcheck", "per_architecture": false},
        {"name": "netconsole_scenario", "node": "tests/cases/machine/netconsole_scenario", "per_architecture": false}
      ],
      "timing": [],
      "native": {
        "plan": "none",
        "class": "QEMU",
        "reason": "the frames are read from QEMU's filter-dump of the emulated card, which a machine outside QEMU has nothing like"
      }
    },
    {
      "case_id": "machine.netconsole-e1000.stop",
      "behavior": "a machine that powers off sends its goodbye as a netconsole frame from the e1000, and nothing that the kernel prints after it silences the card",
      "units": ["netconsole-e1000"],
      "domain": "machine",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": [], "inputs": {}, "repetitions": 1, "seed": null},
      "requirements": {"host_api": "c", "tools": [], "features": {}},
      "execution": {
        "program": "netconsole_scenario",
        "stdin": null,
        "role": "ordinary",
        "privileges": "an ordinary user",
        "isolation": [{"fixture": "scratch"}],
        "children": "none",
        "cleanup": "libetude-case ends the machine and removes the capture, which it keeps after a failure"
      },
      "steps": [
        {
          "step_id": "boot",
          "stage": "boot",
          "machine": "card",
          "does": "boot the test image with netconsole on its command line and its card's frames recorded, until the debug shell's greeting"
        },
        {
          "step_id": "stop",
          "stage": "execute",
          "machine": "card",
          "does": "type `poweroff` at the shell and wait for the machine to power off"
        },
        {"step_id": "capture", "stage": "capture", "does": "run pcapcheck netconsole on the card's frames"}
      ],
      "machines": [
        {
          "machine_id": "card",
          "qemu": {
            "kernel": "kernel",
            "initrd": "test-image",
            "disks": [],
            "cpu": "max",
            "processors": 1,
            "memory_bytes": 134217728,
            "firmware": "direct",
            "devices": [{"model": "e1000"}],
            "boot_options": ["rach2.netconsole"],
            "captures": ["net0"]
          },
          "console": "serial",
          "qmp": true,
          "helper": false
        }
      ],
      "assertions": [
        {"assertion_id": "shell", "checks": "the machine reaches the debug shell", "source": "scenario"},
        {
          "assertion_id": "powered-off",
          "checks": "after `poweroff` the console says `Stopping the system` and QEMU reports that the machine powered off",
          "source": "scenario"
        },
        {
          "assertion_id": "goodbye",
          "checks": "pcapcheck finds at least four netconsole frames that keep the header's contract: one boot id, one source address, sequence numbers from zero without a gap, lengths that match, checksums that sum to zero and the broadcast destination, and the log they carry has `Stopping the system. Goodbye!`",
          "source": "scenario"
        },
        {
          "assertion_id": "silenced",
          "checks": "the log the frames carry has no `powering off`, which the kernel prints after it has silenced the card",
          "source": "scenario"
        }
      ],
