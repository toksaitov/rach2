        "stages": {
          "boot": {"floor_us": 1000000, "initial_us": 120000000, "ceiling_us": 360000000},
          "cleanup": {"floor_us": 100000, "initial_us": 30000000, "ceiling_us": 120000000}
        }
      },
      "resources": {
        "cpu_millis": 1000,
