        {
          "assertion_id": "blanked",
          "checks": "the kernel records its first blank, console: blanked: 1, on request",
          "source": "scenario"
        },
        {
          "assertion_id": "black",
          "checks": "a QMP screen dump after the record of the blank is one color, black",
          "source": "scenario"
        },
        {
          "assertion_id": "state",
          "checks": "the record that hands the shell back says that blankprobe state exited with status 0",
          "source": "scenario"
        },
        {
          "assertion_id": "forced",
          "checks": "blankprobe state, run after Shift was pressed, prints BLANKPROBE BLANKED 1: a key does not undo TIOCLINUX 14",
          "source": "scenario"
        },
        {
          "assertion_id": "unblank",
          "checks": "the record that hands the shell back says that blankprobe unblank exited with status 0, after TIOCLINUX 15 said 0",
          "source": "scenario"
        },
        {
          "assertion_id": "unblanked",
          "checks": "the kernel records its first unblank, console: unblanked: 1, on request",
          "source": "scenario"
        },
        {
          "assertion_id": "back",
          "checks": "a QMP screen dump after the record of the unblank has more than one color again",
          "source": "scenario"
