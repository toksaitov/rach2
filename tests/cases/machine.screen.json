{
  "schema_version": 1,
  "family_id": "machine.screen",
  "summary": "The console blanked and shown again, by TIOCLINUX, by the escape ESC [ 9 ; N ] and by consoleblank=, each in a boot of its own, judged by the kernel's records of its blanks and by QMP's screen dumps, and the backlight's and the mixer's levels kept across a reboot and a reset with the blank turning the backlight off; the scenarios are machine/screen_scenario.c, with the probe tests/blankprobe.c, and machine/levels_scenario.c",
  "cases": [
    {
      "case_id": "machine.screen.tioclinux",
      "behavior": "blankprobe blanks the console with TIOCLINUX 14, which a key does not undo, and unblanks it with TIOCLINUX 4, each blank and unblank counted in the kernel's records",
      "units": [
        "console",
        "blank",
        "blankprobe"
      ],
      "domain": "machine",
      "architectures": [
        "i686",
        "x86_64"
      ],
      "workload": {
        "arguments": [],
        "inputs": {
          "blank": "exec /blankprobe blank",
          "key": "shift",
          "state": "exec /blankprobe state",
          "unblank": "exec /blankprobe unblank"
        },
        "repetitions": 1,
        "seed": null
      },
      "requirements": {
        "host_api": "c",
        "tools": [],
        "features": {}
      },
      "execution": {
        "program": "screen_scenario",
        "stdin": null,
        "role": "ordinary",
        "privileges": "an ordinary user",
        "isolation": [
          {
            "fixture": "scratch"
