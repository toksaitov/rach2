{
  "schema_version": 1,
  "family_id": "machine.modetest",
  "summary": "every mode of std-vga and virtio-vga, set by libdrm's modetest on the GNU root and read back with drmcapture, judged mode by mode against the Debian reference guest's stored run; the runner is tests/graphics/runners/modetest.sh and the scenario tests/cases/machine/graphics_scenario.c",
  "cases": [
    {
      "case_id": "machine.modetest.std-vga",
      "behavior": "every mode of the connected connector of the std-vga display, set by libdrm's modetest through Rach2's bochs-drm and read back with drmcapture, is set as in the Debian reference guest on the same QEMU profile, at the same size with the same checksum of its pixels",
      "units": [
        "tests/graphics/runners/modetest.sh",
        "tests/graphics/capture/drmcapture.c",
        "tests/graphics/runners/judge.py",
        "libdrm's modetest",
        "rach2/sys/drm"
      ],
      "domain": "machine",
      "architectures": [
        "i686",
        "x86_64"
      ],
      "workload": {
        "arguments": [],
        "inputs": {
          "profile": "std-vga",
          "reference": "tests/graphics/ref/debian/std-vga/modetest/modes"
        },
        "repetitions": 1,
        "seed": null
      },
      "requirements": {
        "host_api": "c",
        "tools": [],
        "features": {},
        "hosts": [
          "linux"
        ]
      },
      "execution": {
        "program": "graphics_scenario",
        "stdin": null,
        "role": "ordinary",
        "privileges": "the runner runs as root in the guest, which it needs to be the card's master",
        "isolation": [
          {
            "fixture": "scratch"
          }
        ],
        "children": "none",
        "cleanup": "libetude-case stops the machine and removes the overlay, which it keeps after a failure"
      },
      "steps": [
        {
          "step_id": "boot",
          "stage": "boot",
          "machine": "gnu",
          "does": "boot an overlay of the GNU system's disk on AHCI with rach2.root=ext2 and the std-vga display, wait for the root and the login prompt, log in as root at the console and open the framed guest channel"
        },
        {
          "step_id": "stage",
          "stage": "execute",
          "machine": "gnu",
          "does": "make /tmp/graphics and copy there from the read-only graphics data disk the runners, the guest's environment, the IGT list and the Debian references, and put drmcapture there, owned by the test account"
        },
        {
          "step_id": "run",
          "stage": "execute",
          "machine": "gnu",
          "does": "run modetest.sh as root, with drmcapture, through the framed guest channel"
        },
        {
          "step_id": "judge",
          "stage": "execute",
          "machine": "gnu",
          "does": "run judge.py modes on the modes and the Debian reference's"
        },
        {
          "step_id": "collect",
          "stage": "execute",
          "machine": "gnu",
          "does": "fetch the runner's output as the evidence out.tar.gz and write the host's half of the record, its load and the admission ledger's claims, as the evidence host-record"
        }
      ],
      "machines": [
        {
          "machine_id": "gnu",
          "qemu": {
            "kernel": "kernel",
            "initrd": null,
            "disks": [
              {
                "name": "gnu-disk",
                "base": "gnu-image",
                "cluster_bytes": 65536,
                "bus": "ahci"
              },
              {
                "name": "graphics-payload",
                "base": "graphics-data",
                "cluster_bytes": 65536,
                "bus": "ahci"
              }
            ],
            "cpu": "max",
            "processors": 2,
            "memory_bytes": 2147483648,
            "firmware": "direct",
            "devices": [],
            "boot_options": [
              "rach2.root=ext2"
            ],
            "display": "std-vga"
          },
          "console": "serial",
          "qmp": true,
          "helper": false
        }
      ],
      "services": [],
      "assertions": [
        {
          "assertion_id": "ran",
          "checks": "modetest.sh exits 0, having tried every mode, and prints its result line",
          "source": "scenario"
        },
        {
          "assertion_id": "as-debian",
          "checks": "judge.py finds the same modes as in the Debian reference guest, stored under tests/graphics/ref/debian, each that was set there set here at its size with its checksum, and prints judge: result: pass",
          "source": "scenario"
        }
