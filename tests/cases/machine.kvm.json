{
  "schema_version": 1,
  "family_id": "machine.kvm",
  "summary": "Rach2's KVM run by Debian's QEMU on the x86-64 GNU root: the Debian guest of tests/kvm/guests booted to its token by tests/kvm/kvm-boot.sh, and kvm-unit-tests and Linux's KVM selftests run by tests/kvm/corpus.sh as tests/kvm/unit-tests.list and selftests.list say, on the max-svm and host-svm processor profiles; the scenario is tests/cases/machine/kvm_scenario.c",
  "cases": [
    {
      "case_id": "machine.kvm.boot-debian-tcg",
      "behavior": "kvm-boot.sh boots the Debian guest of tests/kvm/guests, Debian's cloud kernel and an initramfs of Debian's static BusyBox, in the GNU root's QEMU under TCG on Rach2, and the guest prints KVMGUEST OK on its serial console and powers off",
      "units": [
        "tests/kvm/kvm-boot.sh",
        "tests/kvm/guests",
        "Debian's QEMU in the GNU root",
        "tests/kvm/Readme.md",
        "tests/cases/machine/kvm_scenario.c"
      ],
      "domain": "machine",
      "architectures": [
        "x86_64"
      ],
      "workload": {
        "arguments": [],
        "inputs": {
          "runner": "kvm-boot.sh"
        },
        "repetitions": 1,
        "seed": null
      },
      "requirements": {
        "host_api": "c",
        "tools": [],
        "features": {},
        "hosts": [
          "linux",
          "macos"
        ]
      },
      "execution": {
        "program": "kvm_scenario",
        "stdin": null,
        "role": "ordinary",
        "privileges": "the runner runs as root in the guest, which opens /dev/kvm and mounts the data disk",
        "isolation": [
          {
            "fixture": "scratch"
          }
        ],
        "children": "none",
        "cleanup": "libetude-case stops the machine and removes the overlay, which it keeps after a failure"
      },
      "steps": [
        {
          "step_id": "boot",
          "stage": "boot",
          "machine": "gnu",
          "does": "boot an overlay of the GNU system's disk on AHCI with rach2.root=ext2 and no display, wait for the root and the login prompt, log in as root at the console and open the framed guest channel"
        },
        {
          "step_id": "stage",
          "stage": "execute",
          "machine": "gnu",
          "does": "make /tmp/kvm and copy there from the read-only KVM data disk the runners, the lists and the Debian guest"
        },
        {
          "step_id": "run",
          "stage": "execute",
          "machine": "gnu",
          "does": "run kvm-boot.sh -a tcg on the Debian guest as root, through the framed guest channel"
        }
      ],
      "machines": [
        {
          "machine_id": "gnu",
          "qemu": {
            "kernel": "kernel",
            "initrd": null,
            "disks": [
              {
                "name": "gnu-disk",
