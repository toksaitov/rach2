      "case_id": "guest.queue.write",
      "behavior": "a batch of 1280 KiB written to an ext2 volume on a port of an AHCI controller syncs, reads back byte for byte, and leaves the mount writable",
      "units": ["queue", "ahciprobe"],
      "domain": "guest",
      "architectures": ["i686", "x86_64"],
