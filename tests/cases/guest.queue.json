  "cases": [
    {
      "case_id": "guest.queue.read",
      "behavior": "two disks on two ports of one AHCI controller each read in chunks by a process of its own complete through the driver's message-signalled interrupts",
      "units": ["queue", "ahciprobe"],
      "domain": "guest",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": ["read"], "inputs": {}, "repetitions": 1, "seed": null},
      "requirements": {"host_api": "c", "tools": [], "features": {}, "qemu": {"kernel": "kernel", "initrd": "test-image", "disks": [{"name": "queue-slow", "bus": "ahci"}, {"name": "queue-fast", "bus": "ahci"}], "cpu": "max", "processors": 1, "memory_bytes": 134217728, "firmware": "direct", "devices": [], "boot_options": ["rach2.rescue"]}},
      "execution": {"program": "ahciprobe", "stdin": null, "role": "ordinary", "privileges": "root, which reads the disks' nodes", "isolation": [{"fixture": "disk", "names": ["queue-slow", "queue-fast"]}], "children": "reaped", "cleanup": "nothing; the readers are reaped, and the disks are the attempt's private copies"},
      "assertions": [
