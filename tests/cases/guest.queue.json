        {"assertion_id": "synced", "checks": "the sync after the batch returns 0", "source": "program"},
        {"assertion_id": "read-back", "checks": "late.bin reads back whole, every block of 4 KiB as written", "source": "program"},
        {"assertion_id": "writable", "checks": "a second file is made on the volume after the batch, which a mount that went read-only refuses, and the next sync returns 0", "source": "program"},
        {"assertion_id": "unmounted", "checks": "the volume unmounts and /late is removed", "source": "program"}
