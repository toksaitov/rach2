      "behavior": "page faults of a KRFFS root on a port of an AHCI controller, from blockprobe, complete beside raw reads of a second partition of the same disk, and a fault's polled command finishes a queued read it finds active",
      "units": ["queue", "ahciprobe"],
      "domain": "guest",
      "architectures": ["i686", "x86_64"],
      "workload": {"arguments": ["fault"], "inputs": {}, "repetitions": 1, "seed": null},
