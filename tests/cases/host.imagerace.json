  "cases": [
    {
      "case_id": "host.imagerace.concurrent",
      "behavior": "two builds of one image by krffs/mkimage.sh at once, each held before it publishes until the other has made its temporary image, both finish and leave the image whole",
      "units": [
        "imagerace",
        "`tests/system/imagerace.sh`, two builds of one image at once"
      ],
      "domain": "host",
      "architectures": "none",
      "workload": {
        "arguments": [
          "concurrent"
        ],
        "inputs": {
          "manifest": "krffs/manifests/imagerace-tree.manifest",
          "size_mib": 2,
          "builds": 2
        },
        "repetitions": 1,
        "seed": null
      },
      "requirements": {
        "host_api": "c",
        "tools": [],
        "features": {}
      },
      "execution": {
        "program": "family_scenario",
        "stdin": null,
        "role": "ordinary",
        "privileges": "an ordinary user",
        "isolation": [
          {
            "fixture": "scratch"
          }
        ],
        "children": "reaped",
        "cleanup": "libetude-case ends the declared helper and removes its private disk; the C controller removes its fixture after a pass and exports failure evidence"
      },
      "assertions": [
        {
          "assertion_id": "met",
          "checks": "each build reached the touch of its temporary image while the other's temporary image existed",
          "source": "scenario"
        },
        {
          "assertion_id": "first",
          "checks": "the first build ends with status 0",
          "source": "scenario"
        },
        {
          "assertion_id": "second",
          "checks": "the second build ends with status 0",
          "source": "scenario"
        },
        {
          "assertion_id": "image",
          "checks": "the image is left, with the staged program's words",
          "source": "scenario"
        },
        {
          "assertion_id": "deps",
          "checks": "the dependency file is left, and names the staged program",
          "source": "scenario"
        },
        {
          "assertion_id": "temporaries",
          "checks": "no temporary file of either build is left beside the image",
          "source": "scenario"
        }
      ],
      "branches": [],
      "termination": {
        "end": "exited",
        "value": 0
