    {
      "case_id": "host.imagerace.interrupted",
      "behavior": "a rebuild of an image by krffs/mkimage.sh that adds a second program, stopped by SIGTERM at each step of its publication in turn, fails, leaves no temporary and no new image beside old lists, and one make then gives what an uninterrupted build gives",
      "units": [
        "imagerace"
