      },
      "assertions": [
        {
          "assertion_id": "counted",
          "checks": "an uninterrupted rebuild passes through the steps the stops are put at, the write of the temporary image, the touch and the moves of the list of programs, the dependency file and the image among them",
          "source": "scenario"
        },
        {
          "assertion_id": "status",
          "checks": "the rebuild stopped at each step was stopped there, and ends with a status other than 0",
          "source": "scenario"
        },
        {
          "assertion_id": "temporaries",
          "checks": "no stopped rebuild leaves a temporary file beside the image",
          "source": "scenario"
        },
        {
          "assertion_id": "matched",
          "checks": "no stopped rebuild leaves an image with the second program beside a dependency file or a list of programs that lacks it",
          "source": "scenario"
        },
        {
          "assertion_id": "current",
          "checks": "after each stopped rebuild, one make leaves the image with both programs, and the dependency file and the list of programs of an uninterrupted build",
          "source": "scenario"
        }
