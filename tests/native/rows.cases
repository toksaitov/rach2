case gnu/patch -- system/gnu_rows.sh patch x86_64 work=work home=home stage=. @net machine=native
case gnu/tar -- system/gnu_rows.sh tar x86_64 work=work home=home stage=. @net machine=native
case gnu/gzip -- system/gnu_rows.sh gzip x86_64 work=work home=home stage=. @net machine=native
case gnu/xz -- system/gnu_rows.sh xz x86_64 work=work home=home stage=. @net machine=native
case gnu/iproute2 ports:5999 -- system/gnu_rows.sh iproute2 x86_64 work=work home=home stage=. @net machine=native
case gnu/loopctl alone -- system/gnu_rows.sh loopctl x86_64 work=work home=home stage=. @net machine=native
case gnu/losetup mountns alone -- system/gnu_rows.sh losetup x86_64 work=work home=home stage=. @net machine=native
case gnu/e2fsprogs -- system/gnu_rows.sh e2fsprogs x86_64 work=work home=home stage=. @net machine=native
case gnu/file -- system/gnu_rows.sh file x86_64 work=work home=home stage=. @net machine=native
case gnu/pkgconf -- system/gnu_rows.sh pkgconf x86_64 work=work home=home stage=. @net machine=native
case gnu/procps -- system/gnu_rows.sh procps x86_64 work=work home=home stage=. @net machine=native
case gnu/utillinux -- system/gnu_rows.sh utillinux x86_64 work=work home=home stage=. @net machine=native
