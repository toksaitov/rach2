# The native cases of the GNU and agents rows and of tccbuild.sh
# (Readme.md). A program named system/ or native/ is a script of tests/, not
# a program of the build. A word `@net` of a command is the machine's
# interface, address and gateway, as run.sh gives them, and a word
# `@agents:NAME` is the version that vendor/gnu/agents/packages/NAME.sh pins.
# `file:PATH` puts the file PATH of the tree in the workspace.
#
# Left out, as tests/system/gnu_rows.sh says, under machine=native: the
# login to the machine's own server in openssh, rsync and utillinux, whose
# `last` then finds no session of root's, the counts of the whole machine in
# procps, utillinux and chromium, and the write refused over the root in
# disknode. The rows cron, shadow and ntpd change the
# machine (`machine`).

case gnu/names -- system/gnu_rows.sh names x86_64 work=work home=home stage=. @net machine=native
case gnu/glibc -- system/gnu_rows.sh glibc x86_64 work=work home=home stage=. @net machine=native
case gnu/zlib -- system/gnu_rows.sh zlib x86_64 work=work home=home stage=. @net machine=native
case gnu/openssl -- system/gnu_rows.sh openssl x86_64 work=work home=home stage=. @net machine=native
case gnu/openssh -- system/gnu_rows.sh openssh x86_64 work=work home=home stage=. @net machine=native
case gnu/ncurses -- system/gnu_rows.sh ncurses x86_64 work=work home=home stage=. @net machine=native
case gnu/less -- system/gnu_rows.sh less x86_64 work=work home=home stage=. @net machine=native
