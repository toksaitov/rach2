case gnu/fallocate -- system/gnu_rows.sh fallocate x86_64 work=work home=home stage=. @net machine=native
case gnu/chattr -- system/gnu_rows.sh chattr x86_64 work=work home=home stage=. @net machine=native
case gnu/filecache -- system/gnu_rows.sh filecache x86_64 work=work home=home stage=. @net machine=native
case gnu/uname -- system/gnu_rows.sh uname x86_64 work=work home=home stage=. @net machine=native
case gnu/ttygroup -- system/gnu_rows.sh ttygroup x86_64 work=work home=home stage=. @net machine=native
case gnu/disknode -- system/gnu_rows.sh disknode x86_64 work=work home=home stage=. @net machine=native
case gnu/python -- system/gnu_rows.sh python x86_64 work=work home=home stage=. @net machine=native
case gnu/gnupg -- system/gnu_rows.sh gnupg x86_64 work=work home=home stage=. @net machine=native
case gnu/autotools file:build/tests/cases/gnu/sed.tar.xz -- \
    system/gnu_rows.sh autotools x86_64 work=work home=home stage=. @net machine=native
case gnu/make -- system/gnu_rows.sh make x86_64 work=work home=home stage=. @net machine=native
case gnu/gcc -- system/gnu_rows.sh gcc x86_64 work=work home=home stage=. @net machine=native
case gnu/gdb -- system/gnu_rows.sh gdb x86_64 work=work home=home stage=. @net machine=native
case gnu/js -- system/gnu_rows.sh js x86_64 work=work home=home stage=. @net machine=native
