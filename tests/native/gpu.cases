# The speed gate: glmark2's benchmark.
case gpu/gate-glmark2.gl alone log \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/glmark2.sh file:tests/graphics/ref/lenovo/gate \
    -- graphics/runners/lenovo.sh gate glmark2 gl gate
case gpu/gate-glmark2.es2 alone log \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/glmark2.sh file:tests/graphics/ref/lenovo/gate \
    -- graphics/runners/lenovo.sh gate glmark2 es2 gate
