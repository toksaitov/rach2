    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/piglit.sh file:tests/graphics/ref/lenovo/expect/piglit-quick.rows.gz \
    -- graphics/runners/lenovo.sh piglit quick-glsl1 piglit-quick.rows.gz
case gpu/piglit-glsl2 alone log \
