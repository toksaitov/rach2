# The Lenovo's GPU conformance cases (Readme.md): each runner of
# tests/graphics on the machine's own HD 4400 and display, judged case by
# case against Linux's run on the same machine, and the speed gate against
# Linux with the IOMMU's translation off. A program named graphics/ is a
# script of tests/graphics, which lenovo.sh runs with the files the case
# names beside it; tests/graphics/Readme.md's Lenovo section says what each
# case runs and where its reference came from. Every case runs alone, with
# the kernel's records kept, the silent ones first and those that take the
# panel last.

# dEQP-GLES of VK-GL-CTS 1.4.7.1, as root on the render node.
case gpu/deqp-gles2 alone log \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/deqp.sh file:tests/graphics/ref/lenovo/deqp/gles2/results.csv.gz \
    -- graphics/runners/lenovo.sh deqp gles2 1/1 results.csv.gz
case gpu/deqp-gles3.1 alone log \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/deqp.sh file:tests/graphics/ref/lenovo/deqp/gles3/results.csv.gz \
    -- graphics/runners/lenovo.sh deqp gles3 1/2 results.csv.gz
case gpu/deqp-gles3.2 alone log \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/deqp.sh file:tests/graphics/ref/lenovo/deqp/gles3/results.csv.gz \
    -- graphics/runners/lenovo.sh deqp gles3 2/2 results.csv.gz
case gpu/deqp-gles31.1 alone log \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/deqp.sh file:tests/graphics/ref/lenovo/deqp/gles31/results.csv.gz \
    -- graphics/runners/lenovo.sh deqp gles31 1/3 results.csv.gz
case gpu/deqp-gles31.2 alone log \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/deqp.sh file:tests/graphics/ref/lenovo/deqp/gles31/results.csv.gz \
    -- graphics/runners/lenovo.sh deqp gles31 2/3 results.csv.gz
case gpu/deqp-gles31.3 alone log \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/deqp.sh file:tests/graphics/ref/lenovo/deqp/gles31/results.csv.gz \
    -- graphics/runners/lenovo.sh deqp gles31 3/3 results.csv.gz

# piglit's quick profile through GBM, as the desktop's user.
