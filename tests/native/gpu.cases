    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/webgl.sh file:tests/graphics/runners/webgl.html file:tests/graphics/runners/server.py file:tests/graphics/runners/events.py file:tests/graphics/runners/webgl-lenovo.omit file:tests/graphics/ref/lenovo/expect/webgl-firefox.pages \
    -- graphics/runners/lenovo.sh webgl firefox 10 webgl-firefox.pages
case gpu/webgl-firefox.11 alone log \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/webgl.sh file:tests/graphics/runners/webgl.html file:tests/graphics/runners/server.py file:tests/graphics/runners/events.py file:tests/graphics/runners/webgl-lenovo.omit file:tests/graphics/ref/lenovo/expect/webgl-firefox.pages \
    -- graphics/runners/lenovo.sh webgl firefox 11 webgl-firefox.pages

# The speed gate's WebGL fill and ALU checks; their Linux measures go in ref/lenovo/gate.
case gpu/gate-probe.chromium alone log \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/probe.sh file:tests/graphics/runners/probe.html file:tests/graphics/runners/server.py file:tests/graphics/runners/events.py file:tests/graphics/ref/lenovo/gate \
    -- graphics/runners/lenovo.sh gate probe chromium gate
case gpu/gate-probe.firefox alone log \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/probe.sh file:tests/graphics/runners/probe.html file:tests/graphics/runners/server.py file:tests/graphics/runners/events.py file:tests/graphics/ref/lenovo/gate \
    -- graphics/runners/lenovo.sh gate probe firefox gate

# The test bed's harness on the GPU, the rung native-rach2, each scene under
# a headless Weston of its own, set beside Linux's native-linux line (83-7).
# The webgl scene waits for its fault, Chromium's lost context on Rach2's
# Mesa (dev-log/83-testbed/83-7.md, "The WebGL scene").
case testbed/glmark2 alone log \
    file:bed/measure/measure.sh file:bed/measure/piglit.txt file:bed/measure/latency.c file:bed/measure/webgl.html \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/games.sh file:tests/graphics/runners/piglit.sh \
    file:bed/measure/ref/lenovo-linux.lines \
    -- native/testbed.sh glmark2 lenovo-linux.lines
case testbed/piglit alone log \
    file:bed/measure/measure.sh file:bed/measure/piglit.txt file:bed/measure/latency.c file:bed/measure/webgl.html \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/games.sh file:tests/graphics/runners/piglit.sh \
    file:bed/measure/ref/lenovo-linux.lines \
    -- native/testbed.sh piglit lenovo-linux.lines
case testbed/game alone log \
    file:bed/measure/measure.sh file:bed/measure/piglit.txt file:bed/measure/latency.c file:bed/measure/webgl.html \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/games.sh file:tests/graphics/runners/piglit.sh \
    file:bed/measure/ref/lenovo-linux.lines \
    -- native/testbed.sh game lenovo-linux.lines

# Video on the GPU against Linux's decodes, browser plays and hangs (78-14b,
# native/gpuvideo.sh); the clips and vahash are on the data partition, under
# native/video/clips, and the hang check goes last, since it hangs the
# render ring on purpose.
case video/decode alone log mountns \
    file:tests/graphics/lenovo/video-gpu.sh file:tests/graphics/guest-env.sh \
    file:tests/graphics/runners/video.sh file:tests/graphics/runners/common.sh file:tests/graphics/runners/server.py \
    file:tests/graphics/runners/cdp.py file:tests/graphics/runners/events.py file:tests/graphics/runners/video.html \
    file:tests/graphics/runners/clips.sha256 file:tests/graphics/runners/judge.py file:tests/graphics/runners/video.limits \
    file:tests/graphics/ref/lenovo-video/data.sha256 file:tests/graphics/ref/lenovo-video/linux.tar.gz \
    -- native/gpuvideo.sh decode data.sha256 linux.tar.gz
case video/browsers alone log mountns \
    file:tests/graphics/lenovo/video-gpu.sh file:tests/graphics/guest-env.sh \
    file:tests/graphics/runners/video.sh file:tests/graphics/runners/common.sh file:tests/graphics/runners/server.py \
    file:tests/graphics/runners/cdp.py file:tests/graphics/runners/events.py file:tests/graphics/runners/video.html \
    file:tests/graphics/runners/clips.sha256 file:tests/graphics/runners/judge.py file:tests/graphics/runners/video.limits \
    file:tests/graphics/ref/lenovo-video/data.sha256 file:tests/graphics/ref/lenovo-video/linux.tar.gz \
    file:tests/graphics/ref/lenovo-video/spread \
    -- native/gpuvideo.sh browsers data.sha256 linux.tar.gz spread
case video/hang alone log mountns \
    file:tests/graphics/lenovo/video-gpu.sh file:tests/graphics/guest-env.sh \
    file:tests/graphics/runners/video.sh file:tests/graphics/runners/common.sh file:tests/graphics/runners/server.py \
    file:tests/graphics/runners/cdp.py file:tests/graphics/runners/events.py file:tests/graphics/runners/video.html \
    file:tests/graphics/runners/clips.sha256 file:tests/graphics/runners/judge.py file:tests/graphics/runners/video.limits \
    file:tests/graphics/ref/lenovo-video/data.sha256 file:tests/graphics/ref/lenovo-video/linux.tar.gz \
    -- native/gpuvideo.sh hang data.sha256 linux.tar.gz

# The test bed's rungs through a VM on the GPU (83-7, native/bed.sh): the
# shared region's session, figures and the VM's death under load, then the
# forward guest's glmark2 through virgl and Venus. The VMs' disks are on the
# data partition, under native/bed, which tests/kvm/ref/lenovo-bed.sha256
# pins.
case bed/shm alone log mountns stage:vgshmprobe \
    file:tests/kvm/bed-shm.sh file:tests/assign/gpu.sh file:bed/forward/forward.sh \
    file:dev-log/82-assign/82-4/check.sh file:dev-log/78-intel/78-10d/crcmodes.c \
    file:bed/measure/measure.sh file:bed/measure/piglit.txt file:bed/measure/latency.c file:bed/measure/webgl.html \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/games.sh file:tests/graphics/runners/piglit.sh \
    file:tests/kvm/ref/lenovo-bed.sha256 \
    -- native/bed.sh shm lenovo-bed.sha256
case bed/forward.virgl alone log mountns stage:vgshmprobe \
    file:tests/kvm/bed-shm.sh file:tests/assign/gpu.sh file:bed/forward/forward.sh \
    file:dev-log/82-assign/82-4/check.sh file:dev-log/78-intel/78-10d/crcmodes.c \
    file:bed/measure/measure.sh file:bed/measure/piglit.txt file:bed/measure/latency.c file:bed/measure/webgl.html \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/games.sh file:tests/graphics/runners/piglit.sh \
    file:tests/kvm/ref/lenovo-bed.sha256 \
    -- native/bed.sh forward virgl lenovo-bed.sha256
case bed/forward.venus alone log mountns stage:vgshmprobe \
    file:tests/kvm/bed-shm.sh file:tests/assign/gpu.sh file:bed/forward/forward.sh \
    file:dev-log/82-assign/82-4/check.sh file:dev-log/78-intel/78-10d/crcmodes.c \
    file:bed/measure/measure.sh file:bed/measure/piglit.txt file:bed/measure/latency.c file:bed/measure/webgl.html \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/games.sh file:tests/graphics/runners/piglit.sh \
    file:tests/kvm/ref/lenovo-bed.sha256 \
    -- native/bed.sh forward venus lenovo-bed.sha256

# The panel, the touchpad and the data partition: the rows of 76's
# checkpoint slice that need the machine, on i915's mode at 1366x768
# (native/display.sh).
case display/touchpad alone log stage:evprobe -- native/display.sh touchpad
case display/kept alone mountns -- native/display.sh kept
case display/drm alone log stage:drmprobe -- native/display.sh drm
case display/weston alone log -- native/display.sh weston

# The native games' fixed replays, once each with Mesa's shader cache
# empty, on the desktop's session on the panel with sound at volume 1,
# judged against the mean of Linux's two runs (80-7b,
# tests/system/games/lenovo.sh). The two 64-bit cases also print 84's
# big-lock counter deltas with the GPU minimum at 1000 MHz, which the
# gpumin fixture writes back once the case has ended, a forced stop
# included; the i386 game is not judged.
case games/supertuxkart alone log gpumin \
    file:tests/graphics/runners/games.sh file:tests/graphics/runners/common.sh \
    -- system/games/lenovo.sh -n 1 -r . out supertuxkart
case games/0ad alone log gpumin \
    file:tests/graphics/runners/games.sh file:tests/graphics/runners/common.sh \
    -- system/games/lenovo.sh -n 1 -r . out 0ad
case games/supertuxkart-i386 alone log \
    file:tests/graphics/runners/games.sh file:tests/graphics/runners/common.sh \
    -- system/games/lenovo.sh -n 1 -r . out supertuxkart-i386

# Crysis on a private copy of the game of the data partition, which stays
# read-only, with sound at volume 1: the flyby through umu and directly, its
# first two loops judged against 24 frames a second, and 80-9's save loaded
# after this release's update, through a copy of the game's prefix and a new
# one (80-9, native/crysis.sh).
case games/crysis.flyby-umu alone log mountns private \
    file:tests/system/games/crysis.py file:tests/system/games/wm.py \
    -- native/crysis.sh flyby umu
case games/crysis.flyby-direct alone log mountns private \
    file:tests/system/games/crysis.py file:tests/system/games/wm.py \
    -- native/crysis.sh flyby direct
case games/crysis.load alone log mountns private \
    file:tests/system/games/crysis.py file:tests/system/games/wm.py \
    -- native/crysis.sh load default_accept_s2.CRYSISJMSF
