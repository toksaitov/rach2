# Lenovo GPU cases that wait for their Linux references (gpu.cases), which
# the Debian boot of 83-15 makes on the same Lenovo: IGT's buffer and
# submission rows, glmark2's validations, both browsers' WebGL pages and the
# gate's eight WebGL probe measures, the video checks' output with the
# digests of the clips and vahash that boot leaves on the data partition,
# and the digests of the test bed's VM disks it leaves there.
# etude reads probes.cases, musl.cases, rows.cases and gpu.cases, never this
# file, since native preparation copies every file a case declares and these
# references are not yet in the tree. The task that commits a case's
# reference moves the case into gpu.cases.

# IGT's buffer and submission tests, as root.
case gpu/igt-gem.1 alone log \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/igt.sh file:tests/graphics/igt-lenovo-gem.list file:tests/graphics/ref/lenovo/expect/igt-gem.rows \
    -- graphics/runners/lenovo.sh igt igt-lenovo-gem.list gem-1 igt-gem.rows
case gpu/igt-gem.2 alone log \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/igt.sh file:tests/graphics/igt-lenovo-gem.list file:tests/graphics/ref/lenovo/expect/igt-gem.rows \
    -- graphics/runners/lenovo.sh igt igt-lenovo-gem.list gem-2 igt-gem.rows

# glmark2's scenes validated fullscreen on the desktop's compositor.
case gpu/glmark2.gl alone log \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/glmark2.sh file:tests/graphics/ref/lenovo/expect/glmark2-gl.validations \
    -- graphics/runners/lenovo.sh glmark2 gl glmark2-gl.validations
case gpu/glmark2.es2 alone log \
    file:tests/graphics/runners/common.sh file:tests/graphics/runners/judge.py file:tests/graphics/guest-env.sh file:tests/graphics/ref/lenovo/exclusions \
    file:tests/graphics/runners/glmark2.sh file:tests/graphics/ref/lenovo/expect/glmark2-es2.validations \
    -- graphics/runners/lenovo.sh glmark2 es2 glmark2-es2.validations

