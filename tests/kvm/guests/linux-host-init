#!/bin/busybox sh
# linux-host-init: /init of the Linux host that mklinuxhost.sh makes. It
# loads the AHCI and KVM modules of Debian's kernel, mounts the GNU root of
# the first disk read-only, binds its directories into a tmpfs with a tmpfs
# on /tmp, copies the KVM suite's data disk, the second, to /tmp/kvm, and
# runs there, in a chroot of that tmpfs, under Linux's KVM: with no
# `linuxhost=` on the kernel's command line, the guest boots under exits.sh
# that the measurements of Rach2's KVM run, the Debian guest twice and the
# i686 Rach2 guest once, each under the root's own QEMU; with
# `linuxhost=selftests:LIST`, `corpus.sh selftests LIST` of the data disk, as
# Rach2 runs it. Then it powers the machine off. The kernel gives init each
# word of its command line it does not know, `linuxhost=` among them, as a
# variable of its environment.
B=/bin/busybox
$B mount -t proc proc /proc
$B mount -t sysfs sysfs /sys
$B mount -t devtmpfs devtmpfs /dev
for m in scsi_common scsi_mod libata libahci ahci sd_mod irqbypass kvm kvm-amd; do
    $B insmod /lib/modules/$m.ko || echo "linuxhost: insmod: failed: $m"
done
i=0
while { [ ! -b /dev/sda1 ] || [ ! -b /dev/sdb ]; } && [ $i -lt 60 ]; do
    $B sleep 1
    i=$((i + 1))
done
# The GNU root has no /dev, /proc or /sys of its own, which Rach2 makes, and
# is read-only, so the chroot is a tmpfs with its directories bound in.
g=/gnu
r=/root
if ! $B mount -t ext4 -o ro /dev/sda1 $g; then
    echo "linuxhost: the GNU root did not mount"
    $B poweroff -f
fi
$B mount -t tmpfs tmpfs $r
for e in $g/*; do
    b=${e#$g/}
    case $b in
        dev | proc | sys | tmp) ;;
        *)
            if [ -d $e ] && [ ! -L $e ]; then
                $B mkdir $r/$b && $B mount -o bind $e $r/$b
            else
                $B cp -a $e $r/$b
            fi
            ;;
    esac
done
$B mkdir -p $r/dev $r/proc $r/sys $r/tmp
$B mount -t tmpfs tmpfs $r/tmp
$B mount -o bind /dev $r/dev
$B mount -t proc proc $r/proc
$B mount -t sysfs sysfs $r/sys
$B mount -t debugfs debugfs $r/sys/kernel/debug
$B mount -t tracefs tracefs $r/sys/kernel/tracing
$B mkdir -p $r/tmp/kd $r/tmp/kvm
$B mount -t ext4 -o ro /dev/sdb $r/tmp/kd && $B cp -R $r/tmp/kd/. $r/tmp/kvm && $B umount $r/tmp/kd
echo "linuxhost: kernel: $($B uname -r), $($B grep -c ^processor /proc/cpuinfo) processor(s)"
echo "linuxhost: kvm: $($B ls -l /dev/kvm 2>&1)"
case ${linuxhost:-} in
    selftests:*)
        list=${linuxhost#selftests:}
        $B chroot $r /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/tmp \
            /bin/sh -c 'cd /tmp/kvm && sh corpus.sh selftests "$1"' sh "$list" 2>&1
        echo "linuxhost: done"
        $B poweroff -f
        ;;
esac
$B chroot $r /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/tmp /bin/sh -c '
cd /tmp/kvm || exit 1
sh exits.sh sh kvm-boot.sh -a kvm -o /tmp/kvm/boot1.log -k guests/debian/vmlinuz -i guests/debian/initrd
sh exits.sh sh kvm-boot.sh -a kvm -o /tmp/kvm/boot2.log -k guests/debian/vmlinuz -i guests/debian/initrd
sh exits.sh sh kvm-boot.sh -a kvm -o /tmp/kvm/boot3.log -k guests/rach2/kernel -i guests/rach2/ram.krffs -l rach2.tscreliable -t "KVMRACH2 OK"
'
echo "linuxhost: done"
$B poweroff -f
