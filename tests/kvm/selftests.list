x86_64/sev_init2_tests skip skip Requirement not met: __kvm_has_device_attr(kvm_fd, KVM_X86_GRP_SEV, KVM_X86_SEV_VMSA_FEATURES) == 0
x86_64/sev_migrate_tests skip skip Requirement not met: kvm_cpu_has(X86_FEATURE_SEV)
x86_64/sev_smoke_test skip skip Requirement not met: kvm_cpu_has(X86_FEATURE_SEV)
x86_64/smaller_maxphyaddr_emulation_test skip skip Requirement not met: kvm_has_cap(KVM_CAP_SMALLER_MAXPHYADDR)
