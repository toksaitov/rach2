abort_mask : 1
disk_usage_limit : 0
name : kms-hsw
dry_run : 0
allow_non_root : 0
facts : 0
kmemleak : 0
kmemleak_each : 0
sync : 1
log_level : 0
overwrite : 0
multiple_mode : 0
inactivity_timeout : 0
per_test_timeout : 120
overall_timeout : 7200
use_watchdog : 0
piglit_style_dmesg : 0
dmesg_warn_level : 4
prune_mode : 2
test_root : /root/run2/cache/step9/igt/igt-build/tests
results_path : /srv/run2/step9/logs/igt/results
enable_code_coverage : 0
cov_results_per_test : 0
cmdline.argc : 15
cmdline.argv[0] : ./runner/igt_runner
cmdline.argv[1] : -n
cmdline.argv[2] : kms-hsw
cmdline.argv[3] : -s
cmdline.argv[4] : --per-test-timeout
cmdline.argv[5] : 120
cmdline.argv[6] : --overall-timeout
cmdline.argv[7] : 7200
cmdline.argv[8] : --abort-on-monitored-error=taint
cmdline.argv[9] : -t
cmdline.argv[10] : kms_
cmdline.argv[11] : -x
cmdline.argv[12] : hang|suspend|hibernate|kms_pm_backlight|kms_frontbuffer_tracking@(?!basic$)
cmdline.argv[13] : tests
cmdline.argv[14] : /srv/run2/step9/logs/igt/results
