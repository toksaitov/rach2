{
  "schema_version": 1,
  "proof": "dryrun",
  "summary": "dryrun_test.sh against a private copy of mk/dryrun.mk with the first-word test put back",
  "tree": "private",
  "sources": [
    "mk/dryrun.mk"
  ],
  "artifacts": [
    "${WORK}/dryrun.mk"
  ],
  "build": {
    "argv": [
      "/bin/cp",
      "${SRC}/mk/dryrun.mk",
      "${WORK}/dryrun.mk"
    ],
    "bound_s": 10
  },
  "test": {
    "argv": [
      "/usr/bin/env",
      "DRYRUN_MK=${WORK}/dryrun.mk",
      "sh",
      "tests/system/dryrun_test.sh"
    ],
    "bound_s": 60,
    "fail_prefix": "dryrun-test: FAIL: "
  },
  "faults": [
    {
      "name": "first-word",
      "summary": "a rule that looks for the letter n in the first word of MAKEFLAGS, which reads --no-print-directory as -n",
      "edits": [
        {
          "file": "mk/dryrun.mk",
          "find": "MAKE_SHORT_FLAGS := $(filter-out -%,$(firstword $(MAKEFLAGS)))\nDRY_RUN := $(strip $(findstring n,$(MAKE_SHORT_FLAGS)) \\\n                   $(filter -n --dry-run --just-print --recon,$(MAKEFLAGS)))\n",
          "replace": "DRY_RUN := $(findstring n,$(firstword $(MAKEFLAGS)))\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "dryrun-test: FAIL: --no-print-directory: the build did not run"
        ]
      }
    }
  ]
}
