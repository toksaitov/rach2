{
  "schema_version": 1,
  "proof": "kstd",
  "summary": "kstd_hosttest.c's rows on k_itoa with one fault in a private copy of rach2/sys/lib/kstd.c; the test prints nothing and exits with its count of failed checks, which the test command prints",
  "tree": "private",
  "sources": [
    "rach2/sys/lib/kstd.c"
  ],
  "artifacts": [
    "${WORK}/kstd_hosttest"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec ${CC:-cc} -std=c99 -D_DEFAULT_SOURCE -D_FORTIFY_SOURCE=0 -DRACH2_HOSTTEST -g -O1 -Wno-empty-body -ffreestanding -fsanitize=address,undefined -fno-sanitize-recover=all -I rach2/sys/lib tests/host/kstd_hosttest.c ${SRC}/rach2/sys/lib/kstd.c rach2/sys/lib/kstring.c rach2/sys/lib/kctypes.c -o ${WORK}/kstd_hosttest"
    ],
    "bound_s": 120
  },
  "test": {
    "argv": [
      "/bin/sh",
      "-c",
      "st=0; ${WORK}/kstd_hosttest || st=$?; echo \"kstd-hosttest: status $st\"; exit $st"
    ],
    "bound_s": 15
  },
  "faults": [
    {
      "name": "plus",
      "summary": "a plus sign force_sign counts and does not write",
      "edits": [
        {
          "file": "rach2/sys/lib/kstd.c",
          "find": "        } else if (is_signed && initial_input > 0 && force_sign) {\n            *tmp_str++ = '+';\n        }\n",
          "replace": "        }\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "kstd-hosttest: status 1"
        ]
      }
    }
  ]
}
