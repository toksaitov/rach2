{
  "schema_version": 1,
  "proof": "etude-qemu-disks",
  "summary": "the launcher's command lines of disks on IDE and NVMe, of a CD and of the firmware's flash, and the disks it refuses, each fault in a private copy of qemu_profile.c found by its own row",
  "tree": "private",
  "sources": [
    "tools/etude/qemu_profile.c"
  ],
  "artifacts": [
    "${WORK}/etude_qemu_hosttest"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec ${CC:-cc} -std=c99 -D_DEFAULT_SOURCE -D_FORTIFY_SOURCE=0 -O1 -fsanitize=address,undefined -fno-sanitize-recover=all -I tests/host -I tools/etude/include -I tools/etude/posix tests/host/etude_qemu_hosttest.c tools/etude/posix/qemu.c tools/etude/capture.c tools/etude/history_json.c ${SRC}/tools/etude/qemu_profile.c tools/etude/processor.c tools/etude/posix/exec.c tools/etude/posix/keeper.c tools/etude/posix/process.c -o ${WORK}/etude_qemu_hosttest"
    ],
    "bound_s": 120
  },
  "test": {
    "argv": [
      "${WORK}/etude_qemu_hosttest",
      "--argv"
    ],
    "bound_s": 30,
    "fail_prefix": "etude-qemu-test: fail: "
  },
  "faults": [
    {
      "name": "count",
      "summary": "a profile of nine disks is taken",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "    if (disk_count(disks) > ETUDE_QEMU_DISKS)\n",
          "replace": "    if (disk_count(disks) > ETUDE_QEMU_DISKS + 1)\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": nine disks: "
        ],
        "only": true
      }
    },
    {
      "name": "ide-places",
      "summary": "five disks are given places on IDE, which has four",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "if (++*ide > IDE_PLACES ||",
          "replace": "if (++*ide > IDE_PLACES + 1 ||"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": five disks on IDE: "
        ],
        "only": true
      }
    },
    {
      "name": "no-path",
      "summary": "a disk of an empty path is taken",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "if (*d->path == '\\0' || (d->id != NULL) != (d->bus == ETUDE_BUS_DEVICE))",
          "replace": "if ((d->id != NULL) != (d->bus == ETUDE_BUS_DEVICE))"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a disk of no file: "
        ],
        "only": true
      }
    },
    {
      "name": "cd-serial",
      "summary": "a CD on IDE is taken with a serial",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "(d->cdrom && (d->serial != NULL || d->qcow2))",
          "replace": "(d->cdrom && d->qcow2)"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a serial on a CD: "
        ],
        "only": true
      }
    },
    {
      "name": "cd-discard",
      "summary": "a CD is taken with discard",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": " ||\n            (d->cdrom && d->discard))",
          "replace": ")"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a CD with discard: "
        ],
        "only": true
      }
    },
    {
      "name": "unknown-bus",
      "summary": "a disk of an unknown bus is taken, and attached to IDE",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "} else if (d->bus != ETUDE_BUS_NVME || d->cdrom",
          "replace": "} else if (d->cdrom"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": an unknown bus: "
        ],
        "only": true
      }
    },
    {
      "name": "cd-nvme",
      "summary": "a CD is taken on NVMe",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "d->bus != ETUDE_BUS_NVME || d->cdrom ||",
          "replace": "d->bus != ETUDE_BUS_NVME ||"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a CD on NVMe: "
        ],
        "only": true
      }
    },
    {
      "name": "serial-word",
      "summary": "a serial with a space is taken",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "    return word(s) && strlen(s)",
          "replace": "    return s != NULL && strlen(s)"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a serial with a space: "
        ],
        "only": true
      }
    },
    {
      "name": "serial-length",
      "summary": "a serial of 21 characters is taken",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "strlen(s) <= ETUDE_QEMU_SERIAL_MAX &&",
          "replace": "strlen(s) <= ETUDE_QEMU_SERIAL_MAX + 1 &&"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a serial of 21 characters: "
        ],
        "only": true
      }
    },
    {
      "name": "serial-comma",
      "summary": "a serial with a comma is taken",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": " && strchr(s, ',') == NULL;",
          "replace": ";"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a serial with a comma: ",
          ": a serial with a comma on IDE: "
        ],
        "only": true
      }
    },
    {
      "name": "nvme-serial",
      "summary": "an NVMe disk is attached without its serial",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "        add(l, 0, \"nvme,drive=%s,serial=%s%s\", id, d->serial, boot);\n",
          "replace": "        add(l, 0, \"nvme,drive=%s%s\", id, boot);\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the command line is"
        ],
        "only": true
      }
    },
    {
      "name": "nvme-quote",
      "summary": "the commas of an NVMe disk's path are not doubled",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "    add(l, 1, format, d->path);\n    add(l, 0, \"-device\");\n",
          "replace": "    add(l, 0, format, d->path);\n    add(l, 0, \"-device\");\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the command line is"
        ],
        "only": true
      }
    },
    {
      "name": "discard",
      "summary": "a disk of discard is attached without it",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "    const char *discard = d->discard ? \",discard=unmap,detect-zeroes=unmap\" : \"\";\n",
          "replace": "    const char *discard = \"\";\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the command line is"
        ],
        "only": true
      }
    },
    {
      "name": "ide-index",
      "summary": "a disk on IDE takes the place of its position in the profile, counting the NVMe disks before it",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "media=%s%s\", type,\n                 (*ide)++,",
          "replace": "media=%s%s\", type,\n                 (unsigned)n,"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the command line is"
        ],
        "only": true
      }
    },
    {
      "name": "cd-writable",
      "summary": "a CD is attached without readonly",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "d->cdrom ? \"cdrom,readonly=on\" : \"disk\"",
          "replace": "d->cdrom ? \"cdrom\" : \"disk\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the command line is"
        ],
        "only": true
      }
    },
    {
      "name": "bios",
      "summary": "OVMF's code image is given with -bios",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "        add(&l, 0, \"-drive\");\n        add(&l, 1, \"if=pflash,format=raw,readonly=on,file=%s\", ovmf);\n",
          "replace": "        add(&l, 0, \"-bios\");\n        add(&l, 0, \"%s\", ovmf);\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": ovmf: ",
          ": i686 on x86-64 ovmf: "
        ],
        "only": true
      }
    },
    {
      "name": "flash-writable",
      "summary": "OVMF's flash is attached without readonly",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "\"if=pflash,format=raw,readonly=on,file=%s\"",
          "replace": "\"if=pflash,format=raw,file=%s\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": ovmf: ",
          ": i686 on x86-64 ovmf: "
        ],
        "only": true
      }
    },
    {
      "name": "kernel-architecture-ovmf",
      "summary": "OVMF uses the machine of the kernel architecture for an i686 kernel",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "    return p->firmware == ETUDE_FIRMWARE_OVMF ||\n           (p->architecture != NULL && strcmp(p->architecture, \"x86_64\") == 0);",
          "replace": "    return p->architecture != NULL && strcmp(p->architecture, \"x86_64\") == 0;"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": i686 on x86-64 ovmf: ",
          ": no x86-64 ovmf for i686: "
        ],
        "only": true
      }
    },
    {
      "name": "i686-firmware-fallback",
      "summary": "a site without x86-64 OVMF falls back to i686 firmware",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "const char *ovmf = x86_64 ? s->ovmf_x86_64 : s->ovmf_i686;",
          "replace": "const char *ovmf = s->ovmf_x86_64 != NULL ? s->ovmf_x86_64 : s->ovmf_i686;"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": no x86-64 ovmf for i686: "
        ],
        "only": true
      }
    },
    {
      "name": "ahci-port",
      "summary": "every disk on AHCI is attached at its first port",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "\"ide-hd,drive=%s,bus=etude-ahci.%u\", id, (*ahci)++",
          "replace": "\"ide-hd,drive=%s,bus=etude-ahci.%u\", id, *ahci"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the command line is"
        ],
        "only": true
      }
    },
    {
      "name": "ahci-controller",
      "summary": "the disks on AHCI are attached with no ich9-ahci of the name their ports have",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "add(l, 0, \"ich9-ahci,id=etude-ahci\");",
          "replace": "add(l, 0, \"ich9-ahci\");"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the command line is"
        ],
        "only": true
      }
    },
    {
      "name": "bootindex",
      "summary": "a disk that boots first is attached without its boot index",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "const char *boot = d->boot ? \",bootindex=0\" : \"\";",
          "replace": "const char *boot = \"\";"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the command line is"
        ],
        "only": true
      }
    },
    {
      "name": "ide-boot-place",
      "summary": "a disk on IDE that boots first is attached at another place than its position gives",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "*ide / 2, *ide % 2",
          "replace": "*ide % 2, *ide / 2"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the command line is"
        ],
        "only": true
      }
    },
    {
      "name": "ahci-ports",
      "summary": "a profile of seven disks on AHCI is taken",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "if (++*ahci > AHCI_PORTS || ",
          "replace": "if ("
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": seven disks on AHCI: "
        ],
        "only": true
      }
    },
    {
      "name": "ahci-cd",
      "summary": "a CD on AHCI is taken",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "AHCI_PORTS || d->serial != NULL || d->cdrom)",
          "replace": "AHCI_PORTS || d->serial != NULL)"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a CD on AHCI: "
        ],
        "only": true
      }
    },
    {
      "name": "ahci-serial",
      "summary": "a serial on AHCI is taken",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "AHCI_PORTS || d->serial != NULL ||",
          "replace": "AHCI_PORTS ||"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a serial on AHCI: "
        ],
        "only": true
      }
    },
    {
      "name": "boot-count",
      "summary": "two disks that boot first are taken",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "if (d->boot && ++boot > 1)",
          "replace": "if (d->boot && ++boot > 2)"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": two disks that boot first: "
        ],
        "only": true
      }
    },
    {
      "name": "boot-kernel",
      "summary": "a disk that boots first is taken beside -kernel",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": " && !boot_disk(p->disks) ? 0 : EINVAL",
          "replace": " ? 0 : EINVAL"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a disk that boots first beside -kernel: "
        ],
        "only": true
      }
    }
  ]
}
