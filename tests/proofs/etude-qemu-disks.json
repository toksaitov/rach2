{
  "schema_version": 1,
  "proof": "etude-qemu-disks",
  "summary": "the launcher's command lines of disks on IDE and NVMe, of a CD and of the firmware's flash, and the disks it refuses, each fault in a private copy of qemu_profile.c found by its own row",
  "tree": "private",
  "sources": [
    "tools/etude/qemu_profile.c"
  ],
  "artifacts": [
    "${WORK}/etude_qemu_hosttest"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec ${CC:-cc} -std=c99 -D_DEFAULT_SOURCE -D_FORTIFY_SOURCE=0 -O1 -fsanitize=address,undefined -fno-sanitize-recover=all -I tests/host -I tools/etude/include -I tools/etude/posix tests/host/etude_qemu_hosttest.c tools/etude/posix/qemu.c tools/etude/capture.c tools/etude/history_json.c ${SRC}/tools/etude/qemu_profile.c tools/etude/processor.c tools/etude/posix/exec.c tools/etude/posix/keeper.c tools/etude/posix/process.c -o ${WORK}/etude_qemu_hosttest"
    ],
    "bound_s": 120
  },
  "test": {
    "argv": [
      "${WORK}/etude_qemu_hosttest",
      "--argv"
    ],
    "bound_s": 30,
    "fail_prefix": "etude-qemu-test: fail: "
  },
  "faults": [
    {
      "name": "count",
      "summary": "a profile of nine disks is taken",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "    if (disk_count(disks) > ETUDE_QEMU_DISKS)\n",
          "replace": "    if (disk_count(disks) > ETUDE_QEMU_DISKS + 1)\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": nine disks: "
        ],
        "only": true
      }
    },
    {
      "name": "ide-places",
      "summary": "five disks are given places on IDE, which has four",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "if (++ide > IDE_PLACES ||",
          "replace": "if (++ide > IDE_PLACES + 1 ||"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": five disks on IDE: "
        ],
        "only": true
      }
    },
    {
      "name": "no-path",
      "summary": "a disk of an empty path is taken",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "        if (*d->path == '\\0')\n            return EINVAL;\n",
          "replace": ""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a disk of no file: "
        ],
        "only": true
      }
    },
    {
      "name": "ide-serial",
      "summary": "a disk on IDE is taken with a serial, which the launcher does not give it",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "IDE_PLACES || d->serial != NULL ||",
          "replace": "IDE_PLACES ||"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a serial on IDE: "
        ],
        "only": true
      }
    },
    {
      "name": "cd-discard",
      "summary": "a CD is taken with discard",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": " || (d->cdrom && d->discard))",
          "replace": ")"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a CD with discard: "
        ],
        "only": true
      }
    },
    {
      "name": "unknown-bus",
      "summary": "a disk of an unknown bus is taken, and attached to IDE",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "} else if (d->bus != ETUDE_BUS_NVME || d->cdrom",
          "replace": "} else if (d->cdrom"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": an unknown bus: "
        ],
        "only": true
      }
    },
    {
      "name": "cd-nvme",
      "summary": "a CD is taken on NVMe",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "d->bus != ETUDE_BUS_NVME || d->cdrom ||",
          "replace": "d->bus != ETUDE_BUS_NVME ||"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a CD on NVMe: "
        ],
        "only": true
      }
    },
    {
      "name": "serial-word",
      "summary": "a serial with a space is taken",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "    return word(s) && strlen(s)",
          "replace": "    return s != NULL && strlen(s)"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a serial with a space: "
        ],
        "only": true
      }
    },
    {
      "name": "serial-length",
      "summary": "a serial of 21 characters is taken",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "strlen(s) <= ETUDE_QEMU_SERIAL_MAX &&",
          "replace": "strlen(s) <= ETUDE_QEMU_SERIAL_MAX + 1 &&"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a serial of 21 characters: "
        ],
        "only": true
      }
    },
    {
      "name": "serial-comma",
      "summary": "a serial with a comma is taken",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": " && strchr(s, ',') == NULL;",
          "replace": ";"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": a serial with a comma: "
        ],
        "only": true
      }
    },
    {
      "name": "nvme-serial",
      "summary": "an NVMe disk is attached without its serial",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "        add(l, 0, \"nvme,drive=%s,serial=%s\", id, d->serial);\n",
          "replace": "        add(l, 0, \"nvme,drive=%s\", id);\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the command line is"
        ],
        "only": true
      }
    },
    {
      "name": "nvme-quote",
      "summary": "the commas of an NVMe disk's path are not doubled",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "        add(l, 1, format, d->path);\n        add(l, 0, \"-device\");\n",
          "replace": "        add(l, 0, format, d->path);\n        add(l, 0, \"-device\");\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the command line is"
        ],
        "only": true
      }
    },
    {
      "name": "discard",
      "summary": "a disk of discard is attached without it",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "    const char *discard = d->discard ? \",discard=unmap,detect-zeroes=unmap\" : \"\";\n",
          "replace": "    const char *discard = \"\";\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the command line is"
        ],
        "only": true
      }
    },
    {
      "name": "ide-index",
      "summary": "a disk on IDE takes the place of its position in the profile, counting the NVMe disks before it",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "media=%s%s\", (*ide)++,",
          "replace": "media=%s%s\", (unsigned)n,"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the command line is"
        ],
        "only": true
      }
    },
    {
      "name": "cd-writable",
      "summary": "a CD is attached without readonly",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "d->cdrom ? \"cdrom,readonly=on\" : \"disk\"",
          "replace": "d->cdrom ? \"cdrom\" : \"disk\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the command line is"
        ],
        "only": true
      }
    },
    {
      "name": "bios",
      "summary": "OVMF's code image is given with -bios",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "        add(&l, 0, \"-drive\");\n        add(&l, 1, \"if=pflash,format=raw,readonly=on,file=%s\", ovmf);\n",
          "replace": "        add(&l, 0, \"-bios\");\n        add(&l, 0, \"%s\", ovmf);\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": ovmf: "
        ],
        "only": true
      }
    },
    {
      "name": "flash-writable",
      "summary": "OVMF's flash is attached without readonly",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "\"if=pflash,format=raw,readonly=on,file=%s\"",
          "replace": "\"if=pflash,format=raw,file=%s\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          ": ovmf: "
        ],
        "only": true
      }
    }
  ]
}
