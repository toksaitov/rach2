{
  "schema_version": 1,
  "proof": "procfiles",
  "summary": "All three root mount cases detect a wrong mount source, and the applet case detects an incorrect file system size",
  "tree": "shared",
  "sources": [
    "rach2/sys/fs/krffs.c",
    "rach2/sys/syscall_fs.c"
  ],
  "artifacts": [
    "${WORK}/kernel"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "sh tests/proofs/guest.sh make rach2 && sh tests/proofs/guest.sh copy ${WORK} rach2/kernel"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec sh tests/proofs/guest.sh run procfiles \"run: procfiles: PASS\""
    ],
    "bound_s": 1800
  },
  "faults": [
    {
      "name": "mount-source",
      "summary": "every root is reported with an incorrect source",
      "edits": [
        {
          "file": "rach2/sys/fs/krffs.c",
          "find": "    return krffs_mount_src;",
          "replace": "    return \"incorrect\";"
        }
      ],
      "fails": {
        "lines": [
          "machine.procfiles.ram on",
          "machine.procfiles.window on",
          "machine.procfiles.disk on",
          "failure: mount failed:"
        ],
        "status": 1
      }
    },
    {
      "name": "root-size",
      "summary": "statfs reports half the root size",
      "edits": [
        {
          "file": "rach2/sys/syscall_fs.c",
          "find": "        st.f_blocks = total / STATFS_BSIZE;",
          "replace": "        st.f_blocks = total / STATFS_BSIZE / 2;"
        }
      ],
      "fails": {
        "lines": [
          "failure: df-size failed:"
        ],
        "status": 1
      }
    }
  ]
}
