{
  "schema_version": 1,
  "proof": "probe-opathmusl",
  "summary": "the row of opathmusl in the default suite, with faults in the kernel",
  "tree": "shared",
  "sources": [
    "rach2/sys/syscall_fs.c"
  ],
  "artifacts": [
    "${WORK}/kernel"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "tests/system/default_probe.sh",
      "--build",
      "${WORK}"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "tests/system/default_probe.sh",
      "musl/opathmusl"
    ],
    "bound_s": 900,
    "fail_prefix": "default-probe: fail: "
  },
  "faults": [
    {
      "name": "fdupfd-drops-path",
      "summary": "the row that fails with: F_DUPFD keeps O_PATH",
      "edits": [
        {
          "file": "rach2/sys/syscall_fs.c",
          "find": "        dst->flags = entry->flags;\n",
          "replace": "        dst->flags = entry->flags & ~(uint32_t)FD_FLAG_PATH;\n"
        }
      ],
      "fails": {
        "lines": [
          "OPATHMUSL FAIL (F_DUPFD keeps O_PATH)",
          "default-probe: fail: musl/opathmusl did not pass"
        ]
      }
    },
    {
      "name": "dup-drops-path",
      "summary": "the row that fails with: dup keeps O_PATH",
      "edits": [
        {
          "file": "rach2/sys/syscall_fs.c",
          "find": "    dst->flags = entry->flags & ~(uint32_t)FD_FLAG_CLOEXEC;\n",
          "replace": "    dst->flags = entry->flags & ~(uint32_t)(FD_FLAG_CLOEXEC | FD_FLAG_PATH);\n"
        }
      ],
      "fails": {
        "lines": [
          "OPATHMUSL FAIL (dup keeps O_PATH)",
          "default-probe: fail: musl/opathmusl did not pass"
        ]
      }
    }
  ]
}
