{
  "schema_version": 1,
  "proof": "itimer",
  "summary": "sigprobe's rows of setitimer(2), booted alone, with four faults in the kernel's real-time timer",
  "tree": "shared",
  "sources": [
    "rach2/sys/proc/process.c",
    "rach2/sys/syscall.c",
    "rach2/sys/syscall_proc.c"
  ],
  "artifacts": [
    "${WORK}/kernel",
    "${WORK}/sigprobe"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "sh tests/proofs/guest.sh make rach2 test-image build/tests/system/harness && sh tests/proofs/guest.sh copy ${WORK} rach2/kernel tests/sigprobe && sh tests/proofs/guest.sh image ${WORK} 2 tests/sigprobe"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "tests/proofs/guest.sh",
      "boot",
      "${WORK}",
      "--net",
      "hubport,id=net0,hubid=0",
      "--qemu-arg=-cpu",
      "--qemu-arg=max",
      "--append",
      "rach2.rescue",
      "--timeout",
      "120",
      "--steptmo",
      "90",
      "--ok",
      "SIGPROBE OK",
      "--never",
      "SIGPROBE FAIL",
      "expect=Type 'help'",
      "send=exec /sigprobe",
      "expect=SIGPROBE",
      "expect=returning to kernel shell"
    ],
    "bound_s": 300
  },
  "faults": [
    {
      "name": "unposted",
      "summary": "the tick's SIGALRM taken out of proc_wake_sleepers",
      "edits": [
        {
          "file": "rach2/sys/proc/process.c",
          "find": "            signal_post(p, SIGALRM);\n",
          "replace": "            (void)0;\n"
        }
      ],
      "fails": {
        "lines": [
          "FAIL: and its handler runs once SIGALRM is unblocked"
        ]
      }
    },
    {
      "name": "unrearmed",
      "summary": "the timer left disarmed after it fires",
      "edits": [
        {
          "file": "rach2/sys/proc/process.c",
          "find": "            p->alarm_tick = p->alarm_interval != 0 ? proc_alarm_at(now, p->alarm_interval) : 0;\n",
          "replace": "            p->alarm_tick = 0;\n"
        }
      ],
      "fails": {
        "lines": [
          "FAIL: the interval timer ends three sleeps in turn"
        ]
      }
    },
    {
      "name": "unchecked",
      "summary": "setitimer's check of which removed",
      "edits": [
        {
          "file": "rach2/sys/syscall.c",
          "find": "    if (which < ITIMER_REAL || which > ITIMER_PROF) {\n        return -EINVAL;\n    }\n    if (!unew || copy_from_user(&set, unew, sizeof(set)) != 0) {\n",
          "replace": "    if (!unew || copy_from_user(&set, unew, sizeof(set)) != 0) {\n"
        }
      ],
      "fails": {
        "lines": [
          "FAIL: a timer other than the three is refused and arms nothing"
        ]
      }
    },
    {
      "name": "unmasked",
      "summary": "the blocked mask taken out of signal_pending",
      "edits": [
        {
          "file": "rach2/sys/syscall_proc.c",
          "find": "    deliverable = sig_pending_now() & ~current_proc->sig_blocked;\n    debug_pending = arch_debug_pending();\n",
          "replace": "    deliverable = sig_pending_now();\n    debug_pending = arch_debug_pending();\n"
        }
      ],
      "fails": {
        "lines": [
          "FAIL: a blocked alarm does not end a sleep and leaves the timer disarmed"
        ]
      }
    }
  ]
}
