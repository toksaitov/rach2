{
  "schema_version": 1,
  "proof": "doom-libc",
  "summary": "Doom's C library, compiled by tests/host/doom_libc_check.sh with the freestanding fixture tests/host/fixtures/doom_libc.c for the i686 and x86-64 ABIs, with eight faults in private copies of ports/doom/crt0.c and its headers; a fault must fail at least one ABI, with a program status no higher than 1",
  "tree": "private",
  "sources": [
    "ports/doom/crt0.c",
    "ports/doom/include/limits.h",
    "ports/doom/include/stdlib.h",
    "ports/doom/include/sys/types.h",
    "ports/doom/include/unistd.h"
  ],
  "artifacts": [
    "${WORK}/doom_libc-i686",
    "${WORK}/doom_libc-x86_64"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "tests/host/doom_libc_check.sh",
      "build",
      "${SRC}",
      "${WORK}"
    ],
    "bound_s": 120
  },
  "test": {
    "argv": [
      "/bin/sh",
      "tests/host/doom_libc_check.sh",
      "run",
      "${WORK}"
    ],
    "bound_s": 30,
    "fail_prefix": "doom-libc-check: result: fail"
  },
  "faults": [
    {
      "name": "limits",
      "summary": "LONG_MAX as the 32-bit maximum",
      "edits": [
        {
          "file": "ports/doom/include/limits.h",
          "find": "#define LONG_MAX    __LONG_MAX__",
          "replace": "#define LONG_MAX    2147483647L"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "doom-libc-test: fail: long maximum",
          "doom-libc-check: result: fail"
        ]
      }
    },
    {
      "name": "types",
      "summary": "off_t as a 32-bit type",
      "edits": [
        {
          "file": "ports/doom/include/sys/types.h",
          "find": "typedef long off_t;",
          "replace": "typedef int32_t off_t;"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "doom-libc-test: fail: off_t width",
          "doom-libc-check: result: fail"
        ]
      }
    },
    {
      "name": "buffer-format",
      "summary": "vsnprintf reading ll as l",
      "edits": [
        {
          "file": "ports/doom/crt0.c",
          "find": "                precision = precision * 10 + (*p - '0');\n                p++;\n            }\n        }\n\n        if (*p == 'l') {\n            is_long = 1;\n            p++;\n            if (*p == 'l') { is_long = 2; p++; }",
          "replace": "                precision = precision * 10 + (*p - '0');\n                p++;\n            }\n        }\n\n        if (*p == 'l') {\n            is_long = 1;\n            p++;\n            if (*p == 'l') p++;"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "doom-libc-test: fail: 64-bit macros",
          "doom-libc-check: result: fail"
        ]
      }
    },
    {
      "name": "print-format",
      "summary": "vprintf reading ll as l",
      "edits": [
        {
          "file": "ports/doom/crt0.c",
          "find": "            while (*p >= '0' && *p <= '9') {\n                p++;\n            }\n        }\n\n        if (*p == 'l') {\n            is_long = 1;\n            p++;\n            if (*p == 'l') { is_long = 2; p++; }",
          "replace": "            while (*p >= '0' && *p <= '9') {\n                p++;\n            }\n        }\n\n        if (*p == 'l') {\n            is_long = 1;\n            p++;\n            if (*p == 'l') p++;"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "doom-libc-check: result: fail"
        ]
      }
    },
    {
      "name": "scan",
      "summary": "a 0x prefix scanned in base 10",
      "edits": [
        {
          "file": "ports/doom/crt0.c",
          "find": "base = 16;\n            str += 2;",
          "replace": "base = 10;\n            str += 2;"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "doom-libc-test: fail: automatic hex base",
          "doom-libc-check: result: fail"
        ]
      }
    },
    {
      "name": "sort",
      "summary": "a sort of one element that calls the comparator",
      "edits": [
        {
          "file": "ports/doom/include/stdlib.h",
          "find": "if (nmemb < 2 || size == 0) return;",
          "replace": "if (size == 0) return;"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "doom-libc-test: fail: empty sort calls comparator",
          "doom-libc-check: result: fail"
        ]
      }
    },
    {
      "name": "cwd",
      "summary": "getcwd taking a buffer of one byte",
      "edits": [
        {
          "file": "ports/doom/include/unistd.h",
          "find": "if (!buf || size < 2) return NULL;",
          "replace": "if (!buf || size < 1) return NULL;"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "doom-libc-test: fail: cwd size one",
          "doom-libc-check: result: fail"
        ]
      }
    },
    {
      "name": "update",
      "summary": "a + in fopen's mode not opening for reading and writing",
      "edits": [
        {
          "file": "ports/doom/crt0.c",
          "find": "if (strchr(mode, '+')) flags = (flags & ~3) | O_RDWR;",
          "replace": ""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "doom-libc-test: fail: read w+",
          "doom-libc-check: result: fail"
        ]
      }
    }
  ]
}
