{
  "schema_version": 1,
  "proof": "machine-grow-space-test",
  "summary": "the work directory, the log writes and the plan check of tools/dev/machine_grow.sh, through the case machine.grow.space of tests/cases/host/grow.sh on the script's own functions, with faults in a private copy of the script",
  "tree": "private",
  "sources": [
    "tools/dev/machine_grow.sh"
  ],
  "artifacts": [
    "${WORK}/machine_grow.sh"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec cp ${SRC}/tools/dev/machine_grow.sh ${WORK}/machine_grow.sh"
    ],
    "bound_s": 60
  },
  "test": {
    "argv": [
      "/usr/bin/env",
      "TMPDIR=${WORK}",
      "/bin/sh",
      "tests/cases/host/grow.sh",
      "space",
      "${WORK}/machine_grow.sh"
    ],
    "bound_s": 1800,
    "fail_prefix": "grow: result: failed: "
  },
  "faults": [
    {
      "name": "work",
      "summary": "a work directory in /tmp, not on the store",
      "edits": [
        {
          "file": "tools/dev/machine_grow.sh",
          "find": "mktemp -d \"$store/machine-grow.XXXXXX\"",
          "replace": "mktemp -d /tmp/machine-grow.XXXXXX"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "grow: result: failed: machine.grow.space: work"
        ]
      }
    },
    {
      "name": "log",
      "summary": "a failed log write ignored",
      "edits": [
        {
          "file": "tools/dev/machine_grow.sh",
          "find": "fail \"writing $work/$log_name\"",
          "replace": ": \"writing $work/$log_name\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "grow: result: failed: machine.grow.space: log"
        ]
      }
    },
    {
      "name": "diagnostic",
      "summary": "a failed growset called an unsupported geometry",
      "edits": [
        {
          "file": "tools/dev/machine_grow.sh",
          "find": "fail \"creating $work/expected-ranges.txt; growset failed (see $work/growset.log)\"",
          "replace": "fail \"the seed geometry is not supported\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "grow: result: failed: machine.grow.space: output"
        ]
      }
    }
  ]
}
