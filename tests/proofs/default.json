{
  "schema_version": 1,
  "proof": "default",
  "summary": "the default suite's cases on i686, against a close that never answers EBADF, which a guest case reports by its assertion, an exit record of the designated init that gives a status of 1, which fails each machine case of a probe, and a timing record at level 3",
  "tree": "shared",
  "sources": [
    "rach2/sys/syscall_fs.c",
    "rach2/sys/syscall_proc.c",
    "rach2/kernel.c"
  ],
  "artifacts": [
    "${WORK}/kernel"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "ARCH=i686 sh tests/proofs/guest.sh make rach2 && ARCH=i686 sh tests/proofs/guest.sh copy ${WORK} rach2/kernel"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "-c",
      "ARCH=i686 RACH2_WORKERS=4 exec tests/run default"
    ],
    "bound_s": 7200
  },
  "faults": [
    {
      "name": "close-ebadf",
      "summary": "close succeeding for a descriptor that is not open, which errnoprobe's guest case reports as its assertion ebadf-close",
      "edits": [
        {
          "file": "rach2/sys/syscall_fs.c",
          "find": "    return close_fd((int)SC_ARG(params, 0));\n}\n",
          "replace": "    close_fd((int)SC_ARG(params, 0));\n    return 0;\n}\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "@etude 1 assert ebadf-close fail close(999)",
          "run: default: guest.default.errnoprobe: evidence: "
        ]
      }
    },
    {
      "name": "init-status",
      "summary": "the kernel's record of the designated init's exit giving a status of 1 for every exit, which the scenario's assertion exit finds in each machine case of a probe",
      "edits": [
        {
          "file": "rach2/sys/syscall_proc.c",
          "find": "         exiting_pid, status);\n",
          "replace": "         exiting_pid, status | 1);\n"
        },
        {
          "file": "rach2/kernel.c",
          "find": "             (status >> 8) & 0xFF);\n",
          "replace": "             ((status >> 8) & 0xFF) | 1);\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "run: default: guest.default.survivorprobe: evidence: ",
          "run: default: guest.default.orphanprobe: evidence: ",
          "run: default: guest.default.jobprobe: evidence: ",
          "run: default: guest.default.pollprobe: evidence: ",
          "run: default: guest.default.devprobe: evidence: ",
          "run: default: guest.default.fdcallmusl: evidence: ",
          "run: default: guest.default.ishmusl: evidence: ",
          "run: default: guest.default.clockmusl: evidence: ",
          "run: default: guest.default.threadmusl: evidence: "
        ]
      }
    },
    {
      "name": "timing-level",
      "summary": "the kernel's timing record printed at level 3 whatever its check found, which the case timing finds",
      "edits": [
        {
          "file": "rach2/kernel.c",
          "find": "    klog(clock_ok ? KLOG_INFO : KLOG_ERR, \"timing\",\n",
          "replace": "    klog(KLOG_ERR, \"timing\",\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "run: default: guest.default.timing: evidence: "
        ]
      }
    }
  ]
}
