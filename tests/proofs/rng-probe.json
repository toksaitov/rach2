{
  "schema_version": 1,
  "proof": "rng-probe",
  "summary": "rngprobe's report under etude's processor profile max, judged by casecheck, with the probe built from a private copy of kcpu_id whose CPUID subleaf operand is made an output",
  "tree": "private",
  "sources": [
    "rach2/sys/arch/x86/kcpu.c"
  ],
  "artifacts": [
    "${WORK}/kernel",
    "${WORK}/rngprobe"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "tests/proofs/rng.sh",
      "build",
      "${SRC}",
      "${WORK}"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "tests/proofs/rng.sh",
      "test",
      "${WORK}"
    ],
    "bound_s": 300
  },
  "faults": [
    {
      "name": "cpuid",
      "summary": "kcpu_id's CPUID subleaf operand made an output, so that the probe's leaf 7 is not subleaf 0",
      "edits": [
        {
          "file": "rach2/sys/arch/x86/kcpu.c",
          "find": "\"+c\"(rc)",
          "replace": "\"=c\"(rc)"
        }
      ],
      "fails": {
        "lines": [
          "assert cpuid-leaf7 fail"
        ],
        "status": 1
      }
    }
  ]
}
