{
  "schema_version": 1,
  "proof": "probe-vforkmusl",
  "summary": "the row of vforkmusl in the default suite, with faults in the kernel",
  "tree": "shared",
  "sources": [
    "rach2/sys/syscall_proc.c"
  ],
  "artifacts": [
    "${WORK}/kernel"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "tests/system/default_probe.sh",
      "--build",
      "${WORK}"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "tests/system/default_probe.sh",
      "musl/vforkmusl"
    ],
    "bound_s": 900,
    "fail_prefix": "default-probe: fail: "
  },
  "faults": [
    {
      "name": "exec-keeps-vfork-parent",
      "summary": "the row that fails with: the parent ran again at the child's exit, not its exec",
      "edits": [
        {
          "file": "rach2/sys/syscall_proc.c",
          "find": "    mm_put(old);\n    proc_vfork_release(current_proc);\n",
          "replace": "    mm_put(old);\n"
        }
      ],
      "fails": {
        "lines": [
          "VFORKMUSL FAIL (the parent ran again at the child's exit, not its exec",
          "default-probe: fail: musl/vforkmusl did not pass"
        ]
      }
    }
  ]
}
