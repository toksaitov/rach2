{
  "schema_version": 1,
  "proof": "probe-fifomusl",
  "summary": "the row of fifomusl in the default suite, with faults in the kernel",
  "tree": "shared",
  "sources": [
    "rach2/sys/syscall_fs.c",
    "rach2/sys/ipc/pipe.c"
  ],
  "artifacts": [
    "${WORK}/kernel"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "sh tests/proofs/guest.sh make rach2 test-image && sh tests/proofs/guest.sh copy ${WORK} rach2/kernel"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "tests/proofs/guest.sh",
      "default",
      "fifomusl"
    ],
    "bound_s": 900,
    "fail_prefix": "guest: fail: "
  },
  "faults": [
    {
      "name": "fifo-key-name-hash",
      "summary": "descriptors, open, mknod, FIFOs and /proc",
      "edits": [
        {
          "file": "rach2/sys/syscall_fs.c",
          "find": "        ino = (uint64_t)(uintptr_t)node;\n",
          "replace": "        ino = krffs_node_ino(node);\n"
        }
      ],
      "fails": {
        "lines": [
          "FIFOMUSL FAIL (the second found the first's reader",
          "guest: fail: fifomusl did not pass"
        ]
      }
    },
    {
      "name": "fifo-key-follows-name",
      "summary": "descriptors, open, mknod, FIFOs and /proc",
      "edits": [
        {
          "file": "rach2/sys/syscall_fs.c",
          "find": "        ino = (uint64_t)(uintptr_t)node;\n",
          "replace": "        ino = (uint64_t)(uintptr_t)node ^ krffs_node_ino(node);\n"
        }
      ],
      "fails": {
        "lines": [
          "FIFOMUSL FAIL (the renamed FIFO lost its reader",
          "guest: fail: fifomusl did not pass"
        ]
      }
    },
    {
      "name": "fifo-unlink-keeps-name",
      "summary": "descriptors, open, mknod, FIFOs and /proc",
      "edits": [
        {
          "file": "rach2/sys/syscall_fs.c",
          "find": "    if (fd_node_holders(node, NULL) > 0) {\n        krffs_unlink_held(node);\n",
          "replace": "    if (fd_node_holders(node, NULL) > 0) {\n        if (krffs_mode_type(node->mode) != KRFFS_S_IFIFO) {\n            krffs_unlink_held(node);\n        }\n"
        }
      ],
      "fails": {
        "lines": [
          "FIFOMUSL FAIL (a FIFO in an unlinked one's name",
          "guest: fail: fifomusl did not pass"
        ]
      }
    },
    {
      "name": "fifo-ends-not-holders",
      "summary": "descriptors, open, mknod, FIFOs and /proc",
      "edits": [
        {
          "file": "rach2/sys/syscall_fs.c",
          "find": "    if (krffs_mode_type(node->mode) == KRFFS_S_IFIFO) {\n        held += fd_ofd_holders(vfs_root_mount(), node, except ? except->ofd : NULL);\n    }\n    return held;\n",
          "replace": "    return held;\n"
        }
      ],
      "fails": {
        "lines": [
          "FIFOMUSL FAIL (a new FIFO found the unlinked one's reader",
          "guest: fail: fifomusl did not pass"
        ]
      }
    },
    {
      "name": "fifo-bind-key",
      "summary": "descriptors, open, mknod, FIFOs and /proc",
      "edits": [
        {
          "file": "rach2/sys/syscall_fs.c",
          "find": "    if (mnt_is_root(vfs_mount_base(mnt))) {\n",
          "replace": "    if (mnt_is_root(mnt)) {\n"
        }
      ],
      "fails": {
        "lines": [
          "FIFOMUSL FAIL (a writer through a bind did not join a reader through its source",
          "guest: fail: fifomusl did not pass"
        ]
      }
    },
    {
      "name": "fifo-bind-release-unlocked",
      "summary": "descriptors, open, mknod, FIFOs and /proc",
      "edits": [
        {
          "file": "rach2/sys/syscall_fs.c",
          "find": "                     e->ofd->vmnt && vfs_mount_base(e->ofd->vmnt) == root && mnt_is_root(root);\n",
          "replace": "                     e->ofd->vmnt == root && mnt_is_root(root);\n"
        }
      ],
      "fails": {
        "lines": [
          "FIFOMUSL FAIL (the last close through a bind did not free unlinked FIFOs",
          "guest: fail: fifomusl did not pass"
        ]
      }
    },
    {
      "name": "fifo-bind-orphan-kept",
      "summary": "descriptors, open, mknod, FIFOs and /proc",
      "edits": [
        {
          "file": "rach2/sys/syscall_fs.c",
          "find": "    if (!e->ofd || !e->ofd->vmnt || !krffs_fs || !mnt_is_root(vfs_mount_base(e->ofd->vmnt))) {\n",
          "replace": "    if (!e->ofd || !e->ofd->vmnt || !krffs_fs || !mnt_is_root(e->ofd->vmnt)) {\n"
        }
      ],
      "fails": {
        "lines": [
          "FIFOMUSL FAIL (the last close through a bind did not free unlinked FIFOs",
          "guest: fail: fifomusl did not pass"
        ]
      }
    },
    {
      "name": "fifo-rdwr-full-polls-writable",
      "summary": "AF_UNIX sockets, epoll, eventfd, timerfd and FIFOs",
      "edits": [
        {
          "file": "rach2/sys/ipc/pipe.c",
          "find": "        if (pipe_free_space(p) != 0 || !p->read_open) {\n",
          "replace": "        if (pipe_free_space(p) != 0 || !p->read_open || (e->flags & FD_FLAG_READ)) {\n"
        }
      ],
      "fails": {
        "lines": [
          "FIFOMUSL FAIL (a full FIFO polled writable: errno",
          "guest: fail: fifomusl did not pass"
        ]
      }
    },
    {
      "name": "fifo-rdwr-poll-read-queue",
      "summary": "AF_UNIX sockets, epoll, eventfd, timerfd and FIFOs",
      "edits": [
        {
          "file": "rach2/sys/ipc/pipe.c",
          "find": "        if ((e->flags & FD_FLAG_READ) && (e->flags & FD_FLAG_WRITE)) {\n            *wq = &p->rdwr_wq;\n        } else {\n            *wq = (e->flags & FD_FLAG_READ) ? &p->read_wq : &p->write_wq;\n        }\n",
          "replace": "        *wq = (e->flags & FD_FLAG_READ) ? &p->read_wq : &p->write_wq;\n"
        }
      ],
      "fails": {
        "lines": [
          "FIFOMUSL FAIL (a read by another open did not wake a poll for output: errno",
          "guest: fail: fifomusl did not pass"
        ]
      }
    },
    {
      "name": "fifo-reader-no-wait",
      "summary": "rows the close added or strengthened: probe rows the review found weak, the alternate stack, a tracer's view of an image an exec made not dumpable, the ptrace waits bounded for their proofs, and the faults the close's first boots found",
      "edits": [
        {
          "file": "rach2/sys/ipc/pipe.c",
          "find": "    if (!nonblock && acc != 2 && (acc == 0 ? !p->write_open : !p->read_open)) {\n",
          "replace": "    if (!nonblock && acc == 1 && !p->read_open) {\n"
        }
      ],
      "fails": {
        "lines": [
          "FIFOMUSL FAIL (a blocking open for reading returned before a writer opened",
          "guest: fail: fifomusl did not pass"
        ]
      }
    },
    {
      "name": "fifo-reader-hup-before-writer",
      "summary": "A pipe's poll after its writers have gone",
      "edits": [
        {
          "file": "rach2/sys/ipc/pipe.c",
          "find": "        if (!p->write_open && (!p->fifo || e->ofd->fifo_write_opens != p->write_opens)) {\n",
          "replace": "        if (!p->write_open) {\n"
        }
      ],
      "fails": {
        "lines": [
          "FIFOMUSL FAIL (a new FIFO reader reported hangup before a writer opened",
          "guest: fail: fifomusl did not pass"
        ]
      }
    },
    {
      "name": "fifo-reader-hup-never",
      "summary": "A pipe's poll after its writers have gone",
      "edits": [
        {
          "file": "rach2/sys/ipc/pipe.c",
          "find": "        if (!p->write_open && (!p->fifo || e->ofd->fifo_write_opens != p->write_opens)) {\n",
          "replace": "        if (!p->write_open && !p->fifo) {\n"
        }
      ],
      "fails": {
        "lines": [
          "FIFOMUSL FAIL (a FIFO reader missed hangup after a writer opened and closed",
          "guest: fail: fifomusl did not pass"
        ]
      }
    }
  ]
