{
  "schema_version": 1,
  "proof": "servicelog",
  "summary": "the case of tests/run servicelog under etude, on a root whose init-shell is built with each fault in init.c",
  "tree": "shared",
  "sources": [
    "utils/init.c"
  ],
  "artifacts": [
    "${WORK}/init-shell"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "sh tests/proofs/guest.sh make rach2 utils && sh tests/proofs/guest.sh copy ${WORK} utils/sbin/init-shell"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec tests/run servicelog </dev/null"
    ],
    "bound_s": 3600
  },
  "faults": [
    {
      "name": "bound-removed",
      "summary": "the emptying of the log within a boot taken out, so the first boot fails",
      "edits": [
        {
          "file": "utils/init.c",
          "find": "    if (st.st_size < SERVICE_LOG_CAP) {",
          "replace": "    if (st.st_size >= 0) {"
        }
      ],
      "fails": {
        "lines": [
          "run: servicelog: FAIL",
          "assert emptied fail"
        ],
        "status": 1
      }
    },
    {
      "name": "removal-removed",
      "summary": "the removal at boot of a log the boot before left full taken out, so the second boot fails",
      "edits": [
        {
          "file": "utils/init.c",
          "find": "    if (stat(SERVICE_LOG, &st) == 0 && st.st_size >= SERVICE_LOG_CAP) {",
          "replace": "    if (0 && stat(SERVICE_LOG, &st) == 0 && st.st_size >= SERVICE_LOG_CAP) {"
        }
      ],
      "fails": {
        "lines": [
          "run: servicelog: FAIL",
          "assert removed fail"
        ],
        "status": 1
      }
    }
  ]
}
