{
  "schema_version": 1,
  "proof": "etude-forward-casecheck",
  "summary": "casecheck refuses the forwards and guest forwards of a machine's cards that the QEMU launcher would refuse, and the forwards, guest forwards and restriction of a guest case's cards",
  "tree": "private",
  "sources": [
    "tools/etude/cases.c"
  ],
  "artifacts": [
    "${WORK}/casecheck"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec ${CC:-cc} -std=c99 -O1 -fsanitize=address,undefined -fno-sanitize-recover=all -I tools/etude -I tools/etude/include -I utils tools/etude/casecheck.c ${SRC}/tools/etude/cases.c tools/etude/digest.c tools/etude/judge.c tools/etude/json.c tools/etude/processor.c tools/etude/qemu_profile.c tools/etude/schema.c tools/etude/verdict.c tools/etude/history.c tools/etude/history_json.c utils/sha256.c -o ${WORK}/casecheck"
    ],
    "bound_s": 120
  },
  "test": {
    "argv": [
      "${WORK}/casecheck",
      "--selftest",
      "tools/etude/fixtures"
    ],
    "bound_s": 60
  },
  "faults": [
    {
      "name": "past-taken",
      "summary": "a forward of a port past those the case reserves is taken",
      "edits": [
        {
          "file": "tools/etude/cases.c",
          "find": "if (port >= ports) {",
          "replace": "if (0) {"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "with the text: fixture.networks.past:"
        ]
      }
    },
    {
      "name": "twice-taken",
      "summary": "a local port forwarded twice by one protocol is taken",
      "edits": [
        {
          "file": "tools/etude/cases.c",
          "find": "if (forwarded_before(devs, i, j, f)) {",
          "replace": "if (0) {"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "with the text: fixture.networks.twice:"
        ]
      }
    },
    {
      "name": "protocol-ignored",
      "summary": "a local port forwarded by TCP and by UDP is taken for one forwarded twice",
      "edits": [
        {
          "file": "tools/etude/cases.c",
          "find": "same(json_text(g, \"protocol\"), json_text(f, \"protocol\")) &&",
          "replace": ""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "0 manifest ./networks-ok.json"
        ]
      }
    },
    {
      "name": "guest-boot-taken",
      "summary": "forwards of a card of a guest case's boot are taken",
      "edits": [
        {
          "file": "tools/etude/cases.c",
          "find": "json_member(dev, \"forwards\") != NULL || ",
          "replace": ""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "with the text: fixture.networks.guest-boot:"
        ]
      }
    },
    {
      "name": "boot-relay-taken",
      "summary": "guest forwards of a card of a guest case's boot are taken",
      "edits": [
        {
          "file": "tools/etude/cases.c",
          "find": "json_member(dev, \"guest_forwards\") != NULL ||",
          "replace": ""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "with the text: fixture.networks.guest-boot-relay:"
        ]
      }
    },
    {
      "name": "boot-restricted-taken",
      "summary": "a restricted card of a guest case's boot is taken",
      "edits": [
        {
          "file": "tools/etude/cases.c",
          "find": "(restricted != NULL && restricted->integer != 0)",
          "replace": "0"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "with the text: fixture.networks.guest-boot-restricted:"
        ]
      }
    },
    {
      "name": "guest-address-taken",
      "summary": "a guest forward from an address QEMU cannot forward is taken",
      "edits": [
        {
          "file": "tools/etude/cases.c",
          "find": "if (!etude_qemu_guest_address(&card, address)) {",
          "replace": "if (0) {"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "with the text: fixture.networks.guest-address:",
          "with the text: fixture.networks.guest-subnet:"
        ]
      }
    },
    {
      "name": "card-network-ignored",
      "summary": "guest forwards are judged on the default network in place of the card's own",
      "edits": [
        {
          "file": "tools/etude/cases.c",
          "find": "card_of(dev, &card);",
          "replace": "card_of(dev, &card);\n    card.net = NULL;"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "with the text: fixture.networks.guest-subnet:",
          "0 manifest ./networks-ok.json"
        ]
      }
    },
    {
      "name": "guest-past-taken",
      "summary": "a guest forward to a port past those the case reserves is taken",
      "edits": [
        {
          "file": "tools/etude/cases.c",
          "find": "if (local >= ports) {",
          "replace": "if (0) {"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "with the text: fixture.networks.guest-past:"
        ]
      }
    },
    {
      "name": "guest-both-taken",
      "summary": "a port forwarded by TCP both to the guest and from it is taken",
      "edits": [
        {
          "file": "tools/etude/cases.c",
          "find": "if (forwarded_tcp(devs, local)) {",
          "replace": "if (0) {"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "with the text: fixture.networks.guest-both:"
        ]
      }
    },
    {
      "name": "guest-twice-taken",
      "summary": "connections to one address and port forwarded twice are taken",
      "edits": [
        {
          "file": "tools/etude/cases.c",
          "find": "json_member(list->item[k], \"guest_port\")->integer == guest) {",
          "replace": "json_member(list->item[k], \"guest_port\")->integer == guest && 0) {"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "with the text: fixture.networks.guest-twice:"
        ]
      }
    },
    {
      "name": "relay-taken",
      "summary": "a relay that the case does not have is taken",
      "edits": [
        {
          "file": "tools/etude/cases.c",
          "find": "if (command != NULL && !listed(tools, command) &&",
          "replace": "if (0 && command != NULL && !listed(tools, command) &&"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "with the text: fixture.networks.guest-relay:"
        ]
      }
    },
    {
      "name": "udp-listening",
      "summary": "a port forwarded to the guest by UDP is taken for one QEMU listens on by TCP",
      "edits": [
        {
          "file": "tools/etude/cases.c",
          "find": "if (same(json_text(list->item[j], \"protocol\"), \"tcp\") &&",
          "replace": "if ("
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "0 manifest ./networks-ok.json"
        ]
      }
    }
  ]
}
