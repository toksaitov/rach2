{
  "schema_version": 1,
  "proof": "diskdiag",
  "summary": "the case of tests/run diskdiag under etude, against a /proc/disk that gives one sector fewer than the disk has, a raw read of /dev/disk0 one sector past the one asked, and an ordinary kernel whose /dev/disk0 passes a write to the driver",
  "tree": "shared",
  "sources": [
    "rach2/sys/block/diskinfo.c",
    "rach2/sys/fs/devfs.c"
  ],
  "artifacts": [
    "${WORK}/kernel"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "sh tests/proofs/guest.sh make rach2-metal && sh tests/proofs/guest.sh copy ${WORK} rach2-metal/kernel"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec tests/run diskdiag </dev/null"
    ],
    "bound_s": 3600
  },
  "faults": [
    {
      "name": "short-count",
      "summary": "/proc/disk gives the disk's sectors less one",
      "edits": [
        {
          "file": "rach2/sys/block/diskinfo.c",
          "find": "    put_dec(buf, &n, cap, d->sectors);",
          "replace": "    put_dec(buf, &n, cap, d->sectors - 1);"
        }
      ],
      "fails": {
        "lines": [
          "run: diskdiag: FAIL",
          "assert sectors fail"
        ],
        "status": 1
      }
    },
    {
      "name": "next-sector",
      "summary": "a raw read of a disk's window starts one sector past its offset",
      "edits": [
        {
          "file": "rach2/sys/fs/devfs.c",
          "find": "        uint64_t lba = at / BLOCK_SECTOR_SIZE;",
          "replace": "        uint64_t lba = at / BLOCK_SECTOR_SIZE + 1;"
        }
      ],
      "fails": {
        "lines": [
          "run: diskdiag: FAIL",
          "assert sector-first fail",
          "assert sector-partition fail",
          "assert sector-last fail"
        ],
        "status": 1
      }
    },
    {
      "name": "write-through",
      "summary": "an ordinary kernel's /dev/disk0 passes a write to the driver in place of refusing it",
      "edits": [
        {
          "file": "rach2/sys/fs/devfs.c",
          "find": "#ifdef RACH2_RECOVERY\nstatic int32_t dev_disk_write(",
          "replace": "#if 1\nstatic int32_t dev_disk_write("
        }
      ],
      "fails": {
        "lines": [
          "run: diskdiag: FAIL",
          "assert no-refusal fail"
        ],
        "status": 1
      }
    }
  ]
}
