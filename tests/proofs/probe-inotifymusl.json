{
  "schema_version": 1,
  "proof": "probe-inotifymusl",
  "summary": "the row of inotifymusl in the default suite, with faults in the kernel",
  "tree": "shared",
  "sources": [
    "rach2/sys/io/inotify.c",
    "rach2/sys/fs/vfs.c"
  ],
  "artifacts": [
    "${WORK}/kernel"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "sh tests/proofs/guest.sh make rach2 test-image && sh tests/proofs/guest.sh copy ${WORK} rach2/kernel"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "tests/proofs/guest.sh",
      "default",
      "inotifymusl"
    ],
    "bound_s": 900,
    "fail_prefix": "guest: fail: "
  },
  "faults": [
    {
      "name": "inotify-init-clobbers-ebx",
      "summary": "inotify",
      "edits": [
        {
          "file": "rach2/sys/io/inotify.c",
          "find": "    (void)params;\n    return inotify_open(0);\n",
          "replace": "    params->ebx = 0;\n    return inotify_open(0);\n"
        }
      ],
      "fails": {
        "lines": [
          "INOTIFYMUSL FAIL (inotify_init changed the caller's EBX",
          "guest: fail: inotifymusl did not pass"
        ]
      }
    },
    {
      "name": "inotify-no-merge",
      "summary": "inotify",
      "edits": [
        {
          "file": "rach2/sys/io/inotify.c",
          "find": "    if (last && last->wd == wd && last->mask == mask && last->cookie == cookie &&\n",
          "replace": "    if (last && last->wd == wd && last->mask == mask && last->cookie == cookie && !last &&\n"
        }
      ],
      "fails": {
        "lines": [
          "INOTIFYMUSL FAIL (the events of a directory and a file: event 3",
          "guest: fail: inotifymusl did not pass"
        ]
      }
    },
    {
      "name": "inotify-mkdir-not-dir",
      "summary": "inotify",
      "edits": [
        {
          "file": "rach2/sys/fs/vfs.c",
          "find": "        watch_made(mnt, dir, name, IN_ISDIR);\n",
          "replace": "        watch_made(mnt, dir, name, 0);\n"
        }
      ],
      "fails": {
        "lines": [
          "INOTIFYMUSL FAIL (the events of a directory and a file: event 22",
          "guest: fail: inotifymusl did not pass"
        ]
      }
    },
    {
      "name": "inotify-small-read",
      "summary": "inotify",
      "edits": [
        {
          "file": "rach2/sys/io/inotify.c",
          "find": "    return done ? (int32_t)done : -EINVAL;\n",
          "replace": "    return done ? (int32_t)done : 0;\n"
        }
      ],
      "fails": {
        "lines": [
          "INOTIFYMUSL FAIL (a read too small for an event was not EINVAL",
          "guest: fail: inotifymusl did not pass"
        ]
      }
    },
    {
      "name": "inotify-oneshot-kept",
      "summary": "inotify",
      "edits": [
        {
          "file": "rach2/sys/io/inotify.c",
          "find": "    if (w->mask & IN_ONESHOT) {\n        drop(w);\n        return 1;\n    }\n",
          "replace": "\n"
        }
      ],
      "fails": {
        "lines": [
          "INOTIFYMUSL FAIL (a one-shot watch",
          "guest: fail: inotifymusl did not pass"
        ]
      }
    }
  ]
}
