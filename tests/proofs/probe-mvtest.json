{
  "schema_version": 1,
  "proof": "probe-mvtest",
  "summary": "mvtest of the default suite, with faults in the kernel that its rows must catch",
  "tree": "shared",
  "sources": [
    "rach2/sys/syscall_fs.c"
  ],
  "artifacts": [
    "${WORK}/kernel"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "tests/system/default_probe.sh",
      "--build",
      "${WORK}"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "tests/system/default_probe.sh",
      "mvtest"
    ],
    "bound_s": 1200,
    "fail_prefix": "default-probe: fail: "
  },
  "faults": [
    {
      "name": "rename-root-einval",
      "summary": "a fault in syscall_fs.c that fails the row: Test 6d: rename(\"/\", \"mvtest.x\") == -EBUSY... FAILED",
      "edits": [
        {
          "file": "rach2/sys/syscall_fs.c",
          "find": "        return (old_name[0] != '\\0' && (flags & RENAME_NOREPLACE)) ? -EEXIST : -EBUSY;\n",
          "replace": "        return -EINVAL;\n"
        }
      ],
      "fails": {
        "lines": [
          "default-probe: fail: mvtest did not pass",
          "Test 6d: rename(\"/\", \"mvtest.x\") == -EBUSY... FAILED"
        ]
      }
    }
  ]
}
