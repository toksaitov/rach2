{
  "schema_version": 1,
  "proof": "progress",
  "summary": "The manager reports delayed phase work and unassigned failures from complete command reads",
  "tree": "private",
  "sources": [
    "tools/flow/progress.py"
  ],
  "artifacts": [
    "${WORK}/progress.py"
  ],
  "build": {
    "argv": [
      "/bin/cp",
      "${SRC}/tools/flow/progress.py",
      "${WORK}/progress.py"
    ],
    "bound_s": 10
  },
  "test": {
    "argv": [
      "/usr/bin/env",
      "python3",
      "-B",
      "tests/system/progress_test.py",
      "${WORK}/progress.py"
    ],
    "bound_s": 60,
    "fail_prefix": "progress-test: failed: "
  },
  "faults": [
    {
      "name": "phase-idle",
      "summary": "a phase with no completed member is not reported",
      "edits": [
        {
          "file": "tools/flow/progress.py",
          "find": "if work and age >= 21600:",
          "replace": "if False:"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "progress-test: failed: phase-idle:"
        ]
      }
    },
    {
      "name": "blocking-member",
      "summary": "a late member that blocks other work is not reported",
      "edits": [
        {
          "file": "tools/flow/progress.py",
          "find": "if start is not None and age >= 21600:",
          "replace": "if False:"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "progress-test: failed: dependency:"
        ]
      }
    },
    {
      "name": "unassigned-failure",
      "summary": "an unassigned failure waits past thirty minutes",
      "edits": [
        {
          "file": "tools/flow/progress.py",
          "find": "if age >= 1800:",
          "replace": "if age >= 3601:"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "progress-test: failed: half-hour:"
        ]
      }
    },
    {
      "name": "closure",
      "summary": "a completed member does not advance phase progress",
      "edits": [
        {
          "file": "tools/flow/progress.py",
          "find": "last = max([start] + closed)",
          "replace": "last = start"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "progress-test: failed: closure:"
        ]
      }
    },
    {
      "name": "handback",
      "summary": "a failure handed back is timed from its creation",
      "edits": [
        {
          "file": "tools/flow/progress.py",
          "find": "for e in events if e.get(\"event\") == \"unassigned\"",
          "replace": "for e in events if False"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "progress-test: failed: recent-handback:"
        ]
      }
    },
    {
      "name": "prerequisite",
      "summary": "a member waiting on an open prerequisite is reported late",
      "edits": [
        {
          "file": "tools/flow/progress.py",
          "find": "            if blocked:",
          "replace": "            if False:"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "progress-test: failed: prerequisite:"
        ]
      }
    },
    {
      "name": "assignment",
      "summary": "the creation time replaces the current assignment time",
      "edits": [
        {
          "file": "tools/flow/progress.py",
          "find": "max(start or now, assigned_since(issue))",
          "replace": "max(start or now, stamp(issue[\"created_at\"]))"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "progress-test: failed: new-assignment:"
        ]
      }
    }
  ]
}
