{
  "schema_version": 1,
  "proof": "probe-auxvprobe",
  "summary": "the row of auxvprobe in the default suite, with faults in the kernel",
  "tree": "shared",
  "sources": [
    "rach2/sys/arch/i686/loader.s"
  ],
  "artifacts": [
    "${WORK}/kernel"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "tests/system/default_probe.sh",
      "--build",
      "${WORK}"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "tests/system/default_probe.sh",
      "auxvprobe"
    ],
    "bound_s": 900,
    "fail_prefix": "default-probe: fail: "
  },
  "faults": [
    {
      "name": "enter-user-edx",
      "summary": "the row that fails with: edx not 0 at entry",
      "edits": [
        {
          "file": "rach2/sys/arch/i686/loader.s",
          "find": "    xorl %edx, %edx\n",
          "replace": "\n"
        }
      ],
      "fails": {
        "lines": [
          "FAIL: edx not 0 at entry",
          "default-probe: fail: auxvprobe did not pass"
        ]
      }
    }
  ]
}
