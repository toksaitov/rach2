{
  "schema_version": 1,
  "proof": "login-cases",
  "summary": "The login cases detect an open strict console, an unprivileged permissive shell, a stopped session and a missing rescue shell",
  "tree": "shared",
  "sources": [
    "utils/init.c",
    "rach2/kernel.c"
  ],
  "artifacts": [
    "${WORK}/kernel",
    "${WORK}/init-login",
    "${WORK}/init-shell"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "sh tests/proofs/guest.sh make rach2 utils && sh tests/proofs/guest.sh copy ${WORK} rach2/kernel utils/sbin/init-login utils/sbin/init-shell"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec sh tests/proofs/guest.sh run login \"run: login: PASS\""
    ],
    "bound_s": 1800
  },
  "faults": [
    {
      "name": "strict-open",
      "summary": "a missing login also prints the result of an unauthenticated id",
      "edits": [
        {
          "file": "utils/init.c",
          "find": "    (void)write(STDERR_FILENO, first, sizeof(first) - 1);",
          "replace": "    (void)write(STDERR_FILENO, first, sizeof(first) - 1);\n    (void)write(STDOUT_FILENO, \"uid=0\\n\", 6);"
        }
      ],
      "fails": {
        "lines": [
          "failure: closed failed:"
        ],
        "status": 1
      }
    },
    {
      "name": "shell-uid",
      "summary": "the permissive shell starts under an unprivileged uid",
      "edits": [
        {
          "file": "utils/init.c",
          "find": "    for (i = 0; Shells[i] != 0; i++) {",
          "replace": "    setuid(1000);\n    for (i = 0; Shells[i] != 0; i++) {"
        }
      ],
      "fails": {
        "lines": [
          "machine.login.shell on",
          "failure: root-shell failed:"
        ],
        "status": 1
      }
    },
    {
      "name": "session-stop",
      "summary": "init leaves a stopped console session stopped",
      "edits": [
        {
          "file": "utils/init.c",
          "find": "            kill(reaped, SIGCONT);",
          "replace": "            (void)reaped;"
        }
      ],
      "fails": {
        "lines": [
          "machine.login.stopped on",
          "continued failed: waiting for \"CONTINUED-OK\"",
          "gap bound"
        ],
        "status": 1
      }
    },
    {
      "name": "rescue-shell",
      "summary": "a rescue request still starts the image init",
      "edits": [
        {
          "file": "rach2/kernel.c",
          "find": "    if (!rescue_mode) {\n        refuse_unmounted_root();",
          "replace": "    if (1) {\n        refuse_unmounted_root();"
        }
      ],
      "fails": {
        "lines": [
          "machine.login.rescue on",
          "rescue failed: waiting for \"rescue mode\"",
          "gap bound"
        ],
        "status": 1
      }
    }
  ]
}
