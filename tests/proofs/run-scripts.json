{
  "schema_version": 1,
  "proof": "run-scripts",
  "summary": "run_scripts_test.sh against private copies of the run scripts under rach2/, each fault failing the row named for it",
  "tree": "private",
  "sources": [
    "rach2/run.sh",
    "rach2/run_from_disk.sh",
    "rach2/run_from_iso.sh",
    "rach2/debug.sh",
    "rach2/qemu_devices.sh"
  ],
  "artifacts": [
    "${WORK}/rach2/run.sh",
    "${WORK}/rach2/run_from_disk.sh",
    "${WORK}/rach2/run_from_iso.sh",
    "${WORK}/rach2/debug.sh",
    "${WORK}/rach2/qemu_devices.sh"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "mkdir -p ${WORK}/rach2 && cd ${SRC}/rach2 && exec cp run.sh run_from_disk.sh run_from_iso.sh debug.sh qemu_devices.sh ${WORK}/rach2/"
    ],
    "bound_s": 10
  },
  "test": {
    "argv": [
      "/usr/bin/env",
      "RUN_SCRIPTS=${WORK}/rach2",
      "sh",
      "tests/system/run_scripts_test.sh"
    ],
    "bound_s": 300,
    "fail_prefix": "run-scripts-test: result: fail: "
  },
  "faults": [
    {
      "name": "run-default",
      "summary": "run.sh boots without `-cpu max` by default",
      "edits": [
        {
          "file": "rach2/run.sh",
          "find": "CPU=\"${CPU:-max}\"",
          "replace": "CPU=\"${CPU:-qemu64}\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "run-scripts-test: result: fail: run-default:"
        ]
      }
    },
    {
      "name": "run-override",
      "summary": "run.sh ignores CPU",
      "edits": [
        {
          "file": "rach2/run.sh",
          "find": "CPU=\"${CPU:-max}\"",
          "replace": "CPU=max"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "run-scripts-test: result: fail: run-cpu:"
        ]
      }
    },
    {
      "name": "disk-default",
      "summary": "run_from_disk.sh boots without `-cpu max` by default",
      "edits": [
        {
          "file": "rach2/run_from_disk.sh",
          "find": "CPU=\"${CPU:-max}\"",
          "replace": "CPU=\"${CPU:-qemu64}\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "run-scripts-test: result: fail: disk-default:"
        ]
      }
    },
    {
      "name": "disk-override",
      "summary": "run_from_disk.sh ignores CPU",
      "edits": [
        {
          "file": "rach2/run_from_disk.sh",
          "find": "CPU=\"${CPU:-max}\"",
          "replace": "CPU=max"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "run-scripts-test: result: fail: disk-cpu:"
        ]
      }
    },
    {
      "name": "iso-default",
      "summary": "run_from_iso.sh boots without `-cpu max` by default",
      "edits": [
        {
          "file": "rach2/run_from_iso.sh",
          "find": "CPU=\"${CPU:-max}\"",
          "replace": "CPU=\"${CPU:-qemu64}\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "run-scripts-test: result: fail: iso-default:"
        ]
      }
    },
    {
      "name": "iso-override",
      "summary": "run_from_iso.sh ignores CPU",
      "edits": [
        {
          "file": "rach2/run_from_iso.sh",
          "find": "CPU=\"${CPU:-max}\"",
          "replace": "CPU=max"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "run-scripts-test: result: fail: iso-cpu:"
        ]
      }
    },
    {
      "name": "display-default",
      "summary": "qemu_devices.sh gives no `-display none` on a Linux host without a display",
      "edits": [
        {
          "file": "rach2/qemu_devices.sh",
          "find": "DISPLAY_MODE=\"${DISPLAY_MODE:-none}\"",
          "replace": ":"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "run-scripts-test: result: fail: run-nodisplay:"
        ]
      }
    },
    {
      "name": "display-x11",
      "summary": "qemu_devices.sh ignores DISPLAY",
      "edits": [
        {
          "file": "rach2/qemu_devices.sh",
          "find": "[ -z \"${DISPLAY:-}${WAYLAND_DISPLAY:-}\" ]",
          "replace": "[ -z \"${WAYLAND_DISPLAY:-}\" ]"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "run-scripts-test: result: fail: run-x11:"
        ]
      }
    },
    {
      "name": "net-off",
      "summary": "qemu_devices.sh gives no `-nic none` for NET=off",
      "edits": [
        {
          "file": "rach2/qemu_devices.sh",
          "find": "NET_OPTS=\"-nic none\"",
          "replace": "NET_OPTS=\"\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "run-scripts-test: result: fail: run-nonet:"
        ]
      }
    },
    {
      "name": "debug-rescue",
      "summary": "debug.sh without an image boots no debug shell",
      "edits": [
        {
          "file": "rach2/debug.sh",
          "find": "    set -- -append rach2.rescue",
          "replace": "    set --"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "run-scripts-test: result: fail: debug-rescue:"
        ]
      }
    }
  ]
}
