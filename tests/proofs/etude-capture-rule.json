{
  "schema_version": 1,
  "proof": "etude-capture-rule",
  "summary": "casecheck reports a capture of a network card the profile does not have",
  "tree": "private",
  "sources": [
    "tools/etude/cases.c"
  ],
  "artifacts": [
    "${WORK}/casecheck"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec ${CC:-cc} -std=c99 -I tools/etude -I tools/etude/include -I utils tools/etude/casecheck.c ${SRC}/tools/etude/cases.c tools/etude/digest.c tools/etude/judge.c tools/etude/json.c tools/etude/processor.c tools/etude/qemu_profile.c tools/etude/schema.c tools/etude/verdict.c tools/etude/history.c tools/etude/history_json.c utils/sha256.c -o ${WORK}/casecheck"
    ],
    "bound_s": 120
  },
  "test": {
    "argv": [
      "${WORK}/casecheck",
      "--selftest",
      "tools/etude/fixtures"
    ],
    "bound_s": 60
  },
  "faults": [
    {
      "name": "rule-omitted",
      "summary": "capture rule not run",
      "edits": [
        {
          "file": "tools/etude/cases.c",
          "find": "    rule_captures(&r);\n",
          "replace": ""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "capture-card: the capture net1 names no network card of 1"
        ]
      }
    },
    {
      "name": "objects-uncounted",
      "summary": "card objects not counted",
      "edits": [
        {
          "file": "tools/etude/cases.c",
          "find": "        model = d->type == JSON_STRING ? d->string : json_text(d, \"model\");\n",
          "replace": "        model = d->type == JSON_STRING ? d->string : NULL;\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "0 manifest ./network-valid.json"
        ]
      }
    }
  ]
}
