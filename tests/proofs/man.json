{
  "schema_version": 1,
  "proof": "man",
  "summary": "the cases of tests/run man under etude, against a man that ignores the alias table, one that drops the options of the pager -P names, and one that gives only a page's first fifty lines through a pipe",
  "tree": "shared",
  "sources": [
    "krffs/man.script"
  ],
  "artifacts": [
    "${WORK}/os-real.krffs"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "sh tests/proofs/guest.sh make images && sh tests/proofs/guest.sh copy ${WORK} images/os-real.krffs"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec tests/run man </dev/null"
    ],
    "bound_s": 3600
  },
  "faults": [
    {
      "name": "no-alias",
      "summary": "a name is looked up as a page alone, never as an alias",
      "edits": [
        {
          "file": "krffs/man.script",
          "find": "        page=\"$mandir/cat$section/${target:-$1}.$section\"\n",
          "replace": "        page=\"$mandir/cat$section/$1.$section\"\n"
        }
      ],
      "fails": {
        "lines": [
          "run: man: FAIL",
          "assert pipe fail"
        ],
        "status": 1
      }
    },
    {
      "name": "pager-options",
      "summary": "the pager -P names runs without its options",
      "edits": [
        {
          "file": "krffs/man.script",
          "find": "        gunzip -c \"$found\" | sh -c \"$pager\" || status=1\n",
          "replace": "        gunzip -c \"$found\" | sh -c \"${pager%% *}\" || status=1\n"
        }
      ],
      "fails": {
        "lines": [
          "run: man: FAIL",
          "assert named-pager fail"
        ],
        "status": 1
      }
    },
    {
      "name": "truncated",
      "summary": "a page given through a pipe stops after its first fifty lines",
      "edits": [
        {
          "file": "krffs/man.script",
          "find": "    else\n        gunzip -c \"$found\" || status=1\n",
          "replace": "    else\n        gunzip -c \"$found\" | head -n 50 || status=1\n"
        }
      ],
      "fails": {
        "lines": [
          "run: man: FAIL",
          "assert pipe fail"
        ],
        "status": 1
      }
    }
  ]
}
