{
  "schema_version": 1,
  "proof": "commit-msg",
  "summary": "commit_msg_test.sh against private copies of tools/git-hooks/commit-msg, each fault failing exactly its rows",
  "tree": "private",
  "sources": [
    "tools/git-hooks/commit-msg"
  ],
  "artifacts": [
    "${WORK}/commit-msg"
  ],
  "build": {
    "argv": [
      "/bin/cp",
      "${SRC}/tools/git-hooks/commit-msg",
      "${WORK}/commit-msg"
    ],
    "bound_s": 10
  },
  "test": {
    "argv": [
      "/usr/bin/env",
      "COMMIT_MSG_HOOK=${WORK}/commit-msg",
      "sh",
      "tests/system/commit_msg_test.sh"
    ],
    "bound_s": 60,
    "fail_prefix": "commit-msg-test: fail: "
  },
  "faults": [
    {
      "name": "coauthor",
      "summary": "Co-Authored-By no longer refused",
      "edits": [
        {
          "file": "tools/git-hooks/commit-msg",
          "find": "    -e '^(co-authored-by|claude-session|signed-off-by)[[:space:]]*:' \\\n",
          "replace": "    -e '^(claude-session|signed-off-by)[[:space:]]*:' \\\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "commit-msg-test: fail: coauthor:"
        ],
        "only": true
      }
    },
    {
      "name": "case",
      "summary": "the patterns matched in one letter case",
      "edits": [
        {
          "file": "tools/git-hooks/commit-msg",
          "find": "found=$(LC_ALL=C grep -n -i -E \\\n",
          "replace": "found=$(LC_ALL=C grep -n -E \\\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "commit-msg-test: fail: coauthor:",
          "commit-msg-test: fail: session:",
          "commit-msg-test: fail: signoff:",
          "commit-msg-test: fail: generated:",
          "commit-msg-test: fail: robot:"
        ],
        "only": true
      }
    },
    {
      "name": "session",
      "summary": "Claude-Session no longer refused",
      "edits": [
        {
          "file": "tools/git-hooks/commit-msg",
          "find": "    -e '^(co-authored-by|claude-session|signed-off-by)[[:space:]]*:' \\\n",
          "replace": "    -e '^(co-authored-by|signed-off-by)[[:space:]]*:' \\\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "commit-msg-test: fail: session:"
        ],
        "only": true
      }
    },
    {
      "name": "signoff",
      "summary": "Signed-off-by no longer refused",
      "edits": [
        {
          "file": "tools/git-hooks/commit-msg",
          "find": "    -e '^(co-authored-by|claude-session|signed-off-by)[[:space:]]*:' \\\n",
          "replace": "    -e '^(co-authored-by|claude-session)[[:space:]]*:' \\\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "commit-msg-test: fail: signoff:"
        ],
        "only": true
      }
    },
    {
      "name": "generated",
      "summary": "the generated-with footer no longer refused",
      "edits": [
        {
          "file": "tools/git-hooks/commit-msg",
          "find": "    -e '^([^ -~]+[[:space:]]+)?generated with \\[?claude code([[:space:]]|]|$)' \\\n",
          "replace": "    -e '^([^ -~]+[[:space:]]+)?produced by \\[?claude code([[:space:]]|]|$)' \\\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "commit-msg-test: fail: generated:",
          "commit-msg-test: fail: robot:"
        ],
        "only": true
      }
    },
    {
      "name": "noreply",
      "summary": "a trailer ending with the noreply address no longer refused",
      "edits": [
        {
          "file": "tools/git-hooks/commit-msg",
          "find": "# <noreply@anthropic.com>. It prints the first such line and its number.\n",
          "replace": "# <nobody@nowhere.com>. It prints the first such line and its number.\n"
        },
        {
          "file": "tools/git-hooks/commit-msg",
          "find": "    -e '^[[:alnum:]][[:alnum:]-]*:[[:space:]]*[^<>]*<noreply@anthropic\\.com>[[:space:]]*$' \\\n",
          "replace": "    -e '^[[:alnum:]][[:alnum:]-]*:[[:space:]]*[^<>]*<nobody@nowhere\\.com>[[:space:]]*$' \\\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "commit-msg-test: fail: noreply:"
        ],
        "only": true
      }
    },
    {
      "name": "status",
      "summary": "a refusal that exits 0",
      "edits": [
        {
          "file": "tools/git-hooks/commit-msg",
          "find": "exit 1\n",
          "replace": "exit 0\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "commit-msg-test: fail: coauthor:",
          "commit-msg-test: fail: session:",
          "commit-msg-test: fail: signoff:",
          "commit-msg-test: fail: generated:",
          "commit-msg-test: fail: robot:",
          "commit-msg-test: fail: noreply:"
        ],
        "only": true
      }
    },
    {
      "name": "everything",
      "summary": "a message without attribution refused",
      "edits": [
        {
          "file": "tools/git-hooks/commit-msg",
          "find": "    1) exit 0 ;;\n",
          "replace": "    1) ;;\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "commit-msg-test: fail: plain:",
          "commit-msg-test: fail: body:",
          "commit-msg-test: fail: mention:",
          "commit-msg-test: fail: verbose:"
        ],
        "only": true
      }
    },
    {
      "name": "prefix",
      "summary": "any run of punctuation allowed before the footer",
      "edits": [
        {
          "file": "tools/git-hooks/commit-msg",
          "find": "    -e '^([^ -~]+[[:space:]]+)?generated with \\[?claude code([[:space:]]|]|$)' \\\n",
          "replace": "    -e '^([^[:alnum:][:space:]]+[[:space:]]+)?generated with \\[?claude code([[:space:]]|]|$)' \\\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "commit-msg-test: fail: verbose:"
        ],
        "only": true
      }
    },
    {
      "name": "dash",
      "summary": "a trailer name that may start with a dash",
      "edits": [
        {
          "file": "tools/git-hooks/commit-msg",
          "find": "    -e '^[[:alnum:]][[:alnum:]-]*:[[:space:]]*[^<>]*<noreply@anthropic\\.com>[[:space:]]*$' \\\n",
          "replace": "    -e '^[[:alnum:]-]*:[[:space:]]*[^<>]*<noreply@anthropic\\.com>[[:space:]]*$' \\\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "commit-msg-test: fail: verbose:"
        ],
        "only": true
      }
    },
    {
      "name": "indent",
      "summary": "a trailer matched after leading space",
      "edits": [
        {
          "file": "tools/git-hooks/commit-msg",
          "find": "    -e '^(co-authored-by|claude-session|signed-off-by)[[:space:]]*:' \\\n",
          "replace": "    -e '^[[:space:]]*(co-authored-by|claude-session|signed-off-by)[[:space:]]*:' \\\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "commit-msg-test: fail: verbose:"
        ],
        "only": true
      }
    }
  ]
}
