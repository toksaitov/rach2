{
  "schema_version": 1,
  "proof": "test-status",
  "summary": "test_status_test.py against a private copy of tools/flow/test_status.py whose start-time check is False; Linux only, since the test skips a host without /proc/locks",
  "tree": "private",
  "sources": [
    "tools/flow/test_status.py"
  ],
  "artifacts": [
    "${WORK}/test_status.py",
    "${WORK}/runutil"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "cp ${SRC}/tools/flow/test_status.py ${WORK}/test_status.py && exec ${CC:-cc} -O2 -Wall -Wextra -Werror -o ${WORK}/runutil tests/system/runner/runutil.c"
    ],
    "bound_s": 120
  },
  "test": {
    "argv": [
      "/usr/bin/env",
      "TEST_STATUS_READER=${WORK}/test_status.py",
      "python3",
      "tests/system/test_status_test.py",
      "${WORK}/runutil"
    ],
    "bound_s": 120
  },
  "faults": [
    {
      "name": "start-time",
      "summary": "the reader's start-time check is False, which must fail the pid reuse rows",
      "edits": [
        {
          "file": "tools/flow/test_status.py",
          "find": "words[19] != str(start)",
          "replace": "False"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "assert \"dead (pid reused)\" in report()"
        ]
      }
    }
  ]
}
