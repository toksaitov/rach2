{
  "schema_version": 1,
  "proof": "probe-sigmusl",
  "summary": "the row of sigmusl in the default suite, with faults in the kernel",
  "tree": "shared",
  "sources": [
    "rach2/sys/arch/i686/sigframe.c"
  ],
  "artifacts": [
    "${WORK}/kernel"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "tests/system/default_probe.sh",
      "--build",
      "${WORK}"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "tests/system/default_probe.sh",
      "musl/sigmusl"
    ],
    "bound_s": 900,
    "fail_prefix": "default-probe: fail: "
  },
  "faults": [
    {
      "name": "rt-context-unfilled",
      "summary": "the row that fails with: ucontext cs=0x0 esp=0x0 fpregs=0x0",
      "edits": [
        {
          "file": "rach2/sys/arch/i686/sigframe.c",
          "find": "        fill_sigcontext(&frame.rt.uc.mc, tf, fp_addr, oldmask);\n        frame.rt.uc.sigmask[0] = (uint32_t)oldmask;\n",
          "replace": "        frame.rt.uc.sigmask[0] = (uint32_t)oldmask;\n"
        }
      ],
      "fails": {
        "lines": [
          "SIGMUSL FAIL: ucontext cs=0x0 esp=0x0 fpregs=0x0",
          "default-probe: fail: musl/sigmusl did not pass"
        ]
      }
    }
  ]
}
