{
  "schema_version": 1,
  "proof": "style-cases",
  "summary": "style_cases_test.sh on private copies of tests/cases/host/style.sh and its manifest, each fault failing the row named for it",
  "tree": "private",
  "sources": [
    "tests/cases/host/style.sh",
    "tests/cases/host.style.json"
  ],
  "artifacts": [
    "${WORK}/style.sh",
    "${WORK}/host.style.json"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "cp ${SRC}/tests/cases/host/style.sh ${SRC}/tests/cases/host.style.json ${WORK}/"
    ],
    "bound_s": 60
  },
  "test": {
    "argv": [
      "/bin/sh",
      "tests/system/style_cases_test.sh",
      "${WORK}/style.sh",
      "${WORK}/host.style.json"
    ],
    "bound_s": 300
  },
  "faults": [
    {
      "name": "comment",
      "summary": "the conventions case finds no // comment",
      "edits": [
        {
          "file": "tests/cases/host/style.sh",
          "find": "\"$(inhouse_ch | xargs grep -nE '(^|[^:\"])//' 2>/dev/null | grep -vE 'https?://|://')\"",
          "replace": "\"\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "style-cases-test: comment: the case did not fail"
        ]
      }
    },
    {
      "name": "guard",
      "summary": "a header without a guard passes",
      "edits": [
        {
          "file": "tests/cases/host/style.sh",
          "find": "grep -qE '^[[:space:]]*#[[:space:]]*ifndef[[:space:]]+[A-Za-z0-9_]+' \"$h\" ||",
          "replace": "true ||"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "style-cases-test: guard: the case did not fail"
        ]
      }
    },
    {
      "name": "flag",
      "summary": "a script with set -eu and an EXIT trap passes without its finished flag",
      "edits": [
        {
          "file": "tests/cases/host/style.sh",
          "find": "! grep -qF '[ -n \"$finished\" ]' \"$f\"; then",
          "replace": "false; then"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "style-cases-test: flag: the case did not fail"
        ]
      }
    },
    {
      "name": "status",
      "summary": "a case whose assertion failed exits 0",
      "edits": [
        {
          "file": "tests/cases/host/style.sh",
          "find": "echo \"style: result: failed: $ID:$FAILED\"\nexit 1\n",
          "replace": "echo \"style: result: failed: $ID:$FAILED\"\nexit 0\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "style-cases-test: comment: the case did not fail"
        ]
      }
    },
    {
      "name": "report",
      "summary": "a failed check is reported as a pass",
      "edits": [
        {
          "file": "tests/cases/host/style.sh",
          "find": "record \"assert $1 fail $(clip \"$2\")\"",
          "replace": "record \"assert $1 pass\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "style-cases-test: comment: the judgment does not have"
        ]
      }
    },
    {
      "name": "renamed",
      "summary": "the manifest's conventions case declares an assertion the program does not report, in place of one it does",
      "edits": [
        {
          "file": "tests/cases/host.style.json",
          "find": "\"assertion_id\": \"exit-flag\"",
          "replace": "\"assertion_id\": \"exit-flags\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "style-cases-test: the judgment of a clean report did not pass"
        ]
      }
    }
  ]
}
