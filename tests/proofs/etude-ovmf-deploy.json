{
  "schema_version": 1,
  "proof": "etude-ovmf-deploy",
  "summary": "deployment records a discovered, missing or Windows OVMF code image",
  "tree": "private",
  "sources": [
    "tools/etude/deploy.sh"
  ],
  "artifacts": [
    "${WORK}/deploy.sh"
  ],
  "build": {
    "argv": [
      "/bin/cp",
      "${SRC}/tools/etude/deploy.sh",
      "${WORK}/deploy.sh"
    ],
    "bound_s": 30
  },
  "test": {
    "argv": [
      "/bin/sh",
      "-c",
      "ETUDE_DEPLOY_SOURCE=${WORK}/deploy.sh exec sh tests/system/etude_deploy_test.sh --ovmf"
    ],
    "bound_s": 120,
    "fail_prefix": "etude-deploy-test: failed: "
  },
  "faults": [
    {
      "name": "no-discovery",
      "summary": "the firmware finder is not run",
      "edits": [
        {
          "file": "tools/etude/deploy.sh",
          "find": "        deploy_find_ovmf\n",
          "replace": "        OVMF_CODE=${RACH2_OVMF_CODE:-}\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-deploy-test: failed: ovmf-discovery"
        ],
        "only": true
      }
    },
    {
      "name": "missing-code",
      "summary": "an absent firmware override is recorded as usable",
      "edits": [
        {
          "file": "tools/etude/deploy.sh",
          "find": "        if [ -z \"$OVMF_CODE\" ] || [ ! -f \"$OVMF_CODE\" ] || [ ! -r \"$OVMF_CODE\" ]; then\n",
          "replace": "        if false; then\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-deploy-test: failed: ovmf-missing"
        ],
        "only": true
      }
    },
    {
      "name": "windows-data",
      "summary": "the Windows QEMU data directory is not searched",
      "edits": [
        {
          "file": "tools/etude/deploy.sh",
          "find": "            windows*) RACH2_OVMF_CODE=${RACH2_OVMF_CODE:-${1%/*}/share/edk2-x86_64-code.fd} ;;",
          "replace": "            windows*) : ;;"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-deploy-test: failed: windows"
        ],
        "only": true
      }
    },
    {
      "name": "windows-posix-path",
      "summary": "Windows records an MSYS path that native QEMU cannot read",
      "edits": [
        {
          "file": "tools/etude/deploy.sh",
          "find": "            cygpath -m \"$OVMF_CODE\"\n",
          "replace": "            printf '%s\\n' \"$OVMF_CODE\"\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-deploy-test: failed: windows"
        ],
        "only": true
      }
    }
  ]
}
