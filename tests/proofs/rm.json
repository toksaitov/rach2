{
  "schema_version": 1,
  "proof": "rm",
  "summary": "rm_hosttest.c with one fault in a private copy of utils/rm.c",
  "tree": "private",
  "sources": [
    "utils/rm.c"
  ],
  "artifacts": [
    "${WORK}/rm_hosttest"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec ${CC:-cc} -std=c99 -D_DEFAULT_SOURCE -D_FORTIFY_SOURCE=0 -DRACH2_HOSTTEST -g -O1 -ffreestanding -Wall -Wextra -Werror -fsanitize=address,undefined -fno-sanitize-recover=all -I ${SRC}/utils tests/host/rm_hosttest.c -o ${WORK}/rm_hosttest"
    ],
    "bound_s": 300
  },
  "test": {
    "argv": [
      "${WORK}/rm_hosttest"
    ],
    "bound_s": 10,
    "fail_prefix": "rm-hosttest: fail: "
  },
  "faults": [
    {
      "name": "unguarded",
      "summary": "after a failed unlink, remove_recursive empties the operand as a directory without checking that it is one",
      "edits": [
        {
          "file": "utils/rm.c",
          "find": "    struct stat st;\n\n",
          "replace": ""
        },
        {
          "file": "utils/rm.c",
          "find": "    if (lstat(path, &st) < 0 || !S_ISDIR(st.st_mode)) {\n        return -1;\n    }\n",
          "replace": ""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "rm-hosttest: fail: denied operand preserves target contents"
        ]
      }
    }
  ]
}
