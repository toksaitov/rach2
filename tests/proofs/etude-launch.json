{
  "schema_version": 1,
  "proof": "etude-launch",
  "summary": "installed entry points observe durable claims before commands execute",
  "tree": "private",
  "sources": [
    "Makefile",
    "tests/run",
    "tools/etude/launch.sh",
    "tools/ci/run.sh",
    "tools/ci/bisect.sh",
    "tools/dev/testing.sh"
  ],
  "artifacts": [
    "${WORK}/tree/Makefile",
    "${WORK}/tree/tests/run",
    "${WORK}/tree/tools/etude/launch.sh",
    "${WORK}/tree/tools/ci/run.sh",
    "${WORK}/tree/tools/ci/bisect.sh",
    "${WORK}/tree/tools/dev/testing.sh"
  ],
  "build": {
    "argv": [
      "/usr/bin/env",
      "python3",
      "-c",
      "import shutil,sys; shutil.copytree(sys.argv[1],sys.argv[2],dirs_exist_ok=True)",
      "${SRC}",
      "${WORK}/tree"
    ],
    "bound_s": 10
  },
  "test": {
    "argv": [
      "/usr/bin/env",
      "ETUDE_LAUNCH_SOURCES=${WORK}/tree",
      "python3",
      "-B",
      "tests/system/etude_launch_test.py"
    ],
    "bound_s": 180
  },
  "faults": [
    {
      "name": "build-unclaimed",
      "summary": "build unclaimed",
      "edits": [
        {
          "file": "Makefile",
          "find": "ETUDE_WRAP := $(if $(filter $(ETUDE_SITE_FILE),$(ETUDE_ADMITTED)),,$(or $(wildcard $(ETUDE_SITE_FILE)),$(if $(filter undefined,$(origin ETUDE_SITE)),,$(ETUDE_SITE_FILE))))",
          "replace": "ETUDE_WRAP :="
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: build:"
        ]
      }
    },
    {
      "name": "worker-unclaimed",
      "summary": "worker unclaimed",
      "edits": [
        {
          "file": "tests/run",
          "find": "    exec \"$launcher\" legacy sh \"$0\" \"$@\"",
          "replace": "    :"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: worker:"
        ]
      }
    },
    {
      "name": "ci-unclaimed",
      "summary": "ci unclaimed",
      "edits": [
        {
          "file": "tools/ci/run.sh",
          "find": "    exec \"$launcher\" legacy sh \"$0\" \"$@\"",
          "replace": "    :"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: ci:"
        ]
      }
    },
    {
      "name": "owner-unclaimed",
      "summary": "owner unclaimed",
      "edits": [
        {
          "file": "tools/dev/testing.sh",
          "find": "    exec \"$launcher\" build bash -c \\\n",
          "replace": "    : \\\n"
