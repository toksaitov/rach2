          "find": "\nexec \"$bridge\" -i -p -d \"$locks\" -w \"$wait\" \"$ledger\" \\\n    \"launch:$nonce\" \"$(id -un)\" alone \"$capacity\" \"$capacity\" \"$seconds\" \"$environment\" \"$@\"",
          "replace": "\nexec \"$bridge\" -i -p -d \"$locks\" -w \"$wait\" \"$ledger\" \\\n    \"launch:$nonce\" \"$(id -un)\" alone \"4000,134217728,1048576\" \"$capacity\" \"$seconds\" \"$environment\" \"$@\""
        }
