      "edits": [
        {
          "file": "tools/dev/testing.sh",
          "find": "        printf \"'\"\n        printf '%s' \"$*\" | sed \"s/'/'\\\\\\\\''/g\"\n        printf \"'\\n\"\n",
          "replace": "        printf \"'%s'\\n\" \"$(printf '%s' \"$*\" | sed \"s/'/'\\\\\\\\''/g\")\"\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: owner:"
