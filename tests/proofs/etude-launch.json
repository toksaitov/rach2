      "edits": [
        {
          "file": "tools/etude/launch.sh",
          "find": "exec \"$bridge\" -i -p -d \"$locks\" -w \"$wait\" \"$ledger\"",
          "replace": "exec \"$bridge\" -p -d \"$locks\" -w \"$wait\" \"$ledger\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: owner:"
