{
  "schema_version": 1,
  "proof": "etude-launch",
  "summary": "installed entry points observe durable claims before commands execute",
  "tree": "private",
  "sources": [
    "Makefile",
    "tests/run",
    "tools/etude/launch.sh",
    "tools/ci/run.sh",
    "tools/ci/bisect.sh",
    "tools/dev/testing.sh",
    "tools/etude/make.sh"
  ],
  "artifacts": [
    "${WORK}/tree/Makefile",
    "${WORK}/tree/tests/run",
    "${WORK}/tree/tools/etude/launch.sh",
    "${WORK}/tree/tools/ci/run.sh",
    "${WORK}/tree/tools/ci/bisect.sh",
    "${WORK}/tree/tools/dev/testing.sh",
    "${WORK}/tree/tools/etude/make.sh"
  ],
  "build": {
    "argv": [
      "/usr/bin/env",
      "python3",
      "-c",
      "import shutil,sys; shutil.copytree(sys.argv[1],sys.argv[2],dirs_exist_ok=True)",
      "${SRC}",
      "${WORK}/tree"
    ],
    "bound_s": 10
  },
  "test": {
    "argv": [
      "/usr/bin/env",
      "ETUDE_LAUNCH_SOURCES=${WORK}/tree",
      "python3",
      "-B",
      "tests/system/etude_launch_test.py"
    ],
    "bound_s": 180
  },
  "faults": [
    {
      "name": "build-unclaimed",
      "summary": "build unclaimed",
      "edits": [
        {
          "file": "Makefile",
          "find": "ETUDE_WRAP := $(if $(filter $(ETUDE_SITE_FILE),$(ETUDE_ADMITTED)),,$(or $(wildcard $(ETUDE_SITE_FILE)),$(if $(filter undefined,$(origin ETUDE_SITE)),,$(ETUDE_SITE_FILE))))",
          "replace": "ETUDE_WRAP :="
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: build:"
        ]
      }
    },
    {
      "name": "worker-unclaimed",
      "summary": "worker unclaimed",
      "edits": [
        {
          "file": "tests/run",
          "find": "    exec \"$launcher\" legacy sh \"$0\" \"$@\"",
          "replace": "    :"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: worker:"
        ]
      }
    },
    {
      "name": "bisection-unclaimed",
      "summary": "bisection unclaimed",
      "edits": [
        {
          "file": "tools/ci/bisect.sh",
          "find": "        limited \"$site_launcher\" -r \"$log.bridge\" \"$launch_kind\" \"$@\"",
          "replace": "        limited \"$@\"; echo \"exited $?\" > \"$log.bridge\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: bisection:"
        ]
      }
    },
    {
      "name": "wrong-capacity",
      "summary": "wrong capacity",
      "edits": [
        {
          "file": "tools/etude/launch.sh",
          "find": "    resources=$processors,$memory,$disk",
          "replace": "    resources=$processors,$site_memory,$disk"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: build:"
        ]
      }
    },
    {
      "name": "missing-ports",
      "summary": "missing ports",
      "edits": [
        {
          "file": "tools/etude/launch.sh",
          "find": "exec \"$bridge\" -i -p -d \"$locks\" -w \"$wait\" \"$ledger\"",
          "replace": "exec \"$bridge\" -i -d \"$locks\" -w \"$wait\" \"$ledger\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: build:"
        ]
      }
    },
    {
      "name": "lost-input",
      "summary": "lost input",
      "edits": [
        {
          "file": "tools/etude/launch.sh",
          "find": "exec \"$bridge\" -i -p -d \"$locks\" -w \"$wait\" \"$ledger\"",
          "replace": "exec \"$bridge\" -p -d \"$locks\" -w \"$wait\" \"$ledger\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: owner:"
        ]
      }
    },
    {
      "name": "nested-claim",
      "summary": "nested claim",
      "edits": [
        {
          "file": "tools/etude/launch.sh",
          "find": "export ETUDE_ADMITTED RACH2_WORKERS RACH2_MEMORY_MIB",
          "replace": "export RACH2_WORKERS RACH2_MEMORY_MIB"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: build:"
        ]
      }
    },
    {
      "name": "incompatible-endpoint",
      "summary": "incompatible endpoint",
      "edits": [
        {
          "file": "tools/etude/launch.sh",
          "find": "*) refuse 'endpoint is disabled or incompatible'",
          "replace": "*) :"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: refusals:"
        ]
      }
    },
    {
      "name": "nested-signal",
      "summary": "a signalled nested command recorded as an ordinary exit",
      "edits": [
        {
          "file": "tools/etude/launch.sh",
          "find": "        if [ \"$status\" -ge 128 ]; then",
          "replace": "        if false; then"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: nested:"
        ]
      }
    },
    {
      "name": "nested-old-ports",
      "summary": "a nested old checkout run without offset support",
      "edits": [
        {
          "file": "tools/etude/launch.sh",
          "find": "if [ \"$kind\" = legacy ]; then",
          "replace": "if [ \"$kind\" = legacy ] && [ -z \"${ETUDE_ADMITTED:-}\" ]; then"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: nested:"
        ]
      }
    },
    {
      "name": "private-policy",
      "summary": "bisection uses a private hardware record instead of shared site limits",
      "edits": [
        {
          "file": "tools/ci/bisect.sh",
          "find": "if [ -e \"$site\" ] || [ -L \"$site\" ] || [ \"${ETUDE_SITE+x}\" = x ]; then",
          "replace": "if false; then"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: bisection:"
        ]
      }
    },
    {
      "name": "serialized-launches",
      "summary": "serialized launches",
      "edits": [
        {
          "file": "tools/etude/launch.sh",
          "find": "mode=shared",
          "replace": "mode=alone"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: build:"
        ]
      }
    },
    {
      "name": "ignored-serial",
      "summary": "ignored serial",
      "edits": [
        {
          "file": "tools/etude/launch.sh",
          "find": "$1 > half || $2 == \"serial\"",
          "replace": "$1 > half"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: concurrency:"
        ]
      }
    },
    {
      "name": "ignored-large",
      "summary": "ignored large",
      "edits": [
        {
          "file": "tools/etude/launch.sh",
          "find": "$1 > half || $2 == \"serial\"",
          "replace": "$2 == \"serial\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: concurrency:"
        ]
      }
    },
    {
      "name": "unbounded-build",
      "summary": "an old preparation builds without its admitted job limit",
      "edits": [
        {
          "file": "tools/etude/make.sh",
          "find": "        set -- \"$@\" \"-j$requested\"",
          "replace": "        :"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: job-limit:"
        ]
      }
    },
    {
      "name": "opaque-shell-alone",
      "summary": "a shell command takes the host alone",
      "edits": [
        {
          "file": "tools/etude/launch.sh",
          "find": "                run_share \"$RACH2_MEMORY_MIB\"",
          "replace": "                mode=alone"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: owner:"
        ]
      }
    },
    {
      "name": "opaque-legacy-alone",
      "summary": "an unreadable legacy command takes the host alone",
      "edits": [
        {
          "file": "tools/etude/launch.sh",
          "find": "*) run_share \"$RACH2_MEMORY_MIB\"; return ;;",
          "replace": "*) mode=alone; return ;;"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: legacy:"
        ]
      }
    },
    {
      "name": "scrubbed-budget",
      "summary": "a child with a cleared environment cannot run make",
      "edits": [
        {
          "file": "tools/etude/make.sh",
          "find": "    ETUDE_BUILD_JOBS=1",
          "replace": "    exit 2"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: job-limit:"
        ]
      }
    },
    {
      "name": "parallel-default",
      "summary": "a serial make starts parallel jobs without a request",
      "edits": [
        {
          "file": "tools/etude/make.sh",
          "find": "BEGIN { jobs = 1 }",
          "replace": "BEGIN { jobs = limit }"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-launch-test: failed: job-limit:"
        ]
      }
    }
  ]
}
