{
  "schema_version": 1,
  "proof": "password",
  "summary": "tests/system/accept/password_test.sh with three faults compiled into private builds of runner/ptydrive.c",
  "tree": "private",
  "sources": [
    "tests/system/runner/ptydrive.c"
  ],
  "artifacts": [
    "${WORK}/ptydrive"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec ${CC:-cc} -O2 -Wall -Wextra -Werror -o ${WORK}/ptydrive ${SRC}/tests/system/runner/ptydrive.c"
    ],
    "bound_s": 120
  },
  "test": {
    "argv": [
      "/usr/bin/env",
      "PTYDRIVE=${WORK}/ptydrive",
      "sh",
      "tests/system/accept/password_test.sh"
    ],
    "bound_s": 300
  },
  "faults": [
    {
      "name": "repeat",
      "summary": "a second prompt answered",
      "edits": [
        {
          "file": "tests/system/runner/ptydrive.c",
          "find": "                if (asked > 1) {\n",
          "replace": "                if (asked > 100) {\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the second prompt was answered"
        ]
      }
    },
    {
      "name": "redact",
      "summary": "the password written raw",
      "edits": [
        {
          "file": "tests/system/runner/ptydrive.c",
          "find": "static void secret_byte(struct secret_filter *filter, unsigned char byte)\n{\n",
          "replace": "static void secret_byte(struct secret_filter *filter, unsigned char byte)\n{\n    putchar(byte); return;\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "credential bytes reached raw"
        ]
      }
    },
    {
      "name": "count",
      "summary": "a wrong count of prompts",
      "edits": [
        {
          "file": "tests/system/runner/ptydrive.c",
          "find": "    printf(\"\\nPROMPTED=%d\\nANSWERED=%d\\n\", asked, answered);\n",
          "replace": "    printf(\"\\nPROMPTED=%d\\nANSWERED=%d\\n\", (asked != 0), answered);\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "prompt or answer count is wrong"
        ]
      }
    }
  ]
}
