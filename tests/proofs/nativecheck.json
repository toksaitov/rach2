{
  "schema_version": 1,
  "proof": "nativecheck",
  "summary": "nativecheck_test.sh against a private copy of tools/verify/nativecheck.sh, each fault failing the row of what it lets pass",
  "tree": "private",
  "sources": [
    "tools/verify/nativecheck.sh"
  ],
  "artifacts": [
    "${WORK}/nativecheck.sh"
  ],
  "build": {
    "argv": [
      "/bin/cp",
      "${SRC}/tools/verify/nativecheck.sh",
      "${WORK}/nativecheck.sh"
    ],
    "bound_s": 10
  },
  "test": {
    "argv": [
      "/usr/bin/env",
      "NATIVECHECK=${WORK}/nativecheck.sh",
      "sh",
      "tests/system/nativecheck_test.sh"
    ],
    "bound_s": 120
  },
  "faults": [
    {
      "name": "both",
      "summary": "a program with both a case and a reason passed",
      "edits": [
        {
          "file": "tools/verify/nativecheck.sh",
          "find": "if (p in cased && p in machine) fail(",
          "replace": "if (0) fail("
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "nativecheck-test: a program with a case and a reason: expected 1, got 0"
        ]
      }
    },
    {
      "name": "ids",
      "summary": "an id that maps lacks passed",
      "edits": [
        {
          "file": "tools/verify/nativecheck.sh",
          "find": "if (kind == \"id\" && !(item[i] in idnew))",
          "replace": "if (0)"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "nativecheck-test: an id that maps lacks: expected 1, got 0"
        ]
      }
    },
    {
      "name": "type",
      "summary": "a volume of another type than its image passed",
      "edits": [
        {
          "file": "tools/verify/nativecheck.sh",
          "find": "else if (imagetype[p[3]] != p[2])",
          "replace": "else if (0)"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "nativecheck-test: a volume of another type than its image: expected 1, got 0"
        ]
      }
    },
    {
      "name": "loops",
      "summary": "a fifth volume passed",
      "edits": [
        {
          "file": "tools/verify/nativecheck.sh",
          "find": "if (volumes > 4)",
          "replace": "if (volumes > 5)"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "nativecheck-test: more volumes than loop devices: expected 1, got 0"
        ]
      }
    }
  ]
}
