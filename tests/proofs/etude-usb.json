{
  "schema_version": 1,
  "proof": "etude-usb",
  "summary": "USB devices, their drives and a machine without the 8042 reach QEMU, and devices QEMU could not take are refused",
  "tree": "private",
  "sources": [
    "tools/etude/qemu_profile.c"
  ],
  "artifacts": [
    "${WORK}/test"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec ${CC:-cc} -std=c99 -D_DEFAULT_SOURCE -D_FORTIFY_SOURCE=0 -DRACH2_HOSTTEST -O1 -fsanitize=address,undefined -fno-sanitize-recover=all -I tests/host -I tools/etude/include -I tools/etude -I tools/etude/posix -I tools/etude/guest -I utils tests/host/etude_qemu_hosttest.c tools/etude/capture.c tools/etude/history_json.c ${SRC}/tools/etude/qemu_profile.c tools/etude/posix/exec.c tools/etude/posix/keeper.c tools/etude/posix/process.c tools/etude/posix/qemu.c tools/etude/processor.c -o ${WORK}/test"
    ],
    "bound_s": 120
  },
  "test": {
    "argv": [
      "${WORK}/test",
      "--usb"
    ],
    "bound_s": 60
  },
  "faults": [
    {
      "name": "i8042-kept",
      "summary": "the 8042 kept",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "add(&l, 0, \"i8042=off\");",
          "replace": "add(&l, 0, \"i8042=on\");"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the usb command line is"
        ]
      }
    },
    {
      "name": "drive-on-ide",
      "summary": "a drive put on IDE",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "\"file=%%s,format=raw,if=none,id=%s%s\", d->id, discard",
          "replace": "\"file=%%s,format=raw,if=ide,id=%s%s\", d->id, discard"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the usb command line is"
        ]
      }
    },
    {
      "name": "member-omitted",
      "summary": "a device's bus omitted",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "\"bus\", d->bus, \"port\"",
          "replace": "\"bus\", NULL, \"port\""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "the usb command line is"
        ]
      }
    },
    {
      "name": "bus-unchecked",
      "summary": "a bus unchecked",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "(d[i].bus != NULL && !bus_ok(d, i, d[i].bus))",
          "replace": "0"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "a bus no device provides"
        ]
      }
    },
    {
      "name": "port-unchecked",
      "summary": "a port unchecked",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "(d[i].port != NULL && !usb_port(d[i].port))",
          "replace": "0"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "port 0"
        ]
      }
    },
    {
      "name": "drive-unchecked",
      "summary": "a drive unchecked",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "(d[i].drive != NULL && !drive_ok(p, i, d[i].drive))",
          "replace": "0"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "a drive the profile lacks"
        ]
      }
    },
    {
      "name": "property-unchecked",
      "summary": "a property the launcher sets accepted",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "listed(set_members, d->properties[i])",
          "replace": "0"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "a property the launcher sets"
        ]
      }
    },
    {
      "name": "device-boots",
      "summary": "a disk on a device that boots first accepted",
      "edits": [
        {
          "file": "tools/etude/qemu_profile.c",
          "find": "d->serial != NULL || d->boot)",
          "replace": "d->serial != NULL)"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "a disk on a device that boots first"
        ]
      }
    }
  ]
}
