{
  "schema_version": 1,
  "proof": "etude-kvm-deploy",
  "summary": "deployment advertises KVM only when its device opens for reading and writing",
  "tree": "private",
  "sources": [
    "tools/etude/deploy.sh"
  ],
  "artifacts": [
    "${WORK}/deploy.sh"
  ],
  "build": {
    "argv": [
      "/bin/cp",
      "${SRC}/tools/etude/deploy.sh",
      "${WORK}/deploy.sh"
    ],
    "bound_s": 30
  },
  "test": {
    "argv": [
      "/bin/sh",
      "-c",
      "ETUDE_DEPLOY_SOURCE=${WORK}/deploy.sh exec sh tests/system/etude_deploy_test.sh --kvm"
    ],
    "bound_s": 120,
    "fail_prefix": "etude-deploy-test: failed: "
  },
  "faults": [
    {
      "name": "permission-only",
      "summary": "a readable and writable device is advertised without opening it",
      "edits": [
        {
          "file": "tools/etude/deploy.sh",
          "find": "                ( : <> /dev/kvm ) 2>/dev/null && a='kvm ' ;;",
          "replace": "                a='kvm ' ;;"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-deploy-test: failed: kvm-unavailable"
        ],
        "only": true
      }
    },
    {
      "name": "no-kvm",
      "summary": "a device that opens is not advertised",
      "edits": [
        {
          "file": "tools/etude/deploy.sh",
          "find": "2>/dev/null && a='kvm ' ;;",
          "replace": "2>/dev/null && a='' ;;"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "etude-deploy-test: failed: kvm-open"
        ],
        "only": true
      }
    }
  ]
}
