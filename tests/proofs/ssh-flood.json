{
  "schema_version": 1,
  "proof": "ssh-flood",
  "summary": "ssh_flood_test.sh against a private copy of the SSH suite whose flood_start does not record the process ID of a holder's sleep",
  "tree": "private",
  "sources": [
    "tests/system/suites/ssh.sh"
  ],
  "artifacts": [
    "${WORK}/ssh.sh"
  ],
  "build": {
    "argv": [
      "/bin/cp",
      "${SRC}/tests/system/suites/ssh.sh",
      "${WORK}/ssh.sh"
    ],
    "bound_s": 10
  },
  "test": {
    "argv": [
      "/usr/bin/env",
      "SSH_SUITE=${WORK}/ssh.sh",
      "TMPDIR=${WORK}",
      "sh",
      "tests/system/ssh_flood_test.sh"
    ],
    "bound_s": 120
  },
  "faults": [
    {
      "name": "missing-sleep",
      "summary": "flood_start does not record the process ID of a holder's sleep, which must leave children",
      "edits": [
        {
          "file": "tests/system/suites/ssh.sh",
          "find": "        (exec sleep 300 > \"$flood_fifo\") &\n        FLOOD_PIDS=\"$FLOOD_PIDS $!\"\n",
          "replace": "        (exec sleep 300 > \"$flood_fifo\") &\n         :\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "ssh-flood: fixed success left pid "
        ]
      }
    }
  ]
}
