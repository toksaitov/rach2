{
  "schema_version": 1,
  "proof": "release-resume",
  "summary": "release_resume_test.sh against private copies of tools/flow/release.sh, each fault failing a row of its own",
  "tree": "private",
  "sources": [
    "tools/flow/release.sh"
  ],
  "artifacts": [
    "${WORK}/release.sh"
  ],
  "build": {
    "argv": [
      "/bin/cp",
      "${SRC}/tools/flow/release.sh",
      "${WORK}/release.sh"
    ],
    "bound_s": 10
  },
  "test": {
    "argv": [
      "/usr/bin/env",
      "RELEASE_SH=${WORK}/release.sh",
      "sh",
      "tests/system/release_resume_test.sh"
    ],
    "bound_s": 600,
    "fail_prefix": "release-test: failed: "
  },
  "faults": [
    {
      "name": "undone",
      "summary": "no step counts as done",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "    grep -q \"^$1 done \" \"$state/record\"\n",
          "replace": "    false\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: all-done"
        ]
      }
    },
    {
      "name": "full",
      "summary": "a done full run is applied again",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "    done_ full || full\n",
          "replace": "    full\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: full-done"
        ]
      }
    },
    {
      "name": "aside",
      "summary": "an ended record is copied aside before the board is read",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "    fi\n    if [ -n \"$old\" ] || [ ! -f \"$state/record\" ]; then\n",
          "replace": "    fi\n    [ -z \"$old\" ] || cp \"$state/record\" \"$state/$old-early\"\n    if [ -n \"$old\" ] || [ ! -f \"$state/record\" ]; then\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: void-waits"
        ]
      }
    },
    {
      "name": "touched",
      "summary": "the new record drops the `touched` line",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "                grep '^touched ' \"$state/record\" | tail -n 1\n",
          "replace": "                :\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: void-aside"
        ]
      }
    },
    {
      "name": "started",
      "summary": "an ended record with `install started` is replaced",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "        if grep -q '^install started ' \"$state/record\" &&\n",
          "replace": "        if false &&\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: install-stops"
        ]
      }
    },
    {
      "name": "reboot",
      "summary": "a machine running its system after the installer started is sent to recovery",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "                ! grep -q '^install started ' \"$state/record\" ||\n",
          "replace": "                true ||\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: install-reboot"
        ]
      }
    },
    {
      "name": "unrecorded",
      "summary": "the record step is skipped once the acceptance is done",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "    if ! done_ record; then\n",
          "replace": "    if ! done_ accept; then\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: record-write"
        ]
      }
    },
    {
      "name": "unsynced",
      "summary": "the status of the machine's write and flush is ignored",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "            'status 0') ;;\n",
          "replace": "            status*) ;;\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: record-unsynced"
        ]
      }
    },
    {
      "name": "unread",
      "summary": "the record is not read back",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "        [ \"$(printf '%s\\n' \"$have\" | sed '$d')\" = \"$want\" ] ||\n",
          "replace": "        true ||\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: record-refused"
        ]
      }
    },
    {
      "name": "closing",
      "summary": "the phase of a record with `closing` is ignored",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "        phase=$(sed -n 's/^phase //p' \"$state/record\")\n",
          "replace": "        :\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: closing-other"
        ]
      }
    },
    {
      "name": "ready",
      "summary": "an open phase is closed without its readiness checked again",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "    if [ \"$issue_state\" != CLOSED ]; then\n        why=$(still_ready)\n",
          "replace": "    if [ \"$issue_state\" != CLOSED ]; then\n        why=; true\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: closing-unready"
        ]
      }
    },
    {
      "name": "chosen",
      "summary": "a rerun is never chosen",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "        [ -z \"$old\" ] || rerun=$(again)\n",
          "replace": "        :\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: rerun-chosen"
        ]
      }
    },
    {
      "name": "unclosed",
      "summary": "a commit that closes nothing is taken for a fix",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "        [ -n \"$closes\" ] || return 0\n",
          "replace": "        :\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: rerun-other"
        ]
      }
    },
    {
      "name": "closes",
      "summary": "a commit that closes another issue is taken for a fix",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "            case \" $issues \" in *\" $n \"*) ;; *) return 0 ;; esac\n",
          "replace": "            :\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: rerun-unfixed"
        ]
      }
    },
    {
      "name": "arches",
      "summary": "an architecture that failed with no issue is ignored",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "        case \" $arches \" in *\" $a \"*) ;; *) return 0 ;; esac\n",
          "replace": "        :\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: rerun-unfiled"
        ]
      }
    },
    {
      "name": "suites",
      "summary": "a rerun is started for every suite",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "        [ -z \"$only\" ] || set -- \"$@\" -f suites=\"$only\"\n",
          "replace": "        :\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: rerun-dispatch"
        ]
      }
    },
    {
      "name": "open",
      "summary": "an issue of a failure that is still open is taken for a fix",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "^CLOSED Release tests fail on",
          "replace": "^[A-Z]* Release tests fail on"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: rerun-open"
        ]
      }
    },
    {
      "name": "moved",
      "summary": "a change of the machine that the site selects for the tests is ignored",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "        here=$(site \"$sha\") && [ \"$(site \"$o\")\" = \"$here\" ] || return 0\n",
          "replace": "        true || return 0\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: rerun-moved"
        ]
      }
    },
    {
      "name": "stale",
      "summary": "the new record keeps the failed run of the old one",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "                grep '^touched ' \"$state/record\" | tail -n 1\n",
          "replace": "                grep -e \"^touched \" -e \"^run \" \"$state/record\"\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: intermittent"
        ]
      }
    },
    {
      "name": "partial",
      "summary": "a full run is given the suites of a rerun",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "        [ -z \"$only\" ] || set -- \"$@\" -f suites=\"$only\"\n",
          "replace": "        set -- \"$@\" -f suites=\"$only\"\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: full-every"
        ]
      }
    },
    {
      "name": "unclean",
      "summary": "the build for the Lenovo keeps the last build's objects",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "\"ARCH=x86_64 make clean && ARCH=x86_64 make machine",
          "replace": "\"ARCH=x86_64 make machine"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: build-clean"
        ]
      }
    },
    {
      "name": "unaccepted",
      "summary": "the status of metal_accept.sh is ignored",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "        sh tests/system/accept/metal_accept.sh \"$address\" > \"$state/accept.log\" 2>&1 ||\n",
          "replace": "        sh tests/system/accept/metal_accept.sh \"$address\" > \"$state/accept.log\" 2>&1 || true ||\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: accept-fail"
        ]
      }
    },
    {
      "name": "uncommitted",
      "summary": "the candidate is not committed after the acceptance",
      "edits": [
        {
          "file": "tools/flow/release.sh",
          "find": "        lenovo 'bootctl commit' >",
          "replace": "        echo \"bootctl: committed: candidate\" >"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "release-test: failed: accept-pass"
        ]
      }
    }
  ]
}
