{
  "schema_version": 1,
  "proof": "persist",
  "summary": "the cases of tests/run persist and persist-ahci under etude, against a page cache whose sync writes no page back",
  "tree": "shared",
  "sources": [
    "rach2/sys/mm/pagecache.c"
  ],
  "artifacts": [
    "${WORK}/kernel"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "sh tests/proofs/guest.sh make rach2 tests && sh tests/proofs/guest.sh copy ${WORK} rach2/kernel"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec tests/run persist persist-ahci </dev/null"
    ],
    "bound_s": 3600
  },
  "faults": [
    {
      "name": "no-writeback",
      "summary": "the page cache's sync writes no dirty page back to the disk",
      "edits": [
        {
          "file": "rach2/sys/mm/pagecache.c",
          "find": "        } else if (pc_writeback(e) != 0) {\n",
          "replace": "        } else if (0 && pc_writeback(e) != 0) {\n"
        }
      ],
      "fails": {
        "lines": [
          "run: persist: FAIL",
          "run: persist-ahci: FAIL",
          "assert found fail"
        ],
        "status": 1
      }
    }
  ]
}
