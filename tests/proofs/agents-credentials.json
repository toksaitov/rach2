{
  "schema_version": 1,
  "proof": "agents-credentials",
  "summary": "agents_credentials_test.py against private copies of tests/system/accept/agents_guest.sh, each fault failing its test",
  "tree": "private",
  "sources": [
    "tests/system/accept/agents_guest.sh"
  ],
  "artifacts": [
    "${WORK}/agents_guest.sh"
  ],
  "build": {
    "argv": [
      "/bin/cp",
      "${SRC}/tests/system/accept/agents_guest.sh",
      "${WORK}/agents_guest.sh"
    ],
    "bound_s": 10
  },
  "test": {
    "argv": [
      "/usr/bin/env",
      "AGENTS_GUEST=${WORK}/agents_guest.sh",
      "python3",
      "-B",
      "tests/system/agents_credentials_test.py"
    ],
    "bound_s": 300
  },
  "faults": [
    {
      "name": "omitted",
      "summary": "Antigravity's OAuth token not listed",
      "edits": [
        {
          "file": "tests/system/accept/agents_guest.sh",
          "find": "agy) printf '%s\\n' \"$HOME/.gemini/antigravity-cli/antigravity-oauth-token\" ;;",
          "replace": "agy) : ;;"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "FAIL: test_antigravity_scan "
        ]
      }
    },
    {
      "name": "selection",
      "summary": "every agent scanned whatever was asked",
      "edits": [
        {
          "file": "tests/system/accept/agents_guest.sh",
          "find": "for agent in \"$@\"; do",
          "replace": "for agent in claude codex agy muse; do"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "FAIL: test_selected_credentials "
        ]
      }
    },
    {
      "name": "arguments",
      "summary": "the arguments of a process redacted with every agent's credentials",
      "edits": [
        {
          "file": "tests/system/accept/agents_guest.sh",
          "find": "    awk '\n        function cut(",
          "replace": "    awk -v list=\"$(credential_strings all)\" '\n        function cut("
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "FAIL: test_redact_arguments "
        ]
      }
    }
  ]
}
