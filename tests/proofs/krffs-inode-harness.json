{
  "schema_version": 1,
  "proof": "krffs-inode-harness",
  "summary": "the harness's --selftest of its last search of an exited guest's output, with a fault in a private copy of tests/system/runner/harness.c",
  "tree": "private",
  "sources": [
    "tests/system/runner/harness.c"
  ],
  "artifacts": [
    "${WORK}/harness"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec ${CC:-cc} -O2 -Wall -Wextra -Werror ${SRC}/tests/system/runner/harness.c -o ${WORK}/harness"
    ],
    "bound_s": 600
  },
  "test": {
    "argv": [
      "${WORK}/harness",
      "--selftest"
    ],
    "bound_s": 120
  },
  "faults": [
    {
      "name": "harness",
      "summary": "the search of an exited child's output without the drain of the pipe before it",
      "edits": [
        {
          "file": "tests/system/runner/harness.c",
          "find": "    if (child_poll() >= 0)\n        drain_ready();\n",
          "replace": ""
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "returned 0, wanted 1"
        ]
      }
    }
  ]
}
