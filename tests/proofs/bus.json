{
  "schema_version": 1,
  "proof": "bus",
  "summary": "the cases of tests/run bus under etude, against an ATA driver that sends a slave's transfers to its channel's master, one that gives every transfer the 28-bit form, one that probes the primary channel alone, a root search that takes an MBR id for any disk's, and one that looks for the root on disk 0 alone",
  "tree": "shared",
  "sources": [
    "rach2/sys/block/ata.c",
    "rach2/kernel.c"
  ],
  "artifacts": [
    "${WORK}/kernel"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "sh tests/proofs/guest.sh make rach2 && sh tests/proofs/guest.sh copy ${WORK} rach2/kernel"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec tests/run bus </dev/null"
    ],
    "bound_s": 3600
  },
  "faults": [
    {
      "name": "slave-as-master",
      "summary": "a transfer to a slave drive selects its channel's master, so the slave's writes reach the master",
      "edits": [
        {
          "file": "rach2/sys/block/ata.c",
          "find": "    uint8_t slave = d->slave ? ATA_DRIVE_SLAVE : 0;",
          "replace": "    uint8_t slave = 0;"
        }
      ],
      "fails": {
        "lines": [
          "run: bus: FAIL",
          "run: bus: machine.bus.four: evidence: ",
          "assert ps-file fail",
          "assert ss-file fail"
        ],
        "status": 1
      }
    },
    {
      "name": "lba28-only",
      "summary": "every transfer takes the 28-bit form, whose address wraps past sector 2^28",
      "edits": [
        {
          "file": "rach2/sys/block/ata.c",
          "find": "    if (lba + count <= ATA_LBA28_SECTORS) {",
          "replace": "    if (1) {"
        }
      ],
      "fails": {
        "lines": [
          "run: bus: FAIL",
          "run: bus: machine.bus.big: evidence: ",
          "assert far-partition fail",
          "assert far-file fail"
        ],
        "status": 1
      }
    },
    {
      "name": "primary-only",
      "summary": "the ATA driver probes the primary channel and never the secondary",
      "edits": [
        {
          "file": "rach2/sys/block/ata.c",
          "find": "    ata_native_ports();\n    for (c = 0; c < 2; c++) {",
          "replace": "    ata_native_ports();\n    for (c = 0; c < 1; c++) {"
        }
      ],
      "fails": {
        "lines": [
          "run: bus: FAIL",
          "run: bus: machine.bus.four: evidence: ",
          "assert four-drives fail",
          "assert sm-record fail",
          "assert ss-record fail",
          "assert ss-file fail"
        ],
        "status": 1
      }
    },
    {
      "name": "any-mbr-id",
      "summary": "the root search takes an MBRID= identity for any MBR disk's, so both disks match it",
      "edits": [
        {
          "file": "rach2/kernel.c",
          "find": "               d->table.mbr_id == id && e->number == spec_entry_number(spec + 14);",
          "replace": "               e->number == spec_entry_number(spec + 14);"
        }
      ],
      "fails": {
        "lines": [
          "run: bus: FAIL",
          "run: bus: machine.bus.ide-root: evidence: ",
          "run: bus: machine.bus.ahci-root: evidence: ",
          "assert root-record fail"
        ],
        "status": 1
      }
    },
    {
      "name": "root-on-disk0",
      "summary": "the root search looks at disk 0 alone, so a root on the disk the kernel numbers 1 is not found",
      "edits": [
        {
          "file": "rach2/kernel.c",
          "find": "    for (i = 0; i < disk_count(); i++) {",
          "replace": "    for (i = 0; i < disk_count() && i < 1; i++) {"
        }
      ],
      "fails": {
        "lines": [
          "run: bus: FAIL",
          "run: bus: machine.bus.ide-root: evidence: ",
          "assert root-record fail",
          "assert blockprobe-ok fail"
        ],
        "status": 1
      }
    }
  ]
}
