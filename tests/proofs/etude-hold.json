{
  "schema_version": 1,
  "proof": "etude-hold",
  "summary": "etude-hold's test finds a hold that skips an ancestor, takes over what it must refuse, or keeps no lock",
  "tree": "private",
  "sources": [
    "tools/etude/hold.h",
    "tools/etude/etude_hold.c",
    "tools/etude/posix/hold.c",
    "tests/host/etude_hold_hosttest.c"
  ],
  "artifacts": [
    "${WORK}/etude_hold_hosttest"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec ${CC:-cc} -std=c99 -D_DEFAULT_SOURCE -D_FORTIFY_SOURCE=0 -DRACH2_HOSTTEST -Wall -Wextra -Werror -g -O1 -fsanitize=address,undefined -fno-sanitize-recover=all -I tools/etude -I tests/host -I tests/host/compat ${SRC}/tests/host/etude_hold_hosttest.c ${SRC}/tools/etude/posix/hold.c -o ${WORK}/etude_hold_hosttest"
    ],
    "bound_s": 120
  },
  "test": {
    "argv": [
      "${WORK}/etude_hold_hosttest"
    ],
    "bound_s": 120,
    "fail_prefix": "etude-hold-test: fail:"
  },
  "faults": [
    {
      "name": "ancestor-unwalked",
      "summary": "The helper looks for the holder in itself alone and takes the tree from under its ancestor",
      "edits": [
        {
          "file": "tools/etude/etude_hold.c",
          "find": "        if (pid == held)\n",
          "replace": "        if (pid == held && depth == 0)\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "ancestor: "
        ],
        "only": true
      }
    },
    {
      "name": "fault-hold-taken",
      "summary": "A fault script's hold that was left is treated as a run's",
      "edits": [
        {
          "file": "tools/etude/etude_hold.c",
          "find": "    if (r.held)\n",
          "replace": "    if (0)\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "left-fault",
          "ancestor: a hold of a process that is not an ancestor"
        ],
        "only": true
      }
    },
    {
      "name": "survivors-ignored",
      "summary": "A run's hold is taken over while its work still runs",
      "edits": [
        {
          "file": "tools/etude/etude_hold.c",
          "find": "    if (n > 0) {\n",
          "replace": "    if (0) {\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "survivors"
        ],
        "only": true
      }
    },
    {
      "name": "run-hold-held",
      "summary": "A run's hold is recorded as a fault script's, which no run takes over",
      "edits": [
        {
          "file": "tools/etude/etude_hold.c",
          "find": "    if (!h->run)\n",
          "replace": "    if (1)\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "run hold"
        ],
        "only": true
      }
    },
    {
      "name": "kill-released",
      "summary": "The lock goes after a command killed with KILL",
      "edits": [
        {
          "file": "tools/etude/etude_hold.c",
          "find": "    if (status == 137) {\n",
          "replace": "    if (0) {\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "killed: "
        ],
        "only": true
      }
    },
    {
      "name": "guard-unlocked",
      "summary": "The helper takes the tree without its record lock",
      "edits": [
        {
          "file": "tools/etude/posix/hold.c",
          "find": "    if (fcntl(fd, F_SETLK, &lock) == 0)\n",
          "replace": "    if (1)\n"
        }
      ],
      "fails": {
        "status": 1,
        "lines": [
          "busy: "
        ],
        "only": true
      }
    }
  ]
}
