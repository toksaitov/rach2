{
  "schema_version": 1,
  "proof": "probe-suidmusl",
  "summary": "the row of suidmusl in the default suite, with faults in the kernel",
  "tree": "shared",
  "sources": [
    "rach2/sys/syscall_proc.c",
    "rach2/sys/proc/ptrace.c"
  ],
  "artifacts": [
    "${WORK}/kernel"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "sh tests/proofs/guest.sh make rach2 test-image && sh tests/proofs/guest.sh copy ${WORK} rach2/kernel"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "tests/proofs/guest.sh",
      "default",
      "suidmusl"
    ],
    "bound_s": 900,
    "fail_prefix": "guest: fail: "
  },
  "faults": [
    {
      "name": "exec-setid-ignored",
      "summary": "execve",
      "edits": [
        {
          "file": "rach2/sys/syscall_proc.c",
          "find": "    uint32_t mode = current_proc->no_new_privs ? 0u : s->id.mode;\n",
          "replace": "    uint32_t mode = 0u;\n"
        }
      ],
      "fails": {
        "lines": [
          "SUIDMUSL FAIL (child status)",
          "guest: fail: suidmusl did not pass"
        ]
      }
    },
    {
      "name": "exec-root-tracer-suppresses",
      "summary": "execve",
      "edits": [
        {
          "file": "rach2/sys/syscall_proc.c",
          "find": "    return (current_proc->ptrace & PT_TRACED) && !ptrace_tracer_privileged(current_proc);\n",
          "replace": "    return (current_proc->ptrace & PT_TRACED) != 0;\n"
        }
      ],
      "fails": {
        "lines": [
          "SUIDMUSL FAIL (the exec traced by root)",
          "guest: fail: suidmusl did not pass"
        ]
      }
    },
    {
      "name": "exec-user-tracer-gains",
      "summary": "execve",
      "edits": [
        {
          "file": "rach2/sys/proc/ptrace.c",
          "find": "    return tracer != NULL && group_privileged(tracer->tg);\n",
          "replace": "    return tracer != NULL;\n"
        }
      ],
      "fails": {
        "lines": [
          "SUIDMUSL FAIL (the exec traced by uid 1000)",
          "guest: fail: suidmusl did not pass"
        ]
      }
    },
    {
      "name": "exec-shared-fs-gains",
      "summary": "execve",
      "edits": [
        {
          "file": "rach2/sys/syscall_proc.c",
          "find": "        if (t->tg == current_proc->tg && t->fs == current_proc->fs) {\n",
          "replace": "        if (t->fs == current_proc->fs) {\n"
        }
      ],
      "fails": {
        "lines": [
          "SUIDMUSL FAIL (the exec whose directories uid 1000 shares)",
          "guest: fail: suidmusl did not pass"
        ]
      }
    },
    {
      "name": "exec-xonly-dumpable",
      "summary": "execve",
      "edits": [
        {
          "file": "rach2/sys/syscall_proc.c",
          "find": "    s->unreadable = !s->prog.readable;\n",
          "replace": "    s->unreadable = 0;\n"
        }
      ],
      "fails": {
        "lines": [
          "SUIDMUSL FAIL (the execute-only copy is dumpable)",
          "guest: fail: suidmusl did not pass"
        ]
      }
    },
    {
      "name": "peek-nondumpable",
      "summary": "rows the close added or strengthened: probe rows the review found weak, the alternate stack, a tracer's view of an image an exec made not dumpable, the ptrace waits bounded for their proofs, and the faults the close's first boots found",
      "edits": [
        {
          "file": "rach2/sys/proc/ptrace.c",
          "find": "    if (!mm || (!proc_privileged(current_proc) && !mm->dumpable)) {\n",
          "replace": "    if (!mm) {\n"
        }
      ],
      "fails": {
        "lines": [
          "SUIDMUSL FAIL (a uid 1000 tracer read the execute-only copy)",
          "guest: fail: suidmusl did not pass"
        ]
      }
    }
  ]
}
