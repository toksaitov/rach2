{
  "schema_version": 1,
  "proof": "diskpolicy",
  "summary": "the cases of tests/run diskpolicy under etude, against a read-only policy that allows every command, and a check_diskpolicy.sh that takes any policy banner for the one asked and never looks for the other",
  "tree": "shared",
  "sources": [
    "rach2/sys/block/diskcmd.c",
    "tools/inspect/check_diskpolicy.sh"
  ],
  "artifacts": [
    "${WORK}/kernel",
    "${WORK}/check_diskpolicy.sh"
  ],
  "build": {
    "argv": [
      "/bin/sh",
      "-c",
      "sh tests/proofs/guest.sh make rach2-metal && sh tests/proofs/guest.sh copy ${WORK} rach2-metal/kernel && cp tools/inspect/check_diskpolicy.sh ${WORK}/"
    ],
    "bound_s": 3600
  },
  "test": {
    "argv": [
      "/bin/sh",
      "-c",
      "exec tests/run diskpolicy </dev/null"
    ],
    "bound_s": 3600
  },
  "faults": [
    {
      "name": "allow-all",
      "summary": "the read-only policy allows every command, so the read-only kernel's mount writes the disk",
      "edits": [
        {
          "file": "rach2/sys/block/diskcmd.c",
          "find": "    case DISKCMD_IDENTIFY:\n        return 1;\n    default:\n        return 0;",
          "replace": "    case DISKCMD_IDENTIFY:\n        return 1;\n    default:\n        return 1;"
        }
      ],
      "fails": {
        "lines": [
          "run: diskpolicy: FAIL",
          "assert ro-refused fail",
          "assert ro-unchanged fail"
        ],
        "status": 1
      }
    },
    {
      "name": "any-banner",
      "summary": "check_diskpolicy.sh accepts a kernel with either banner and does not look for the other",
      "edits": [
        {
          "file": "tools/inspect/check_diskpolicy.sh",
          "find": "\"$BINFIND\" \"rach2: disk policy: $POLICY\" \"$KERNEL\" || {",
          "replace": "\"$BINFIND\" \"rach2: disk policy: \" \"$KERNEL\" || {"
        },
        {
          "file": "tools/inspect/check_diskpolicy.sh",
          "find": "if \"$BINFIND\" \"rach2: disk policy: $OTHER\" \"$KERNEL\"; then",
          "replace": "if false; then"
        }
      ],
      "fails": {
        "lines": [
          "run: diskpolicy: FAIL",
          "assert read-write-refused fail",
          "assert read-only-refused fail"
        ],
        "status": 1
      }
    }
  ]
}
