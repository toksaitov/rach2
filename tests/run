#!/usr/bin/env sh
#
# tests/run: the one way to run a test suite.
#
#   tests/run NAME              one suite
#   tests/run NAME NAME...      those suites, at the same time
#   tests/run core              the tier `make test` runs
#   tests/run all               every suite
#
# The suites themselves live in tests/system/suites.mk, one `run-NAME` target
# each; tests/registry lists their names, the external commands they need, and
# which tier they belong to. This file decides only what runs, when, and how a
# failure is reported.
#
set -u

REPO=$(cd "$(dirname "$0")/.." && pwd)
# e2fsprogs, where a package manager keeps it off the path; the suites that
# name mke2fs or e2fsck find them where the build does.
. "$REPO/tools/setup/e2fsprogs_path.sh"
REGISTRY="$REPO/tests/registry"
[ -f "$REGISTRY" ] || { echo "run: missing $REGISTRY" >&2; exit 1; }

# How many suites run at once. A suite spends most of its life waiting for an
# emulated machine rather than computing, so the useful count is above the
# core count: on a ten-core machine the full run takes 1286s at four workers,
# 728 at eight, 587 at twelve, 527 at sixteen and 499 at twenty, and stops
# improving there. Twice the processors lands on that knee.
workers_default() {
    n=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
    case "$n" in ''|*[!0-9]*) n=4 ;; esac
    n=$((n * 2))
    [ "$n" -lt 4 ] && n=4
    echo "$n"
}
WORKERS="${RACH2_WORKERS:-$(workers_default)}"
case "$WORKERS" in
    ''|*[!0-9]*) echo "run: RACH2_WORKERS must be a positive whole number" >&2; exit 2 ;;
esac
# `00` is digits and is zero, and a pool of zero waits for a worker that never
# frees. The value is compared as a number from here on, so it is made one.
WORKERS=$((WORKERS + 0))
[ "$WORKERS" -ge 1 ] || { echo "run: RACH2_WORKERS must be a positive whole number" >&2; exit 2; }

# Scratch for this run: one ledger per suite, the held output of each pooled
# suite, and the shim that writes the ledgers.
WORK=$(mktemp -d "${TMPDIR:-/tmp}/rach2-run.XXXXXX")
# Checked because everything below builds a path on it: an empty value would
# put the shim at /bin/qemu-system-i386 and delete / on the way out.
[ -d "$WORK" ] || { echo "run: no scratch directory" >&2; exit 1; }
trap 'rm -rf "$WORK"' EXIT INT TERM HUP

# Each suite names the machines it starts, so a leaked one can be blamed on the
# suite that left it. Listing every QEMU on the host works only while one suite
# runs at a time; with twenty running, each would see the other nineteen. So a
# shim named `qemu-system-i386` goes first on PATH, writes its own pid to the
# ledger of the suite that is running, and then becomes the real QEMU. The
# harness reaches QEMU through execvp and the shell suites through their own
# PATH lookup, so this covers both without either knowing about it.
QEMU_REAL=$(command -v qemu-system-i386 2>/dev/null || true)
if [ -n "$QEMU_REAL" ]; then
    mkdir -p "$WORK/bin"
    {
        echo "#!/bin/sh"
        # shellcheck disable=SC2016 # the shim expands these, not this script
        echo 'test -n "${RACH2_QEMU_LEDGER:-}" && echo $$ >> "$RACH2_QEMU_LEDGER"'
        echo "exec '$QEMU_REAL' \"\$@\""
    } > "$WORK/bin/qemu-system-i386"
    chmod +x "$WORK/bin/qemu-system-i386"
    PATH="$WORK/bin:$PATH"; export PATH
fi

# The registry, one field at a time. Order in the file is the schedule order.
suite_names()  { awk -F'|' '!/^#/ && NF > 1 { print $1 }' "$REGISTRY"; }
suite_tools()  { awk -F'|' -v s="$1" '!/^#/ && $1 == s { print $2 }' "$REGISTRY"; }
suite_known()  { [ -n "$(suite_tools "$1")" ]; }
tier_names()   { awk -F'|' -v t="$1" '!/^#/ && $3 == t { print $1 }' "$REGISTRY"; }

usage_names() {
    suite_names | tr '\n' ' ' | sed 's/^/  /;s/ $//' >&2
    echo >&2
}

# Every external command a suite needs, before anything is built for it.
check_tools() {
    tools=$(suite_tools "$1")
    [ "$tools" = "-" ] && return 0
    oldifs=$IFS; IFS=,
    for tool in $tools; do
        IFS=$oldifs
        command -v "$tool" >/dev/null 2>&1 || {
            echo "run: $1 needs $tool and it is not installed" >&2
            return 1
        }
    done
    IFS=$oldifs
}

# A suite must stop every machine it starts. One left running costs a
# processor and a few hundred megabytes until the host reboots, and nothing
# else notices: the suite passed, and the pid now belongs to init.
check_machines() {
    ledger="$WORK/$1.machines"
    [ -f "$ledger" ] || return 0
    leaked=""
    while read -r pid; do
        [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && leaked="$leaked $pid"
    done < "$ledger"
    [ -z "$leaked" ] && return 0
    echo "run: $1: left$leaked running; a suite must stop every machine it starts" >&2
    # Stopped here as well as reported. The suite failed either way, and a
    # machine left behind costs a processor and a few hundred megabytes until
    # the host reboots.
    for pid in $leaked; do kill "$pid" 2>/dev/null; done
    return 1
}

# The name and the tools were checked before anything was built, so this does
# not repeat them; it runs the target and then reads the ledger the shim wrote.
run_one() {
    start=$(date +%s)
    RACH2_QEMU_LEDGER="$WORK/$1.machines"; export RACH2_QEMU_LEDGER
    : > "$RACH2_QEMU_LEDGER"
    rc=0
    make -C "$REPO" --no-print-directory "run-$1" || rc=1
    check_machines "$1" || rc=1
    if [ "$rc" = 0 ]; then
        echo "run: $1: PASS in $(($(date +%s) - start))s"
    else
        echo "run: $1: FAIL in $(($(date +%s) - start))s" >&2
    fi
    return "$rc"
}

# The given suites, at most $WORKERS at a time, each one's output held and
# replayed in order at the end: twenty suites writing to one terminal is not a
# report. The failures are left in POOL_FAILED rather than printed, because a
# caller reading this through a command substitution would run it in a subshell
# and the replayed output would go there instead of to the person waiting.
POOL_FAILED=""
run_pool() {
    POOL_FAILED=""; running=""
    for suite in $1; do
        while [ "$(alive "$running")" -ge "$WORKERS" ]; do sleep 0.2; done
        ( run_one "$suite" > "$WORK/$suite.out" 2>&1; echo $? > "$WORK/$suite.rc" ) &
        running="$running $!"
    done
    wait
    for suite in $1; do
        cat "$WORK/$suite.out" 2>/dev/null
        rc=1; [ -f "$WORK/$suite.rc" ] && read -r rc < "$WORK/$suite.rc"
        [ "$rc" = 0 ] || POOL_FAILED="$POOL_FAILED $suite"
    done
}

alive() { n=0; for p in $1; do kill -0 "$p" 2>/dev/null && n=$((n + 1)); done; echo "$n"; }

# Build the product and the test tools once, so no two suites build at once.
prepare() {
    echo "run: preparing"
    make -C "$REPO" --no-print-directory -j prepare-all || {
        echo "run: result: preparation failed" >&2; exit 1
    }
}

# `style` rebuilds the kernel with its own flags and shares a scratch directory
# with `host`, so those two run alone, before the pool. `usb` and `usbdisk` plug devices in
# and out through QEMU's monitor, and on a host saturated by the pool that
# monitor stops answering `device_add` for a minute or more while the machine
# runs on; the suite passes every time on its own, so it runs alone, after
# the pool.
run_set() {
    failed=""; serial=""; pooled=""; lone=""
    for suite in $1; do
        case "$suite" in
            style|host) serial="$serial $suite" ;;
            usb|usbdisk) lone="$lone $suite" ;;
            *)          pooled="$pooled $suite" ;;
        esac
    done
    for suite in $serial; do run_one "$suite" || failed="$failed $suite"; done
    [ -n "$pooled" ] && { run_pool "$pooled"; failed="$failed$POOL_FAILED"; }
    for suite in $lone; do run_one "$suite" || failed="$failed $suite"; done
    [ -z "$failed" ] && return 0
    echo "run: result: failed:$failed" >&2
    return 1
}

case "${1-}" in
    '')
        echo "usage: tests/run NAME [NAME...] | core | all" >&2
        echo "run: valid suites are:" >&2; usage_names; exit 2 ;;
    all|core)
        # A set and a name in one command would read as "the set and also
        # this", and the set is not being added to. Refused rather than
        # silently dropped.
        [ "$#" -eq 1 ] || {
            echo "run: '$1' is a whole set; it takes no other names" >&2; exit 2
        }
        if [ "$1" = all ]; then
            # shellcheck disable=SC2046 # a suite name is one word by format
            set -- $(suite_names)
        else
            # shellcheck disable=SC2046 # a suite name is one word by format
            set -- $(tier_names core)
        fi ;;
esac

# Every name and every tool, before a single object is built: a run that is
# going to refuse the last suite should refuse it now rather than in an hour.
[ "$#" -gt 0 ] || { echo "run: no suites in that set" >&2; exit 2; }
seen=""
for suite in "$@"; do
    suite_known "$suite" || {
        echo "run: unknown suite '$suite'; valid suites are:" >&2; usage_names; exit 2
    }
    # Twice in one command means two runs sharing one ledger and one held
    # output, where the second result overwrites the first.
    case " $seen " in
        *" $suite "*) echo "run: $suite is named twice" >&2; exit 2 ;;
    esac
    seen="$seen $suite"
    check_tools "$suite" || exit 1
done

prepare
if [ "$#" -eq 1 ]; then
    run_one "$1" || exit 1
else
    run_set "$*" || exit 1
    echo "run: result: all $# suites passed"
fi
