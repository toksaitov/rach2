#!/usr/bin/env sh
#
# tests/run: the one way to run a test suite.
#
#   tests/run NAME              one suite
#   tests/run NAME NAME...      those suites, at the same time
#   tests/run core              the tier `make test` runs
#   tests/run all               every suite
#   tests/run inventory         every suite with what it proves, as Markdown
#
# A suite is the cases of a family in tests/cases, whose identity ends in its
# name, which etude runs; tests/registry lists the suites' names, the external
# commands they need, and which tier they belong to. This file decides only
# what runs, when, and how a failure is reported.
#
set -u
# The installed launcher accounts for this command before it builds or runs.
site=${ETUDE_SITE:-/etc/rach2/etude-site}
if [ "${ETUDE_ADMITTED:-}" != "$site" ] && { [ -e "$site" ] || [ -L "$site" ] || [ "${ETUDE_SITE+x}" = x ]; }; then
    launcher=$(sed -n 's/^launcher //p' "$site") || exit 2
    [ -n "$launcher" ] && [ -x "$launcher" ] || {
        echo 'run: result: refused: installed etude launcher is unavailable' >&2
        exit 2
    }
    exec "$launcher" legacy sh "$0" "$@"
fi

# ARCH names the architecture the run builds and boots, as mk/arch.mk does:
# i686 when it is unset, into build/ on qemu-system-i386, or x86_64, into
# build/x86_64/ on qemu-system-x86_64. Every make the run starts is given it,
# and a set is the suites the registry lists for it.
ARCH=${ARCH:-i686}
case "$ARCH" in
    i686) ARCH_BUILD=build; RACH2_QEMU="qemu-system-i386" ;;
    x86_64) ARCH_BUILD=build/x86_64; RACH2_QEMU="qemu-system-x86_64" ;;
    *) echo "run: result: refused: ARCH=$ARCH: the architectures are i686 and x86_64" >&2; exit 2 ;;
esac
export RACH2_QEMU
ARCH_VAR="ARCH=$ARCH"

# RACH2_KERNEL=NAME passes rach2-NAME/kernel in the architecture's build tree
# to the suites as BOOT_KERNEL, after the preparation has built it with the
# NAME-kernel target of tests/system/suites.mk (ubsan, o2); unset, BOOT_KERNEL
# is rach2/kernel there. tests/system/suites.mk says which boots it replaces.

REPO=$(cd "$(dirname "$0")/.." && pwd)
# A run is two processes. The first, which the caller starts, checks the names
# and the host in a private scratch directory, takes the tree through
# etude-hold (hold_tree below), waits for the hold to end and removes the
# scratch and the status record. The second is the hold's command, the run
# proper: this script again, with RACH2_RUN_WORK naming the scratch and
# RACH2_RUN_STATUS the status record, which it removes as well when it ends.
# No product or shared build file is written before the hold.
HELD=""
if [ -n "${RACH2_RUN_WORK:-}" ]; then
    HELD=1
    WORK=$RACH2_RUN_WORK
    STATUS_RECORD=${RACH2_RUN_STATUS:-}
else
    WORK=""
    STATUS_RECORD=""
fi
trap '[ -z "$WORK" ] || rm -rf "$WORK"; [ -z "$STATUS_RECORD" ] || rm -f "$STATUS_RECORD"' 0
trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
# The first process compiles the two helpers the run needs before it builds,
# etude-hold and etude-ports, with the host compiler into the scratch.
if [ -z "$WORK" ]; then
    WORK=$(mktemp -d "${TMPDIR:-/tmp}/rach2-run.XXXXXX") || exit 1
    mkdir "$WORK/bin" || exit 1
    case $(uname -s) in
        MINGW*|MSYS*|UCRT*|CLANG*)
            helper_repo=$(cygpath -m "$REPO") || exit 1
            helper_work=$(cygpath -m "$WORK") || exit 1
            if ! { "${ETUDE_WIN_CC:-/ucrt64/bin/gcc}" -std=c99 -O2 -static -D_WIN32_WINNT=0x0A00 \
                -o "$helper_work/bin/etude-hold.exe" "$helper_repo/tools/etude/etude_hold.c" \
                "$helper_repo/tools/etude/win/hold.c" "$helper_repo/tools/etude/win/winfmt.c" &&
                "${ETUDE_WIN_CC:-/ucrt64/bin/gcc}" -std=c99 -O2 -static -D_WIN32_WINNT=0x0A00 \
                -I"$helper_repo/tools/etude/include" -I"$helper_repo/tools/etude" \
                -o "$helper_work/bin/etude-ports.exe" "$helper_repo/tools/etude/etude_ports.c" \
                "$helper_repo/tools/etude/portlock.c" "$helper_repo/tools/etude/win/winfmt.c"; }; then
                echo "run: result: refused: the run's helpers did not compile" >&2
                exit 1
            fi ;;
        *)
            if ! { cc -std=c99 -O2 -D_DEFAULT_SOURCE -o "$WORK/bin/etude-hold" \
                "$REPO/tools/etude/etude_hold.c" "$REPO/tools/etude/posix/hold.c" &&
                cc -std=c99 -O2 -D_DEFAULT_SOURCE -I"$REPO/tools/etude/include" -I"$REPO/tools/etude" \
                -o "$WORK/bin/etude-ports" "$REPO/tools/etude/etude_ports.c" \
                "$REPO/tools/etude/portlock.c" "$REPO/tools/etude/win/winfmt.c"; }; then
                echo "run: result: refused: the run's helpers did not compile" >&2
                exit 1
            fi ;;
    esac
fi
RUN_SHELL='sh'
RUN_ENV=
RUN_TREE=$REPO
RUN_PORT_DIR=${RACH2_PORT_DIR:-/tmp}
case $(uname -s) in
    MINGW*|MSYS*|UCRT*|CLANG*)
        WORK=$(cygpath -m "$WORK") || exit 1
        RUN_TREE=$(cygpath -m "$REPO") || exit 1
        RUN_PORT_DIR=$(cygpath -m "$RUN_PORT_DIR") || exit 1
        RUN_SHELL=$(cygpath -m "$(command -v sh)") || exit 1
        RUN_ENV=$(cygpath -m "$(command -v env)") || exit 1
        RACH2_HOLD_HELPER=$(cygpath -m "$WORK/bin/etude-hold.exe") || exit 1
        export RACH2_HOLD_HELPER ;;
esac
case "${RACH2_PORT_OFFSET:-}" in
    *[!0-9]*) echo "run: result: refused: RACH2_PORT_OFFSET must be a whole number" >&2; exit 2 ;;
esac
unset RACH2_RUN_WORK RACH2_PROGRESS_FD RACH2_HOST_LOCK RACH2_RUN_STATUS
LC_ALL=C; export LC_ALL

# e2fsprogs, where a package manager keeps it off the path, so that the suites
# that name mke2fs or e2fsck find them where the build does.
. "$REPO/tools/setup/e2fsprogs_path.sh"
case $(uname -s) in
    MINGW*|MSYS*|UCRT*|CLANG*)
        . "$REPO/tools/etude/collection-windows.sh" || exit 1 ;;
esac
# On macOS, Homebrew's mtools 4.0.49 appends `_` to some of the names it copies
# out of a volume under LC_ALL=C, so each mtools program on the path is put
# first in it as a wrapper in the run's scratch that runs it under C.UTF-8.
if [ "$(uname -s)" = Darwin ] && [ ! -d "$WORK/mtools" ]; then
    mkdir "$WORK/mtools" || exit 1
    for tool in mattrib mcopy mdel mdeltree mdir mformat minfo mlabel mmd mmove mrd mren mtype; do
        real=$(command -v "$tool") || continue
        printf '#!/bin/sh\nLC_ALL=C.UTF-8 exec "%s" "$@"\n' "$real" > "$WORK/mtools/$tool" &&
            chmod 755 "$WORK/mtools/$tool" || exit 1
    done
    PATH=$WORK/mtools:$PATH; export PATH
fi
# macOS's tar adds a `._NAME` file of each file's extended attributes to an
# archive it makes, unless COPYFILE_DISABLE is set.
COPYFILE_DISABLE=1; export COPYFILE_DISABLE
REGISTRY="$REPO/tests/registry"
[ -f "$REGISTRY" ] || { echo "run: result: refused: missing $REGISTRY" >&2; exit 1; }

# How many suites run at once. A suite spends most of its time waiting for an
# emulated machine rather than computing, so the useful count is above the
# core count: on a ten-core machine the full run of one-processor machines
# takes 1286s at four workers, 728 at eight, 587 at twelve, 527 at sixteen
# and 499 at twenty, and improves no further. The default is twice the host's
# processors, counted in the machines' processors, each machine having
# RACH2_CPUS (set_cpus), so that the guests' processors do not outnumber the
# host's threads by more than two to one and boots finish within their steps'
# time limits.
workers_default() {
    n=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
    case "$n" in ''|*[!0-9]*) n=4 ;; esac
    c=${RACH2_CPUS:-2}
    case "$c" in ''|*[!0-9]*|0*) c=2 ;; esac
    n=$((n * 2 / c))
    [ "$n" -lt 4 ] && n=4
    echo "$n"
}
WORKERS="${RACH2_WORKERS:-$(workers_default)}"
# How much guest memory the pool may have booted at once, in MiB: three
# quarters of the host's, so the memory matrix's 4 GiB machine and the
# suites beside it do not push the host into swap, where the time limits no
# longer hold. RACH2_MEMORY_MIB overrides it. A suite is admitted while the
# running suites' declared memory plus its own fits; a suite alone always fits.
memory_default() {
    b=$(sysctl -n hw.memsize 2>/dev/null)
    if [ -z "$b" ] && [ -r /proc/meminfo ]; then
        b=$(($(awk '/^MemTotal:/ { print $2 }' /proc/meminfo) * 1024))
    fi
    case "$b" in ''|*[!0-9]*) echo 4096; return ;; esac
    echo $((b * 3 / 4 / 1048576))
}
MEMORY_MIB="${RACH2_MEMORY_MIB:-$(memory_default)}"
case "$MEMORY_MIB" in
    ''|*[!0-9]*|0) echo "run: result: refused: RACH2_MEMORY_MIB must be a positive whole number" >&2; exit 2 ;;
esac
case "$WORKERS" in
    ''|*[!0-9]*) echo "run: result: refused: RACH2_WORKERS must be a positive whole number" >&2; exit 2 ;;
esac
# `00` is digits and is zero, and a pool of zero waits for a worker that never
# frees. The value is compared as a number from here on, so it is made one.
WORKERS=$(awk -v n="$WORKERS" 'BEGIN {if (n < 1 || n > 1024) exit 1; printf "%.0f\n", n}') || {
    echo "run: result: refused: RACH2_WORKERS must be between 1 and 1024" >&2; rm -rf "$WORK"; exit 2;
}
[ "$WORKERS" -ge 1 ] || { echo "run: result: refused: RACH2_WORKERS must be a positive whole number" >&2; exit 2; }

# The suites run under etude-legacy's set driver (tools/etude/Readme.md),
# which this run starts once the tree is its own and every check has passed.
# The driver supervises each process a suite starts, its machines among them,
# and stops them all when it is stopped. A signal that reaches the run while
# the driver runs is passed on to it: the driver cancels the suites, prints
# what the unfinished ones had written and writes the run's history, and the
# run prints its lines and exits as the signal says. A signal before or after
# the driver ends the run at once, and stops the make it waits for. `finish`
# runs once: the trap calls it and the EXIT trap finds it done.
DRIVER=""
WATCHER=""
MAKE_PID=""
SIGNALLED=""
FINISHED=""
# shellcheck disable=SC2329 # run from the traps
finish() {
    [ -z "$FINISHED" ] || return 0
    FINISHED=1
    trap '' INT TERM HUP
    [ -z "$WATCHER" ] || kill "$WATCHER" 2>/dev/null
    [ -z "$MAKE_PID" ] || stop_make
    if [ -n "$DRIVER" ]; then
        kill -TERM "$DRIVER" 2>/dev/null
        wait "$DRIVER" 2>/dev/null
    fi
    rm -rf "$WORK"
    [ -z "$STATUS_RECORD" ] || rm -f "$STATUS_RECORD"
}
trap 'finish' EXIT
trap 'SIGNALLED=1; finish; echo "run: result: interrupted by int" >&2; exit 130' INT
trap 'SIGNALLED=1; finish; echo "run: result: interrupted by term" >&2; exit 143' TERM
trap 'SIGNALLED=1; finish; echo "run: result: interrupted by hup" >&2; exit 129' HUP
# One run at a time on a tree: two share `build/` and its images, and each suite
# kills what runs under its directory at its start. The lock is etude-hold's
# (tools/etude/Readme.md): a POSIX record lock on `build/.run.guard`, and beside
# it the directory `build/.run.lock`, whose owner record gives the holder's
# identity, its command's process group and the run's arguments, which is what
# a second run prints and what a takeover reads. hold_tree runs the run proper
# as etude-hold's command, a process group of its own, which a TERM, INT or
# HUP that reaches the holder reaches once as TERM; the holder outlives the
# run and removes the directory when it ends. A lock whose holder is gone is
# taken over only when nothing of its command's group is left, and a script's
# lock, whose record says `held`, never is. A run started under the hold of a
# script or a caller finds the holder among its ancestors (tools/etude/hold.sh)
# and runs under that hold, taking and releasing nothing; a script the run
# starts finds the run's hold the same way.
LOCK="$REPO/build/.run.lock"
. "$REPO/tools/etude/hold.sh"
lock_field() { sed -n "s/^$1 //p" "$LOCK/owner" 2>/dev/null; }
# hold_tree ARGS: run the run proper under etude-hold and exit with its status.
# The holder runs in the background, so that a TERM, INT or HUP that reaches
# this process is passed on to it at once, as TERM, which is what the holder
# passes to its command; under a caller's hold, where etude-hold becomes the
# run proper, an INT would be lost, since a background command starts with
# INT ignored. The run proper's standard input is /dev/null, as a background
# command's is. A refusal of the tree prints its reason and exits 1. The EXIT
# trap removes the scratch and the status record when the run has ended.
hold_tree() {
    STATUS_RECORD=$REPO/build/.run.status.$$
    RACH2_RUN_WORK=$WORK; RACH2_RUN_STATUS=$STATUS_RECORD
    export RACH2_RUN_WORK RACH2_RUN_STATUS
    holder=""
    stop=""
    trap 'stop=1; [ -z "$holder" ] || kill -TERM "$holder" 2>/dev/null' INT TERM HUP
    trap '[ -z "$WORK" ] || rm -rf "$WORK"; [ -z "$STATUS_RECORD" ] || rm -f "$STATUS_RECORD"' EXIT
    set -- "$RUN_SHELL" "$0" "$@"
    if [ -n "$RUN_ENV" ]; then
        set -- "$RUN_ENV" "MSYS2_ARG_CONV_EXCL=${MSYS2_ARG_CONV_EXCL-}" "$@"
    fi
    MSYS2_ARG_CONV_EXCL='*' "$WORK/bin/etude-hold" -r "$RUN_TREE" run "$@" &
    holder=$!
    [ -z "$stop" ] || kill -TERM "$holder" 2>/dev/null
    while :; do
        wait "$holder"
        held_rc=$?
        kill -0 "$holder" 2>/dev/null || break
    done
    # A holder killed with KILL leaves the run proper running, and the run's
    # own exit removes the scratch and the status record.
    [ "$held_rc" != 137 ] || { WORK=""; STATUS_RECORD=""; }
    exit "$held_rc"
}
# stop_make: stop the make the run waits for, with TERM. A run that leads its
# process group, as etude-hold's command does, stops the whole group, which
# holds the make and its recipes and nothing that `finish` has not stopped. A
# run under a caller's hold, whose group is the caller's, stops the make and
# each of its descendants that one reading of the process table finds.
# shellcheck disable=SC2329 # run from finish, from the traps
stop_make() {
    if [ "$(ps -o pgid= -p $$ | tr -d ' ')" = "$$" ]; then
        kill -s TERM 0 2>/dev/null
        return
    fi
    # shellcheck disable=SC2046 # one pid a word
    kill -s TERM $(ps -A -o pid= -o ppid= | awk -v root="$MAKE_PID" '
        { below[$2] = below[$2] " " $1 }
        END {
            todo = root
            while (todo != "") {
                n = split(todo, now, " "); todo = ""
                for (i = 1; i <= n; i++) { print now[i]; todo = todo below[now[i]] }
            }
        }') 2>/dev/null
}

# The registry, one field at a time. Order in the file is the schedule order.
suite_names()  { awk -F'|' '!/^#/ && NF > 1 { print $1 }' "$REGISTRY"; }
suite_tools()  { awk -F'|' -v s="$1" '!/^#/ && $1 == s { print $2 }' "$REGISTRY"; }
suite_known()  { [ -n "$(suite_tools "$1")" ]; }
tier_names()   { awk -F'|' -v t="$1" '!/^#/ && $3 == t { print $1 }' "$REGISTRY"; }
# The architectures a suite runs on, the sixth field, commas between them;
# empty is every architecture.
suite_arches() { awk -F'|' -v s="$1" '!/^#/ && $1 == s { print $6 }' "$REGISTRY"; }
suite_for_arch() { # suite_for_arch NAME: 0 when it runs on ARCH
    case ",$(suite_arches "$1")," in
        ,,|*",$ARCH,"*) return 0 ;;
    esac
    return 1
}
arch_only() { # arch_only NAME...: those of the names that run on ARCH
    for s in "$@"; do suite_for_arch "$s" && echo "$s"; done
}
suite_images() { awk -F'|' -v s="$1" '!/^#/ && $1 == s { print $4 }' "$REGISTRY"; }
suite_tier()   { awk -F'|' -v s="$1" '!/^#/ && $1 == s { print $3 }' "$REGISTRY"; }
# What a suite proves, in one sentence: the comment in suites.mk that names
# it as `tests/run NAME`, read to the end of its first sentence.
suite_proves() {
    awk -v n="$1" '
        /^#/ { line = $0; sub(/^# ?/, "", line)
               if (!on && index(line, "`tests/run " n "`") == 1) { on = 1; text = line; next }
               if (on && index(line, "`tests/run ") == 1) exit
               if (on) { text = text " " line; next } }
        { if (on) exit }
        END {
            if (!on) exit
            sub(/^`tests\/run [a-z0-9-]*`:? */, "", text)
            if (match(text, /\. |\.$/)) text = substr(text, 1, RSTART)
            print text
        }' "$REPO/tests/system/suites.mk"
}
# A tools field in words: `a,b+c/d+e` is "a, either b and c or d and e", and
# `tooling` is etude's tooling machine.
tools_prose() {
    echo "$1" | awk -F, '{
        for (i = 1; i <= NF; i++) {
            e = "/" $i "/"; gsub(/\/tooling\//, "/etude\047s tooling machine/", e)
            e = substr(e, 2, length(e) - 2); gsub(/\+/, " and ", e)
            if (index(e, "/")) { gsub(/\//, " or ", e); e = "either " e }
            printf "%s%s", (i > 1 ? ", " : ""), e
        }
        print ""
    }'
}
# The suites as Markdown, one line each in the registry's order: the tier,
# the tools, the memory, and what the suite proves. tests/system/suites.md
# is this output, and `tests/run style` compares the two.
inventory() {
    echo "# The suites"
    echo
    echo "One line per suite, in the order the pool starts them, from \`tests/run inventory\`: the tier, the external commands the suite needs, \`qemu\` being the emulator of the architecture \`ARCH\` names, the most guest memory its machines ask for at once, the architectures it runs on when it does not run on both, and what it proves, which is the sentence in \`tests/system/suites.mk\` that names it. \`tests/run style\` compares this file with that output."
    echo
    for s in $(suite_names); do
        tools=$(tools_prose "$(suite_tools "$s")")
        case "$tools" in
            -) tools="needs nothing beyond the build" ;;
            *) tools="needs $tools" ;;
        esac
        case ",$(suite_tools "$s")," in
            *,qemu,*|*qemu-system-*) memory="$(suite_memory "$s") MiB" ;;
            *) memory="no machine" ;;
        esac
        arches=$(suite_arches "$s")
        case "$arches" in
            '') arches="" ;;
            *) arches="; $(echo "$arches" | sed 's/,/ and /g') only" ;;
        esac
        proves=$(suite_proves "$s"); [ -n "$proves" ] || proves="(no sentence in suites.mk names this suite)"
        # shellcheck disable=SC2016 # the backticks are Markdown, not a command
        printf '* `%s` (%s tier; %s; %s%s): %s\n' "$s" "$(suite_tier "$s")" "$tools" "$memory" "$arches" "$proves"
    done
}
suite_memory() { # the guest memory a suite's machines ask for at once, MiB
    m=$(awk -F'|' -v s="$1" '!/^#/ && $1 == s { print $5 }' "$REGISTRY")
    case "$m" in ''|*[!0-9]*) echo 128 ;; *) echo "$m" ;; esac
}

# What a suite writes under build/images, as globs from the registry's
# fourth field; a suite that declares nothing owns the files named after
# it, `NAME-test*`, `NAME.*`, `NAME-*` and `NAME/*`, and a second-card twin,
# `NAME-e1000`, owns the plain suite's names with `-e1000` before the
# extension. A file made during a run that no suite of the run owns, or that
# two own, fails the run by name: pooled suites share nothing, and the
# declarations are the inventory of what they touch. The build's own products,
# the ones the preparation records, and their `.d` files are not a suite's and
# are passed over.
image_patterns() { # image_patterns NAME: one glob a line
    p=$(suite_images "$1")
    if [ -n "$p" ]; then
        printf '%s\n' "$p" | tr ',' '\n'
    else
        case "$1" in
            *-e1000) b=${1%-e1000}; printf '%s\n' "$b*-e1000.*" "$b*-e1000-*" "$b*-e1000/*" ;;
            *) printf '%s\n' "$1-test*" "$1.*" "$1-*" "$1/*" ;;
        esac
    fi
}
image_table() { # image_table NAMES: lines of "NAME GLOB"
    for s in $1; do image_patterns "$s" | sed "s/^/$s /"; done
}
check_declarations() { # a glob two suites declare is refused before anything runs
    dup=$(image_table "$(suite_names)" | awk '{print $2}' | sort | uniq -d | head -3)
    [ -z "$dup" ] || { echo "run: result: refused: two suites declare the same images:$(echo "$dup" | tr '\n' ' ')" >&2; return 1; }
}
check_images() { # check_images NAMES: 0 when every file made that is not a
                 # recorded build product belongs to one of them
    [ -f "$WORK/images.stamp" ] || return 0
    image_table "$1" > "$WORK/images.patterns"
    ( cd "$REPO/$ARCH_BUILD/images" 2>/dev/null && find . -type f -newer "$WORK/images.stamp" | sed 's|^\./||' | sort ) > "$WORK/images.made"
    # A product of the run's target is the build's, and check_hashes checks it.
    if [ -f "$WORK/inventory.products" ]; then
        { sed -n "s|^$ARCH_BUILD/images/||p" "$WORK/inventory.products"
          # with the .d and .programs files of mkimage.sh, in no closure
          sed -n "s|^$ARCH_BUILD/images/||p" "$WORK/inventory.products" | sed 's/$/.d/'
          sed -n "s|^$ARCH_BUILD/images/||p" "$WORK/inventory.products" | sed 's/$/.programs/'
        } | sort -u > "$WORK/images.products"
        comm -23 "$WORK/images.made" "$WORK/images.products" > "$WORK/images.made.new"
        mv "$WORK/images.made.new" "$WORK/images.made"
    fi
    bad=""
    while IFS= read -r f; do
        owners=""
        while read -r s g; do
            case "$s" in
                *-e1000) ;;
                *) case "$f" in *-e1000.*|*-e1000-*|*-e1000/*) continue ;; esac ;;
            esac
            # shellcheck disable=SC2254 # the glob is the pattern
            case "$f" in $g) case " $owners " in *" $s "*) ;; *) owners="$owners $s" ;; esac ;; esac
        done < "$WORK/images.patterns"
        case "$(echo "$owners" | wc -w | tr -d ' ')" in
            1) ;;
            0) echo "run: images: undeclared: $ARCH_BUILD/images/$f" >&2; bad=1 ;;
            *) echo "run: images: shared: $ARCH_BUILD/images/$f:$owners" >&2; bad=1 ;;
        esac
    done < "$WORK/images.made"
    [ -z "$bad" ]
}

usage_names() {
    suite_names | tr '\n' ' ' | sed 's/^/  /;s/ $//' >&2
    echo >&2
}

# What the host must let the run do, tried and not merely looked up.
# `tools/setup/hostcheck.c` binds TCP and UDP sockets, and a Unix socket on
# POSIX hosts, for suites besides style and host. It also attaches a disk
# image when a suite names hdiutil and the host has it. A refusal stops the
# run before the build.
check_host() {
    checker="$WORK/hostcheck"
    case $(uname -s) in
        MINGW*|MSYS*|UCRT*|CLANG*)
            checker="$WORK/hostcheck.exe"
            check_source=$(cygpath -m "$REPO/tools/setup/hostcheck.c") || return 1
            "${ETUDE_WIN_CC:-/ucrt64/bin/gcc}" -std=c99 -O2 -static \
                -o "$checker" "$check_source" -lws2_32 ;;
        *) cc -O2 -o "$checker" "$REPO/tools/setup/hostcheck.c" ;;
    esac || {
        echo "run: the host check did not compile" >&2; return 1
    }
    if "$checker" "$WORK" "$@"; then
        return 0
    fi
    echo "run: result: the host refuses an operation the suites need; nothing was built" >&2
    return 1
}

# The free space a run that boots machines needs before it builds anything: a
# full set writes some 30 GiB of images for one architecture.
# tools/setup/space.sh reads it, and under WSL the Windows drive that holds the
# distribution's disk as well. `RACH2_MIN_FREE_GIB` is the floor, 40 when
# unset; 0 turns the check off.
check_space() {
    sh "$REPO/tools/setup/space.sh" run 'a run' "${RACH2_MIN_FREE_GIB:-40}" "$REPO"
}

# tooling_host: succeed on a host that is not Linux and has the commands that
# etude's tooling machine runs on (tools/etude/Readme.md, The tooling machine).
tooling_host() {
    [ "$(uname -s)" != Linux ] || return 1
    for tool in qemu-system-x86_64 qemu-img curl tar; do
        command -v "$tool" >/dev/null 2>&1 || return 1
    done
}

# Every external command a suite needs, before anything is built for it. An
# entry with alternatives, `a+b/c+d`, is met when every command of one of
# them is installed. `qemu` is the emulator of ARCH, and `tooling` is met
# where tooling_host succeeds.
check_tools() { # check_tools NAME
    tools=$(suite_tools "$1")
    [ "$tools" = "-" ] && return 0
    for entry in $(echo "$tools" | tr ',' ' '); do
        met=""
        for choice in $(echo "$entry" | tr '/' ' '); do
            has=1
            for tool in $(echo "$choice" | tr '+' ' '); do
                case "$tool" in
                    qemu) tool=$RACH2_QEMU ;;
                    tooling) tooling_host && continue; has=""; break ;;
                esac
                if ! command -v "$tool" >/dev/null 2>&1; then
                    case $(uname -s) in
                        MINGW*|MSYS*|UCRT*|CLANG*)
                            collection_windows_tool "$tool" "$1" && continue ;;
                    esac
                    has=""; break
                fi
            done
            [ -n "$has" ] && { met=1; break; }
        done
        [ -n "$met" ] && continue
        case "$entry" in
            *[/+]*) echo "run: $1 needs $(tools_prose "$entry"), which this host does not have" >&2 ;;
            *) [ "$entry" = qemu ] && entry=$RACH2_QEMU
               echo "run: $1 needs $entry and it is not installed" >&2 ;;
        esac
        return 1
    done
}

# A make run under the runner is started in the background, in the run's
# process group, and waited for, since the shell runs a trap at once while it
# waits and only after the command ends while one runs in the foreground: a
# signal then stops the run at once, and `finish` stops the make (stop_make).
# A make in the run's group is one of the processes of the hold's command, which
# a takeover of the lock of a run killed with KILL finds still running.
run_make() {
    # shellcheck disable=SC2086
    make -C "$REPO" --no-print-directory $ARCH_VAR "$@" &
    MAKE_PID=$!
    wait "$MAKE_PID"
    make_rc=$?
    MAKE_PID=""
    return "$make_rc"
}

# What a run reads, and must not change while it runs: the scripts that
# decide a result and the tools that judge one, hashed when the run starts,
# again every two seconds while the driver runs, and again at the end; and
# the products the suites read, which the preparation records with their
# SHA-256, and which `etude-legacy check -d` compares again at the end, by
# the digests that build/tests/digests keeps for a file that has not been
# written since it was hashed, and by reading the others again. A
# difference, or a file gone, voids the run by name. Two equal hashes do not
# say the file stood still in between; they say what the result was made
# with is what is there now.
present() { ( cd "$REPO" && while read -r f; do [ -f "$f" ] && echo "$f"; done ) | sort -u; }
scripts_inventory() {
    ( cd "$REPO" && {
        echo tests/run; echo tests/registry; echo tests/system/suites.mk; echo Makefile
        ls mk/*.mk tests/system/runner/*.c tests/system/*.sh tests/system/accept/*.sh \
           tests/system/*.py tests/system/accept/agents/* tests/system/checkers/*.awk tests/system/fixtures/*.sh \
           tests/system/agents/* tests/system/fakeapi/* tests/system/fakeapi/repo/* tools/flow/* \
           tools/image/*.sh krffs/*.sh tests/cases/*.json tests/cases/host/*.sh tests/cases/machine/*.c tests/cases/machine/*.h \
           tests/cases/machine/*.sh tests/cases/machine/*.py krffs/manifests/* 2>/dev/null
    } ) | present
}
hasher() {
    cksum
}
hash_list() { # hash_list LIST OUT: each file's hash, or `gone` for one missing
    ( cd "$REPO" && while read -r f; do
        if [ -f "$f" ]; then hasher < "$f" | awk -v file="$f" '{print $1 ":" $2, file}'; else echo "gone $f"; fi
      done < "$1" ) > "$2"
}
take_scripts() {
    scripts_inventory > "$WORK/inventory.scripts"
    hash_list "$WORK/inventory.scripts" "$WORK/hashes.scripts"
}
# The scripts are checked as the set runs, not only at its end: the runner,
# the registry, the makefiles, the suite and tool scripts and the data files
# and helpers they read at run time, which is what `scripts_inventory` lists.
# A file changed under a run voids it, and a change found only at the end
# costs the whole run, while the scripts are cheap to hash. The kernel and
# the application sources are not hashed here; a change to one reaches the run
# through the products, which are large and are left to the check at the end.
check_scripts_now() { # 0 when no script of the inventory has changed
    [ -f "$WORK/hashes.scripts" ] || return 0
    hash_list "$WORK/inventory.scripts" "$WORK/hashes.scripts.now"
    cmp -s "$WORK/hashes.scripts" "$WORK/hashes.scripts.now" && return 0
    diff "$WORK/hashes.scripts" "$WORK/hashes.scripts.now" |
        awk '/^>/ {print $3}' | sort -u | while read -r f; do
            echo "run: voided: $f changed during the run" >&2
        done
    return 1
}
# The watcher of the scripts while the driver runs: a change stops the set,
# as a signal would, and leaves `voided` in the scratch for the verdict. Its
# nap runs in the background, so that the TERM that ends the watcher ends the
# nap with it and leaves nothing behind.
watch_scripts() {
    nap=""
    trap - EXIT INT HUP
    trap '[ -z "$nap" ] || kill "$nap" 2>/dev/null; exit 0' TERM
    while :; do
        sleep 2 &
        nap=$!
        wait "$nap"
        nap=""
        check_scripts_now && continue
        echo "run: stopping the set: the tree changed under it" >&2
        : > "$WORK/voided"
        kill -TERM "$DRIVER" 2>/dev/null
        return 0
    done
}
check_hashes() { # 0 when no script and no product differs or is gone
    voided=""
    if [ -f "$WORK/inventory.scripts" ]; then
        hash_list "$WORK/inventory.scripts" "$WORK/hashes.scripts.after"
        if ! cmp -s "$WORK/hashes.scripts" "$WORK/hashes.scripts.after"; then
            diff "$WORK/hashes.scripts" "$WORK/hashes.scripts.after" | awk '/^>/ {print $3}' | sort -u |
                while read -r f; do echo "run: voided: $f changed during the run" >&2; done
            voided=1
        fi
    fi
    if [ -f "$RECORD" ]; then
        "$ETUDE_LEGACY" check -d "$RECORD" > "$WORK/check.out" 2>&1
        case $? in
            0) ;;
            1) sed -n 's/^etude-legacy: changed: \(.*\)$/run: voided: \1 changed during the run/p
                       s/^etude-legacy: missing: \([^:]*\): .*$/run: voided: \1 changed during the run/p' \
                   "$WORK/check.out" >&2
               voided=1 ;;
            *) cat "$WORK/check.out" >&2
               echo "run: voided: the preparation's record could not be checked" >&2
               voided=1 ;;
        esac
    fi
    [ -z "$voided" ]
}

# The runner never measures host speed or changes the pool width.
#
# A host with a KVM device this user cannot open is refused rather than run
# under the emulator: the bounds were set under KVM, and a run that fell back
# to the emulator without saying so would report its slowness as a
# regression. `RACH2_QEMU_ACCEL=tcg` asks for the emulator outright.
set_accel() {
    kvm=/dev/kvm
    case "${RACH2_QEMU_ACCEL:-}" in
        '')
            if [ -r "$kvm" ] && [ -w "$kvm" ]; then
                RACH2_QEMU_ACCEL=kvm
            elif [ -e "$kvm" ]; then
                echo "run: result: refused: $kvm exists but this user cannot read and write it; add the user to its group, or set RACH2_QEMU_ACCEL=tcg to run under the emulator" >&2
                return 1
            elif [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = x86_64 ] &&
                [ "$(sysctl -n kern.hv_support 2>/dev/null)" = 1 ]; then
                RACH2_QEMU_ACCEL=hvf
            else
                RACH2_QEMU_ACCEL=tcg
            fi
            ;;
        kvm|hvf|whpx|tcg) ;;
        *)
            echo "run: result: refused: RACH2_QEMU_ACCEL must be kvm, hvf, whpx or tcg" >&2
            return 1
            ;;
    esac
    export RACH2_QEMU_ACCEL
}

# The processors every machine of the run has: RACH2_CPUS, 2 when it is unset,
# which the shim passes to QEMU as `-smp` before the suite's own arguments, so
# a suite that names a count of its own, as one that boots several counts
# does, keeps it.
set_cpus() {
    RACH2_CPUS=${RACH2_CPUS:-2}
    case "$RACH2_CPUS" in
        ''|*[!0-9]*|0*) echo "run: result: refused: RACH2_CPUS must be a whole number from 1 to 64" >&2; return 1 ;;
    esac
    [ "$RACH2_CPUS" -le 64 ] || { echo "run: result: refused: RACH2_CPUS must be a whole number from 1 to 64" >&2; return 1; }
    export RACH2_CPUS
}

case "${1-}" in
    inventory) inventory; exit 0 ;;
    '')
        echo "usage: tests/run NAME [NAME...] | core | all | inventory" >&2
        echo "run: result: refused: no suite named" >&2; usage_names; exit 2 ;;
    all|core)
        # A set takes no other names, rather than dropping them silently.
        [ "$#" -eq 1 ] || {
            echo "run: result: refused: '$1' is a whole set; it takes no other names" >&2; exit 2
        }
        if [ "$1" = all ]; then
            # shellcheck disable=SC2046 # a suite name is one word by format
            set -- $(arch_only $(suite_names))
        else
            # shellcheck disable=SC2046 # a suite name is one word by format
            set -- $(arch_only $(tier_names core))
        fi ;;
esac

# Every name and every tool, before a single object is built: a run that is
# going to refuse the last suite should refuse it now rather than in an hour.
[ "$#" -gt 0 ] || { echo "run: result: refused: no suites in that set" >&2; exit 2; }
seen=""
for suite in "$@"; do
    suite_known "$suite" || {
        echo "run: result: refused: unknown suite '$suite'" >&2; usage_names; exit 2
    }
    ls "$REPO"/tests/cases/*."$suite".json > /dev/null 2>&1 || {
        echo "run: result: refused: no family of cases in tests/cases is the suite $suite" >&2; exit 2
    }
    # Two runs of one suite would share one ledger and one held output.
    case " $seen " in
        *" $suite "*) echo "run: result: refused: $suite is named twice" >&2; exit 2 ;;
    esac
    seen="$seen $suite"
    suite_for_arch "$suite" || {
        echo "run: result: refused: $suite runs on $(suite_arches "$suite") alone, and ARCH is $ARCH" >&2; exit 2
    }
    check_tools "$suite" || { echo "run: result: refused: $suite has no tools to run with" >&2; exit 1; }
done
# The cases chosen, before anything is built: RACH2_CASES gives case
# identities, of which each suite of the run runs those of its own, and must
# name one of each; RACH2_AGENTS_ROWS and RACH2_ACCEPT_AGENTS give the rows of
# `agents` and `agentsaccept` by the last part of their identities, run in the
# order given. tests/system/case_select.py writes a manifest of the chosen
# cases for each suite chosen from, which the set driver reads in place of
# the suite's own, and prints how many cases it chose.
agents_rows=${RACH2_AGENTS_ROWS:-}
accept_rows=${RACH2_ACCEPT_AGENTS:-}
chosen=""
if [ -n "${RACH2_CASES:-}$agents_rows$accept_rows" ]; then
    rm -rf "$WORK/chosen"
    chosen=$(python3 "$REPO/tests/system/case_select.py" ${RACH2_CASES:+-c "$RACH2_CASES"} \
        ${agents_rows:+-r agents "$agents_rows"} ${accept_rows:+-r agentsaccept "$accept_rows"} \
        "$ARCH" "$REPO/tests/cases" "$WORK/chosen" "$@") || {
        echo "run: result: refused: the cases chosen are not cases of the suites named" >&2; exit 2
    }
fi
case "$chosen" in
    '') selection="" ;;
    1) selection=", a selection of 1 case" ;;
    *) selection=", a selection of $chosen cases" ;;
esac
diskimage=""
sockets="--no-sockets"
machines=""
for suite in "$@"; do
    case ",$(suite_tools "$suite")," in
        *[,/+]hdiutil[,/+]*) command -v hdiutil >/dev/null 2>&1 && diskimage="--diskimage" ;;
    esac
    case ",$(suite_tools "$suite")," in
        *,qemu,*|*,qemu-system-*) machines=1 ;;
    esac
    case "$suite" in
        style|host) ;;
        *) sockets="" ;;
    esac
done
# The run proper, the hold's command, finds these checks made by the process
# that took the tree for it.
if [ -z "$HELD" ]; then
    check_host $diskimage $sockets || { echo "run: result: refused: this host cannot run the set" >&2; exit 1; }
    [ -n "$sockets" ] || check_space || exit 1
    check_declarations || exit 1
fi

set_accel || exit 2
set_cpus || exit 2
NEED_PORTS=""
[ -z "$machines" ] || [ -n "${RACH2_PORT_OFFSET:-}" ] || NEED_PORTS=1
[ -n "$HELD" ] || hold_tree "$@"
etude_held "$REPO" || {
    echo "run: result: refused: the tree is not held for this run: RACH2_TREE_HELD must name an ancestor that build/.run.lock/owner names" >&2
    exit 1
}
if [ "$(lock_field pid)" != "$PPID" ]; then
    echo "run: the tree is held for this run by its caller, pid $RACH2_TREE_HELD"
fi
# The status record, which tools/flow/test_status.py reads: the identity of
# the holder, which runs for as long as the run, the scratch, where the port
# claim records its wait, and the names.
[ -n "$STATUS_RECORD" ] || { echo "run: result: refused: RACH2_RUN_STATUS is not set" >&2; exit 1; }
{
    echo "identity $(lock_field identity)"
    echo "work $WORK"
    echo "args $*"
} > "$STATUS_RECORD.new"
mv "$STATUS_RECORD.new" "$STATUS_RECORD"
# The host lock a run of the suites named takes before its port claim, below:
# `alone` when one declares more guest memory than half of the host's, which
# is two thirds of memory_default's three quarters, and `shared` otherwise.
host_lock() { # host_lock NAME...
    half=$(($(memory_default) * 2 / 3))
    for s in "$@"; do
        [ "$(suite_memory "$s")" -le "$half" ] || { echo alone; return; }
    done
    echo shared
}
# The block of host ports the run's machines forward, claimed by etude-ports
# last, after every check that can refuse the run and after the tree is held,
# and only when a suite named boots a machine: one whose tools name QEMU.
# `inventory`, a refused command and a set of suites that boot nothing, such
# as `style` and `host`, claim nothing. Every tree on the host, in every
# account, claims a block from the same lock files in /tmp, so two trees never
# forward the same port; the helper holds the lock through exec for as long as
# this process lives and sets RACH2_PORT_OFFSET, which the set driver adds to
# the ports of the machine cases. The run starts again under the lock with the
# names it was given, as a set expanded them; while the helper waits it writes
# the wait to `claim.wait` in RACH2_RUN_WORK, which the status record names.
# The holder keeps the tree while the claim waits, and removes the lock when
# the claim is interrupted, as the first process removes the scratch and the
# status record. A caller that set the offset itself owns the ports it names.
# Before the block, the helper takes the host lock in the same directory, of
# the kind RACH2_HOST_LOCK gives it: `shared`, which any number of runs have
# at once, or, for a run with a suite that declares more guest memory than
# half of the host's, as `bigmem` does on the testing host, `alone`, which
# waits for the runs in progress to end and keeps every other run that claims
# a block from starting until this one ends. The variable is given to the
# helper alone, which unsets it before the exec. RACH2_PORT_DIR names another
# directory for the block files and the host lock's, as it does for
# tools/ci/bisect.sh.
if [ -n "$NEED_PORTS" ]; then
    RACH2_RUN_WORK=$WORK; RACH2_RUN_STATUS=$STATUS_RECORD
    RACH2_HOST_LOCK=$(host_lock "$@")
    export RACH2_RUN_WORK RACH2_RUN_STATUS RACH2_HOST_LOCK
    set -- "$RUN_SHELL" "$0" "$@"
    if [ -n "$RUN_ENV" ]; then
        set -- "$RUN_ENV" "MSYS2_ARG_CONV_EXCL=${MSYS2_ARG_CONV_EXCL-}" "$@"
    fi
    MSYS2_ARG_CONV_EXCL='*' exec "$WORK/bin/etude-ports" "$RUN_PORT_DIR" 10 "$@"
fi
[ -z "${RACH2_PORT_OFFSET:-}" ] || export RACH2_PORT_OFFSET
# The accelerator the suites' machines run on, which the set driver gives
# every machine of the cases, as set_accel chose it.
export RACH2_QEMU_ACCEL
# The x86-64 firmware that the machine cases booted by UEFI take, found where
# the suites that boot by UEFI look for it (tools/setup/ovmf_path.sh).
# shellcheck source=tools/setup/ovmf_path.sh
. "$REPO/tools/setup/ovmf_path.sh"
[ -z "$OVMF_CODE" ] || { RACH2_OVMF_CODE=$OVMF_CODE; export RACH2_OVMF_CODE; }

# The line that says this run began. Everything below it belongs to this run,
# and a log without it is a run that never started.
echo "run: starting: $* (pid $$, $(date '+%Y-%m-%d %H:%M:%S'), architecture $ARCH, workers $WORKERS, memory $MEMORY_MIB MiB, accelerator $RACH2_QEMU_ACCEL, processors $RACH2_CPUS$selection)"
case $(uname -s) in
    MINGW*|MSYS*|UCRT*|CLANG*) collection_windows || exit 1 ;;
esac
# The recovery system starts an SSH server only where a key was built into it,
# and the suites that repair or update a machine do that work through recovery
# over SSH. The key is minted here: after the names are checked and the tree is
# this run's, so two runners cannot mint at once, and before the first make,
# because make decides from the key's presence what the recovery artifacts are
# called. A plain `make` mints nothing, which is what keeps the absence
# meaningful.
if [ ! -f "$REPO/krffs/recovery_authorized_keys" ]; then
    run_make recovery-key || {
        echo "run: result: the recovery system's key could not be made" >&2
        exit 1
    }
fi
# Git keeps no file mode but the executable bit, so a checkout that writes the
# committed demo keys leaves them readable by others, and ssh refuses such a
# key. krffs/gen_demo_key.sh sets the mode only when it makes the key lists.
for key in rach2_demo_ed25519 rach2_test_ed25519; do
    [ ! -f "$REPO/krffs/$key" ] || chmod 600 "$REPO/krffs/$key"
done
take_scripts
# The set driver, the formatter and the validator, built here and copied into
# the scratch, so that a build a suite starts cannot replace them while they
# run.
mkdir -p "$WORK/etude"
MANIFESTS=$(ls "$REPO"/tests/cases/*.json)
etude_programs="etude-legacy history_lines casecheck"
# shellcheck disable=SC2086 # one program a word
targets=$(for p in $etude_programs; do printf ' build/tools/etude/%s' "$p"; done)
# shellcheck disable=SC2086 # one target a word
if ! run_make -s $targets > "$WORK/etude.log" 2>&1 ||
    ! (cd "$REPO/build/tools/etude" && cp $etude_programs "$WORK/etude/"); then
    cat "$WORK/etude.log" >&2
    echo "run: result: refused: etude's set driver did not build" >&2; exit 1
fi
ETUDE_LEGACY=$WORK/etude/etude-legacy
SCHEMAS=$REPO/tools/etude/schemas
RECORD=$WORK/prepare.record
RESULTS=${RACH2_RESULTS:-$WORK/results}
FAILED=${RACH2_FAILED:-$REPO/build/tests/failed}
mkdir -p "$RESULTS" "$FAILED"
RESULTS=$(cd "$RESULTS" && pwd) || exit 1
FAILED=$(cd "$FAILED" && pwd) || exit 1
# The families of cases, `FAMILY PATH` a line, each checked by its schema and
# rules first, so that a manifest at fault refuses every run; a suite is run
# by the family whose identity ends in its name.
# shellcheck disable=SC2086 # one manifest a word
"$WORK/etude/casecheck" -s "$SCHEMAS" families $MANIFESTS > "$WORK/families" || {
    echo "run: result: refused: a case manifest of tests/cases is at fault" >&2; exit 1
}
family_of() { # family_of SUITE: the line of the suite's family, or nothing
    awk -v s="$1" '{ n = split($1, part, "."); if (part[n] == s) { print; exit } }' "$WORK/families"
}
# The suites the driver runs, one a line with the manifest of the suite's
# cases; `style` and `host` run first, one at a time, and a failure of `style`
# stops the set, since the fix of a style fault is an edit, which changes the
# GNU root's sources. The map gives each suite its family of cases.
: > "$WORK/map"
for suite in "$@"; do
    case "$suite" in
        style) flags=" serial stops" ;;
        host) flags=" serial" ;;
        *) flags="" ;;
    esac
    family=$(family_of "$suite")
    [ -n "$family" ] || {
        echo "run: result: refused: no family of cases in tests/cases is the suite $suite" >&2; exit 2
    }
    [ ! -f "$WORK/chosen/$suite.json" ] || family="${family%% *} $WORK/chosen/$suite.json"
    echo "$suite$flags cases=${family#* }"
    echo "$suite ${family%% *}" >> "$WORK/map"
done > "$WORK/selection"
# The driver's ledger is the run's own: the machine's admission is the claim
# the run has already, the installed launcher's or the caller's, which counts
# memory alone. The ledger bounds the pool by its width, WORKERS, and by
# MEMORY_MIB of guest memory beside the 128 MiB a claim adds for each QEMU;
# a suite larger than the memory budget runs alone. Processors and disk are
# shared among the machine's runs, so neither keeps the pool below its width:
# the ledger has room for WORKERS machines of RACH2_CPUS processors each, and
# its disk is the free space of the build tree.
free_kib=$(df -Pk "$REPO/build/tests" 2>/dev/null | awk 'NR == 2 { print $4 }')
case "$free_kib" in ''|*[!0-9]*|0) free_kib=$((WORKERS * 1048576)) ;; esac
capacity="$((WORKERS * RACH2_CPUS * 1000)),$(((MEMORY_MIB + WORKERS * 128) * 1048576)),$((free_kib * 1024))"
# A set that boots no machine holds no port block, and its suites take the
# table's ports as they are, as suites.mk reads an unset offset.
[ -n "${RACH2_PORT_OFFSET:-}" ] || { RACH2_PORT_OFFSET=0; export RACH2_PORT_OFFSET; }
commit=$(git -C "$REPO" rev-parse --verify -q HEAD 2>/dev/null) || commit=""
case "$commit" in *[!0-9a-f]*) commit="" ;; esac
[ "$(git -C "$REPO" rev-parse --show-toplevel 2>/dev/null)" = "$REPO" ] || commit=""
# The installed site policy that admitted this run, whose line
# `boundary_lazy bigmem-boundary-v1` lets a machine case boot the lazy
# 72 GiB boundary profile; a run admitted by no site has none.
admitted=""
[ "${ETUDE_ADMITTED:-}" != "$site" ] || admitted=$site
# shellcheck disable=SC2329 # run from the traps
forward() { SIGNALLED=$1; [ -z "$DRIVER" ] || kill "-$1" "$DRIVER" 2>/dev/null; }
trap 'forward INT' INT; trap 'forward TERM' TERM; trap 'forward HUP' HUP
# shellcheck disable=SC2086 # the options are one word each or none
"$ETUDE_LEGACY" set -t "$REPO" -a "$ARCH" ${RACH2_KERNEL:+-n "$RACH2_KERNEL"} \
    -l "$WORK/ledger" -c "$capacity" -j "$WORKERS" -o "$RESULTS" -e "$FAILED" \
    -S "$SCHEMAS" -K "$WORK/etude/casecheck" -p "$RECORD" -r "$STATUS_RECORD" -m "$WORK/images.stamp" \
    ${commit:+-g "$commit"} ${RACH2_STOP_ON_FAIL:+-k} ${admitted:+-P "$admitted"} -q "$*" "$WORK/selection" &
DRIVER=$!
watch_scripts &
WATCHER=$!
while :; do
    wait "$DRIVER"
    driver_rc=$?
    kill -0 "$DRIVER" 2>/dev/null || break
done
stream="$RESULTS/history/tests.$ARCH.*.$DRIVER.jsonl"
DRIVER=""
kill "$WATCHER" 2>/dev/null
wait "$WATCHER" 2>/dev/null
WATCHER=""
trap 'SIGNALLED=1; finish; echo "run: result: interrupted by int" >&2; exit 130' INT
trap 'SIGNALLED=1; finish; echo "run: result: interrupted by term" >&2; exit 143' TERM
trap 'SIGNALLED=1; finish; echo "run: result: interrupted by hup" >&2; exit 129' HUP
case "$driver_rc" in
    2) echo "run: result: refused: etude-legacy did not run the set" >&2; exit 2 ;;
    3) [ -n "$SIGNALLED" ] || { echo "run: result: refused: preparation failed" >&2; exit 1; } ;;
esac
# The verdict: the formatter's lines of the run's history, with a run
# voided by a changed script or product, or with a file under the images that
# no suite of it owns, failed by that name as well.
extra=""
{ [ ! -f "$WORK/voided" ] && check_hashes; } || extra="-f voided"
[ ! -f "$RECORD" ] || sed -n 's/^file [^ ]* [^ ]* [^ ]* [^ ]* //p' "$RECORD" > "$WORK/inventory.products"
check_images "$*" || extra="$extra -f images"
# shellcheck disable=SC2086 # the options are one word each
# shellcheck disable=SC2086 # the stream is a pattern of one file
"$WORK/etude/history_lines" -s "$SCHEMAS" $extra "$WORK/map" $stream
lines_rc=$?
if [ -n "$SIGNALLED" ]; then
    case "$SIGNALLED" in
        INT) echo "run: result: interrupted by int" >&2; exit 130 ;;
        HUP) echo "run: result: interrupted by hup" >&2; exit 129 ;;
        *) echo "run: result: interrupted by term" >&2; exit 143 ;;
    esac
fi
if [ "$lines_rc" = 0 ] && [ "$driver_rc" != 0 ]; then
    echo "run: runner: etude-legacy exited with status $driver_rc" >&2
    echo "run: result: failed: runner" >&2
    exit 1
fi
[ "$lines_rc" = 0 ] || exit 1
exit 0
