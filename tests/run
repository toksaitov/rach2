#!/usr/bin/env sh
#
# tests/run: the one way to run a test suite.
#
#   tests/run NAME              one suite
#   tests/run NAME NAME...      those suites, at the same time
#   tests/run core              the tier `make test` runs
#   tests/run all               every suite
#
# The suites themselves live in tests/system/suites.mk, one `run-NAME` target
# each; tests/registry lists their names, the external commands they need, and
# which tier they belong to. This file decides only what runs, when, and how a
# failure is reported.
#
set -u

# The run is a process group of its own, so that stopping it stops every
# make, recipe and machine it started and nothing above it: a runner started
# from a script shares its parent's group, and a signal to that group would
# take the parent as well. The group is made by an exec through perl, since
# the shell has no way to make one; without perl the run keeps the group it
# was given and stops only what its ledgers name.
if [ -z "${RACH2_RUN_GROUP:-}" ] && command -v perl >/dev/null 2>&1; then
    RACH2_RUN_GROUP=1; export RACH2_RUN_GROUP
    exec perl -e 'setpgrp(0, 0); exec @ARGV or die "run: exec: $!\n"' -- sh "$0" "$@"
fi
unset RACH2_RUN_GROUP # a runner started under this one makes a group of its own

REPO=$(cd "$(dirname "$0")/.." && pwd)
# e2fsprogs, where a package manager keeps it off the path; the suites that
# name mke2fs or e2fsck find them where the build does.
# Where the tree has it; the runner's own self-test drives a tree that does not.
[ -f "$REPO/tools/setup/e2fsprogs_path.sh" ] && . "$REPO/tools/setup/e2fsprogs_path.sh"
REGISTRY="$REPO/tests/registry"
[ -f "$REGISTRY" ] || { echo "run: result: refused: missing $REGISTRY" >&2; exit 1; }

# How many suites run at once. A suite spends most of its life waiting for an
# emulated machine rather than computing, so the useful count is above the
# core count: on a ten-core machine the full run takes 1286s at four workers,
# 728 at eight, 587 at twelve, 527 at sixteen and 499 at twenty, and stops
# improving there. Twice the processors lands on that knee.
workers_default() {
    n=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
    case "$n" in ''|*[!0-9]*) n=4 ;; esac
    n=$((n * 2))
    [ "$n" -lt 4 ] && n=4
    echo "$n"
}
# The deadline variables are this runner's to set: a set measures its own
# factor, and a suite run by itself keeps its numbers as written, whatever
# was inherited from the environment.
unset RACH2_DEADLINES RACH2_DEADLINE_FACTOR
WORKERS="${RACH2_WORKERS:-$(workers_default)}"
case "$WORKERS" in
    ''|*[!0-9]*) echo "run: result: refused: RACH2_WORKERS must be a positive whole number" >&2; exit 2 ;;
esac
# `00` is digits and is zero, and a pool of zero waits for a worker that never
# frees. The value is compared as a number from here on, so it is made one.
WORKERS=$((WORKERS + 0))
[ "$WORKERS" -ge 1 ] || { echo "run: result: refused: RACH2_WORKERS must be a positive whole number" >&2; exit 2; }

# Scratch for this run: one ledger per suite, the held output of each pooled
# suite, and the shim that writes the ledgers.
WORK=$(mktemp -d "${TMPDIR:-/tmp}/rach2-run.XXXXXX")
# Checked because everything below builds a path on it: an empty value would
# put the shim at /bin/qemu-system-i386 and delete / on the way out.
[ -d "$WORK" ] || { echo "run: result: refused: no scratch directory" >&2; exit 1; }

# What this run owns: its descendants by the process table, which reaches
# the makes, recipes and machines under it and the ones the harness's
# deadline put in groups of their own; the members of its process group;
# and the machines in the ledgers. The end of a run, on a signal or in the
# ordinary way, stops what is still owned and waits until it is gone: TERM,
# then KILL two seconds later, five seconds at most, and what is left after
# that is named. A signal besides stops further starts and prints what the
# unfinished suites had written; the exit is the signal's. `finish` runs
# once: the trap calls it and the EXIT trap finds it done.
OWN_PGID=$(ps -o pgid= -p $$ | tr -d ' ')
PGID=$OWN_PGID
[ "$PGID" = "$$" ] || PGID="" # not a group of its own: only the ledgers are stopped
STOPPING=""
owned() {
    # The listing's own processes, the substitution's subshell and what it
    # started, are not the run's: every process under the one that ran `ps`
    # is left out, whether reached through the table or through the group.
    ps -axo pid=,ppid= > "$WORK/ps" 2>/dev/null &
    self=$!; wait "$self"
    { [ -n "$PGID" ] && pgrep -g "$PGID" 2>/dev/null; :; } > "$WORK/group"
    awk -v root="$$" -v self="$self" '
        FILENAME == ARGV[1] { kid[$1] = $2; next }
        { group[$1] = 1 }
        END {
            for (q = self; (q in kid) && q != root; q = kid[q]) skip[q] = 1
            for (p in kid) {
                q = p; n = 0
                while ((q in kid) && q != root && !(q in skip) && n++ < 1000) q = kid[q]
                if (q in skip) continue
                if (q == root && p != root || p in group) print p
            }
            for (p in group) if (!(p in kid)) print p
        }' "$WORK/ps" "$WORK/group"
    for f in "$WORK"/*.machines; do
        [ -f "$f" ] && cat "$f"
    done
    :
}
owned_live() { owned | sort -u | while read -r p; do [ -n "$p" ] && [ "$p" != "$$" ] && kill -0 "$p" 2>/dev/null && echo "$p"; done; }
owned_kill() {
    for pid in $(owned_live); do kill "-$1" "$pid" 2>/dev/null; done
}
owned_wait() { # owned_wait TENTHS: 0 when nothing owned is left within the time
    i=0
    while [ "$i" -lt "$1" ]; do
        [ -z "$(owned_live)" ] && return 0
        sleep 0.1; i=$((i + 1))
    done
    [ -z "$(owned_live)" ]
}
owned_stop() {
    owned_kill TERM
    owned_wait 20 && return 0
    owned_kill KILL
    owned_wait 30 && return 0
    echo "run: still running after the stop: $(owned_live | tr '\n' ' ')" >&2
    return 1
}
SIGNALLED=""
FINISHED=""
# shellcheck disable=SC2329 # run from the traps
finish() {
    [ -z "$FINISHED" ] || return 0
    FINISHED=1
    trap '' INT TERM HUP
    STOPPING=1
    for suite in $RUNNING_NAMES; do
        [ -f "$WORK/$suite.out" ] || continue
        if [ -f "$WORK/$suite.rc" ]; then
            cat "$WORK/$suite.out" # ended, not yet reported
        elif [ -n "$SIGNALLED" ]; then
            echo "run: $suite: stopped before its end; its output so far:"
            cat "$WORK/$suite.out"
        fi
    done
    [ -z "$(owned_live)" ] || owned_stop
    rm -rf "$WORK"
    lock_release
}
RUNNING=""; RUNNING_NAMES=""
trap 'finish' EXIT
trap 'SIGNALLED=1; finish; exit 130' INT
trap 'SIGNALLED=1; finish; exit 143' TERM
trap 'SIGNALLED=1; finish; exit 129' HUP
# One run at a time on a tree: two share `build/` and its images, and each
# suite kills what runs under its directory at its start. The lock is a
# directory, made atomically, holding the owner's pid, process group,
# scratch directory and arguments. A lock with no owner file yet is one
# being taken this moment, until it is ten seconds old. A lock whose owner
# is gone is taken over only when nothing of its group and none of its
# ledgers' machines is left: a runner killed with KILL cannot clean up, and
# its makes and machines may still be running; they are named for the
# person to stop. The takeover moves the old lock aside by rename, which
# one taker at most can do. The pid alone does not say the owner is alive,
# since pids are reused; the pid is the owner's while its group is the
# recorded one.
LOCK="$REPO/build/.run.lock"
lock_field() { sed -n "s/^$1 //p" "$LOCK/owner" 2>/dev/null; }
lock_owner_alive() {
    opid=$(lock_field pid)
    [ -n "$opid" ] && [ "$(ps -o pgid= -p "$opid" 2>/dev/null | tr -d ' ')" = "$(lock_field pgid)" ]
}
lock_being_taken() {
    [ ! -f "$LOCK/owner" ] && [ -n "$(find "$LOCK" -maxdepth 0 -newermt '-10 seconds' 2>/dev/null)" ]
}
lock_survivors() {
    opgid=$(lock_field pgid)
    {
        [ -n "$opgid" ] && pgrep -g "$opgid" 2>/dev/null
        owork=$(lock_field work)
        [ -n "$owork" ] && cat "$owork"/*.machines 2>/dev/null
        :
    } | sort -u | while read -r p; do [ -n "$p" ] && kill -0 "$p" 2>/dev/null && echo "$p"; done | tr '\n' ' '
}
lock_take() {
    mkdir -p "$REPO/build"
    if mkdir "$LOCK" 2>/dev/null; then
        :
    elif lock_being_taken; then
        echo "run: another run is taking this tree" >&2
        return 1
    elif lock_owner_alive; then
        echo "run: another run holds this tree: $(lock_field pid), $(lock_field args), since $(lock_field since)" >&2
        return 1
    elif [ -n "$(lock_survivors)" ]; then
        echo "run: a run that is gone left work running: pids $(lock_survivors); stop them before the next run" >&2
        return 1
    else
        echo "run: taking over the lock a run left: $(lock_field pid), $(lock_field args)"
        mv "$LOCK" "$LOCK.old.$$" 2>/dev/null || { echo "run: another run took the tree first" >&2; return 1; }
        rm -rf "$LOCK.old.$$"
        mkdir "$LOCK" 2>/dev/null || { echo "run: another run took the tree first" >&2; return 1; }
    fi
    { echo "pid $$"; echo "pgid $OWN_PGID"; echo "work $WORK"; echo "since $(date '+%Y-%m-%d %H:%M:%S')"; echo "args $*"; } > "$LOCK/owner.new"
    mv "$LOCK/owner.new" "$LOCK/owner"
    LOCKED=1
}
LOCKED=""
# shellcheck disable=SC2329 # run from finish, from the traps
lock_release() {
    [ -n "$LOCKED" ] && [ "$(sed -n 's/^pid //p' "$LOCK/owner" 2>/dev/null)" = "$$" ] && rm -rf "$LOCK"
    LOCKED=""
}

# Each suite names the machines it starts, so a leaked one can be blamed on the
# suite that left it. Listing every QEMU on the host works only while one suite
# runs at a time; with twenty running, each would see the other nineteen. So a
# shim named `qemu-system-i386` goes first on PATH, writes its own pid to the
# ledger of the suite that is running, and then becomes the real QEMU. The
# harness reaches QEMU through execvp and the shell suites through their own
# PATH lookup, so this covers both without either knowing about it.
QEMU_REAL=$(command -v qemu-system-i386 2>/dev/null || true)
if [ -n "$QEMU_REAL" ]; then
    mkdir -p "$WORK/bin"
    {
        echo "#!/bin/sh"
        # shellcheck disable=SC2016 # the shim expands these, not this script
        echo 'test -n "${RACH2_QEMU_LEDGER:-}" && echo $$ >> "$RACH2_QEMU_LEDGER"'
        echo "exec '$QEMU_REAL' \"\$@\""
    } > "$WORK/bin/qemu-system-i386"
    chmod +x "$WORK/bin/qemu-system-i386"
    PATH="$WORK/bin:$PATH"; export PATH
fi

# The registry, one field at a time. Order in the file is the schedule order.
suite_names()  { awk -F'|' '!/^#/ && NF > 1 { print $1 }' "$REGISTRY"; }
suite_tools()  { awk -F'|' -v s="$1" '!/^#/ && $1 == s { print $2 }' "$REGISTRY"; }
suite_known()  { [ -n "$(suite_tools "$1")" ]; }
tier_names()   { awk -F'|' -v t="$1" '!/^#/ && $3 == t { print $1 }' "$REGISTRY"; }

usage_names() {
    suite_names | tr '\n' ' ' | sed 's/^/  /;s/ $//' >&2
    echo >&2
}

# What the host must let the run do, tried and not merely looked up.
# `tools/setup/hostcheck.c` binds a TCP, a UDP and a Unix socket when a chosen
# suite boots a machine, and attaches a disk image when one names hdiutil; a
# refusal stops the run before the build. `RACH2_HOSTCHECK` names another
# checker, which is how the runner's own test drives a refusal.
check_host() {
    checker="${RACH2_HOSTCHECK:-}"
    if [ -z "$checker" ]; then
        checker="$WORK/hostcheck"
        cc -O2 -o "$checker" "$REPO/tools/setup/hostcheck.c" || {
            echo "run: the host check did not compile" >&2; return 1
        }
    fi
    if "$checker" "$WORK" ${1:+"$1"}; then
        return 0
    fi
    echo "run: result: the host refuses an operation the suites need; nothing was built" >&2
    return 1
}

# Every external command a suite needs, before anything is built for it.
check_tools() {
    tools=$(suite_tools "$1")
    [ "$tools" = "-" ] && return 0
    oldifs=$IFS; IFS=,
    for tool in $tools; do
        IFS=$oldifs
        command -v "$tool" >/dev/null 2>&1 || {
            echo "run: $1 needs $tool and it is not installed" >&2
            return 1
        }
    done
    IFS=$oldifs
}

# A suite must stop every machine it starts. One left running costs a
# processor and a few hundred megabytes until the host reboots, and nothing
# else notices: the suite passed, and the pid now belongs to init.
check_machines() {
    ledger="$WORK/$1.machines"
    [ -f "$ledger" ] || return 0
    # A machine told to stop takes a moment to go: it flushes what it was
    # given and writes its own records first. Asking once, the instant the
    # suite's last command returns, calls that a machine left behind and fails
    # a suite whose every row passed, which is what this check cost on
    # 2026-09-13. A few seconds turn the race into a check, and a machine that
    # really was left is still there after them.
    tries=0
    while :; do
        leaked=""
        while read -r pid; do
            [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && leaked="$leaked $pid"
        done < "$ledger"
        [ -z "$leaked" ] && return 0
        [ "$tries" -ge 5 ] && break
        tries=$((tries + 1))
        sleep 1
    done
    echo "run: $1: left$leaked running; a suite must stop every machine it starts" >&2
    # Stopped here as well as reported. The suite failed either way, and a
    # machine left behind costs a processor and a few hundred megabytes until
    # the host reboots.
    for pid in $leaked; do kill "$pid" 2>/dev/null; done
    return 1
}

# A make run under the runner is started in the background and waited for,
# since the shell runs a trap at once while it waits and only after the
# command ends while one runs in the foreground: a signal then stops the run
# at once, and the group kill takes the make and what it started.
run_make() {
    if command -v perl >/dev/null 2>&1; then
        # A background job of a non-interactive shell ignores INT and QUIT
        # and would hand that on to every test; perl puts them back.
        perl -e '$SIG{INT} = "DEFAULT"; $SIG{QUIT} = "DEFAULT"; exec @ARGV or die "run: exec: $!\n"' -- \
            make -C "$REPO" --no-print-directory "$@" &
        wait $!
    else
        make -C "$REPO" --no-print-directory "$@"
    fi
}

# The name and the tools were checked before anything was built, so this does
# not repeat them; it runs the target and then reads the ledger the shim wrote.
# A suite run on its own builds what its own target names, in parallel, and
# nothing else: `tests/run host` after an edit to a utility does not restage
# five images and two ISOs first. In a set, `prepare` has built everything.
# The components were built before either, in a Make of their own.
run_one() {
    start=$(date +%s)
    RACH2_QEMU_LEDGER="$WORK/$1.machines"; export RACH2_QEMU_LEDGER
    : > "$RACH2_QEMU_LEDGER"
    rc=0
    if [ "${2-}" = alone ]; then
        # What the target names is built first and hashed, then the suite
        # runs against those files; one make of both would hash a build in
        # progress or a suite already run.
        # An e1000 suite's target is a wrapper that runs the plain one with
        # NIC set, so the products are the plain target's.
        target="run-$1"
        case "$1" in *-e1000) target="run-${1%-e1000}" ;; esac
        products=$(closure "$target" | grep '^build/')
        # shellcheck disable=SC2086 # the prerequisites are one word each
        [ -z "$products" ] || run_make -j $products || rc=1
        [ "$rc" = 0 ] && take_products "$target"
        [ "$rc" = 0 ] && { run_make "run-$1" || rc=1; }
    else
        run_make "run-$1" || rc=1
    fi
    check_machines "$1" || rc=1
    if [ "$rc" = 0 ]; then
        echo "run: $1: PASS in $(($(date +%s) - start))s"
    else
        echo "run: $1: FAIL in $(($(date +%s) - start))s" >&2
    fi
    return "$rc"
}

# The given suites, at most $WORKERS at a time, each one's output held while
# it runs and printed whole the moment it ends, in the order they end: twenty
# suites writing to one terminal is not a report, and a report an hour late
# is not one either. A suite's result is its `.rc` file, written beside and
# moved into place after its output is closed, so a reader never sees an
# empty result; a job that is gone with no result failed. The failures are
# left in POOL_FAILED rather than printed, because a caller reading this
# through a command substitution would run it in a subshell and the output
# would go there instead of to the person waiting. With RACH2_STOP_ON_FAIL
# set, the first failure stops the pool: what is queued does not start, and
# what is running is stopped and reported as stopped.
POOL_FAILED=""
run_pool() {
    POOL_FAILED=""; RUNNING=""; RUNNING_NAMES=""; stopped=""; poll_turns=0
    # shellcheck disable=SC2086 # the names are one word each; this drops the leading space
    set -- $1; pending="$*"
    while [ -n "$pending" ] || [ -n "$RUNNING_NAMES" ]; do
        pool_collect
        # Admit while there is room and nothing has stopped the pool.
        while [ -n "$pending" ] && [ -z "$stopped" ] && [ -z "$STOPPING" ] &&
              [ "$(alive "$RUNNING")" -lt "$WORKERS" ]; do
            suite=${pending%% *}
            case "$pending" in *" "*) pending=${pending#* } ;; *) pending="" ;; esac
            ( run_one "$suite" > "$WORK/$suite.out" 2>&1; echo $? > "$WORK/$suite.rc.new";
              mv "$WORK/$suite.rc.new" "$WORK/$suite.rc" ) &
            echo $! > "$WORK/$suite.job"
            RUNNING="$RUNNING $!"
            RUNNING_NAMES="$RUNNING_NAMES $suite"
        done
        pool_collect
        if [ -n "$stopped" ]; then
            [ -z "$pending" ] || {
                echo "run: stopped on the first failure; not started:$(echo " $pending" | sed 's/  */ /g')"
                POOL_FAILED="$POOL_FAILED $pending"; pending=""
            }
            [ -z "$RUNNING_NAMES" ] || {
                echo "run: stopped on the first failure; stopped part way:$(echo " $RUNNING_NAMES" | sed 's/  */ /g')"
                owned_stop
                for suite in $RUNNING_NAMES; do
                    [ -f "$WORK/$suite.rc" ] || { echo "run: $suite: stopped" >> "$WORK/$suite.out"; echo 1 > "$WORK/$suite.rc"; }
                done
                pool_collect
            }
        fi
        poll_turns=$((poll_turns + 1))
        if [ "$((poll_turns % 10))" -eq 0 ] && [ -z "$stopped" ] && ! check_scripts_now; then
            echo "run: stopping the set: the tree changed under it" >&2
            stopped=1
        fi
        [ -z "$pending" ] && [ -z "$RUNNING_NAMES" ] || sleep 0.2
    done
    RUNNING=""
}

# The suites that ended since the last look, each reported once and its
# held output removed, so an interrupted run does not print it twice.
pool_collect() {
    for suite in $RUNNING_NAMES; do
        if [ -f "$WORK/$suite.rc" ]; then
            :
        elif job_of "$suite"; then
            continue
        elif [ -f "$WORK/$suite.rc" ]; then
            : # it ended, and wrote its result, between the two looks
        else
            echo 1 > "$WORK/$suite.rc" # gone with no result
            echo "run: $suite: ended without a result" >> "$WORK/$suite.out"
        fi
        cat "$WORK/$suite.out" 2>/dev/null
        rm -f "$WORK/$suite.out"
        read -r rc < "$WORK/$suite.rc"
        [ "$rc" = 0 ] || POOL_FAILED="$POOL_FAILED $suite"
        [ "$rc" = 0 ] || [ -z "${RACH2_STOP_ON_FAIL:-}" ] || stopped=1
        RUNNING_NAMES=$(echo " $RUNNING_NAMES " | sed "s/ $suite / /" | sed 's/^ *//;s/ *$//')
    done
}
# Whether the job running `$1` is still alive.
job_of() {
    pid=$(cat "$WORK/$1.job" 2>/dev/null)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

alive() { n=0; for p in $1; do kill -0 "$p" 2>/dev/null && n=$((n + 1)); done; echo "$n"; }

# What a run reads, and must not change while it runs: the scripts that
# decide a result and the tools that judge one, hashed when the run starts,
# and the kernels and the products the run's target builds, hashed once
# they are built, read from make's own database (`make -pn`), which lists
# every target with its prerequisites expanded, so the list is what make
# builds and not a list kept by hand. Both are hashed again at the end,
# whatever the result; a difference, or a file gone, voids the run by name.
# Two equal hashes do not say the file stood still in between; they say
# what the result was made with is what is there now.
closure() { # closure TARGET: the file prerequisites reachable from TARGET
    make -C "$REPO" -pn "$1" 2>/dev/null | awk -v root="$1" '
        /^#/ || /^$/ { next }
        /^[^ \t:=]+:[^=]/ {
            t = $1; sub(/:$/, "", t)
            n = split($0, f, /[ \t]+/)
            for (i = 2; i <= n; i++) if (f[i] != "" && f[i] != "|") deps[t] = deps[t] " " f[i]
            cur = t; next
        }
        /^\t/ && cur == "prepare-all" { # its halves are named by its recipe
            n = split($0, f, /[ \t]+/)
            for (i = 1; i <= n; i++) if (f[i] ~ /^prepare-/) deps[cur] = deps[cur] " " f[i]
            next
        }
        /^\t/ { next }
        END {
            queue[1] = root; head = 1; tail = 1; seen[root] = 1
            while (head <= tail) {
                t = queue[head++]
                m = split(deps[t], d, " ")
                for (i = 1; i <= m; i++) if (d[i] != "" && !(d[i] in seen)) { seen[d[i]] = 1; queue[++tail] = d[i] }
            }
            for (x in seen) if (x ~ /^build\// || x ~ /\//) print x
        }' | sort
}
present() { ( cd "$REPO" && while read -r f; do [ -f "$f" ] && echo "$f"; done ) | sort -u; }
scripts_inventory() {
    ( cd "$REPO" && {
        echo tests/run; echo tests/registry; echo tests/system/suites.mk; echo Makefile
        ls mk/*.mk tests/system/*.sh tests/system/suites/*.sh tests/system/accept/*.sh \
           tools/image/*.sh krffs/*.sh tools/verify/check.sh krffs/manifests/* 2>/dev/null
    } ) | present
}
products_inventory() { # products_inventory TARGET
    ( cd "$REPO" && ls build/rach2*/kernel 2>/dev/null; closure "$1" ) | present
}
hasher() {
    if command -v shasum >/dev/null 2>&1; then shasum -a 256; else sha256sum; fi
}
hash_list() { # hash_list LIST OUT: each file's hash, or `gone` for one missing
    ( cd "$REPO" && while read -r f; do
        if [ -f "$f" ]; then hasher < "$f" | sed "s|-\$|$f|"; else echo "gone  $f"; fi
      done < "$1" ) > "$2"
}
take_scripts() {
    scripts_inventory > "$WORK/inventory.scripts"
    hash_list "$WORK/inventory.scripts" "$WORK/hashes.scripts"
}
take_products() { # take_products TARGET
    products_inventory "$1" > "$WORK/inventory.products"
    hash_list "$WORK/inventory.products" "$WORK/hashes.products"
}
# The sources are checked as the set runs, not only at its end. A file changed
# under a run voids it, and learning that ninety minutes later costs the whole
# run; on 2026-09-13 it cost one. Hashing the scripts is cheap and it is the
# case that happens: a product changes because a source did, and the products
# are large, so they are left to the check at the end.
check_scripts_now() { # 0 when no source has changed since the set began
    [ -f "$WORK/hashes.scripts" ] || return 0
    hash_list "$WORK/inventory.scripts" "$WORK/hashes.scripts.now"
    cmp -s "$WORK/hashes.scripts" "$WORK/hashes.scripts.now" && return 0
    diff "$WORK/hashes.scripts" "$WORK/hashes.scripts.now" |
        awk '/^>/ {print $3}' | sort -u | while read -r f; do
            echo "run: voided: $f changed during the run" >&2
        done
    return 1
}

check_hashes() { # 0 when nothing hashed differs or is gone
    voided=""
    for kind in scripts products; do
        [ -f "$WORK/inventory.$kind" ] || continue
        hash_list "$WORK/inventory.$kind" "$WORK/hashes.$kind.after"
        cmp -s "$WORK/hashes.$kind" "$WORK/hashes.$kind.after" && continue
        diff "$WORK/hashes.$kind" "$WORK/hashes.$kind.after" | awk '/^>/ {print $3}' | sort -u | while read -r f; do
            echo "run: voided: $f changed during the run" >&2
        done
        voided=1
    done
    [ -z "$voided" ]
}
# The components first, in a Make of their own: an image rule that meets a
# program and the component that builds it in one Make reads the program's
# time before the component has run, and keeps the old image. Then, for a
# set, the product and the test tools once, so no two suites build at once. A
# suite run alone builds its own images through its own target.
build_components() {
    run_make -j components || {
        echo "run: result: refused: the components did not build" >&2; exit 1
    }
}
prepare() {
    echo "run: preparing"
    run_make -j prepare-all || {
        echo "run: result: refused: preparation failed" >&2; exit 1
    }
}

# The deadline factor of a set. `tests/system/calibrate.sh` boots WIDTH
# machines at once and times fixed work of two kinds, computing and storage,
# by the host's clock; each kind's factor is its time against the reference
# measured idle at width 1, and the factor passed is the larger, which
# bounds both kinds, times a margin for the pool's mixed load, which the
# calibration's uniform machines do not make, rounded up to a tenth. A factor
# above the envelope fails the set by name: a host that slow does not run
# the set in the day, and a longer deadline would only hide it. The
# references: 2026-09-11, the owner's Mac mini, idle, calibprobe as it is.
REF_COMPUTE=1.2
REF_STORAGE=2.5
CAL_MARGIN=1.5
CAL_ENVELOPE=8.0
# A host busy for a minute is not a host that cannot run the set, and refusing
# the set costs everything it would have told. A measurement past the envelope
# is taken again once, after a wait, before the set is refused. A factor given
# by hand is not measured and is never retried. `RACH2_CALIBRATION_RETRY=0`
# turns the retry off, which is what a test of the refusal itself wants.
CAL_RETRY=${RACH2_CALIBRATION_RETRY:-1}
CAL_RETRY_WAIT=${RACH2_CALIBRATION_RETRY_WAIT:-60}
calibrate() { # calibrate WIDTH -> CAL_FACTOR, or 1 on a failure
    if [ -n "${RACH2_CALIBRATION_FACTOR:-}" ]; then
        # A factor given by hand is held to the same form and envelope.
        case "$RACH2_CALIBRATION_FACTOR" in
            *[!0-9.]*|.*|*.|*.*.*|'') echo "run: RACH2_CALIBRATION_FACTOR must be a decimal such as 2.5" >&2; return 1 ;;
        esac
        CAL_FACTOR=$(awk -v f="$RACH2_CALIBRATION_FACTOR" -v envelope="$CAL_ENVELOPE" 'BEGIN {
            f = int(f * 10 + 0.999) / 10; if (f < 1) f = 1
            if (f > envelope) { printf "run: result: refused: the factor %.1f given is past the envelope of %.1f\n", f, envelope > "/dev/stderr"; exit 1 }
            printf "%.1f\n", f }') || return 1
        echo "run: calibration: width $1, factor $CAL_FACTOR given by RACH2_CALIBRATION_FACTOR"
        return 0
    fi
    out=$(sh "$REPO/tests/system/calibrate.sh" "$1" "$WORK/calibrate.$1") || {
        echo "run: calibration at width $1 did not finish: $out" >&2; return 1
    }
    CAL_FACTOR=$(printf '%s\n' "$out" | awk -v rc="$REF_COMPUTE" -v rs="$REF_STORAGE" -v margin="$CAL_MARGIN" -v envelope="$CAL_ENVELOPE" -v width="$1" '
        { for (i = 1; i <= NF; i++) { split($i, kv, "="); v[kv[1]] = kv[2] } }
        END {
            fc = v["compute"] / rc; if (fc < 1) fc = 1
            fs = v["storage"] / rs; if (fs < 1) fs = 1
            f = (fc > fs ? fc : fs) * margin; f = int(f * 10 + 0.999) / 10
            printf "run: calibration: width %d, computing %.1f s against %.1f (%.2f), storage %.1f s against %.1f (%.2f), margin %.1f, factor %.1f\n", width, v["compute"], rc, fc, v["storage"], rs, fs, margin, f > "/dev/stderr"
            if (f > envelope) { printf "run: result: refused: the emulator runs at 1/%.1f of its idle rate at width %d, past the envelope of %.1f\n", f, width, envelope > "/dev/stderr"; exit 1 }
            printf "%.1f\n", f
        }') || return 1
    [ -n "$CAL_FACTOR" ] || return 1
    return 0
}

# `style` rebuilds the kernel with its own flags and shares a scratch directory
# with `host`, so those two run alone, before the pool. `usb` plugs devices
# in and out through QEMU's monitor and loses two rows under host load
# (entry 36 of milestone 50), so it runs alone, after the pool, until that
# is fixed. `diskrate` holds the storage paths under time bounds measured on
# an idle host, and in the pool a row runs three to four times slower than
# alone. `usbdisk`, `sealed` and `mount` were alone for the load of the
# pools of 2026-09-04, whose steps now wait on their own output rather than
# the clock; they run in the pool, and one that loses a step to the load in
# a set is run alone once and, if it passes there, listed here again by hand.
# `install` builds the kernel inside the guest, twice, which is a computation
# the emulator runs at a third of its rate beside eleven other machines: it
# lost that step's 1800 s at twenty and at twelve on 2026-09-10 and passed
# alone in 778 s, so it runs alone. `imagerace` asks make whether a shared
# image is out of date, and every other worker in the pool runs make on the
# same tree: on 2026-09-12 one rebuilt the test image between this suite's
# touch of a staged program and its question, so the answer was that the
# image was current and the suite failed a check that passes alone. It is
# entry 28's rule for a question rather than an artifact, so it runs alone.
# The second measurement, when the first was past the envelope. A factor given
# by hand was not measured, so it is refused as it stands.
calibrate_again() { # calibrate_again WIDTH
    [ -z "${RACH2_CALIBRATION_FACTOR:-}" ] || return 1
    [ "$CAL_RETRY" != 0 ] || return 1
    echo "run: calibration: the host was busy; measuring again in $CAL_RETRY_WAIT s" >&2
    sleep "$CAL_RETRY_WAIT"
    calibrate "$1"
}

# The width the host can carry, which is not always the width it was asked
# for. A machine whose emulator runs slower than the envelope allows at the
# width given is not a machine that cannot run the set: it is one that cannot
# run it that wide. The width comes down a quarter at a time until the
# measurement fits, down to a floor, and the set runs at what fits and says so.
# Refusing instead costs everything the set would have told, and on the host
# this was written on the default width measured 8.1 and 8.2 against an
# envelope of 8.0, so half the sets were refused for a tenth.
CAL_FLOOR=${RACH2_CALIBRATION_FLOOR:-4}
calibrate_fit() { # calibrate_fit WIDTH -> CAL_WIDTH, CAL_FACTOR
    CAL_WIDTH=$1
    calibrate "$CAL_WIDTH" && return 0
    # The one wait is here, for a host that was busy for a minute. Narrowing
    # after it costs a measurement each and no more waiting: a host that is
    # steadily too slow for this width says so at once.
    calibrate_again "$CAL_WIDTH" && return 0
    [ -z "${RACH2_CALIBRATION_FACTOR:-}" ] || return 1
    while [ "$CAL_WIDTH" -gt "$CAL_FLOOR" ]; do
        CAL_WIDTH=$((CAL_WIDTH * 3 / 4))
        [ "$CAL_WIDTH" -lt "$CAL_FLOOR" ] && CAL_WIDTH=$CAL_FLOOR
        echo "run: calibration: narrowing the pool to $CAL_WIDTH and measuring again" >&2
        calibrate "$CAL_WIDTH" && return 0
    done
    return 1
}

run_set() {
    failed=""; serial=""; pooled=""; lone=""
    for suite in $1; do
        case "$suite" in
            style|host) serial="$serial $suite" ;;
            usb|diskrate|install|imagerace) lone="$lone $suite" ;;
            *)          pooled="$pooled $suite" ;;
        esac
    done
    RUNNING=serial
    for suite in $serial; do run_one "$suite" || failed="$failed $suite"; done
    RUNNING=""
    [ -n "$STOPPING" ] && return 1
    if [ -n "$failed" ] && [ -n "${RACH2_STOP_ON_FAIL:-}" ]; then
        echo "run: stopped on a failure; not started:$pooled$lone"
        echo "run: result: failed:$failed" >&2
        return 1
    fi
    # The pool's factor is measured at the width the pool will run at, the
    # smaller of the workers and the suites; the lone suites run one at a
    # time after it and get the factor measured at width 1, which says how
    # this host compares with the reference.
    POOL_FACTOR=""; ALONE_FACTOR=""
    if [ -n "$pooled" ]; then
        n=$(echo "$pooled" | wc -w | tr -d ' ')
        width=$WORKERS; [ "$n" -lt "$width" ] && width=$n
        calibrate_fit "$width" || {
            echo "run: result: the calibration failed" >&2; return 1; }
        width=$CAL_WIDTH
        WORKERS=$width
        POOL_FACTOR=$CAL_FACTOR
    fi
    if [ -n "$lone" ]; then
        calibrate 1 || calibrate_again 1 || {
            echo "run: result: the calibration failed" >&2; return 1; }
        ALONE_FACTOR=$CAL_FACTOR
    fi
    if [ -n "$pooled" ]; then
        RACH2_DEADLINES=scaled; RACH2_DEADLINE_FACTOR=$POOL_FACTOR
        export RACH2_DEADLINES RACH2_DEADLINE_FACTOR
        run_pool "$pooled"; failed="$failed$POOL_FAILED"
        unset RACH2_DEADLINES RACH2_DEADLINE_FACTOR
    fi
    RUNNING=serial
    for suite in $lone; do
        [ -n "$failed" ] && [ -n "${RACH2_STOP_ON_FAIL:-}" ] && { echo "run: stopped on a failure; not started: $suite"; failed="$failed $suite"; continue; }
        RACH2_DEADLINES=scaled; RACH2_DEADLINE_FACTOR=$ALONE_FACTOR
        export RACH2_DEADLINES RACH2_DEADLINE_FACTOR
        run_one "$suite" || failed="$failed $suite"
        unset RACH2_DEADLINES RACH2_DEADLINE_FACTOR
    done
    RUNNING=""
    [ -n "$STOPPING" ] && return 1
    [ -z "$failed" ] && return 0
    echo "run: result: failed:$failed" >&2
    return 1
}

case "${1-}" in
    '')
        echo "usage: tests/run NAME [NAME...] | core | all" >&2
        echo "run: result: refused: no suite named" >&2; usage_names; exit 2 ;;
    all|core)
        # A set and a name in one command would read as "the set and also
        # this", and the set is not being added to. Refused rather than
        # silently dropped.
        [ "$#" -eq 1 ] || {
            echo "run: result: refused: '$1' is a whole set; it takes no other names" >&2; exit 2
        }
        if [ "$1" = all ]; then
            # shellcheck disable=SC2046 # a suite name is one word by format
            set -- $(suite_names)
        else
            # shellcheck disable=SC2046 # a suite name is one word by format
            set -- $(tier_names core)
        fi ;;
esac

# Every name and every tool, before a single object is built: a run that is
# going to refuse the last suite should refuse it now rather than in an hour.
[ "$#" -gt 0 ] || { echo "run: result: refused: no suites in that set" >&2; exit 2; }
seen=""
for suite in "$@"; do
    suite_known "$suite" || {
        echo "run: result: refused: unknown suite '$suite'" >&2; usage_names; exit 2
    }
    # Twice in one command means two runs sharing one ledger and one held
    # output, where the second result overwrites the first.
    case " $seen " in
        *" $suite "*) echo "run: result: refused: $suite is named twice" >&2; exit 2 ;;
    esac
    seen="$seen $suite"
    check_tools "$suite" || { echo "run: result: refused: $suite has no tools to run with" >&2; exit 1; }
done
diskimage=""
sockets="--no-sockets"
for suite in "$@"; do
    case ",$(suite_tools "$suite")," in
        *,hdiutil,*) diskimage="--diskimage" ;;
    esac
    case "$suite" in
        style|host) ;;
        *) sockets="" ;;
    esac
done
check_host $diskimage $sockets || { echo "run: result: refused: this host cannot run the set" >&2; exit 1; }

# A runner whose lock is gone but whose processes are not: the lock covers
# the ordinary case, and this covers the tree whose lock was removed by hand
# while a set was still running.
others=$(pgrep -f "sh $0" 2>/dev/null | grep -v "^$$\$" | tr '\n' ' ' | sed 's/ $//')
if [ -n "$others" ]; then
    echo "run: result: refused: another runner is still running: pids $others" >&2
    exit 1
fi
lock_take "$@" || { echo "run: result: refused: the tree is not free" >&2; exit 1; }
# The line that says this run began. Everything below it belongs to this run,
# and a log without it is a run that never started.
echo "run: starting: $* (pid $$, $(date '+%Y-%m-%d %H:%M:%S'))"
# The recovery system starts an SSH server only where a key was built into it,
# and the suites that repair or update a machine do that work through recovery
# over SSH. The key is minted here: after the names are checked and the tree is
# this run's, so two runners cannot mint at once, and before the first make,
# because make decides from the key's presence what the recovery artifacts are
# called. A plain `make` mints nothing, which is what keeps the absence
# meaningful; the tree the runner's own selftest drives has no recovery system
# at all, which is why the manifest is looked for and not the key alone.
if [ -f "$REPO/krffs/manifests/rach2-recovery.manifest" ] &&
   [ ! -f "$REPO/krffs/recovery_authorized_keys" ]; then
    make -C "$REPO" --no-print-directory recovery-key || {
        echo "run: the recovery system's key could not be made" >&2
        exit 1
    }
fi
take_scripts
build_components
rc=0
if [ "$#" -eq 1 ]; then
    RUNNING=serial
    run_one "$1" alone || rc=1
    RUNNING=""
else
    prepare
    take_products prepare-all
    run_set "$*" || rc=1
fi
check_hashes || rc=1
[ "$rc" = 0 ] && [ "$#" -gt 1 ] && echo "run: result: all $# suites passed"
exit "$rc"
