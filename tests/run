#!/usr/bin/env sh
#
# tests/run: the one way to run a test suite.
#
#   tests/run NAME              one suite
#   tests/run NAME NAME...      those suites, at the same time
#   tests/run core              the tier `make test` runs
#   tests/run all               every suite
#   tests/run inventory         every suite with what it proves, as Markdown
#
# The suites themselves live in tests/system/suites.mk, one `run-NAME` target
# each; tests/registry lists their names, the external commands they need, and
# which tier they belong to. This file decides only what runs, when, and how a
# failure is reported.
#
set -u

# RACH2_KERNEL=NAME boots every suite on build/rach2-NAME/kernel, built by
# the NAME-kernel target of tests/system/suites.mk (ubsan, o2) before the
# rest of the preparation, since the images the preparation stages hold that
# kernel; unset, the suites boot build/rach2/kernel.
KERNEL_VAR=""
if [ -n "${RACH2_KERNEL:-}" ]; then
    KERNEL_VAR="BOOT_KERNEL=build/rach2-${RACH2_KERNEL}/kernel"
fi

REPO=$(cd "$(dirname "$0")/.." && pwd)
# Compile the host helper in private scratch before making a process group.
# No product or shared build file is written by this bootstrap.
if [ "${RACH2_RUN_GROUP:-}" != "$$" ]; then
    WORK=$(mktemp -d "${TMPDIR:-/tmp}/rach2-run.XXXXXX") || exit 1
    if ! cc -O2 -Wall -Wextra -o "$WORK/runutil" "$REPO/tests/system/runner/runutil.c"; then
        echo "run: result: refused: the runner helper did not compile" >&2
        rm -rf "$WORK"; exit 1
    fi
    RACH2_RUN_GROUP=$$; RACH2_RUN_WORK=$WORK; RACH2_RUN_UTIL=$WORK/runutil
    export RACH2_RUN_GROUP RACH2_RUN_WORK RACH2_RUN_UTIL
    exec "$RACH2_RUN_UTIL" group sh "$0" "$@"
fi
WORK=$RACH2_RUN_WORK
trap 'rm -rf "$WORK"' 0
unset RACH2_RUN_GROUP RACH2_RUN_WORK RACH2_PROGRESS_FD
LC_ALL=C; export LC_ALL
now() { "$RACH2_RUN_UTIL" now; }
sleep() { "$RACH2_RUN_UTIL" sleep "$1"; }

# e2fsprogs, where a package manager keeps it off the path; the suites that
# name mke2fs or e2fsck find them where the build does.
# Where the tree has it; the runner's own self-test drives a tree that does not.
[ -f "$REPO/tools/setup/e2fsprogs_path.sh" ] && . "$REPO/tools/setup/e2fsprogs_path.sh"
REGISTRY="$REPO/tests/registry"
[ -f "$REGISTRY" ] || { echo "run: result: refused: missing $REGISTRY" >&2; exit 1; }

# How many suites run at once. A suite spends most of its life waiting for an
# emulated machine rather than computing, so the useful count is above the
# core count: on a ten-core machine the full run takes 1286s at four workers,
# 728 at eight, 587 at twelve, 527 at sixteen and 499 at twenty, and stops
# improving there. Twice the processors lands on that knee.
workers_default() {
    n=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
    case "$n" in ''|*[!0-9]*) n=4 ;; esac
    n=$((n * 2))
    [ "$n" -lt 4 ] && n=4
    echo "$n"
}
# Internal deadline variables belong to this run. Only the explicit public
# override is inherited; it applies equally to single suites and sets.
unset RACH2_DEADLINES RACH2_DEADLINE_FACTOR
WORKERS="${RACH2_WORKERS:-$(workers_default)}"
# How much guest memory the pool may have booted at once, in MiB: three
# quarters of the host's, so the memory matrix's 4 GiB machine and the
# suites beside it never push the host into swap, where every deadline
# lies. RACH2_MEMORY_MIB overrides it. A suite is admitted while the running
# suites' declared memory plus its own fits; a suite alone always fits.
memory_default() {
    b=$(sysctl -n hw.memsize 2>/dev/null)
    if [ -z "$b" ] && [ -r /proc/meminfo ]; then
        b=$(($(awk '/^MemTotal:/ { print $2 }' /proc/meminfo) * 1024))
    fi
    case "$b" in ''|*[!0-9]*) echo 4096; return ;; esac
    echo $((b * 3 / 4 / 1048576))
}
MEMORY_MIB="${RACH2_MEMORY_MIB:-$(memory_default)}"
case "$MEMORY_MIB" in
    ''|*[!0-9]*|0) echo "run: result: refused: RACH2_MEMORY_MIB must be a positive whole number" >&2; exit 2 ;;
esac
case "$WORKERS" in
    ''|*[!0-9]*) echo "run: result: refused: RACH2_WORKERS must be a positive whole number" >&2; exit 2 ;;
esac
# `00` is digits and is zero, and a pool of zero waits for a worker that never
# frees. The value is compared as a number from here on, so it is made one.
WORKERS=$(awk -v n="$WORKERS" 'BEGIN {if (n < 1 || n > 1024) exit 1; printf "%.0f\n", n}') || {
    echo "run: result: refused: RACH2_WORKERS must be between 1 and 1024" >&2; rm -rf "$WORK"; exit 2;
}
[ "$WORKERS" -ge 1 ] || { echo "run: result: refused: RACH2_WORKERS must be a positive whole number" >&2; exit 2; }

# What this run owns: its descendants by the process table, which reaches
# the makes, recipes and machines under it and the ones the harness's
# deadline put in groups of their own; the members of its process group;
# and the machines in the ledgers. The end of a run, on a signal or in the
# ordinary way, stops what is still owned and waits until it is gone: TERM,
# then KILL five seconds later, eight seconds at most, and what is left after
# that is named. A signal besides stops further starts and prints what the
# unfinished suites had written; the exit is the signal's. `finish` runs
# once: the trap calls it and the EXIT trap finds it done.
OWN_PGID=$("$RACH2_RUN_UTIL" pgid $$)
PGID=$OWN_PGID
# Not a group of its own, so nothing is matched by group; what the ledgers
# and the process table name is still stopped.
[ "$PGID" = "$$" ] || PGID=""
STOPPING=""
owned() {
    # The listing's own processes, the substitution's subshell and what it
    # started, are not the run's: every process under the one that ran `ps`
    # is left out, whether reached through the table or through the group.
    ps -A -o pid= -o ppid= -o pgid= > "$WORK/ps" 2>/dev/null &
    self=$!; wait "$self"
    awk -v group="$PGID" '$3 == group {print $1}' "$WORK/ps" > "$WORK/group"
    for f in "$WORK"/*.groups; do
        [ -f "$f" ] || continue
        while read -r group; do
            awk -v group="$group" '$3 == group {print $1}' "$WORK/ps" >> "$WORK/group"
        done < "$f"
    done
    awk -v root="$$" -v self="$self" '
        FILENAME == ARGV[1] { kid[$1] = $2; next }
        { group[$1] = 1 }
        END {
            for (q = self; (q in kid) && q != root; q = kid[q]) skip[q] = 1
            for (p in kid) {
                q = p; n = 0
                while ((q in kid) && q != root && !(q in skip) && n++ < 1000) q = kid[q]
                if (q in skip) continue
                if (q == root && p != root || p in group) print p
            }
            for (p in group) if (!(p in kid)) print p
        }' "$WORK/ps" "$WORK/group"
    for f in "$WORK"/*.machines; do
        [ -f "$f" ] && "$RACH2_RUN_UTIL" registered "$f"
    done
    for f in "$WORK"/*.jobs; do
        [ -f "$f" ] && cat "$f"
    done
    :
}
owned_live() { owned | sort -u | while read -r p; do [ -n "$p" ] && [ "$p" != "$$" ] && kill -0 "$p" 2>/dev/null && echo "$p"; done; }
owned_kill() {
    for pid in $(owned_live); do kill "-$1" "$pid" 2>/dev/null; done
}
owned_wait() { # owned_wait TENTHS: 0 when nothing owned is left within the time
    i=0
    while [ "$i" -lt "$1" ]; do
        [ -z "$(owned_live)$(groups_live)" ] && return 0
        sleep 0.1; i=$((i + 1))
    done
    [ -z "$(owned_live)$(groups_live)" ]
}
# Group ledgers also reach reparented children when ps is unavailable.
groups_kill() {
    for f in "$WORK"/*.groups; do
        [ -f "$f" ] || continue
        while read -r group; do "$RACH2_RUN_UTIL" killgroup "$group" "$1" 2>/dev/null || :; done < "$f"
    done
}
groups_live() {
    for f in "$WORK"/*.groups; do
        [ -f "$f" ] || continue
        while read -r group; do
            "$RACH2_RUN_UTIL" killgroup "$group" 0 2>/dev/null && echo "$group"
        done < "$f"
    done
    :
}
owned_stop() {
    owned_live > "$WORK/stopping"
    groups_kill 15
    while read -r pid; do kill -TERM "$pid" 2>/dev/null; done < "$WORK/stopping"
    # Let suite supervisors finish their two-second TERM and token cleanup
    # before escalating against the supervisors themselves.
    owned_wait 50 && return 0
    while read -r pid; do kill -KILL "$pid" 2>/dev/null; done < "$WORK/stopping"
    owned_kill KILL
    groups_kill 9
    owned_wait 30 && return 0
    echo "run: still running after the stop: $(owned_live | tr '\n' ' ')" >&2
    return 1
}
SIGNALLED=""
FINISHED=""
# shellcheck disable=SC2329 # run from the traps
finish() {
    [ -z "$FINISHED" ] || return 0
    FINISHED=1
    trap '' INT TERM HUP
    STOPPING=1
    for suite in $RUNNING_NAMES; do
        [ -f "$WORK/$suite.out" ] || continue
        if [ -f "$WORK/$suite.rc" ]; then
            cat "$WORK/$suite.out" # ended, not yet reported
        elif [ -n "$SIGNALLED" ]; then
            echo "run: $suite: stopped before its end; its output so far:"
            cat "$WORK/$suite.out"
        fi
    done
    [ -z "$(owned_live)$(groups_live)" ] || owned_stop
    lock_release
    rm -rf "$WORK"
}
RUNNING=""; RUNNING_NAMES=""
trap 'finish' EXIT
trap 'SIGNALLED=1; finish; echo "run: result: interrupted by int" >&2; exit 130' INT
trap 'SIGNALLED=1; finish; echo "run: result: interrupted by term" >&2; exit 143' TERM
trap 'SIGNALLED=1; finish; echo "run: result: interrupted by hup" >&2; exit 129' HUP
# One run at a time on a tree: two share `build/` and its images, and each
# suite kills what runs under its directory at its start. Two runners are
# kept apart by a POSIX record lock on `build/.run.guard`; beside it a
# directory, made atomically, holds the owner's pid, process group, scratch
# directory and arguments, which is what a second runner prints and what a
# takeover reads. A lock with no owner file yet is one
# being taken this moment, until it is ten seconds old. A lock whose owner
# is gone is taken over only when nothing of its group and none of its
# ledgers' machines is left: a runner killed with KILL cannot clean up, and
# its makes and machines may still be running; they are named for the
# person to stop. The takeover moves the old lock aside by rename, which
# one taker at most can do. The pid alone does not say the owner is alive,
# since pids are reused; the pid is the owner's while its group is the
# recorded one.
LOCK="$REPO/build/.run.lock"
lock_field() { sed -n "s/^$1 //p" "$LOCK/owner" 2>/dev/null; }
lock_owner_alive() {
    opid=$(lock_field pid)
    [ -n "$opid" ] && [ "$("$RACH2_RUN_UTIL" pgid "$opid" 2>/dev/null)" = "$(lock_field pgid)" ]
}
lock_being_taken() {
    [ ! -f "$LOCK/owner" ] && "$RACH2_RUN_UTIL" young "$LOCK" 10
}
lock_survivors() {
    opgid=$(lock_field pgid)
    {
        ps -A -o pid= -o pgid= | awk -v group="$opgid" '$2 == group {print $1}'
        owork=$(lock_field work)
        if [ -n "$owork" ]; then
            for f in "$owork"/*.machines; do
                [ -f "$f" ] && "$RACH2_RUN_UTIL" registered "$f"
            done
            for f in "$owork"/*.groups; do
                [ -f "$f" ] || continue
                while read -r group; do
                    "$RACH2_RUN_UTIL" killgroup "$group" 0 2>/dev/null && echo "$group"
                done < "$f"
            done
        fi
        :
    } | sort -u | while read -r p; do [ -n "$p" ] && kill -0 "$p" 2>/dev/null && echo "$p"; done | tr '\n' ' '
}
lock_take() {
    mkdir -p "$REPO/build"
    if [ "${RACH2_RUN_LOCK:-}" != "$$" ]; then
        RACH2_RUN_LOCK=$$; RACH2_RUN_GROUP=$$; RACH2_RUN_WORK=$WORK
        export RACH2_RUN_LOCK RACH2_RUN_GROUP RACH2_RUN_WORK
        exec "$RACH2_RUN_UTIL" lock "$REPO/build/.run.guard" "$LOCK/owner" sh "$0" "$@"
    fi
    unset RACH2_RUN_LOCK
    if mkdir "$LOCK" 2>/dev/null; then
        :
    elif lock_being_taken; then
        echo "run: another run is taking this tree" >&2
        return 1
    elif lock_owner_alive; then
        echo "run: another run holds this tree: $(lock_field pid), $(lock_field args), since $(lock_field since)" >&2
        return 1
    elif [ -n "$(lock_survivors)" ]; then
        echo "run: a run that is gone left work running: pids $(lock_survivors); stop them before the next run" >&2
        return 1
    else
        echo "run: taking over the lock a run left: $(lock_field pid), $(lock_field args)"
        mv "$LOCK" "$LOCK.old.$$" 2>/dev/null || { echo "run: another run took the tree first" >&2; return 1; }
        rm -rf "$LOCK.old.$$"
        mkdir "$LOCK" 2>/dev/null || { echo "run: another run took the tree first" >&2; return 1; }
    fi
    { echo "pid $$"; echo "pgid $OWN_PGID"; echo "work $WORK"; echo "since $(date '+%Y-%m-%d %H:%M:%S')"; echo "args $*"; } > "$LOCK/owner.new"
    mv "$LOCK/owner.new" "$LOCK/owner"
    LOCKED=1
}
LOCKED=""
# shellcheck disable=SC2329 # run from finish, from the traps
lock_release() {
    [ -n "$LOCKED" ] && [ "$(sed -n 's/^pid //p' "$LOCK/owner" 2>/dev/null)" = "$$" ] && rm -rf "$LOCK"
    LOCKED=""
}

# The registry, one field at a time. Order in the file is the schedule order.
suite_names()  { awk -F'|' '!/^#/ && NF > 1 { print $1 }' "$REGISTRY"; }
suite_tools()  { awk -F'|' -v s="$1" '!/^#/ && $1 == s { print $2 }' "$REGISTRY"; }
suite_known()  { [ -n "$(suite_tools "$1")" ]; }
tier_names()   { awk -F'|' -v t="$1" '!/^#/ && $3 == t { print $1 }' "$REGISTRY"; }
suite_images() { awk -F'|' -v s="$1" '!/^#/ && $1 == s { print $4 }' "$REGISTRY"; }
suite_tier()   { awk -F'|' -v s="$1" '!/^#/ && $1 == s { print $3 }' "$REGISTRY"; }
# What a suite proves, in one sentence: the comment in suites.mk that names
# it as `tests/run NAME`, read to the end of its first sentence.
suite_proves() {
    awk -v n="$1" '
        /^#/ { line = $0; sub(/^# ?/, "", line)
               if (!on && index(line, "`tests/run " n "`") == 1) { on = 1; text = line; next }
               if (on && index(line, "`tests/run ") == 1) exit
               if (on) { text = text " " line; next } }
        { if (on) exit }
        END {
            if (!on) exit
            sub(/^`tests\/run [a-z0-9-]*`:? */, "", text)
            if (match(text, /\. |\.$/)) text = substr(text, 1, RSTART)
            print text
        }' "$REPO/tests/system/suites.mk"
}
# The suites as Markdown, one line each in the registry's order: the tier,
# the tools, the memory, and what the suite proves. tests/system/suites.md
# is this output, and `tests/run style` compares the two.
inventory() {
    echo "# The suites"
    echo
    echo "One line per suite, in the order the pool starts them, from \`tests/run inventory\`: the tier, the external commands the suite needs, the most guest memory its machines ask for at once, and what it proves, which is the sentence in \`tests/system/suites.mk\` that names it. \`tests/run style\` compares this file with that output."
    echo
    for s in $(suite_names); do
        tools=$(suite_tools "$s" | sed 's/,/, /g')
        case "$tools" in
            -) tools="needs nothing beyond the build" ;;
            *) tools="needs $tools" ;;
        esac
        case "$(suite_tools "$s")" in
            *qemu-system-i386*) memory="$(suite_memory "$s") MiB" ;;
            *) memory="no machine" ;;
        esac
        proves=$(suite_proves "$s"); [ -n "$proves" ] || proves="(no sentence in suites.mk names this suite)"
        # shellcheck disable=SC2016 # the backticks are Markdown, not a command
        printf '* `%s` (%s tier; %s; %s): %s\n' "$s" "$(suite_tier "$s")" "$tools" "$memory" "$proves"
    done
}
suite_memory() { # the guest memory a suite's machines ask for at once, MiB
    m=$(awk -F'|' -v s="$1" '!/^#/ && $1 == s { print $5 }' "$REGISTRY")
    case "$m" in ''|*[!0-9]*) echo 128 ;; *) echo "$m" ;; esac
}

# What a suite writes under build/images, as globs from the registry's
# fourth field; a suite that declares nothing owns the files named after
# it, `NAME-test*`, `NAME.*`, `NAME-*` and `NAME/*`, and a second-card twin,
# `NAME-e1000`, owns the plain suite's names with `-e1000` before the
# extension. A file made during a run that no suite of the run owns, or that
# two own, fails the run by name: pooled suites share nothing, and the
# declarations are the inventory of what they touch. The build's own products,
# the ones the preparation records, and their `.d` files are not a suite's and
# are passed over.
image_patterns() { # image_patterns NAME: one glob a line
    p=$(suite_images "$1")
    if [ -n "$p" ]; then
        printf '%s\n' "$p" | tr ',' '\n'
    else
        case "$1" in
            *-e1000) b=${1%-e1000}; printf '%s\n' "$b*-e1000.*" "$b*-e1000-*" "$b*-e1000/*" ;;
            *) printf '%s\n' "$1-test*" "$1.*" "$1-*" "$1/*" ;;
        esac
    fi
}
image_table() { # image_table NAMES: lines of "NAME GLOB"
    for s in $1; do image_patterns "$s" | sed "s/^/$s /"; done
}
check_declarations() { # a glob two suites declare is refused before anything runs
    dup=$(image_table "$(suite_names)" | awk '{print $2}' | sort | uniq -d | head -3)
    [ -z "$dup" ] || { echo "run: result: refused: two suites declare the same images:$(echo "$dup" | tr '\n' ' ')" >&2; return 1; }
}
images_stamp() { : > "$WORK/images.stamp"; }
check_images() { # check_images NAMES: 0 when every file made that is not a
                 # recorded build product belongs to one of them
    [ -f "$WORK/images.stamp" ] || return 0
    image_table "$1" > "$WORK/images.patterns"
    ( cd "$REPO/build/images" 2>/dev/null && find . -type f -newer "$WORK/images.stamp" | sed 's|^\./||' | sort ) > "$WORK/images.made"
    # A product of the run's own target is the build's and not a suite's: a
    # suite's make remakes one whose prerequisite the parallel build left at
    # the same second, and the file is the same bytes, which `check_hashes`
    # is what proves. Only what no product covers is asked about below.
    if [ -f "$WORK/inventory.products" ]; then
        { sed -n 's|^build/images/||p' "$WORK/inventory.products"
          # and the dependency file make wrote beside each, which is not a
          # target of its own and so is in no closure
          sed -n 's|^build/images/||p' "$WORK/inventory.products" | sed 's/$/.d/'
        } | sort -u > "$WORK/images.products"
        comm -23 "$WORK/images.made" "$WORK/images.products" > "$WORK/images.made.new"
        mv "$WORK/images.made.new" "$WORK/images.made"
    fi
    bad=""
    while IFS= read -r f; do
        owners=""
        while read -r s g; do
            case "$s" in
                *-e1000) ;;
                *) case "$f" in *-e1000.*|*-e1000-*|*-e1000/*) continue ;; esac ;;
            esac
            # shellcheck disable=SC2254 # the glob is the pattern
            case "$f" in $g) case " $owners " in *" $s "*) ;; *) owners="$owners $s" ;; esac ;; esac
        done < "$WORK/images.patterns"
        case "$(echo "$owners" | wc -w | tr -d ' ')" in
            1) ;;
            0) echo "run: images: undeclared: build/images/$f" >&2; bad=1 ;;
            *) echo "run: images: shared: build/images/$f:$owners" >&2; bad=1 ;;
        esac
    done < "$WORK/images.made"
    [ -z "$bad" ]
}

usage_names() {
    suite_names | tr '\n' ' ' | sed 's/^/  /;s/ $//' >&2
    echo >&2
}

# What the host must let the run do, tried and not merely looked up.
# `tools/setup/hostcheck.c` binds a TCP, a UDP and a Unix socket when a chosen
# suite boots a machine, and attaches a disk image when one names hdiutil; a
# refusal stops the run before the build. `RACH2_HOSTCHECK` names another
# checker, which is how the runner's own test drives a refusal.
check_host() {
    checker="${RACH2_HOSTCHECK:-}"
    if [ -z "$checker" ]; then
        checker="$WORK/hostcheck"
        cc -O2 -o "$checker" "$REPO/tools/setup/hostcheck.c" || {
            echo "run: the host check did not compile" >&2; return 1
        }
    fi
    if "$checker" "$WORK" ${1:+"$1"}; then
        return 0
    fi
    echo "run: result: the host refuses an operation the suites need; nothing was built" >&2
    return 1
}

# Every external command a suite needs, before anything is built for it.
check_tools() {
    tools=$(suite_tools "$1")
    [ "$tools" = "-" ] && return 0
    oldifs=$IFS; IFS=,
    for tool in $tools; do
        IFS=$oldifs
        command -v "$tool" >/dev/null 2>&1 || {
            echo "run: $1 needs $tool and it is not installed" >&2
            return 1
        }
    done
    IFS=$oldifs
}

# A registered machine may close inherited descriptors. Check its saved
# start time as well as its PID; old ledger entries can have been reused.
check_machines() {
    "$RACH2_RUN_UTIL" machines "$1" "$WORK/$1.machines"
}

# A make run under the runner is started in the background and waited for,
# since the shell runs a trap at once while it waits and only after the
# command ends while one runs in the foreground: a signal then stops the run
# at once, and the group kill takes the make and what it started.
run_make() {
    # shellcheck disable=SC2086
    "$RACH2_RUN_UTIL" group make -C "$REPO" --no-print-directory $KERNEL_VAR "$@" &
    make_pid=$!
    echo "$make_pid" >> "$WORK/build.groups"
    echo "$make_pid" >> "$WORK/run.jobs"
    wait "$make_pid"
}

# A suite has the same supervisor in every scheduling position. Its output
# and its machines' output reset only its own silence clock.
suite_make() {
    # shellcheck disable=SC2086
    "$RACH2_RUN_UTIL" suite "$1" "$IDLE_SECONDS" "$RACH2_QEMU_LEDGER" \
        make -C "$REPO" --no-print-directory $KERNEL_VAR "run-$1" &
    suite_pid=$!
    echo "$suite_pid" >> "$WORK/run.jobs"
    wait "$suite_pid"
}

# The name and the tools were checked before anything was built, so this does
# not repeat them; it runs the target and then reads the ledger the shim wrote.
# A suite run on its own builds what its own target names, in parallel, and
# nothing else: `tests/run host` after an edit to a utility does not restage
# five images and two ISOs first. In a set, `prepare` has built everything.
# The components were built before either, in a Make of their own.
run_one() {
    start=$(now)
    RACH2_QEMU_LEDGER="$WORK/$1.machines"; export RACH2_QEMU_LEDGER
    : > "$RACH2_QEMU_LEDGER"
    [ "${2-}" = pooled ] || echo "run: $1: starting (idle limit $IDLE_SECONDS s)"
    rc=0
    if [ "${2-}" = alone ]; then
        # What the target names is built first and hashed, then the suite
        # runs against those files; one make of both would hash a build in
        # progress or a suite already run.
        # An e1000 suite's target is a wrapper that runs the plain one with
        # NIC set, so the products are the plain target's.
        target="run-$1"
        case "$1" in *-e1000) target="run-${1%-e1000}" ;; esac
        products=$(closure "$target" | grep '^build/')
        # shellcheck disable=SC2086 # the prerequisites are one word each
        [ -z "$products" ] || run_make -j $products || rc=1
        [ "$rc" = 0 ] && take_products "$target"
        images_stamp
        [ "$rc" = 0 ] && { suite_make "$1" || rc=1; }
    else
        suite_make "$1" || rc=1
    fi
    check_machines "$1" || rc=1
    if [ "$rc" = 0 ]; then
        echo "run: $1: PASS in $(($(now) - start))s"
    else
        echo "run: $1: FAIL in $(($(now) - start))s" >&2
    fi
    return "$rc"
}

# The given suites, at most $WORKERS at a time, each one's output held while
# it runs and printed whole the moment it ends, in the order they end: twenty
# suites writing to one terminal is not a report, and a report an hour late
# is not one either. A suite's result is its `.rc` file, written beside and
# moved into place after its output is closed, so a reader never sees an
# empty result; a job that is gone with no result failed. The failures are
# left in POOL_FAILED rather than printed, because a caller reading this
# through a command substitution would run it in a subshell and the output
# would go there instead of to the person waiting. With RACH2_STOP_ON_FAIL
# set, the first failure stops the pool: what is queued does not start, and
# what is running is stopped and reported as stopped.
POOL_FAILED=""
run_pool() {
    POOL_FAILED=""; RUNNING=""; RUNNING_NAMES=""; stopped=""; poll_turns=0
    # shellcheck disable=SC2086 # the names are one word each; this drops the leading space
    set -- $1; pending="$*"
    while [ -n "$pending" ] || [ -n "$RUNNING_NAMES" ]; do
        pool_collect
        # Admit while there is room and nothing has stopped the pool.
        while [ -n "$pending" ] && [ -z "$stopped" ] && [ -z "$STOPPING" ] &&
              [ "$(active_count)" -lt "$WORKERS" ]; do
            suite=$(pool_next)
            [ -n "$suite" ] || break # nothing fits the memory budget until something ends
            rest=""; for s in $pending; do [ "$s" = "$suite" ] || rest="$rest $s"; done
            pending=${rest# }
            echo "run: $suite: starting (idle limit $IDLE_SECONDS s)"
            ( RACH2_PROGRESS_FD=3; export RACH2_PROGRESS_FD
              run_one "$suite" pooled > "$WORK/$suite.out" 2>&1; echo $? > "$WORK/$suite.rc.new";
              mv "$WORK/$suite.rc.new" "$WORK/$suite.rc" ) 3>&1 &
            echo $! > "$WORK/$suite.job"
            RUNNING="$RUNNING $!"
            RUNNING_NAMES="$RUNNING_NAMES $suite"
        done
        pool_collect
        if [ -n "$stopped" ]; then
            [ -z "$pending" ] || {
                echo "run: stopped on the first failure; not started:$(echo " $pending" | sed 's/  */ /g')"
                POOL_FAILED="$POOL_FAILED $pending"; pending=""
            }
            [ -z "$RUNNING_NAMES" ] || {
                echo "run: stopped on the first failure; stopped part way:$(echo " $RUNNING_NAMES" | sed 's/  */ /g')"
                owned_stop
                for suite in $RUNNING_NAMES; do
                    [ -f "$WORK/$suite.rc" ] || { echo "run: $suite: stopped" >> "$WORK/$suite.out"; echo 1 > "$WORK/$suite.rc"; }
                done
                pool_collect
            }
        fi
        poll_turns=$((poll_turns + 1))
        if [ "$((poll_turns % 10))" -eq 0 ] && [ -z "$stopped" ] && ! check_scripts_now; then
            echo "run: stopping the set: the tree changed under it" >&2
            stopped=1
        fi
        [ -z "$pending" ] && [ -z "$RUNNING_NAMES" ] || sleep 0.2
    done
    RUNNING=""
}

# The suites that ended since the last look, each reported once and its
# held output removed, so an interrupted run does not print it twice.
pool_collect() {
    for suite in $RUNNING_NAMES; do
        if [ -f "$WORK/$suite.rc" ]; then
            :
        elif job_of "$suite"; then
            continue
        elif [ -f "$WORK/$suite.rc" ]; then
            : # it ended, and wrote its result, between the two looks
        else
            echo 1 > "$WORK/$suite.rc" # gone with no result
            echo "run: $suite: ended without a result" >> "$WORK/$suite.out"
        fi
        wait "$(cat "$WORK/$suite.job")" 2>/dev/null || :
        cat "$WORK/$suite.out" 2>/dev/null
        rm -f "$WORK/$suite.out"
        read -r rc < "$WORK/$suite.rc"
        [ "$rc" = 0 ] || POOL_FAILED="$POOL_FAILED $suite"
        [ "$rc" = 0 ] || [ -z "${RACH2_STOP_ON_FAIL:-}" ] || stopped=1
        RUNNING_NAMES=$(echo " $RUNNING_NAMES " | sed "s/ $suite / /" | sed 's/^ *//;s/ *$//')
    done
}
# Whether the job running `$1` is still alive.
job_of() {
    pid=$(cat "$WORK/$1.job" 2>/dev/null)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

active_count() {
    # shellcheck disable=SC2086 # suite names have no whitespace
    set -- $RUNNING_NAMES
    echo "$#"
}
active_memory() { # the declared memory of the suites running now, MiB
    total=0
    for s in $RUNNING_NAMES; do total=$((total + $(suite_memory "$s"))); done
    echo "$total"
}
# The first pending suite whose memory fits beside what runs, or the first
# pending one when nothing runs; empty when none fits yet.
pool_next() {
    have=$(active_memory)
    for s in $pending; do
        if [ "$have" -eq 0 ] || [ $((have + $(suite_memory "$s"))) -le "$MEMORY_MIB" ]; then
            echo "$s"; return
        fi
    done
}

# What a run reads, and must not change while it runs: the scripts that
# decide a result and the tools that judge one, hashed when the run starts,
# and the kernels and the products the run's target builds, hashed once
# they are built, read from make's own database (`make -pn`), which lists
# every target with its prerequisites expanded, so the list is what make
# builds and not a list kept by hand. Both are hashed again at the end,
# whatever the result; a difference, or a file gone, voids the run by name.
# Two equal hashes do not say the file stood still in between; they say
# what the result was made with is what is there now.
closure() { # closure TARGET: the file prerequisites reachable from TARGET
    make -C "$REPO" -pn "$1" 2>/dev/null | awk -v root="$1" '
        /^#/ || /^$/ { next }
        /^[^ \t:=]+:[^=]/ {
            t = $1; sub(/:$/, "", t)
            n = split($0, f, /[ \t]+/)
            for (i = 2; i <= n; i++) if (f[i] != "" && f[i] != "|") deps[t] = deps[t] " " f[i]
            cur = t; next
        }
        /^\t/ && cur == "prepare-all" { # its halves are named by its recipe
            n = split($0, f, /[ \t]+/)
            for (i = 1; i <= n; i++) if (f[i] ~ /^prepare-/) deps[cur] = deps[cur] " " f[i]
            next
        }
        /^\t/ { next }
        END {
            queue[1] = root; head = 1; tail = 1; seen[root] = 1
            while (head <= tail) {
                t = queue[head++]
                m = split(deps[t], d, " ")
                for (i = 1; i <= m; i++) if (d[i] != "" && !(d[i] in seen)) { seen[d[i]] = 1; queue[++tail] = d[i] }
            }
            for (x in seen) if (x ~ /^build\// || x ~ /\//) print x
        }' | sort
}
present() { ( cd "$REPO" && while read -r f; do [ -f "$f" ] && echo "$f"; done ) | sort -u; }
scripts_inventory() {
    ( cd "$REPO" && {
        echo tests/run; echo tests/registry; echo tests/system/suites.mk; echo Makefile
        ls mk/*.mk tests/system/runner/*.c tests/system/*.sh tests/system/suites/*.sh tests/system/accept/*.sh \
           tools/image/*.sh krffs/*.sh tools/verify/check.sh krffs/manifests/* 2>/dev/null
    } ) | present
}
products_inventory() { # products_inventory TARGET
    ( cd "$REPO" && ls build/rach2*/kernel 2>/dev/null; closure "$1" ) | present
}
hasher() {
    cksum
}
hash_list() { # hash_list LIST OUT: each file's hash, or `gone` for one missing
    ( cd "$REPO" && while read -r f; do
        if [ -f "$f" ]; then hasher < "$f" | awk -v file="$f" '{print $1 ":" $2, file}'; else echo "gone $f"; fi
      done < "$1" ) > "$2"
}
take_scripts() {
    scripts_inventory > "$WORK/inventory.scripts"
    hash_list "$WORK/inventory.scripts" "$WORK/hashes.scripts"
}
take_products() { # take_products TARGET
    products_inventory "$1" > "$WORK/inventory.products"
    hash_list "$WORK/inventory.products" "$WORK/hashes.products"
}
# The scripts are checked as the set runs, not only at its end: the runner,
# the registry, the makefiles and the suite and tool scripts, which is what
# `scripts_inventory` lists. A file changed under a run voids it, and learning
# that ninety minutes later costs the whole run; on 2026-09-13 it cost one.
# Hashing those is cheap and it is the case that happens. The kernel and the
# application sources are not hashed here; a change to one reaches the run
# through the products, which are large and are left to the check at the end.
check_scripts_now() { # 0 when no script of the inventory has changed
    [ -f "$WORK/hashes.scripts" ] || return 0
    hash_list "$WORK/inventory.scripts" "$WORK/hashes.scripts.now"
    cmp -s "$WORK/hashes.scripts" "$WORK/hashes.scripts.now" && return 0
    diff "$WORK/hashes.scripts" "$WORK/hashes.scripts.now" |
        awk '/^>/ {print $3}' | sort -u | while read -r f; do
            echo "run: voided: $f changed during the run" >&2
        done
    return 1
}

check_hashes() { # 0 when nothing hashed differs or is gone
    voided=""
    for kind in scripts products; do
        [ -f "$WORK/inventory.$kind" ] || continue
        hash_list "$WORK/inventory.$kind" "$WORK/hashes.$kind.after"
        cmp -s "$WORK/hashes.$kind" "$WORK/hashes.$kind.after" && continue
        diff "$WORK/hashes.$kind" "$WORK/hashes.$kind.after" | awk '/^>/ {print $3}' | sort -u | while read -r f; do
            echo "run: voided: $f changed during the run" >&2
        done
        voided=1
    done
    [ -z "$voided" ]
}
# The components first, in a Make of their own: an image rule that meets a
# program and the component that builds it in one Make reads the program's
# time before the component has run, and keeps the old image. Then, for a
# set, the product and the test tools once, so no two suites build at once. A
# suite run alone builds its own images through its own target.
build_components() {
    run_make -j components || {
        echo "run: result: refused: the components did not build" >&2; exit 1
    }
}
prepare() {
    echo "run: preparing"
    # The named kernel first: the disks and sticks the preparation makes
    # carry it, so it must exist before they are built.
    if [ -n "$KERNEL_VAR" ]; then
        run_make "${RACH2_KERNEL}-kernel" || {
            echo "run: result: refused: the $RACH2_KERNEL kernel did not build" >&2; exit 1
        }
    fi
    run_make -j prepare-all || {
        echo "run: result: refused: preparation failed" >&2; exit 1
    }
}

# Completion bounds keep their written values unless the caller supplies a
# factor. The runner never measures host speed or changes the pool width.
set_accel() {
    case "${RACH2_QEMU_ACCEL:-}" in
        '')
            if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
                RACH2_QEMU_ACCEL=kvm
            elif [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = x86_64 ] &&
                [ "$(sysctl -n kern.hv_support 2>/dev/null)" = 1 ]; then
                RACH2_QEMU_ACCEL=hvf
            else
                RACH2_QEMU_ACCEL=tcg
            fi
            ;;
        kvm|hvf|tcg) ;;
        *)
            echo "run: result: refused: RACH2_QEMU_ACCEL must be kvm, hvf or tcg" >&2
            return 1
            ;;
    esac
    export RACH2_QEMU_ACCEL
}

set_factor() {
    CAL_FACTOR=${RACH2_TIMEOUT_FACTOR:-1}
    case "$CAL_FACTOR" in
        *[!0-9.]*|.*|*.|*.*.*|'')
            echo "run: result: refused: RACH2_TIMEOUT_FACTOR must be a positive decimal" >&2
            return 1 ;;
    esac
    CAL_FACTOR=$(awk -v f="$CAL_FACTOR" 'BEGIN {
        if (f < 1 || f > 64) exit 1
        printf "%.1f\n", int(f * 10 + 0.999) / 10
    }') || {
        echo "run: result: refused: RACH2_TIMEOUT_FACTOR must be between 1 and 64" >&2
        return 1
    }
    RACH2_DEADLINES=scaled; RACH2_DEADLINE_FACTOR=$CAL_FACTOR
    export RACH2_DEADLINES RACH2_DEADLINE_FACTOR
}

run_set() {
    failed=""; serial=""; pooled=""
    for suite in $1; do
        case "$suite" in
            style|host) serial="$serial $suite" ;;
            *)          pooled="$pooled $suite" ;;
        esac
    done
    RUNNING=serial
    for suite in $serial; do run_one "$suite" || failed="$failed $suite"; done
    RUNNING=""
    [ -n "$STOPPING" ] && return 1
    if [ -n "$failed" ] && [ -n "${RACH2_STOP_ON_FAIL:-}" ]; then
        echo "run: stopped on a failure; not started:$pooled"
        echo "run: result: failed:$failed" >&2
        return 1
    fi
    if [ -n "$pooled" ]; then
        run_pool "$pooled"; failed="$failed$POOL_FAILED"
    fi
    [ -n "$STOPPING" ] && return 1
    [ -z "$failed" ] && return 0
    echo "run: result: failed:$failed" >&2
    return 1
}

case "${1-}" in
    inventory) inventory; exit 0 ;;
    '')
        echo "usage: tests/run NAME [NAME...] | core | all | inventory" >&2
        echo "run: result: refused: no suite named" >&2; usage_names; exit 2 ;;
    all|core)
        # A set and a name in one command would read as "the set and also
        # this", and the set is not being added to. Refused rather than
        # silently dropped.
        [ "$#" -eq 1 ] || {
            echo "run: result: refused: '$1' is a whole set; it takes no other names" >&2; exit 2
        }
        if [ "$1" = all ]; then
            # shellcheck disable=SC2046 # a suite name is one word by format
            set -- $(suite_names)
        else
            # shellcheck disable=SC2046 # a suite name is one word by format
            set -- $(tier_names core)
        fi ;;
esac

# Every name and every tool, before a single object is built: a run that is
# going to refuse the last suite should refuse it now rather than in an hour.
[ "$#" -gt 0 ] || { echo "run: result: refused: no suites in that set" >&2; exit 2; }
seen=""
for suite in "$@"; do
    suite_known "$suite" || {
        echo "run: result: refused: unknown suite '$suite'" >&2; usage_names; exit 2
    }
    # Twice in one command means two runs sharing one ledger and one held
    # output, where the second result overwrites the first.
    case " $seen " in
        *" $suite "*) echo "run: result: refused: $suite is named twice" >&2; exit 2 ;;
    esac
    seen="$seen $suite"
    check_tools "$suite" || { echo "run: result: refused: $suite has no tools to run with" >&2; exit 1; }
done
diskimage=""
sockets="--no-sockets"
for suite in "$@"; do
    case ",$(suite_tools "$suite")," in
        *,hdiutil,*) diskimage="--diskimage" ;;
    esac
    case "$suite" in
        style|host) ;;
        *) sockets="" ;;
    esac
done
check_host $diskimage $sockets || { echo "run: result: refused: this host cannot run the set" >&2; exit 1; }

IDLE_SECONDS=${RACH2_IDLE_TIMEOUT:-300}
case "$IDLE_SECONDS" in
    ''|*[!0-9]*) echo "run: result: refused: RACH2_IDLE_TIMEOUT must be a positive whole number" >&2; exit 2 ;;
esac
IDLE_SECONDS=$(awk -v n="$IDLE_SECONDS" 'BEGIN {if (n < 1 || n > 86400) exit 1; printf "%.0f\n", n}') || {
    echo "run: result: refused: RACH2_IDLE_TIMEOUT must be between 1 and 86400 seconds" >&2; exit 2;
}
set_factor || exit 2
set_accel || exit 2
lock_take "$@" || { echo "run: result: refused: the tree is not free" >&2; exit 1; }
# Each suite names the machines it starts, so a leaked one can be blamed on the
# suite that left it. Listing every QEMU on the host works only while one suite
# runs at a time; with twenty running, each would see the other nineteen. So a
# shim named `qemu-system-i386` goes first on PATH, writes its own pid to the
# ledger of the suite that is running, and then becomes the real QEMU. The
# harness reaches QEMU through execvp and the shell suites through their own
# PATH lookup, so this covers both without either knowing about it.
# The shim also chooses the accelerator, so every suite boots the same kind
# of machine and none names one: KVM where /dev/kvm can be opened, HVF on
# an x86 Mac that reports it, the emulator otherwise. `RACH2_QEMU_ACCEL`
# names one outright, and `tcg` is how a KVM host is measured without it.
QEMU_REAL=$(command -v qemu-system-i386 2>/dev/null || true)
if [ -n "$QEMU_REAL" ]; then
    mkdir -p "$WORK/bin"
    export QEMU_REAL RACH2_QEMU_ACCEL
    cat > "$WORK/bin/qemu-system-i386" <<'QEMU'
#!/bin/sh
exec "$RACH2_RUN_UTIL" machine "${RACH2_QEMU_LEDGER:?}" "$QEMU_REAL" -accel "${RACH2_QEMU_ACCEL:?}" "$@"
QEMU
    chmod +x "$WORK/bin/qemu-system-i386"
    PATH="$WORK/bin:$PATH"; export PATH
fi

# A sweep of the process table for another runner stood here for an hour on
# 2026-09-14 and was removed: a runner of another tree looks exactly like a
# runner of this one on a command line, so the runner's own selftest, which
# drives a tree of its own while a set runs, refused itself. The lock is what
# knows which tree a run holds, and it names the run that holds it.
# The line that says this run began. Everything below it belongs to this run,
# and a log without it is a run that never started.
echo "run: starting: $* (pid $$, $(date '+%Y-%m-%d %H:%M:%S'), workers $WORKERS, memory $MEMORY_MIB MiB, timeout factor $CAL_FACTOR, accelerator $RACH2_QEMU_ACCEL)"
# The recovery system starts an SSH server only where a key was built into it,
# and the suites that repair or update a machine do that work through recovery
# over SSH. The key is minted here: after the names are checked and the tree is
# this run's, so two runners cannot mint at once, and before the first make,
# because make decides from the key's presence what the recovery artifacts are
# called. A plain `make` mints nothing, which is what keeps the absence
# meaningful; the tree the runner's own selftest drives has no recovery system
# at all, which is why the manifest is looked for and not the key alone.
if [ -f "$REPO/krffs/manifests/rach2-recovery.manifest" ] &&
   [ ! -f "$REPO/krffs/recovery_authorized_keys" ]; then
    make -C "$REPO" --no-print-directory recovery-key || {
        echo "run: result: the recovery system's key could not be made" >&2
        exit 1
    }
fi
check_declarations || exit 1
take_scripts
build_components
rc=0
if [ "$#" -eq 1 ]; then
    # The kernel RACH2_KERNEL names is built here too: a suite run alone
    # builds through its own target, which does not name that kernel, so
    # without this the suite would boot whatever the last set left, or
    # nothing at all.
    if [ -n "$KERNEL_VAR" ]; then
        run_make "${RACH2_KERNEL}-kernel" || {
            echo "run: result: refused: the $RACH2_KERNEL kernel did not build" >&2; exit 1
        }
    fi
    RUNNING=serial
    run_one "$1" alone || rc=1
    RUNNING=""
else
    prepare
    take_products prepare-all
    images_stamp
    run_set "$*" || rc=1
fi
check_hashes || rc=1
check_images "$*" || { echo "run: result: failed: images" >&2; rc=1; }
if [ "$rc" = 0 ]; then
    echo "run: result: all $# suites passed"
else
    echo "run: result: failed"
fi
exit "$rc"
